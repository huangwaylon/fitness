{
  "name": "island-fund",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && cp build-pages/index.html build-pages/404.html && touch build-pages/.nojekyll",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "prepare": "svelte-kit sync || true",
    "assets:fetch": "node scripts/fetch-assets.ts",
    "fonts:subset": "node scripts/font-subsets.ts",
    "gas:build": "node gas/build.ts",
    "bench": "node scripts/bench-model.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24"
  }
}
