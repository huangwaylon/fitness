{
  "name": "island-fund",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && cp build-pages/index.html build-pages/404.html && touch build-pages/.nojekyll",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:report": "node scripts/e2e-report.ts",
    "e2e:ci-like": "node scripts/e2e-ci-like.ts",
    "e2e:shards": "node scripts/e2e-shards.ts",
    "prepare": "svelte-kit sync || true",
    "assets:fetch": "node scripts/fetch-assets.ts",
    "catalog:build": "node scripts/catalog.ts",
    "fonts:subset": "node scripts/font-subsets.ts",
    "icons:build": "node scripts/icons.ts",
    "audio:music": "node scripts/music.ts",
    "gas:build": "node gas/build.ts",
    "gas:deploy": "node gas/deploy.ts",
    "heads": "node scripts/heads.ts",
    "assets:derive": "node scripts/derive-art.ts",
    "terrain": "node scripts/terrain.ts",
    "terrain:preview": "node scripts/terrain-preview.ts",
    "bench": "node scripts/bench-model.ts",
    "knip": "knip",
    "models": "node scripts/models.ts",
    "room-models": "node scripts/room-models.ts",
    "seat-anchors": "node scripts/seat-anchors.ts",
    "world3d-models": "node scripts/world3d-models.ts",
    "world3d-sheet": "node scripts/world3d-sheet.ts",
    "villagers3d": "node scripts/villagers3d-models.ts",
    "layout": "node scripts/layout.ts",
    "layout:default": "node scripts/layout-default.ts",
    "home-models": "node scripts/home-models.ts",
    "structure-models": "node scripts/home-models.ts --structures",
    "terrain-textures": "node scripts/terrain-textures.ts",
    "unused": "node scripts/unused-assets.ts",
    "unused:probe": "node scripts/unused-probe.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "gltfpack": "^1.3.0",
    "knip": "^6.44.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "three": "^0.170.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24"
  }
}
