{
  "video": "Lm_SCbOzxJs",
  "lines": [
    { "t": [0.6, 3.7], "ja": "ジェリーをいじめるのが、世界で一番好きなことだったのに" },
    { "t": [3.7, 5.2], "ja": "あなたとイチャイチャすることの次にね" },
    { "t": [5.2, 7.4], "ja": "両方いっぺんにやったときのこと覚えてる？" },
    { "t": [7.4, 10.2], "ja": "あいつ、すごく気まずそうだったよな" },
    { "t": [10.2, 11.8], "ja": "悲しい日だね" },
    { "t": [11.8, 13], "ja": "これから誰をからかえばいいの？" },
    { "t": [13, 14], "ja": "心配はいらない" },
    { "t": [14, 16.6], "ja": "私が働いたどの職場にも、ジェリーがいた" },
    { "t": [16.6, 19.2], "ja": "一人のジェリーがいなくなると、職場は自然に" },
    { "t": [19.2, 21.6], "ja": "その役を埋める新しいジェリーを選ぶ" },
    { "t": [21.6, 24.5], "ja": "社会のダーウィン主義だ。強い者が弱い者を食いものにする" },
    { "t": [24.5, 28.8], "ja": "すぐに、お前たちの誰かが容赦なくばかにされるだろう" },
    { "t": [28.8, 30.4], "ja": "ああ、自然の摂理だ" },
    { "t": [33.4, 36.6], "ja": "これが最後の動物管理の報告書です" },
    { "t": [39.2, 41.2], "ja": "何してるの、変な人" },
    { "t": [41.2, 43.5], "ja": "何もこぼさないようにしてるだけだよ" },
    { "t": [43.5, 46.6], "ja": "レスリーは、これを年ごとに整理してって言ってたと思う" },
    { "t": [46.6, 47.6], "ja": "とっくにやってるよ" },
    { "t": [47.6, 49.3], "ja": "2つの「ファイルの山の山」を作ったんだ" },
    { "t": [50.8, 51.8], "ja": "ファイルの山の山" },
    { "t": [53, 54.2], "ja": "山の山" },
    { "t": [54.2, 56], "ja": "山の山、違うな" },
    { "t": [56, 56.9], "ja": "壊れちゃったの？" },
    { "t": [56.9, 58.9], "ja": "いや、何も問題ない" },
    { "t": [58.9, 61.5], "ja": "まあ、これで新しいジェリーが誰か決まったな" },
    { "t": [61.5, 62.2], "ja": "決まってないよ" },
    { "t": [62.2, 63.4], "ja": "ほとんど言い間違えてないし" },
    { "t": [63.4, 64.4], "ja": "言い間違えたじゃない" },
    { "t": [64.4, 65.4], "ja": "やめろよ" },
    { "t": [67.8, 69.6], "ja": "こうやって始まるんだ" },
    { "t": [69.6, 71], "ja": "次のジェリーが" },
    { "t": [71, 72.6], "ja": "ひとつの言い間違いから" },
    { "t": [72.6, 75], "ja": "そして30年後には、青緑色のセーターベストを着て" },
    { "t": [75, 78.6], "ja": "アイポッドでボニー・レイットと「ダ・ヴィンチ・コード」を聞いてるんだ" },
    { "t": [82.6, 84.3], "ja": "もう始まってる" },
    { "t": [84.3, 87.8], "ja": "ジェリーの悲しくて臭い王冠には、自然な後継ぎがいる" },
    { "t": [87.8, 89.1], "ja": "それは僕じゃない" },
    { "t": [89.1, 90.6], "ja": "アンディだ" },
    { "t": [90.6, 92.3], "ja": "体がでかい、当てはまる" },
    { "t": [92.3, 94.2], "ja": "間抜け、当てはまる" },
    { "t": [94.2, 99.2], "ja": "あとはドワイヤーお決まりの失敗を待つだけ。だいたい20分に1回は起きる" },
    { "t": [99.2, 101.9], "ja": "あら、ファイロ・パイロじゃない" },
    { "t": [101.9, 103], "ja": "へえ、すっごく独創的だね、ドナ" },
    { "t": [103, 104.4], "ja": "それがはやると思ってるの？" },
    { "t": [104.4, 105.4], "ja": "ねえ、ペンが" },
    { "t": [107.4, 108.4], "ja": "アンディを見て" },
    { "t": [108.4, 109.7], "ja": "おい、体じゅうインクだらけだぞ" },
    { "t": [109.7, 111.3], "ja": "おい、アンディが新しいジェリーだ" },
    { "t": [111.3, 112.1], "ja": "ゲームオーバー" },
    { "t": [112.1, 113], "ja": "最高" },
    { "t": [113, 114.3], "ja": "見て、俺、巨大イカみたい" },
    { "t": [114.3, 116.1], "ja": "ねえ、ハニー、俺、インク・ドラキュラだよ" },
    { "t": [116.1, 117.1], "ja": "いや、やめて" },
    { "t": [117.1, 118.2], "ja": "イカ・ドラキュラだよ" },
    { "t": [118.2, 119.4], "ja": "もうやった？" },
    { "t": [121.2, 122.8], "ja": "見当違いよ、ファイロ" },
    { "t": [122.8, 123.4], "ja": "どういう意味？" },
    { "t": [124.3, 125.6], "ja": "アンディは新しいジェリーにはならない" },
    { "t": [125.6, 127], "ja": "何があっても恥ずかしがらないもの" },
    { "t": [127, 129], "ja": "恥を知らない巨大な子犬みたいなものよ" },
    { "t": [129, 131.8], "ja": "あなたに必要なのは、職場の新入りよ" },
    { "t": [131.8, 133.8], "ja": "それか、みんなが僕をからかうのをやめればいいんだけど" },
    { "t": [133.8, 134.7], "ja": "うん、それはない" },
    { "t": [137.2, 139.2], "ja": "虚栄のかがり火だな" },
    { "t": [139.2, 140.6], "ja": "ファイロ・パイロ" },
    { "t": [140.6, 141.3], "ja": "冗談だろ？" },
    { "t": [142.1, 145.4], "ja": "ねえ、ジェリーがいなくなったから、穴埋めに誰かを雇う必要があるよ" },
    { "t": [145.4, 146.8], "ja": "職場に新しい人を？" },
    { "t": [146.8, 147.8], "ja": "人じゃないよ" },
    { "t": [147.8, 148.8], "ja": "インターンだよ" },
    { "t": [149.4, 151.6], "ja": "いったいなぜインターンを雇う必要がある？" },
    { "t": [151.6, 154.6], "ja": "インターンは税金が一切かからない" },
    { "t": [154.6, 157.1], "ja": "それに何より、たいていばかでひどいんだ" },
    { "t": [157.1, 158.2], "ja": "だから仕事は全然進まない" },
    { "t": [158.2, 159.8], "ja": "給料がいらないジェリーみたいなものだよ" },
    { "t": [159.8, 160.4], "ja": "やるじゃないか" },
    { "t": [160.4, 161.9], "ja": "それは実に説得力のある話だ" },
    { "t": [162.6, 164], "ja": "その調子だ、ファイロ" },
    { "t": [164, 166.3], "ja": "いつかこの役所を本当に壊せるかもしれん" },
    { "t": [170.3, 172.3], "ja": "ねえ、ここを抜け出さない？" },
    { "t": [173.2, 175.2], "ja": "仕事は始まったばかりですよ、ミーグルさん" },
    { "t": [175.2, 176.8], "ja": "ええ、でも私たちのお仕事は始まったばかりなの" },
    { "t": [176.8, 177.6], "ja": "わかるでしょ？" },
    { "t": [177.6, 179.8], "ja": "ねえドナ、その新しい若い彼氏は誰？" },
    { "t": [179.8, 181.4], "ja": "テイラーです。新しいインターンです" },
    { "t": [181.4, 182.2], "ja": "これが新しいインターン？" },
    { "t": [182.2, 183], "ja": "冗談だろ？" },
    { "t": [183, 185.3], "ja": "ええ、妹のナタリーと同じ高校だったの" },
    { "t": [185.3, 186.8], "ja": "アメフト部のスターだったのよ" },
    { "t": [187.5, 190.7], "ja": "へえ、筋肉ばかの体育会系ってわけ？" },
    { "t": [190.7, 194.5], "ja": "実は、牧師さんがホームレスの保護施設を運営するのを手伝うために、最終学年でアメフトをやめたんです" },
    { "t": [194.5, 197.8], "ja": "へえ、そんなにホームレスが好きなら、結婚すればいいのにね" },
    { "t": [197.8, 200.2], "ja": "誰だって彼と結婚できたら幸せよ" },
    { "t": [200.2, 202.1], "ja": "なあ、テイラー、俺とエイプリルと結婚しない？" },
    { "t": [202.1, 204.4], "ja": "そうしたいけど、俺は結婚するタイプじゃないんだ" },
    { "t": [204.4, 207], "ja": "あげられる愛がたくさんあるから、それに枠をはめるのは不公平な気がして" },
    { "t": [208.2, 208.9], "ja": "彼、分かってる" },
    { "t": [209.7, 210.6], "ja": "本当に分かってるね" },
    { "t": [214.9, 217.3], "ja": "ロン、僕が悲しいかどうか聞いて" },
    { "t": [218.2, 218.5], "ja": "聞かない" },
    { "t": [218.5, 220.5], "ja": "ロン、僕が新しいジェリーなんだ" },
    { "t": [221.3, 223.7], "ja": "で、泣き言を言って何か変わるのか？" },
    { "t": [223.7, 225.3], "ja": "いじめられ役にはなりたくないだろう" },
    { "t": [225.3, 226.6], "ja": "自分の身は自分で守れ" },
    { "t": [226.6, 228.2], "ja": "わかってないよ、ロン" },
    { "t": [228.2, 230.2], "ja": "僕はもうジェリーだったことがあるんだ" },
    { "t": [230.2, 233.3], "ja": "サウスカロライナのやせっぽちのインド系の子どもで、最悪だった" },
    { "t": [233.3, 236], "ja": "12年かかったけど、生まれ変わったんだ" },
    { "t": [236, 237], "ja": "今は会社の経営者だ" },
    { "t": [237, 238.1], "ja": "イケてるスーツを着てる" },
    { "t": [238.1, 239.2], "ja": "毛皮のパンツもはいてる" },
    { "t": [239.2, 241.4], "ja": "でも全部むだだった" },
    { "t": [241.4, 242.5], "ja": "またジェリーに逆戻りだ" },
    { "t": [244.3, 244.7], "ja": "わかったよ" },
    { "t": [244.7, 247.6], "ja": "スウェットパンツとニコラス・スパークスの小説を買ってくる" },
    { "t": [247.6, 248.7], "ja": "どうせならとことんなりきってやる" },
    { "t": [250.2, 251.8], "ja": "トムは自分で何とかできる" },
    { "t": [251.8, 252.7], "ja": "大人の男だ" },
    { "t": [253.4, 254.5], "ja": "まあ、半分大人だな" },
    { "t": [254.5, 257.4], "ja": "12歳の子どもに自分の服を貸し出す商売をしているからな" },
    { "t": [258.5, 258.9], "ja": "やあ" },
    { "t": [259.9, 261.1], "ja": "ジェリー、ここで何してるの？" },
    { "t": [261.1, 262.3], "ja": "クビになったと思ってた" },
    { "t": [262.3, 263.4], "ja": "クビじゃないよ" },
    { "t": [263.4, 264.3], "ja": "退職したんだ" },
    { "t": [264.3, 265.6], "ja": "みんなそう言うんだよね" },
    { "t": [265.6, 267.6], "ja": "ジェリーに来てもらうよう頼んだのは私だ" },
    { "t": [267.6, 270.6], "ja": "あの新しいインターンはうまくいかなかったから、辞めさせた" },
    { "t": [270.6, 274.2], "ja": "もう一度言うけど、全力で反対します" },
    { "t": [274.2, 276], "ja": "今回も、承知した" },
    { "t": [276, 279.5], "ja": "それから、ジェリーには週に2、3時間来てもらうよう頼んだ" },
    { "t": [279.5, 281.3], "ja": "正式な後任が見つかるまでな" },
    { "t": [281.3, 283.1], "ja": "せっかくいなくなったと思ったのに？" },
    { "t": [283.1, 284], "ja": "うーん、どうかな、ロン" },
    { "t": [284, 285.4], "ja": "わかってるのか？" },
    { "t": [285.4, 289.7], "ja": "ジェリーは週に1回来る。みんなで彼が食べるところを眺めて" },
    { "t": [289.7, 293.3], "ja": "彼がやることや言うこと、おならについて何でも話せるんだ" },
    { "t": [294.7, 295.8], "ja": "おかえり、ジェリー" },
    { "t": [295.8, 296.4], "ja": "ああ、ありがとう" },
    { "t": [296.4, 298], "ja": "ああ、ただここにいられるだけで…" },
    { "t": [300.6, 302.7], "ja": "…お決まりの新入りだな" }
  ]
}
