{
  "video": "-3qsZ2HTmKQ",
  "lines": [
    { "t": [0, 1.6], "ja": "何を着てるんだ？" },
    { "t": [1.6, 4], "ja": "え？カジュアルな交流用の服だ" },
    { "t": [4, 5.8], "ja": "魚のフライのパーティーに行くみたいだね、ドワイト" },
    { "t": [5.8, 7.3], "ja": "違う、オオカミが月に向かって吠えてるんだ" },
    { "t": [7.3, 10.3], "ja": "女性をその気にさせるんだ。吠えるのは夜の営みを連想させるからな" },
    { "t": [10.3, 11.4], "ja": "そうか" },
    { "t": [11.4, 12.9], "ja": "…" },
    { "t": [12.9, 13.9], "ja": "それは不適切だよ" },
    { "t": [13.9, 15.5], "ja": "…" },
    { "t": [15.5, 17], "ja": "最低だ。最低だぞ、ドワイト" },
    { "t": [17, 18.6], "ja": "…" },
    { "t": [18.6, 20.4], "ja": "…" },
    { "t": [20.4, 22.4], "ja": "よし、よし、さあ行くぞ" },
    { "t": [22.4, 24], "ja": "…" },
    { "t": [24, 26.1], "ja": "いや、それはやめたほうがいい" },
    { "t": [26.1, 28.2], "ja": "いいかつらなんてものは存在しないよ" },
    { "t": [28.2, 30.8], "ja": "ああ、でもそれは君だから言えるんだよ、オスカー" },
    { "t": [30.8, 34.9], "ja": "君にはその豊かで美しいラテン系の髪があるからね" },
    { "t": [34.9, 36.6], "ja": "すごく素敵だ" },
    { "t": [38.3, 40.3], "ja": "彼は農場が心配なんだよね？" },
    { "t": [40.3, 42.5], "ja": "モーズはひとりで馬の去勢をするのが嫌いなんだ" },
    { "t": [42.5, 44.4], "ja": "ドワイト、ドワイト、農場の話はやめろ" },
    { "t": [44.4, 46.3], "ja": "共感できないんだよ。農場なんて誰も持ってない" },
    { "t": [46.3, 48.5], "ja": "待って、馬が心配なの？" },
    { "t": [48.5, 50.2], "ja": "素敵ね" },
    { "t": [50.2, 52.2], "ja": "馬は何頭いるの？" },
    { "t": [52.2, 54], "ja": "9頭と4分の3だ" },
    { "t": [54, 57], "ja": "「バーガー・オン・ザ・ゴー」という装置を発明した" },
    { "t": [57, 60.1], "ja": "普通サイズのハンバーガーを6個" },
    { "t": [60.1, 64.6], "ja": "または小さいバーガーを12個、馬を殺さずに取り出せる" },
    { "t": [64.6, 66.5], "ja": "ジョージ・フォアマン社はまだ検討中だ" },
    { "t": [66.5, 68], "ja": "シャーパー・イメージ社もまだ検討中だ" },
    { "t": [68, 69.3], "ja": "スカイモール社もまだ検討中だ" },
    { "t": [69.3, 72.6], "ja": "ハマッカー・シュレンマー社もまだ検討中だ" },
    { "t": [72.6, 74.9], "ja": "シアーズには断られた" },
    { "t": [74.9, 87], "ja": "「トイ・ストーリー」「ファインディング・ニモ」「カールじいさんの空飛ぶ家」、ずっと号泣だよ" },
    { "t": [87, 88.6], "ja": "ピクサーは見られないんだ" },
    { "t": [88.6, 89.5], "ja": "マイケル。なんだ" },
    { "t": [89.5, 90.6], "ja": "この女はもういい。退屈だ" },
    { "t": [90.6, 91.4], "ja": "なんで？" },
    { "t": [91.4, 93.8], "ja": "双子を見つけた" },
    { "t": [93.8, 96.2], "ja": "なんと。双子か" },
    { "t": [96.2, 97.7], "ja": "ごめんね。わかってくれるよね" },
    { "t": [97.7, 99.3], "ja": "会えてよかったよ" },
    { "t": [99.3, 105.9], "ja": "見事じゃないか？" },
    { "t": [105.9, 107.9], "ja": "男じゃないか、ドワイト" },
    { "t": [107.9, 110], "ja": "いい双子を見つけるのは最高だ" },
    { "t": [110, 112], "ja": "お前はどこかおかしいよ" },
    { "t": [112, 113.9], "ja": "いい双子じゃないだろ" },
    { "t": [113.9, 115], "ja": "いい双子じゃないだろ" },
    { "t": [115, 115.9], "ja": "いい双子じゃないだろ" }
  ]
}
