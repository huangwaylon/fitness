    { "t": [144.5,145], "ja": "全然" },
    { "t": [145,146], "ja": "いいか、レスリー" },
    { "t": [146,147], "ja": "君の仕事は" },
    { "t": [147,148.5], "ja": "君はそれが得意だが" },
    { "t": [148.5,150], "ja": "俺をよく見せることだ" },
