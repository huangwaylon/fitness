  "lines": [
    { "t": [0,1.5], "ja": "郵便が来たよ" },
    { "t": [1.5,3.5], "ja": "あっ！　ねえ" },
    { "t": [3.5,7.5], "ja": "ジェリー、郵便にスープをこぼしまくって、このまぬけ" },
    { "t": [7.5,10.5], "ja": "うそ、インディアナ女性協会の表彰事務局からの封筒よ" },
    { "t": [10.5,12.5], "ja": "みんな、落ち着いて" },
    { "t": [12.5,15], "ja": "これが何を意味するか分かる？" },
    { "t": [15,17.5], "ja": "私がポーニーの今年の女性なのよ" },
    { "t": [17.5,20.5], "ja": "インディアナ女性協会っていうのは、インディアナ州の女性の団体なの" },
    { "t": [20.5,23.5], "ja": "私は9歳の時から会費を払ってる会員で" },
    { "t": [23.5,25.5], "ja": "毎年、女性を一人選んで" },
    { "t": [25.5,28.5], "ja": "ドロシー・エバートン・スマイス女性エンパワーメント賞を贈るの" },
    { "t": [28.5,30.5], "ja": "受賞はすべての女の子の夢" },
    { "t": [30.5,32.5], "ja": "でも、私にとっては運命なの" },
    { "t": [32.5,34], "ja": "そして夢でもある" },
    { "t": [34,35], "ja": "読んでくれる？" },
    { "t": [35,38], "ja": "女子のみんな、集まって！" },
    { "t": [38,40], "ja": "じゃあ読むね" },
    { "t": [40,42], "ja": "インディアナ女性協会は誇りを持って発表します" },
    { "t": [42,44], "ja": "今年のドロシー・エバートン・スマイス" },
    { "t": [44,46], "ja": "女性エンパワーメント賞の受賞者は" },
    { "t": [46,48], "ja": "ロナルド・スワンソン" },
    { "t": [48,49], "ja": "あはは、はいはい、なかなか面白いね" },
    { "t": [49,50], "ja": "ロナルド・スワンソンって書いてある" },
    { "t": [50,52], "ja": "何？　いや、いや、いや、書いてあるって" },
    { "t": [52,54], "ja": "私…　それは…　ちがう" },
    { "t": [54,56], "ja": "それって…　何？" },
    { "t": [56,57], "ja": "女性しか表彰しないのよ" },
    { "t": [57,58.5], "ja": "ロンは女性の正反対じゃない" },
    { "t": [58.5,59.5], "ja": "どうなってるの？" },
    { "t": [59.5,61.5], "ja": "あなたが、えっと、ポーニーの今年の女性" },
    { "t": [61.5,62.5], "ja": "みたいね" },
    { "t": [65.5,66.5], "ja": "ふん、やっとか" },
    { "t": [66.5,68.5], "ja": "いや、いや、いや" },
    { "t": [68.5,70.5], "ja": "絶対に何かの間違いよ" },
    { "t": [70.5,71.5], "ja": "よかったな、俺！" },
    { "t": [71.5,72.5], "ja": "おめでとう、ロン" },
    { "t": [72.5,73.5], "ja": "おめでとう" },
    { "t": [73.5,74.5], "ja": "すごいことだね" },
    { "t": [74.5,75.5], "ja": "最高" },
    { "t": [75.5,77.5], "ja": "賞なんてくだらない" },
    { "t": [77.5,80.5], "ja": "だから、こんなばかげたものはきっぱり断って" },
    { "t": [80.5,83], "ja": "レスリーに渡すよう推薦するつもりだ" },
    { "t": [83,87], "ja": "あいつはすごく頑張ってるし、俺は頑張ってないからな" },
    { "t": [87,89], "ja": "だが" },
    { "t": [89,92], "ja": "あいつはこういうくだらないことを気にしすぎる" },
    { "t": [92,95], "ja": "だから、このチャンスを逃すわけにはいかない" },
    { "t": [95,97], "ja": "からかうチャンスをな" },
    { "t": [97,99], "ja": "さて、一日中ここに突っ立って" },
