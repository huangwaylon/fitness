    { "t": [132,133], "ja": "ふむ" },
    { "t": [133,136], "ja": "まあ、手紙には確かにロン・スワンソンと書いてあったぞ" },
    { "t": [136,138], "ja": "ええ、でも私のキャンプの企画のことも書いてあった" },
    { "t": [138,139], "ja": "ああ、そうだな" },
