    { "t": [165.5,167.5], "ja": "それに、もし立場が逆で" },
    { "t": [167.5,168.5], "ja": "君が賞を取ってたら" },
    { "t": [168.5,170.5], "ja": "俺ならおめでとうって言ってたぞ" },
    { "t": [173.5,174.5], "ja": "おめでとう、ロン" },
    { "t": [174.5,175.5], "ja": "何だって？" },
    { "t": [175.5,176.5], "ja": "聞こえたでしょ" },
    { "t": [178.5,179.5], "ja": "女の子たちに運動場を用意するって約束したでしょ" },
    { "t": [179.5,181.5], "ja": "今週中にね" },
    { "t": [181.5,183.5], "ja": "まあ、ここは男の世界だからな、ウィンストン" },
    { "t": [183.5,184.5], "ja": "慣れることだ" },
