    { "t": [101.5,104], "ja": "どこかのしょぼい女性団体からの賞でな" },
    { "t": [104,105.5], "ja": "みんな、仕事に戻れ" },
    { "t": [113.5,114.5], "ja": "ねえ" },
    { "t": [114.5,115.5], "ja": "封筒には何が入ってたの？" },
