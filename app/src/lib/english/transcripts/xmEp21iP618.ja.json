{
  "video": "xmEp21iP618",
  "lines": [
    { "t": [1,  2], "ja": "ねえ、ママ" },
    { "t": [2,  3.5], "ja": "あら、どうしたの？ 何か用？" },
    { "t": [3.5,  5], "ja": "あの会合って、まだ予定どおり？" },
    { "t": [5,  6], "ja": "お偉いさんとのやつ？" },
    { "t": [6,  8], "ja": "ええ、私の知る限りはね" },
    { "t": [8,  12], "ja": "会合の日を変えたら、変に思われるかな？" },
    { "t": [12,  16], "ja": "まあ、ちょっと当てにならない人に見えるかもね" },
    { "t": [16,  18], "ja": "それがあなたの与えたい印象なら別だけど" },
    { "t": [18,  21], "ja": "当てにならないのは、政治家として最悪" },
    { "t": [21,  24], "ja": "あとは汚職。それか強姦魔" },
    { "t": [24,  26], "ja": "政治には落とし穴がたくさんあるけど" },
    { "t": [26,  27], "ja": "その3つが一番大きいの" },
    { "t": [27,  29], "ja": "それで、この人について知っておくべきことはある？" },
    { "t": [29,  31], "ja": "政治的な経歴は？" },
    { "t": [31,  33], "ja": "名前はジョージ・ガーンウェイ" },
    { "t": [33,  35], "ja": "イーグルトン市の、行政の責任者よ" },
    { "t": [35,  37], "ja": "離婚していて、子どもが2人" },
    { "t": [37,  39], "ja": "よし、知れてよかった。知識は力なり" },
    { "t": [39,  43], "ja": "フランシス・ベーコン。それか、メアリー・ジェイ・ブライジ" },
    { "t": [43,  45], "ja": "レスリーは、あまりデートをしないの" },
    { "t": [45,  47], "ja": "男の人とはあまり出会わないのよ、記録保管所とか" },
    { "t": [47,  50], "ja": "公立図書館とか、デパートの靴売り場じゃね" },
    { "t": [50,  54], "ja": "だから、行政の会議で会った政策オタクを、デート相手に紹介したの" },
    { "t": [54,  56], "ja": "市の条例の話ばかりする人なの" },
    { "t": [56,  58], "ja": "きっと気に入るわ" },
    { "t": [58,  59], "ja": "よかった" },
    { "t": [59,  61], "ja": "それを着ていくの？" },
    { "t": [61,  63], "ja": "ううん、もう少しきちんとした" },
    { "t": [63,  64], "ja": "ボタンを上まで留めたのを着るつもり" },
    { "t": [64,  65], "ja": "台無しにしたくないから" },
    { "t": [65,  67], "ja": "もう少しおしゃれなのにしてみたら？" },
    { "t": [67,  71], "ja": "ローラ・ブッシュ風のおしゃれ？ それともミシェル・オバマ風？" },
    { "t": [71,  73], "ja": "さて、ご存じのとおり、私たちは公園と" },
    { "t": [73,  75], "ja": "住宅地を作ることになっています" },
    { "t": [75,  77], "ja": "なので、もちろん用途地域の条例を" },
    { "t": [77,  79], "ja": "市議会に承認・改正してもらう必要があります" },
    { "t": [79,  82], "ja": "どんな映画が好き？" },
    { "t": [82,  83], "ja": "え？" },
    { "t": [83,  89], "ja": "えーと、まあ、ドキュメンタリーとか、政治スリラーとか" },
    { "t": [89,  91], "ja": "僕は、どんな映画も好きだよ" },
    { "t": [91,  92], "ja": "いいですね" },
    { "t": [92,  95], "ja": "それで、土地の写真を持ってきたんですけど" },
    { "t": [95,  98], "ja": "家がすごく近いのが分かりますよね" },
    { "t": [98,  100], "ja": "そちらの町では、用途地域の変更ってどれくらい大変ですか？" },
    { "t": [100,  102], "ja": "少し詳しく話してもらえますか？" },
    { "t": [102,  103], "ja": "いいよ" },
    { "t": [103,  104], "ja": "よかった" },
    { "t": [104,  106], "ja": "新鮮だな、本当に好きな人といるのは" },
    { "t": [106,  108], "ja": "行政の話をするのがね" },
    { "t": [108,  111], "ja": "僕がデートする女性のほとんどは、退屈だって言うから" },
    { "t": [111,  113], "ja": "まあ、ほら、用途地域の条例がないと" },
    { "t": [113,  115], "ja": "すべてがめちゃくちゃになりかねませんから" },
    { "t": [115,  118], "ja": "君は、すごくきっちりした人なんだね？" },
    { "t": [118,  119], "ja": "ええ" },
    { "t": [119,  120], "ja": "そこがいい" },
    { "t": [120,  122], "ja": "お母さんが、君はあまりデートしないって言ってたよ" },
    { "t": [122,  123], "ja": "え？" },
    { "t": [123,  127], "ja": "仕事に集中してきたので" },
    { "t": [127,  128], "ja": "どうしてそんなことを？" },
    { "t": [128,  131], "ja": "ああ、僕もあまりデートしてないからさ" },
    { "t": [131,  132], "ja": "離婚してから" },
    { "t": [132,  135], "ja": "僕は、えー、まあ、楽じゃなかった" },
    { "t": [135,  138], "ja": "何とかやってるけど、子どもたちにはつらかったんだ" },
    { "t": [138,  141], "ja": "僕の子どもじゃないよ、もう大人だから" },
    { "t": [141,  144], "ja": "つらかったのは、その子どもたちなんだ" },
    { "t": [144,  145], "ja": "ええ" },
    { "t": [145,  147], "ja": "ああ、すまない" },
    { "t": [147,  149], "ja": "あらら" },
    { "t": [149,  150], "ja": "すまない" },
    { "t": [150,  151], "ja": "はい" },
    { "t": [151,  152], "ja": "謝るよ" },
    { "t": [152,  153], "ja": "あら" },
    { "t": [153,  155], "ja": "初デートで離婚の話なんて、するべきじゃないね" },
    { "t": [159,  161], "ja": "でも、君には何でも話せる気がするんだ" },
    { "t": [165,  166], "ja": "はい" },
    { "t": [166,  167], "ja": "はい" },
    { "t": [167,  169], "ja": "もっとワインを飲もう" },
    { "t": [169,  171], "ja": "今夜の流れにまかせよう" },
    { "t": [173,  176], "ja": "彼、デートだと思ってる" },
    { "t": [176,  177], "ja": "これがデートだって言ったの？" },
    { "t": [177,  178], "ja": "デートでしょ" },
    { "t": [178,  180], "ja": "何だと思ってたの？" },
    { "t": [180,  182], "ja": "政治戦略の打ち合わせ" },
    { "t": [182,  184], "ja": "レスリー、あなたも若くはないのよ" },
    { "t": [184,  185], "ja": "まあ、彼もね" },
    { "t": [185,  187], "ja": "しかも62歳よ" },
    { "t": [187,  189], "ja": "かなりうまくいってると思う" },
    { "t": [189,  192], "ja": "それに、彼女は若い頃のサンディ・ダンカンに似てる" },
    { "t": [192,  195], "ja": "ほら、戻って夕食を済ませなさい" },
    { "t": [195,  196], "ja": "デートだと思わせておけばいいの" },
    { "t": [196,  199], "ja": "嫌なら、彼と寝なくてもいいから" },
    { "t": [199,  200], "ja": "何？" },
    { "t": [200,  201], "ja": "頭おかしいの？" },
    { "t": [201,  202], "ja": "よかった" },
    { "t": [202,  203], "ja": "やあ、元気？" }
  ]
}
