{
  "video": "WxOtlGmyiSw",
  "lines": [
    { "t": [0.5,2.9], "ja": "うわ、新しい職場を見てよ" },
    { "t": [2.9,4], "ja": "ここ、すごすぎる" },
    { "t": [4,5.1], "ja": "来てくれてありがとう、みんな" },
    { "t": [5.1,7.7], "ja": "すごく忙しくて、手を貸してほしいんだ" },
    { "t": [7.7,8.6], "ja": "パス" },
    { "t": [8.6,10.9], "ja": "わざわざここまで来て、手伝うのを断るの？" },
    { "t": [10.9,12.6], "ja": "うん、あなたがどんな顔をするか見たかったの" },
    { "t": [12.6,14.1], "ja": "断った時にね" },
    { "t": [14.1,15.3], "ja": "来た価値は完全にあったわ" },
    { "t": [16.4,17.9], "ja": "アンディ、大丈夫？" },
    { "t": [17.9,18.6], "ja": "ああ、平気だよ" },
    { "t": [18.6,21.1], "ja": "ただ、人生は無意味で、何も大事じゃなくて" },
    { "t": [21.1,22.3], "ja": "いつも疲れてるだけ" },
    { "t": [22.3,23.6], "ja": "それに眠れないし" },
    { "t": [23.6,24.7], "ja": "食べすぎてる" },
    { "t": [24.7,26.9], "ja": "昔の趣味にも興味がわかないんだ" },
    { "t": [26.9,29.4], "ja": "アンディは警察学校の試験に落ちてから" },
    { "t": [29.4,32.2], "ja": "すっかり自信をなくしちゃったの" },
    { "t": [32.2,33.7], "ja": "いつも悲しそうで、汗をかいてる" },
    { "t": [34.9,37.4], "ja": "いつもなら、楽しそうで汗をかいてるのに" },
    { "t": [37.4,39.6], "ja": "明日までに最初の寄付先を選ばなきゃいけないのに" },
    { "t": [39.6,41.9], "ja": "応募が山ほどあるんだ" },
    { "t": [41.9,43.8], "ja": "仕分けを手伝ってくれる？" },
    { "t": [43.8,44.6], "ja": "ねえ" },
    { "t": [44.6,46.4], "ja": "楽しそうじゃない、ハニー" },
    { "t": [46.4,48.3], "ja": "ほら、手伝ってあげよう" },
    { "t": [48.3,49.5], "ja": "楽しいわよ" },
    { "t": [49.5,51.5], "ja": "まあ、君たちで何とかなりそうだね" },
    { "t": [51.5,52.3], "ja": "俺はもう行くよ" },
    { "t": [52.3,54.1], "ja": "実は自分の慈善団体の用事があってさ" },
    { "t": [54.1,55.9], "ja": "トミーのおなか基金っていうんだ" },
    { "t": [55.9,57.4], "ja": "まあ、ここでは豪華なランチが出るんだ" },
    { "t": [57.4,58.9], "ja": "残るなら、少し食べていいよ" },
    { "t": [58.9,60.1], "ja": "何？" },
    { "t": [60.1,61.6], "ja": "カニのキャビア？" },
    { "t": [61.6,64.1], "ja": "トミーのおなか基金を代表して" },
    { "t": [64.1,67.1], "ja": "このありがたいご寄付を喜んでお受けします" },
    { "t": [67.1,69.1], "ja": "ベン？" },
    { "t": [69.1,70.5], "ja": "ベン？" },
    { "t": [70.5,71.3], "ja": "何だい、アンディ" },
    { "t": [71.3,72.9], "ja": "見つけたかもしれないんだ" },
    { "t": [72.9,74.1], "ja": "けっこういいものをさ" },
    { "t": [74.1,75.3], "ja": "分かった、とりあえず横に置いておいて" },
    { "t": [75.3,76.3], "ja": "あとで読むよ" },
    { "t": [76.3,77.6], "ja": "だめ、アンディが見つけたんだから" },
    { "t": [77.6,79.4], "ja": "今すぐ説明してくれるわよ" },
    { "t": [79.4,80.8], "ja": "さあ、ハニー" },
    { "t": [80.8,84.1], "ja": "レッドウッド音楽プログラムっていうんだ" },
    { "t": [84.1,87.4], "ja": "問題を抱えた子どもたちのための放課後の音楽教室なんだ" },
    { "t": [87.4,89], "ja": "子どもたちが路上に出ないようにできる" },
    { "t": [89,89.8], "ja": "へえ" },
    { "t": [89.8,92.5], "ja": "それに知ってのとおり、路上は危ない" },
    { "t": [92.5,94.5], "ja": "たとえば、僕は一回マンホールに落ちたことがある" },
    { "t": [94.5,95.7], "ja": "一日中そこにいたんだ" },
    { "t": [95.7,99.1], "ja": "結論として、子どもたちをこれ以上マンホールで暮らさせるわけにはいかない" },
    { "t": [99.1,101.7], "ja": "レッドウッド音楽プログラム、頑張れ" },
    { "t": [101.7,103.9], "ja": "裁判長、アーメン" },
    { "t": [103.9,105], "ja": "いいアイデアだね" },
    { "t": [105,107.3], "ja": "ほかに何かいいものを見つけた人は？" },
    { "t": [107.3,110.1], "ja": "トム？" },
    { "t": [110.1,111.2], "ja": "えっと、うん" },
    { "t": [111.2,113.3], "ja": "いいのがあるよ" },
    { "t": [113.3,116.9], "ja": "クリーン・シート基金っていうんだ" },
    { "t": [116.9,118.8], "ja": "これが俺の推し" },
    { "t": [118.8,122.4], "ja": "そこは、ケー・ケー・ケーに法律の手助けをしてるのよ" },
    { "t": [122.4,123.9], "ja": "これがあなたの推しなの？" },
    { "t": [123.9,125.7], "ja": "ああ、ボンボン取ってくれる？" },
    { "t": [125.7,129.5], "ja": "トム、それ今かけなきゃいけないの？" },
    { "t": [129.5,130.4], "ja": "いや、ベン" },
    { "t": [130.4,133.1], "ja": "このスムージーは勝手に混ざってくれないからさ" },
    { "t": [137.2,138], "ja": "分かった" },
    { "t": [140.1,142.9], "ja": "決まったと思う" },
    { "t": [142.9,145], "ja": "ルーラル・アンビュケアっていうんだ" },
    { "t": [145,146.7], "ja": "病院から遠くに住んでる人のために" },
    { "t": [146.7,148.7], "ja": "救急車を買いたいんだって" },
    { "t": [148.7,149.8], "ja": "救急車なんてくだらない" },
    { "t": [149.8,151.2], "ja": "救急車が誰かの役に立ったことなんてある？" },
    { "t": [151.2,152.9], "ja": "アンディの音楽のはどうなの？" },
    { "t": [152.9,154], "ja": "まあ、これはすごく大事な活動だよ" },
    { "t": [154,155.8], "ja": "困ってる人をたくさん助けられる" },
    { "t": [155.8,156.8], "ja": "ごめんね、アンディ" },
    { "t": [156.8,157.7], "ja": "なんで？" },
    { "t": [157.7,159], "ja": "いや、全然いいよ" },
    { "t": [159,159.9], "ja": "あの人たちのためにうれしいよ" },
    { "t": [159.9,160.9], "ja": "最高じゃん" },
    { "t": [160.9,161.7], "ja": "ねえ、僕がこれから何するか分かる？" },
    { "t": [161.7,163.9], "ja": "車のほうに行ってくる" },
    { "t": [163.9,165.5], "ja": "ここ、ちょっと暑くて、少し汗かいちゃった" },
    { "t": [165.5,167.5], "ja": "まあ、すごくがっかりしたけど" },
    { "t": [167.5,170.2], "ja": "お医者さんとかキリンとか" },
    { "t": [170.2,172.5], "ja": "何を助けることにしたにせよ" },
    { "t": [172.5,176.4], "ja": "その何かをどうにかすることに、きっと大喜びするだろうね" },
    { "t": [176.4,177.2], "ja": "じゃあ、俺は帰るよ" },
    { "t": [177.2,180.2], "ja": "よくやった、みんな" },
    { "t": [180.2,181.2], "ja": "何？" },
    { "t": [181.2,182.7], "ja": "アンディは警察の試験に落ちてから" },
    { "t": [182.7,184.2], "ja": "すごく落ちこんでたの" },
    { "t": [184.2,185.5], "ja": "くだらない寄付先を選ぶのが" },
    { "t": [185.5,187.2], "ja": "ここ何週間かで一番うれしそうだったのに" },
    { "t": [187.2,188.5], "ja": "あなたって本当に自分勝手" },
    { "t": [188.5,189.4], "ja": "自分勝手？" },
    { "t": [189.4,190.7], "ja": "慈善団体をやってるんだよ" },
    { "t": [190.7,193.3], "ja": "あら、結局あなたのやってることが一番大事なのね" },
    { "t": [193.3,194.2], "ja": "いかにもベンらしいわ" },
    { "t": [194.2,198.2], "ja": "ごめん、カキを忘れてた" },
    { "t": [198.2,199.2], "ja": "今日はよくやったな" }
  ]
}
