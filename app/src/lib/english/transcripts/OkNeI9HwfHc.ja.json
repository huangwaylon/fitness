{
  "video": "OkNeI9HwfHc",
  "lines": [
    { "t": [0,1.5], "ja": "誕生日月間だよ" },
    { "t": [1.5,4.4], "ja": "クリードは今日、オスカーは再来週" },
    { "t": [4.4,6.5], "ja": "メレディスは月末" },
    { "t": [6.5,8.4], "ja": "マイケルはいつも赤と白の飾りを使って…" },
    { "t": [8.4,9.9], "ja": "あのさ、考えがあるんだけど" },
    { "t": [9.9,12.9], "ja": "ひとつの大きなパーティーで、まとめてお祝いしない？" },
    { "t": [12.9,13.7], "ja": "え？" },
    { "t": [13.7,16.2], "ja": "このオフィスでは13人が働いてる" },
    { "t": [16.2,21], "ja": "だから年に13回、マイケルはケーキと風船と" },
    { "t": [21,25.2], "ja": "何かしらの冗談のプレゼントを用意して、乾杯のあいさつをするんだ" },
    { "t": [25.2,26.3], "ja": "そのあいさつには2種類ある" },
    { "t": [26.3,29.1], "ja": "ひとつは、年を取ったことをネタにする冗談" },
    { "t": [29.1,30.6], "ja": "「そのしわを見てみろ」" },
    { "t": [30.6,33.3], "ja": "「黒人はクラックしない…いや、薬のクラックじゃなくて」" },
    { "t": [33.3,36.8], "ja": "もうひとつは、何か不適切なことか、ひどいこと" },
    { "t": [36.8,40.2], "ja": "あるいはその両方。ほかには？" },
    { "t": [40.2,42.3], "ja": "「ハッピー・バースデー」は、高いハモりのパートしか歌わない" },
    { "t": [42.3,48.1], "ja": "それに、サプライズパーティーの大ファンなんだ" },
    { "t": [48.1,50.9], "ja": "もしかすると、ちょっと行き過ぎなくらいにね" },
    { "t": [50.9,52.3], "ja": "誕生日おめでとう！" },
    { "t": [52.3,53.8], "ja": "誕生日おめでとう！" },
    { "t": [53.8,58.2], "ja": "誕生日おめでとう！" },
    { "t": [58.2,60.2], "ja": "だから、まあ、そうだな" },
    { "t": [60.2,63.7], "ja": "まとめて済ませちゃうのは、効率的かもしれないと思うんだ" },
    { "t": [63.7,64.7], "ja": "（音楽）" },
    { "t": [64.7,65.1], "ja": "（音楽）" },
