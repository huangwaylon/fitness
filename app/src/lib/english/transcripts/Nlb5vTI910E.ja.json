  "lines": [
    { "t": [0, 1], "ja": "これがあるの。レスリー！" },
    { "t": [1, 2], "ja": "やあ" },
    { "t": [2, 3], "ja": "やあ" },
    { "t": [3, 4], "ja": "これは私の彼氏のデレク" },
    { "t": [4, 5], "ja": "こっちはデレクの彼氏のベン" },
    { "t": [5, 6], "ja": "やあ" },
    { "t": [6, 7], "ja": "やあ" },
    { "t": [7, 8], "ja": "あら" },
    { "t": [8, 9], "ja": "待って、ごめん" },
    { "t": [9, 10], "ja": "どういう状況なの？" },
    { "t": [10, 11], "ja": "どういう意味？" },
    { "t": [11, 13], "ja": "どういう仕組みなの？" },
    { "t": [13, 15], "ja": "デレクはゲイだけど、私に対してはストレートなの" },
    { "t": [15, 17], "ja": "でもベンに対してはゲイで、ベンもデレクに対して本当にゲイなの" },
    { "t": [17, 18], "ja": "それで、私はベンが嫌い" },
    { "t": [18, 19], "ja": "そんなに複雑じゃないでしょ" },
    { "t": [19, 20], "ja": "ううん" },
    { "t": [20, 21], "ja": "ああ" },
    { "t": [21, 22], "ja": "うん" },
    { "t": [22, 23], "ja": "なるほど" },
    { "t": [23, 26], "ja": "若者の文化っていうのは、私には理解できないのよね" },
    { "t": [26, 28], "ja": "それで、何かご用？" },
    { "t": [28, 29], "ja": "二人とも、あなたにどうしても会いたかったの" },
    { "t": [29, 32], "ja": "あなたは今、二人のヒーローみたいなものだから" },
    { "t": [32, 33], "ja": "まあ" },
    { "t": [33, 34], "ja": "あら、エイプリル" },
    { "t": [34, 35], "ja": "やめてよ" },
    { "t": [35, 36], "ja": "ただのペンギンじゃない" },
    { "t": [36, 37], "ja": "いや" },
    { "t": [37, 40], "ja": "私は公務員だから、政治的な立場を取っちゃいけないの" },
    { "t": [40, 42], "ja": "でも取ったじゃない。最高だったよ" },
    { "t": [42, 43], "ja": "うん" },
    { "t": [43, 46], "ja": "ほかの政治家は誰も立場をはっきりさせないから、ゲイの人たちみんなにとってすごく大きな意味があるんだ" },
    { "t": [46, 47], "ja": "わあ" },
    { "t": [47, 48], "ja": "本当にそうなの" },
    { "t": [48, 52], "ja": "それで、明日の夜バルジでパーティーをやるんだけど、お願いしたいことがあって" },
    { "t": [52, 53], "ja": "あなたに" },
    { "t": [53, 55], "ja": "ぜひ、主賓になってほしいの" },
    { "t": [55, 56], "ja": "まあ" },
    { "t": [56, 57], "ja": "来てくれたら最高だな" },
    { "t": [57, 58], "ja": "うん、来なきゃだめだよ" },
    { "t": [58, 59], "ja": "これ、誰が作ったの？" },
    { "t": [62, 63], "ja": "どうやって？" },
    { "t": [63, 64], "ja": "フォトショップ" },
    { "t": [64, 65], "ja": "何？" },
    { "t": [65, 66], "ja": "パソコンだよ" },
    { "t": [66, 67], "ja": "ああ" },
    { "t": [67, 68], "ja": "ねえ" },
    { "t": [68, 69], "ja": "なんで、そんなにおめかししてるの？" },
    { "t": [69, 71], "ja": "ああ、長い話なの" },
    { "t": [71, 74], "ja": "今夜、ゲイバーで主賓になるのよ" },
    { "t": [74, 76], "ja": "ゲイの人たちに好かれ始めたみたい" },
    { "t": [76, 77], "ja": "よく分からないけど" },
    { "t": [77, 79], "ja": "私のこと、すてきだとか思ってるのかもね" },
    { "t": [79, 80], "ja": "まあ、似合ってるわよ、あなた" },
    { "t": [80, 80.1], "ja": "今夜は誰かをストレートにしちゃうかもね" },
    { "t": [80.1, 92], "ja": "あれは間違いなく、ドナとの今までで一番の会話だった" },
    { "t": [92, 98], "ja": "レスリー、こちらは家族安定協会財団のマーシャ・ラングマンさん" },
    { "t": [98, 99], "ja": "あら、こんにちは" },
    { "t": [99, 100], "ja": "すてきなお話ね" },
    { "t": [100, 101], "ja": "まあ、どうもありがとうございます" },
    { "t": [101, 105], "ja": "昨日の動物園での出来事について、少しお話しできればと思いまして" },
    { "t": [105, 108], "ja": "いや、私はこの件に関係ないので" },
    { "t": [108, 113], "ja": "それで、あなたと家族安定協会財団のすばらしい皆さんのために、私にできることは？" },
    { "t": [113, 119], "ja": "そうね、もしよければ、辞めていただけるとうれしいんですけど" },
    { "t": [119, 121], "ja": "まあ、本気なんですか？" },
    { "t": [121, 127], "ja": "あなたは税金を使って、公共の場所で、ゲイのペンギンの結婚式を行いました" },
    { "t": [127, 132], "ja": "それは、同性婚の推進に賛成する立場を、象徴的に示したということです" },
    { "t": [132, 135], "ja": "あら、すみません、でもちょっと待ってください、マーシャ" },
    { "t": [135, 138], "ja": "そんなつもりは全然なかったんです" },
    { "t": [138, 140], "ja": "じゃあ、ほかにどんな理由でペンギンを結婚させるの？" },
    { "t": [140, 143], "ja": "かわいいだろうって、固く信じてたからです" },
    { "t": [143, 145], "ja": "実際、かわいかったし" },
    { "t": [145, 146], "ja": "レスリー、あなた結婚してる？" },
    { "t": [146, 147], "ja": "いいえ" },
    { "t": [147, 149], "ja": "えっと、まだです、マーシャ" },
    { "t": [149, 150], "ja": "もうすぐ" },
    { "t": [150, 151], "ja": "たぶん" },
    { "t": [151, 152], "ja": "計画があるんです" },
    { "t": [152, 153], "ja": "でも、いいえ、いいえ" },
    { "t": [153, 154], "ja": "今はまだ" },
    { "t": [154, 155], "ja": "まだ誰とも付き合ってません" },
    { "t": [155, 157], "ja": "仕事に集中してるんです" },
    { "t": [157, 158], "ja": "そうだと思った" },
    { "t": [158, 161], "ja": "だから、あなたには分かるはずがないのよ" },
    { "t": [161, 166], "ja": "同性同士が結婚すると、私たちほかの人の結婚が台なしになるの" },
    { "t": [166, 171], "ja": "だから、結婚式を無効にするか、私が公の場であなたの辞任を求めるか、どちらかね" },
    { "t": [173, 174], "ja": "そうだ" },
    { "t": [174, 175], "ja": "私、道を覚えるのがすごく苦手なの" },
    { "t": [175, 178], "ja": "駐車場に行くには、ここを出て左？それとも右？" },
    { "t": [178, 179], "ja": "左よ、ええ" },
    { "t": [179, 180], "ja": "ありがとう" },
    { "t": [180, 181], "ja": "どういたしまして" },
    { "t": [181, 183], "ja": "結婚式を無効にして！" },
    { "t": [183, 184], "ja": "また今度ね" }
