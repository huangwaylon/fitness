{
  "video": "04TmqfAbKKM",
  "lines": [
    { "t": [0.8,  2.1], "ja": "おはよう、諸君" },
    { "t": [2.7,  4.8], "ja": "本場ニューヨークのベーグルが欲しい人は？" },
    { "t": [5.3,  6.8], "ja": "ん？ スタンリー？" },
    { "t": [7.3,  7.7], "ja": "ありがとう" },
    { "t": [7.8,  10.6], "ja": "いや、いや、いや、いや。君には特別に、ライ麦の黒パンのを用意した" },
    { "t": [11.4,  13], "ja": "わあ。エイチ・アンド・エイチだ" },
    { "t": [13.8,  16.1], "ja": "わざわざニューヨークまでベーグルを買いに行ったの？" },
    { "t": [16.9,  19.1], "ja": "ああ、なぜだ？ もっと近くに売ってる店があるのか？" },
    { "t": [19.6,  21.4], "ja": "本当にうれしい、ドワイト。ありがとう" },
    { "t": [21.7,  22], "ja": "ありがとう" },
    { "t": [22.4,  24.4], "ja": "ああ、礼には及ばない。一つ貸しだ" },
    { "t": [25,  26.1], "ja": "全員、私に一つ借りだ" },
    { "t": [26.6,  27.8], "ja": "おはようございます、マイケル" },
    { "t": [27.9,  28.5], "ja": "おはよう、ドワイト" },
    { "t": [28.7,  29.2], "ja": "お腹すいてません？" },
    { "t": [29.2,  31.5], "ja": "いや。フィッシュスティックのサンドイッチを食べた" },
    { "t": [31.9,  33.5], "ja": "実は、フィッシュスティックのサンドイッチを2つ食べた" },
    { "t": [33.7,  34.8], "ja": "彼女が自分のを食べたくないって言うから" },
    { "t": [34.8,  37.6], "ja": "たぶん、彼女に必要な精力剤は私だけなんだな" },
    { "t": [38,  39.4], "ja": "フィッシュスティックは精力剤じゃありません" },
    { "t": [39.4,  39.7], "ja": "そうか" },
    { "t": [39.7,  40.7], "ja": "それはシカのペニスのことです" },
    { "t": [40.9,  41.3], "ja": "効いたけどな" },
    { "t": [41.6,  43.8], "ja": "とにかく、それは2時間以上前のことで" },
    { "t": [44,  46.8], "ja": "今あなたがお腹をすかせているのは科学的な事実です" },
    { "t": [47.3,  47.6], "ja": "ベーグルは？" },
    { "t": [48,  49.3], "ja": "じゃあ、遠慮なく" },
    { "t": [49.6,  51.1], "ja": "ねえ、チーズも持ってきたぞ" },
    { "t": [51.3,  52.8], "ja": "彼女の分も一つもらっていこう" },
    { "t": [53.2,  53.7], "ja": "素晴らしい" },
    { "t": [53.9,  54.5], "ja": "頭にいい食べ物です" },
    { "t": [54.8,  55.6], "ja": "どうもありがとう" },
    { "t": [55.6,  55.9], "ja": "よし" },
    { "t": [57.9,  58.6], "ja": "貸しだぞ" },
    { "t": [58.9,  61.6], "ja": "男が友だちにベーグルを買ってやって" },
    { "t": [61.6,  63.6], "ja": "貸しを作って、その貸しを使って" },
    { "t": [63.6,  66.3], "ja": "共同部長の座を奪ったやつをクビにする" },
    { "t": [66.3,  67.2], "ja": "なんてことも、もうできないのか？" },
    { "t": [69,  69.4], "ja": "まったく" },
    { "t": [70.3,  72.2], "ja": "いつからみんな、こんなに疑い深くなったんだ？" },
    { "t": [75.1,  77.8], "ja": "やあ、ドワイト、ちょっとしたサプライズがあるんだ" },
    { "t": [78,  78.5], "ja": "当ててやろう" },
    { "t": [78.6,  81], "ja": "私があげたベーグルを食べて、気に入ったんだな" },
    { "t": [81,  81.4], "ja": "そう！" },
    { "t": [82.8,  84.5], "ja": "それで、お返しがしたくて" },
    { "t": [84.9,  86.3], "ja": "ローファーを磨いてたら" },
    { "t": [86.4,  87.7], "ja": "たまたま目に入ったんだけど" },
    { "t": [87.7,  90.1], "ja": "君のブリーフケースがちょっとくたびれてたからさ" },
    { "t": [90.5,  92.1], "ja": "それで、ちょっと手でゴシゴシやって" },
    { "t": [92.3,  95.2], "ja": "ピカピカに磨いて、昔の輝きを取り戻したよ" },
    { "t": [95.8,  97.4], "ja": "ほっぺたに当ててみて" },
    { "t": [98.9,  99.6], "ja": "そうする" },
    { "t": [100.2,  101.2], "ja": "プレゼントをもらったら、ドーン！" },
    { "t": [101.7,  102.2], "ja": "お礼状" },
    { "t": [102.3,  103.5], "ja": "どこかに招待されたら、バーン！" },
    { "t": [104.1,  104.6], "ja": "出欠の返事" },
    { "t": [105.3,  107], "ja": "親切にされたら、バシッ！" },
    { "t": [107.7,  108.5], "ja": "お返しだ" },
    { "t": [110.2,  111.8], "ja": "僕の礼儀正しさを甘く見るなよ" },
    { "t": [112.7,  113.6], "ja": "ドアを開けてあげよう" },
    { "t": [113.7,  114.4], "ja": "はい、どうぞ！" },
    { "t": [114.5,  115.4], "ja": "どうもありがとう、キャンベル" },
    { "t": [115.4,  116.2], "ja": "そっちのは僕が開けるよ" },
    { "t": [116.3,  117.1], "ja": "あらまあ" },
    { "t": [117.9,  118.3], "ja": "ありがとう" },
    { "t": [118.9,  121.1], "ja": "そうだ、健康のためのいいコツがある" },
    { "t": [121.4,  123.1], "ja": "歩くときにお尻をぎゅっと締めると" },
    { "t": [123.2,  124.8], "ja": "ひざへの負担がすごく減るんだ" },
    { "t": [124.9,  125.3], "ja": "本当に？" },
    { "t": [125.4,  125.7], "ja": "見てろ" },
    { "t": [125.9,  126], "ja": "ああ" },
    { "t": [126.3,  126.4], "ja": "へえ" },
    { "t": [129,  129.4], "ja": "だろ？" },
    { "t": [129.5,  130.2], "ja": "本当に効くね" },
    { "t": [130.2,  131.2], "ja": "ああ、遠慮なく使ってくれ" },
    { "t": [131.2,  131.7], "ja": "いつでも" },
    { "t": [132,  132.2], "ja": "よし" },
    { "t": [132.4,  133.6], "ja": "おい、ちょっと待て" },
    { "t": [134.1,  137.5], "ja": "上着を斜めにしたまま歩くな" },
    { "t": [137.5,  139.4], "ja": "それに、これは矢のようにまっすぐでないと" },
    { "t": [139.4,  140.5], "ja": "どうもありがとう" },
    { "t": [141.8,  142.6], "ja": "うわあ" },
    { "t": [143,  144.5], "ja": "本当にありがとう" },
    { "t": [144.8,  145.6], "ja": "いえいえ" },
    { "t": [145.9,  146.3], "ja": "座って" },
    { "t": [146.7,  147.1], "ja": "どうぞ" },
    { "t": [147.6,  149], "ja": "君こそ座って" },
    { "t": [149.6,  150], "ja": "そうだ" },
    { "t": [150.1,  152.9], "ja": "先回りして、電池を替えておこう" },
    { "t": [152.9,  154.6], "ja": "君のワイヤレスマウスのね" },
    { "t": [154.6,  155.3], "ja": "必要ない" },
    { "t": [155.6,  157.2], "ja": "そんなことしなくていいのに" },
    { "t": [158.2,  159.6], "ja": "アンディのせいで、ややこしくなってる" },
    { "t": [159.9,  160.5], "ja": "だが心配はしていない" },
    { "t": [161.2,  162.5], "ja": "むしろ私の腕が上がるだけだ" },
    { "t": [167.2,  168.2], "ja": "ここで何が起きてる？" },
    { "t": [168.5,  169.4], "ja": "アンディがランチをおごってくれたの" },
    { "t": [169.7,  170.4], "ja": "なんてことだ" },
    { "t": [170.8,  171], "ja": "本当に？" },
    { "t": [171.4,  171.9], "ja": "ああ" },
    { "t": [172.1,  172.4], "ja": "ああ" },
    { "t": [172.5,  174.8], "ja": "シュルート流の親切の教科書から、そのまま真似させてもらったよ" },
    { "t": [175.1,  175.7], "ja": "教科書なんてない" },
    { "t": [175.9,  177.1], "ja": "あるのは生き残りの手引きだけだ" },
    { "t": [177.2,  180.9], "ja": "君がみんなに朝食をおごったから、僕はみんなにランチをおごったんだ" },
    { "t": [181.1,  183.1], "ja": "よし、じゃあ、私にやらせろ" },
    { "t": [183.3,  186.6], "ja": "いやあ、まったく、このタコスは作るのがやけに面倒だな" },
    { "t": [186.9,  188.5], "ja": "みんなのタコスを私が作ろう" },
    { "t": [189.1,  190.8], "ja": "うぐぐぐぐぐぐぐ" },
    { "t": [192.4,  194.5], "ja": "おっと、おっと、ドワイト、僕がやるよ" },
    { "t": [194.5,  196.6], "ja": "おい、おい、落ち着け、任せておけ" },
    { "t": [196.9,  197.7], "ja": "いや、僕にやらせて" },
    { "t": [197.8,  199.7], "ja": "いやいやいやいや、私がやる" },
    { "t": [201.8,  203.4], "ja": "ねえ、ドワイト、こんなのばかげてる" },
    { "t": [203.8,  205.5], "ja": "気にするな、貸しにしておけばいい" },
    { "t": [209.2,  209.9], "ja": "どうしたの？" },
    { "t": [210,  212.7], "ja": "くそっ、これが上に挟まってる。この職場の誰も手伝ってくれない" },
    { "t": [212.9,  213.3], "ja": "ほら、どいて" },
    { "t": [214.1,  216.1], "ja": "もしドワイトが死んで、まだ借りが残ってたら？" },
    { "t": [216.8,  218.4], "ja": "それは幽霊が出るもとよ" },
    { "t": [218.9,  220.8], "ja": "ああ、そうだ、でっかい借りができるぞ" },
    { "t": [220.9,  222.2], "ja": "小さい封筒みたいなもんだ。はい、どうぞ" },
    { "t": [222.2,  223.8], "ja": "取れた。ドワイト" },
    { "t": [227.8,  229.2], "ja": "スターバックスのギフトカード" },
    { "t": [229.5,  229.9], "ja": "サプライズ！" },
    { "t": [231.6,  232.8], "ja": "みんなからよ" },
    { "t": [233.5,  234.6], "ja": "15ドル分" },
    { "t": [236.6,  239.3], "ja": "くそっ。ジムを倒すのに、少しも近づいていない" },
    { "t": [240,  241.2], "ja": "ああ、無駄な一日だった" },
    { "t": [241.7,  244.8], "ja": "今ごろ、これくらいの高さの毒キノコが育てられたのに" }
  ]
}
