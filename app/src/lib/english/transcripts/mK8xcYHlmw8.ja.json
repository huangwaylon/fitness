{
  "video": "mK8xcYHlmw8",
  "lines": [
    { "t": [0, 3], "ja": "ピクニックもなしで屋上に閉じこめられた！" },
    { "t": [3.1, 4.5], "ja": "ピクニックなしってわけじゃないよ" },
    { "t": [4.6, 6], "ja": "ナプキンは持ってきた" },
    { "t": [7, 10], "ja": "やっぱりいいや。ナプキンはあるね" },
    { "t": [10.5, 12.8], "ja": "助けて！" },
    { "t": [15.8, 16.8], "ja": "やめて" },
    { "t": [16.8, 17.8], "ja": "何も言ってないよ" },
    { "t": [18.8, 19.8], "ja": "だめ！" },
    { "t": [22.8, 24.3], "ja": "何も言ってないって" },
    { "t": [24.4, 25.8], "ja": "目で言ってたよ" },
    { "t": [27.3, 29.8], "ja": "ピクニックの一番いいところはまだできるよ" },
    { "t": [29.9, 31], "ja": "地面に座ること" },
    { "t": [33.8, 36.9], "ja": "カーリー、なんで僕たちのことをみんなに知られたくないの？" },
    { "t": [37.2, 38.4], "ja": "僕と一緒にいるのが恥ずかしい？" },
    { "t": [38.9, 40.6], "ja": "まさか、違う。全然そんなことない" },
    { "t": [41.4, 43.2], "ja": "あなたに夢中なの" },
    { "t": [44.8, 47], "ja": "あなたのソフト帽が頭から飛んでいったとき" },
    { "t": [48.3, 49.4], "ja": "悲しかったもの" },
    { "t": [52.3, 55.5], "ja": "あのね、私、ボーとは公に付き合ってたの" },
    { "t": [55.5, 58.2], "ja": "それで彼にライブ配信中にふられて" },
    { "t": [58.4, 59.8], "ja": "ネットでみんなに叩かれたの" },
    { "t": [59.8, 62.9], "ja": "だって心配なの。もし私たちが公表したら" },
    { "t": [63, 65.8], "ja": "あなたまであんなつらい目にあわせちゃうって" },
    { "t": [67.3, 69.2], "ja": "近いうちに僕をふるつもり？" },
    { "t": [69.3, 70.1], "ja": "ううん" },
    { "t": [70.1, 72.2], "ja": "もちろんない" },
    { "t": [72.3, 76.7], "ja": "ただ、本当にあなたを守りたいの" },
    { "t": [76.7, 81.1], "ja": "知ってるかわからないけど、ネットってけっこう意地悪なんだよ" },
    { "t": [84.3, 86.1], "ja": "僕を守る必要なんてないよ、ね？" },
    { "t": [86.2, 88.4], "ja": "何を言われても受け止められる" },
    { "t": [88.5, 90.2], "ja": "それか、ずっと秘密にしててもいい" },
    { "t": [90.3, 91.4], "ja": "ずっとずっとそれでいいよ" },
    { "t": [91.4, 92.4], "ja": "どっちでもいいんだ" },
    { "t": [94.2, 95.3], "ja": "君と一緒にいたいだけだから" },
    { "t": [96.8, 99.6], "ja": "君は、僕がずっと望んできたすべてなんだ" },
    { "t": [100.6, 104], "ja": "ネットで誰に何を言われても、この気持ちは変わらない" },
    { "t": [106.1, 108], "ja": "だって愛してるから、カーリー" },
    { "t": [110.4, 111.4], "ja": "君に恋してるんだ" },
    { "t": [115.9, 117.9], "ja": "ナプキンを持ってきてよかった" },
    { "t": [120.3, 121.7], "ja": "やっと誰かがメッセージに返事をくれた" },
    { "t": [122.6, 123.2], "ja": "母さんだ" },
    { "t": [124, 127.7], "ja": "「お知らせよ。カメラがついてるわ。それにカーリーのあごがきれいに見えない角度よ」" },
    { "t": [129.4, 131.9], "ja": "ドローンを見せるために配信を始めて、すっかり忘れてた" },
    { "t": [135.3, 135.8], "ja": "うそ" },
    { "t": [143.8, 144.3], "ja": "わあ" },
    { "t": [144.4, 146.1], "ja": "コメントが意外と優しい" },
    { "t": [146.8, 147.8], "ja": "「やっとだね」" },
    { "t": [148.2, 149.3], "ja": "「あなたたちみたいになりたい」" },
    { "t": [149.4, 150.4], "ja": "「これはすごすぎる」" },
    { "t": [150.5, 153], "ja": "「絶対に、全力ですぐ閉じたりなんかしてないよ」" },
    { "t": [153.2, 153.5], "ja": "まあ" },
    { "t": [153.6, 154.7], "ja": "皮肉で言ってるんだと思う" },
    { "t": [154.9, 155.2], "ja": "あら" },
    { "t": [158.2, 159], "ja": "二人だけの秘密なんて、もういい" },
    { "t": [160.5, 161.6], "ja": "世界中に知ってほしい" },
    { "t": [165.3, 171.4], "ja": "愛してるわ、フレディ・ベンソン" },
    { "t": [182.4, 183.4], "ja": "ドローンだ" },
    { "t": [184.2, 185.7], "ja": "送信機を壊してもだめだったみたい" },
    { "t": [185.8, 187], "ja": "でも、何かの絵を作ってる" },
    { "t": [187.3, 189.4], "ja": "うん、フレディの名前と脈打つハートを描いてるのよ" },
    { "t": [190.1, 190.3], "ja": "へえ" },
    { "t": [191.2, 192.8], "ja": "あんまりハートには見えないな" },
    { "t": [193.4, 194], "ja": "なんか変だね" },
    { "t": [194.1, 195.4], "ja": "どっちかというとマイクみたい" },
    { "t": [195.7, 196], "ja": "うん" },
    { "t": [196.2, 197.5], "ja": "それか横向きの灯台" },
    { "t": [200.9, 202.1], "ja": "何かわかった気がする" },
    { "t": [203.1, 204.5], "ja": "あれは…" },
    { "t": [204.5, 204.8], "ja": "ああ、だめ" },
    { "t": [204.9, 206.4], "ja": "絶対に太ってるとかじゃない" },
    { "t": [207.4, 208], "ja": "ああ、そうか" },
    { "t": [208, 208.6], "ja": "今わかった" },
    { "t": [209.9, 212.5], "ja": "ドローンが最初の設定の隊形に戻っちゃったんだ" },
    { "t": [212.7, 212.9], "ja": "あら" },
    { "t": [213, 213.9], "ja": "なんであんな形に？" },
    { "t": [214.1, 217.7], "ja": "だって、どうやらスペンサーがドローンの試運転で、大きな…を作ったらしくて" },
    { "t": [217.7, 218.7], "ja": "ああ、くそ！" },
    { "t": [219.2, 220.9], "ja": "僕の灯台が横倒しだ" },
    { "t": [222.7, 225.4], "ja": "もう一回、私を愛してるって話に戻ってくれる？" },
    { "t": [225.6, 226.8], "ja": "うん、そう言ってくれるのを待ってた" },
    { "t": [227.3, 227.8], "ja": "愛してる" },
    { "t": [235.3, 235.9], "ja": "そうなの？" },
    { "t": [236.3, 236.7], "ja": "脈打ってる" },
    { "t": [237.7, 238.1], "ja": "うん" },
    { "t": [239.2, 240.8], "ja": "よし、今度こそちゃんとわかった" },
    { "t": [248.5, 249.6], "ja": "シャンパンを持ってきてくれてありがとう" },
    { "t": [250.1, 252.9], "ja": "もしかして、道でかっこいいソフト帽を見かけなかった？" },
    { "t": [253.4, 254.6], "ja": "新しいのを買ってあげるよ" },
    { "t": [256.1, 258.2], "ja": "やっと助けに来てくれてありがとう" },
    { "t": [258.4, 258.9], "ja": "ああ、うん" },
    { "t": [259.1, 260.2], "ja": "電話に気づかなくてごめん" },
    { "t": [260.3, 261.8], "ja": "まったく普通の理由でね" },
    { "t": [262, 264.9], "ja": "関係ないけど、でっかいフクロネズミの死体をどこに捨てればいいか知ってる人いる？" },
    { "t": [266.8, 268.8], "ja": "愛を公表したことに乾杯" },
    { "t": [269.6, 269.8], "ja": "乾杯" }
  ]
}
