{
  "video": "6J4qQMWnqio",
  "lines": [
    { "t": [0,  5], "ja": "僕の絵には、大好きなギリシャ神話の一つを選んだんだ" },
    { "t": [6.1,  9.6], "ja": "ケンタウロスの女神ディオフィーナが、大きな雄ジカを仕留める場面" },
    { "t": [10.2,  11.9], "ja": "これは、えーと、見事だね" },
    { "t": [12.2,  13.1], "ja": "息をのむほどだよ、ジェリー" },
    { "t": [13.3,  14.3], "ja": "うん、本当にそうだ" },
    { "t": [14.6,  15.8], "ja": "わあ、ありがとう、みんな" },
    { "t": [16.4,  19.6], "ja": "ねえレスリー、ちょっと来てジェリーの絵を見てごらんよ" },
    { "t": [19.7,  20], "ja": "あら" },
    { "t": [20.7,  21.6], "ja": "うそでしょ" },
    { "t": [24.1,  24.9], "ja": "私だ" },
    { "t": [25.1,  25.8], "ja": "これ、私？" },
    { "t": [26.2,  26.5], "ja": "え？" },
    { "t": [27.2,  27.7], "ja": "まさか" },
    { "t": [30,  31.5], "ja": "ああ、もう" },
    { "t": [31.7,  32.5], "ja": "確かに君に似てるね" },
    { "t": [32.6,  33.7], "ja": "今ごろ気づいたの？" },
    { "t": [33.8,  35.9], "ja": "夜、目を閉じるとそれが見えるのか、ジェリー？" },
    { "t": [36.2,  37.9], "ja": "上半身裸のレスリーが、馬にくっついてるのが" },
    { "t": [38.5,  40.9], "ja": "あの、レスリー、本当に本当にごめん" },
    { "t": [41.5,  43.2], "ja": "ディオフィーナは力強い女神で" },
    { "t": [43.4,  45.8], "ja": "最近、力強い女性についてよく考えてて" },
    { "t": [46,  48.5], "ja": "無意識のうちに君を描いちゃったんだ" },
    { "t": [49,  50.3], "ja": "ごめん、すぐに外すよ" },
    { "t": [50.3,  50.6], "ja": "だめ" },
    { "t": [51.8,  52.6], "ja": "飾っておいて" },
    { "t": [54.5,  55.4], "ja": "大好き" },
    { "t": [56.3,  57.8], "ja": "どう説明したらいいか分からない" },
    { "t": [58.1,  60.3], "ja": "これを見るたびに、心の中で思うの" },
    { "t": [60.5,  62.6], "ja": "このケンタウロスの女性にできないことってある？って" },
    { "t": [63.3,  65.3], "ja": "エスカレーターに乗ることと、車の運転以外でね" },
    { "t": [65.7,  70], "ja": "芸術って、本当に素晴らしいわ" },
    { "t": [70.9,  71.7], "ja": "うそでしょ" },
    { "t": [71.7,  72.8], "ja": "赤ちゃんがトムだ" },
    { "t": [73.3,  73.8], "ja": "え？" },
    { "t": [74.5,  76.9], "ja": "間違いなく、今までで一番好きな絵だわ" },
    { "t": [77.2,  78.2], "ja": "何だよ、ジェリー？" },
    { "t": [78.6,  79.5], "ja": "俺の太鼓腹を見ろよ" },
    { "t": [79.5,  80.7], "ja": "妊娠した赤ちゃんみたいだ" },
    { "t": [81.2,  82.3], "ja": "それに、なんでこんなに怖がってるんだ？" },
    { "t": [82.7,  83.9], "ja": "よし、今すぐこれを外さなきゃ" },
    { "t": [84,  85.4], "ja": "だめ、この絵はどこにも行かないわよ、トム" },
    { "t": [85.7,  88], "ja": "こんにちは、芸術を愛するお仲間さん" },
    { "t": [89.2,  90.6], "ja": "絵へようこそ" },
    { "t": [91.7,  92.4], "ja": "待って、これってあなた？" },
    { "t": [94.3,  95.1], "ja": "まあ、セクシーね" },
    { "t": [95.8,  96.4], "ja": "ありがとう" },
    { "t": [97.1,  98.1], "ja": "この人も描かれてるの" },
    { "t": [98.2,  99.1], "ja": "あの小さい太った赤ちゃんよ" },
    { "t": [103.3,  105.7], "ja": "ああ、あの照明、何か月も直してもらおうとしてたんだ" },
    { "t": [106,  106.6], "ja": "ありがとう" },
    { "t": [107.1,  107.7], "ja": "彼女にお礼を言って" },
    { "t": [108.6,  109.5], "ja": "おはよう、トム" },
    { "t": [109.7,  113.5], "ja": "今朝、彼女が私の部屋に乗り込んできて、これを片付けるまで帰らないって言ったんです" },
    { "t": [113.5,  113.8], "ja": "ちゃんと片付くまでね" },
    { "t": [114.1,  114.4], "ja": "ふーん" },
    { "t": [114.9,  116.8], "ja": "まあ、誰かさんは気分が良さそうでよかったよ" },
    { "t": [117.3,  121.5], "ja": "あの絵を、誰でも見られる公共の建物に飾るんだって" },
    { "t": [121.9,  127.3], "ja": "ジェリーはひと筆で、何年もかけて作った俺のジェイ・ジー風の雰囲気をぶち壊して" },
    { "t": [127.3,  131.2], "ja": "太った茶色い赤ちゃんの雰囲気に変えちまった。それほどかっこよくない雰囲気にね" },
    { "t": [131.6,  133.7], "ja": "ねえ、アフロディーテ、クリスが部屋に来てって" },
    { "t": [135.2,  136.4], "ja": "なぜ怒っているのか？" },
    { "t": [136.7,  139.7], "ja": "まず、税金で作った動物のポルノから話しましょう" },
    { "t": [139.8,  141.7], "ja": "いや、それは言いすぎじゃないかと" },
    { "t": [141.9,  146.7], "ja": "破棄してほしいし、この役所からの謝罪声明も求めます。わいせつな描写について" },
    { "t": [146.7,  147.7], "ja": "獣姦の" },
    { "t": [149,  149.5], "ja": "獣姦？" },
    { "t": [149.6,  151.3], "ja": "これはケンタウロスの絵ですよ" },
    { "t": [151.5,  153.4], "ja": "美しい、半分人間で半分馬の" },
    { "t": [153.6,  154.8], "ja": "で、どうやってそうなったの？" },
    { "t": [155.2,  159.1], "ja": "誰が何と関係を持って、どれを産んだのよ？" },
    { "t": [159.3,  164.2], "ja": "ラングマンさん、お話はうかがいました、理解しています。できる限りのことをして" },
    { "t": [164.2,  164.8], "ja": "解決策を見つけます" },
    { "t": [166.2,  167], "ja": "破棄して" },
    { "t": [168.9,  169.9], "ja": "破棄して？" },
    { "t": [170.1,  171.2], "ja": "いや、彼女は本気だ" },
    { "t": [171.6,  173.2], "ja": "あなた個人として、不快に思いますか？" },
    { "t": [174.2,  175.2], "ja": "個人的には、いいえ" },
    { "t": [175.8,  178.3], "ja": "いや、個人的には、人の体を描いたいい芸術は好きです" },
    { "t": [179.3,  180.9], "ja": "ヌードの彫刻をかじったこともあります" },
    { "t": [181.7,  182.4], "ja": "ヌードのモデルもしました" },
    { "t": [182.9,  184.6], "ja": "大学では、ヌード版の「キャッツ」に出ました" },
    { "t": [185.1,  185.4], "ja": "ふむ" },
    { "t": [185.7,  187.1], "ja": "でも、今は裸じゃないですよね？" },
    { "t": [187.3,  191.2], "ja": "ここは役所の建物で、それは不適切だからです。それがまさに" },
    { "t": [191.2,  192.3], "ja": "マーシャの言いたいことだと思います" },
    { "t": [192.5,  194.5], "ja": "だから、この件をうまく片付けて" },
    { "t": [194.9,  196.9], "ja": "あの絵は破棄させません" },
    { "t": [197.5,  202.6], "ja": "優れた芸術には必ずメッセージがある。この絵のメッセージは、「どきなさい" },
    { "t": [202.6,  206.8], "ja": "お尻に矢を刺されたくなければね」よ、マーシャ" }
  ]
}
