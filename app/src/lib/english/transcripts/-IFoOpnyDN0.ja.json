{
  "video": "-IFoOpnyDN0",
  "lines": [
    { "t": [0.8, 3.1], "ja": "じゃあ、やり直し" },
    { "t": [3.1, 7], "ja": "レスリー・ノープです。こちらは課のメンバーのトム・ハヴァフォード" },
    { "t": [7, 10.1], "ja": "みなさんのどんな質問にもお答えしますので、どうぞ" },
    { "t": [10.1, 15], "ja": "いや、いい日だね。先月、俺は刑務所に入れられたんだから" },
    { "t": [15, 16.7], "ja": "その通り" },
    { "t": [16.7, 22.9], "ja": "警察のトップは9級のフリーメイソンなのに、音楽がうるさすぎる" },
    { "t": [22.9, 25], "ja": "落書きをやめさせてください、お願いします" },
    { "t": [25, 26], "ja": "お願いします" },
    { "t": [26, 28.2], "ja": "私も、あなたと同じくらい下品な言葉が嫌いなんです" },
    { "t": [28.2, 29.2], "ja": "ええ、本当に頭にきます" },
    { "t": [29.2, 30.2], "ja": "私には子どもはいませんけど" },
    { "t": [30.2, 31.2], "ja": "そうですね" },
    { "t": [31.2, 34.2], "ja": "3歳の子を連れて公園を歩いてたら、誰かが" },
    { "t": [34.2, 37.2], "ja": "「おい、くそったれ」って叫んで、相手も「お前こそくそったれだ、このばか」って" },
    { "t": [37.2, 42.2], "ja": "この人たちは、自分が住む場所を大事に思う地域の住民なの。だから私には" },
    { "t": [42.2, 47.2], "ja": "どなられているとき、みんなが大声で気にかけてくれてるように聞こえるの" },
    { "t": [47.2, 50.2], "ja": "さて、ローラ・リニーについて言いたいことがいくつかある" },
    { "t": [50.2, 52.2], "ja": "本当にありがとう、バリー" },
    { "t": [52.2, 53.2], "ja": "いつも来てくれてうれしいわ" },
    { "t": [53.2, 55.2], "ja": "ほかに意見のある方は？" },
    { "t": [55.2, 56.2], "ja": "こんにちは" },
    { "t": [56.2, 57.2], "ja": "こんにちは" },
    { "t": [57.2, 58.4], "ja": "アン・パーキンスです" },
    { "t": [58.4, 63.4], "ja": "看護師で、正直言って、政治にはあまり興味がありません" },
    { "t": [69.4, 73.4], "ja": "でも、サリバン通りの空き地のことで話をしに来ました" },
    { "t": [73.4, 74.4], "ja": "すばらしいわ" },
    { "t": [74.4, 75.4], "ja": "いい考えね" },
    { "t": [75.4, 76.4], "ja": "くわしく聞かせて" },
    { "t": [76.4, 77.4], "ja": "いいえ、問題なんです" },
    { "t": [89.4, 90.4], "ja": "しかも、もう1年近くそのままなんです" },
    { "t": [90.4, 91.4], "ja": "12か月よ" },
    { "t": [91.4, 92.4], "ja": "はい" },
    { "t": [92.4, 93.4], "ja": "続けて" },
    { "t": [93.4, 94.4], "ja": "ええ" },
    { "t": [94.4, 97.4], "ja": "それで、ミュージシャンの恋人が…実は私が養ってるんですけど" },
    { "t": [97.4, 101.4], "ja": "とにかく、彼がそこに落ちて両脚を骨折したんです" },
    { "t": [101.4, 102.4], "ja": "アン、ちょっと話をさせて" },
    { "t": [102.4, 105.4], "ja": "じゃあ、恋人がその穴に落ちたんだね？" },
    { "t": [105.4, 106.4], "ja": "はい" },
    { "t": [106.4, 109.4], "ja": "で、その彼とは、けっこう真剣なの？" },
    { "t": [109.4, 110.4], "ja": "一緒に住んでる？" },
    { "t": [110.4, 111.4], "ja": "はい" },
    { "t": [111.4, 112.4], "ja": "へえ" },
    { "t": [112.4, 114.4], "ja": "きっとすごく大変だろうね" },
    { "t": [114.4, 118.4], "ja": "だって、その彼、もともとあまりパッとしない感じみたいだし" },
    { "t": [118.4, 120.4], "ja": "そのうえ両脚骨折だろ" },
    { "t": [120.4, 121.4], "ja": "ただ弱いだけだよ" },
    { "t": [121.4, 122.4], "ja": "君が面倒を見なきゃいけない" },
    { "t": [122.4, 124.4], "ja": "たぶん、次に進みたいって感じてるんじゃない？" },
    { "t": [124.4, 125.4], "ja": "なんで？" },
    { "t": [125.4, 128.4], "ja": "もっと恋愛に、体ごと冒険してみなよ" },
    { "t": [128.4, 131.4], "ja": "今、私を口説いてるの？" },
    { "t": [131.4, 132.4], "ja": "ああ、まさか" },
    { "t": [132.4, 133.4], "ja": "いや、口説いてないよ" },
    { "t": [133.4, 134.4], "ja": "実は結婚してるんだ" },
    { "t": [134.4, 136.4], "ja": "ただ心が開いてるだけさ" },
    { "t": [136.4, 138.4], "ja": "人とつながるのが好きなんだよ" },
    { "t": [138.4, 141.4], "ja": "ほら、女性といると、魅力的な女性といると、すごく落ち着くんだ" },
    { "t": [141.4, 142.4], "ja": "たくさん一緒に過ごしてきたからね" },
    { "t": [142.4, 144.4], "ja": "それで、なんていうか" },
    { "t": [144.4, 146.4], "ja": "集会の時間を使いすぎてる気がするな" },
    { "t": [146.4, 148.4], "ja": "連絡先だけ交換しようか" },
    { "t": [148.4, 152.4], "ja": "ほら、週末にどこか出かけて、この話をゆっくりしてもいいし" },
    { "t": [152.4, 153.4], "ja": "あのね" },
    { "t": [153.4, 154.4], "ja": "ぜひそうしたいところだけど" },
    { "t": [154.4, 158.4], "ja": "要するに、何か月もこれを直してもらおうとしてるんです" },
    { "t": [158.4, 159.4], "ja": "でも誰も何もしてくれない" },
    { "t": [159.4, 160.4], "ja": "見た目もひどいし" },
    { "t": [160.4, 161.4], "ja": "危ないし" },
    { "t": [161.4, 162.4], "ja": "市の土地なんです" },
    { "t": [162.4, 164.4], "ja": "だから何とかしてください" },
    { "t": [170.4, 171.4], "ja": "わかりました" },
    { "t": [173.4, 174.4], "ja": "私が何とかします" },
    { "t": [174.4, 175.4], "ja": "本当に？" },
    { "t": [175.4, 176.4], "ja": "ええ、私たち…私が力になります" },
    { "t": [176.4, 178.4], "ja": "約束ですか？" },
    { "t": [178.4, 181.4], "ja": "約束以上よ" },
    { "t": [181.4, 183.4], "ja": "指切りげんまんよ" },
    { "t": [183.4, 188.4], "ja": "みなさん全員に指切りして約束します。私が力になります" },
    { "t": [188.4, 191.4], "ja": "明日その場所に行って" },
    { "t": [191.4, 194.4], "ja": "あの穴を埋めます" },
    { "t": [194.4, 199.4], "ja": "それが終わったら、そこに公園を造ります" },
    { "t": [199.4, 200.4], "ja": "わあ" },
    { "t": [202.4, 203.4], "ja": "はい" },
    { "t": [207.4, 211.4], "ja": "私は公園課で6年働いてきて、誇れる仕事もたくさんしてきたわ" },
    { "t": [211.4, 217.4], "ja": "最近は、猫の問題があった後に、町じゅうの砂場の砂を消毒する運動を率いたの" },
    { "t": [217.4, 229.4], "ja": "でもこの穴は、まったく新しい公園を一から造るチャンスなの。これは私のフーバーダムになるかもしれない" },
    { "t": [229.4, 230.4], "ja": "また次回お会いしましょう" },
    { "t": [230.4, 230.5], "ja": "また次回お会いしましょう" },
    { "t": [230.5, 231.4], "ja": "さようなら" }
  ]
}
