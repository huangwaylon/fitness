  "lines": [
    { "t": [1, 1.8], "ja": "あ" },
    { "t": [3.3, 4.1], "ja": "わあ" },
    { "t": [10.3, 12.9], "ja": "やあジム、机を一緒に使う仲間になれると思ってたんだ" },
    { "t": [12.9, 14.2], "ja": "カーペットを替えてる間ね" },
    { "t": [15.6, 18.6], "ja": "パソコンが1台だと、ちょっと難しいかもしれませんね" },
    { "t": [18.6, 19.4], "ja": "ああ" },
    { "t": [19.4, 22], "ja": "でも、奥なら確か空いてる机があるぞ" },
    { "t": [22, 22.8], "ja": "ええ" },
    { "t": [25.1, 26.4], "ja": "じゃあ、僕がそこに行くんですね" },
    { "t": [26.4, 28], "ja": "いやいや、本当に、一緒に使っても構わないぞ" },
    { "t": [28, 29.6], "ja": "いやいや、本当に" },
    { "t": [29.6, 30.8], "ja": "僕が奥に行きます" },
    { "t": [34.9, 35.7], "ja": "やあ、ケリー" },
    { "t": [38, 39.1], "ja": "こっちに移ってくるの？" },
    { "t": [39.1, 40.9], "ja": "えっと、今日だけね" },
    { "t": [40.9, 42.7], "ja": "マイケルが僕の机にいる間だけ" },
    { "t": [42.7, 44.2], "ja": "前はトビーがそこに座ってたんだけど" },
    { "t": [44.2, 47.3], "ja": "アレルギーのせいで、あっちに移らなきゃいけなくなったの" },
    { "t": [47.3, 51.4], "ja": "机のアレルギー？" },
    { "t": [51.4, 52.2], "ja": "変よね" },
    { "t": [53.4, 56.6], "ja": "本当なの、クローゼットの扉が閉まらないの" },
    { "t": [56.6, 59.1], "ja": "だって、服をかける人のために、ちゃんと測るのなんて" },
    { "t": [59.1, 62.2], "ja": "すぐできるでしょ。ハンガーってみんな、このくらいの大きさじゃない？" },
    { "t": [62.2, 65], "ja": "なのに、なんでクローゼットの設計者がそれを考えなかったのか分からない" },
    { "t": [65, 68.7], "ja": "だから今は新しいやり方をしてて、服を床に山積みにしておいて" },
    { "t": [68.7, 71], "ja": "その山の周りを歩いて、着る服を選ぶの" },
    { "t": [71, 79.2], "ja": "ビヨンセ、色のピンク、歌手のピンク、ホットドッグ、とにかく最高なもの全部、かき氷" },
    { "t": [79.2, 83], "ja": "マイケルが、机の椅子の高さの上げ方を聞いてこいって" },
    { "t": [83, 85], "ja": "横のレバーだよ" },
    { "t": [85, 86.9], "ja": "僕もそう言ったんだ。ありがとう" },
    { "t": [90.9, 94.6], "ja": "うそ、彼、すごくかわいい" },
    { "t": [94.6, 97.6], "ja": "私の代わりに話して、私のこと好きか聞いてくれない？" },
    { "t": [97.6, 99.4], "ja": "いや、それは無理だと思う" },
    { "t": [99.4, 103.4], "ja": "お願い、ジム、お願い、お願い、ジム、お願い、お願い、お願い、すごくかわいいの" },
    { "t": [103.4, 107.2], "ja": "彼のことすごく好きで、自分で聞きたいけど、恥ずかしすぎるの" },
    { "t": [107.2, 112.6], "ja": "お願い、ジム、お願い、お願い、お願い、お願い、ジム、お願い、お願い、お願い" },
    { "t": [112.6, 113.6], "ja": "やあ。どう？" },
    { "t": [113.6, 114.6], "ja": "別に、そんなに" },
    { "t": [114.6, 116.6], "ja": "ちょっと聞いてもいい？" },
    { "t": [116.6, 118.6], "ja": "実はちょっと気まずいんだけど" },
    { "t": [118.6, 119.6], "ja": "何？" },
    { "t": [119.6, 122.6], "ja": "ケリーのこと、どう思う？" },
    { "t": [122.6, 123.6], "ja": "さあ" },
    { "t": [123.6, 126.6], "ja": "ちょっと面倒なのが好きならね" },
    { "t": [126.6, 129.6], "ja": "彼女、すごくいい子だよ" },
    { "t": [129.6, 131.6], "ja": "彼女に興味あるの？" },
    { "t": [131.6, 132.6], "ja": "うん、すごく" },
    { "t": [132.6, 133.6], "ja": "本当？" },
    { "t": [133.6, 134.6], "ja": "彼女、何か言ってた？" },
    { "t": [134.6, 136.6], "ja": "いろいろ言ってたよ" },
    { "t": [136.6, 139.6], "ja": "彼女が長く付き合いたいのか" },
    { "t": [139.6, 142.6], "ja": "それとも、軽く遊ぶだけでいいのか、知ってる？" },
    { "t": [142.6, 145.6], "ja": "全然分からない" },
    { "t": [145.6, 147.6], "ja": "聞いてみてくれる？" },
    { "t": [147.6, 149.6], "ja": "うん" },
    { "t": [149.6, 151.6], "ja": "いいよ" },
    { "t": [151.6, 154.6], "ja": "ああ、長く付き合いたいに決まってる" },
    { "t": [154.6, 157.6], "ja": "恋に落ちて、子どもを産んで、ずっと一緒にいるの" },
    { "t": [157.6, 159.6], "ja": "でも、彼にはそれを言わないで、いい？" },
    { "t": [159.6, 161.6], "ja": "私は、何でもオーケーって感じだって伝えて" },
    { "t": [161.6, 163.6], "ja": "だって、私は軽い女じゃないけど、どうなるか分からないでしょ" },
    { "t": [163.6, 167.6], "ja": "やあ、ブレンダ、ボートで会ったジム・ハルパートです" },
    { "t": [167.6, 170.6], "ja": "会社の名簿で君の番号を知ったんだ" },
    { "t": [170.6, 174.6], "ja": "それで、たぶん君が番号を載せたのは" },
    { "t": [174.6, 177.6], "ja": "僕に誘ってほしかったからだと思ってね" },
    { "t": [177.6, 180.6], "ja": "えっと、だから折り返し電話して" },
    { "t": [180.6, 183.6], "ja": "僕の番号は、その名簿で分かるから" },
    { "t": [183.6, 186.6], "ja": "えっと、それか、メールを見て" },
    { "t": [186.6, 188.6], "ja": "今送ったところだから" },
    { "t": [188.6, 190.6], "ja": "うわ" },
    { "t": [190.6, 192.6], "ja": "えっと、折り返し電話してね" },
    { "t": [192.6, 193.6], "ja": "そうだといいな" },
