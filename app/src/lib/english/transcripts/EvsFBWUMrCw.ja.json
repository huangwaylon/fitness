{
  "video": "EvsFBWUMrCw",
  "lines": [
    { "t": [0,9.7], "ja": "えっと、そうなの、友達の家に泊まって" },
    { "t": [9.7,12.4], "ja": "コンタクトの保存液を忘れちゃったから" },
    { "t": [12.4,15.2], "ja": "予備の眼鏡をかけてくるしかなかったの" },
    { "t": [17.4,18.9], "ja": "うるさい" },
    { "t": [18.9,20.8], "ja": "よし、みんな" },
    { "t": [20.8,23.3], "ja": "うわ、パム" },
    { "t": [23.3,25], "ja": "それ、すごくブサイクに見えるよ" },
    { "t": [25,28.3], "ja": "あのさ、パム、かわいくなりたいなら、眼鏡は外すもんだよ" },
    { "t": [28.3,30], "ja": "逆方向に進んでるって" },
    { "t": [30,33.8], "ja": "コンタクトがないの　ごめん、声も聞こえないや" },
    { "t": [33.8,36.5], "ja": "ブサイクな科学者から雑音が出てるだけだもん" },
    { "t": [36.5,39.4], "ja": "えー、みんな、ちょっとした" },
    { "t": [39.4,41.7], "ja": "アイデア会議を会議室でやるぞ" },
    { "t": [41.7,44.5], "ja": "活気をつけろ！" },
    { "t": [44.5,47], "ja": "何なら僕に活気が出るか分かる？" },
    { "t": [47,49.8], "ja": "君が、パメラ・モーガン・ビーズリー…" },
    { "t": [49.8,51.2], "ja": "やめて、やめてよ　もし君が…" },
    { "t": [51.2,52.8], "ja": "マイケルの会議の最中にプロポーズなんかしたら" },
    { "t": [52.8,53.7], "ja": "断るからね" },
    { "t": [53.7,56], "ja": "まあ、もう遅いよ。だって僕がプロポーズ（提案）するのは" },
    { "t": [56,57.7], "ja": "君が僕にコーヒーを1杯持ってくることだから" },
    { "t": [57.7,59.3], "ja": "そうしたら僕はすごく元気になって" },
    { "t": [59.3,61.2], "ja": "世界一幸せな男になれる" },
    { "t": [61.2,65.8], "ja": "みんな、さて、どうやってこのオフィスに活気をつける？" },
    { "t": [65.8,68.4], "ja": "だってほら、クリスマス以来、何もしてないだろう" },
    { "t": [68.4,71.9], "ja": "パムなんか、どう見てももう努力するのをやめてしまった" },
    { "t": [71.9,74.2], "ja": "だから私たちがやるべきなのは、物事を動かすことだ" },
    { "t": [74.2,75.6], "ja": "少し盛り上げていかないと" },
    { "t": [75.6,78.6], "ja": "何かいいアイデアがある人は？" },
    { "t": [78.6,79.7], "ja": "何か提案は？" },
    { "t": [79.7,80.6], "ja": "はい、アンディ" },
    { "t": [80.6,84.2], "ja": "留守番電話の応答メッセージを変えたらどうでしょう" },
    { "t": [84.2,87.8], "ja": "もう少し勢いと元気があるやつに" },
    { "t": [87.8,89.1], "ja": "勢いと元気　勢いと元気" },
    { "t": [89.1,90.9], "ja": "ほら、こういう言葉を探してたんだよ" },
    { "t": [90.9,91.8], "ja": "はい、ジム" },
    { "t": [91.8,94.8], "ja": "じゃあ、もっと新しい留守電メッセージにして" },
    { "t": [94.8,96.9], "ja": "さらに勢いと元気を出すのはどうですか？" },
    { "t": [96.9,98], "ja": "いいぞ、乗ってきた" },
    { "t": [98,98.9], "ja": "気に入った" },
    { "t": [98.9,101.3], "ja": "いっそ全体をテーマにして、ラップみたいに韻を踏むとか" },
    { "t": [101.3,102.5], "ja": "都会っぽいやつ　都会っぽい" },
    { "t": [102.5,105.3], "ja": "そうだ、スタンリー、それを手伝ってくれないか？" },
    { "t": [105.3,106.9], "ja": "スタンリー、もしもし、スタンリー？" },
    { "t": [106.9,108.4], "ja": "私はいい　いや、君だ" },
    { "t": [108.4,110.7], "ja": "ほら、スタンリー、そのゲームを置いて" },
    { "t": [110.7,111.9], "ja": "みんなに加わって" },
    { "t": [111.9,114.1], "ja": "いやだ　スタンリー、ちょっとした…" },
    { "t": [114.1,115.2], "ja": "ほっといてくれ、まったく" },
    { "t": [115.2,117], "ja": "アイデア会議をしてるんだよ" },
    { "t": [117,118.3], "ja": "聞こえなかったのか！" },
    { "t": [125.1,126.2], "ja": "よし。これはいい" },
    { "t": [126.2,127.9], "ja": "水を一杯取ってくる" },
    { "t": [134.8,136.4], "ja": "ちょっと話せますか？" },
    { "t": [136.4,138.2], "ja": "ああ、何だ？" },
    { "t": [139,141.9], "ja": "えっと、ちゃんと対処すべきだと思うんです" },
    { "t": [141.9,143.8], "ja": "今朝のスタンリーとの件に" },
    { "t": [143.8,145.8], "ja": "何をべらべら言ってるんだ？" },
    { "t": [145.8,147.2], "ja": "何もなかったぞ" },
    { "t": [147.2,150.2], "ja": "いや、だって、スタンリーは堂々と命令に逆らったんですよ" },
    { "t": [150.2,151.6], "ja": "会議室でのことか？" },
    { "t": [151.6,152.8], "ja": "ええ" },
    { "t": [152.8,155.5], "ja": "あれは二人でふざけ合ってたんだよ" },
    { "t": [155.5,157.4], "ja": "彼が「聞こえなかったのか？」と言って" },
    { "t": [157.4,160.7], "ja": "私が「おいおいおい、何だって、相棒？」と言った" },
    { "t": [160.7,163.9], "ja": "彼は冗談を言ってたんだよ、トビー、いいか？" },
    { "t": [163.9,165.3], "ja": "冗談には見えませんでしたけど" },
    { "t": [165.3,168.1], "ja": "まあ、君には分からないだろうな。スタンリーは美しくて" },
    { "t": [168.1,172.8], "ja": "生意気で力強い黒人男性で、君は君だからな" },
    { "t": [172.8,175.5], "ja": "君に友達がいたら、分かるはずだ" },
    { "t": [175.5,177], "ja": "友達同士は冗談を言い合うものなんだ" },
    { "t": [177,179.2], "ja": "「よう、お前は貧乏だな" },
    { "t": [179.2,181.4], "ja": "まあな、でもお前の母ちゃんは死んでるけどな」" },
    { "t": [181.4,183.7], "ja": "それが友達ってものさ" },
    { "t": [183.7,184.9], "ja": "（音楽）" },
    { "t": [184.9,186.6], "ja": "（音楽）" },
