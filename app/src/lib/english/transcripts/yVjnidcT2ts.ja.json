{
  "video": "yVjnidcT2ts",
  "lines": [
    { "t": [0,  2.8], "ja": "ロン、タオルを見つけたよ" },
    { "t": [2.8,  5.2], "ja": "大丈夫？" },
    { "t": [5.2,  7.7], "ja": "わあ" },
    { "t": [7.7,  10.1], "ja": "どうやらクレイグはヨガを習ってるらしい" },
    { "t": [10.1,  12.5], "ja": "乾いた服は、これしか見つからなかった" },
    { "t": [12.5,  13.7], "ja": "まあ、すてきよ" },
    { "t": [13.7,  15.5], "ja": "ものすごく腹が立っている" },
    { "t": [15.5,  18.4], "ja": "もう、ほら。泣き言はやめなさい、大きな赤ちゃんね" },
    { "t": [18.4,  20.6], "ja": "眉毛が吹き飛んだあなたも見たことあるし" },
    { "t": [20.6,  22.5], "ja": "口ひげのないあなたも見たことある" },
    { "t": [22.5,  23.6], "ja": "全部見てきたのよ" },
    { "t": [23.6,  24.6], "ja": "逃げ場はないわよ、ロン" },
    { "t": [24.6,  27.4], "ja": "考えられる限りの逃げ方は全部試したでしょ" },
    { "t": [27.4,  29.4], "ja": "もう話すしかないの" },
    { "t": [29.4,  34.4], "ja": "あの「職場の近所の同僚」たちに、何があったの？" },
    { "t": [34.4,  36.4], "ja": "ん？" },
    { "t": [36.4,  39.2], "ja": "吐いちゃいなさい" },
    { "t": [39.2,  41.2], "ja": "君が辞めた" },
    { "t": [41.2,  43.7], "ja": "それから1か月後、テリーを連れていった" },
    { "t": [43.7,  46], "ja": "ええ、だって、何も考えない雑用係が必要だったし" },
    { "t": [46,  47.6], "ja": "彼は最高の雑用係だもの" },
    { "t": [47.6,  49.9], "ja": "そのとおり" },
    { "t": [49.9,  52.4], "ja": "それから、エイプリルを連れていった" },
    { "t": [52.4,  53.9], "ja": "行ってほしくなかった" },
    { "t": [53.9,  58.8], "ja": "彼女は職場で最も親しい知り合いの一人になっていたからな" },
    { "t": [58.8,  60.9], "ja": "だが、君の誘いは断るにはもったいなかった" },
    { "t": [60.9,  62.9], "ja": "だから、引き止めなかった" },
    { "t": [62.9,  65.2], "ja": "それからトムが自分の商売のために辞めた" },
    { "t": [65.2,  67], "ja": "ドナも自分の商売のために辞めた" },
    { "t": [67,  68.6], "ja": "ある日、顔を上げると" },
    { "t": [68.6,  70.6], "ja": "知っている顔が一人もいなかった" },
    { "t": [70.6,  73.5], "ja": "だから、ある決断をした" },
    { "t": [73.5,  82.3], "ja": "おや、まあ、まあ、目の錯覚かしら？" },
    { "t": [82.3,  83.3], "ja": "ロン・スワンソンじゃない？" },
    { "t": [83.3,  84.3], "ja": "やあ、レスリー" },
    { "t": [84.3,  85.4], "ja": "やあ、エイプリル" },
    { "t": [85.4,  86.3], "ja": "ラリー？" },
    { "t": [86.3,  87.3], "ja": "あ、今はテリーです" },
    { "t": [87.3,  88.3], "ja": "そうか" },
    { "t": [88.3,  89.8], "ja": "ちょうど運よく… ちょっと待って" },
    { "t": [89.8,  90.7], "ja": "ああ" },
    { "t": [90.7,  92.2], "ja": "投票のこと、ランディと話した？" },
    { "t": [92.2,  93.7], "ja": "北東部に圧力をかけなきゃって伝えて" },
    { "t": [93.7,  95.3], "ja": "じゃないと、永遠に待たされることになる" },
    { "t": [95.3,  96.3], "ja": "もう待たされるのはうんざりなの、いい？" },
    { "t": [96.3,  97.7], "ja": "ごめん、今日はめちゃくちゃな日で" },
    { "t": [97.7,  99.5], "ja": "で、どうしたの、大きなくまさん？" },
    { "t": [99.5,  100.4], "ja": "大したことじゃない" },
    { "t": [100.4,  102.3], "ja": "昼食でもどうかと思っただけだ" },
    { "t": [102.3,  103.3], "ja": "えー、明日は？" },
    { "t": [103.3,  104.4], "ja": "ぜひ" },
    { "t": [104.4,  105.9], "ja": "久しぶりだもの" },
    { "t": [105.9,  107.3], "ja": "ジェイジェイ・ダイナーで、12時半" },
    { "t": [107.3,  108.5], "ja": "よし。では、その時に" },
    { "t": [108.5,  111.9], "ja": "よし、ランディによると明日、下院で投票があって" },
    { "t": [111.9,  113.5], "ja": "準備のためにワシントンに来てほしいって" },
    { "t": [113.5,  114.3], "ja": "うそ、本当に？" },
    { "t": [114.3,  116.4], "ja": "分かった、一番早い便を取って" },
    { "t": [116.4,  119.2], "ja": "ミズーリの資料を持って、私の車のところで待ってて" },
    { "t": [119.2,  122.2], "ja": "ねえ、ハニー、ワシントンに行かなきゃいけないの" },
    { "t": [122.2,  124.4], "ja": "子どもたちのお迎え、お願いできる？" },
    { "t": [124.4,  126.1], "ja": "あ、ああ、うそ" },
    { "t": [126.1,  128.6], "ja": "ロン、私、昼食の約束をすっぽかしたのね" },
    { "t": [128.6,  130.2], "ja": "ああ、そうだ" },
    { "t": [130.2,  132], "ja": "しばらく待ったが、何があったかは" },
    { "t": [132,  133.5], "ja": "すぐに分かった" },
    { "t": [133.5,  135.9], "ja": "君の生活はかなり忙しそうだったからな" },
    { "t": [135.9,  139.2], "ja": "それで話は終わり？ 私がすっぽかしたってこと？" },
    { "t": [142.1,  144.2], "ja": "私に何か頼むつもりだったのね" },
    { "t": [144.2,  146.3], "ja": "だから昼食に誘ったのね" },
    { "t": [148.4,  149.6], "ja": "ロン、あなたは…" },
    { "t": [149.6,  153], "ja": "仕事をもらえないか、頼むつもりだった" },
    { "t": [153,  155.9], "ja": "連邦政府でな" },
    { "t": [155.9,  160.4], "ja": "口に出すだけで、汚らわしい気分だ" },
    { "t": [160.4,  162.7], "ja": "友だちが恋しくて" },
    { "t": [162.7,  164.6], "ja": "3階に来て、また一緒に" },
    { "t": [164.6,  166.3], "ja": "働きたかったのね" },
    { "t": [166.3,  170.2], "ja": "それがどれだけつらかったか、想像もできない" },
    { "t": [170.2,  172.4], "ja": "ああ、どうして気づかなかったんだろう？" },
    { "t": [172.4,  175.3], "ja": "ロン、本当にごめんなさい" },
    { "t": [175.3,  177.5], "ja": "もっといい友だちでいるべきだった" },
    { "t": [177.5,  180.3], "ja": "正直、レスリー、いいんだ" },
    { "t": [180.3,  182.7], "ja": "あれは、すでに書かれていた文章の" },
    { "t": [182.7,  184.2], "ja": "最後の句読点にすぎなかった" },
    { "t": [184.2,  186.4], "ja": "私の役所での仕事は終わっていた" },
    { "t": [186.4,  188.1], "ja": "確かに、物事を閉鎖して" },
    { "t": [188.1,  190.9], "ja": "腐った獣の血を内側から抜くのは大好きだったがな" },
    { "t": [190.9,  192.8], "ja": "あなたのたとえって、本当に美しいわね" },
    { "t": [192.8,  194.7], "ja": "だが、去る時だったんだ" },
    { "t": [194.7,  198.6], "ja": "それに、その理由を君にも誰にも説明する気になれなかった" },
    { "t": [198.6,  201.5], "ja": "その後に起きたこと、私たちのケンカ" },
    { "t": [201.5,  203.7], "ja": "私の会社がモーニングスター開発を引き受けて" },
    { "t": [203.7,  209.2], "ja": "看護師の古い家を取り壊したとき、君に前もって知らせなかったこと" },
    { "t": [209.2,  213.2], "ja": "それは後悔している" },
    { "t": [213.2,  215.5], "ja": "ここではいい時間を過ごした" },
    { "t": [215.5,  220.4], "ja": "だが、君とトムとドナとエイプリルとテリーがいなくなってから" },
    { "t": [220.4,  225.3], "ja": "このオフィスを見回すと、何も同じではなかった" },
    { "t": [225.3,  228.2], "ja": "まあ、それならどうにかする方法があるわ" }
  ]
}
