{
  "video": "tKK39FaCzzA",
  "lines": [
    { "t": [0,  2.2], "ja": "カーリー・シェイは、いろいろな苦難を乗り越えてきた" },
    { "t": [2.3,  5.4], "ja": "でも、寝室が火事になったときほど、ひどいことはなかった" },
    { "t": [5.5,  7], "ja": "私の部屋が燃えてる！" },
    { "t": [7.7,  8.7], "ja": "何？" },
    { "t": [15,  17.4], "ja": "うん、これはちょっとした修理じゃ済まないね" },
    { "t": [17.6,  19.5], "ja": "このベッド脇のテーブルランプが火元だ" },
    { "t": [19.7,  20.7], "ja": "ランプ？" },
    { "t": [20.8,  22.4], "ja": "でも、テーブルランプなんて持ってない" },
    { "t": [24.1,  26.2], "ja": "ちょっと待って。話をさかのぼろう" },
    { "t": [28.1,  30.1], "ja": "サプライズ！ サプライズ！" },
    { "t": [30.7,  33.5], "ja": "そう、すべては一風変わった誕生日プレゼントから始まった" },
    { "t": [33.6,  37.5], "ja": "これ、グミのクマのランプ？ ああ、カーリーの誕生日に作ったんだ" },
    { "t": [37.7,  40.9], "ja": "いろんな色と味のグミで覆われたランプシェード" },
    { "t": [41.1,  43.4], "ja": "土台には、あの5ポンドの巨大グミ" },
    { "t": [43.5,  46], "ja": "しかもスイッチの上にまで小さなクマがいる" },
    { "t": [46.1,  48.3], "ja": "正直、これ私も欲しい" },
    { "t": [48.5,  49.5], "ja": "大好き" },
    { "t": [50.6,  52.1], "ja": "ありがとう。ねえ、頼みがあるんだ" },
    { "t": [52.3,  54.4], "ja": "これを上に持っていって、カーリーのベッド脇の台に置いて" },
    { "t": [54.5,  55.6], "ja": "コンセントを差して、スイッチを入れて" },
    { "t": [55.8,  56.6], "ja": "お安いご用" },
    { "t": [56.8,  59.4], "ja": "そして、ここから事態はひどくおかしくなった" },
    { "t": [59.5,  61.7], "ja": "普通のグミにはゼラチンが入っていて" },
    { "t": [61.8,  65.2], "ja": "平均的な溶ける温度は華氏95度" },
    { "t": [65.4,  70.1], "ja": "一方、普通の電球の表面は華氏250度まで上がる" },
    { "t": [70.2,  72.5], "ja": "あのランプのグミっぷりを考えれば" },
    { "t": [72.6,  74.6], "ja": "時間の問題だった" },
    { "t": [74.7,  75.7], "ja": "カーリー、ごめん…" },
    { "t": [77.1,  78.2], "ja": "おいで" },
    { "t": [79.2,  82], "ja": "さて、そろそろ気持ちを全部吐き出す時間だろう" },
    { "t": [82.1,  83.3], "ja": "直し始める前にね" },
    { "t": [83.4,  85], "ja": "よかったら、私とママの家に泊まっていいよ" },
    { "t": [85.1,  86.1], "ja": "ああ！" },
    { "t": [87.4,  88.4], "ja": "次に行こう" },
    { "t": [88.5,  91], "ja": "さて、たっぷりの保険金が入って" },
    { "t": [91.1,  93.2], "ja": "ダイヤ付きの腕時計のおかげで…" },
    { "t": [93.3,  95.4], "ja": "まあ、1921年のロベール・ジュレですから" },
    { "t": [95.6,  98], "ja": "払い戻しの額は…" },
    { "t": [99.3,  100.9], "ja": "8万2000ドルです" },
    { "t": [101,  102], "ja": "何？！" },
    { "t": [103.6,  106.7], "ja": "スペンサーと友だちは、カーリーの部屋を一から作り直す" },
    { "t": [106.8,  108], "ja": "ここでちょっと豆知識" },
    { "t": [108.1,  109.1], "ja": "燃える前の" },
    { "t": [109.3,  111.9], "ja": "カーリーの元の寝室は、一度も映ったことがなかった" },
    { "t": [112.1,  114], "ja": "でも、今の部屋にある物から判断すると" },
    { "t": [114.2,  117.3], "ja": "これ以上ないくらいの、最高にグレードアップしたグレードアップだ" },
    { "t": [117.4,  118.6], "ja": "サプライズ！" },
    { "t": [118.7,  122.3], "ja": "待って、「最高にグレードアップした」って言葉あるの？" },
    { "t": [122.8,  125.1], "ja": "とにかく、細かいところを見ていこう" },
    { "t": [125.6,  126.8], "ja": "すてきな棚の飾りに" },
    { "t": [126.9,  129.2], "ja": "このおしゃれな磁石のオレンジ色の人形たち" },
    { "t": [129.5,  132.3], "ja": "その隣には、5ポンドの巨大グミの飾り" },
    { "t": [132.6,  134], "ja": "そして、グミといえば…" },
    { "t": [135.7,  137.2], "ja": "グミのシャンデリア？" },
    { "t": [137.3,  139.9], "ja": "燃えにくいグミでできてるんだ！" },
    { "t": [141.5,  142.6], "ja": "確かにグレードアップだ" },
    { "t": [142.8,  144.5], "ja": "今度は火事になる心配もない" },
    { "t": [145,  148], "ja": "だって、テーマがあるなら、とことんやらなきゃ" },
    { "t": [148.7,  151.4], "ja": "シャンデリアの下には、すごいキングサイズのベッド" },
    { "t": [151.5,  154.2], "ja": "スピーカー内蔵で、テーマに合わせたまくらまで付いてる" },
    { "t": [154.6,  157.4], "ja": "実は、この言葉には見覚えがある" },
    { "t": [157.8,  159.3], "ja": "シーズン1を振り返ると" },
    { "t": [159.4,  162.2], "ja": "「アイ・ステークアウト」の回で、この言葉が出てくるんだ" },
    { "t": [162.4,  166.1], "ja": "教会用のズボンに、マスタードをほんの一滴こぼしただけで、彼女はキレたんだ" },
    { "t": [167.1,  167.7], "ja": "何？！" },
    { "t": [167.8,  168.6], "ja": "教会用のズボン？" },
    { "t": [169.7,  171.4], "ja": "いとこのアニーに挨拶して" },
    { "t": [171.9,  174], "ja": "どうも。刑務所にいるって言ってなかった？" },
    { "t": [174.1,  175.8], "ja": "ああ、仮釈放中なの" },
    { "t": [176.2,  179.1], "ja": "自分のまくらにも、何か付け足そうかな" },
    { "t": [179.5,  180.3], "ja": "いや、いいや" },
    { "t": [180.7,  182], "ja": "そして寝る時間になったら…" },
    { "t": [182.2,  183.8], "ja": "カーリーとして過ごした大変な一日の後…" },
    { "t": [185.3,  187.2], "ja": "文字どおり、ベッドに飛び込める" },
    { "t": [187.3,  190.4], "ja": "そう。このベッドにはトランポリンも付いてるんだ" },
    { "t": [190.5,  191.7], "ja": "すごくかっこいい！" },
    { "t": [191.8,  193.6], "ja": "間違いなく、一番ユニークな追加だ" },
    { "t": [193.7,  196.3], "ja": "でも、危険の注意書きが必要だね" },
    { "t": [196.8,  198.5], "ja": "やってみたい！ だめ、だめ、だめ、だめ！" },
    { "t": [198.6,  199.9], "ja": "待って、待って、だめ！" },
    { "t": [200,  201.5], "ja": "おお！ おお！" },
    { "t": [201.7,  202.6], "ja": "痛っ！" },
    { "t": [202.7,  204], "ja": "もう、勘弁してよ！" },
    { "t": [204.7,  206.2], "ja": "信じられない！" },
    { "t": [206.3,  208.6], "ja": "船が浮かんでる、水のコーヒーテーブルは気に入った？" },
    { "t": [208.7,  209.4], "ja": "うん" },
    { "t": [209.6,  212.3], "ja": "まあ確かに、これにコーヒーを置くのはすごく難しいだろう" },
    { "t": [212.5,  214.9], "ja": "でも、花や中のライトまで付いた" },
    { "t": [215.1,  216.4], "ja": "すごくかっこいい飾りだし" },
    { "t": [216.5,  218.9], "ja": "本物の水まで。そんなの関係ない！" },
    { "t": [219,  222.2], "ja": "前衛的なアイスクリームサンドのラブソファ、いいね！" },
    { "t": [222.3,  225], "ja": "これは「ラブソファ」って言葉に、まったく新しい意味をくれる" },
    { "t": [225.1,  228.1], "ja": "だって、アイスクリームサンドが嫌いな人なんている？" },
    { "t": [228.3,  230.9], "ja": "電動クローゼットには、新しい服がまるごとそろっていて" },
    { "t": [231,  233], "ja": "便利なタッチパネルで服を選べる" },
    { "t": [233.1,  236.4], "ja": "世界一すごいクローゼットの準備はいい？" },
    { "t": [237,  238.4], "ja": "もう、言葉がない" },
    { "t": [238.5,  240.1], "ja": "最高をはるかに超えてる" },
    { "t": [240.3,  242.7], "ja": "今の、うそでしょ！ いや、本当に起きたんだ！" },
    { "t": [242.8,  244.3], "ja": "そして、寝室に欠かせないのが" },
    { "t": [244.4,  248.3], "ja": "高性能で、めちゃくちゃすごいメイクコーナー" },
    { "t": [248.4,  249.9], "ja": "鏡がデジタルなだけじゃなく…" },
    { "t": [250,  252], "ja": "見て！ わあ、私、カーリー！" },
    { "t": [252.1,  255.2], "ja": "マスカラでもつけようかな" },
    { "t": [255.3,  257.6], "ja": "壁にはドライヤーの機能まで付いている" },
    { "t": [257.7,  259.1], "ja": "早く、ほら、座って！ うん" },
    { "t": [259.5,  261.1], "ja": "はい、そのボタンを押して" },
    { "t": [261.2,  262.2], "ja": "うん" },
    { "t": [265,  267.2], "ja": "離れて！ えー、だじゃれを許してほしいんだけど" },
    { "t": [267.4,  269.6], "ja": "吹き飛ばされるほど驚いたよ" },
    { "t": [270.3,  272.1], "ja": "それに、細かいところもある" },
    { "t": [272.3,  274.6], "ja": "アイカーリーのロゴ、エレキギター" },
    { "t": [274.8,  276.9], "ja": "カップケーキと輪ゴムのサイドテーブル" },
    { "t": [277.1,  280.3], "ja": "壁のいろいろな写真、ほかにもたくさん" },
    { "t": [281.6,  283.2], "ja": "世界一のお兄ちゃんは誰だ？" },
    { "t": [284.4,  285.4], "ja": "あなた" },
    { "t": [289.5,  292.5], "ja": "カーリー・シェイ、大胆で楽しくて" },
    { "t": [292.6,  294.3], "ja": "最高にイケてる部屋を持ってる！" },
    { "t": [294.4,  295.4], "ja": "ひゅー！" },
    { "t": [295.8,  298.2], "ja": "さあ、あなたなら寝室をどうグレードアップする？" },
    { "t": [298.3,  299.9], "ja": "下のコメント欄で教えてね" },
    { "t": [300,  302.2], "ja": "懐かしさを最高にグレードアップしたいなら" },
    { "t": [302.3,  305.4], "ja": "ユーチューブのニック・リワインドをぜひ登録してね" },
    { "t": [305.5,  307.6], "ja": "（音楽）" }
  ]
}
