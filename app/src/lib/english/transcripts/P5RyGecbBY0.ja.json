{
  "video": "P5RyGecbBY0",
  "lines": [
    { "t": [0.6, 2.3], "ja": "動物管理課へようこそ" },
    { "t": [2.3, 3.5], "ja": "案内するよ" },
    { "t": [3.5, 4.5], "ja": "あれは椅子" },
    { "t": [4.5, 6.2], "ja": "あれは猫かオポッサム" },
    { "t": [6.2, 9.2], "ja": "あ、これは紙ナプキン。犬のかっこいい名前を書いておいたんだ" },
    { "t": [9.2, 12.7], "ja": "バーク・オバマ" },
    { "t": [12.7, 14], "ja": "なるほど。それって？" },
    { "t": [14, 15.1], "ja": "これはどうなってるの？" },
    { "t": [15.1, 17.7], "ja": "ああ、うん、この鳥を外で見つけたんだ" },
    { "t": [17.7, 19.2], "ja": "仕事の終わりを知らせる笛にしようとしたんだよ" },
    { "t": [19.2, 22.1], "ja": "「フリントストーン」の最初みたいにね" },
    { "t": [22.1, 23.5], "ja": "見た目より難しかったけど" },
    { "t": [23.5, 25.9], "ja": "この町は害獣がひどく増えている" },
    { "t": [25.9, 27.7], "ja": "それは、動物管理課が" },
    { "t": [27.7, 30.9], "ja": "動物を捕まえるのがまったくだめだからだ" },
    { "t": [30.9, 34.6], "ja": "彼らが得意なのは、マリファナを吸うことと売ることだけ" },
    { "t": [34.6, 36.1], "ja": "ここは最低最悪の掃きだめで" },
    { "t": [36.1, 38], "ja": "マリファナ中毒のダメな二人が仕切っている" },
    { "t": [38, 40.5], "ja": "完全に、どうしようもなく管理がなってない" },
    { "t": [40.5, 41.6], "ja": "どうも" },
    { "t": [41.6, 43.2], "ja": "確かに、ひどい運営みたいに見えるけど" },
    { "t": [43.2, 44.7], "ja": "私たち、ここに来てまだ2分よ" },
    { "t": [44.7, 46.5], "ja": "彼らのやり方にも、何か理由があるのかも" },
    { "t": [46.5, 48], "ja": "やり方は一つじゃないものね" },
    { "t": [48, 48.8], "ja": "四つ" },
    { "t": [48.8, 50], "ja": "やり方は四つあるのね" },
    { "t": [50, 52.5], "ja": "準備はいい？いたた、いたた、何これ？" },
    { "t": [52.5, 54.9], "ja": "コヨーテのわなだよ。いたっ、痛い" },
    { "t": [54.9, 56.3], "ja": "ああ、害獣がすごく多くてさ" },
    { "t": [56.3, 58.2], "ja": "誰かに電話しようと思ってたんだけど" },
    { "t": [58.2, 60], "ja": "ほら、誰も電話に出ないんだよね" },
    { "t": [60, 61.9], "ja": "あなたたちが、その電話を受ける人なのよ" },
    { "t": [61.9, 63.7], "ja": "うわ、それ、頭がぐるぐるする" },
    { "t": [63.7, 64.6], "ja": "いたっ！" },
    { "t": [64.6, 65.7], "ja": "あなたはクビ" },
    { "t": [65.7, 66.5], "ja": "あなたもクビ" },
    { "t": [66.5, 67.6], "ja": "この課は全員クビ" },
    { "t": [67.6, 68.6], "ja": "いたた、痛い" },
    { "t": [68.6, 70.4], "ja": "これ、走る時に使う足なのに" },
    { "t": [70.4, 71.8], "ja": "なあ、ジャマイカに行こうぜ" },
    { "t": [71.8, 73.1], "ja": "いや、ジャマイカに行こうよ" },
    { "t": [73.1, 74.1], "ja": "あ、そう言ったのか？" },
    { "t": [74.1, 75.5], "ja": "いや" },
    { "t": [75.5, 95.6], "ja": "（音楽）" }
  ]
}
