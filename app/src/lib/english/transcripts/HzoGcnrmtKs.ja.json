{
  "video": "HzoGcnrmtKs",
  "lines": [
    { "t": [0,  2], "ja": "最近、私どうしちゃったんだろう？" },
    { "t": [2,  4], "ja": "だって、どの男の人を見ても" },
    { "t": [4,  6], "ja": "ほら、例えば、あの人を見て" },
    { "t": [6,  8], "ja": "普段なら、あんな人には絶対…" },
    { "t": [8,  10], "ja": "惹かれないのに" },
    { "t": [10,  12], "ja": "でも今は、この気分のせいで" },
    { "t": [12,  16], "ja": "あの人のスウェットとウエストポーチをはぎ取りたくてたまらないの" },
    { "t": [16,  18], "ja": "ちょっと待って" },
    { "t": [18,  20], "ja": "今って、妊娠4か月目くらいよね？" },
    { "t": [20,  22], "ja": "うん。それって、まったく普通のことよ" },
    { "t": [22,  25], "ja": "4か月目くらいになると、ホルモンがおかしくなり始めるの" },
    { "t": [25,  27], "ja": "本当に？ じゃあ、あなたもそうだったの？" },
    { "t": [27,  29], "ja": "うん、もちろん" },
    { "t": [29,  31], "ja": "でも忘れないでね、私は三つ子を妊娠してたの" },
    { "t": [31,  33], "ja": "だから、医学的に言うと、私は…" },
    { "t": [33,  35], "ja": "3倍ムラムラしてたの" },
    { "t": [35,  38], "ja": "わあ、それで全部説明がつく" },
    { "t": [38,  41], "ja": "先週末なんて、お店をはしごして" },
    { "t": [41,  43], "ja": "サンタのひざに座ってたの" },
    { "t": [45,  46], "ja": "分かる分かる" },
    { "t": [46,  48], "ja": "私も覚えてる、等身大パネルを盗もうとしたこと" },
    { "t": [48,  50], "ja": "ボクサーのイベンダー・ホリフィールドのを、スニーカー店のフットロッカーからね" },
    { "t": [50,  52], "ja": "うわ。ええ、うわ" },
    { "t": [52,  54], "ja": "そうだ、明日お医者さんに行くの" },
    { "t": [54,  56], "ja": "そのことを聞いてみる" },
    { "t": [56,  58], "ja": "薬か何かをくれるかも" },
    { "t": [58,  62], "ja": "そうそう、それが必要よ。いい薬がね" },
    { "t": [62,  63], "ja": "こんにちは" },
    { "t": [63,  64], "ja": "こんにちは" },
    { "t": [64,  66], "ja": "お伝えしておきますが、ロング先生は今日いらっしゃいません" },
    { "t": [66,  67], "ja": "病院に呼ばれたので" },
    { "t": [67,  69], "ja": "シフ先生が診察します" },
    { "t": [69,  70], "ja": "あ、分かりました" },
    { "t": [70,  72], "ja": "ねえ、聞いてもいい？" },
    { "t": [72,  76], "ja": "気のせい？ それとも、私の採血をした人、すごくかっこよくなかった？" },
    { "t": [76,  77], "ja": "あら" },
    { "t": [77,  79], "ja": "誰のことか分かる？" },
    { "t": [79,  80], "ja": "坊主頭で" },
    { "t": [80,  81], "ja": "毛深い指の" },
    { "t": [84,  85], "ja": "こんにちは、レイチェル" },
    { "t": [85,  86], "ja": "シフです" },
    { "t": [86,  88], "ja": "ええ、そうね" },
    { "t": [90,  91], "ja": "で、調子はどうですか？" },
    { "t": [91,  93], "ja": "ええ、すごく、すごくいいの" },
    { "t": [93,  94], "ja": "でも、私の話はこれくらいで" },
    { "t": [94,  95], "ja": "ねえ" },
    { "t": [95,  96], "ja": "何ですか？" },
    { "t": [96,  97], "ja": "どこの出身？" },
    { "t": [97,  98], "ja": "お仕事は？" },
    { "t": [100,  101], "ja": "医者です" },
    { "t": [101,  102], "ja": "そうよね" },
    { "t": [102,  103], "ja": "そうよね" },
    { "t": [103,  105], "ja": "いや、つまり、ほら、空いた時間にってこと" },
    { "t": [105,  106], "ja": "料理はする？" },
    { "t": [106,  107], "ja": "スキーは？" },
    { "t": [107,  109], "ja": "それとも奥さんか彼女と過ごしてるの？" },
    { "t": [110,  113], "ja": "えー、妻も彼女もいませんが、スキーは好きです" },
    { "t": [113,  114], "ja": "わあ、私もスキー大好き" },
    { "t": [114,  116], "ja": "すごくない？" },
    { "t": [118,  120], "ja": "で、何か不快な症状はありますか？" },
    { "t": [120,  121], "ja": "いいえ" },
    { "t": [121,  122], "ja": "すごく居心地いいの" },
    { "t": [123,  124], "ja": "お腹にガスがたまって痛むことは？" },
    { "t": [124,  125], "ja": "いいえ" },
    { "t": [128,  131], "ja": "もう、シフ先生ったら、何て質問するの？" },
    { "t": [133,  134], "ja": "では" },
    { "t": [134,  135], "ja": "台の上に横になってもらえますか？" },
    { "t": [136,  138], "ja": "あら、私に台の上に横になってほしいの？" },
    { "t": [140,  141], "ja": "すみません、何か起きてます？" },
    { "t": [141,  142], "ja": "あなたも感じてる？" }
