{
  "video": "Cq9rqDNOgh4",
  "lines": [
    { "t": [0, 2], "ja": "なんで会議室で会議してるの？" },
    { "t": [2, 3], "ja": "レスリーはいないのに" },
    { "t": [3, 6], "ja": "ロンが自分から動いて、会議を仕切ってるの" },
    { "t": [7.5, 9.5], "ja": "冗談じゃないのよ" },
    { "t": [9.5, 11.6], "ja": "みんなに知らせておきたい。私が主催する" },
    { "t": [11.6, 15.5], "ja": "毎年恒例の、公園課職員感謝バーベキューだ" },
    { "t": [15.5, 17.2], "ja": "レスリー・ノープの" },
    { "t": [17.2, 21], "ja": "「職員お楽しみサマースラム・グリル・ジャム・ファンズプロージョン」をやるのね" },
    { "t": [21, 21.8], "ja": "その通りだ" },
    { "t": [21.8, 24.4], "ja": "じゃあ、アイスキャンディー早食い大会を仕切るのね" },
    { "t": [24.4, 26.6], "ja": "ウォータースライダー・マラソンに、スイカの彫刻" },
    { "t": [26.6, 28.6], "ja": "ガスパチョ対決、それから…" },
    { "t": [28.6, 31.8], "ja": "公園の規則についての一人芝居にも主演するのね" },
    { "t": [31.8, 33], "ja": "「パークス・アンド・ドールズ」！" },
    { "t": [33, 35.1], "ja": "公園ならここにあるわ" },
    { "t": [35.1, 37.2], "ja": "その名はラムセット公園" },
    { "t": [37.2, 40.8], "ja": "門が開いているのは夜明けから日暮れまで" },
    { "t": [40.8, 44.1], "ja": "そのどれもやらない。それが狙いだ" },
    { "t": [44.1, 46.8], "ja": "毎年夏、レスリーはバーベキューを開いて" },
    { "t": [46.8, 49.4], "ja": "公園課と維持管理の職員に感謝する" },
    { "t": [49.4, 50.7], "ja": "ぞっとする" },
    { "t": [50.7, 55], "ja": "バーベキューの目的はただ一つ、みんなで分け合ううまい肉だ" },
    { "t": [55, 57.2], "ja": "気取ったデザートはなし" },
    { "t": [57.2, 59.4], "ja": "巨大なシャボン玉銃もなし" },
    { "t": [59.4, 61.6], "ja": "着ぐるみの大人の男もなし" },
    { "t": [61.6, 65.8], "ja": "そして何より、野菜はなし" },
    { "t": [65.8, 67.9], "ja": "ねえ、ロン、せめて焼きトウモロコシはいい？" },
    { "t": [67.9, 69.8], "ja": "だめだ" },
    { "t": [69.8, 78.5], "ja": "先月ロンに仕事をオファーしたら、断られたんだ" },
    { "t": [78.5, 81], "ja": "文字どおり胸が張り裂けたよ" },
    { "t": [81, 84.9], "ja": "でも今、ここが本当に彼の居場所なんだってわかった" },
    { "t": [84.9, 87.1], "ja": "いいぞ、ロン！" },
    { "t": [87.1, 90.5], "ja": "本当によくやってるよ！" },
    { "t": [90.5, 92.1], "ja": "聞こえてないな" },
    { "t": [92.1, 93.9], "ja": "よし、バーベキューを始めよう" },
    { "t": [93.9, 95.6], "ja": "あら、かわいい子！" },
    { "t": [95.6, 96.8], "ja": "何してるの？" },
    { "t": [96.8, 98], "ja": "うそでしょ" },
    { "t": [98, 100.1], "ja": "みんな、これが今日の肉だ" },
    { "t": [100.1, 102.1], "ja": "だめ、だめ、だめ、だめ、ロン" },
    { "t": [102.1, 103.8], "ja": "ロン、なんで私たちにこんなことするの？" },
    { "t": [103.8, 105.5], "ja": "私の考えでは、少なすぎるんだ" },
    { "t": [105.5, 107], "ja": "自分の夕食の目を見つめて" },
    { "t": [107, 109.5], "ja": "命のめぐりについて考えた者がな" },
    { "t": [109.5, 110.7], "ja": "これがお前たちの夕食だ" },
    { "t": [110.7, 112], "ja": "名前はトムだ" },
    { "t": [112, 114.5], "ja": "はは、やられたな！" },
    { "t": [114.5, 115.3], "ja": "本気？" },
    { "t": [115.3, 117.1], "ja": "いや、面白いのはわかるが" },
    { "t": [117.1, 119.1], "ja": "それが本当の名前なんだ" },
    { "t": [119.1, 121.5], "ja": "トムはとても賢くて、驚くほど忠実だ" },
    { "t": [121.5, 123.2], "ja": "ほとんど犬みたいなものだ" },
    { "t": [123.2, 125.8], "ja": "これから料理して、かんで、飲みこむ犬だ" },
    { "t": [125.8, 127.9], "ja": "おい、子どもがいるんだぞ！" },
    { "t": [127.9, 128.7], "ja": "もっともだ" },
    { "t": [128.7, 130.5], "ja": "誰か、この動物の血を抜くのを" },
    { "t": [130.5, 132.2], "ja": "手伝ってくれる子はいるか？" },
    { "t": [132.2, 134], "ja": "上手にできたら、ぼうこうをやろう" },
    { "t": [134, 136.3], "ja": "ふくらませれば楽しいボールになる" },
    { "t": [136.3, 137.2], "ja": "ねえ、ロン" },
    { "t": [137.2, 139.3], "ja": "まさか、ここでその豚を殺したりしないわよね？" },
    { "t": [139.3, 140.4], "ja": "心配いらない" },
    { "t": [140.4, 141.3], "ja": "許可証がある" },
    { "t": [143.4, 145.9], "ja": "これには、私は好きなことをしていいと書いてあるだけよ" },
    { "t": [145.9, 148.4], "ja": "私は公園課の局長で" },
    { "t": [148.4, 150], "ja": "ここは公園なの" },
    { "t": [150, 151.2], "ja": "公園の話じゃないわよ" },
    { "t": [151.2, 154.7], "ja": "法律3つと衛生規則十数個に違反してるわ" },
    { "t": [156.7, 157.5], "ja": "わかった" },
    { "t": [158.4, 161.4], "ja": "バーベキューは延期だ。肉を買ってくるまでな" },
    { "t": [161.4, 163], "ja": "「フード・アンド・スタッフ」でだ" },
    { "t": [163, 164.3], "ja": "行くぞ、トム" },
    { "t": [164.3, 165.9], "ja": "違う、豚のトムだ" },
    { "t": [185.7, 185.79999999999998], "ja": "さようなら" }
  ]
}
