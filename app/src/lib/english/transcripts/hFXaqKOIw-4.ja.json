{
  "video": "hFXaqKOIw-4",
  "lines": [
    { "t": [1,  3.2], "ja": "これから紙を配る" },
    { "t": [3.2,  6], "ja": "そこに人間のお尻を一つ描いてもらう" },
    { "t": [6,  7.3], "ja": "描いた絵を私がどうするかは" },
    { "t": [7.3,  9], "ja": "私以外の誰にも関係ない" },
    { "t": [9,  11.1], "ja": "上のお尻と見比べるつもりでしょ" },
    { "t": [11.1,  13], "ja": "違う。私のフェチだ" },
    { "t": [13,  14.2], "ja": "あ、それと名前も書いてくれ" },
    { "t": [14.2,  16.2], "ja": "私のフェチは、署名入りのお尻の絵なんだ" },
    { "t": [16.2,  17.8], "ja": "お尻なんか描かないぞ" },
    { "t": [17.8,  19.8], "ja": "分かった、じゃあお尻はなしだ" },
    { "t": [19.8,  22.8], "ja": "大きくて丸いダブリューの字を描いてもらうのはどう？" },
    { "t": [22.8,  25.1], "ja": "そう、それか乳首のない胸とか" },
    { "t": [25.1,  27.1], "ja": "はいはい、そろそろ仕事に戻る時間だと思う" },
    { "t": [27.1,  28], "ja": "さあ、みんな、行こう" },
    { "t": [28,  31.5], "ja": "半分に切ったメロンみたいなのを" },
    { "t": [31.5,  33.5], "ja": "下の部分だけ描くとか" },
    { "t": [33.5,  35.3], "ja": "まあ、これじゃ何も進まないな" },
    { "t": [35.3,  37.3], "ja": "別のやり方が必要だ" },
    { "t": [37.3,  39.6], "ja": "一番弱いやつを見つけて" },
    { "t": [39.6,  41.5], "ja": "群れから引き離すんだ" },
    { "t": [43.1,  45], "ja": "そうだな、ネイトを一人にできれば" },
    { "t": [45,  46.1], "ja": "口を割らせられると思う" },
    { "t": [47.3,  48.9], "ja": "話しかける口実さえあればいい" },
    { "t": [48.9,  50.9], "ja": "お母さんが死にかけてるって言えばいい" },
    { "t": [50.9,  52.7], "ja": "彼にはたいてい効く" },
    { "t": [52.7,  55.8], "ja": "ネイト、お母さんが死にかけてるぞ" },
    { "t": [58,  62], "ja": "ほら、それは気の毒に思うよ" },
    { "t": [62,  64.5], "ja": "大丈夫、大丈夫" },
    { "t": [64.5,  67], "ja": "じゃあ、母さんはまた持ち直すの？" },
    { "t": [67,  68.5], "ja": "よかった" },
    { "t": [68.5,  69.5], "ja": "話せる？" },
    { "t": [69.5,  71.5], "ja": "いや、またお休みが必要なんだ" },
    { "t": [71.5,  73.5], "ja": "さて、聞いてくれ。せっかく来てもらったんだから" },
    { "t": [73.5,  75.5], "ja": "この壁画の件について話そう" },
    { "t": [75.5,  77], "ja": "犯人を知ってるんだろ" },
    { "t": [77,  79.5], "ja": "倉庫の連中の多くが友だちなのは分かってる" },
    { "t": [79.5,  81.5], "ja": "でも、こっちにはガムがあるぞ" },
    { "t": [81.5,  85], "ja": "最近、ガムのミントが強くなったと思わない？" },
    { "t": [85,  87.4], "ja": "なんか、強すぎるのもあるよね" },
    { "t": [87.4,  89.4], "ja": "まるで本気で傷つけようとしてるみたい" },
    { "t": [89.4,  90.9], "ja": "壁画に落書きしたのは誰か言え" },
    { "t": [90.9,  91.9], "ja": "あいつがやった" },
    { "t": [94.9,  97.4], "ja": "よし、行っていいぞ。ガムをやれ" },
    { "t": [97.4,  99.4], "ja": "ガムはない。最初からガムなんてなかった" },
    { "t": [99.4,  102.4], "ja": "それ、本当にひどいよ" },
    { "t": [102.4,  124], "ja": "ああ、本当にひどい" }
  ]
}
