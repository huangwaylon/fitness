{
  "video": "KXOm29FkU48",
  "lines": [
    { "t": [0.9,1.8], "ja": "おはよう、アンディ" },
    { "t": [4.8,7.8], "ja": "よし、僕のパソコン、何かが違うぞ" },
    { "t": [10,11.2], "ja": "あっ！" },
    { "t": [11.2,12.8], "ja": "なくなってる" },
    { "t": [14.6,17.5], "ja": "さあ、捜査開始だ" },
    { "t": [17.5,19.8], "ja": "実は、警察学校の入学試験の一部に" },
    { "t": [19.8,22.4], "ja": "事件の捜査があるんだ" },
    { "t": [22.4,24.2], "ja": "だから1か月くらい前に、オフィスのみんなに頼んだんだ" },
    { "t": [24.2,25.9], "ja": "いつか僕の机から何か盗んでくれって" },
    { "t": [25.9,28.2], "ja": "練習できるようにね" },
    { "t": [28.2,29.7], "ja": "さあ、やるぞ" },
    { "t": [30,33.3], "ja": "待って、ねえ、僕のメガネも取った？" },
    { "t": [33.3,35.5], "ja": "サングラスも取られてる" },
    { "t": [35.5,37.8], "ja": "先週末はマイアミにいたんだ" },
    { "t": [37.8,39.8], "ja": "サウスビーチで本領発揮してきたよ" },
    { "t": [39.8,41.2], "ja": "マイアミでは何して過ごしてるんだ？" },
    { "t": [41.2,43.2], "ja": "盗んだパソコンでも売りさばいてるのか？" },
    { "t": [43.2,45.7], "ja": "ああ、君の役所のパソコンを" },
    { "t": [45.7,49], "ja": "インディアナからマイアミまで持っていって" },
    { "t": [49,52.6], "ja": "闇市場で150ドルで売ったよ" },
    { "t": [52.6,55.8], "ja": "気づいてないだろうけど、今ので自分からバラしちゃったね" },
    { "t": [57.8,61.5], "ja": "一日中あなたのファイルを見てたんだ、ジェリー" },
    { "t": [61.5,63.3], "ja": "それが本名ならね" },
    { "t": [63.3,64.4], "ja": "本名じゃないよ" },
    { "t": [64.4,65.5], "ja": "本当の名前はゲイリーだ" },
    { "t": [65.5,69.5], "ja": "じゃあ、ゲイリー、それが本名ならね" },
    { "t": [69.5,71.3], "ja": "誰かが僕のパソコンを盗んだ" },
    { "t": [71.3,74.1], "ja": "さあ、もし犯人なら、僕の目を見て" },
    { "t": [74.1,76.6], "ja": "法律で、僕に言わなきゃいけないことになってる" },
    { "t": [76.6,79.4], "ja": "じゃないと、わなにかけたことになるから" },
    { "t": [79.4,80.9], "ja": "ごめんね、アンディ" },
    { "t": [80.9,81.8], "ja": "僕じゃないよ" },
    { "t": [81.8,82.8], "ja": "うわ、そうか" },
    { "t": [82.8,83.6], "ja": "本当に？" },
    { "t": [83.6,84.5], "ja": "いや" },
    { "t": [84.5,85.3], "ja": "分かった" },
    { "t": [85.3,86.1], "ja": "うん" },
    { "t": [86.1,87.2], "ja": "よし、ジェリーじゃないって分かった" },
    { "t": [87.2,89.4], "ja": "僕にうそをついてなければね" },
    { "t": [89.4,92.7], "ja": "人がうそをついてるかどうか、僕には全然分からないんだ" },
    { "t": [92.7,95.2], "ja": "警察の仕事でそれが問題にならないといいけど" },
    { "t": [95.2,97], "ja": "クリス・トレーガー" },
    { "t": [97,97.5], "ja": "はい" },
    { "t": [97.5,98.7], "ja": "やあ、アンディ" },
    { "t": [98.7,100], "ja": "あなたがやったのは分かってますよ" },
    { "t": [100,101], "ja": "何を？" },
    { "t": [103,105.7], "ja": "バカでハンサムなふりをしてもむだですよ" },
    { "t": [105.7,108.5], "ja": "僕の警察の試験の練習のために" },
    { "t": [108.5,110.2], "ja": "僕のパソコンを盗んだんでしょ" },
    { "t": [110.2,112.1], "ja": "あなたはセクシーなのと同じくらい有罪です" },
    { "t": [112.1,115], "ja": "アンディ、中庭の向こう側のオフィスからも" },
    { "t": [115,117.5], "ja": "パソコンが盗まれたって報告があったんだ" },
    { "t": [117.5,121.1], "ja": "これは君の警察の訓練じゃないと思う" },
    { "t": [121.1,123.1], "ja": "市役所に泥棒が入ったんだよ" },
    { "t": [123.1,124.2], "ja": "うそかどうか分からないな" },
    { "t": [124.2,125], "ja": "本当に？" },
    { "t": [125,125.8], "ja": "たぶんね" },
    { "t": [125.8,126.8], "ja": "本物の犯罪ってこと？" },
    { "t": [126.8,127.7], "ja": "それならもっといい" },
    { "t": [128.9,129.9], "ja": "で、作戦はどうします、おまわりさん？" },
    { "t": [129.9,132.6], "ja": "周りを封鎖して、電話を何本か盗聴するとか" },
    { "t": [132.6,133.5], "ja": "あ、思いついた" },
    { "t": [133.5,135.2], "ja": "犯人が盗むように、にせのパソコンを置いておくんです" },
    { "t": [135.2,138.3], "ja": "先に爆弾をつめておいて、ドカン" },
    { "t": [138.3,139.9], "ja": "全員やっつける" },
    { "t": [139.9,141.1], "ja": "いや、そういうのは一切やらないよ" },
    { "t": [141.1,142.7], "ja": "アンディ、やる気はすごくいいと思うよ" },
    { "t": [142.7,144.3], "ja": "でも、そこまでのお金はないんだ" },
    { "t": [144.3,146.1], "ja": "大がかりな捜査を始めるようなお金はね" },
    { "t": [147.3,150.3], "ja": "このくだらない報告書を書いて、それで終わり？" },
    { "t": [150.3,151.6], "ja": "未来の警官として分かってほしいんですけど" },
    { "t": [151.6,152.8], "ja": "こいつを逃がすわけにはいかないんです" },
    { "t": [152.8,156.5], "ja": "いいかい、警察の仕事なんてほとんどこんなもんだよ" },
    { "t": [156.5,158.5], "ja": "ただ書き留めるだけ" },
    { "t": [158.5,160.8], "ja": "スーパーヒーローの出番じゃないんだ" },
    { "t": [160.8,164.2], "ja": "退屈に聞こえるなら、別のことをしたほうがいいかもな" },
    { "t": [166.5,168.2], "ja": "彼の前向きな気持ちを盗んだ犯人を" },
    { "t": [168.2,170.1], "ja": "見つけたほうがいいかもね" },
    { "t": [171.7,173.2], "ja": "やあ、キャプテン" },
    { "t": [173.2,175.6], "ja": "最新情報です、新しい容疑者は" },
    { "t": [175.6,177.7], "ja": "カーペット・エンポリアムをやってるやつです" },
    { "t": [177.7,181.3], "ja": "僕の考えでは、犯人ってじゅうたんに何かを包むのが大好きだから" },
    { "t": [181.3,183.8], "ja": "それに、全部広げようとしたら怒鳴られたし、だから…" },
    { "t": [183.8,187.2], "ja": "アンディ、犯人を見つけようとする熱意はうれしいけど" },
    { "t": [187.2,189], "ja": "考えに入れたほうがいいんじゃないかな" },
    { "t": [189,189.9], "ja": "警官が言ってたことを" },
    { "t": [189.9,194.9], "ja": "だって、もう、悪いやつを捜査すらできないなら" },
    { "t": [194.9,197.5], "ja": "警官になる意味なんてある？" },
    { "t": [197.5,198.5], "ja": "何してるの？" },
    { "t": [198.5,199.9], "ja": "落ちこむと、シャツを脱ぐんだ" },
    { "t": [199.9,202.2], "ja": "いやな気持ちになると汗をかくから" },
    { "t": [202.2,204.3], "ja": "はあ" },
    { "t": [204.3,207.7], "ja": "あのさ、警官になるのはやめたほうがいいのかも" },
    { "t": [207.7,211.1], "ja": "市役所で週末の" },
    { "t": [211.1,212.2], "ja": "パートの警備員を新しく募集してるんだ" },
    { "t": [212.2,213.2], "ja": "やってみる？" },
    { "t": [213.2,214.5], "ja": "警察官になりたいかどうかを" },
    { "t": [214.5,216.3], "ja": "確かめる方法だと思ってさ" },
    { "t": [216.3,218.7], "ja": "でも覚えておいて、この仕事を受けるなら" },
    { "t": [218.7,220.7], "ja": "いつでも服は着たままでいること" },
    { "t": [220.7,222.1], "ja": "悲しくなってもね" },
    { "t": [222.1,224.6], "ja": "お断り" },
    { "t": [224.6,225.7], "ja": "分かった、やるよ" },
    { "t": [225.7,226.4], "ja": "いいぞ" },
    { "t": [226.4,227.6], "ja": "やるよ、約束する" },
    { "t": [227.6,228.9], "ja": "それに…" },
    { "t": [228.9,231.3], "ja": "銃をもらえて、人の顔に向けられるんですよね" },
    { "t": [231.3,232.2], "ja": "違います" }
  ]
}
