  "lines": [
    { "t": [1, 2.2], "ja": "よし" },
    { "t": [2.2, 4.1], "ja": "これを捕まえるチャンスは、一度しかないかもしれない" },
    { "t": [4.1, 5.6], "ja": "だから、頭を使ってやらないと" },
