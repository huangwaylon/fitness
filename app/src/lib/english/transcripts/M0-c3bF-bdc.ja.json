    { "t": [29.7, 31.4], "ja": "よし、大丈夫" },
    { "t": [31.4, 33.3], "ja": "次はお前だ、うんち野郎" },
    { "t": [33.3, 34.8], "ja": "お見事です、レスリー" },
    { "t": [34.8, 37], "ja": "まあ、ありがとうございます。すばらしいチームのおかげです" },
    { "t": [37, 38.4], "ja": "私はただの、ちょっとした黒幕で" },
    { "t": [38.4, 39.5], "ja": "作戦を全部考えて" },
    { "t": [39.5, 41.2], "ja": "それを完璧にやりとげただけです" },
    { "t": [41.2, 43.4], "ja": "こちらはアンディ・ドワイヤー。実際に捕まえたのは彼です" },
    { "t": [43.4, 44.4], "ja": "ドワイヤーさん" },
    { "t": [44.4, 48.1], "ja": "そんな、友達は俺のことをアンディ・ラディカルって呼ぶんです" },
    { "t": [48.1, 49.2], "ja": "呼ばないよ" },
    { "t": [49.2, 52.4], "ja": "昼は靴みがきのアンディ・ドワイヤー" },
    { "t": [52.4, 55.8], "ja": "別の時間は、オポッサムを捕まえるアンディ・ラディカル" },
    { "t": [55.8, 59.4], "ja": "そして夜は、好きなことをしてる。仕事はなし" },
    { "t": [59.4, 62.1], "ja": "これは、とてもいい宣伝のチャンスだと思うんです" },
    { "t": [62.1, 64], "ja": "それで、新聞の記者に" },
    { "t": [64, 66.8], "ja": "取材とチームの写真撮影に来てもらうよう手配しました" },
    { "t": [66.8, 67.5], "ja": "対策チーム" },
    { "t": [67.5, 68.7], "ja": "すばらしい" },
    { "t": [68.7, 70], "ja": "それから、今度市長室に特別なお願いがある時は" },
    { "t": [70, 72.8], "ja": "電話してください" },
    { "t": [72.8, 74], "ja": "まあ、もちろん、します" },
    { "t": [74, 76], "ja": "特別なお願いなら山ほどあるんです" },
    { "t": [76, 77.1], "ja": "どれにしようかな？" },
    { "t": [77.1, 78.4], "ja": "いや、今選ばなくてもいいでしょう？" },
    { "t": [78.4, 80.5], "ja": "リサイクル用のごみ箱をもう一つ、なんてどうです？" },
    { "t": [80.5, 81.4], "ja": "だめです" },
    { "t": [81.4, 82.4], "ja": "ラミネート加工したバスの定期券は？" },
    { "t": [82.4, 83.2], "ja": "だめです" },
    { "t": [83.2, 84.3], "ja": "いつも何時ごろ寝ますか？" },
    { "t": [84.3, 86.1], "ja": "いいアイデアって、たいてい夜に浮かぶので" },
    { "t": [86.1, 87.8], "ja": "仕事の時間内にしましょう、ね？" },
    { "t": [87.8, 88.8], "ja": "ええ、分かりました" },
    { "t": [88.8, 89.8], "ja": "では" },
    { "t": [89.8, 90.6], "ja": "地獄で会おうぜ、相棒" },
    { "t": [96.8, 99.4], "ja": "捕まえたオポッサムが、フェアウェイ・フランクだと確信しているか？" },
    { "t": [99.4, 100.4], "ja": "はい" },
    { "t": [100.4, 101.3], "ja": "完全に確信しているか？" },
