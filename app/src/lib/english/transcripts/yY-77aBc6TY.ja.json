  "lines": [
    { "t": [0,  6], "ja": "ドワイトはどこだ？" },
    { "t": [6,  8], "ja": "大丈夫か？" },
    { "t": [8,  11], "ja": "いや。実は全然大丈夫じゃない" },
    { "t": [11,  13], "ja": "でも、聞いてくれてありがとう。うれしいよ" },
    { "t": [13,  15], "ja": "そうだ、この機会に" },
    { "t": [15,  18], "ja": "みんなにお礼を言いたい。面と向かってうそをついて" },
    { "t": [18,  21], "ja": "ずっと何が起きてるか教えてくれなかったことにね" },
    { "t": [21,  23], "ja": "どういたしまして" },
    { "t": [28,  31], "ja": "ドワイト？" },
    { "t": [31,  33], "ja": "アンディ" },
    { "t": [33,  35], "ja": "終わりだ" },
    { "t": [35,  37], "ja": "おお、よかった。振られたのか" },
    { "t": [37,  40], "ja": "違う。お前たち二人が終わりなんだ" },
    { "t": [40,  43], "ja": "いや、ありえない。私はあきらめない" },
    { "t": [43,  44], "ja": "あきらめなきゃだめだ" },
    { "t": [44,  46], "ja": "いや、その必要はない" },
    { "t": [46,  49], "ja": "彼女はお前を愛してない。僕と結婚するんだ" },
    { "t": [49,  51], "ja": "さあ、それはどうかな" },
    { "t": [51,  55], "ja": "彼女は私との愛し合う行為を、明らかに楽しんでいるようだからな" },
    { "t": [55,  57], "ja": "アンジェラ・バーナード" },
    { "t": [57,  59], "ja": "そんな名前には絶対にならない" },
    { "t": [59,  62], "ja": "なるんだよ、それにお前もそう呼ばなきゃならない" },
    { "t": [62,  64], "ja": "それはないね" },
    { "t": [64,  67], "ja": "ねえ、二人とも。ちょっと頭を冷やさない？" },
    { "t": [67,  68], "ja": "引き下がれって言ってるんだ" },
    { "t": [68,  70], "ja": "私は絶対に引き下がらないと言っている" },
    { "t": [70,  71], "ja": "なら、引き下がらせてやる" },
    { "t": [71,  72], "ja": "へえ、そう？ どうやってやるつもりだ？" },
    { "t": [72,  74], "ja": "力ずくでだ" },
    { "t": [74,  77], "ja": "それはとても漠然としていて、少しも怖くない" },
    { "t": [77,  78], "ja": "お前と戦う" },
    { "t": [78,  79], "ja": "だめ" },
    { "t": [79,  81], "ja": "よし、いいだろう。決闘だ" },
    { "t": [81,  83], "ja": "勝ったほうがアンジェラをもらう" },
    { "t": [83,  84], "ja": "いいだろう！" },
    { "t": [84,  85], "ja": "いいだろう！" },
    { "t": [85,  86], "ja": "どうかしてる" },
    { "t": [86,  87], "ja": "武器は何だ？" },
    { "t": [87,  88], "ja": "はい、もういいでしょ、だって…" },
    { "t": [88,  89], "ja": "おい、お前には関係ない" },
    { "t": [89,  91], "ja": "職場で起きるなら、関係あるの" },
    { "t": [91,  93], "ja": "いいか？ 職場ではやらない" },
    { "t": [93,  94], "ja": "そうだ" },
    { "t": [94,  95], "ja": "外でやる" },
    { "t": [95,  96], "ja": "職場の外でな" },
    { "t": [96,  97], "ja": "関係ないだろ" },
    { "t": [97,  98], "ja": "なら、関係ないな" },
    { "t": [98,  100], "ja": "よし。で、武器は？" },
    { "t": [100,  101], "ja": "素手だ" },
    { "t": [101,  102], "ja": "ばかげている" },
    { "t": [102,  104], "ja": "私は剣を使う。そしてお前の素手を切り落とす" },
    { "t": [104,  106], "ja": "じゃあ、僕も何か用意する" },
    { "t": [106,  108], "ja": "前にも、男二人が私を取り合ったことがあるの" },
    { "t": [108,  111], "ja": "たいていは、どっちがビデオカメラを持つかでね" },
    { "t": [111,  114], "ja": "よし、73センチの日本刀を使う" },
    { "t": [114,  116], "ja": "うーん、日本刀は持ってない" },
    { "t": [116,  117], "ja": "持ってないのか？" },
    { "t": [117,  118], "ja": "よし、いいだろう" },
    { "t": [118,  120], "ja": "バイキングのような、両手持ちの大剣を使う" },
    { "t": [120,  121], "ja": "僕は…それって何？" },
    { "t": [121,  122], "ja": "短い剣は持ってるか？" },
    { "t": [122,  123], "ja": "一体、何を持ってるんだ？" },
    { "t": [123,  126], "ja": "えーと、12ゲージのサトリ・スーパーライト" },
    { "t": [126,  129], "ja": "いいだろう、それに一番近いのはナイトロ・エクスプレスだ" },
    { "t": [129,  131], "ja": "待って、それって銃？" },
    { "t": [131,  132], "ja": "ええ、そう" },
    { "t": [132,  137], "ja": "えー、アンディのはキジ撃ち用で、ドワイトのはゾウを仕留める用だ" },
    { "t": [137,  138], "ja": "よし" },
    { "t": [138,  139], "ja": "はい、それはやめましょう" },
    { "t": [139,  140], "ja": "ちょっと待って、パム" },
    { "t": [140,  144], "ja": "アンディ、賞品がアンジェラだと完全に理解しているか？" },
    { "t": [144,  146], "ja": "神に誓って、理解している" },
    { "t": [146,  150], "ja": "そしてドワイト、賞品がアンジェラだと完全に理解しているか？" },
    { "t": [150,  151], "ja": "理解している" },
    { "t": [151,  153], "ja": "二人とも銃を持たせればいい" },
    { "t": [153,  154], "ja": "スタンリー" },
    { "t": [154,  155], "ja": "ダーウィンだよ" },
    { "t": [155,  156], "ja": "ダーウィン" },
    { "t": [156,  158], "ja": "アンジェラが最後に誰とくっつくかなんてどうでもいい" },
    { "t": [158,  163], "ja": "ただ、どっちかがもう片方をボコボコにするのが見たいだけ" },
    { "t": [163,  165], "ja": "ただし…" },
    { "t": [165,  169], "ja": "アンジェラが殴られることもあると思う？" },
    { "t": [169,  171], "ja": "やった、トビーが来た！" },
    { "t": [171,  172], "ja": "ああ" },
    { "t": [172,  175], "ja": "みんな、職場の暴力に関する規則を説明しなきゃだめかな？" },
    { "t": [175,  176], "ja": "いいえ" },
    { "t": [176,  177], "ja": "はい" },
    { "t": [177,  178], "ja": "いや、大丈夫だ" },
    { "t": [178,  179], "ja": "説明して" },
    { "t": [179,  182], "ja": "ダンダー・ミフリンは、いかなる行為も一切容認しません" },
    { "t": [182,  186], "ja": "社員を危険にさらすことは、一切許さない方針です" },
    { "t": [186,  187], "ja": "分かりましたか？" },
    { "t": [187,  188], "ja": "分かった" },
    { "t": [188,  189], "ja": "はいはい" },
    { "t": [189,  190], "ja": "どうでもいい" },
    { "t": [190,  191], "ja": "分かったよ" },
    { "t": [191,  192], "ja": "よかった" },
    { "t": [192,  193], "ja": "ばっちり" },
    { "t": [193,  194], "ja": "よく分かった" },
    { "t": [194,  195], "ja": "よーく分かった" },
    { "t": [195,  196], "ja": "ああ" },
    { "t": [196,  197], "ja": "ドワイト？" },
    { "t": [197,  198], "ja": "武器は全部、職場から持ち出してくれたよね" },
    { "t": [198,  199], "ja": "もちろんです。大おばの墓にかけて誓います" },
    { "t": [199,  200], "ja": "墓はない" },
    { "t": [200,  201], "ja": "墓はない" },
    { "t": [201,  202], "ja": "コンバインに落ちた" },
