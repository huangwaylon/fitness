{
  "video": "CE95PhvQbvg",
  "lines": [
    { "t": [0, 3.1], "ja": "はい、何かの食べ物にアレルギーがあれば、数日でわかりますよ" },
    { "t": [3.2, 6.7], "ja": "この赤み具合からすると、針で刺されることにアレルギーがあるのかも" },
    { "t": [7.1, 9], "ja": "もう5軒くらい病院を回ったんだよ" },
    { "t": [9.3, 11.1], "ja": "足首を電子レンジにかけられた" },
    { "t": [11.2, 11.6], "ja": "レントゲンだね" },
    { "t": [11.7, 13.6], "ja": "科学のために血を持っていかれた" },
    { "t": [13.7, 14.3], "ja": "コレステロール検査ね" },
    { "t": [14.3, 17], "ja": "エイプリルは鼻の穴を取られた" },
    { "t": [17.2, 17.6], "ja": "診てもらったの" },
    { "t": [17.6, 20], "ja": "誰かが僕のあそこを見て、さわった" },
    { "t": [20.2, 20.8], "ja": "あれは変だったな" },
    { "t": [21, 22.3], "ja": "しかもあの人、医者でもなかった" },
    { "t": [22.5, 23.2], "ja": "あれは…" },
    { "t": [23.2, 25.5], "ja": "え？" },
    { "t": [26.2, 26.6], "ja": "ああ" },
    { "t": [27.1, 29], "ja": "家に帰って、僕にアイスを買おう" },
    { "t": [29, 30.4], "ja": "こちらが請求書です" },
    { "t": [31.2, 31.7], "ja": "ああ、うん" },
    { "t": [31.9, 32.5], "ja": "それはいらないよ" },
    { "t": [32.6, 33.8], "ja": "無料の医療カードを持ってるから" },
    { "t": [34.3, 37], "ja": "えっと、歯の治療には500ドルの自己負担があります" },
    { "t": [37.3, 38.7], "ja": "ああ、えっと、それは違うと思うな" },
    { "t": [39, 41.4], "ja": "保険っていうのがあるんだ" },
    { "t": [41.5, 42.1], "ja": "保険でカバーされるはずだよ" },
    { "t": [42.2, 43.1], "ja": "それでも500ドルです" },
    { "t": [44.6, 45.4], "ja": "どれどれ" },
    { "t": [46.1, 48.7], "ja": "ああ、だってさ、いいかい？" },
    { "t": [48.9, 49.1], "ja": "行くぞ！" },
    { "t": [49.3, 51.4], "ja": "食い逃げだ、どいて！" },
    { "t": [52.7, 53.1], "ja": "イエー！" },
    { "t": [53.5, 54.4], "ja": "ヒャッホー！" },
    { "t": [55.1, 55.6], "ja": "あらら" },
    { "t": [56.3, 57.8], "ja": "救急車を呼んだよ" },
    { "t": [58, 60.8], "ja": "別の救急車ね。僕がぶつかったやつじゃなくて！" },
    { "t": [61.4, 63.2], "ja": "ほかの医者に診てもらったほうがいいかも" },
    { "t": [64.1, 64.4], "ja": "いや" },
    { "t": [64.6, 65.5], "ja": "医者はもうたくさん" },
    { "t": [66.2, 67.5], "ja": "あいつらは詐欺師の集まりだ" },
    { "t": [67.9, 69.6], "ja": "タダのもので釣って" },
    { "t": [69.6, 70.9], "ja": "気づいたら、バーン！" },
    { "t": [71.6, 72.9], "ja": "救急車にぶつかってる" },
    { "t": [74, 74.9], "ja": "毎回そうなんだ" },
    { "t": [75.5, 77.3], "ja": "家に帰って、お互いを手当てしよう" },
    { "t": [77.6, 78.6], "ja": "裁縫セットを買えばいい" },
    { "t": [78.6, 81.3], "ja": "どこかの橋の下で、僕の唇を縫ってくれればいい" },
    { "t": [81.8, 83.3], "ja": "うーん、すごくロマンチック" },
    { "t": [85.2, 87.2], "ja": "ごめん、電話が来た" },
    { "t": [87.2, 87.8], "ja": "わかった" },
    { "t": [88, 89.8], "ja": "裁縫セットって保険でカバーされると思う？" },
    { "t": [90.2, 90.8], "ja": "それか食料品は？" },
    { "t": [90.9, 91.9], "ja": "それか、エックスボックスのゲームとか？" },
    { "t": [92.1, 92.9], "ja": "保険って何？" },
    { "t": [93.3, 94], "ja": "知らない" },
    { "t": [94, 94.6], "ja": "どうでもいいよ" },
    { "t": [94.6, 124.6], "ja": "また次回お会いしましょう" }
  ]
