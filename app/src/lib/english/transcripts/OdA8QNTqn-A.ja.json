{
  "video": "OdA8QNTqn-A",
  "lines": [
    { "t": [0.9,  2.6], "ja": "アン・パーキンス、気分はどう？" },
    { "t": [2.6,  3.4], "ja": "知らないほうがいいわよ" },
    { "t": [3.4,  4.7], "ja": "それだけが知りたいんだ" },
    { "t": [5.9,  7.5], "ja": "分かった、じゃあ、聞いたからにはね" },
    { "t": [7.5,  9], "ja": "お尻から首まで、ずっと突き刺すような痛みがあるの" },
    { "t": [9,  10.4], "ja": "お尻から首までね" },
    { "t": [10.4,  12], "ja": "お腹は妊娠線だらけで" },
    { "t": [12,  13.6], "ja": "昔の地球儀みたいになってる" },
    { "t": [13.6,  15], "ja": "胸もすごく痛くなってきてるし" },
    { "t": [15,  16.7], "ja": "それに、ブルック・シールズの" },
    { "t": [16.7,  17.6], "ja": "産後うつの本を読んだばかりで" },
    { "t": [17.6,  20.4], "ja": "今は「産後うつになる前の不安」になってるの" },
    { "t": [21.3,  22.6], "ja": "大丈夫、心配いらない" },
    { "t": [22.6,  24.3], "ja": "痛みにはタイレノールを" },
    { "t": [24.3,  25.8], "ja": "お腹にはシアバターを持ってくるよ" },
    { "t": [25.8,  28], "ja": "それに、豊かな体つきは" },
    { "t": [28,  30.6], "ja": "体が自然のとおりに、ちゃんと働いている証拠さ" },
    { "t": [30.6,  31.7], "ja": "ほら、これで大丈夫" },
    { "t": [31.7,  32.9], "ja": "少しは良くなった？" },
    { "t": [32.9,  34], "ja": "ええ、ありがとう" },
    { "t": [34,  35.2], "ja": "乳首について調べてるんだ" },
    { "t": [35.2,  36.8], "ja": "乳首が敏感になっているのは" },
    { "t": [36.8,  39.5], "ja": "乳首の乳管が開いてきているからなんだ" },
    { "t": [39.5,  41.8], "ja": "だから、この乳首キットを買ってきた" },
    { "t": [41.8,  43.4], "ja": "乳首の専門家、カーンスタンス社のだよ" },
    { "t": [43.4,  45.4], "ja": "乳首クリーム、乳首パッド" },
    { "t": [45.4,  47.6], "ja": "それに、乳首にニキビができたときのための" },
    { "t": [47.6,  49.3], "ja": "特別な乳首ニキビ軟膏も入ってる" },
    { "t": [49.3,  52], "ja": "もう、お願いだから「乳首」って言うのやめて" },
    { "t": [53.3,  55.1], "ja": "とにかく、これで敏感になったときに" },
    { "t": [55.1,  57.1], "ja": "少しでも楽になればいいな、その…" },
    { "t": [58,  60.9], "ja": "おっぱいの帽子のあたりがね" },
    { "t": [60.9,  62.2], "ja": "それとラマーズ教室？" },
    { "t": [62.2,  64.5], "ja": "あのネズミ講の話、聞いたらびっくりするわよ" },
    { "t": [64.5,  67.4], "ja": "ちょっと、ドナ、何やってるの？" },
    { "t": [67.4,  70.3], "ja": "私が煙とトロのそばにいられないの、知ってるでしょ？" },
    { "t": [70.3,  73.5], "ja": "最初は面白かったけど、もう手に負えないわ" },
    { "t": [73.5,  76.1], "ja": "ここは仕事の愚痴を言う場だったのに" },
    { "t": [76.1,  77.3], "ja": "あなたが独り占めしちゃった" },
    { "t": [77.3,  80], "ja": "そう、今は寿司と葉巻の会よ" },
    { "t": [80,  81.9], "ja": "へえ、そう" },
    { "t": [81.9,  83.1], "ja": "そういうことね" },
    { "t": [84.6,  85.5], "ja": "悪いことしたわね" },
    { "t": [85.5,  87.9], "ja": "私はしてない。これはキューバ産の葉巻で、これはブリよ" },
    { "t": [87.9,  88.7], "ja": "最高の気分" },
    { "t": [88.7,  89.6], "ja": "おっと！" },
    { "t": [89.6,  90.7], "ja": "窓の外に化け物が" },
    { "t": [90.7,  92.4], "ja": "私の一番の不満が何か分かる？" },
    { "t": [92.4,  94.4], "ja": "愚痴りたいことは山ほどあるのに" },
    { "t": [94.4,  95.4], "ja": "家には持ち帰れないの" },
    { "t": [95.4,  97.4], "ja": "だってクリスは世界一思いやりのある人で" },
    { "t": [97.4,  98.7], "ja": "ただ私を助けたいだけだから" },
    { "t": [98.7,  99.9], "ja": "そしたら私は申し訳なくなって" },
    { "t": [99.9,  101.3], "ja": "今度は助けたがる彼にイライラして" },
    { "t": [101.3,  102.8], "ja": "そしたらもっと申し訳なくなるの" },
    { "t": [102.8,  104.8], "ja": "あなたたちなら、愚痴っても平気だと思ったのに" },
    { "t": [104.8,  106.9], "ja": "ここで座って愚痴ってばかりなんだから" },
    { "t": [106.9,  108.8], "ja": "批判も罪悪感もなしにね。でも、あのね" },
    { "t": [108.8,  110.4], "ja": "私の勘違いだったみたい。それにね" },
    { "t": [110.4,  111.5], "ja": "もっと怒鳴りたいけど" },
    { "t": [111.5,  113.4], "ja": "ちょっとおもらししちゃったみたい" },
    { "t": [114.8,  115.8], "ja": "今度は何だ？" },
    { "t": [115.8,  117.4], "ja": "看護師さんが怒ってるのか？" },
    { "t": [117.4,  118.2], "ja": "どうでもいい" },
    { "t": [120.4,  122.8], "ja": "やあ、みんな、ちょうど夜のジョギングに行くところなんだ" },
    { "t": [122.8,  124.2], "ja": "一緒に来ない？" },
    { "t": [124.2,  125.2], "ja": "お断りよ" },
    { "t": [125.2,  127.4], "ja": "来たのは、あなたが自分の奥さんの面倒を見るべきだからよ" },
    { "t": [127.4,  128.9], "ja": "彼女、何にでも文句を言って" },
    { "t": [128.9,  130.3], "ja": "ワインとチーズの会を台無しにしてるの" },
    { "t": [130.3,  132.4], "ja": "文字どおり、質問が千個あるよ" },
    { "t": [132.4,  133.7], "ja": "なんでロンはヘッドホンをしてるの？" },
    { "t": [133.7,  134.8], "ja": "ワインとチーズの会って何？" },
    { "t": [134.8,  136.2], "ja": "それに、アンは何に文句を言ってるの？" },
    { "t": [136.2,  137.2], "ja": "主にあなたよ" },
    { "t": [137.2,  138.2], "ja": "あなたが彼女に愚痴を言わせないって" },
    { "t": [138.2,  139.1], "ja": "いつも全部を解決しようとして" },
    { "t": [139.1,  140.6], "ja": "忙しいから" },
    { "t": [140.6,  142.1], "ja": "僕が助けようとするのが嫌なの？" },
    { "t": [142.1,  144.9], "ja": "典型的なわなにはまったな、クリストファー" },
    { "t": [144.9,  146.8], "ja": "女性の問題を解決しようとするんだ" },
    { "t": [146.8,  148.9], "ja": "問題が何なのか、ただ聞く代わりにね" },
    { "t": [148.9,  150.2], "ja": "なんで大声なの？" },
    { "t": [150.2,  153.2], "ja": "トムが私のレコードを全部、この四角いのに入れたんだ" },
    { "t": [153.2,  154.9], "ja": "なあ、アンがタイレノールを欲しいなら" },
    { "t": [154.9,  156.2], "ja": "自分で取ってこられる" },
    { "t": [156.2,  159.1], "ja": "彼女が君に求めてるのは、目を見て" },
    { "t": [159.1,  161.8], "ja": "うなずいて、二つの魔法の言葉を言うことだけ" },
    { "t": [161.8,  162.7], "ja": "「それは最悪」" },
    { "t": [162.7,  164.3], "ja": "最悪" },
    { "t": [164.3,  165.4], "ja": "「それは最悪」？" },
    { "t": [165.4,  167.4], "ja": "俺は人生をかけて、恋愛のハウツー本を読んできたんだ" },
    { "t": [167.4,  169.8], "ja": "女の子をだまして好きにさせるためにね" },
    { "t": [169.8,  171.4], "ja": "アンが悩みを話してきても" },
    { "t": [171.4,  172.6], "ja": "解決しようとするな" },
    { "t": [172.6,  176.6], "ja": "ただ「うわ、それは最悪だね」って言え" },
    { "t": [176.6,  179.5], "ja": "曲が次から次へと流れてくる" },
    { "t": [179.5,  181.5], "ja": "これは素晴らしい四角だ" },
    { "t": [183.2,  184.7], "ja": "やあ、今日はどうだった？" },
    { "t": [184.7,  185.8], "ja": "まあまあ" },
    { "t": [185.8,  187.8], "ja": "今度は脚がすごく痛いの" },
    { "t": [187.8,  190.7], "ja": "緊張型の頭痛みたいなのが、ふくらはぎにある感じ" },
    { "t": [190.7,  192.2], "ja": "毎日、新しい驚きがあるのよ" },
    { "t": [194.3,  195.4], "ja": "それは最悪だね" },
    { "t": [195.4,  196.7], "ja": "でしょ" },
    { "t": [196.7,  198.2], "ja": "それに、ガスがすごいの" },
    { "t": [198.2,  201.4], "ja": "長くてゆっくりなおならが、ずっと出続けてるの" },
    { "t": [201.4,  203], "ja": "話し始めてからね" },
    { "t": [203,  204.3], "ja": "今朝からよ" },
    { "t": [204.3,  205.6], "ja": "それは本当に最悪だね" },
    { "t": [205.6,  206.8], "ja": "ええ" },
    { "t": [206.8,  207.8], "ja": "本当にね" },
    { "t": [209.6,  210.4], "ja": "ありがとう" },
    { "t": [212.4,  214.9], "ja": "君の問題を全部解決しようとして、ごめんね" },
    { "t": [214.9,  217.4], "ja": "もう、謝らないで" },
    { "t": [217.4,  219.9], "ja": "私こそ、変になっちゃってごめん" },
    { "t": [219.9,  223.6], "ja": "あなたは、女の子が望める中で一番優しくて思いやりのある赤ちゃんのパパよ" }
  ]
}
