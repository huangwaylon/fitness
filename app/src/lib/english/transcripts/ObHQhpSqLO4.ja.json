{
  "video": "ObHQhpSqLO4",
  "lines": [
    { "t": [1,  3.6], "ja": "こんにちは、レスリーです。クリスさん？" },
    { "t": [3.6,  4.8], "ja": "ああ。遅れてごめん" },
    { "t": [4.8,  6.6], "ja": "あら、気にしないで" },
    { "t": [6.6,  8], "ja": "きれいだね" },
    { "t": [8,  9], "ja": "ありがとう" },
    { "t": [9,  10.2], "ja": "あ、ほら、コートを預かるよ" },
    { "t": [10.2,  12.4], "ja": "あら、ありがとう。どうぞ" },
    { "t": [12.4,  14.8], "ja": "でかしたわ、アン" },
    { "t": [14.8,  17.8], "ja": "実は聞こえてたよ。え？" },
    { "t": [17.8,  21.6], "ja": "えっと、学部も大学院もウィスコンシンだったんだ" },
    { "t": [21.6,  22.6], "ja": "行け、バジャーズ" },
    { "t": [22.6,  24.2], "ja": "ブー。インディアナ・フージャーズよ" },
    { "t": [24.2,  26.4], "ja": "いや、バジャーズだ" },
    { "t": [26.4,  29], "ja": "まあ、それは大事なことじゃないわ" },
    { "t": [29,  32.2], "ja": "とにかく、こうして会えてうれしい" },
    { "t": [32.2,  34.2], "ja": "アンが君のことをずっとすごいって言ってて" },
    { "t": [34.2,  36.2], "ja": "自分の目で確かめたくなったんだ" },
    { "t": [36.2,  37.8], "ja": "ええ、アンは私の一番の親友なの" },
    { "t": [37.8,  41.2], "ja": "君がインディアナ大学だって、言っておいてほしかったけど、まあいいや" },
    { "t": [41.2,  43.4], "ja": "で、君は遊園地の担当なんだよね？" },
    { "t": [43.4,  44.4], "ja": "へえ、楽しそう" },
    { "t": [44.4,  46.8], "ja": "実は、普通の公園なの" },
    { "t": [46.8,  48.8], "ja": "ブランコとか滑り台とか" },
    { "t": [48.8,  51.8], "ja": "これで2回目の失敗ね" },
    { "t": [51.8,  55.8], "ja": "ねえ、こういう紹介って、いつもすごく気まずいのが面白くない？" },
    { "t": [56.4,  60.2], "ja": "ねえ、見てて" },
    { "t": [60.2,  64.2], "ja": "今から素手でこのろうそくの火を消すよ" },
    { "t": [64.2,  67.2], "ja": "いいわよ" },
    { "t": [67.2,  69.2], "ja": "痛っ" },
    { "t": [69.2,  71], "ja": "本当に痛かった" },
    { "t": [71,  72], "ja": "大丈夫？" },
    { "t": [72,  74.2], "ja": "もう、ネットではずっと簡単そうだったのに" },
    { "t": [74.2,  76.2], "ja": "ああ、氷を借りなきゃ" },
    { "t": [79.2,  82.6], "ja": "それで、楽しい？ エムアールアイの技師の仕事って" },
    { "t": [82.6,  84], "ja": "いい質問だね" },
    { "t": [84,  85.8], "ja": "誰かが部屋に入ってくる" },
    { "t": [85.8,  87.8], "ja": "3人の子を持つ母親を想像して" },
    { "t": [87.8,  88.8], "ja": "先生かもしれない" },
    { "t": [88.8,  91.8], "ja": "どこかが悪いのは分かってるけど、何なのかは分からない" },
    { "t": [91.8,  93.8], "ja": "彼女は怖がってる" },
    { "t": [93.8,  95.8], "ja": "1時間もしないうちに、僕にはそれが分かるんだ" },
    { "t": [95.8,  96.8], "ja": "彼女はどこが悪いの？" },
    { "t": [96.8,  98.8], "ja": "分からない" },
    { "t": [98.8,  101.8], "ja": "でも、エムアールアイ技師の一番いいところは" },
    { "t": [101.8,  104.6], "ja": "何でも中が見えることなんだ" },
    { "t": [104.6,  105.6], "ja": "あそこの男、見える？" },
    { "t": [105.6,  108.6], "ja": "彼の頭の中をのぞけるって想像してみて" },
    { "t": [108.6,  109.6], "ja": "へえ" },
    { "t": [109.6,  110.6], "ja": "だろ" },
    { "t": [110.6,  113.6], "ja": "このステーキも、このバターも、このパンも中が見られる" },
    { "t": [113.6,  116.6], "ja": "何でも中が見られるんだ" },
    { "t": [116.6,  119.6], "ja": "まあ、このパンの中を見ても、出てくるのはパンだけでしょ" },
    { "t": [119.6,  120.6], "ja": "さあね" },
    { "t": [120.6,  121.6], "ja": "エムアールアイを撮ってみないと" },
    { "t": [121.6,  124.6], "ja": "とにかく、天職が見つかってよかったわね" },
    { "t": [124.6,  128.4], "ja": "私なんて、エムアールアイを撮ったことすらないし" },
    { "t": [128.4,  129.4], "ja": "何だって？" },
    { "t": [131.4,  133.4], "ja": "どうしようかしら" },
    { "t": [133.4,  136.4], "ja": "無料で検査してあげるって言ってるんだよ" },
    { "t": [136.4,  138.4], "ja": "普通なら最大2000ドルかかるんだ" },
    { "t": [138.4,  140.4], "ja": "ちょっと甘やかしてるくらいさ" },
    { "t": [140.4,  143.4], "ja": "まあ、ちょっと興味はあるかも" },
    { "t": [143.4,  144.4], "ja": "よかった" },
    { "t": [144.4,  147.4], "ja": "正直、余命3か月の人に時間をかけたくないからね" },
    { "t": [147.4,  154.2], "ja": "まあ、冒険だと思うようにしてるの" },
    { "t": [154.2,  157.2], "ja": "すぐにまた馬に乗るみたいなものよ" },
    { "t": [157.2,  161.2], "ja": "その馬がいかれてて、私の体の中をのぞきたがってるとしてもね" },
    { "t": [161.2,  164.2], "ja": "どんな感じ？" },
    { "t": [164.2,  165.2], "ja": "うーん、変な感じ" },
    { "t": [165.2,  166.2], "ja": "完璧だ" },
    { "t": [166.2,  168.2], "ja": "あ、今、生理中じゃないよね？" },
    { "t": [168.2,  169.2], "ja": "違うわ" },
    { "t": [169.2,  170.2], "ja": "関係あるの？" },
    { "t": [170.2,  172.2], "ja": "まあ、これには関係ない" },
    { "t": [172.2,  175.2], "ja": "よし、中はちょっと窮屈だよ" },
    { "t": [175.2,  177.2], "ja": "心配しないで、ガラスのすぐ向こう側にいるから" },
    { "t": [177.2,  182], "ja": "で、出身を聞いてなかったね" },
    { "t": [182,  183], "ja": "ポーニーよ" },
    { "t": [183,  184], "ja": "じっとしてて" },
    { "t": [184,  186], "ja": "どんな音楽が好き？" },
    { "t": [186,  188], "ja": "答えていいの？" },
    { "t": [188,  189], "ja": "いいよ、じっとしててね" },
    { "t": [189,  191], "ja": "何でも" },
    { "t": [191,  194], "ja": "今はじっとしていることがすごく大事なんだ、レスリー" },
    { "t": [194,  197], "ja": "もう千回は言ったよ" },
    { "t": [197,  199], "ja": "腕を骨折したことある？" },
    { "t": [199,  200], "ja": "答えていいよ" },
    { "t": [200,  201], "ja": "ほら、止めてあげる" },
    { "t": [201,  204], "ja": "一度、自転車に乗ってたら、男の子たちにからかわれて" },
    { "t": [204,  206], "ja": "追いかけたら、ハンドルを取られちゃったの" },
    { "t": [206,  207.8], "ja": "それが見えるなんて驚き" },
    { "t": [207.8,  209.8], "ja": "3年くらい前のことなのに" },
    { "t": [209.8,  212.8], "ja": "そんなことのために機械を止めたなんて" },
    { "t": [212.8,  215.8], "ja": "子どもはいないんだよね、レスリー？" },
    { "t": [215.8,  216.8], "ja": "いないわ" },
    { "t": [216.8,  218.8], "ja": "立派なオーブンを持ってるね" },
    { "t": [218.8,  219.8], "ja": "はいはい" },
    { "t": [219.8,  220.8], "ja": "もう帰る時間ね" },
    { "t": [220.8,  221.8], "ja": "中は十分な広さがある" },
    { "t": [221.8,  223.8], "ja": "正直、その気になれば" },
    { "t": [223.8,  226.8], "ja": "最初から三つ子もいけるよ、レスリー" },
    { "t": [226.8,  231.6], "ja": "大型の業務用オーブンがあるからね。じゃあ、これで終わり" }
  ]
}
