"t":[148,150],"en":"-Do you have something in your pocket?"},{"t":[153,154],"en":"-Chunky."},{"t":[159,160],"en":"Do I have?"},{"t":[160,161],"en":"-No, thank you."},{"t":[161,162],"en":"-Okay."},{"t":[163,165],"en":"-It is a message."},{"t":[165,168],"en":"It is an inspiration."},{"t":[168,173],"en":"It is a source of beauty."},{"t":[173,175],"en":"And without paper,"},{"t":[175,178],"en":"it could not have happened."},{"t":[179,182],"en":"Unless you had a camera."},{"t":[198,202.4],"en":"Thank you very much."}]}
