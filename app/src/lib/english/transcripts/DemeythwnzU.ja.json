{
  "video": "DemeythwnzU",
  "lines": [
    { "t": [0,1.3], "ja": "－もう一度言うぞ" },
    { "t": [1.3,4.2], "ja": "男子トイレには、洗顔料用の別のディスペンサーが必要だ" },
    { "t": [4.2,6.1], "ja": "ハンドソープで顔は洗えない" },
    { "t": [6.1,8], "ja": "この毛穴を見てくれ。ぱっくり開いてる" },
    { "t": [8,9.6], "ja": "－ねえ、みんな　－タイム" },
    { "t": [9.6,11.6], "ja": "少し休憩にしよう" },
    { "t": [11.6,12.5], "ja": "アン、何か用？" },
    { "t": [12.5,14.9], "ja": "－レスリーを探してたんだけど、今は気になるわ" },
    { "t": [14.9,16.7], "ja": "なんでみんな、何もしないで座り込んで" },
    { "t": [16.7,18.4], "ja": "仕事中に酔っぱらってるのか" },
    { "t": [18.4,20], "ja": "－これはワインとチーズの会さ、美人さん" },
    { "t": [20,22.2], "ja": "月に一回みんなで集まって" },
    { "t": [22.2,23.8], "ja": "仕事でむかつくことを吐き出すんだ" },
    { "t": [23.8,26.4], "ja": "－もちろん、上等なワインとチーズを味わいながらね" },
    { "t": [26.4,28.1], "ja": "－ラリー、サラミ！" },
    { "t": [28.1,30.7], "ja": "－人事部の決まりで、私は月に一度" },
    { "t": [30.7,32.7], "ja": "時間をとらなければならない" },
    { "t": [32.7,36.4], "ja": "部下と職場のもめ事について話し合うためにな" },
    { "t": [36.4,39], "ja": "だが決まりには書かれていない" },
    { "t": [39,42.6], "ja": "ヘッドホンでウィリー・ネルソンを聞いてはいけないとは" },
    { "t": [42.6,45], "ja": "－それにカイルがまた私の場所に車を停めたの" },
    { "t": [45,46.7], "ja": "これで今月4回目よ" },
    { "t": [46.7,47.8], "ja": "－やあ、ウォルト　－悪かったよ" },
    { "t": [47.8,49.4], "ja": "誰だって間違えることはある" },
    { "t": [49.4,51.3], "ja": "あいつ、俺を見て、自分のことを…" },
    { "t": [51.3,55], "ja": "－今日はどうだった？" },
    { "t": [55,57.1], "ja": "－気を失うまで首を絞めてやりたい" },
    { "t": [57.1,58.5], "ja": "－タイム？　－楽しそう" },
    { "t": [58.5,59.4], "ja": "私もやってみたい" },
    { "t": [59.4,60.8], "ja": "－うーん、これにはルールがあるのよ、お嬢ちゃん" },
    { "t": [60.8,61.9], "ja": "次はドナの番" },
    { "t": [61.9,63.4], "ja": "－私の時間は最後に回すわ" },
    { "t": [63.4,64.9], "ja": "なんだか面白くなりそうな気がする" },
    { "t": [64.9,66.3], "ja": "－じゃあ、長くは話さないわ" },
    { "t": [66.3,67.7], "ja": "またトイレに行きたいから" },
    { "t": [67.7,69], "ja": "6分ごとにトイレに行かなきゃいけないの" },
    { "t": [69,71.2], "ja": "お腹にビーチボールが入ってて" },
    { "t": [71.2,72.4], "ja": "それがぼうこうをパンチしてくるから" },
    { "t": [72.4,74.2], "ja": "－それはきついな" },
    { "t": [74.2,75.4], "ja": "－でしょ" },
    { "t": [75.4,76.4], "ja": "それに、いつもお腹がすいてるの" },
    { "t": [76.4,77.2], "ja": "－じゃあ、チーズを食べなよ" },
    { "t": [77.2,78.6], "ja": "－チーズはだめなのよ、ラリー" },
    { "t": [78.6,79.9], "ja": "ワインもだめ" },
    { "t": [79.9,81.4], "ja": "おいしいものは何もだめなの" },
    { "t": [81.4,84.4], "ja": "食べていいのは、液状のアマニくらい" },
    { "t": [84.4,86.1], "ja": "でもそんなの欲しくない。私が何を食べたいか分かる？" },
    { "t": [86.1,87], "ja": "豚の皮の揚げせんべい" },
    { "t": [87,87.9], "ja": "ゼリービーンズも食べたい" },
    { "t": [87.9,90.8], "ja": "それに、マッシュポテトがぎっしり詰まった巨大なゴミ袋も欲しい" },
    { "t": [90.8,92], "ja": "パックマンになりたい" },
    { "t": [92,94.4], "ja": "それで、点の代わりにシナモンロールを食べたいの" },
    { "t": [94.4,96.5], "ja": "巨大な頭と口だけになりたい" },
    { "t": [96.5,99.4], "ja": "ジャンクフードの粒を、何列も何列も食べたいのよ" },
    { "t": [99.4,102.1], "ja": "で、私のポテト入りゴミ袋はどこ？" },
    { "t": [102.1,105.5], "ja": "うう" },
    { "t": [105.5,106.8], "ja": "－俺は…" },
    { "t": [106.8,108.2], "ja": "－うわあ" },
    { "t": [108.2,109.9], "ja": "－看護師さん、これはどういうことだ？" },
    { "t": [109.9,111.7], "ja": "－ワインとチーズの会、緊急開催よ" },
    { "t": [111.7,112.9], "ja": "ロン、ヘッドホンをつけて" },
    { "t": [112.9,114], "ja": "文句がたくさんあるの" },
    { "t": [114,115], "ja": "座って" },
    { "t": [115,116], "ja": "吐き出したいの" },
    { "t": [116,118.2], "ja": "それから、どんなことがあっても" },
    { "t": [118.2,119.5], "ja": "私の言うことに何も言い返さないで" },
    { "t": [119.5,120.6], "ja": "いいわね" },
    { "t": [120.6,122.3], "ja": "さあ、吐き気の話をしましょう" },
    { "t": [122.3,124.3], "ja": "一日中吐いてるの" },
    { "t": [124.3,126.1], "ja": "－うう、それに出産準備のクラス？" },
    { "t": [126.1,128.3], "ja": "あのインチキな仕組みの話をしたら驚くわよ" },
    { "t": [128.3,131.2], "ja": "－ちょっと、ドナ、何なの？" },
    { "t": [131.2,134.1], "ja": "私がたばこの煙や脂ののったマグロのそばにいちゃいけないのは知ってるでしょ" },
    { "t": [134.1,135.1], "ja": "ロン…" },
    { "t": [135.1,137.4], "ja": "－最初は面白かったが、もう度が過ぎている" },
    { "t": [137.4,139.9], "ja": "ここは仕事の愚痴を吐き出す場だったのに" },
    { "t": [139.9,141.2], "ja": "君が乗っ取ってしまった" },
    { "t": [141.2,142.1], "ja": "－そうよ" },
    { "t": [142.1,143.9], "ja": "今日からは寿司と葉巻の会なの" },
    { "t": [143.9,144.6], "ja": "－へえ" },
    { "t": [144.6,145.7], "ja": "分かった" },
    { "t": [145.7,148.5], "ja": "そういうことね" },
    { "t": [148.5,149.4], "ja": "－悪いことしたな" },
    { "t": [149.4,150.3], "ja": "－私はそうは思わん" },
    { "t": [150.3,150.9], "ja": "これはキューバ産の葉巻だ" },
    { "t": [150.9,151.7], "ja": "これはブリだ" },
    { "t": [151.7,152.6], "ja": "最高の気分だ" },
    { "t": [152.6,153.4], "ja": "－うわっ！" },
    { "t": [153.4,154.6], "ja": "窓に怪物がいる" },
    { "t": [154.6,156.2], "ja": "－私のいちばんの不満が何か分かる？" },
    { "t": [156.2,158.2], "ja": "文句を言いたいことが山ほどあるのに" },
    { "t": [158.2,159.3], "ja": "家では言えないの" },
    { "t": [159.3,161.3], "ja": "だってクリスは世界一思いやりのある人で" },
    { "t": [161.3,162.6], "ja": "ただ私を助けたいだけなのよ" },
    { "t": [162.6,163.8], "ja": "そうすると私は申し訳なくなって" },
    { "t": [163.8,165.2], "ja": "今度は助けようとする彼にイライラして" },
    { "t": [165.2,166.6], "ja": "それでもっと自分が嫌になるの" },
    { "t": [166.6,168.7], "ja": "みんななら、私が文句を言っても平気だと思ってた" },
    { "t": [168.7,170.8], "ja": "だってここで座って文句ばっかり言ってるでしょ" },
    { "t": [170.8,172.2], "ja": "責められることも、悪いと思うこともなく" },
    { "t": [172.2,173], "ja": "でもね" },
    { "t": [173,174.4], "ja": "私が間違ってたみたい。それにね" },
    { "t": [174.4,175.4], "ja": "もっと怒鳴りたいところだけど" },
    { "t": [175.4,177.2], "ja": "今ちょっとおもらししちゃったみたい" },
    { "t": [178.7,179.7], "ja": "－今度は何だ？" },
    { "t": [179.7,181.3], "ja": "看護師さんは怒ってるのか？" },
    { "t": [181.3,182], "ja": "－どうでもいい" }
  ]
}
