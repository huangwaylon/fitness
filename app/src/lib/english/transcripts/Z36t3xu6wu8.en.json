:"What the ?"},{"t":[118,119],"en":"Nice."},{"t":[119,136],"en":"Hey, Ron, were you trying to get a seven?"},{"t":[136,137],"en":"Because if you were, you did a great job."},{"t":[137,139],"en":"I am very angry right now."},{"t":[139,140],"en":"Ow."},{"t":[140,141],"en":"What?"},{"t":[141,142],"en":"My finger was in there."},{"t":[142,143],"en":"Ron crossed my finger."},{"t":[143,144],"en":"I think it might be broken."},{"t":[144,145],"en":"Are you a female bird?"},{"t":[145,146],"en":"It was an accident."},{"t":[146,147],"en":"Oh, my God."},{"t":[147,148],"en":"It's already swollen."},{"t":[148,149],"en":"Tom, my God."},{"t":[149,150],"en":"Do you have any pride at all?"},{"t":[150,151],"en":"This is on purpose."},{"t":[151,152],"en":"You're jealous of my give."},{"t":[152,153],"en":"Okay, come on, Tweety Bird."},{"t":[153,154],"en":"Let's get you some ice."},{"t":[154,155],"en":"It hurt."},{"t":[155,156],"en":"Come on."},{"t":[156,157],"en":"Okay, everything's settled here."},{"t":[157,158],"en":"Want to head home?"},{"t":[158,159],"en":"No."},{"t":[159,160],"en":"We haven't finished yet."},{"t":[160,161],"en":"Last frame."},{"t":[161,162],"en":"Your turn."},{"t":[162,163],"en":"He hurt his hands."},{"t":[163,164],"en":"Last frame."},{"t":[164,165],"en":"Go."},{"t":[165,166],"en":"Fine."},{"t":[166,167],"en":"I'll bowl one-handed."},{"t":[167,168],"en":"Like an idiot."},{"t":[168,169],"en":"You need six pins to win."},{"t":[186,187],"en":"Woo."},{"t":[187,188],"en":"Oh, come on."},{"t":[188,190],"en":"King Kong ain't got nothing on me."},{"t":[190,192],"en":"Oh, my bingy still hurts."},{"t":[192,193],"en":"Oh, the bravery."},{"t":[193,194],"en":"The perseverance."},{"t":[194,196],"en":"You're an American hero."},{"t":[196,198],"en":"And the best part is beautiful."},{"t":[198,199],"en":"You get to drive the champion home."},{"t":[199,201],"en":"Here you go, lane eight."},{"t":[201,203],"en":"No, lane 22."},{"t":[203,204],"en":"The one at the very end."},{"t":[212,