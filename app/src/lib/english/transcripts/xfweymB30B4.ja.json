  "lines": [
    { "t": [0,  3.4], "ja": "シアトル・スーパーセンターへようこそ。今夜はエキシビションマッチ" },
    { "t": [3.5,  7.2], "ja": "シーエフシー王者シェルビー・マークスと、カーリー・シェイの対戦です" },
    { "t": [7.3,  8.8], "ja": "ネット番組をやっている子です" },
    { "t": [9.6,  11.6], "ja": "さあ、メインイベントの始まりです" },
    { "t": [13.7,  15], "ja": "よし、出番だよ" },
    { "t": [15.1,  16.1], "ja": "楽しんでおいで" },
    { "t": [16.2,  17.6], "ja": "よし、いいところ見せてね。それと、忘れないで" },
    { "t": [21.7,  22.5], "ja": "ちょっと" },
    { "t": [23.4,  25.1], "ja": "それはないでしょ。ごめん" },
    { "t": [26.4,  27.9], "ja": "もう行ったほうがいいよ。うん" },
    { "t": [27.9,  29.3], "ja": "さあ、始まります" },
    { "t": [30,  32.2], "ja": "どうも。どうも" },
    { "t": [34.1,  36.7], "ja": "はい、お二人さん、メインイベント、いよいよ本番だ" },
    { "t": [36.8,  39.6], "ja": "見ている何百万人ものファンに、いい試合を見せよう" },
    { "t": [39.7,  43], "ja": "では、それぞれのコーナーに戻って、さあ始めよう" },
    { "t": [43.1,  44.1], "ja": "いいね" },
    { "t": [46.9,  47.9], "ja": "おっと" },
    { "t": [49,  50.3], "ja": "準備はいい？ うん" },
    { "t": [50.4,  51.4], "ja": "口を開けて" },
    { "t": [53.4,  55.4], "ja": "よし、行っておいで、楽しんで" },
    { "t": [55.4,  56.4], "ja": "うん" },
    { "t": [58.2,  60.5], "ja": "さて、これはエキシビションマッチなので" },
    { "t": [60.5,  62.5], "ja": "3分1ラウンドだけの予定です" },
    { "t": [62.6,  64.9], "ja": "でも、シェルビー・マークス相手に1ラウンドもった人はいないので" },
    { "t": [65,  66.8], "ja": "あまり関係ないでしょうね" },
    { "t": [66.9,  69.2], "ja": "どうも。おかげで自分がばかみたいに思えてきたよ、マーヴィン" },
    { "t": [72.2,  73.9], "ja": "行け、シェルビー！ 準備はいい？" },
    { "t": [74,  75.9], "ja": "いけるよ、シェルビー！ 準備はいい？" },
    { "t": [78.9,  80.1], "ja": "ファイト！ 準備はいい？" },
    { "t": [80.2,  81.1], "ja": "（聞き取れない）" },
    { "t": [81.2,  82.1], "ja": "（聞き取れない）" },
    { "t": [82.2,  83.1], "ja": "（聞き取れない）" },
    { "t": [83.2,  84.1], "ja": "だめ！ だめ！" },
    { "t": [84.2,  85.1], "ja": "だめ！ だめ！" },
    { "t": [97.1,  98.1], "ja": "痛っ！" },
    { "t": [100.2,  102.1], "ja": "タイム！ タイム？ タイムなんてない！" },
    { "t": [102.1,  103.9], "ja": "タイムは取れないよ！" },
    { "t": [103.9,  105.4], "ja": "タイムは取れないってば！" },
    { "t": [105.5,  106.9], "ja": "ああ、やるしかない！" },
    { "t": [108.8,  111.3], "ja": "えー、非公式のタイムです" },
    { "t": [111.4,  113.4], "ja": "もう、あの子、本気で殺しにきてる！" },
    { "t": [113.5,  114.8], "ja": "手加減してくれるはずじゃなかった？" },
    { "t": [114.9,  115.8], "ja": "本人もそう言ってたのに！" },
    { "t": [115.9,  116.8], "ja": "あの子、何やってるのか分からない" },
    { "t": [116.9,  120.1], "ja": "行け、シェイ！ 頑張れ、カーリー！" },
    { "t": [120.2,  121.7], "ja": "みんな！ みんな、やってるよ！" },
    { "t": [121.8,  123.1], "ja": "（聞き取れない） やってるよ！" },
    { "t": [123.2,  124.7], "ja": "（聞き取れない）" },
    { "t": [124.8,  127.5], "ja": "（聞き取れない） ねえ、シェルビー" },
    { "t": [127.5,  132.3], "ja": "手加減して、本気で殴らないって約束したの、覚えてる？" },
    { "t": [132.3,  133.2], "ja": "痛っ！" },
    { "t": [141.1,  142.1], "ja": "やめて！ やめて！ やめて！" },
    { "t": [142.2,  145.1], "ja": "放して、カーリー！ 脚を放して！" },
    { "t": [145.2,  148.1], "ja": "シェイ、王者の左脚にしがみついています！" },
    { "t": [149.1,  150.2], "ja": "とても珍しい" },
    { "t": [150.3,  152.9], "ja": "こんな技は見たことがないですね" },
    { "t": [153,  156.1], "ja": "やめて！ 脚を放して！ 絶対いや！" },
    { "t": [156.1,  157.8], "ja": "脚を放しちゃだめ！" },
    { "t": [157.9,  158.9], "ja": "脚を放しちゃだめ！" },
    { "t": [159,  160.3], "ja": "いや！ ほら！ がんばって！" },
    { "t": [160.4,  162.4], "ja": "カーリー、がんばれ！" },
    { "t": [162.4,  163.4], "ja": "カーリー、がんばれ！" },
    { "t": [163.4,  165.2], "ja": "マークスがシェイを脚から振り落とそうとしています" },
    { "t": [165.3,  167.7], "ja": "しかし、シェイは必死にしがみついている！" },
    { "t": [167.8,  169.7], "ja": "いいぞ！ ほら！ いいぞ！ ほら！" },
    { "t": [171.2,  174.2], "ja": "誰か、この子を脚からはがしてくれない？ 殴れないじゃない" },
    { "t": [174.3,  175.7], "ja": "カーリー、がんばれ！" },
    { "t": [175.8,  180.2], "ja": "カーリー、このラウンドは残り10秒！" },
    { "t": [180.2,  183.7], "ja": "がんばって、カーリー！ よし！" },
    { "t": [183.8,  184.7], "ja": "うそでしょ！" },
    { "t": [184.8,  190.8], "ja": "あと8秒で、カーリー・シェイはシェルビー・マークス相手に1ラウンドもった初めての女の子になります" },
    { "t": [192.9,  198.1], "ja": "5、4、3、2、1！" },
    { "t": [200.3,  202.1], "ja": "反則だ！" },
    { "t": [205.5,  213.1], "ja": "そしてカーリー・シェイ、叫びながら逃げていきます。反則だ！ これは反則じゃない！" },
    { "t": [214.6,  215.7], "ja": "カーリー！ カーリー！" },
    { "t": [215.8,  218], "ja": "どこにいるか分からない。そっちを見て。ああ、もう！" },
    { "t": [218.1,  219.5], "ja": "えーと… カーリー！" },
    { "t": [219.6,  221.7], "ja": "下には絶対いないよ。最前列に行ったのかも？" },
    { "t": [221.8,  222.9], "ja": "みんな！ こっち！" },
    { "t": [223,  224.3], "ja": "やあ！" },
    { "t": [224.4,  226], "ja": "いい試合だった！ すごい！" },
    { "t": [226.1,  228.8], "ja": "最高だったよ！ すごかった！" },
    { "t": [228.9,  230.5], "ja": "やめてよ〜！ すごかったよ！" },
    { "t": [230.5,  233], "ja": "パンチもキックも一回もしなかったし、すごくぶざまだったけど" },
    { "t": [233.1,  235.7], "ja": "一流のプロ格闘家相手に、まる1ラウンドもったんだ！" },
    { "t": [235.8,  236.9], "ja": "待って、拍手！ 待って、拍手！" },
    { "t": [237,  240.6], "ja": "ずっと走り回るつもり… ずっと走り回るつもり…" },
    { "t": [240.7,  242.2], "ja": "ねえ、なんでみんな…" },
    { "t": [244.8,  246.6], "ja": "何の用？ カーリーと話したいの" },
    { "t": [246.7,  248], "ja": "聞きたいことがあって…" },
    { "t": [252.5,  253.7], "ja": "本当にごめん" },
    { "t": [258.7,  260.4], "ja": "車で待ってる！" },
    { "t": [264.5,  268], "ja": "今夜はどうしたの？ 手加減するって約束したじゃない" },
    { "t": [268.5,  270.8], "ja": "私が知ってるのは、ある子がジムに来て、動画を見せてきたってことだけ" },
    { "t": [270.9,  272.4], "ja": "記者会見であなたたちが" },
    { "t": [272.5,  274.6], "ja": "私のおばあちゃんを突き飛ばすって話してる動画" },
    { "t": [274.7,  276.4], "ja": "どんな子？ 分からない" },
    { "t": [276.5,  279.3], "ja": "これくらいの背で、私たちと同い年、丸い頭、礼儀正しいけど、すごく気味悪い子" },
    { "t": [280.3,  281.3], "ja": "ネヴィル。ネヴィル" },
    { "t": [282.2,  284.6], "ja": "これで分かった。ネヴィルが偽の動画を作ったんだ" },
    { "t": [284.6,  285.6], "ja": "あのちびめ" },
    { "t": [286.9,  288.3], "ja": "まだここにいるかも。見てきて！" },
    { "t": [288.4,  288.9], "ja": "了解" },
    { "t": [293.5,  295.6], "ja": "ネヴィルの頭って、ちょっと丸いよね。メロンみたい" },
    { "t": [295.7,  296.2], "ja": "うん" },
    { "t": [299.4,  302], "ja": "放せ！ 本気だぞ、フレディ・ベンソン！" },
    { "t": [302.1,  303.7], "ja": "僕には権利がある！" },
    { "t": [303.8,  306.7], "ja": "僕の意思に反して、ここに引きずってくるのは違法だ" },
    { "t": [306.8,  309.2], "ja": "さもないと、君を裁判所に引きずり出すぞ！" },
    { "t": [309.3,  310.7], "ja": "訴えてやる！ 分かったよ！" },
    { "t": [310.7,  311.7], "ja": "放したよ！" },
    { "t": [312.5,  314.7], "ja": "ギビー、明かり！ 明かり！" },
    { "t": [315.7,  317.9], "ja": "よし、フレディ、君なんか怖くない" },
    { "t": [318.7,  319.5], "ja": "いいね" },
    { "t": [321.5,  323.7], "ja": "君なんか怖くない。こんにちは、ネヴィル" },
    { "t": [324.7,  328.3], "ja": "こんにちは、ネヴィル。君も怖くない" },
    { "t": [332.5,  336.6], "ja": "よう、ネヴィル。……分かった、君は怖い" },
    { "t": [338.3,  340.5], "ja": "いいから認めなよ。何を？" },
    { "t": [340.6,  345.6], "ja": "偽の動画でシェルビー・マークスをだましたこと。私が彼女のおばあちゃんにタックルするつもりに見える動画で" },
    { "t": [345.7,  348.2], "ja": "そんなことはしてない" },
    { "t": [350.2,  351.8], "ja": "分かった、シェルビーをだました" },
    { "t": [354.7,  355.4], "ja": "だから何？" },
    { "t": [358.3,  359], "ja": "こんにちは、ネヴィル" },
    { "t": [359.9,  360.5], "ja": "うわ、まずい" },
    { "t": [364.3,  366], "ja": "あ、分かった。分かったよ" },
    { "t": [366.7,  367.5], "ja": "そもそも何をする気？" },
    { "t": [368.1,  370.9], "ja": "お嬢さんたち、僕のズボンはとても高いんだ" },
