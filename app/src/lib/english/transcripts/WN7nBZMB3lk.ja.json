  "lines": [
    { "t": [0, 5], "ja": "おはようございます、マイケル" },
    { "t": [5, 7], "ja": "おっと、違う、違う、違う、違う" },
    { "t": [7, 9], "ja": "私はマイケルではない" },
    { "t": [9, 13], "ja": "私はウィリー・ウォンカだ！" },
    { "t": [13, 14], "ja": "おはようございます、ウォンカさん" },
    { "t": [14, 15], "ja": "伝言です" },
    { "t": [15, 16], "ja": "おや、どうもありがとう" },
    { "t": [16, 17], "ja": "それは何ですか？" },
    { "t": [17, 18], "ja": "それは何ですか？" },
    { "t": [18, 19], "ja": "教えてください" },
    { "t": [19, 20], "ja": "ジェリービーンズ" },
    { "t": [20, 21], "ja": "違う、違う、違う" },
    { "t": [21, 24], "ja": "ただの普通のジェリービーンズではないのだよ、お嬢さん" },
    { "t": [24, 29], "ja": "これは並外れたジェリービーンズなのだ" },
    { "t": [29, 32], "ja": "ウィリー・ウォンカの金のチケットの販促アイデアは" },
    { "t": [32, 35], "ja": "たぶん僕が今までに思いついた中で最高のアイデアだ" },
    { "t": [35, 37], "ja": "たぶん人類が今までに思いついた中で最高のアイデアだ" },
    { "t": [37, 41], "ja": "3日前、5枚の金色の紙を" },
    { "t": [41, 43], "ja": "適当に選んだ紙の出荷品にこっそり入れたんだ" },
    { "t": [43, 47], "ja": "これで、お客さんは注文の合計から1割引きになる" },
    { "t": [47, 51], "ja": "お客さんにとっては、気まぐれな楽しさと" },
    { "t": [51, 56], "ja": "わくわくと夢にあふれた一日になるだろう" },
    { "t": [56, 57], "ja": "やあ、トム" },
    { "t": [57, 58], "ja": "何だって？" },
    { "t": [58, 60], "ja": "ああ、金のチケットを見つけたんだ" },
    { "t": [60, 61], "ja": "僕の顧客の一人が金のチケットを見つけた" },
    { "t": [61, 62], "ja": "ウッフッフー！" },
    { "t": [62, 63], "ja": "ああ" },
    { "t": [63, 64], "ja": "ラ・ディー・ドゥー！" },
    { "t": [64, 65], "ja": "いや、おめでとう" },
    { "t": [65, 66], "ja": "タ・タ・パ・タ！" },
    { "t": [66, 67], "ja": "おお！" },
    { "t": [67, 68], "ja": "ウッフッフー！" },
    { "t": [68, 69], "ja": "教えてくれ！" },
    { "t": [69, 70], "ja": "ああ、今すぐ書き留めるよ" },
    { "t": [70, 74], "ja": "唇の大きい、わがままな女の子だった？" },
    { "t": [74, 75], "ja": "ちょっと待って" },
    { "t": [75, 77], "ja": "それともカウボーイに夢中の変な男の子？" },
    { "t": [77, 78], "ja": "ちょっと待って" },
    { "t": [78, 79], "ja": "工場見学に招待しよう！" },
    { "t": [79, 80], "ja": "ちょっと待って" },
    { "t": [80, 82], "ja": "実はペンシルベニアのブルークロスなんだ" },
    { "t": [82, 83], "ja": "本当？" },
    { "t": [83, 84], "ja": "うん" },
    { "t": [84, 85], "ja": "大口の顧客だよ" },
    { "t": [85, 86], "ja": "おい！" },
    { "t": [86, 87], "ja": "オスカー！" },
    { "t": [87, 88], "ja": "ウッフッフー！" },
    { "t": [88, 91], "ja": "えっと、損害はどれくらい？" },
    { "t": [91, 93], "ja": "ブルークロスの取引の1割だよ" },
