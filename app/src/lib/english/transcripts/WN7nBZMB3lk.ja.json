    { "t": [114, 115], "ja": "それで…" },
    { "t": [115, 116], "ja": "わかった" },
    { "t": [116, 120], "ja": "じゃあ、僕は本社に電話して、売上の半分を失ったわけじゃないってわかってもらうよ" },
    { "t": [120, 121], "ja": "失ってない" },
    { "t": [121, 122], "ja": "それは…" },
    { "t": [122, 123], "ja": "大丈夫だ" },
    { "t": [123, 126], "ja": "うまくいく" },
