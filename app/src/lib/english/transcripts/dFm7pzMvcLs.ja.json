{
  "video": "dFm7pzMvcLs",
  "lines": [
    { "t": [1,  2.6], "ja": "60秒でロン" },
    { "t": [2.6,  4.5], "ja": "トム、今夜は見かけなかったな" },
    { "t": [4.5,  7], "ja": "プレゼンの準備をしてたんです" },
    { "t": [7,  8.8], "ja": "レスリーにお祝いを言いに来ただけで" },
    { "t": [8.8,  9.8], "ja": "すぐに戻ります" },
    { "t": [9.8,  11.4], "ja": "その勤勉さは立派だ" },
    { "t": [11.4,  13.4], "ja": "私は常に新しい投資先を探している" },
    { "t": [13.4,  15.9], "ja": "9歳で初めて仕事に就いて以来" },
    { "t": [15.9,  18.1], "ja": "金はすべて金（きん）につぎ込んできた" },
    { "t": [18.1,  20.3], "ja": "今、史上最高値だ" },
    { "t": [20.3,  23.8], "ja": "だから、それなりの額の金を持っている" },
    { "t": [25.8,  26.9], "ja": "しゃべりすぎた" },
    { "t": [28.2,  30.6], "ja": "明日を楽しみにしてます" },
    { "t": [30.6,  32.4], "ja": "ええ、そのことで、考えてたんですけど" },
    { "t": [32.4,  35], "ja": "日程を変更してもらうことってできますか？" },
    { "t": [35,  36.5], "ja": "すべてが、僕の世界レベルの基準に" },
    { "t": [36.5,  38.3], "ja": "達しているか確かめたくて" },
    { "t": [38.3,  40.6], "ja": "私は約束は守る主義だ、坊主" },
    { "t": [40.6,  42.4], "ja": "他の人にも守ってほしい" },
    { "t": [42.4,  45.3], "ja": "もちろん、はい、問題ありません、明日の朝8時ですね" },
    { "t": [45.3,  47.7], "ja": "きっと、すごく感心してもらえると思います" },
    { "t": [47.7,  49.3], "ja": "僕たちのプレゼンに" },
    { "t": [49.3,  52.4], "ja": "僕たち？ 他に誰が一緒なんだ？" },
    { "t": [52.4,  56.9], "ja": "リッカ、リッカ、リッカ、リッカ、はっはっはっはっは" },
    { "t": [56.9,  58], "ja": "スワンソン" },
    { "t": [58,  58.8], "ja": "ジャン・ラルフィオ" },
    { "t": [58.8,  59.7], "ja": "俺だよ" },
    { "t": [59.7,  61.6], "ja": "君も関わっているとは知らなかった" },
    { "t": [61.6,  63.3], "ja": "もちろんですよ、彼は僕のビジネスパートナーです" },
    { "t": [63.3,  66.5], "ja": "しーっ、すっきり" },
    { "t": [66.5,  69.1], "ja": "ビジネスパートナー、今もこれからも永遠に" },
    { "t": [69.1,  72.7], "ja": "待って、フォーエバー21、21発の礼砲" },
    { "t": [72.7,  74.6], "ja": "サルート・ユア・ショーツ、カブーシュ" },
    { "t": [74.6,  77], "ja": "口ひげの前で、連想ゲームを炸裂させちゃった" },
    { "t": [77,  78.4], "ja": "それも彼がこのビジネスに持ち込む" },
    { "t": [78.4,  79.9], "ja": "たくさんの才能の一つなんです" },
    { "t": [79.9,  81], "ja": "エビちゃん？" },
    { "t": [81,  83], "ja": "ああ、そうか" },
    { "t": [83,  84.3], "ja": "その動きは考え直せ、坊主" },
    { "t": [88,  104.3], "ja": "また次回" }
  ]
}
