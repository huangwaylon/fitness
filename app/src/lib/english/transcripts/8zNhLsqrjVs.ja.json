{
  "video": "8zNhLsqrjVs",
  "lines": [
    { "t": [0, 1], "ja": "大丈夫？" },
    { "t": [1, 2.5], "ja": "午後からずっと様子がおかしいよ" },
    { "t": [2.5, 3.8], "ja": "うん、大丈夫、大丈夫" },
    { "t": [3.8, 6.3], "ja": "完璧じゃないけど、まあまあね" },
    { "t": [7.8, 9.6], "ja": "もう、どうしたの？" },
    { "t": [9.6, 12.2], "ja": "ごめん、今「チーズ」って言った？" },
    { "t": [14.1, 15.9], "ja": "わかった、どうしたの？" },
    { "t": [15.9, 18.5], "ja": "フィービーが、君とドンはソウルメイトだって言うんだ" },
    { "t": [18.5, 19.8], "ja": "僕はそういうのを信じてない" },
    { "t": [19.8, 21.4], "ja": "でも、君たち二人はすごく気が合うし" },
    { "t": [21.4, 23], "ja": "だからさ、邪魔はしないよ" },
    { "t": [23, 24.4], "ja": "君がドンと駆け落ちして" },
    { "t": [24.4, 25.8], "ja": "チーズの家で暮らしたいならね" },
    { "t": [27.5, 29.4], "ja": "待って、ソウルメイトを信じてないの？" },
    { "t": [29.4, 31.2], "ja": "うん。でも、ドンは信じてるだろうね" },
    { "t": [34.2, 36.3], "ja": "私もソウルメイトなんて信じてない" },
    { "t": [37.4, 38.3], "ja": "そうなの？" },
    { "t": [38.3, 39.6], "ja": "うん。あなたと私が" },
    { "t": [39.6, 41.8], "ja": "最初から結ばれる運命だったとは思わない" },
    { "t": [41.8, 43], "ja": "私たちは恋に落ちて" },
    { "t": [43, 45.6], "ja": "二人の関係のために努力してるんだと思う" },
    { "t": [45.6, 47.4], "ja": "すごく努力しなきゃいけない日もあるけどね" },
    { "t": [48.9, 51.2], "ja": "じゃあ、ドンと一緒に" },
    { "t": [51.2, 52.3], "ja": "チーズの家で暮らしたくないの？" },
    { "t": [53.5, 55.9], "ja": "うん、それは考え直したの" },
    { "t": [55.9, 57.7], "ja": "そんな家、掃除するのがどれだけ大変かわかる？" },
    { "t": [57.7, 60.5], "ja": "愛してる" },
    { "t": [60.5, 61.7], "ja": "知ってる" },
    { "t": [61.7, 62.6], "ja": "そうだ" },
    { "t": [62.6, 64.6], "ja": "今夜、夕食に連れていってあげる" },
    { "t": [64.6, 66.5], "ja": "最高のお店を見つけたんだ" },
    { "t": [66.5, 68.5], "ja": "モッツァレラスティックとハラペーニョポッパーがあるんだよ" },
    { "t": [71.1, 72.6], "ja": "だめ？本当に？すごくおいしいのに" }
  ]
}
