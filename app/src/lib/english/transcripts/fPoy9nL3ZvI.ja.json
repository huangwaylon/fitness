{
  "video": "fPoy9nL3ZvI",
  "lines": [
    { "t": [0,1.2], "ja": "やあ" },
    { "t": [1.2,3], "ja": "何か作業してるの？" },
    { "t": [3,4.8], "ja": "私のほうが君より詳しい" },
    { "t": [4.8,6.7], "ja": "分かった" },
    { "t": [6.7,8.5], "ja": "エイプリルとアンディが結婚したとき" },
    { "t": [8.5,10.4], "ja": "私は結婚祝いを贈らなかった" },
    { "t": [10.4,12], "ja": "私の経験では、結婚祝いなんてものは" },
    { "t": [12,15.5], "ja": "離婚のたき火にくべる、たきつけにすぎない" },
    { "t": [15.5,19], "ja": "だが、二人が家庭を作るのを本当に手伝える方法を見つけたと思う" },
    { "t": [21.5,24], "ja": "そこの豆袋。ついて来い" },
    { "t": [24,25.3], "ja": "私はナスよ" },
    { "t": [25.3,26.9], "ja": "どうでもいい。ついて来い" },
    { "t": [26.9,28.9], "ja": "なんで？　－小さい手が要るんだ" },
    { "t": [30,33.3], "ja": "私…怖い" },
    { "t": [33.3,35], "ja": "ほら。できたと思う" },
    { "t": [35,36.4], "ja": "ああ。できたな" },
    { "t": [36.4,38.3], "ja": "うえっ" },
    { "t": [38.3,40.5], "ja": "せめて何をしてるのか教えてくれない？" },
    { "t": [40.5,41.7], "ja": "私も家を持ってるの" },
    { "t": [41.7,44], "ja": "ちゃんと何か覚えたいのよ" },
    { "t": [44,46.3], "ja": "ああ" },
    { "t": [46.3,49.8], "ja": "バルブの軸を、バルブの胴に締め込んでいるんだ" },
    { "t": [49.8,51.5], "ja": "ハンドルを付け替えて" },
    { "t": [51.5,53.4], "ja": "それから止めねじを締める" },
    { "t": [53.4,55.8], "ja": "これで固定されるんだ" },
    { "t": [55.8,58.7], "ja": "すごい！　直った！" },
    { "t": [58.7,60.5], "ja": "いい気分だろう" },
    { "t": [60.5,63.2], "ja": "達成感と誇りだ" },
    { "t": [63.2,66.1], "ja": "くそっ。本当にたまらないな" },
    { "t": [68.1,69.6], "ja": "大丈夫？" },
    { "t": [69.6,70.7], "ja": "最高だ" },
    { "t": [70.7,72.1], "ja": "この家を回って" },
    { "t": [72.1,74.7], "ja": "直すべきところを見つけて、全部直していく" },
    { "t": [74.7,75.9], "ja": "手伝いたいか？" },
    { "t": [75.9,77.5], "ja": "すごく手伝いたい" },
    { "t": [77.5,78.7], "ja": "よし" },
    { "t": [78.7,80.7], "ja": "次はあれだ" },
    { "t": [80.7,83.1], "ja": "ちょっと失礼！" },
    { "t": [83.1,85.1], "ja": "ああ。いい姿勢だな" },
    { "t": [85.1,86.8], "ja": "頭をしっかり押さえておけよ" },
    { "t": [86.8,89], "ja": "頭をね　－聞いてくれ！" },
    { "t": [89,91.1], "ja": "1分だけ電気を止めなければならない" },
    { "t": [91.1,92.8], "ja": "みんな、真っ暗になるわよ" },
    { "t": [92.8,94.2], "ja": "少し我慢してね、いい？" },
    { "t": [94.2,96.3], "ja": "メインのヒューズを切らなきゃいけないの" },
    { "t": [96.3,97.2], "ja": "ただのヒューズだ" },
    { "t": [97.2,99.5], "ja": "ただのヒューズよ、みんな" },
    { "t": [99.5,100.7], "ja": "ただのヒューズ" },
    { "t": [100.7,104.2], "ja": "そのトルクレンチ、使いこなしてるじゃないか" },
    { "t": [104.2,106.2], "ja": "ええ、まあ、フランジが少し曲がってたから" },
    { "t": [106.2,109.1], "ja": "トリプルスリーのボルトで、ぐっと押し込んだのよ、親方" },
    { "t": [109.1,111], "ja": "今のはでたらめだな" },
    { "t": [111,113.3], "ja": "分かってる。でも、こういう話し方ってすごく楽しいの" },
    { "t": [113.3,115.5], "ja": "なあ" },
    { "t": [115.5,118.3], "ja": "これをやろう" },
    { "t": [118.3,119.8], "ja": "君はそれにふさわしい" },
    { "t": [119.8,121.8], "ja": "ありがとう、ロン" },
    { "t": [121.8,132.6], "ja": "…" }
  ]
}
