    { "t": [0,  3.8], "ja": "僕を見て！" },
    { "t": [3.8,  6], "ja": "よし、こういうことだ" },
    { "t": [6,  8.5], "ja": "明日、ジョニー・カラテのオリジナル曲をオークションに出したいんだ" },
    { "t": [8.5,  10], "ja": "だから、オークションに来てほしい" },
    { "t": [10,  13], "ja": "オークション？ よし、分かった、メモしておくよ" },
