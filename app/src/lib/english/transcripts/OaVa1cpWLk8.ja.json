    { "t": [16,  18], "ja": "いや、僕のファイルにはそう書いてない" },
    { "t": [18,  20], "ja": "あ、忘れてた。反対の手だった" },
    { "t": [20,  22], "ja": "よし、もっといいやり方が必要ね" },
