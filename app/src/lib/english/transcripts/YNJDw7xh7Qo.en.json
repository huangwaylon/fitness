{"video":"YNJDw7xh7Qo","lines":[{"t":[0,4.1],"en":"Oh, my God."},{"t":[4.5,5.7],"en":"What does that thing do?"},{"t":[6.1,6.3],"en":"Hmm."},{"t":[7.8,9.3],"en":"Uh, that's an eye removal machine."},{"t":[9.4,10.2],"en":"All right, I'm out of here."},{"t":[10.2,10.9],"en":"I'm kidding, I'm kidding."},{"t":[11.6,12.1],"en":"Uh-oh."},{"t":[12.3,12.7],"en":"Hi, Rachel."},{"t":[12.8,12.9],"en":"Hey."},{"t":[13.1,13.9],"en":"I'm Dr. Miller."},{"t":[14.1,17.4],"en":"Monica told me you were a little nervous, but don't worry, everything's gonna be just fine."},{"t":[17.5,18.2],"en":"So we're done then."},{"t":[18.7,20.3],"en":"Almost, but first we gotta start."},{"t":[20.5,20.8],"en":"Okay."},{"t":[21.1,22.3],"en":"This is the glaucoma test."},{"t":[22.5,22.8],"en":"Uh-huh."},{"t":[22.9,23.2],"en":"Sit down."},{"t":[24.6,25],"en":"Okay."},{"t":[25.6,26.4],"en":"Put your chin here."},{"t":[26.5,26.9],"en":"Mm-hmm."},{"t":[28.2,31.2],"en":"Now, you're gonna feel a small puff of air in each eye."},{"t":[31.3,31.7],"en":"Uh, what?"},{"t":[33.3,34.7],"en":"A small puff of air."},{"t":[34.9,35.7],"en":"Now, come on!"},{"t":[38.1,38.8],"en":"Here we go."},{"t":[38.9,39.2],"en":"All right."},{"t":[40.5,42.8],"en":"One, two, three."},{"t":[43.2,43.5],"en":"Okay."},{"t":[45,45.6],"en":"I'm sorry."},{"t":[46.1,46.4],"en":"All right."},{"t":[46.8,48.3],"en":"I'm gonna stay in here this time."},{"t":[49,49.2],"en":"Okay."},{"t":[49.8,50.1],"en":"Ready?"},{"t":[50.4,50.6],"en":"Uh-huh."},{"t":[51.3,53],"en":"One, two, three."},{"t":[53.1,53.6],"en":"I'm sorry."},{"t":[54.3,54.6],"en":"You know what?"},{"t":[54.6,55.4],"en":"I'm gonna hold her head."},{"t":[55.7,55.8],"en":"Okay."},{"t":[56.9,57.5],"en":"That's okay."},{"t":[60.8,61.3],"en":"One."},{"t":[61.4,61.7],"en":"Uh-huh."},{"t":[62.1,62.4],"en":"Two."},{"t":[62.4,63.8],"en":"Oh, I'm sorry."},{"t":[64.5,65.2],"en":"You know what?"},{"t":[65.3,65.7],"en":"You're young."},{"t":[65.9,67],"en":"You probably don't have glaucoma."},{"t":[67.3,67.4],"en":"Oh."},{"t":[68.7,69.9],"en":"Oh, okay."},{"t":[70.7,73.5],"en":"Okay, so it was very, very nice to meet you, sir."},{"t":[73.8,74.1],"en":"And I'm..."},{"t":[74.1,74.5],"en":"Oh, hey!"},{"t":[74.5,75.6],"en":"What are you..."},{"t":[75.6,76.4],"en":"Are you crazy?"},{"t":[76.6,76.7],"en":"Okay."},{"t":[77.2,80.6],"en":"You got a small, minor infection in that left eye."},{"t":[81,84.4],"en":"I want you to take these drops three times a day for a week, and you'll be as good as new."},{"t":[84.6,85.4],"en":"Yeah, no, I don't."},{"t":[85.4,87],"en":"I don't put things in my eye."},{"t":[87.6,88.3],"en":"Okay, then."},{"t":[88.6,90.4],"en":"I guess we'll see you back here in three months."},{"t":[90.5,90.8],"en":"Great."},{"t":[91,92.1],"en":"And I'll fit you for a glass eye."},{"t":[92.2,93.4],"en":"Okay, just give me the damn drops."},{"t":[95.7,96.3],"en":"Dr. Miller?"},{"t":[98.5,100],"en":"P-E-C-F-D."},{"t":[101.7,103],"en":"Very good, Monica."},{"t":[105.6,106.6],"en":"You know where they are."},{"t":[106.7,107.4],"en":"I sure do."},{"t":[112,113.2],"en":"And you don't get one."}]}
