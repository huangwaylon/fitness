{
  "video": "aF2tasp8Zqc",
  "lines": [
    { "t": [0, 5.5], "ja": "今日のプレゼン、本当によかったよ" },
    { "t": [5.5, 6.5], "ja": "あ、ありがとう" },
    { "t": [6.5, 8], "ja": "ポーニーについて話してたこと、よかった" },
    { "t": [8, 9.5], "ja": "聞いていて本当にうれしかったよ" },
    { "t": [9.5, 11.5], "ja": "ポーニーは本当に特別な町なの" },
    { "t": [11.5, 13.5], "ja": "あそこに住むのが大好き" },
    { "t": [13.5, 19.5], "ja": "それに、えっと、毎日楽しみにしてる時間があって" },
    { "t": [19.5, 22.5], "ja": "町と一緒に過ごして" },
    { "t": [22.5, 26.5], "ja": "町といろんな話をする時間なの" },
    { "t": [26.5, 29.5], "ja": "それに町は、とても素敵な金髪をしてるし" },
    { "t": [29.5, 32.5], "ja": "政治家の伝記を驚くほどたくさん読んでるの" },
    { "t": [32.5, 35], "ja": "町にしてはね。そこが好き" },
    { "t": [35, 36], "ja": "ああ、もう" },
    { "t": [36, 38], "ja": "ごめん。まずいことになるかもしれないのはわかってるけど" },
    { "t": [38, 40.5], "ja": "もう我慢できない" },
    { "t": [40.5, 43], "ja": "せめて話し合わなきゃいけないと思うんだ" },
    { "t": [43, 47], "ja": "だって、僕だけじゃないよね？" },
    { "t": [47, 49], "ja": "ええ、あなただけじゃない" },
    { "t": [53, 55], "ja": "ああ、もう" },
    { "t": [55, 57], "ja": "何？大丈夫？" },
    { "t": [57, 58], "ja": "完璧よ" },
    { "t": [58, 59.5], "ja": "ちょっと便器さんにご用があるの" },
    { "t": [59.5, 60.5], "ja": "わかるでしょ？" },
    { "t": [60.5, 61.5], "ja": "コカインを買いに行くんじゃないわよ" },
    { "t": [61.5, 62.5], "ja": "トイレに行くの" },
    { "t": [62.5, 63.5], "ja": "私の呼び方では「おしっこ宮殿」" },
    { "t": [63.5, 64.5], "ja": "それにアンに電話するわけでもないから" },
    { "t": [64.5, 67.5], "ja": "ねえ、アン、緊急事態よ、暗号名ベン" },
    { "t": [67.5, 69.5], "ja": "名前を言ったら暗号にならないわよ" },
    { "t": [69.5, 71.5], "ja": "彼が私のことを好きだって言ったの" },
    { "t": [71.5, 73.5], "ja": "今から彼とキスしまくってくる" },
    { "t": [73.5, 74.5], "ja": "顔中にね" },
    { "t": [74.5, 75.5], "ja": "最高じゃない！" },
    { "t": [75.5, 76], "ja": "だめ、だめ" },
    { "t": [76, 77], "ja": "例の原稿を読んで" },
    { "t": [77, 78], "ja": "本気？" },
    { "t": [78, 79], "ja": "そう！" },
    { "t": [79, 81], "ja": "わかったわ" },
    { "t": [81, 83], "ja": "レスリー、公園課のレスリー・ノープです" },
    { "t": [83, 85], "ja": "アン・パーキンスを通して話しています" },
    { "t": [85, 86], "ja": "友人で美人の看護師です" },
    { "t": [86, 87], "ja": "ありがとう" },
    { "t": [87, 89], "ja": "ベンとは何もしないこと" },
    { "t": [89, 91], "ja": "責任をもちなさい。彼の口がどんなにかわいくても" },
    { "t": [91, 93], "ja": "あなたの仕事がかかってるのよ！" },
    { "t": [93, 94], "ja": "黙って、アン！" },
    { "t": [94, 95], "ja": "あなたが書いたんでしょ！" },
    { "t": [95, 96], "ja": "違う！" },
    { "t": [96, 97], "ja": "あなた…じゃあ、レスリー、レスリー" },
    { "t": [97, 99], "ja": "自分が何を言ってるかわかってないわ" },
    { "t": [99, 101], "ja": "私は彼のことがすごく大事なの" },
    { "t": [101, 103], "ja": "それに赤ワインを2杯半飲んだの" },
    { "t": [103, 104.5], "ja": "つまり、今から彼とキスしまくってくるってこと" },
    { "t": [104.5, 106], "ja": "今すぐね。最高になるわ" },
    { "t": [106, 107.5], "ja": "やった！" },
    { "t": [107.5, 109], "ja": "違う、私を止めるのがあなたの役目でしょ" },
    { "t": [109, 111], "ja": "だめ、やめて" },
    { "t": [111, 113], "ja": "黙って、アン。どうせやるから" },
    { "t": [113, 114], "ja": "やった！" },
    { "t": [117, 119], "ja": "レスリー！" },
    { "t": [121, 123.5], "ja": "君が入札に勝ったとベンから聞いて" },
    { "t": [123.5, 125.5], "ja": "僕は大喜びしたんだ" },
    { "t": [125.5, 127.5], "ja": "だから、ここまで来て一緒にお祝いしなきゃと思って" },
    { "t": [127.5, 129], "ja": "この世に君にできないことなんて" },
    { "t": [129, 130.5], "ja": "文字どおり一つもないよ" },
    { "t": [130.5, 131.5], "ja": "で、これからどうする？" },
    { "t": [131.5, 133.5], "ja": "長い散歩でもする？" },
    { "t": [133.5, 135.5], "ja": "ミニゴルフとか" },
    { "t": [135.5, 138.5], "ja": "たぶん、もうポーニーに戻るよ" },
    { "t": [138.5, 139.5], "ja": "そうね" },
    { "t": [139.5, 140.5], "ja": "とんでもない" },
    { "t": [140.5, 142.5], "ja": "わざわざ家まで運転して帰る必要なんてないよ" },
    { "t": [142.5, 144.5], "ja": "この街にちゃんとしたマンションがあるんだから" },
    { "t": [144.5, 145.5], "ja": "いえ、そんなご迷惑はかけられないわ" },
    { "t": [145.5, 146.5], "ja": "とんでもない、とんでもない" },
    { "t": [146.5, 148.5], "ja": "ぜひうちに泊まってほしいんだ" },
    { "t": [148.5, 149.5], "ja": "レスリー、君は客間を使って" },
    { "t": [149.5, 152.5], "ja": "ベン、君は僕のソファで寝てもらうよ" },
    { "t": [152.5, 156.5], "ja": "文字どおり、今までで一番快適なソファだから" },
    { "t": [156.5, 157.5], "ja": "私たち、クリスのソファにいる" },
    { "t": [157.5, 158.5], "ja": "うん" },
    { "t": [158.5, 159.5], "ja": "そうだね" },
    { "t": [159.5, 160.5], "ja": "しかも私、彼の服を着てる" },
    { "t": [160.5, 161.5], "ja": "あー" },
