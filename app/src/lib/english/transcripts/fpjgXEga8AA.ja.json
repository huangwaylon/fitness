{
  "video": "fpjgXEga8AA",
  "lines": [
    { "t": [0,1.8], "ja": "よし" },
    { "t": [1.8,3.3], "ja": "あ、誰かいる" },
    { "t": [3.3,5], "ja": "楽しくなるよ　わくわくしてる？" },
    { "t": [5,6.2], "ja": "わくわくしてる、うん　準備はいい？" },
    { "t": [6.2,7.3], "ja": "ええ、もちろん　気合い入ってる？" },
    { "t": [7.3,8.7], "ja": "うん　ひかえめに見せて" },
    { "t": [8.7,11.8], "ja": "でも自信を持ってね" },
    { "t": [11.8,13.2], "ja": "こんにちは" },
    { "t": [13.2,15.3], "ja": "私たちは地元の役所の者です" },
    { "t": [15.3,16.5], "ja": "少しお話しさせていただけますか" },
    { "t": [16.5,18], "ja": "サリバン通りの穴についてなんですが" },
    { "t": [18,19.2], "ja": "いいですよ" },
    { "t": [19.2,22.9], "ja": "すばらしい　前向きな反応ね" },
    { "t": [22.9,25], "ja": "あの穴を、すてきな地域の公園に変えたら" },
    { "t": [25,26.7], "ja": "どう思われますか？" },
    { "t": [26.7,28.6], "ja": "ああ、いいですね　それはすごくいい考えです" },
    { "t": [28.6,30.6], "ja": "よかった　実は私もこの近所に住んでるので" },
    { "t": [30.6,33.1], "ja": "そのことなら少しお話しできるかと" },
    { "t": [33.1,34.6], "ja": "第3区画ね　はい" },
    { "t": [34.6,39], "ja": "えっと、明日の夜に公開の話し合いがあるので" },
    { "t": [39,41.6], "ja": "もし来ていただけたら、すごくうれしいです" },
    { "t": [41.6,43.2], "ja": "強く賛成だって声を上げてほしいんです" },
    { "t": [43.2,46.1], "ja": "明日？　無理です　忙しいので　すみません" },
    { "t": [46.1,47.5], "ja": "ええ、みなさんお忙しいのは分かっています" },
    { "t": [47.5,48.9], "ja": "でも、ぜひ集まりに来ていただきたいんです" },
    { "t": [48.9,50.5], "ja": "すみません　でも、頑張ってね" },
    { "t": [50.5,51.5], "ja": "公園には大賛成なんだけど" },
    { "t": [51.5,53.2], "ja": "もし私たちがこう言ったら、気持ちは変わりますか…" },
    { "t": [53.2,54.2], "ja": "もういないよ" },
    { "t": [54.2,55.2], "ja": "へえ、公園か" },
    { "t": [55.2,56.7], "ja": "すごくいい考えだね" },
    { "t": [56.7,57.2], "ja": "よかった" },
    { "t": [57.2,58.9], "ja": "町の集まりに来て" },
    { "t": [58.9,60], "ja": "賛成の気持ちを伝えてもらえますか？" },
    { "t": [60,61], "ja": "もちろん" },
    { "t": [61,62.9], "ja": "で、その公園には遊び場とか" },
    { "t": [62.9,65], "ja": "子ども用のプールとかできるのかな？" },
    { "t": [65,67.8], "ja": "あ、えっと、お子さんはおいくつですか？" },
    { "t": [67.8,68.8], "ja": "子どもはいない" },
    { "t": [68.8,69.9], "ja": "あらら" },
    { "t": [69.9,71.1], "ja": "賛成って書いておくね" },
    { "t": [71.1,72], "ja": "やめて" },
    { "t": [72,74.1], "ja": "それと、その公園はうちから少なくとも1000フィートは離れてるよね" },
    { "t": [74.1,75.6], "ja": "だって、ほら" },
    { "t": [75.6,77], "ja": "もう引っ越しはできないからさ" },
    { "t": [77,79.1], "ja": "エイプリル、私の後ろに立って" },
    { "t": [79.1,80.9], "ja": "以上です　これで全部です　これで終わりです" },
    { "t": [80.9,83], "ja": "チラシは？　ありません" },
    { "t": [83,84.8], "ja": "分かった　ありがとう" },
    { "t": [89,90.1], "ja": "もう" },
    { "t": [90.1,91.3], "ja": "最高　本当に最高" },
    { "t": [91.3,92.7], "ja": "戸別訪問って大好き" },
    { "t": [92.7,94.4], "ja": "なんてすてきな時間の使い方なの" },
    { "t": [94.4,95.8], "ja": "よし、チーム・ハヴァーフォード" },
    { "t": [95.8,98.1], "ja": "君たちは最高だけど…" },
    { "t": [98.1,100.4], "ja": "僕はソロでやったほうがうまくいく気がするんだ" },
    { "t": [100.4,101.8], "ja": "だから、もう行くよ" },
    { "t": [101.8,103.1], "ja": "じゃあね" },
    { "t": [108.5,109.4], "ja": "走り方が変" },
    { "t": [109.4,110.9], "ja": "本当に変ね" },
    { "t": [110.9,114.7], "ja": "いい考えだけど、ちょっとよく分からなくて" },
    { "t": [114.7,117.4], "ja": "そうですか　どの部分がよく分からないんですか？" },
    { "t": [117.4,119.4], "ja": "あの穴を公園にすることかな" },
    { "t": [119.4,122.9], "ja": "それって、ほぼ全部じゃない" }
  ]
}
