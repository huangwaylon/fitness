    { "t": [0, 8], "ja": "（無音）" },
    { "t": [8, 9], "ja": "ロン！" },
    { "t": [9, 11], "ja": "やあ、アンディ" },
    { "t": [11, 13], "ja": "ここ静かだね。みんなはどこ？" },
    { "t": [13, 16], "ja": "役所が閉鎖されたんだ。どの新聞にも載っている" },
    { "t": [16, 17], "ja": "いつまで続くの？" },
    { "t": [17, 20], "ja": "運がよければ、この建物は何か月も空っぽのままだ" },
    { "t": [20, 21], "ja": "わあ" },
    { "t": [21, 24], "ja": "私に言えるのは、すべての公園が" },
    { "t": [24, 26], "ja": "追って知らせがあるまで閉鎖されるということです" },
    { "t": [26, 30], "ja": "いいですか、このことで私以上に心を痛めている人はいません" },
    { "t": [30, 32], "ja": "別に競争じゃないですけど" },
    { "t": [32, 33], "ja": "もし競争なら、私が勝ちます" },
    { "t": [33, 34], "ja": "でも、それは今は関係ありません" },
    { "t": [34, 35], "ja": "大事なのは、私が勝つってことです" },
    { "t": [35, 37], "ja": "いつまで閉鎖されるんですか？" },
    { "t": [37, 38], "ja": "ずっとかもしれない" },
    { "t": [38, 39], "ja": "役所が閉鎖されたら" },
    { "t": [39, 41], "ja": "誰がアルカイダを止めるんだ？" },
    { "t": [41, 42], "ja": "一つずつ片付けましょう" },
    { "t": [42, 45], "ja": "あと2週間で学校が休みになるのよ" },
    { "t": [45, 47], "ja": "一日中、子どもたちをどうすればいいの？" },
    { "t": [47, 49], "ja": "家に置いておけって言うの？私が住んでる家に？" },
    { "t": [49, 51], "ja": "何と言えばいいか分かりません" },
    { "t": [51, 54], "ja": "明日のラムセット公園での子どもコンサートはどうなるの？" },
    { "t": [54, 56], "ja": "フレディ・スパゲッティのコンサートよ" },
    { "t": [56, 58], "ja": "フレディ・スパゲッティは中止になりました" },
    { "t": [58, 61], "ja": "ああ！" },
    { "t": [61, 64], "ja": "今の赤字と今後の赤字の見通しを考えると" },
    { "t": [64, 67], "ja": "支出を32％減らす必要があります" },
    { "t": [67, 69], "ja": "きりよく40にしよう" },
    { "t": [69, 70], "ja": "いや、それは必要ないです" },
    { "t": [70, 72], "ja": "削れ。削れ" },
    { "t": [72, 75], "ja": "私は市の予算を削るための" },
    { "t": [75, 78], "ja": "特別委員会の正式なメンバーだ" },
    { "t": [78, 81], "ja": "そう言っただけで、ちょっと興奮した" },
    { "t": [81, 84], "ja": "まず手始めに、市役所を売ろう" },
    { "t": [84, 86], "ja": "誰かに大きなガソリンスタンドか" },
    { "t": [86, 87], "ja": "ティージェイ・マックスにでもしてもらえばいい" },
    { "t": [87, 89], "ja": "ロン、それはとても独創的なアイデアです" },
    { "t": [89, 90], "ja": "でも、主な財産は" },
    { "t": [90, 91], "ja": "どれも売りたくないんです" },
    { "t": [91, 92], "ja": "将来の収入源を" },
    { "t": [92, 94], "ja": "失いたくないので" },
    { "t": [94, 95], "ja": "なるほど" },
    { "t": [95, 97], "ja": "心配するな。アイデアはまだ山ほどある" },
    { "t": [97, 99], "ja": "よし、えっと…" },
    { "t": [99, 102], "ja": "本当にごめん" },
    { "t": [102, 103], "ja": "着信音を新しくしたんだ" },
    { "t": [103, 105], "ja": "僕がいない間に何も削らないでね" },
    { "t": [105, 106], "ja": "レスリー？" },
    { "t": [106, 109], "ja": "あなたが私たちのやることを嫌いでも構わない" },
    { "t": [109, 111], "ja": "私は二人分くらい大好きだから" },
    { "t": [111, 112], "ja": "私たちは、今日" },
    { "t": [112, 113], "ja": "フレディ・スパゲッティのコンサートを開くの" },
    { "t": [113, 115], "ja": "5時に48番の区画でね" },
    { "t": [115, 116], "ja": "そんなことはできない" },
    { "t": [116, 117], "ja": "見てなさい" },
    { "t": [117, 118], "ja": "やってみせるわ、ロン" },
    { "t": [118, 119], "ja": "あなたなしでね" },
    { "t": [119, 121], "ja": "ガンガンやるぞ！" },
