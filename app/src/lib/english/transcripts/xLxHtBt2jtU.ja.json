{
  "video": "xLxHtBt2jtU",
  "lines": [
    { "t": [0,6.7], "ja": "おはよう、ドワイト" },
    { "t": [9.9,10.8], "ja": "お前は誰だ？" },
    { "t": [12,12.9], "ja": "誰かって？" },
    { "t": [13.7,14.7], "ja": "ジムだよ" },
    { "t": [14.9,16.6], "ja": "12年も一緒に働いてるじゃないか" },
    { "t": [17.5,18.3], "ja": "変な冗談だな、ドワイト" },
    { "t": [19.2,19.9], "ja": "お前はジムじゃない" },
    { "t": [20.1,20.9], "ja": "ジムはアジア人じゃない" },
    { "t": [21.6,22.6], "ja": "本気で一度も気づかなかったの？" },
    { "t": [23.2,25.3], "ja": "へえ、人種で人を見ないなんて、すばらしいね" },
    { "t": [28.2,29.3], "ja": "いいだろう、ジム" },
    { "t": [29.3,33.1], "ja": "じゃあ、昨日お前が取った契約の話をしてもらおうか" },
    { "t": [34.3,38.4], "ja": "ああ、ウェリントン・システムズに、24ポンドのレター用紙を10箱売ったよ" },
    { "t": [38.6,40.4], "ja": "それとも、クリーガー・マーフィーのこと？" },
    { "t": [40.5,41.7], "ja": "あっちはまだ契約がまとまってないんだ" },
    { "t": [41.8,45], "ja": "でも、ポール・クリーガーから留守電が入ってるといいな" },
    { "t": [46.9,48.4], "ja": "パスワードを入力してください" },
    { "t": [54,55.9], "ja": "新しいメッセージが1件あります" },
    { "t": [55.9,56.8], "ja": "なんで分かったんだ？" },
    { "t": [57,58.3], "ja": "だめ、だめ、だめ、だめ" },
    { "t": [58.3,62], "ja": "それは社員だけの機密情報だ。部外者は見られない" },
    { "t": [62.2,62.8], "ja": "ドワイト、やめてくれ" },
    { "t": [62.9,63.6], "ja": "仕事してるんだから" },
    { "t": [63.7,64.7], "ja": "お前はここの社員じゃないだろ" },
    { "t": [64.7,65.5], "ja": "お前はジムじゃない" },
    { "t": [65.7,67.7], "ja": "ジム、夕食の予約取れたよ" },
    { "t": [67.9, 68.6], "ja": "お店、7時半からね" },
    { "t": [68.7,69.2], "ja": "ああ、いいね" },
    { "t": [69.2,69.6], "ja": "楽しみだ" },
    { "t": [73.6,77.3], "ja": "ジムは今朝は歯医者で、スティーブは私たちの友達の俳優なの" },
    { "t": [77.6,78.6], "ja": "お前が誰かは知らない" },
    { "t": [78.6,80.7], "ja": "お前が誰かは知らないが、ジムじゃない" },
    { "t": [81.6,82.9], "ja": "これがジムだ" },
    { "t": [87.7,88], "ja": "えっと" },
    { "t": [89.7,91], "ja": "あの、えっと、どうやって…" }
  ]
}
