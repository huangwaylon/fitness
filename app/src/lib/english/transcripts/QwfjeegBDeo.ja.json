{
  "video": "QwfjeegBDeo",
  "lines": [
    { "t": [0,  2.1], "ja": "マイケル・スコット、ありがとう" },
    { "t": [2.1,  4.1], "ja": "感謝してるよ、マイク" },
    { "t": [4.1,  5.7], "ja": "よし" },
    { "t": [5.7,  6.7], "ja": "どうも" },
    { "t": [6.7,  8.4], "ja": "まだ紹介されていませんでしたね" },
    { "t": [8.4,  10.7], "ja": "ドワイト・シュルート、地域部長補佐です" },
    { "t": [10.7,  13.7], "ja": "アンディ・バーナード、営業担当の地域ディレクターです" },
    { "t": [13.7,  15.1], "ja": "では、私の下につくわけですね？" },
    { "t": [15.1,  16.4], "ja": "とんでもない" },
    { "t": [16.4,  20.2], "ja": "私の肩書きには「部長」が入っていて、私はディレクターです" },
    { "t": [20.2,  23.2], "ja": "映画の撮影現場なら、一番上の肩書きですよ" },
    { "t": [23.2,  24.9], "ja": "映画のこと、何か知ってます？" },
    { "t": [24.9,  26.7], "ja": "映画のことなら何でも知っている" },
    { "t": [26.7,  29.9], "ja": "240本以上見たからな" },
    { "t": [29.9,  36.1], "ja": "それはおめでとう" },
    { "t": [36.1,  40], "ja": "さて、よくよく考えて、内省化をした結果" },
    { "t": [40,  44.5], "ja": "ジムを新しい右腕にすることにした" },
    { "t": [44.5,  48.3], "ja": "本人が望めばの話だけど、昇給はなしだ" },
    { "t": [48.3,  51], "ja": "いや、実はあるんだ" },
    { "t": [51,  53.5], "ja": "じゃあ、新しい三番手は誰に？" },
    { "t": [53.5,  55.4], "ja": "あー、それはまだ決めてない" },
    { "t": [55.4,  57.1], "ja": "マイケル、一言いいですか" },
    { "t": [57.1,  59.7], "ja": "今回の件を、すべて実に" },
    { "t": [59.7,  61.6], "ja": "見事な落ち着きでさばかれましたね" },
    { "t": [61.6,  62.6], "ja": "ありがとう、アンディ" },
    { "t": [62.6,  64], "ja": "とても優しいね" },
    { "t": [64,  66], "ja": "それに、あなたのリーダーシップのおかげで…" },
    { "t": [66,  67.9], "ja": "黙れ、黙れ" },
    { "t": [67.9,  69], "ja": "もう…" },
    { "t": [69,  72.9], "ja": "ごますりはやめろ" },
    { "t": [77,  79], "ja": "駐車場で、あんたのダサい車を見たよ" },
    { "t": [79,  80], "ja": "燃費はどれくらい？ 1ガロンで4マイルくらい？" },
    { "t": [80,  81.7], "ja": "いや、その倍だな" },
    { "t": [81.7,  84.1], "ja": "往年のトランザム、ビンテージのアメリカン・マッスルカーだ" },
    { "t": [84.1,  86.3], "ja": "へえ、僕のエクステラはかなりイケてるよ" },
    { "t": [86.3,  88.1], "ja": "豪華なのにタフ" },
    { "t": [88.1,  89.3], "ja": "さすが日本製だね" },
    { "t": [89.3,  91.3], "ja": "エクステラなんて、本当の言葉ですらない" },
    { "t": [91.3,  93.8], "ja": "実は、ある。ラテン語で「大地」って意味だ" },
    { "t": [93.8,  95.3], "ja": "へえ、じゃあ「元・大地」に乗ってるのか" },
    { "t": [95.3,  96.8], "ja": "ああ。なるほどね" },
    { "t": [96.8,  101.3], "ja": "「元・大地」より、往年のトランザムに乗るほうがいいね" },
    { "t": [101.3,  103.5], "ja": "ああ、そうだろうね" },
    { "t": [103.5,  106.7], "ja": "あ、そうそう、1985年から電話で、車を返してほしいってさ" },
    { "t": [106.7,  108.9], "ja": "へえ、1985年がタイムマシンを持ってるといいがな" },
    { "t": [108.9,  110.1], "ja": "俺のは87年型だから" },
    { "t": [110.1,  111.4], "ja": "おお、タイムマシンといえば" },
    { "t": [111.4,  112.9], "ja": "ちょうど未来から帰ってきたんだけど" },
    { "t": [112.9,  114.5], "ja": "あんたの葬式に行ったら、なんと" },
    { "t": [114.5,  115.9], "ja": "誰も来てなかったよ" },
    { "t": [115.9,  117.4], "ja": "葬式といえば" },
    { "t": [117.4,  120.5], "ja": "さっさと死んだらどうだ？" },
    { "t": [120.5,  124.8], "ja": "おお、実によくできた文だね" },
    { "t": [124.8,  126.8], "ja": "英語の教授になるべきだよ" },
    { "t": [126.8,  129.8], "ja": "コー・ノット大学のね" },
    { "t": [129.8,  131.2], "ja": "ばか" },
    { "t": [131.2,  133.8], "ja": "僕がばかなら、トランザムに乗ってるさ" },
    { "t": [133.8,  135.2], "ja": "もしあんたがトランザムに乗ってたら" },
    { "t": [135.2,  138.2], "ja": "世界一賢いばかだろうな" },
    { "t": [138.2,  142.1], "ja": "ばか！" },
    { "t": [142.1,  144.1], "ja": "お前こそばかだ！" },
    { "t": [144.1,  145.7], "ja": "いい言い返しだな！" },
    { "t": [145.7,  148.1], "ja": "言い返し方をからかってやったんだよ！" },
    { "t": [148.1,  150.8], "ja": "だからうまくいったんだ！" },
    { "t": [152.8,  154.8], "ja": "今の言い合いは、完全に僕の勝ちだ" },
    { "t": [154.8,  177.2], "ja": "…" }
  ]
}
