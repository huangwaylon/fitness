{
  "video": "sSqM7UMYCzE",
  "lines": [
    { "t": [0, 2], "ja": "何してるの？お礼のメッセージを送ってるの" },
    { "t": [2, 3.8], "ja": "いたずら動画を送ってくれた人にね" },
    { "t": [3.8, 5.8], "ja": "ああ、あの血だらけのピクルスの場面、最高だった" },
    { "t": [5.9, 8.6], "ja": "ええ、血が出るおやつはいつも笑えるわ" },
    { "t": [10.3, 12], "ja": "私が今までやった中で最高のいたずら、知りたい？" },
    { "t": [12.1, 14.4], "ja": "ああ、やめて" },
    { "t": [15.9, 19.5], "ja": "警官に、自分の足が切り落とされたと思いこませたの" },
    { "t": [21.2, 22.2], "ja": "うわ" },
    { "t": [22.9, 24], "ja": "すごく面白い" },
    { "t": [24.1, 26.3], "ja": "ねえ、君が今までやった中で一番面白いいたずらを聞きたいな" },
    { "t": [26.4, 29], "ja": "えっと、僕もすごいいたずらをしたことあるよ" },
    { "t": [29.1, 30.8], "ja": "たとえば、男子キャンプに行ってたとき" },
    { "t": [30.8, 33], "ja": "ある子の帽子にレーズンを詰めたんだ" },
    { "t": [33.7, 36.3], "ja": "言っとくけど、帽子にあれが入ってるとは思ってなかったはずだよ" },
    { "t": [38.3, 39.3], "ja": "あなたは？" },
    { "t": [41.1, 43.1], "ja": "私？今までで最高のいたずらは？" },
    { "t": [43.2, 45.1], "ja": "あ、えっと…" },
    { "t": [45.6, 46.8], "ja": "ノックノックジョークって数に入る？" },
    { "t": [47.2, 48.3], "ja": "ノックノックジョーク？" },
    { "t": [48.4, 49.9], "ja": "あんなのジョークにも入らないよ" },
    { "t": [51.5, 53.4], "ja": "じゃあ、一度もやったことないみたい" },
    { "t": [53.5, 54.4], "ja": "うそでしょ" },
    { "t": [54.5, 56.9], "ja": "人生で一度もいたずらしたことないの？" },
    { "t": [57, 58.2], "ja": "えっと…" },
    { "t": [58.2, 60.4], "ja": "「アイカーリー」でルーバートにやってることは？" },
    { "t": [60.7, 61.8], "ja": "あれはいたずらだよ" },
    { "t": [61.9, 63.3], "ja": "うん、考えてるのは私だけどね" },
    { "t": [63.4, 64.4], "ja": "数に入らない" },
    { "t": [65.1, 66.1], "ja": "じゃあ、ごめん" },
    { "t": [66.5, 68], "ja": "私、いたずらするタイプじゃないみたい" },
    { "t": [68.4, 69.4], "ja": "ちょっと、あんた" },
    { "t": [69.4, 71.5], "ja": "その年で一度もいたずらしたことないなんて、ありえないよ" },
    { "t": [72.2, 72.7], "ja": "まあ…" },
    { "t": [73.5, 74.9], "ja": "きっとそのうちやるわ" },
    { "t": [74.9, 75.1], "ja": "きっとそのうちやるわ" },
    { "t": [76.2, 76.9], "ja": "私が…" },
    { "t": [77.7, 78.3], "ja": "ほら…" },
    { "t": [79.2, 80.3], "ja": "ふさわしい人に出会ったらね" },
    { "t": [82.1, 83.2], "ja": "だめ、だめ、だめ、だめ、だめ" },
    { "t": [83.3, 84.5], "ja": "これはすぐにやらなきゃ" },
    { "t": [84.6, 85.5], "ja": "そんなことない" },
    { "t": [85.5, 86], "ja": "フレディ！" },
    { "t": [86.1, 87.2], "ja": "今回はサムに賛成だな" },
    { "t": [88.4, 89.2], "ja": "わかった" },
    { "t": [89.3, 90.7], "ja": "誰かにいたずらするわ" },
    { "t": [91.3, 92.8], "ja": "仲間からの圧力の勝ちね" },
    { "t": [94.1, 95.6], "ja": "カーリー？カーリー！" },
    { "t": [95.7, 96.5], "ja": "どこにいるの？" },
    { "t": [97, 98.7], "ja": "カーリー！カーリー！" },
    { "t": [99.2, 101], "ja": "ねえ、カーリーのメッセージを読んで" },
    { "t": [101.6, 103.8], "ja": "「ねえ、『アイカーリー』のすごいアイデアを思いついたの" },
    { "t": [103.9, 107], "ja": "放課後すぐ、サムと一緒にスタジオに来て」って書いてある" },
    { "t": [107.5, 108.1], "ja": "じゃあ、見回してよ" },
    { "t": [108.2, 108.8], "ja": "どこかに彼女いる？" },
    { "t": [108.9, 109.5], "ja": "待って" },
    { "t": [110.6, 111.7], "ja": "おっ、これ何？" },
    { "t": [114.6, 115.2], "ja": "読んで" },
    { "t": [117.1, 119.8], "ja": "「アイカーリーのみんなに、僕から甘いデザートを" },
    { "t": [119.8, 120.9], "ja": "ハグとくすぐりを込めて" },
    { "t": [121.3, 122], "ja": "ネビル」" },
    { "t": [123.3, 123.9], "ja": "ネビル？" },
    { "t": [124.2, 125.3], "ja": "どうやってここに持ちこんだの？" },
    { "t": [125.7, 127.2], "ja": "わからないけど、何も食べる気はないね" },
    { "t": [130.7, 131.9], "ja": "手を上げろ！" },
    { "t": [133.5, 134.4], "ja": "うわあ！" },
    { "t": [135, 136.2], "ja": "ひどかった！" },
    { "t": [136.5, 138], "ja": "面白くない！いや、違う" },
    { "t": [138.1, 139.7], "ja": "すごく面白かったわよ" },
    { "t": [141, 142.4], "ja": "いたずら成功！認めなさい！" },
    { "t": [142.4, 143.8], "ja": "見事にひっかけたわ！" },
    { "t": [145.5, 146.2], "ja": "やられたよ" },
    { "t": [147.1, 148], "ja": "よくやったね" },
    { "t": [148.3, 150.2], "ja": "ありがとう。でも、いたずらの王様の助けがなかったら" },
    { "t": [150.3, 151.5], "ja": "できなかったわ" },
    { "t": [151.6, 152.4], "ja": "ああ、その通り" },
    { "t": [152.8, 155.1], "ja": "いやあ、いたずらがこんなに楽しいって忘れてたよ" },
    { "t": [155.2, 156.5], "ja": "興奮を感じた？" },
    { "t": [156.6, 157.6], "ja": "ヒャッホー！" },
    { "t": [160.5, 161.7], "ja": "落ち着いて、カウボーイ" },
    { "t": [162.7, 164.9], "ja": "いたずらに夢中にならないでね。ならないよ" },
    { "t": [168.1, 169.1], "ja": "ならないって" },
    { "t": [172.4, 174.3], "ja": "ギプスはどれくらいつけなきゃいけないって医者は言ってた？" },
    { "t": [174.8, 175.9], "ja": "6週間" },
    { "t": [177.7, 180.1], "ja": "まあ、自業自得だよ。わけもなくあのパイプに飛び乗ったんだから" },
    { "t": [181.5, 183.6], "ja": "合図は「ギビー」って言ったじゃないか。だから「ギビー」って聞こえたんだ" },
    { "t": [183.7, 185.2], "ja": "そうだけど、合図は聞こえてなかっただろ。みんな、いい、わかった" },
    { "t": [185.3, 187.2], "ja": "合図はギビーだと聞いて、ギビーと聞こえて、合図はギビーだと聞いたんだ" },
    { "t": [187.3, 188.3], "ja": "そう、合図はギビーで、合図はギビーだと聞いて、ギビーだと聞いたんだ" },
    { "t": [188.4, 189.3], "ja": "誰かがギビーって言って、合図はギビーだと聞こえたんだ" },
    { "t": [189.4, 190.8], "ja": "みんな、彼を連れ戻して、もう放っておいてやろうよ" },
    { "t": [190.9, 191.6], "ja": "みんな！" },
    { "t": [191.7, 197.1], "ja": "みんな、スペンサーを何とかしてくれ。あいつはやりすぎだ" },
    { "t": [198.7, 199.8], "ja": "今度は何をしたの？" },
    { "t": [199.9, 202.2], "ja": "ヨーロッパの高級な顔のクリームをくれたんだ" },
    { "t": [202.6, 204.5], "ja": "顔がすべすべになるって書いてある" },
    { "t": [204.8, 205.5], "ja": "それで？" },
    { "t": [205.6, 207.2], "ja": "まあ、俺の顔はもうすべすべだからな" },
    { "t": [208.3, 209.9], "ja": "だから友だちのルーカスにあげたんだ" },
    { "t": [210.5, 212], "ja": "こいつの顔はかさかさしてるところがあるから" },
    { "t": [213.9, 214.6], "ja": "それで？" },
    { "t": [215.1, 216.3], "ja": "ケビン、電気を消せ！" },
    { "t": [221.7, 222.8], "ja": "うわあ" },
    { "t": [225, 225.9], "ja": "つけ直して" },
    { "t": [228.2, 230.2], "ja": "暗闇で光る顔のクリーム？" },
    { "t": [230.7, 232.7], "ja": "どんなひねくれた男がそれを面白いと思うんだ？" },
    { "t": [234.6, 235.5], "ja": "ごめんなさい" },
    { "t": [235.6, 236.7], "ja": "ルーカスに言ってくれ" },
    { "t": [237.1, 238.3], "ja": "これじゃあ映画も見に行けない" },
    { "t": [241.5, 243], "ja": "お前ら、スペンサーを何とかしたほうがいいぞ" },
    { "t": [247.6, 248.6], "ja": "どうする？" },
    { "t": [248.7, 251.5], "ja": "言ったでしょ、あんたたちがスペンサーにボウリングに行くって言って" },
    { "t": [251.6, 252.6], "ja": "私が後ろからこっそり近づいて…" },
    { "t": [252.7, 254], "ja": "ヌンチャクはしまって" },
    { "t": [256.7, 257.9], "ja": "全部私のせいよ" },
    { "t": [258.3, 258.9], "ja": "なんで君の？" },
    { "t": [259, 260.4], "ja": "お兄ちゃんは自分に問題があるってわかってた" },
    { "t": [260.5, 262.7], "ja": "手伝いたくなかったのに、私がまたいたずらの世界に引き戻して" },
    { "t": [262.8, 263.9], "ja": "今じゃやめられないの" },
    { "t": [264, 265.8], "ja": "ねえ、こういうのは前にも見たことがある" },
    { "t": [265.9, 267.9], "ja": "どん底に落ちるまでやめないだろうね" },
    { "t": [268.5, 269.7], "ja": "私はどん底に落ちたことがある" },
    { "t": [271.8, 274.2], "ja": "スペンサーは9年生のとき、もうどん底に落ちてるわ" },
    { "t": [274.3, 276.4], "ja": "子どもたちの目にガーリックパウダーを入れたやつ？" },
    { "t": [276.8, 277.5], "ja": "ああ、そうか" },
    { "t": [278.9, 280.6], "ja": "まあ、ヌンチャクのことも前向きに考えてくれれば" },
    { "t": [280.7, 281.3], "ja": "ちょっと！" },
    { "t": [281.4, 285], "ja": "サム、スペンサーにあのとき何が起きたか思い出させたらどう？" },
    { "t": [289.5, 290.4], "ja": "話が見えない" },
    { "t": [292.8, 294.4], "ja": "お兄ちゃんと同じ学校に通ってた子たちに電話できるわ" },
    { "t": [294.9, 295.9], "ja": "ガーリックパウダーの被害者たち？" },
    { "t": [296, 297.2], "ja": "うん、それでうちに呼ぶの" },
    { "t": [297.3, 299.2], "ja": "そうすれば、いたずらが人にどんな痛みを与えるか" },
    { "t": [299.3, 300.6], "ja": "思い出させられる" },
    { "t": [301.4, 303.2], "ja": "いいね。ママ、それ気に入った" },
    { "t": [303.3, 304.4], "ja": "助けて、助けて！" },
    { "t": [304.5, 305.2], "ja": "助けて、助けて！" },
    { "t": [305.3, 307.5], "ja": "助けて、助けて、助けて、助けて！" },
    { "t": [307.6, 308.7], "ja": "どうしたの？" },
    { "t": [308.8, 309.5], "ja": "逃げろ" },
    { "t": [316.4, 317.4], "ja": "何があったの？" },
    { "t": [317.5, 319.3], "ja": "昔の同級生にボコボコにされた" },
    { "t": [319.4, 320.4], "ja": "起こしてくれ！" },
    { "t": [320.5, 323], "ja": "でも、いたずらについてわかってもらうのを" },
    { "t": [323.1, 324.3], "ja": "手伝ってもらうだけのはずだったのに" },
    { "t": [324.4, 325.3], "ja": "よくわかった！" },
    { "t": [325.4, 326.2], "ja": "よくわかったよ！" }
  ]
