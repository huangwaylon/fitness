{
  "video": "wy0K449Zk0U",
  "lines": [
    { "t": [0,  2.5], "ja": "ねえ、アン、まだ看護師やってる？ それとも、クビになった？" },
    { "t": [2.5,  4], "ja": "医者全員と寝たから" },
    { "t": [4,  7], "ja": "言い直してみる？" },
    { "t": [7,  8.5], "ja": "ねえ、アン、まだ看護師やってる？" },
    { "t": [8.5,  10.5], "ja": "アンディの具合が悪いの" },
    { "t": [10.5,  11.5], "ja": "どうしたの、アンディ？" },
    { "t": [11.5,  14], "ja": "頭が痛くて、ものが二重に見えるんだ" },
    { "t": [14,  16.5], "ja": "それに、曲が頭から離れないし、歯も痛い" },
    { "t": [16.5,  18.5], "ja": "あと、お腹がすいてる" },
    { "t": [18.5,  20.5], "ja": "うん、そのうちのいくつかは症状だけど" },
    { "t": [20.5,  23], "ja": "いくつかは、ただ人間だからってだけね" },
    { "t": [23,  24.5], "ja": "頭を打った？" },
    { "t": [24.5,  26.5], "ja": "いや" },
    { "t": [26.5,  31.5], "ja": "あ、打った。厳密に言うと、頭のあたりを壁のあたりにぶつけた" },
    { "t": [31.5,  33.5], "ja": "そう、ゴールドディスクを飾ってたの" },
    { "t": [36.5,  38], "ja": "うわ、大丈夫？" },
    { "t": [38,  40], "ja": "うん、大丈夫" },
    { "t": [42,  44.5], "ja": "要するに、僕はゴールドディスクを持ってるってこと" },
    { "t": [44.5,  46], "ja": "まあ、切り傷とあざなら手当てできるけど" },
    { "t": [46,  48], "ja": "他のことは、ちゃんとしたお医者さんに診てもらわないと" },
    { "t": [48,  49.5], "ja": "ちょっと、お利口さん、そんなお金ないの" },
    { "t": [49.5,  51.5], "ja": "ねえ、お利口さん、あるよ" },
    { "t": [51.5,  53], "ja": "保険があるもん" },
    { "t": [53,  54.5], "ja": "二人とも、そんなにお利口じゃないでしょ" },
    { "t": [54.5,  59.5], "ja": "だって保険は、車に何か悪いことが起きたときのためのものだから" },
    { "t": [59.5,  61.5], "ja": "ちなみに、私は何年も入ってない" },
    { "t": [61.5,  63.5], "ja": "信じられない。私たち、前は一緒に住んでたのに" },
    { "t": [63.5,  64.5], "ja": "ああ" },
    { "t": [64.5,  66.5], "ja": "まだ僕のことが気になってるんだね" },
    { "t": [66.5,  67.5], "ja": "左を見て" },
    { "t": [67.5,  69.5], "ja": "大丈夫？" },
    { "t": [69.5,  71.5], "ja": "どうでもいい" },
    { "t": [71.5,  73.5], "ja": "あなたって、自分の薬にハマっちゃうタイプの医者？" },
    { "t": [73.5,  74.5], "ja": "絶対そうでしょ" },
    { "t": [74.5,  75.5], "ja": "じゃあ、アンディ、何があったのか教えて" },
    { "t": [75.5,  81.5], "ja": "百科事典を読んでたら、つまずいたか転んだかして、頭を打ったんです" },
    { "t": [81.5,  84.5], "ja": "先生の言う「脳ヘルメット」をね" },
    { "t": [84.5,  87.5], "ja": "そう、くしゃみして、壁に頭をぶつけたの" },
    { "t": [87.5,  89.5], "ja": "いかにもありそうだね" },
    { "t": [89.5,  92.5], "ja": "まあ、脳しんとうだとしても、ごく軽いから心配はいらないよ" },
    { "t": [92.5,  94.5], "ja": "他に気になることは？" },
    { "t": [94.5,  95.5], "ja": "ないです" },
    { "t": [95.5,  96.5], "ja": "そう" },
    { "t": [96.5,  100.5], "ja": "いや、えーと、ありますね。ひざの裏あたりに変な発疹があって" },
    { "t": [100.5,  104.5], "ja": "舌のこっち側は、もう何の味もしないんです" },
    { "t": [104.5,  108.5], "ja": "歩くとたまに、足首がガラガラヘビみたいな変な音を立てるし" },
    { "t": [108.5,  109.5], "ja": "他には？" },
    { "t": [109.5,  112.5], "ja": "目から遠いものがぼやけて見えます" },
    { "t": [112.5,  116.5], "ja": "前にツイックスを包み紙ごと食べたんだけど、包み紙が出てきたのを見たことがない" },
    { "t": [116.5,  119.5], "ja": "それに、この25年間に噛んだガムは全部飲み込んでます" },
    { "t": [119.5,  120.5], "ja": "アンディ！" },
    { "t": [120.5,  121.5], "ja": "分からないけど" },
    { "t": [121.5,  123.5], "ja": "ここに来る途中で親指を折りました" },
    { "t": [123.5,  125.5], "ja": "とにかく治してください" },
    { "t": [125.5,  131.5], "ja": "まあ、親指は手当てできるけど、残りの千個のことは専門医を紹介することになるね" },
    { "t": [131.5,  134.5], "ja": "へえ、なんにもしてくれなくてどうも、ハリス先生" },
    { "t": [134.5,  135.5], "ja": "どういたしまして" },
    { "t": [135.5,  145.5], "ja": "イー、エイチ、4、エム、ジャガイモの形、マグカップの形、にじみ、にじみ、中指" },
    { "t": [145.5,  146.5], "ja": "にじみ" },
    { "t": [146.5,  147.5], "ja": "残りは全部にじみです" },
    { "t": [147.5,  148.5], "ja": "なんてこと" },
    { "t": [148.5,  149.5], "ja": "ここまで運転してきたのに" },
    { "t": [149.5,  153.5], "ja": "1週間で、自分たちの診察予約を1億件くらい入れたの" },
    { "t": [153.5,  156.5], "ja": "これが終わったら、10年くらい医者に行かなくて済む" },
    { "t": [156.5,  158.5], "ja": "だって、私たち賢いから" },
    { "t": [158.5,  161.5], "ja": "まあ、絶対にメガネが必要だね" },
    { "t": [161.5,  162.5], "ja": "だめ、メガネはかけさせない" },
    { "t": [162.5,  163.5], "ja": "今の顔が好きなの" },
    { "t": [163.5,  165.5], "ja": "メガネをかけたら離婚するから" },
    { "t": [165.5,  166.5], "ja": "ほら、聞いたでしょ、先生" },
    { "t": [166.5,  168.5], "ja": "メガネには男前すぎるんです" },
    { "t": [168.5,  169.5], "ja": "悪気はないですよ" },
    { "t": [175.5,  176.5], "ja": "どういたしまして" },
    { "t": [176.5,  177.5], "ja": "また次回" },
    { "t": [177.5,  178.5], "ja": "じゃあね" }
  ]
}
