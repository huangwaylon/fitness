262.2],"en":"It's-it's-it's better this way anyway."},{"t":[264.2,265.6],"en":"I mean, I don't know what I was thinking"},{"t":[265.6,267.1],"en":"going down that road again with us."},{"t":[267.4,269],"en":"It's-it's just much easier"},{"t":[269,271.1],"en":"if we're-if we're just friends"},{"t":[271.1,272.3],"en":"who have a kid."},{"t":[273.2,273.6],"en":"Really?"},{"t":[274,274.3],"en":"Yeah."},{"t":[274.9,276.6],"en":"And-and you're okay with that?"},{"t":[276.6,276.9],"en":"Yes."},{"t":[277,278.6],"en":"I mean, it's-it's what we always planned."},{"t":[279.5,281],"en":"And if-if you have a plan,"},{"t":[281.2,282.1],"en":"you should stick to it."},{"t":[282.3,283.6],"en":"That's-that's-that's why"},{"t":[283.6,284.5],"en":"they call them plans."},{"t":[284.6,284.7],"en":"Hello?"},{"t":[288.1,288.8],"en":"I'm fine."},{"t":[290.8,292.4],"en":"Hey, for what it's worth,"},{"t":[292.8,293.4],"en":"with Rachel,"},{"t":[293.5,294.6],"en":"I don't think you'll ever be"},{"t":[294.6,295.9],"en":"just anybody."},{"t":[297.7,299.2],"en":"Hey, there you go."},{"t":[302,302.4],"en":"Thanks."},{"t":[303.2,304.2],"en":"Thanks."}]}
