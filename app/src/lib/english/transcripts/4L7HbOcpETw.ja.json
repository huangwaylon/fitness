    { "t": [112.6, 113.6], "ja": "パイプの一種だ" },
    { "t": [113.6, 117.2], "ja": "たばこを詰めて、よく果物やはちみつの香りを混ぜるんだ" },
    { "t": [117.2, 118.2], "ja": "わかった" },
    { "t": [118.2, 121.2], "ja": "いいか、トビー…パム、これを書き留めてくれ" },
    { "t": [121.2, 125.6], "ja": "トビーの尿検査に加えて、血液と髪の毛も検査したい" },
    { "t": [125.6, 126.6], "ja": "そんなことできないよ" },
    { "t": [126.6, 131.1], "ja": "誰でも無作為に検査できるし、無作為に君を選んだんだ" },
    { "t": [131.1, 132.1], "ja": "それは無作為じゃない" },
