    { "t": [44.1, 45.1], "ja": "疑いの対象にはならない" },
    { "t": [45.1, 48.2], "ja": "薬物は人生をだめにするんだ、みんな" },
    { "t": [48.2, 51.4], "ja": "薬物は仕事を台無しにする" },
    { "t": [51.4, 52.4], "ja": "チーチ＆チョンを見てみろ" },
    { "t": [52.4, 55], "ja": "チーチ＆チョンが面白いのは誰でも知ってる" },
    { "t": [55, 59.4], "ja": "でも、マリファナを吸ってなかったらどれだけ面白かったか想像してみろ" },
    { "t": [59.4, 63], "ja": "じゃあ、みんな左を見て" },
    { "t": [63, 66.9], "ja": "今度は右を見て" },
    { "t": [66.9, 74.4], "ja": "そのどちらかの人は、人生のどこかで薬物のせいで死ぬ" },
    { "t": [74.4, 79.5], "ja": "今年は、子どもに本を読み聞かせる人より、コカインを使う人のほうが多くなる" },
    { "t": [79.5, 81.3], "ja": "その情報、どこで仕入れたんですか？" },
    { "t": [81.3, 83.7], "ja": "この情報が怖いか、怖くないか、どっちだ？" },
    { "t": [83.7, 84.7], "ja": "怖くないです" },
    { "t": [84.7, 88.2], "ja": "薬物を吸うのはかっこいいと思う？" },
    { "t": [88.2, 90.1], "ja": "お酒をやるのはかっこいいと思う？" },
    { "t": [90.1, 91.1], "ja": "いいえ、思いません" },
