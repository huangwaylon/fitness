{
  "video": "ltbHNnrkbXY",
  "lines": [
    { "t": [0, 2.4], "ja": "ねえ、モニカ、ピートにチャンスをあげようよ" },
    { "t": [2.7, 5], "ja": "ねえ、彼面白かったし、すごくいい人そうだし" },
    { "t": [5.2, 7], "ja": "あの小切手の件もかわいかったじゃない" },
    { "t": [7.3, 7.8], "ja": "小切手の件って？" },
    { "t": [9, 11.9], "ja": "冗談でね、私に気がある職場のお客さんが" },
    { "t": [11.9, 13.6], "ja": "2万ドルのチップをくれたの" },
    { "t": [14.3, 16.5], "ja": "小切手に電話番号が書いてあって。電話させたくてやっただけよ" },
    { "t": [17.5, 19], "ja": "ピート・ベッカー。ピート…" },
    { "t": [26.4, 27.4], "ja": "これが彼？" },
    { "t": [28.2, 29.1], "ja": "それはビル・クリントンだよ" },
    { "t": [30, 32.2], "ja": "誰と抱き合ってるの？" },
    { "t": [34.8, 37], "ja": "うそ。これ、ピートだ" },
    { "t": [37.5, 38.9], "ja": "なんでビルがピートと抱き合ってるの？" },
    { "t": [39.1, 40.8], "ja": "こいつ、「モス865」を作った人だよ" },
    { "t": [41.1, 43.4], "ja": "世界中のオフィスがそのソフトを使ってる" },
    { "t": [43.6, 44.3], "ja": "うちでも使ってる！" },
    { "t": [44.4, 45.1], "ja": "ほらね" },
    { "t": [46.9, 47.9], "ja": "うそでしょ" },
    { "t": [48.6, 49.8], "ja": "モニカが億万長者とデートするんだ" },
    { "t": [50.1, 51.6], "ja": "デートなんてしないわよ" },
    { "t": [51.7, 54.4], "ja": "うそ。これが本物の2万ドルの小切手だなんて信じられない" },
    { "t": [54.4, 55.5], "ja": "ああ、すごくわくわくする" },
    { "t": [56.9, 58.4], "ja": "それか、ものすごく失礼か" },
