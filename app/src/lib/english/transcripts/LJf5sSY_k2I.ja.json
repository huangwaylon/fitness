{
  "video": "LJf5sSY_k2I",
  "lines": [
    { "t": [0, 2.5], "ja": "彼女に見せたくなかったから、近所を走り回って" },
    { "t": [2.5, 4.1], "ja": "見つけた新聞を全部買ったんだ" },
    { "t": [5.8, 7.1], "ja": "うわ、これはひどい" },
    { "t": [7.5, 9], "ja": "俺も、悪い批評は結構もらってきたからな" },
    { "t": [9.8, 11.2], "ja": "でも、初めてのいい批評は今でも覚えてる" },
    { "t": [11.7, 14.8], "ja": "「この『わが町』の公演は、ほかの全てがただひどかった" },
    { "t": [15.3, 17.5], "ja": "ジョーイ・トリビアーニは最悪だった」" },
    { "t": [21, 22.7], "ja": "やあ。うそ" },
    { "t": [23.2, 24.2], "ja": "この新聞の山を見て" },
    { "t": [24.8, 27], "ja": "きっといい批評なのね。すごくいいの？" },
    { "t": [27.9, 28.3], "ja": "えっと" },
    { "t": [30, 33.9], "ja": "ああ、なんてこと" },
    { "t": [34.2, 38.2], "ja": "でもいい知らせは、半径2ブロック以内の人は誰も知らないってこと" },
    { "t": [39.7, 41.1], "ja": "マンハッタンのほかの人たちは？" },
    { "t": [41.4, 42.2], "ja": "うん、みんな知ってる" },
    { "t": [43.7, 45.3], "ja": "うそでしょ。ひどすぎる" },
    { "t": [45.7, 46.4], "ja": "本当に残念だよ" },
    { "t": [46.4, 47.8], "ja": "すごく恥ずかしい" },
    { "t": [48.3, 49.5], "ja": "でもさ、よく言うだろ、モン？" },
    { "t": [49.6, 51.7], "ja": "悪い評判なんてものはない、ってね" },
    { "t": [51.8, 55.7], "ja": "「シェフのマヒマヒはひどいひどい」って書かれても" },
    { "t": [56.1, 57], "ja": "悪い評判じゃないって思うの？" },
    { "t": [59.1, 60.2], "ja": "俺が書いたんじゃないし" },
    { "t": [61.9, 62.8], "ja": "彼の言う通りなの？" },
    { "t": [63.1, 63.5], "ja": "私って本当に…" },
    { "t": [63.6, 64], "ja": "私ってひどいの？" },
    { "t": [64.2, 64.5], "ja": "いや" },
    { "t": [65.1, 67.2], "ja": "なあ、なあ、モニカ、よく聞いて、いい？" },
    { "t": [67.4, 69.2], "ja": "友達だから言ってるんじゃない" },
    { "t": [69.2, 70.8], "ja": "本当のことだから言うんだ" },
    { "t": [71, 72.5], "ja": "君の料理は最悪だよ" }
  ]
}
