{
  "video": "t1FM4nExR5c",
  "lines": [
    { "t": [0,2.8], "ja": "ディージェイ・バッツのお出ましだ" },
    { "t": [2.8,6.4], "ja": "トム・ハヴァフォードのお出ましだと告げてくれ" },
    { "t": [6.4,9.3], "ja": "あー、ワン、ツー、ワン、ツー" },
    { "t": [9.3,10.2], "ja": "ドナテッラ" },
    { "t": [10.2,11.9], "ja": "ティーモービル" },
    { "t": [11.9,12.9], "ja": "君に3つの言葉を" },
    { "t": [12.9,14.8], "ja": "自分にごほうび" },
    { "t": [14.8,17.1], "ja": "自分にごほうび、2011" },
    { "t": [17.1,20.1], "ja": "年に一度、ドナと俺は自分にごほうびをあげる日を過ごすんだ" },
    { "t": [20.1,21.6], "ja": "何をごほうびにするかって？" },
    { "t": [21.6,22.4], "ja": "服" },
    { "t": [22.4,23.1], "ja": "自分にごほうび" },
    { "t": [23.1,23.7], "ja": "香水" },
    { "t": [23.7,24.3], "ja": "自分にごほうび" },
    { "t": [24.3,25.2], "ja": "マッサージ" },
    { "t": [25.2,25.8], "ja": "自分にごほうび" },
    { "t": [25.8,26.7], "ja": "ミモザ" },
    { "t": [26.7,27.2], "ja": "自分にごほうび" },
    { "t": [27.2,28.8], "ja": "上等な革製品" },
    { "t": [28.8,29.6], "ja": "自分にごほうび" },
    { "t": [29.6,31.3], "ja": "一年でいちばんの日だ" },
    { "t": [31.3,33.3], "ja": "一年でいちばんの日？" },
    { "t": [33.3,34.3], "ja": "ひとつ聞きたいんだけど" },
    { "t": [34.3,34.9], "ja": "うん" },
    { "t": [34.9,38.4], "ja": "今日、ベンも一緒に誘うのってどう思う？" },
    { "t": [38.4,40.7], "ja": "いや、だめだ" },
    { "t": [40.7,41.6], "ja": "これは俺たちの行事だろ" },
    { "t": [41.6,43.7], "ja": "彼、本当に休みが必要そうだよ" },
    { "t": [43.7,47], "ja": "今にも真っ二つに切れそうな、細い輪ゴムみたい" },
    { "t": [47,48], "ja": "その通り" },
    { "t": [48,49.3], "ja": "彼はリラックスの仕方を知らないんだ" },
    { "t": [49.3,51.3], "ja": "ドナ、君と俺はリラックスのプロだぞ" },
    { "t": [51.3,53.7], "ja": "ベンが俺たちについてこられるほど、ゆっくりできるわけがない" },
    { "t": [53.7,55.9], "ja": "お姫さま、今日は俺たちの聖なる日なんだ" },
    { "t": [55.9,56.9], "ja": "年に一度だけの日" },
    { "t": [56.9,58.4], "ja": "自分勝手になっていい日なんだ" },
    { "t": [58.4,59.2], "ja": "おっ、カップケーキ" },
    { "t": [59.2,62.7], "ja": "それは全部俺のだぞ、ジェリー" },
    { "t": [62.7,65.9], "ja": "（聞き取れない）" },
    { "t": [65.9,67.4], "ja": "ああ、もう" },
    { "t": [67.4,71.4], "ja": "ベンチでひとりでスープ飲んでる？" },
    { "t": [71.4,73.5], "ja": "トム" },
    { "t": [73.5,76], "ja": "分かったよ" },
    { "t": [76,77.2], "ja": "ほら、輪ゴムくん" },
    { "t": [77.2,78], "ja": "一緒に来いよ" },
    { "t": [78,79], "ja": "え？" },
    { "t": [79,80.3], "ja": "文句は言わない" },
    { "t": [80.3,81.7], "ja": "車の中でスープは禁止" },
    { "t": [81.7,82.3], "ja": "乗って" },
    { "t": [84.8,85.8], "ja": "今、何が起きてるの？" },
    { "t": [85.8,91], "ja": "じゃあ、自分にごほうびの日って、スパに行ってモールに行くだけの日なの？" },
    { "t": [91,92.5], "ja": "分からないと思ったよ" },
    { "t": [92.5,94.5], "ja": "分からないと思ったよ" },
    { "t": [94.5,96.5], "ja": "まあ、僕はリラックスの初心者だからね" },
    { "t": [96.5,97.7], "ja": "教えてくれよ" },
    { "t": [97.7,99.2], "ja": "いいか、弁当箱くん" },
    { "t": [99.2,101.2], "ja": "大事なのは、自分を甘やかすことなんだ" },
    { "t": [101.2,104.4], "ja": "とにかく力を抜けって" },
    { "t": [104.4,105.4], "ja": "無理だよ" },
    { "t": [105.4,107.9], "ja": "ハープの音って、なんだか落ち着かないんだ" },
    { "t": [107.9,109.9], "ja": "うそでしょ！" },
    { "t": [109.9,111.1], "ja": "こんにちは、ドナ" },
    { "t": [111.1,112.6], "ja": "どうも" },
    { "t": [112.6,114.6], "ja": "リラックスのレッスン、その1。鍼だ" },
    { "t": [114.6,117.6], "ja": "背中にもお尻にもいいんだ" },
    { "t": [117.6,118.9], "ja": "顔には針" },
    { "t": [118.9,120.9], "ja": "体の芯には快感" },
    { "t": [120.9,124.4], "ja": "力を抜いて、動かないで" },
    { "t": [124.4,125.4], "ja": "分かった" },
    { "t": [125.4,126.4], "ja": "ああ" },
    { "t": [126.4,132.4], "ja": "人生でこんなにストレスを感じたのは初めてだ" },
    { "t": [132.4,133.4], "ja": "ベン、聞いて" },
    { "t": [133.4,137.4], "ja": "針から気をそらすために、あなたの好きなことの話をするね、いい？" },
    { "t": [137.4,139.4], "ja": "会計" },
    { "t": [139.4,141.4], "ja": "三角法" },
    { "t": [141.4,143.4], "ja": "切手、たぶん" },
    { "t": [143.4,144.4], "ja": "どちらかというと珍しい硬貨派だな" },
    { "t": [144.4,145.4], "ja": "助けて" },
    { "t": [145.4,146.4], "ja": "助けて" },
    { "t": [146.4,149.4], "ja": "ようこそ、イーグルトンのモール「ニルヴァーナ」へ" },
    { "t": [149.4,150.9], "ja": "裏には水鏡の池がある" },
    { "t": [150.9,153.4], "ja": "モールの中を昔ながらの汽車が走ってる" },
    { "t": [153.4,155.4], "ja": "それにバーバリーが3軒ある" },
    { "t": [155.4,158.9], "ja": "友達に「バーバリーで会おう」って言ったら、どの店か言わなきゃいけないんだ" },
    { "t": [159.9,160.9], "ja": "さあ、行こう" },
    { "t": [162.4,167.9], "ja": "このドレスがすごく欲しいし、このクリスタルのカブトムシも好き。でも高いし、使い道がないの" },
    { "t": [167.9,171.9], "ja": "ドナ・ミーグル、自分にごほうびだ" },
    { "t": [171.9,176.9], "ja": "ベルベットのスリッパ、カシミヤの靴下、ベルベットのパンツ、カシミヤのタートルネック" },
    { "t": [176.9,178.9], "ja": "俺はカシミヤとベルベットのキャンディー・ケーンだ" },
    { "t": [178.9,180.4], "ja": "自分にごほうび" },
    { "t": [180.4,182.4], "ja": "だって、こんなのどうかしてるよ" },
    { "t": [182.4,185.4], "ja": "なあ、今日は自分に何か買ったのか？" },
    { "t": [185.4,186.9], "ja": "うん、この靴下のセットを買ったよ" },
    { "t": [186.9,187.9], "ja": "ただの白い靴下？" },
    { "t": [187.9,188.4], "ja": "うん" },
    { "t": [188.4,189.4], "ja": "そんなのごほうびじゃない" },
    { "t": [189.4,191.4], "ja": "ドナ、こいつから俺を引き離してくれ" },
    { "t": [191.4,194.9], "ja": "ねえ、これは私たちなりの「自分にごほうびの日」で、彼には彼なりのやり方が必要なのかも" },
    { "t": [194.9,195.9], "ja": "何の話だよ？" },
    { "t": [195.9,200.9], "ja": "ねえ、もし何かひとつに大金を使えるとしたら、靴下代じゃなくてね、何に使う？" },
    { "t": [200.9,210.4], "ja": "うそだろ、うそだろ、うそだろ。オタクの新しいレベルだ" },
    { "t": [210.4,211.4], "ja": "そうだよね" },
    { "t": [211.4,212.4], "ja": "ばかげてる" },
    { "t": [212.4,213.4], "ja": "僕は何してるんだ？" },
    { "t": [213.4,214.4], "ja": "いや、いや、いや、いや、いや、いや" },
    { "t": [214.4,215.9], "ja": "いい意味で言ったんだよ、ベン" },
    { "t": [215.9,216.9], "ja": "聞いてくれ" },
    { "t": [216.9,218.9], "ja": "君はもう、自分にごほうびチームの一員だ、いいな？" },
    { "t": [218.9,222.9], "ja": "その衣装で幸せになれるなら、買うんだ" },
    { "t": [222.9,224.9], "ja": "店から着て出ていくんだ、いいな？" },
    { "t": [224.9,225.9], "ja": "自分にごほうびをあげるんだ" },
    { "t": [225.9,227.4], "ja": "うん、よし" },
    { "t": [227.4,228.4], "ja": "そうするよ" },
    { "t": [228.4,229.4], "ja": "僕は…" },
    { "t": [229.4,230.4], "ja": "うん" },
    { "t": [230.4,231.4], "ja": "自分にごほうびをあげる" },
    { "t": [231.4,232.4], "ja": "ありがとう、二人とも" },
    { "t": [234.4,235.4], "ja": "ありがとう" },
    { "t": [237.4,239.4], "ja": "これが本当に必要だったんだ" },
    { "t": [241.4,243.4], "ja": "自分にごほうびをあげるよ" },
    { "t": [245.4,247.4], "ja": "あらら、バットマンが泣いてる" },
    { "t": [248.4,249.4], "ja": "どうした？" },
    { "t": [249.4,250.4], "ja": "言っちゃえよ" },
    { "t": [250.4,255.4], "ja": "ある女性と、えー、しばらく付き合ってたんだ" },
    { "t": [255.4,260.9], "ja": "それで、えー、つい最近、別れたんだ" },
    { "t": [260.9,263.9], "ja": "だから最近、調子が悪かったのか" },
    { "t": [263.9,264.9], "ja": "残念だったな、相棒" },
    { "t": [264.9,266.9], "ja": "ワイアット、お前はいい男だぞ" },
    { "t": [266.9,268.4], "ja": "大丈夫さ" },
    { "t": [268.4,270.4], "ja": "女の子なんてどこにでもいるぞ、ベン" },
    { "t": [270.4,271.9], "ja": "このモール中にいる" },
    { "t": [271.9,273.9], "ja": "きっと見つかるし、うまくいくさ" },
    { "t": [273.9,274.9], "ja": "でも今は、気持ちを全部出しちゃえよ" },
    { "t": [274.9,276.9], "ja": "思いきり泣くのを、自分へのごほうびにしな" },
    { "t": [278.9,279.9], "ja": "ひとつだけ聞いていい？" },
    { "t": [279.9,280.9], "ja": "何？" },
    { "t": [281.9,284.9], "ja": "なぜそんなに深刻な顔をしてる？" },
    { "t": [284.9,285.4], "ja": "（音楽）" },
    { "t": [285.4,285.5], "ja": "（音楽）" }
  ]
