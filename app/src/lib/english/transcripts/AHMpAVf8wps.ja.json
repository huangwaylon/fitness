{
  "video": "AHMpAVf8wps",
  "lines": [
    { "t": [0,1.5], "ja": "冗談でしょ" },
    { "t": [1.5,4.4], "ja": "ねえ、僕のことをケリーに悪く言ってるらしいね" },
    { "t": [5.4,7.8], "ja": "あなたが前にケリーにひどい扱いをしてたことを、思い出させてあげただけよ" },
    { "t": [7.8,10], "ja": "まあ、それは君の意見で、ケリーの意見でもある" },
    { "t": [10,11.3], "ja": "でも、僕の意見じゃない" },
    { "t": [11.3,13.5], "ja": "僕に何か悪いことを言いたいなら、パム" },
    { "t": [13.5,15.4], "ja": "面と向かって言ってよ" },
    { "t": [15.4,16.3], "ja": "確かにね" },
    { "t": [19.8,22.2], "ja": "あなたはあまりいい人だと思わない" },
    { "t": [22.2,24.8], "ja": "それに失礼だけど、前にもこれ言った気がする" },
    { "t": [24.8,26.1], "ja": "あなたのこと、あまり好きじゃないの" },
    { "t": [26.1,27.1], "ja": "まあ、多くの人が言うと思うよ" },
    { "t": [27.1,30.4], "ja": "ラヴィよりも僕のほうがケリーにお似合いだって" },
    { "t": [30.4,32.9], "ja": "ちょっと、ライアン、本気？" },
    { "t": [32.9,34.7], "ja": "ラヴィのほうがずっといいよ" },
    { "t": [34.7,35.9], "ja": "うん　ケリーにとって？" },
    { "t": [35.9,38.9], "ja": "ああ、おまえ、今どうかしてるぞ" },
    { "t": [38.9,40.9], "ja": "ラヴィは何もかもそろってる" },
    { "t": [40.9,43.2], "ja": "ラヴィに直接会ったことはないけど" },
    { "t": [43.2,44.6], "ja": "あえて言わせてもらうよ" },
    { "t": [44.6,47.6], "ja": "君のことは少ししか知らないけどね、ブライアン" },
    { "t": [47.6,49.5], "ja": "僕はラヴィのほうがいいと思う" },
    { "t": [49.5,51.8], "ja": "もう一度言うけど、その人に会ったこともないんだけどね" },
    { "t": [51.8,53.7], "ja": "ケリー、周りを見て" },
    { "t": [53.7,55.6], "ja": "誰も僕たちのことを信じてない" },
    { "t": [55.6,56.7], "ja": "誰もだ" },
    { "t": [56.7,59.7], "ja": "ライアン、私の友だちの前で騒ぐのはやめて" },
    { "t": [59.7,62.4], "ja": "ケリー、最高にすごい愛の詩を書いたんだ" },
    { "t": [63.6,65.4], "ja": "でも、読むこともできない" },
    { "t": [65.4,67.5], "ja": "心がもたないんだ" },
    { "t": [67.5,69.6], "ja": "え、だめ、だめ、だめ、読んでよ、お願い" },
    { "t": [69.6,71.2], "ja": "すごい詩って大好きなの" },
    { "t": [71.2,73.4], "ja": "いや、つらすぎて無理だ" },
    { "t": [73.4,74.7], "ja": "痛みに負けずに読んで、強くなって" },
    { "t": [74.7,76.8], "ja": "この詩を聞いたら君はくずれ落ちちゃうよ" },
    { "t": [76.8,77.7], "ja": "もう、ライアン、あっち行って" },
    { "t": [77.7,79.9], "ja": "ケリーには、すてきな彼氏ができたんだから" },
    { "t": [79.9,82.7], "ja": "ああ、彼は本当にかっこいいよ" },
    { "t": [82.7,84.2], "ja": "もうケリーにかまわないで" },
    { "t": [84.2,87.2], "ja": "ほらね、ケリー、僕たちの愛がみんなを怖がらせてるんだ" },
    { "t": [87.2,89.8], "ja": "型にはまった世界がめちゃくちゃになるからね" },
    { "t": [95.7,97.4], "ja": "でもさ、彼の言ってること正しいと思う？" },
    { "t": [99,101.7], "ja": "僕たちって型にはまった世界に住んでるのかな？" },
    { "t": [101.7,103.6], "ja": "完全にそうだけど、そういう話じゃないの" },
    { "t": [103.6,104.6], "ja": "もう" },
    { "t": [107.7,108.7], "ja": "あっ" },
    { "t": [108.7,110.2], "ja": "ブー！" },
    { "t": [110.2,111.2], "ja": "うわ" },
    { "t": [111.2,112], "ja": "ブー！" },
    { "t": [112,113.2], "ja": "ブー！" },
    { "t": [113.2,114], "ja": "おまえこそブーだ！" },
    { "t": [114,114.7], "ja": "あなたは有害よ" },
    { "t": [114.7,115.5], "ja": "あなたは有害よ！" },
    { "t": [115.5,118.2], "ja": "ちょっと、ちょっと、ちょっと　ケリー、君に言いたいことがいくつかある" },
    { "t": [118.2,119.7], "ja": "それと、割りこまないでね" },
    { "t": [119.7,120.7], "ja": "割りこむつもりなんてなかったけど" },
    { "t": [120.7,122.3], "ja": "うん、でも君はよく割りこむから、とにかくしないで" },
    { "t": [122.3,123.1], "ja": "ありがとう" },
    { "t": [123.1,126], "ja": "分かってるよ、僕は今まで、いつも君を大事に扱ってきたわけじゃない" },
    { "t": [126,129.6], "ja": "なぜだか君が、自分はこう扱われるべきだと思ってるようにはね" },
    { "t": [129.6,132.2], "ja": "でも、君と結婚したいんだ、ケリー・カプール" },
    { "t": [132.2,134.6], "ja": "今日じゃないかもしれない、明日でもないかもしれない" },
    { "t": [134.6,136.1], "ja": "でもいつか" },
    { "t": [136.1,137.3], "ja": "それに、たぶん" },
    { "t": [137.3,138.3], "ja": "おえっ！" },
    { "t": [138.3,139.8], "ja": "最低！" },
    { "t": [139.8,141.2], "ja": "何が気に入らないの？" },
    { "t": [141.2,143], "ja": "ねえ、ねえ、ねえ、ねえ、ねえ、話を元に戻して" },
    { "t": [143,143.8], "ja": "早く、お願い" },
    { "t": [143.8,144.7], "ja": "早く元に戻せる？" },
    { "t": [144.7,146], "ja": "これは僕にとってすごく大事なんだ" },
    { "t": [146,147.5], "ja": "こっち向いて" },
    { "t": [147.5,148.3], "ja": "こっち向いて" },
    { "t": [148.3,150], "ja": "ちょっと、話を戻してくれないかな？" },
    { "t": [150,150.6], "ja": "ありがとう" },
    { "t": [150.6,151.6], "ja": "彼女はこっちを向きたくないってさ" },
    { "t": [151.6,153.6], "ja": "ありがとう" },
    { "t": [153.6,157.3], "ja": "ケリー、ずっと一緒にいられるとは約束できない" },
    { "t": [157.3,159.6], "ja": "絶対に浮気しないとも約束できない" },
    { "t": [159.6,160.2], "ja": "そんな約束、するべきでもない" },
    { "t": [160.2,162.1], "ja": "今の結婚はそういうふうにできてないんだ" },
    { "t": [162.1,163], "ja": "男はそういうふうにできてない" },
    { "t": [163,165.1], "ja": "すごく面白い記事があるから、メールで送るよ" },
    { "t": [165.1,166.4], "ja": "でも、これだけは言える" },
    { "t": [166.4,170.5], "ja": "たとえ1週間以内に別れる確率が五分五分でも" },
    { "t": [170.5,173.1], "ja": "僕はそのサイコロを振りたい" },
    { "t": [173.1,174.1], "ja": "愛してるよ、ケリー" },
    { "t": [174.1,174.9], "ja": "バイバイ" },
    { "t": [174.9,177.1], "ja": "僕と一緒にそのサイコロを振ってくれる？" },
    { "t": [177.1,180.1], "ja": "あなたは私にとってすごく大切な人" },
    { "t": [180.1,182.5], "ja": "でも、私はラヴィを愛してるし、彼を選ぶ" },
    { "t": [182.5,183.3], "ja": "いや、違う" },
    { "t": [183.3,184.1], "ja": "違わない（選ぶの）" },
    { "t": [184.1,184.9], "ja": "いや、違うよ" },
    { "t": [184.9,187.8], "ja": "これからも友だちでいられるといいな" },
    { "t": [187.8,188.7], "ja": "やあ" },
    { "t": [188.7,189.7], "ja": "どうも" },
    { "t": [189.7,192.7], "ja": "ハグしてもいい？" },
    { "t": [192.7,195.1], "ja": "いったい何がしたいの？" },
    { "t": [195.1,196.1], "ja": "うん" },
    { "t": [196.1,198.1], "ja": "すごくいいね" },
    { "t": [198.1,199.9], "ja": "あっ" },
    { "t": [199.9,200.8], "ja": "うえっ" },
    { "t": [200.8,202.2], "ja": "まあ、ケリーがちゃんと分け合ってるみたいでよかった" },
    { "t": [202.2,204], "ja": "うっ" },
