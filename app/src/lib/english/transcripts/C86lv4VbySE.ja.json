{
  "video": "C86lv4VbySE",
  "lines": [
    { "t": [0,  2.3], "ja": "次の方" },
    { "t": [2.3,  4.8], "ja": "で、何か耳寄りな話はある、サルバトーレ？" },
    { "t": [4.8,  5.8], "ja": "足が痛い" },
    { "t": [5.8,  8.7], "ja": "いかにもサルバトーレね" },
    { "t": [8.7,  9.9], "ja": "知り合いだったか？" },
    { "t": [9.9,  10.9], "ja": "あ、いいえ" },
    { "t": [10.9,  13.3], "ja": "これが私の、初めての公式な政治家としてのヘアカットなんです" },
    { "t": [13.3,  16.6], "ja": "レスリー・ノープ、公園レクリエーション課の副部長です" },
    { "t": [16.6,  19.7], "ja": "あのマーリーン何とかノープと関係あるのか？" },
    { "t": [19.7,  20.9], "ja": "場合によりますね" },
    { "t": [20.9,  23.9], "ja": "娘であることを、関係があると言うなら" },
    { "t": [23.9,  26.6], "ja": "他に何て言うんだよ？" },
    { "t": [26.6,  28], "ja": "で、これをどうしてほしい？" },
    { "t": [28,  29.9], "ja": "ええと、今夜は母が表彰されるんです" },
    { "t": [29.9,  32.4], "ja": "だから、ある意味、私も表彰されるようなもので" },
    { "t": [32.4,  34.7], "ja": "ちょっと雰囲気を変えたかったんです" },
    { "t": [34.7,  37.2], "ja": "アップにして、ちょっと生意気な感じで" },
    { "t": [37.2,  40], "ja": "でも力強くて、名家っぽく" },
    { "t": [43.4,  44.8], "ja": "まあ、ありがとう" },
    { "t": [46.2,  48.2], "ja": "やあ、エイプリル" },
    { "t": [48.2,  50.3], "ja": "こんばんは、ボス" },
    { "t": [50.3,  51.4], "ja": "あら、今は仕事の時間外よ、エイプリル" },
    { "t": [51.4,  52.7], "ja": "ボスなんて呼ばなくていいの" },
    { "t": [52.7,  56.2], "ja": "サルバトーレは、この髪型を「市長」って呼んでるの" },
    { "t": [56.2,  57.8], "ja": "そう、ポーニー初の女性市長になったら" },
    { "t": [57.8,  60.9], "ja": "この髪型にするつもりよ" },
    { "t": [60.9,  63.3], "ja": "うわあ" },
    { "t": [63.3,  64.6], "ja": "私、すごく着飾りすぎてる" },
    { "t": [64.6,  65.4], "ja": "何言ってるの？" },
    { "t": [65.4,  66.2], "ja": "すてきよ" },
    { "t": [66.2,  67.3], "ja": "私たち、すてき" },
    { "t": [67.3,  68.5], "ja": "みんな私たちを見てる" },
    { "t": [68.5,  70.1], "ja": "ええ、そうね" },
    { "t": [70.1,  71], "ja": "何か飲む？" },
    { "t": [71,  73.5], "ja": "ええ、すごく飲みたい" },
    { "t": [73.5,  75.3], "ja": "あの男の人、こっちを見てる" },
    { "t": [75.3,  77.8], "ja": "あれは元市議会議員のフランク・シュナベルよ" },
    { "t": [77.8,  79.9], "ja": "今夜は格上の世界にいるのよ、アン" },
    { "t": [79.9,  80.8], "ja": "格上の世界" },
    { "t": [80.8,  81.6], "ja": "こっちに来るわ" },
    { "t": [81.6,  82.5], "ja": "え？" },
    { "t": [82.5,  83.6], "ja": "よし、落ち着いて。落ち着いて" },
    { "t": [83.6,  85.1], "ja": "頑張る" },
    { "t": [85.1,  86.7], "ja": "こんばんは。こんばんは" },
    { "t": [86.7,  88.7], "ja": "元市議会議員さん、レスリー・ノープです" },
    { "t": [88.7,  90.3], "ja": "今夜表彰される人の娘です" },
    { "t": [90.3,  94.2], "ja": "ただ伝えたかったんだ、君たち二人がしていることは本当に勇敢だと思う" },
    { "t": [94.2,  99.9], "ja": "つまり、ありのままの自分でいることがね。私にも君たちの勇気があればな" },
    { "t": [99.9,  105.5], "ja": "はい、行きましょう" },
    { "t": [105.5,  109.1], "ja": "こんにちは" },
    { "t": [109.1,  112], "ja": "あら、レス" },
    { "t": [112,  113.7], "ja": "まあ" },
    { "t": [113.7,  114.6], "ja": "すてきね" },
    { "t": [114.6,  115.3], "ja": "気に入った？" },
    { "t": [115.3,  116.5], "ja": "サルバトーレの所に行ったの" },
    { "t": [116.5,  118.1], "ja": "サルバトーレは普段、男性専門よ" },
    { "t": [118.1,  119], "ja": "普段はね" },
    { "t": [119,  121], "ja": "でも今回は、例外を作ってくれたの" },
    { "t": [121,  122.7], "ja": "こちらはアン・パーキンス" },
    { "t": [122.7,  123.7], "ja": "あら" },
    { "t": [123.7,  124.7], "ja": "レスリーの新しいお友だちね" },
    { "t": [124.7,  125.7], "ja": "ええ、友だち" },
    { "t": [125.7,  126.7], "ja": "私たち友だちです" },
    { "t": [126.7,  127.7], "ja": "ただの友だち" },
    { "t": [127.7,  128.7], "ja": "私には彼氏がいます" },
    { "t": [128.7,  129.7], "ja": "男性です" },
    { "t": [129.7,  131.7], "ja": "ねえ、アン、マークはどこ？" },
    { "t": [131.7,  132.7], "ja": "トムと帰ったわ" },
    { "t": [132.7,  135.4], "ja": "まずい、難しい任務があって、彼の助けが必要なのに" },
    { "t": [135.4,  136.4], "ja": "私が手伝う" },
    { "t": [136.4,  137.4], "ja": "何かやらせて" },
    { "t": [137.4,  141.4], "ja": "分かった、えーと、どうやらレストレポが私たちを適当にあしらおうとしてるから、母に作戦があるの" },
    { "t": [141.4,  143.4], "ja": "ちょっと圧力をかけるのよ" },
    { "t": [143.4,  147.7], "ja": "彼女は隠そうとしてるの、夫が好きなのは…" },
    { "t": [147.7,  152.7], "ja": "じゃあ、彼女を脅すつもり？" },
    { "t": [152.7,  153.7], "ja": "違う" },
    { "t": [153.7,  155.7], "ja": "ちょっと強気に出るだけ" },
    { "t": [155.7,  156.7], "ja": "タロンソン流でね" },
    { "t": [156.7,  157.7], "ja": "それ、強気には聞こえない" },
    { "t": [157.7,  158.7], "ja": "汚いやり方に聞こえる" },
    { "t": [158.7,  160.7], "ja": "お母さんに汚いことをしろって言われてるみたい" },
    { "t": [160.7,  162.7], "ja": "アン、あなたは政治が分かってない" },
    { "t": [162.7,  163.7], "ja": "いい、看護師は簡単でしょ" },
    { "t": [163.7,  164.7], "ja": "そう？" },
    { "t": [164.7,  165.7], "ja": "ええ" },
    { "t": [165.7,  167.7], "ja": "仕事に行けば、人が来て、治してあげればいい" },
    { "t": [167.7,  168.7], "ja": "でも政治は違う" },
    { "t": [168.7,  170.7], "ja": "時には、痛い目にあわせなきゃいけないの" },
    { "t": [170.7,  173.7], "ja": "人にいいように利用されちゃだめなのよ" },
    { "t": [173.7,  175.7], "ja": "お母さんの助言は良くないと思う" },
    { "t": [175.7,  177.7], "ja": "そうは思わない" },
    { "t": [177.7,  179.7], "ja": "お母さんに言われたことは何でもやるの？" },
    { "t": [179.7,  182.7], "ja": "あなたは彼氏に言われたことは何でもやるの？" },
    { "t": [182.7,  183.7], "ja": "最近、パンケーキでも焼いた？" },
    { "t": [183.7,  185.7], "ja": "彼は両脚を骨折してるのよ" },
    { "t": [185.7,  187.7], "ja": "ええ、それに松葉杖が3本ある" },
    { "t": [187.7,  188.7], "ja": "その1本はあなた" },
    { "t": [188.7,  189.7], "ja": "残りの2本が松葉杖" },
    { "t": [189.7,  192.7], "ja": "ねえ、私、ここにいる必要ないわ" },
    { "t": [196.7,  197.7], "ja": "いいんだよ" },
    { "t": [197.7,  199.7], "ja": "ケンカしたっていい" },
    { "t": [199.7,  202.7], "ja": "君たち二人も、他のみんなと同じなんだから" },
    { "t": [202.7,  206.7], "ja": "ありがとう" },
    { "t": [206.7,  208.7], "ja": "シュナベル元議員" }
  ]
}
