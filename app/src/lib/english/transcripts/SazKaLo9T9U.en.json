{"video":"SazKaLo9T9U","lines":[{"t":[0,2.7],"en":"Mmm, those fries look delicious."},{"t":[2.7,5],"en":"Oh, I didn't know you liked french fries."},{"t":[5,7.5],"en":"Help yourself, what's mine is yours."},{"t":[11.6,14.6],"en":"Mmm, wow, are those stuffed clams?"},{"t":[18.2,21.5],"en":"Uh, yes, they are my stuffed clams."},{"t":[23.9,26.1],"en":"How about those fries, though, huh?"},{"t":[27.9,29.1],"en":"They are delicious."},{"t":[29.1,30.6],"en":"Uh-huh, uh-huh."},{"t":[33.9,36.1],"en":"You are beautiful, you know that?"},{"t":[38.3,40.2],"en":"That is so sweet."},{"t":[42.2,43.2],"en":"Okay."},{"t":[55.8,57.2],"en":"Now look what you did!"},{"t":[57.2,58.1],"en":"What?"},{"t":[58.1,60.2],"en":"What is the matter with you?"},{"t":[60.2,64],"en":"I don't like it when people take food off of my plate, okay?"},{"t":[64,66],"en":"But you just said what's mine is yours."},{"t":[66,67.2],"en":"Well, I didn't mean it!"},{"t":[69.2,70.3],"en":"No."},{"t":[70.3,71.1],"en":"This is work."},{"t":[71.1,73.1],"en":"I should call in, can you excuse me?"},{"t":[73.1,74.8],"en":"Oh, yeah, sure, no problem."},{"t":[74.8,78.3],"en":"What are you doing?"},{"t":[78.3,80.4],"en":"I thought you don't share food."},{"t":[80.4,82.3],"en":"Sure I do!"},{"t":[82.3,83.5],"en":"I don't want to do it."},{"t":[83.5,84.1],"en":"I don't know."},{"t":[84.1,89.1],"en":"I don't know if I can't have your clams, you can't have my dessert."},{"t":[89.1,89.7],"en":"This is a two-way street."},{"t":[89.7,90.7],"en":"This is a two-way street."},{"t":[90.7,91.7],"en":"Oh."},{"t":[91.7,92.5],"en":"Oh."},{"t":[92.5,94.5],"en":"Really?"},{"t":[94.5,95.5],"en":"Really?"},{"t":[95.5,98.7],"en":"Now, this all better be here when I come back."},{"t":[98.7,100.2],"en":"Yeah, of course."},{"t":[100.2,102.7],"en":"Yeah, of course, I can control myself."},{"t":[102.7,103.2],"en":"Right?"},{"t":[103.2,104],"en":"Yeah."},{"t":[104,104.8],"en":"Good."},{"t":[116.5,117.6],"en":"Stop staring at me!"},{"t":[129.7,131.2],"en":"Well, just a tiny little."},{"t":[134,136.2],"en":"Uh-oh."},{"t":[146.7,148.2],"en":"I'm not even sorry."}]}
