{
  "video": "f9QHuKzvBVc",
  "lines": [
    { "t": [0, 2], "ja": "わあ、びっくり" },
    { "t": [2, 4], "ja": "うん、ちょっとだけ話したくて" },
    { "t": [4, 7], "ja": "ほら、私の口から直接聞いてほしいことがあって" },
    { "t": [7, 9], "ja": "言葉で、私の口から" },
    { "t": [9, 10], "ja": "今の、変だった？" },
    { "t": [10, 11], "ja": "大丈夫？" },
    { "t": [11, 13], "ja": "うん、大丈夫" },
    { "t": [13, 14], "ja": "まず、こちらはエヴリン" },
    { "t": [14, 15], "ja": "あら、こんにちは" },
    { "t": [15, 18], "ja": "イーグルトンで、私と同じ保健課の仕事をしてる人なの" },
    { "t": [18, 20], "ja": "向こうでは、あまり仕事がなかったんです" },
    { "t": [20, 22], "ja": "イーグルトンの人はとても健康なので" },
    { "t": [22, 24], "ja": "まあ、それならあなたにはすごく面白い挑戦になるかもね" },
    { "t": [24, 26], "ja": "だってポーニーは、記録に残っている最初の" },
    { "t": [26, 28], "ja": "超糖尿病の例がある町だし" },
    { "t": [28, 32], "ja": "ルー・ゲーリッグのもう一つの病気の唯一の例もあるの" },
    { "t": [32, 34], "ja": "教科書にも載ってるんだから" },
    { "t": [34, 36], "ja": "ありがとう、エヴリン。あとでオフィスでね" },
    { "t": [36, 39], "ja": "私はもう少し、レスリーと面と向かって話さないといけないの" },
    { "t": [39, 41], "ja": "お会いできてよかったです" },
    { "t": [41, 43], "ja": "わあ、彼女がかわいそう" },
    { "t": [43, 45], "ja": "だって、誰もあなたの代わりにはなれないもの、アン" },
    { "t": [45, 47], "ja": "その小さなお人形みたいな足じゃね" },
    { "t": [47, 49], "ja": "うん、実は、そのことを話したかったの" },
    { "t": [49, 52], "ja": "私、えっと、仕事を辞めて" },
    { "t": [52, 55], "ja": "エヴリンに引き継ごうと思ってるの" },
    { "t": [55, 56], "ja": "え？だめ" },
    { "t": [56, 57], "ja": "誰かにそうしろって言われたの？" },
    { "t": [57, 58], "ja": "エヴリンでしょ？" },
    { "t": [58, 59], "ja": "やっぱりあの人、怪物だったんだ" },
    { "t": [59, 60], "ja": "違う、違う、違う" },
    { "t": [60, 62], "ja": "クリスと話し合ってて" },
    { "t": [62, 66], "ja": "ポーニーを出ることを真剣に考えてるの" },
    { "t": [66, 69], "ja": "どこか別の所に引っ越して、家族を作ろうって" },
    { "t": [69, 71], "ja": "うそ、見て" },
    { "t": [71, 72], "ja": "ワッフルだ" },
    { "t": [72, 74], "ja": "おいしいワッフル" },
    { "t": [74, 75], "ja": "食べてみる？" },
    { "t": [75, 76], "ja": "うん、食べてみよう" },
    { "t": [76, 77], "ja": "ん？" },
    { "t": [77, 78], "ja": "んー" },
    { "t": [78, 79], "ja": "待って、何の話だっけ？" },
    { "t": [79, 80], "ja": "食べて" },
    { "t": [80, 81], "ja": "楽しんで" },
    { "t": [81, 82], "ja": "うん" },
    { "t": [82, 83], "ja": "そうそう" },
    { "t": [83, 86], "ja": "じゃあ、私の聞き間違いじゃなければ" },
    { "t": [86, 89], "ja": "あなたはポーニーを出ることは考えてないってことね" },
    { "t": [89, 90], "ja": "出ることを考えてるの" },
    { "t": [90, 93], "ja": "これって、アンお得意の「なんてね」ジョーク？" },
    { "t": [93, 94], "ja": "「ポーニーを出るの" },
    { "t": [94, 95], "ja": "なんてね」みたいな" },
    { "t": [95, 96], "ja": "私、そんなことしない" },
    { "t": [96, 97], "ja": "始めたのかなって期待したのに" },
    { "t": [97, 98], "ja": "まだ決まったわけじゃないの" },
    { "t": [98, 100], "ja": "ただ、私たちはどっちもポーニー出身じゃないし" },
    { "t": [100, 103], "ja": "私の家族はみんなミシガンにいるし" },
    { "t": [103, 106], "ja": "クリスは大きな町での生活が恋しいの" },
    { "t": [106, 108], "ja": "だから、そのことをあなたと話したかったの" },
    { "t": [108, 110], "ja": "私の口から聞いてほしくて" },
    { "t": [110, 111], "ja": "んー" },
    { "t": [111, 113], "ja": "なんか、馬が走ってるような音、聞こえない？" },
    { "t": [113, 114], "ja": "んー" },
    { "t": [114, 115], "ja": "何？" },
    { "t": [115, 116], "ja": "まあ" },
    { "t": [116, 117], "ja": "見て！" },
    { "t": [117, 119], "ja": "馬に乗ったジョー・バイデン？" },
    { "t": [119, 120], "ja": "上半身裸で？" },
    { "t": [120, 122], "ja": "すごい！" },
    { "t": [122, 124], "ja": "仕事が山ほどあるの" },
    { "t": [124, 125], "ja": "そんなに忙しくないから" },
    { "t": [125, 129], "ja": "自分で出ていってね" },
    { "t": [129, 132], "ja": "いい？アンがポーニーを出たいなら、分かるよ" },
    { "t": [132, 135], "ja": "だって、世界一の町に親友と一緒にいて" },
    { "t": [135, 137], "ja": "ずっと幸せに暮らすなんて、誰がしたい？" },
    { "t": [137, 140], "ja": "心の姉妹を古い靴みたいに捨てて" },
    { "t": [140, 143], "ja": "嫌な人だらけのゴミみたいな町に引っ越せるのに" },
    { "t": [143, 144], "ja": "分かるよ" },
    { "t": [144, 146], "ja": "恨んでないから" }
  ]
}
