{"video":"qEOkRjED2wg","lines":[{"t":[0,5],"en":"Shaping a company is in a sense similar to training a geisha."},{"t":[5,10],"en":"You have to mold not merely the physical form, but also the character."},{"t":[10,13],"en":"The two must harmonize."},{"t":[13,16],"en":"Are they still there?"},{"t":[16,21],"en":"They want a decision. Who gets the big client?"},{"t":[21,23],"en":"Well, they can wait."},{"t":[23,28],"en":"I'll still be talking about geishas long past their bedtime."},{"t":[28,30],"en":"You know, I trained as one."},{"t":[30,35],"en":"Is it just me or is our boss a freaking weirdo?"},{"t":[35,38],"en":"Let me get some air."},{"t":[45,51],"en":"Jim, you know it would be really dastardly if we snuck out of here and got to the client first."},{"t":[56,65],"en":"He's running!"},{"t":[65,66],"en":"Damn it!"},{"t":[66,68],"en":"Damn it."},{"t":[68,71],"en":"What is this supposed to be?"},{"t":[71,72],"en":"It's a monkey."},{"t":[72,75],"en":"Jim, get real. This is not a monkey."},{"t":[75,77],"en":"It's got a hula skirt and a blue nose."},{"t":[77,78],"en":"Hold on, hold on. Is this him?"},{"t":[78,79],"en":"What?"},{"t":[79,80],"en":"Is that him?"},{"t":[80,81],"en":"It's him!"},{"t":[81,82],"en":"Do something! Get out!"},{"t":[82,83],"en":"What? What am I going to do?"},{"t":[83,84],"en":"I don't..."},{"t":[84,85],"en":"Go slash his tires."},{"t":[85,86],"en":"Go dent his hood."},{"t":[89,90],"en":"That's it?"},{"t":[90,91],"en":"Oh, that's great."},{"t":[91,92],"en":"That's like a five second delay."},{"t":[92,93],"en":"Dwight!"},{"t":[93,94],"en":"Go!"},{"t":[94,95],"en":"Does this thing have turbo?"},{"t":[95,96],"en":"Nitrous?"},{"t":[96,97],"en":"Hit the NAS."},{"t":[97,98],"en":"NAS?"},{"t":[98,99],"en":"You mean like in Fast and Furious?"},{"t":[99,100],"en":"Yeah."},{"t":[100,101],"en":"Oh yeah, I definitely have NAS."},{"t":[101,102],"en":"Hit the NAS."},{"t":[102,103],"en":"Are you sure?"},{"t":[103,104],"en":"Yes."},{"t":[104,105],"en":"Brace yourself."},{"t":[105,106],"en":"Three, two, one."},{"t":[106,107],"en":"Here we go!"},{"t":[112,113],"en":"Ready?"},{"t":[113,114],"en":"Go!"},{"t":[114,116],"en":"Go, go, go, go, go, go, go, go, go, go, go, go, go, go."},{"t":[127,128],"en":"Ah!"},{"t":[135,136],"en":"You alright?"},{"t":[136,137],"en":"Yeah."},{"t":[140,141],"en":"Ah!"},{"t":[143,144],"en":"Dwight, what are you doing?"},{"t":[144,145],"en":"Shh."},{"t":[145,146],"en":"Go!"},{"t":[146,147],"en":"Go!"},{"t":[147,148],"en":"Take the stairs!"},{"t":[148,149],"en":"Now!"},{"t":[149,150],"en":"What are you talking about?"},{"t":[150,151],"en":"Just run!"},{"t":[151,152],"en":"Take the stairs!"},{"t":[152,153],"en":"I don't even know where the stairs are!"},{"t":[153,154],"en":"I'll stall him!"},{"t":[154,155],"en":"Go!"},{"t":[155,156],"en":"God!"},{"t":[156,157],"en":"What are you doing?"},{"t":[157,158],"en":"I'm going to activate the seismic failsafe!"},{"t":[158,159],"en":"We'll be stuck between floors for hours!"},{"t":[159,161],"en":"I'm going to activate the seismic failsafe!"},{"t":[161,162],"en":"We'll be stuck between floors for hours!"},{"t":[162,163],"en":"I'm going to activate the seismic failsafe!"},{"t":[163,164],"en":"We'll be stuck between floors for hours!"},{"t":[175,176],"en":"We'll be stuck between floors for hours!"},{"t":[176,177],"en":"Uh-oh!"},{"t":[177,178],"en":"My pants fell down!"},{"t":[178,179],"en":"What?"},{"t":[179,180],"en":"My pants fell down!"},{"t":[180,181],"en":"What?"},{"t":[181,182],"en":"My pants fell down!"},{"t":[182,183],"en":"I don't have a belt!"},{"t":[183,184],"en":"My pants fell down!"},{"t":[184,185],"en":"I don't have a belt!"},{"t":[185,186],"en":"Hello, sir!"},{"t":[186,187],"en":"Good day!"},{"t":[187,188],"en":"Dwight K. Schrute, Dunder Mifflin Scranton!"},{"t":[188,189],"en":"Forgive my pants."},{"t":[189,190],"en":"They fell down!"},{"t":[190,191],"en":"An appointment with Mr. Ramesh, please!"},{"t":[191,192],"en":"Right now is fine!"},{"t":[192,193],"en":"No, no, no!"},{"t":[193,194],"en":"I was here first!"},{"t":[194,195],"en":"Dwight K. Schrute, Dunder Mifflin Scranton!"},{"t":[195,196],"en":"Hi, guys!"},{"t":[196,197],"en":"What's going on?"},{"t":[197,198],"en":"Mr. Ramesh!"},{"t":[198,199],"en":"Harry Jannerone!"},{"t":[199,200],"en":"Dunder Mifflin, Syracuse!"},{"t":[200,201],"en":"I was here first!"},{"t":[201,202],"en":"Sorry about this."},{"t":[202,203],"en":"I already made an appointment!"},{"t":[203,204],"en":"With your secretary!"},{"t":[204,205],"en":"Let me stop you all right here!"},{"t":[205,207],"en":"I've already picked a new paper supplier!"},{"t":[207,208],"en":"Wait, it's not DM Utica, is it?"},{"t":[208,209],"en":"No, no!"},{"t":[209,211],"en":"It's not Dunder Mifflin at all, actually!"},{"t":[211,213],"en":"It's Big Red Paper Company!"},{"t":[213,214],"en":"Big Red Paper Company?"},{"t":[214,215],"en":"Mm-hmm!"}]}
