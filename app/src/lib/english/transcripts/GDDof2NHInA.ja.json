{
  "video": "GDDof2NHInA",
  "lines": [
    { "t": [0, 3.2], "ja": "ペニーセーバーって、誰だ？いや、何だ？" },
    { "t": [3.2, 5.7], "ja": "クーポンがたくさん入った無料のチラシよ" },
    { "t": [5.7, 9.3], "ja": "これがダイアンの住所のロン・スワンソンあてに届いた" },
    { "t": [9.3, 11.8], "ja": "私が住んで1か月もたっていない所だ" },
    { "t": [11.8, 13.4], "ja": "どうしてそんなことが起きる？" },
    { "t": [13.4, 15.9], "ja": "これはひどいプライバシーの侵害だ" },
    { "t": [15.9, 18.9], "ja": "プライバシーの権利は、私にとってとても大切だ" },
    { "t": [18.9, 21.4], "ja": "私の家族は、私書箱を一つだけ使ってきた" },
    { "t": [21.4, 23.3], "ja": "何世代にもわたってな" },
    { "t": [23.3, 25.6], "ja": "購読した雑誌は、二つだけ" },
    { "t": [25.6, 28.5], "ja": "「リーダーズ・ダイジェスト」と「エボニー」だ" },
    { "t": [28.5, 30.6], "ja": "エボニーは事務の手違いだったが" },
    { "t": [30.6, 33.7], "ja": "結果的に、なかなか面白い一年の読書になった" },
    { "t": [33.7, 35.4], "ja": "これがどうやって届いたのか分からないが" },
    { "t": [35.4, 37.2], "ja": "二度とあってはならない" },
    { "t": [37.2, 38.6], "ja": "どうすれば止められる？" },
    { "t": [38.6, 40.9], "ja": "うーん。こういうのはドナが得意だよ" },
    { "t": [40.9, 43], "ja": "ウィリアムズ・ソノマ（キッチン用品店）のダイレクトメールを止めてくれたんだ" },
    { "t": [43, 44.6], "ja": "でも、僕がまた自分で登録しちゃった" },
    { "t": [44.6, 45.9], "ja": "あそこの鍋つかみにはまってるんだ" },
    { "t": [45.9, 47.4], "ja": "あの鍋つかみを手に入れたい！" },
    { "t": [47.4, 49.2], "ja": "ドナが戻ったらすぐに知らせてくれ" },
    { "t": [49.2, 50.4], "ja": "彼女のツイッターによると" },
    { "t": [50.4, 52.1], "ja": "5分前にコーヒーを買ったって" },
    { "t": [52.1, 54.2], "ja": "待って、今、戻ってくるところを生配信してる" },
    { "t": [54.2, 55.9], "ja": "もうすぐここに来るはず…" },
    { "t": [55.9, 58.9], "ja": "3、2、1…" },
    { "t": [58.9, 60.9], "ja": "やあ、やあ！やあ、やあ！" },
    { "t": [60.9, 63.9], "ja": "ハッシュタグ、コーヒー探しの旅で、タイムラインが大盛り上がりよ" },
    { "t": [63.9, 65.1], "ja": "それについてのスナップチャット、見た？" },
    { "t": [65.1, 67.2], "ja": "いや。何それ？" },
    { "t": [67.2, 68.9], "ja": "ほら、来た" },
    { "t": [71, 73.8], "ja": "人には、放っておいてもらう権利があるべきだ" },
    { "t": [73.8, 76], "ja": "私は世の中から完全に姿を消したい" },
    { "t": [76, 78.7], "ja": "そんなのありえない。私はネットが生きがいなの" },
    { "t": [78.7, 80.8], "ja": "私の遊び相手の4割は、そこで見つけてるんだから" },
    { "t": [80.8, 82.1], "ja": "それに、ネットから消えたら" },
    { "t": [82.1, 83.8], "ja": "どうやって投稿するの？イケてる料理の写真とか" },
    { "t": [83.8, 84.7], "ja": "行ったレストランで撮ったやつ" },
    { "t": [84.7, 86.1], "ja": "それに、自慢して回ってるかっこいい場所の写真は？" },
    { "t": [86.1, 87.6], "ja": "食べ物は食べるためのもの" },
    { "t": [87.6, 89.1], "ja": "場所はいるためのものだ" },
    { "t": [89.1, 90.1], "ja": "話は以上" },
    { "t": [90.1, 91], "ja": "ネットから消えないで、ロン" },
    { "t": [91, 91.8], "ja": "ネットは最高だよ" },
    { "t": [91.8, 94.5], "ja": "むしろ、もっとネットにつながるべきよ" },
    { "t": [94.5, 97.2], "ja": "ネット！ネット！ネット！ネット！ネット！ネット！ネット！ネット！" },
    { "t": [97.2, 98.4], "ja": "私が消えるのを手伝ってくれたら" },
    { "t": [98.4, 100.9], "ja": "二人とも早く帰っていいぞ" },
    { "t": [100.9, 105.1], "ja": "ネット反対！ネット反対！ネット反対！ネット反対！ネット反対！" },
    { "t": [105.1, 107.3], "ja": "ポール、もしまた私の名前が書かれた" },
    { "t": [107.3, 108.1], "ja": "こういうのを見つけたら" },
    { "t": [108.1, 110.1], "ja": "森まで車で行って、埋めてほしい" },
    { "t": [110.1, 112.1], "ja": "誰に郵便を届けるかは、私が決めることじゃありません" },
    { "t": [112.1, 113.1], "ja": "届けるだけです" },
    { "t": [113.1, 114.7], "ja": "責任逃れだな" },
    { "t": [114.7, 117.8], "ja": "弱虫で腹黒い人間の最後の逃げ場だ" },
    { "t": [117.8, 118.8], "ja": "それはちょっときついですよ" },
    { "t": [118.8, 120.1], "ja": "出ていけ" },
    { "t": [120.1, 121.9], "ja": "携帯電話は処分したよ" },
    { "t": [121.9, 124.1], "ja": "これが最後のクレジットカード" },
    { "t": [124.1, 126.6], "ja": "本当にこのカードを切っちゃっていいの？" },
    { "t": [126.6, 128.1], "ja": "駐車場に入るのにも使うのに" },
    { "t": [128.1, 129.6], "ja": "これからはバスに乗る" },
    { "t": [129.6, 131.5], "ja": "支払いは現金にする" },
    { "t": [131.5, 134.4], "ja": "世の中に、私の痕跡はほかに何が残っている？" },
    { "t": [134.4, 135.6], "ja": "考えろ、みんな" },
    { "t": [135.6, 137.4], "ja": "ジェイジェイのダイナーに、あなたの写真がなかった？" },
    { "t": [137.4, 138.1], "ja": "あの時の…" },
    { "t": [138.1, 140.1], "ja": "おい！やめろ、トム！" },
    { "t": [140.1, 142.1], "ja": "ジェイジェイ、何か月か前に" },
    { "t": [142.1, 144.7], "ja": "私はここに来て、卵を食べ始めた" },
    { "t": [144.7, 146.6], "ja": "おいしかったので、もっと注文した" },
    { "t": [146.6, 148.3], "ja": "気づけば、確か私は…" },
    { "t": [148.3, 150.6], "ja": "20分で卵51個" },
    { "t": [150.6, 151.9], "ja": "焼くのが追いつかなかった" },
    { "t": [151.9, 153.4], "ja": "最後の10個は、まだからがついてたよ" },
    { "t": [153.4, 155.3], "ja": "ジェイジェイのダイナーの記録だったの" },
    { "t": [155.3, 156.5], "ja": "それであなたが彼の写真を撮ったの" },
    { "t": [156.5, 159.5], "ja": "今、プライバシーのためにその写真が必要なの" },
    { "t": [159.5, 161.7], "ja": "いいけど、誰にも分からないと思うよ" },
    { "t": [161.7, 163.3], "ja": "それがあなただなんて" },
    { "t": [163.3, 166.9], "ja": "言われた通りにしたんだから" },
    { "t": [166.9, 169.9], "ja": "それでも情報が多すぎる" },
    { "t": [169.9, 170.9], "ja": "行くぞ" },
    { "t": [170.9, 171.9], "ja": "今度はどこに行くの？" },
    { "t": [171.9, 175.9], "ja": "私はたくさんの食べ物を、たくさんのレストランで食べてきた" },
    { "t": [175.9, 179.2], "ja": "なぜほかのみんなは、食べるのがこんなに下手なんだ？" },
    { "t": [179.2, 182], "ja": "よし、私の写った写真は全部回収した" },
    { "t": [182, 184.6], "ja": "オフィスのドアの名札も外した" },
    { "t": [184.6, 189.1], "ja": "小児科のカルテも没収して処分した" },
    { "t": [189.1, 190.3], "ja": "何か抜けていることは？" },
    { "t": [190.3, 191.2], "ja": "いい知らせだよ、ロン" },
    { "t": [191.2, 192.8], "ja": "ジャン＝ラルフィオが、あなたのシャツを気に入ってる" },
    { "t": [192.8, 194.3], "ja": "いったい何の話だ？" },
    { "t": [194.3, 195.8], "ja": "ああ、一日中あなたの写真を撮ってたんだ" },
    { "t": [195.8, 197.2], "ja": "新しいフェイスブックのアルバム用にね" },
    { "t": [197.2, 200.4], "ja": "「ロン・スワン、ネットから消える」" },
    { "t": [200.4, 203.3], "ja": "トム、自分がしたことに" },
    { "t": [203.3, 205.5], "ja": "何か問題があると思わないか？" },
    { "t": [207.6, 210.6], "ja": "今は思うよ、うん。ごめん" },
    { "t": [210.6, 212.9], "ja": "消せ" },
    { "t": [212.9, 214.2], "ja": "消せ" },
    { "t": [214.2, 215.5], "ja": "消せ" },
    { "t": [223.7, 225.3], "ja": "いったい何が起きてるんだ？" },
    { "t": [225.3, 227.4], "ja": "うっかりヴァインを開いちゃったんだよ" },
    { "t": [227.4, 229.2], "ja": "今、初めての自撮り動画をヴァインに上げちゃったね、ロン" },
    { "t": [229.2, 230.2], "ja": "で、僕はあなたをヴァインで撮ってる" },
    { "t": [230.2, 231.3], "ja": "自撮りをヴァインに" },
    { "t": [231.3, 234], "ja": "世の中は悪夢だ" },
    { "t": [234, 236.1], "ja": "（無音）" },
    { "t": [236.1, 237.6], "ja": "待って、待って、待って、待って" },
    { "t": [237.6, 240.2], "ja": "ロンの写真を全部消して！" },
    { "t": [240.2, 242.8], "ja": "ロンの写真を全部消して！" },
    { "t": [242.8, 244.5], "ja": "問題はこれだ" },
    { "t": [244.5, 246.4], "ja": "一定の量の金をやろう" },
    { "t": [246.4, 248.7], "ja": "キャンピングカーと引き換えにな" },
    { "t": [248.7, 251.1], "ja": "保険のために、住所はまだ必要ですよ" },
    { "t": [251.1, 253], "ja": "ここが私の新しい家だ" },
    { "t": [253, 256.8], "ja": "住所は、どこであれ止めてある場所だ" },
    { "t": [256.8, 258.8], "ja": "どこにいたの？" },
    { "t": [258.8, 260], "ja": "タイヤがパンクして" },
    { "t": [260, 262.4], "ja": "何時間もあなたに連絡を取ろうとしてたの" },
    { "t": [262.4, 263.6], "ja": "すまない、ダーリン" },
    { "t": [263.6, 266.3], "ja": "自分の持ち物のほとんどを処分したり" },
    { "t": [266.3, 269.1], "ja": "郵便局員を脅したりするのに忙しかったんだ" },
    { "t": [269.1, 270.9], "ja": "ロン、あなたがプライバシーを大事にしてるのは分かってる" },
    { "t": [270.9, 272.9], "ja": "でも、今のあなたは夫で父親なの" },
    { "t": [272.9, 274.9], "ja": "キャンピングカーで町をさまよって" },
    { "t": [274.9, 276.8], "ja": "誰にも見つからないなんて、だめよ" },
    { "t": [276.8, 278.8], "ja": "私は世の中から消えるという任務の途中なんだ" },
    { "t": [278.8, 280.6], "ja": "あのね、完全につながってなくてもいい" },
    { "t": [280.6, 283], "ja": "でも、私たちとはつながっていてほしいの" },
    { "t": [283, 286.6], "ja": "引っ越しは考えてくれないだろうな" },
    { "t": [286.6, 287.9], "ja": "聞いたところでは、学校も" },
    { "t": [287.9, 291.2], "ja": "ユッカ・マウンテンの地下トンネルも、まあまあらしい" },
    { "t": [291.2, 293.1], "ja": "愛してる。でも、あなたはどんな問題も" },
    { "t": [293.1, 295.1], "ja": "山の中に住めば解決すると思ってる" },
    { "t": [295.1, 297.2], "ja": "私も愛してる" },
    { "t": [297.2, 307.7], "ja": "（音楽）" }
  ]
}
