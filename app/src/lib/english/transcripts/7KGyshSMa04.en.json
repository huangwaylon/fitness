7,149],"en":"Yeah, complicated 'cause of the love."},{"t":[149,150],"en":"I..."},{"t":[150,151],"en":"I didn't..."},{"t":[151,153],"en":"I do not love Rachel."},{"t":[153,155],"en":"I'm gonna tell her right now about the whole thing,"},{"t":[155,158],"en":"so we can get this marriage annulled as fast as possible."},{"t":[158,159],"en":"Okay?"},{"t":[159,160],"en":"Would I do that if I loved her?"},{"t":[160,163],"en":"I've never been more convinced of your love for her."},{"t":[164,168],"en":"I do not have feelings for Rachel, okay?"},{"t":[171,172],"en":"Oh, what's wrong?"},{"t":[172,179],"en":"Monica and Chandler are really moving in here and I have to move out and everything is changing."},{"t":[179,180],"en":"Oh, my..."},{"t":[180,181],"en":"Oh, come here."},{"t":[181,182],"en":"Come here."},{"t":[182,183],"en":"It's okay."},{"t":[183,186],"en":"Oh, everything's gonna be okay."},{"t":[186,187],"en":"Thank you."},{"t":[187,188.5],"en":"Of course."}]}
