{
  "video": "7Bq_mRcIWso",
  "lines": [
    { "t": [0, 3], "ja": "「アイカーリー」には、かなり奇妙な回がいくつかある" },
    { "t": [3.1, 4.5], "ja": "僕とダチョウは結婚するんだ" },
    { "t": [6.7, 8.9], "ja": "おそろいのネクタイをしてるよ" },
    { "t": [9, 12.4], "ja": "でも一番奇妙な回のひとつが「アイクリスマス」" },
    { "t": [12.5, 16.7], "ja": "カーリーがスペンサーに普通になってほしいと願い、すべてが変わる回だ" },
    { "t": [16.8, 20.8], "ja": "「アイクリスマス」の奇妙な場面ベスト5を見てみよう" },
    { "t": [20.9, 24.1], "ja": "始まりは、クリスマスツリーの思わぬ火事のあと" },
    { "t": [24.2, 25.9], "ja": "カーリーはスペンサーが普通だったらと願い" },
    { "t": [26, 28.9], "ja": "その願いを守護天使がかなえる" },
    { "t": [29, 30.2], "ja": "俺の名前はミッチだ" },
    { "t": [31.7, 34.3], "ja": "おっと、ずいぶんびくびくしてるな" },
    { "t": [36.2, 39.1], "ja": "出ていかないと警察を呼ぶわよ" },
    { "t": [39.2, 42.6], "ja": "おいおい、自分のクリスマスの天使に警察を呼ぶなよ" },
    { "t": [42.7, 44.8], "ja": "彼が天使だとは信じがたい" },
    { "t": [44.9, 47], "ja": "見た目がかなり荒っぽいからね" },
    { "t": [47.1, 48.9], "ja": "でも魔法のようなカードの手品のあと…" },
    { "t": [49, 49.9], "ja": "カードを1枚引いて" },
    { "t": [53.6, 55.3], "ja": "クラブのキング" },
    { "t": [55.4, 57.9], "ja": "カードの手品なんて誰でもできるでしょ？" },
    { "t": [58, 59.6], "ja": "彼を見て" },
    { "t": [61.7, 63], "ja": "冗談じゃないんだ" },
    { "t": [63.1, 64.3], "ja": "本当に天使なんだ" },
    { "t": [67.2, 70.8], "ja": "カーリーは彼を信じ、事態は本当に奇妙になっていく" },
    { "t": [73.2, 74.4], "ja": "今、何が起きたの？" },
    { "t": [74.5, 75.8], "ja": "彼は普通に生まれたんだ" },
    { "t": [75.9, 80.5], "ja": "あなた…あなた、頭がおかしいのよ" },
    { "t": [80.6, 85.9], "ja": "カーリーが下に行くと、何もかも普通。スペンサーもだ" },
    { "t": [86, 87.8], "ja": "胃薬を持ってきたわよ" },
    { "t": [87.9, 89.2], "ja": "ああ、ありがとう" },
    { "t": [89.3, 92.3], "ja": "会社のストレスで、本当に胃の調子が悪くてね" },
    { "t": [96.1, 98.1], "ja": "スペンサーは普通に生まれた。君が願った通りにね" },
    { "t": [98.2, 101.4], "ja": "カーリー、大丈夫？" },
    { "t": [101.5, 102.8], "ja": "なんで叫んだんだ？" },
    { "t": [102.9, 103.6], "ja": "何かおかしいの" },
    { "t": [103.7, 104.8], "ja": "ああ、何かがおかしい" },
    { "t": [104.9, 106.8], "ja": "この変な男が…" },
    { "t": [106.9, 108.8], "ja": "変な男って？" },
    { "t": [108.9, 110.8], "ja": "怖い小説でも読んでたの？" },
    { "t": [112.1, 113.9], "ja": "いいえ、小説なんて読んでないわ" },
    { "t": [114, 114.8], "ja": "あら、私は読んでたわ" },
    { "t": [114.9, 118.1], "ja": "1700年代に農民のためにパンを焼くパン屋の話なの" },
    { "t": [118.2, 119.8], "ja": "あの本、大好きだよ" },
    { "t": [119.9, 120.9], "ja": "すてきな読み物だよね" },
    { "t": [121, 125], "ja": "でも一番奇妙なのは、そう、あれだ" },
    { "t": [125.1, 128], "ja": "うわ、気味が悪すぎる" },
    { "t": [128.1, 130.9], "ja": "この別の世界で変わったカップルは" },
    { "t": [131, 132.7], "ja": "スペンサーとベンソンさんだけじゃない" },
    { "t": [132.8, 136.4], "ja": "フレディにも新しい彼女ができている。ロナ・バーガーだ" },
    { "t": [136.5, 139.5], "ja": "なんでフレディがロナ・バーガーと手をつないでるの？" },
    { "t": [139.6, 141.4], "ja": "ロナ・バーガーはフレディの彼女だよ" },
    { "t": [141.5, 142.2], "ja": "え？" },
    { "t": [142.3, 143.4], "ja": "違うわ" },
    { "t": [143.5, 145.2], "ja": "彼はロナ・バーガーが大嫌いなのよ" },
    { "t": [145.3, 147.4], "ja": "みんなロナ・バーガーが大嫌いなの" },
    { "t": [147.5, 150.8], "ja": "カーリーにさえ、あまり特別じゃない相手がいる" },
    { "t": [150.9, 151.7], "ja": "ネビル？" },
    { "t": [152.8, 154.5], "ja": "ネビル・パパーマン？" },
    { "t": [154.6, 157.5], "ja": "そう、それが間違いなく一番奇妙な部分だ" },
    { "t": [160.9, 162.9], "ja": "スペンサーが普通に生まれたせいで" },
    { "t": [163, 166.5], "ja": "「アイカーリー」もなく、友情もない" },
    { "t": [166.6, 167.5], "ja": "サムとのね" },
    { "t": [167.6, 170.6], "ja": "サムのことは忘れたほうがいい" },
    { "t": [170.7, 172.5], "ja": "なんで？" },
    { "t": [172.6, 173.8], "ja": "なんで？" },
    { "t": [173.9, 174.9], "ja": "彼女は君のことをほとんど知らないんだ" },
    { "t": [175, 175.8], "ja": "うそよ" },
    { "t": [175.9, 178.1], "ja": "スペンサーは彼女を悪い子だと思っていた" },
    { "t": [178.2, 180.2], "ja": "小さいころ、彼女と遊ばせてくれなかったんだ" },
    { "t": [180.3, 181.9], "ja": "だから君とサムは友だちにならなかった" },
    { "t": [182, 182.7], "ja": "頭がおかしいわ" },
    { "t": [182.8, 184.5], "ja": "サムは私の親友よ" },
    { "t": [184.6, 186.3], "ja": "毎週一緒に「アイカーリー」をやってるの" },
    { "t": [186.4, 187.9], "ja": "「アイカーリー」なんてないよ" },
    { "t": [188, 189.2], "ja": "サムはどこ？" },
    { "t": [189.3, 191.9], "ja": "サムが少年院に入っていたのは驚くことではない" },
    { "t": [192, 195.6], "ja": "でも、あの名コンビのいない世界は想像しにくい" },
    { "t": [195.7, 198.4], "ja": "私のせいであなたがここにいるの。警察を呼んだのはお前か？" },
    { "t": [199.8, 201.6], "ja": "おい、ここを出たら絶対に…だめ！" },
    { "t": [201.7, 203.9], "ja": "あなたがここにいるのは、私がスペンサーに普通になってほしいって願ったからなの" },
    { "t": [204.5, 205.5], "ja": "スペンサーって誰？" },
    { "t": [205.6, 206.7], "ja": "私の兄よ" },
    { "t": [207.1, 208.5], "ja": "磁石のツリーを作って、それが燃えて…" },
    { "t": [208.6, 210.8], "ja": "おい、あんたのことほとんど知らないんだけど。よく知ってるわよ" },
    { "t": [210.9, 213.5], "ja": "私がばかな願いをするまで、親友だったのよ" },
    { "t": [213.6, 217.7], "ja": "最後の場面は、史上最も奇妙なクリスマスパーティー" },
    { "t": [217.8, 220.1], "ja": "そこでかなり衝撃的な知らせがわかる" },
    { "t": [221.5, 222.6], "ja": "何ですって？" },
    { "t": [222.7, 224.6], "ja": "スペンサーと私、結婚するの" },
    { "t": [224.7, 225.7], "ja": "ええっ！" },
    { "t": [225.8, 227.6], "ja": "そう、これがカーリーにとって我慢の限界だった" },
    { "t": [227.7, 230.8], "ja": "そして彼女は、すべてが元に戻るように願った" },
    { "t": [230.9, 235.7], "ja": "もう、いいかげんにして！カー…痛い、腕が！" },
    { "t": [238.2, 239.8], "ja": "スパゲッティ・タコスを作って！" },
    { "t": [239.9, 243.1], "ja": "え？夕食は白身魚の蒸し物だよ" },
    { "t": [244.5, 246.7], "ja": "蒸した魚なんて嫌いでしょ、退屈だから" },
    { "t": [246.8, 248.8], "ja": "お兄ちゃんはスパゲッティ・タコスを作るのが好きなの" },
    { "t": [248.9, 250.9], "ja": "それに作るときは、ちょっとした歌を歌うのよ" },
    { "t": [251, 253.8], "ja": "カーリー、歌を歌うのは教会でだけだよ" },
    { "t": [253.9, 257.6], "ja": "ああ！妹さん、どうしちゃったの？" },
    { "t": [257.7, 259.9], "ja": "私はただの妹じゃない、あなたの友だちよ！" },
    { "t": [260, 261.5], "ja": "カーリー、落ち着いたほうがいいよ" },
    { "t": [261.6, 263], "ja": "落ち着きたくなんかない！" },
    { "t": [263.1, 265], "ja": "頭おかしい。聞こえたわよ、ロナ！" },
    { "t": [266.8, 268.4], "ja": "痛み止めを持ってこようか？" },
    { "t": [268.5, 269.3], "ja": "いらない！" },
    { "t": [270.3, 271.8], "ja": "元のお兄ちゃんに戻ってほしいだけ！" },
    { "t": [271.9, 274], "ja": "本来のお兄ちゃんでいてほしいの！" },
    { "t": [274.1, 276.7], "ja": "幸い、彼女はこの現実に戻ってくることができ" },
    { "t": [276.8, 278.8], "ja": "すべてが普通に戻った" },
    { "t": [279.1, 281.2], "ja": "いや…普通じゃない状態にかな？" },
    { "t": [281.8, 282.9], "ja": "会いたかった" },
    { "t": [283.9, 285.3], "ja": "それに家も元に戻った！" },
    { "t": [286.8, 288.5], "ja": "えっと、何のことかさっぱり…" },
    { "t": [288.6, 290.2], "ja": "ねえ、スペンサー、そのツリーを" },
    { "t": [290.3, 291.6], "ja": "ゴミ置き場に運ぶの手伝おうか？" },
    { "t": [291.7, 293.1], "ja": "ああ、ちょっと詰めこむのを手伝って…" },
    { "t": [293.2, 294.2], "ja": "だめ！" },
    { "t": [294.3, 296.3], "ja": "誰もこのツリーに触らないで！" },
    { "t": [297.5, 299.5], "ja": "嫌いだと思ってた。嫌いじゃないわ！" },
    { "t": [299.8, 301.3], "ja": "今まで一番好きなツリーよ！" },
    { "t": [301.7, 303.9], "ja": "あなたが一番好きな奇妙な場面はどれ？" },
    { "t": [304.3, 305.6], "ja": "コメントで教えてね" }
  ]
}
