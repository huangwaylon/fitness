{
  "video": "SYeO3N2gvmY",
  "lines": [
    { "t": [0,  3.1], "ja": "どうも、ロン・スワンソンだ" },
    { "t": [3.1,  6], "ja": "普段は、人と話さないようにしているんだが" },
    { "t": [6,  8.6], "ja": "この「スネークジュース」とかいうのを飲んでいて" },
    { "t": [8.6,  9.9], "ja": "これがめちゃくちゃうまい" },
    { "t": [9.9,  11.3], "ja": "買うべきだ" },
    { "t": [11.3,  13.2], "ja": "ああ、うん。どうも" },
    { "t": [13.2,  15.7], "ja": "いいか、私のおすすめは" },
    { "t": [15.7,  17.8], "ja": "ほぼ保証付きだと思っていい" },
    { "t": [17.8,  20.1], "ja": "これを飲め、今すぐ" },
    { "t": [20.1,  22.2], "ja": "くねくね、くねくね" },
    { "t": [22.2,  25.3], "ja": "ドランカーマイスター、来てくれたんだ" },
    { "t": [25.3,  27.2], "ja": "ああ、メールをもらったよ" },
    { "t": [27.2,  28.4], "ja": "話がある" },
    { "t": [28.4,  31.5], "ja": "でもまずは、スネークジュースをちょっと飲んでみて" },
    { "t": [31.5,  34.9], "ja": "140プルーフ、つまりアルコール70％" },
    { "t": [34.9,  36.5], "ja": "でも心配いらない、カフェインもたっぷり入ってるから" },
    { "t": [36.5,  37.5], "ja": "眠くならないよ" },
    { "t": [37.5,  41.4], "ja": "1オンスでも飲んだら、文字どおり死ぬと思う" },
    { "t": [41.4,  44.1], "ja": "市役所の全員にメールして" },
    { "t": [44.1,  47.1], "ja": "君が経営するクラブに来るよう言ったね" },
    { "t": [47.1,  49.5], "ja": "君が発明したお酒を買いに" },
    { "t": [49.5,  52.4], "ja": "公務員は、自分の権力を使って" },
    { "t": [52.4,  54.3], "ja": "私腹を肥やしてはいけないんだ" },
    { "t": [54.3,  55.7], "ja": "言いたいことは完全に分かるよ、クリス" },
    { "t": [55.7,  56.8], "ja": "二度とやらない" },
    { "t": [56.8,  58.7], "ja": "どうしても避けられないと思う" },
    { "t": [58.7,  60.7], "ja": "スネークホールの株は売ってもらうしかない" },
    { "t": [60.7,  61.8], "ja": "いやだ！" },
    { "t": [61.8,  63.3], "ja": "ティー・ペイン、こいつに絡まれてるのか？" },
    { "t": [63.3,  64.8], "ja": "俺の上司なんだ" },
    { "t": [64.8,  65.9], "ja": "そうか、なるほど" },
    { "t": [65.9,  67.2], "ja": "お前の名前でラップを作ってやろうか？" },
    { "t": [67.2,  67.9], "ja": "ああ" },
    { "t": [67.9,  70.2], "ja": "ゴー、ビー、オー、ダブル・エス" },
    { "t": [70.2,  72.6], "ja": "彼の言うとおりにすれば、成功するぜ" },
    { "t": [74.6,  76.8], "ja": "悪いけど、私のペースが速すぎると思うのは" },
    { "t": [76.8,  78.3], "ja": "あなたがベンとのことで遅すぎるからじゃない？" },
    { "t": [78.3,  79.7], "ja": "悪いけど、私がゆっくりなのは" },
    { "t": [79.7,  80.9], "ja": "仕事を失うかもしれないからよ" },
    { "t": [80.9,  83.3], "ja": "はいはい、悪いけど、それって少し言い訳なんじゃない？" },
    { "t": [83.3,  84.6], "ja": "自分の気持ちに素直に動かないことの" },
    { "t": [84.6,  86.1], "ja": "悪いけど、あなたが持ってたなんて覚えてないわ" },
    { "t": [86.1,  87.9], "ja": "気持ちの看護学位なんて" },
    { "t": [87.9,  88.5], "ja": "気を悪くしたわ" },
    { "t": [88.5,  89.7], "ja": "失礼ね" },
    { "t": [89.7,  91.2], "ja": "踊ってくる" },
    { "t": [91.2,  91.9], "ja": "（ろれつが回らない）" },
    { "t": [91.9,  94.4], "ja": "おお、いいね" },
    { "t": [94.4,  95.6], "ja": "ねえ、大丈夫？" },
    { "t": [95.6,  96.6], "ja": "大声が聞こえたけど" },
    { "t": [96.6,  98.4], "ja": "ええ、すごく怒ってるし、すごく酔ってる" },
    { "t": [98.4,  99.3], "ja": "一緒に踊る？" },
    { "t": [99.3,  100.7], "ja": "スネークジュースをもう1杯持ってきて" },
    { "t": [100.7,  103.3], "ja": "あー、それはあまりいい考えじゃないかも" },
    { "t": [103.3,  104.2], "ja": "もういい" },
    { "t": [104.2,  105.2], "ja": "ジャン・ラルフィオ！" },
    { "t": [105.2,  105.7], "ja": "はい、ここにいるよ" },
    { "t": [105.7,  106.4], "ja": "私のそばで踊って" },
    { "t": [106.4,  107], "ja": "いいね" },
    { "t": [107,  107.5], "ja": "いいね" },
    { "t": [107.5,  111.7], "ja": "アンとの初めてのケンカ。しかも、とびきりのやつ" },
    { "t": [111.7,  115], "ja": "でも、友だち同士の正直な話し合いは" },
    { "t": [115,  116.7], "ja": "深い友情につながると思うの" },
    { "t": [116.7,  118.6], "ja": "これは私たちの関係の転機" },
    { "t": [118.6,  120.7], "ja": "正々堂々とケンカすることが大事" },
    { "t": [120.7,  124.2], "ja": "集中して、落ち着いていればいいのよ" },
    { "t": [124.2,  128], "ja": "あなたはばかで、嫌なやつで、ばかよ" },
    { "t": [128,  130.6], "ja": "これがどうして私のせいなのか分からない" },
    { "t": [130.6,  133.1], "ja": "違う、いつも何でもあなたのせいってわけじゃない" },
    { "t": [133.1,  135], "ja": "いつも何でも自分のせいにしないで" },
    { "t": [135,  136.2], "ja": "全部私のせいじゃない" },
    { "t": [136.2,  137.8], "ja": "私はばかで嫌なやつじゃない" },
    { "t": [137.8,  139.9], "ja": "今あなたにばかなことしてるのは、私じゃないし" },
    { "t": [139.9,  140.8], "ja": "そういう意味じゃなかったの" },
    { "t": [140.8,  141.9], "ja": "いや、そういう意味じゃなかった" },
    { "t": [141.9,  143.2], "ja": "ただ、あなたがばかだったってこと" },
    { "t": [143.2,  144.5], "ja": "それに、嫌なやつみたいに振る舞ってた" },
    { "t": [144.5,  147.4], "ja": "ねえ、あなたにあの仕事を考えたのは悪かったわ、いい？" },
    { "t": [147.4,  149.9], "ja": "でも時々、私が正しい方向に押してあげないと" },
    { "t": [149.9,  151.8], "ja": "あなたは立ち止まったままになっちゃう" },
    { "t": [151.8,  153.2], "ja": "ただ、力になろうとしただけなの" },
    { "t": [153.2,  156.2], "ja": "もう、あなたの「力になる」はたくさん、いい？" },
    { "t": [156.2,  156.7], "ja": "やめて！" },
    { "t": [161.7,  164.6], "ja": "なら、一緒に働かないほうがいいのかもね" },
    { "t": [164.6,  166.2], "ja": "いっそのこと…" },
    { "t": [166.2,  174.3], "ja": "デトックスするたびに、毒素が体から出ていくのが本当に感じられるんだ" },
    { "t": [174.3,  174.9], "ja": "だよね！" },
    { "t": [174.9,  176.8], "ja": "すごく健康になった気がする" },
    { "t": [176.8,  179.4], "ja": "スープ段階まで、まだまる1週間あるよ" },
    { "t": [179.4,  180.5], "ja": "うーん！" },
    { "t": [180.5,  183.2], "ja": "スープ前の段階は最高だよ" },
    { "t": [183.2,  184.3], "ja": "一番頭がさえてる時期なんだ" },
    { "t": [184.3,  185.4], "ja": "よかった" },
    { "t": [185.4,  187.2], "ja": "今夜は誰かが、頭をさえさせておかないと" },
    { "t": [187.2,  190.4], "ja": "このスネークジュースは、ほぼネズミ駆除の毒だ" },
    { "t": [190.4,  191.3], "ja": "みんな、べろべろだ" },
    { "t": [191.3,  194.1], "ja": "お前、何も分かってない。何のことかも言ってないのに" },
    { "t": [194.1,  196.8], "ja": "彼女に全部聞かれたけど、一回もやらなかった" },
    { "t": [196.8,  198.9], "ja": "俺はゾウみたいなもんだ、いい？" },
    { "t": [198.9,  203.4], "ja": "部屋に入ると、「ああ、あいつがいるな」って感じ" },
    { "t": [203.4,  206.7], "ja": "俺は、バ・バ・バ・ボーイって感じ" },
    { "t": [206.7,  208.8], "ja": "音楽を下げろ" },
    { "t": [208.8,  213.2], "ja": "ブンブン、うんち、愛、そういうやつ" },
    { "t": [213.2,  223.2], "ja": "これで全員？" },
    { "t": [223.2,  224.2], "ja": "アンはタクシーで帰った" },
    { "t": [224.2,  226.2], "ja": "トムはトランクに、ジェリーは屋根の上だ" },
    { "t": [226.2,  227.7], "ja": "よし、まずはどこへ？" },
    { "t": [227.7,  229.6], "ja": "お前の母ちゃんのケツ" },
    { "t": [229.6,  231.3], "ja": "すごく孤独" },
    { "t": [231.3,  233.7], "ja": "一人でも、俺の車で吐きそうになったら" },
    { "t": [233.7,  236.1], "ja": "全員歩いて帰ってもらうぞ" },
    { "t": [236.1,  237.1], "ja": "レスリー" },
    { "t": [237.1,  239.7], "ja": "ここにいるわ" },
    { "t": [239.7,  243.1], "ja": "保健局の新しい広報部長を雇いに行かないと" },
    { "t": [243.1,  245.7], "ja": "うそ、ひどい二日酔い" },
    { "t": [245.7,  248.4], "ja": "うそ、ひどい二日酔い" },
    { "t": [248.4,  251], "ja": "うそ、ひどい二日酔い" },
    { "t": [251,  253.9], "ja": "うそ、ひどい二日酔い" },
    { "t": [253.9,  256.8], "ja": "こんなにひどい二日酔いは初めて" },
    { "t": [256.8,  259.1], "ja": "気分は最高。今朝5キロ走ったんだ" },
    { "t": [259.1,  259.8], "ja": "本当？" },
    { "t": [259.8,  261.6], "ja": "いや、シャワーで吐いた" }
  ]
}
