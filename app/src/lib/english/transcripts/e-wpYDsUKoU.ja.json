{
  "video": "e-wpYDsUKoU",
  "lines": [
    { "t": [1, 3.6], "ja": "よし、管理人は留守だけど、ねえ、いいかい？" },
    { "t": [3.6, 5.6], "ja": "母さんがもうすぐ来るし、かぎを持ってるんだ" },
    { "t": [5.6, 8.8], "ja": "そんなに待てない。何とかして。ドアを壊して！" },
    { "t": [8.8, 10.8], "ja": "そうしたいけど、僕は桃みたいにすぐあざになるんだ" },
    { "t": [13.7, 17.4], "ja": "それに、ほら、大丈夫だって。赤ちゃんは寝てるよ" },
    { "t": [17.4, 19.3], "ja": "もしベビーベッドから飛び出してたら？" },
    { "t": [19.3, 21.9], "ja": "自分の頭も支えられないのに、そうだね、飛び出すよね" },
    { "t": [23.2, 25.2], "ja": "どうしよう！水を出しっぱなしにしちゃった！" },
    { "t": [25.2, 26.9], "ja": "いや、出しっぱなしになんかしてないって" },
    { "t": [26.9, 28.9], "ja": "頼むから、しっかりして、ね？" },
    { "t": [28.9, 30.3], "ja": "待って、コンロをつけっぱなしにした？" },
    { "t": [30.3, 32.8], "ja": "君は1996年から料理してないだろ" },
    { "t": [34.1, 35.9], "ja": "窓は開いてる？だって窓が開いてたら" },
    { "t": [35.9, 37.5], "ja": "鳥が入ってくるかもしれないし…" },
    { "t": [37.5, 39.2], "ja": "うわ、そうだね、君の言う通りかも" },
    { "t": [39.2, 41], "ja": "たぶん、ほら、待って、聞いて、聞いて" },
    { "t": [41, 44.3], "ja": "ハトが。いや、いや、待って、違う" },
    { "t": [44.3, 45.7], "ja": "ワシが飛び込んできた！" },
    { "t": [47, 49.8], "ja": "コンロにとまって火がついた！" },
    { "t": [51.8, 56], "ja": "それを見た赤ちゃんは、部屋を飛び越えて" },
    { "t": [56, 57.8], "ja": "強い鳥を助けに行く" },
    { "t": [57.8, 60.1], "ja": "ところがワシはそれを" },
    { "t": [60.1, 61.2], "ja": "攻撃だと勘違いして" },
    { "t": [61.2, 63.1], "ja": "赤ちゃんをかぎづめでつかむ" },
    { "t": [63.1, 65.9], "ja": "その間に、蛇口から出た水が部屋を満たしていく" },
    { "t": [66.6, 68.6], "ja": "赤ちゃんと鳥は、まだ燃えたまま" },
    { "t": [68.6, 70.1], "ja": "死にもの狂いで組み合ったまま" },
    { "t": [70.1, 71.9], "ja": "渦の中をぐるぐる回る" },
    { "t": [71.9, 73.5], "ja": "部屋いっぱいの渦の中をね" },
    { "t": [76.7, 78.5], "ja": "もし本当だったら、すっごく後悔するからね" },
