{
  "video": "_Tk0dR70XSE",
  "lines": [
    { "t": [0,1.5], "ja": "これから母に会いに行くの" },
    { "t": [1.5,4.1], "ja": "母は郡の学校制度のお偉いさんなの" },
    { "t": [4.1,5.4], "ja": "私のヒーローよ" },
    { "t": [5.4,6.4], "ja": "どう説明すればいいかな" },
    { "t": [6.4,10], "ja": "マザー・テレサのように尊敬されていて" },
    { "t": [10,12], "ja": "スターリンのように力があって" },
    { "t": [12,14.1], "ja": "マーガレット・サッチャーのように美しいの" },
    { "t": [15.2,16.2], "ja": "入るか出るか、どっちかにして、レスリー" },
    { "t": [16.2,17.4], "ja": "戸口に立たれると気味が悪いわ" },
    { "t": [17.4,18.2], "ja": "そうね、ごめん" },
    { "t": [18.2,19.8], "ja": "入るほうにする" },
    { "t": [19.8,21.7], "ja": "で、何の用なの、レスリー？" },
    { "t": [21.7,25], "ja": "ただ、うわさ話やおしゃべりをしに来ただけ。いつものやつ" },
    { "t": [25,26.3], "ja": "でも、すごく忙しそうだし" },
    { "t": [26.3,29.7], "ja": "私もすごく忙しいから、これで失礼するわ" },
    { "t": [30,32.7], "ja": "あら、変ね" },
    { "t": [32.7,34.1], "ja": "今ちょっと思い出したんだけど" },
    { "t": [34.1,36.4], "ja": "私、自分の小委員会を持つことになったの" },
    { "t": [37.5,38.5], "ja": "そうなの" },
    { "t": [38.5,39.6], "ja": "きっと何か耳にしてるわよね" },
    { "t": [39.6,40.9], "ja": "みんなうわさしてるから" },
    { "t": [40.9,41.8], "ja": "ふーん" },
    { "t": [41.8,42.6], "ja": "まあ、いいわ" },
    { "t": [42.6,44.3], "ja": "とにかく、明日集会を開くの" },
    { "t": [44.3,46.6], "ja": "午後7時に、スミスフィールド・コミュニティーセンターで" },
    { "t": [46.6,47.4], "ja": "ふーん" },
    { "t": [47.4,48.6], "ja": "そう、私が仕切るの" },
    { "t": [48.6,49.7], "ja": "たいしたことじゃないけど" },
    { "t": [49.7,50.9], "ja": "いや、たいしたことよ、大事なことなの" },
    { "t": [50.9,53], "ja": "まあ、どうかな、私は、ほら" },
    { "t": [54.8,56.5], "ja": "来たい？" },
    { "t": [56.5,59], "ja": "あら、ねえ、私がどれだけ忙しいか知ってるでしょ" },
    { "t": [59,60.5], "ja": "分かってる、分かってる、分かってる" },
    { "t": [60.5,62.3], "ja": "だから、誘うふりをしただけ" },
    { "t": [65,66.9], "ja": "行けるようにしてみるわ" },
    { "t": [66.9,68.4], "ja": "ジェリー、元気か？" },
    { "t": [68.4,69.6], "ja": "なあ、プレッツェル好きだろ？" },
    { "t": [69.6,70.4], "ja": "ほら！" },
    { "t": [70.4,71.2], "ja": "どんどん食べて" },
    { "t": [71.2,72.1], "ja": "来てくれてありがとう" },
    { "t": [72.1,73.2], "ja": "あっちに席を取っておいたよ" },
    { "t": [73.2,74.4], "ja": "この公園の件で俺がいちばん大事にしてるのは" },
    { "t": [74.4,75.5], "ja": "あんたのとこのフェンスを入れることなんだ" },
    { "t": [75.5,76.6], "ja": "この前、あんたのフェンスの前を車で通ったんだけど" },
    { "t": [76.6,78.3], "ja": "「うわ、このフェンス最高だな」って思ったよ" },
    { "t": [78.3,79.8], "ja": "「さすがロイスだ」ってね" },
    { "t": [79.8,81.1], "ja": "チョコマフィンが好きなら" },
    { "t": [81.1,82.2], "ja": "好きなだけ取って" },
    { "t": [82.2,83.6], "ja": "こんなに早く業者を呼ぶのは" },
    { "t": [83.6,85.5], "ja": "ちょっと先走りすぎだって" },
    { "t": [85.5,86.9], "ja": "言う人もいるかもしれない" },
    { "t": [86.9,87.7], "ja": "でも、いいか？" },
    { "t": [87.7,89.5], "ja": "銃がここで、俺がここ" },
    { "t": [89.5,90.3], "ja": "ドーン" },
    { "t": [90.3,93.2], "ja": "ビクター・マイルズ、トム・ハヴァフォードです。お元気ですか？" },
    { "t": [93.2,94.5], "ja": "来てくださって本当にありがとうございます" },
    { "t": [94.5,97.2], "ja": "レスリーを紹介したいんです" },
    { "t": [97.2,98], "ja": "ビクター・マイルズさん" },
    { "t": [98,98.8], "ja": "どうも" },
    { "t": [98.8,100], "ja": "戸別訪問で知り合った方なんだ" },
    { "t": [100,102.9], "ja": "しかもインディアナで一番の芝の業者なんだよ" },
    { "t": [102.9,104], "ja": "すばらしいわ" },
    { "t": [104,105], "ja": "よう、レス" },
    { "t": [105,106.5], "ja": "どうも" },
    { "t": [106.5,108.7], "ja": "本当にうまくやってほしいと思ってるよ、ね？" },
    { "t": [108.7,109.9], "ja": "ドン・セメントのドンさん" },
    { "t": [109.9,111.8], "ja": "トム・ハヴァフォードです、お会いできてうれしいです" },
    { "t": [111.8,113.1], "ja": "御社の宣伝ソングを考えてたんですよ" },
    { "t": [113.1,114], "ja": "こんなのはどうです？" },
    { "t": [114,117.3], "ja": "「ドン・セメントは最高のセメント" },
    { "t": [117.3,118.6], "ja": "ドンの」" },
    { "t": [118.6,120.3], "ja": "ああ、来てくれて本当にうれしい" },
    { "t": [120.3,122.3], "ja": "うん、アンディも応援しに来たの" },
    { "t": [122.3,124.4], "ja": "私、舞台の経験があまりないから" },
    { "t": [124.4,125.5], "ja": "これ、大丈夫よね？" },
    { "t": [125.5,126.6], "ja": "公園なんだから" },
    { "t": [126.6,127.8], "ja": "公園なんて、そんなに嫌われるわけないじゃない" },
    { "t": [127.8,129.4], "ja": "昨日はみんな、公園をかなり嫌ってたみたいだけど" },
    { "t": [129.4,131.4], "ja": "エイプリル、エイプリル、客席にいてほしいの" },
    { "t": [131.4,133.2], "ja": "分かった　待って、もし質問が" },
    { "t": [133.2,134.6], "ja": "否定的になってきたら、あなたを指名するから" },
    { "t": [134.6,136.4], "ja": "とにかく、公園を全力で売り込んでほしいの" },
    { "t": [136.4,137.3], "ja": "できる？" },
    { "t": [137.3,138.1], "ja": "なんで？" },
    { "t": [138.1,139.7], "ja": "お願い、エイプリル、真剣なの" },
    { "t": [139.7,141.4], "ja": "できる？" },
    { "t": [141.4,142.4], "ja": "たぶん" },
    { "t": [142.4,145.1], "ja": "いい子ね、いい子、いい「たぶん」よ、いい子" },
    { "t": [145.1,147.1], "ja": "よし、始めるわよ。みんな並んで" },
    { "t": [157.3,159.2], "ja": "いいえ、それはできません" },
    { "t": [159.2,160.7], "ja": "違法ですから" },
    { "t": [160.7,162.5], "ja": "今夜はお越しいただき、本当にありがとうございます" },
    { "t": [162.5,166], "ja": "これは、サリバン通りの48番区画を" },
    { "t": [166,169.7], "ja": "地域の公園にするという提案についての、初めての集会です" },
    { "t": [172.4,174.1], "ja": "はい" },
    { "t": [174.1,176.5], "ja": "これは大失敗になるわね" },
    { "t": [176.5,178.4], "ja": "娘には成功してほしいの" },
    { "t": [178.4,180.3], "ja": "だからいつも言ってるのよ" },
    { "t": [180.3,182.8], "ja": "妻や母になることは何も悪くないって" },
    { "t": [182.8,185.6], "ja": "さて、私が話した多くの方が" },
    { "t": [185.6,188.9], "ja": "このアイデアを熱烈に支持してくれています" },
    { "t": [188.9,191.9], "ja": "残念ながら、今夜は誰も来られませんでしたが" },
    { "t": [191.9,194.3], "ja": "ちゃんと実在します" },
    { "t": [195.3,197.1], "ja": "私の作り話じゃありません" },
    { "t": [197.1,197.9], "ja": "あ、質問がありますね" },
    { "t": [197.9,198.6], "ja": "はい" },
    { "t": [198.6,199.8], "ja": "いえ、いえ" },
    { "t": [199.8,200.8], "ja": "えっと、いいえ" },
    { "t": [200.8,201.8], "ja": "今は質問を受け付けていません" },
    { "t": [201.8,203.1], "ja": "ケイト・スピバックです" },
    { "t": [203.1,203.9], "ja": "覚えてるわ" },
    { "t": [203.9,205.6], "ja": "この近所に住んでいます" },
    { "t": [205.6,209.6], "ja": "私はこの公園に100パーセント反対です" },
    { "t": [209.6,211.7], "ja": "環境影響調査をひとつもしないで" },
    { "t": [211.7,214.9], "ja": "部がこの計画を進めているなんて信じられません" },
    { "t": [214.9,217.9], "ja": "みなさんも同じ考えなら、立ち上がりましょう" },
    { "t": [217.9,218.7], "ja": "おお" },
    { "t": [218.7,219.4], "ja": "いいぞ！" },
    { "t": [219.4,220.4], "ja": "ありがとう" },
    { "t": [220.4,221.4], "ja": "はい" },
    { "t": [221.4,228.1], "ja": "えっと、私たちは、その、予定より少し先を行っていまして" },
    { "t": [228.1,232.1], "ja": "えー、こんなに早く集会を開いているので" },
    { "t": [232.1,234.9], "ja": "そのことは、マーク・ブレンダナウィッツから注意されていました" },
    { "t": [234.9,237.1], "ja": "この計画の担当の都市計画者です" },
    { "t": [237.1,240.6], "ja": "えっと、じゃあ彼なら何と言うかな？" },
    { "t": [240.6,241.6], "ja": "うーん" },
    { "t": [241.6,244.4], "ja": "こういうことです" },
    { "t": [244.4,249.4], "ja": "レスリー、この土地について少し説明しようか？" },
    { "t": [249.4,251.7], "ja": "もちろん、大丈夫？" },
    { "t": [251.7,254.2], "ja": "マーク・ブレンダナウィッツはどんな質問にも答えられます" },
    { "t": [254.2,257.7], "ja": "すばらしい人です。彼の話が聞けるなんて、みなさんおめでとうございます" },
    { "t": [257.7,258.5], "ja": "どうも" },
    { "t": [258.5,260.7], "ja": "えー、レスリーは僕のことを少し持ち上げすぎたかもしれません" },
    { "t": [260.7,261.7], "ja": "そんなことないわ" },
    { "t": [261.7,262.6], "ja": "彼は最高よ" },
    { "t": [262.6,263.6], "ja": "何でもできるの" },
    { "t": [263.6,264.6], "ja": "はい" },
    { "t": [264.6,268.1], "ja": "48番区画は、えー、長方形の土地です" },
    { "t": [268.1,269.3], "ja": "水はけがとてもよくて" },
    { "t": [269.3,272.6], "ja": "サリバン通りとコリンズ通りの角にあります" },
    { "t": [272.6,273.6], "ja": "質問はありますか？" },
    { "t": [273.6,275.4], "ja": "質問というより、意見があるんだけど" },
    { "t": [275.4,276.3], "ja": "どうぞ" },
    { "t": [276.3,277.7], "ja": "ギプスをしてるあの男に言いたいの" },
    { "t": [277.7,278.7], "ja": "来たぞ" },
    { "t": [278.7,279.5], "ja": "ローレンス" },
    { "t": [279.5,281.3], "ja": "はい、はい、はい" },
    { "t": [281.3,282.7], "ja": "彼はアンディ・ドワイヤーです" },
    { "t": [282.7,284.3], "ja": "地元の住民で" },
    { "t": [284.3,286.5], "ja": "気の毒なことに、あの穴に落ちたんです" },
    { "t": [286.5,289.1], "ja": "えっと、そんなことはどうでもいいの" },
    { "t": [289.1,291.4], "ja": "あの人、一晩中ガレージで音楽を鳴らしてるのよ" },
    { "t": [291.4,293.1], "ja": "頭がおかしくなりそう" },
    { "t": [293.1,297.7], "ja": "ローレンスは、えー、おばあさんと住んでて" },
    { "t": [297.7,299.1], "ja": "それはなかなか立派なことよ" },
    { "t": [299.1,300.2], "ja": "たぶん面倒を見てるんでしょうね" },
    { "t": [300.2,302.8], "ja": "でもどうでもいい、あいつはクズよ" },
    { "t": [302.8,305.9], "ja": "うるさいし、ひどいし、うちの鳥が起きちゃうの" },
    { "t": [305.9,307.6], "ja": "今は鳥を飼ってるの？" },
    { "t": [307.6,308.6], "ja": "そうよ、鳥を飼ってるの" },
    { "t": [308.6,311.2], "ja": "すてきできれいで高い鳥をね" },
    { "t": [311.2,313.1], "ja": "あなたがあの音楽を鳴らすと起きちゃうのよ" },
    { "t": [313.1,315.1], "ja": "いいかい、僕は役所の人間じゃないんだ、いい？" },
    { "t": [315.1,316.9], "ja": "えー、たしかにロックンロールはやってる" },
    { "t": [316.9,318.1], "ja": "そこは認めるよ" },
    { "t": [318.1,319.5], "ja": "バンドをやってるんだ" },
    { "t": [319.5,321.3], "ja": "「ジャスト・ザ・ティップ」っていうんだ" },
    { "t": [321.3,323.6], "ja": "それで、実は、この中にベースを弾ける人がいたら" },
    { "t": [323.6,324.5], "ja": "ベーシストを募集してるよ" },
    { "t": [324.5,325.3], "ja": "はい" },
    { "t": [325.3,327.3], "ja": "では、5分間休憩にしましょうか？" }
  ]
}
