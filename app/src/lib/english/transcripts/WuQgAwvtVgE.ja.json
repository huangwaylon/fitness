{
  "video": "WuQgAwvtVgE",
  "lines": [
    { "t": [0, 3.7], "ja": "みんな、わかった気がするよ" },
    { "t": [3.7, 6.2], "ja": "何が君たちをイライラさせてるのか" },
    { "t": [6.2, 8.1], "ja": "怖がる理由はないんだ" },
    { "t": [8.1, 10.4], "ja": "悪い男はいなくなった。チャールズはいない" },
    { "t": [10.4, 12], "ja": "チャールズは本当にこいつらをひどい目にあわせたんだ" },
    { "t": [12, 14.1], "ja": "みんな仕事に集中しすぎてる" },
    { "t": [14.1, 15.9], "ja": "僕が仕切ってたころは" },
    { "t": [15.9, 18.9], "ja": "ここはデイブ＆バスターズみたいなゲームセンターだったんだ" },
    { "t": [18.9, 24.1], "ja": "みんなぶらぶらして、楽しんで、昼寝を食べて" },
    { "t": [24.1, 26.6], "ja": "なんだろう。まるで…" },
    { "t": [26.6, 29.8], "ja": "デイブが死んじゃったみたいな感じだ" },
    { "t": [29.8, 32.1], "ja": "パパが来たぞ。パパが君たちの面倒を見てやる" },
    { "t": [32.1, 34], "ja": "自分のことをパパと呼ばないでください" },
    { "t": [34, 37.3], "ja": "僕は君たちの大きなパパで" },
    { "t": [37.3, 40.1], "ja": "痛いところにキスしてあげるんだ" },
    { "t": [40.1, 42.6], "ja": "ちっちゃいアンディちゃんは怖いのかな" },
    { "t": [42.6, 44], "ja": "アンディ、怖いの？うん" },
    { "t": [44, 45.6], "ja": "みんな怖いのかな？ううん" },
    { "t": [45.6, 49.7], "ja": "パパがついてるよ、僕のちっちゃな天使たち" },
    { "t": [49.7, 51.4], "ja": "よし" },
    { "t": [51.4, 53.3], "ja": "いい方法を思いついたんだ" },
    { "t": [53.3, 55], "ja": "みんなを落ちこみから抜け出させる方法をね" },
    { "t": [55, 58.3], "ja": "え？「ファンク」が問題で、解決策でもあるんだ" },
    { "t": [58.3, 59.5], "ja": "なるほど" },
    { "t": [59.5, 60.8], "ja": "下の階のオフィスを" },
    { "t": [60.8, 63.1], "ja": "みんながくつろげる場所に変えたんだ" },
    { "t": [63.1, 66.1], "ja": "魅力的じゃない人も魅力的な人も" },
    { "t": [66.1, 69.3], "ja": "集まって、会って、あいさつして" },
    { "t": [69.3, 71.6], "ja": "愛する人に会い" },
    { "t": [71.6, 73.9], "ja": "会う人を愛せる場所だ" },
    { "t": [73.9, 76.3], "ja": "これって、一緒にランチに行きたがらなかったことへの罰ですか？" },
    { "t": [76.3, 78.3], "ja": "ランチのことはもう忘れたら、オスカー？" },
    { "t": [78.3, 79.4], "ja": "みんなはもう忘れてるよ" },
    { "t": [79.4, 83.4], "ja": "仕事ばかりで遊ばないと、マイケルはつまらない子になる" },
    { "t": [83.4, 85.7], "ja": "お化けのコーヒーハウスみたいなもの？" },
    { "t": [85.7, 88.7], "ja": "ドワイトのせいで混乱してるな。どちらかというとディスコなんだ" },
    { "t": [88.7, 90.2], "ja": "お化けディスコみたいなものだ" },
    { "t": [90.2, 92.3], "ja": "コーヒーはあるけど、お化けはいない" },
    { "t": [92.3, 94.7], "ja": "ダンスホールとコーヒーバーが一緒になったものね" },
    { "t": [94.7, 98.3], "ja": "1階にある昼間のディスコだよ" },
    { "t": [98.3, 100.1], "ja": "産業用のオフィスビルのね" },
    { "t": [100.1, 101.3], "ja": "カフェ・ディスコね" },
    { "t": [101.3, 102.3], "ja": "その通り" },
    { "t": [102.3, 103.6], "ja": "じゃあ、ディスコ・カフェみたいな" },
    { "t": [103.6, 104.6], "ja": "何？" },
    { "t": [104.6, 106.6], "ja": "違う、違う、全然違う" },
    { "t": [106.6, 110], "ja": "下に行けと無理強いはできないけど、誘うことはできる" },
    { "t": [110, 112.4], "ja": "僕は下にいるよ" },
    { "t": [112.4, 114.4], "ja": "エリンもときどき下にいるし" },
    { "t": [114.4, 119.2], "ja": "エスプレッソ飲み放題だ" },
    { "t": [123.3, 126.5], "ja": "さて、ケビン、残ったのは私たちだけみたいね" },
    { "t": [126.5, 127.5], "ja": "うん" },
    { "t": [127.5, 128.8], "ja": "留守番ね" },
    { "t": [128.8, 130.2], "ja": "うん" },
    { "t": [130.2, 131.7], "ja": "ここ最高だね" },
    { "t": [131.7, 132.6], "ja": "ありがとう" },
    { "t": [132.6, 134.1], "ja": "もう、ケビン" },
    { "t": [134.1, 135.4], "ja": "まだ電話を保留にしてるんだけど" },
    { "t": [135.4, 137], "ja": "マイケルに答えを聞いて" },
    { "t": [137, 137.8], "ja": "戻ってくるはずだったでしょ" },
    { "t": [137.8, 138.4], "ja": "ごめん" },
    { "t": [138.4, 139.5], "ja": "ここは仕事禁止ゾーンだ" },
    { "t": [139.5, 142.1], "ja": "この場所を尊重してくれ" },
    { "t": [142.1, 145.3], "ja": "うん、この場所を尊重して" },
    { "t": [145.3, 146.9], "ja": "おいで" },
    { "t": [146.9, 148.1], "ja": "ケビン、待て" },
    { "t": [148.1, 149.6], "ja": "ケビン、おいで" },
    { "t": [149.6, 151.2], "ja": "ケビン、待て" },
    { "t": [151.2, 152], "ja": "ケビン、おいで" },
    { "t": [152, 153.5], "ja": "待て、待て" },
    { "t": [153.5, 154.4], "ja": "さあ、今すぐ" },
    { "t": [154.4, 156.5], "ja": "クッキーよ、ケビン、クッキー" },
    { "t": [156.5, 159.6], "ja": "クッキーなんてないぞ、ケビン" },
    { "t": [159.6, 160.6], "ja": "クッキーあるの？" },
    { "t": [160.6, 161.5], "ja": "うん" },
    { "t": [161.5, 162.6], "ja": "何？" },
    { "t": [162.6, 164.7], "ja": "さあ" },
    { "t": [164.7, 166.7], "ja": "もう、ケビンったら" },
    { "t": [166.7, 167.6], "ja": "クッキーなんてないの" },
    { "t": [167.6, 168.5], "ja": "クッキーはない" },
    { "t": [168.5, 169.4], "ja": "さあ" },
    { "t": [169.4, 170.4], "ja": "おいで" },
    { "t": [170.4, 172.1], "ja": "クッキーが欲しかったのに" },
    { "t": [172.1, 175.2], "ja": "まったく、ありえない" },
    { "t": [175.2, 179.1], "ja": "たばこ会社フィリップモリスの創業者の気持ちが、今わかったよ" },
    { "t": [179.1, 185.9], "ja": "ただ、みんなに楽しくて気持ちよくくつろげる方法をあげたかっただけなのに" },
    { "t": [185.9, 191.4], "ja": "いきなりひどい怪物扱いされるんだ" },
