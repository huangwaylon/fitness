{
  "video": "m26EYdpoN34",
  "lines": [
    { "t": [0, 2.5], "ja": "ああもう。今度は何がだめなの？" },
    { "t": [2.5, 5.8], "ja": "これ、注文したのと違う" },
    { "t": [5.8, 9.7], "ja": "ああ、僕の人生、何ひとつうまくいかないのか？" },
    { "t": [9.7, 14.2], "ja": "まず結婚がだめになって、それから僕は…" },
    { "t": [14.2, 15.7], "ja": "分かってる、分かってる" },
    { "t": [15.7, 17.1], "ja": "それからアパートを失って" },
    { "t": [17.1, 18.4], "ja": "それから仕事を失って" },
    { "t": [18.4, 20.5], "ja": "それから元妻があっという間に結婚して" },
    { "t": [20.5, 22.6], "ja": "そして今度はコーヒー、あー！" },
    { "t": [22.6, 26.5], "ja": "ロス、話があるの" },
    { "t": [26.5, 29.1], "ja": "わかった。ときどき僕は…" },
    { "t": [29.1, 31.4], "ja": "だめ、だめ、だめ、だめ、だめ、だめ、だめ" },
    { "t": [31.4, 34.5], "ja": "私が話すの" },
    { "t": [34.5, 43.6], "ja": "私たちの輝いてた日々に、もう日が沈んだと思うの" },
    { "t": [43.6, 45], "ja": "え？" },
    { "t": [45, 48.7], "ja": "あなたはとても優しい人よ、ロス" },
    { "t": [48.7, 53.8], "ja": "えっと、あいにくだけど" },
    { "t": [53.8, 58.2], "ja": "あなたの愚痴には、もう一秒も耐えられないと思うの" },
    { "t": [58.2, 62.6], "ja": "えっと、ちゃんと聞き取れてるか確かめさせて" },
    { "t": [62.6, 69.6], "ja": "僕が愚痴っぽすぎるから、別れるってこと？" },
    { "t": [69.6, 70.6], "ja": "ああ！" },
    { "t": [72.6, 78.1], "ja": "つまり、僕があまりに愚痴っぽくなって" },
    { "t": [78.1, 86.1], "ja": "君をイライラさせてるってこと、ジャニス？" },
    { "t": [86.1, 87.1], "ja": "まあ、そうね！" },
    { "t": [89, 89.5], "ja": "なんて" },
    { "t": [89.5, 90.4], "ja": "ことなの" },
    { "t": [93.4, 94.4], "ja": "大丈夫？" },
    { "t": [94.4, 95.4], "ja": "今は大丈夫" }
  ]
