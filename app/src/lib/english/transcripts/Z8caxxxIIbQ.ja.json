  "lines": [
    { "t": [0,  4], "ja": "クリーニングを出して、ビタミン剤を受け取って" },
    { "t": [4,  7], "ja": "「ビタミン」のつづりを教えて" },
    { "t": [7,  11], "ja": "新しいジーンズをはきならす" },
    { "t": [11,  14], "ja": "自分が何者か分かってる？" },
    { "t": [14,  15], "ja": "何？" },
    { "t": [15,  18], "ja": "あいつのパシリだよ" },
    { "t": [18,  20], "ja": "だめ、だめ、だめ！" },
    { "t": [20,  23], "ja": "待って、まさか僕のキットカットに座ってないよね？" },
    { "t": [23,  27], "ja": "ううん、市場がちょっと下がって" },
    { "t": [27,  29], "ja": "1300万ドル損したの" },
    { "t": [29,  32], "ja": "でも、キットカットは無事よ" },
    { "t": [32,  34], "ja": "どうしよう？ どうしよう？" },
    { "t": [34,  36], "ja": "会社には電話できない、殺される" },
    { "t": [36,  39], "ja": "お客さんにも電話できない、自殺しちゃう" },
    { "t": [39,  41], "ja": "もう最悪、今度は胸が痛い" },
    { "t": [41,  42], "ja": "何？" },
    { "t": [42,  44], "ja": "胸が痛いの" },
    { "t": [44,  47], "ja": "うっ、それに今度は息ができない" },
    { "t": [47,  49], "ja": "フィービー、心臓発作なの？" },
    { "t": [49,  52], "ja": "えーと、もしそうなら、ズキッと走る痛みがある？" },
    { "t": [52,  53], "ja": "左腕の上から下まで？" },
    { "t": [53,  54], "ja": "うん" },
    { "t": [54,  56], "ja": "じゃあ、そう、それなの" },
    { "t": [56,  58], "ja": "うそでしょ！" },
    { "t": [58,  67.8], "ja": "また次回" }
