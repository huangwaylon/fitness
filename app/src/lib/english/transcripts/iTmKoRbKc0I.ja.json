{
  "video": "iTmKoRbKc0I",
  "lines": [
    { "t": [0,  1.3], "ja": "ハーブ・スケーファー" },
    { "t": [1.3,  3], "ja": "何度も言うけど、アンディ、お辞儀はいらないから" },
    { "t": [3,  4], "ja": "仰せのままに、奥様" },
    { "t": [4,  6], "ja": "さて、ハーブ、ご用件は何かしら？" },
    { "t": [6,  8], "ja": "では、心の準備をしてください" },
    { "t": [8,  9], "ja": "恐ろしい知らせがあります" },
    { "t": [9,  10], "ja": "そうなの？" },
    { "t": [10,  13], "ja": "明日の夜明けに、世界が終わります" },
    { "t": [13,  15], "ja": "あら、残念。本当に明日なの？" },
    { "t": [15,  18], "ja": "残念ながら。夜明けちょうどに" },
    { "t": [18,  23], "ja": "ゾープが来て、あなたを肉体から解放してくれます" },
    { "t": [23,  25], "ja": "1970年代のしばらくの間" },
    { "t": [25,  27], "ja": "この町は奇妙なカルトに支配されてたの" },
    { "t": [27,  31], "ja": "で、数年おきに残ったメンバーが世界の終わりを予言して" },
    { "t": [31,  33], "ja": "公園で徹夜の集会をするの" },
    { "t": [33,  35], "ja": "すごく迷惑なのよ" },
    { "t": [35,  37], "ja": "世界が終わると思うと" },
    { "t": [37,  40], "ja": "仮設トイレで狙いが雑になるらしいの" },
    { "t": [40,  43], "ja": "なんでそのカルトは「合理主義者」って名乗ってるの？" },
    { "t": [43,  45], "ja": "それはね、もし人に批判されても" },
    { "t": [45,  48], "ja": "すごく合理的なものを攻撃してるように見えるからだって" },
    { "t": [48,  49], "ja": "妙に賢いね" },
    { "t": [49,  51], "ja": "ねえ、心配することは何もないの" },
    { "t": [51,  53], "ja": "世界が終わるって、もう15回も言ってるし" },
    { "t": [53,  55], "ja": "その日に起きた悪いことといえば" },
    { "t": [55,  58], "ja": "ランス・アームストロングがシェリル・クロウを振ったことくらい" },
    { "t": [58,  59], "ja": "悲劇の日だったな" },
    { "t": [59,  60], "ja": "うん" },
    { "t": [60,  61], "ja": "強く生きよう" },
    { "t": [61,  65], "ja": "とにかく、今夜はベンと私も付き添うべきだと思う" },
    { "t": [65,  67], "ja": "え、そこまでしなくていいと思うけど" },
    { "t": [67,  68], "ja": "いえいえ、ぜひそうさせて" },
    { "t": [68,  71], "ja": "あの人たちは、頭がナッツの星に住んでるのよ" },
    { "t": [71,  73], "ja": "僕も頭がナッツの星に住んでるよ" },
    { "t": [73,  76], "ja": "ふすまとナッツは、お腹の調子にすごくいいんだ" },
    { "t": [76,  78], "ja": "さて、どうやら一緒に過ごすしかないみたいだね" },
    { "t": [78,  79], "ja": "うん" },
    { "t": [79,  83], "ja": "あのさ、少しは来るけど、もしよければ長居はしないよ" },
    { "t": [83,  87], "ja": "ほら、まだちょっと気まずいだろ？" },
    { "t": [87,  88], "ja": "うん" },
    { "t": [88,  89], "ja": "うん" },
    { "t": [89,  91], "ja": "うん、うん、うん、うんうん、完全に分かる" },
    { "t": [91,  92], "ja": "絶対に分かる" },
    { "t": [92,  94], "ja": "最近、ベンとはあまり一緒に過ごしてない" },
    { "t": [94,  95], "ja": "だから何？" },
    { "t": [95,  96], "ja": "一緒に過ごさない人なんて、たくさんいる" },
    { "t": [96,  100], "ja": "ジェリーとエイプリル、オバマとマドンナも、たぶんね" },
    { "t": [100,  102], "ja": "私たち、いい仲間に入ってるわ" },
    { "t": [102,  104], "ja": "市は彼らを、公共の安全への脅威と見ていますか？" },
    { "t": [104,  107], "ja": "いえ、まったく。ショーナ・マルウェイ・トウィープさん" },
    { "t": [107,  112], "ja": "では、市政管理室の職員が2人ここにいることに、特に意味はないと？" },
    { "t": [112,  114], "ja": "何もないですよ。他にやることがなかっただけで" },
    { "t": [114,  116], "ja": "それは、彼らより僕のことを物語ってるかもね" },
    { "t": [116,  117], "ja": "どうも" },
    { "t": [117,  118], "ja": "どうも" },
    { "t": [118,  119], "ja": "見出しの案です" },
    { "t": [119,  123], "ja": "彼らの知る世界は終わるが、ポーニーは平気" },
    { "t": [123,  124], "ja": "ちょっと長いわね" },
    { "t": [124,  125], "ja": "そうか" },
    { "t": [125,  126], "ja": "ゾープなんて知るか" },
    { "t": [126,  131], "ja": "終末予言は空振り、市民は町一番の公園で楽しい夜を過ごす" },
    { "t": [131,  132], "ja": "なぜか、もっと長い" },
    { "t": [132,  133], "ja": "だよね" },
    { "t": [133,  134], "ja": "じゃあ、最初のにしておくわ" },
    { "t": [134,  135], "ja": "よかった" },
    { "t": [135,  137], "ja": "あの、それと、彼かわいいわね" },
    { "t": [137,  138], "ja": "独身？" },
    { "t": [138,  139], "ja": "知ってる？" },
    { "t": [139,  140], "ja": "クリス？" },
    { "t": [140,  141], "ja": "いいえ" },
    { "t": [141,  142], "ja": "実はジェリーの娘とつき合ってるの" },
    { "t": [142,  143], "ja": "あ、ううん、ごめん" },
    { "t": [143,  144], "ja": "ベンのことよ" },
    { "t": [144,  145], "ja": "彼ってどういう人？" },
    { "t": [145,  146], "ja": "誰？" },
    { "t": [146,  147], "ja": "ベン？" },
    { "t": [147,  148], "ja": "私…" },
    { "t": [148,  149], "ja": "分からない" },
    { "t": [149,  150], "ja": "私…" },
    { "t": [150,  151], "ja": "私は…" },
    { "t": [151,  152], "ja": "よく分からない" },
    { "t": [152,  155], "ja": "彼は、えーと、男性で、働く人で、それで…" },
    { "t": [155,  157], "ja": "そういう話はしたことないから…" },
    { "t": [157,  159], "ja": "いつも、すごく仕事だけの関係だから…" },
    { "t": [159,  163], "ja": "あなたの推測も私と同じくらい、いや、私以上に当たると思う" },
    { "t": [163,  166], "ja": "以上、レスリー・ノープでした" },
    { "t": [166,  167], "ja": "そう" },
    { "t": [167,  168], "ja": "いいわね" },
    { "t": [168,  169], "ja": "ありがとう" },
    { "t": [169,  170], "ja": "どういたしまして" },
    { "t": [170,  172], "ja": "どうしたの？" },
    { "t": [172,  175], "ja": "世界が終わるの" },
    { "t": [175,  177], "ja": "あらら" },
    { "t": [177,  178], "ja": "この先の展開は分かってる" },
    { "t": [178,  180], "ja": "ショーナのやり口は分かってるの" },
    { "t": [180,  185], "ja": "彼女が笑いかけて、二人は恋に落ちて、結婚して、彼女の名前はショーナ・マルウェイ・ワイアットになる" },
    { "t": [185,  189], "ja": "それとも、彼がすごく進歩的で、ベン・ワイアット・マルウェイ・トウィープに改名するかも" },
    { "t": [189,  192], "ja": "もう、彼が仮にそんなことをすると思うと、本当に腹が立つ" },
    { "t": [192,  196], "ja": "念のため言うけど、彼とつき合わないのは、あなたが市議会に立候補すると決めたからでしょ" },
    { "t": [196,  199], "ja": "じゃあ、私が彼とつき合えないからって、他の人ならいいわけ？" },
    { "t": [199,  200], "ja": "あらら" },
    { "t": [200,  201], "ja": "わあ" },
    { "t": [201,  202], "ja": "そう" },
    { "t": [202,  204], "ja": "きっと何でもないわ" },
    { "t": [204,  207], "ja": "うん、今のは絶対に何かあった" },
    { "t": [207,  208], "ja": "うそでしょ" },
    { "t": [208,  209], "ja": "あの仕草、知ってる" },
    { "t": [209,  210], "ja": "5分後には寝ちゃうわ" },
    { "t": [210,  211], "ja": "止めなきゃ" },
    { "t": [211,  213], "ja": "二人を一生、引き離しておかなきゃ" },
    { "t": [213,  214], "ja": "どうやって？" },
    { "t": [214,  215], "ja": "分からない" },
    { "t": [215,  216], "ja": "行くわよ" },
    { "t": [216,  217], "ja": "ああ、ここにいたのね" },
    { "t": [217,  219], "ja": "わあ、二人ともまだ話してるの？" },
    { "t": [219,  221], "ja": "ベンの話が退屈で、死にそうになってない？" },
    { "t": [221,  222], "ja": "おい" },
    { "t": [222,  223], "ja": "すごく退屈" },
    { "t": [223,  225], "ja": "実は、すごく楽しく話してたの" },
    { "t": [225,  226], "ja": "ズボンは脱がないで" },
    { "t": [226,  227], "ja": "え？" },
    { "t": [227,  228], "ja": "つまり、落ち着いてってこと！" },
    { "t": [228,  230], "ja": "いや、そのズボン、すごく素敵ね" },
    { "t": [230,  231], "ja": "そのズボン、本当に好き" },
    { "t": [231,  232], "ja": "どこで買ったの？" },
    { "t": [232,  233], "ja": "もっとズボンを買いに行かない？" },
    { "t": [233,  235], "ja": "それか、えーと、ここから離れるとか？" },
    { "t": [235,  237], "ja": "あの世界の終わりパーティーに行ってみようかな" },
    { "t": [237,  239], "ja": "ああ、負け犬が集まるところよ" },
    { "t": [239,  240], "ja": "ええ、それって何？" },
    { "t": [240,  241], "ja": "トムからメールが来たんだ" },
    { "t": [241,  242], "ja": "ちょっとのぞいてみようかな" },
    { "t": [242,  243], "ja": "それか…" },
    { "t": [243,  246], "ja": "じゃあ、ここにいたほうがいいわよ" },
    { "t": [246,  248], "ja": "だって、あなたは行けないもの" },
    { "t": [248,  250], "ja": "だって、ゾープが来たときにここにいなかったら？" },
    { "t": [250,  251], "ja": "赤っ恥をかくわよ" },
    { "t": [251,  256], "ja": "ゾープが来たら、お前たちの顔は溶かされて燃料にされる" },
    { "t": [256,  259], "ja": "それに立ち会いたいでしょ？" },
    { "t": [259,  260], "ja": "それでも行ってみるわ" },
    { "t": [260,  262], "ja": "レスリー、いつもありがとう" },
    { "t": [262,  265], "ja": "わあ、信じられないくらい感じの悪い人ね" },
    { "t": [265,  266], "ja": "夜明けは近い" },
    { "t": [266,  268], "ja": "測量者ゾープが近づいてくる" },
    { "t": [268,  276], "ja": "そして地上のすべての借りは返される" },
    { "t": [276,  278], "ja": "ドーナツはこれで最後だよ" },
    { "t": [278,  282], "ja": "個人的なことで話せますか？" },
    { "t": [282,  284], "ja": "普段なら、だめだ" },
    { "t": [284,  290], "ja": "だが人類の終わりまで20分しかないことを考えても、やはりだめだ" },
    { "t": [290,  292], "ja": "今夜、私どうかしてた" },
    { "t": [292,  297], "ja": "ベンが他の人とつき合う可能性さえ、つぶそうとしたの" },
    { "t": [297,  299], "ja": "だめだと言ったのが聞こえなかったのか？" },
    { "t": [299,  301], "ja": "別れたのは私のせい" },
    { "t": [301,  311], "ja": "でもね、ロン、もし明日世界が終わるなら、私は彼と一緒にいたい" },
    { "t": [311,  315], "ja": "ほう、それは大事なことだな" },
    { "t": [315,  320], "ja": "問題は、レスリー、世界は明日終わらないってことだ" },
    { "t": [320,  323], "ja": "太陽はちょうどあそこから昇る" },
    { "t": [323,  328], "ja": "普通の金曜日になって、君は前と全く同じ立場にいる" },
    { "t": [328,  330], "ja": "分かってる" },
    { "t": [330,  333], "ja": "ただ、彼が他の人といると思うだけで、つらいの" },
    { "t": [333,  338], "ja": "少しでも気が晴れるなら、レスリー、20分後にはみんな死んでいますよ" },
    { "t": [338,  340], "ja": "本当に気が晴れたわ" },
    { "t": [340,  341], "ja": "ありがとう、ハーブ" }
  ]
}
