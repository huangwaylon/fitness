{
  "video": "qTKbULvknqo",
  "lines": [
    { "t": [0,4.1], "ja": "今半分払う。仕事が終わったら残りの半分だ" },
    { "t": [4.1,5.7], "ja": "それって全部、帳簿には載らないの？" },
    { "t": [5.7,6.8], "ja": "当然だ" },
    { "t": [6.8,9.3], "ja": "いいね、税金なしだ" },
    { "t": [9.3,10.9], "ja": "よし、知っておくべきことは全部" },
    { "t": [10.9,12.8], "ja": "標的については、この中に入ってる" },
    { "t": [12.8,14], "ja": "で、仕事って何？" },
    { "t": [16,17.2], "ja": "殺しだ" },
    { "t": [17.2,19.9], "ja": "了解、それは大仕事だね。“殺し”の M だ" },
    { "t": [21.6,23.9], "ja": "人を殺させるなんてだめだ！" },
    { "t": [23.9,25.4], "ja": "もし、その人が殺されて当然だったら？" },
    { "t": [25.4,26.6], "ja": "アンジェラ、そいつが君に何をしたんだ？" },
    { "t": [26.6,29.1], "ja": "私の夫と寝てるの" },
    { "t": [29.1,31.8], "ja": "ああ、かわいそうに。気持ちは分かるよ" },
    { "t": [31.8,33], "ja": "これってちょっとおかしい気がする" },
    { "t": [33,34.7], "ja": "そう、おかしいよ、ありがとう" },
    { "t": [34.7,35.8], "ja": "でも、やってもいいかな" },
    { "t": [35.8,36.6], "ja": "だめだ！　ありがとう！" },
    { "t": [36.6,38], "ja": "だめだ、絶対にだめだ" },
    { "t": [38,39.4], "ja": "仕返しの方法はいろいろある" },
    { "t": [39.4,42.2], "ja": "私は紙袋にうんこをして" },
    { "t": [42.2,44], "ja": "玄関先に置くのでうまくいったことがある　それはすごく効くよ" },
    { "t": [44,46.2], "ja": "何回もやられたことがあるんだ" },
    { "t": [46.2,47.8], "ja": "かなりこたえる　だめ、だめ、だめ" },
    { "t": [47.8,49], "ja": "体に直接じゃなきゃだめ" },
    { "t": [49,50.6], "ja": "この人を苦しめたいの" },
    { "t": [50.6,51.8], "ja": "ひざを砕くのはどう？" },
    { "t": [51.8,53.4], "ja": "だめ、だめ、それじゃ逆効果だ、トレバー" },
    { "t": [53.4,56.2], "ja": "そうね、ひざを砕くのはいいかも" },
    { "t": [56.2,59], "ja": "だめだ、アンジェラ、何を言ってるんだ？" },
    { "t": [59,60.9], "ja": "でも、あなたは私の味方でいてくれるって言ったじゃない" },
    { "t": [60.9,63.2], "ja": "そうしようとしてる。でも、君が頼んでいるのは…" },
    { "t": [63.2,66.2], "ja": "これしか、けりをつける方法はないの" },
    { "t": [68.5,71.2], "ja": "分かった。でも、それは残酷だ" },
    { "t": [71.2,72.6], "ja": "ひざを痛めた女性は" },
    { "t": [72.6,74.5], "ja": "まともに床もみがけないからな" },
    { "t": [74.5,76.6], "ja": "よし、じゃあ決まりだ" },
    { "t": [76.6,78.1], "ja": "ひざ砕き1件" },
    { "t": [78.1,80.6], "ja": "決行は4時だ" },
    { "t": [80.6,83.4], "ja": "いいか、俺が出ていったら、もう後戻りはできないぞ" },
    { "t": [83.4,85.6], "ja": "何？　なんでここに呼び出したの？" },
    { "t": [85.6,86.6], "ja": "標的のことだ" },
    { "t": [86.6,88.6], "ja": "オスカーだろう？" },
    { "t": [88.6,91.2], "ja": "あいつと議員はゲイの関係なんだな" },
    { "t": [91.2,93.3], "ja": "何の話か分からない" },
    { "t": [93.3,94.6], "ja": "君の鼻の穴は違うことを言っているぞ" },
    { "t": [94.6,97.6], "ja": "君がうそをつくたびに、そうやってふくらむんだ" },
    { "t": [97.6,99.5], "ja": "また会ったな、いけない鼻の穴め" },
    { "t": [99.5,102.4], "ja": "いいわ、オスカーよ。だから何？" },
    { "t": [102.4,105.6], "ja": "知らない人のひざを砕きたいならまだ分かる" },
    { "t": [105.6,107.8], "ja": "でも同僚を、いや、友達と言ってもいい相手をか？" },
    { "t": [107.8,109.4], "ja": "その通り、友達よ" },
    { "t": [109.4,111.7], "ja": "何年も何年も隣に座って" },
    { "t": [111.7,113.3], "ja": "おしゃべりして、笑顔を見せて" },
    { "t": [113.3,115.3], "ja": "その間ずっと、陰でこそこそ" },
    { "t": [115.3,118.3], "ja": "私の結婚を汚して、夫を誘惑してたのよ" },
    { "t": [118.3,122.5], "ja": "君がどれほどつらいか、想像もつかない" },
    { "t": [122.5,127.2], "ja": "だが、最初に結婚の誓いを破ったのは、君と私だ" },
    { "t": [127.2,131.5], "ja": "そうかもしれないけど、もう手遅れよ" },
    { "t": [131.5,132.5], "ja": "どういう意味だ？" },
    { "t": [132.5,134.3], "ja": "彼が来てる" },
    { "t": [134.3,139.3], "ja": "だめ、だめ、だめ、だめ、だめ" },
    { "t": [139.3,146.3], "ja": "オスカー、オスカー、オスカー、よかった" },
    { "t": [146.3,148.2], "ja": "いいか、おい、ついて来い" },
    { "t": [148.2,149.4], "ja": "何？　ついて来い" },
    { "t": [149.4,150.2], "ja": "そのまま進め！" },
    { "t": [150.2,152.4], "ja": "倉庫に建設作業員がたくさんいて" },
    { "t": [152.4,155.2], "ja": "ズボンもはかずにダイエットソーダを飲んでるんだ" },
    { "t": [155.2,156.5], "ja": "これは見なきゃだめだぞ" },
    { "t": [156.5,158.1], "ja": "すごいんだ" },
    { "t": [158.1,160.1], "ja": "（聞き取れない）" },
    { "t": [166.1,169.5], "ja": "オスカー・マルティネスさんにサンドイッチのお届けです" },
    { "t": [172.3,176], "ja": "私がオスカー・マルティネスです" },
    { "t": [176,177.2], "ja": "いや、そいつじゃない、そいつじゃない、そいつじゃない" },
    { "t": [177.2,177.9], "ja": "外だ" },
    { "t": [178.9,179.9], "ja": "外へ" },
    { "t": [181.9,182.9], "ja": "何？" },
    { "t": [182.9,184.9], "ja": "そういえば、休憩室にドーナツがあるぞ" },
    { "t": [184.9,185.9], "ja": "いいね" },
    { "t": [187.9,189.9], "ja": "説明している時間はない" },
    { "t": [193.9,195.9], "ja": "いや、やっぱり説明する時間はある" },
    { "t": [195.9,197.9], "ja": "君がアンジェラの夫を誘惑したと知って" },
    { "t": [197.9,199.8], "ja": "私たちは君のひざを砕く男を雇ったんだ" },
    { "t": [199.8,201.8], "ja": "なんてこと、いったいどうかしてるの？" },
    { "t": [201.8,203], "ja": "どうかしてるのは君だ！" },
    { "t": [203,206.7], "ja": "スクラントン・ウィルクスバリには、すてきな男が山ほどいるのに" },
    { "t": [206.7,208.7], "ja": "よりによって、彼女の子どもの父親を選ぶとはな" },
    { "t": [208.7,209.7], "ja": "何の話か分からない" },
    { "t": [209.7,210.7], "ja": "ああ、うそをつくな" },
    { "t": [210.7,212.7], "ja": "君の大事なひざを守ろうとしているんだ" },
    { "t": [212.7,213.7], "ja": "いつも自慢している、そのひざをな" },
    { "t": [213.7,214.7], "ja": "さあ、ここから逃げるぞ" },
    { "t": [214.7,215.7], "ja": "すぐ後ろにいるかもしれない" },
    { "t": [215.7,218.6], "ja": "いや、実は目の前にいる" },
    { "t": [218.6,220.6], "ja": "さあ、やろうぜ" },
    { "t": [220.6,221.6], "ja": "やってやる" },
    { "t": [221.6,223.6], "ja": "吐くかもしれないけど、やってやる" },
    { "t": [223.6,224.6], "ja": "だめだ、トレバー、そうはさせない" },
    { "t": [224.6,225.6], "ja": "彼はダンダー・ミフリンの人間だ" },
    { "t": [225.6,226.6], "ja": "私の仲間だ" },
    { "t": [226.6,228.6], "ja": "悪いな、ドワイト。でも、このばかな、ばかな人生で一度くらい" },
    { "t": [228.6,229.6], "ja": "何かをやり遂げたいんだ、いいか？" },
    { "t": [229.6,231.5], "ja": "男らしさの悩みがあるんだよ、それに…" },
    { "t": [231.5,232.5], "ja": "分かった" },
    { "t": [232.5,233.5], "ja": "だめ！" },
    { "t": [233.5,234.5], "ja": "だめ！" },
    { "t": [234.5,235.5], "ja": "つかまえた！" },
    { "t": [235.5,236.5], "ja": "この腕！" },
    { "t": [236.5,237.5], "ja": "お前は…" },
    { "t": [237.5,238.5], "ja": "（音楽）" },
