{
  "video": "ZvK0ddkH6LY",
  "lines": [
    { "t": [0,7.2], "ja": "これが欲しかったの" },
    { "t": [7.5,9.4], "ja": "晩ごはんは、捨ててあった乳飲料だったから" },
    { "t": [9.6,10.1], "ja": "うそでしょ" },
    { "t": [10.3,10.6], "ja": "ほんとだよ" },
    { "t": [12.2,14.6], "ja": "なんでルークとチャンネルを始めようなんて思ったんだろう" },
    { "t": [15,16.3], "ja": "私、そんなに必死に相棒がほしかったの？" },
    { "t": [16.7,18], "ja": "答えないで。まだ話してるから" },
    { "t": [20.2,21.7], "ja": "また何か作りたいだけなの" },
    { "t": [22.4,23.6], "ja": "それなら相棒はいらないよ" },
    { "t": [24.4,26], "ja": "そう、相棒はいらない" },
    { "t": [26.4,27], "ja": "サムが必要なの" },
    { "t": [27.5,30.1], "ja": "でもサムは、あのバイク集団と好きなことをしに行っちゃった" },
    { "t": [30.4,31.5], "ja": "オブリタレーターズね" },
    { "t": [32.2,33.3], "ja": "サムが無事だといいけど" },
    { "t": [33.5,35.4], "ja": "サムだよ。無事か心配なのは、向こうの連中のほう" },
    { "t": [37.3,40.1], "ja": "サムがここにいたら、またアイカーリーができるのに" },
    { "t": [43.4,44.8], "ja": "私一人でできると思う？" },
    { "t": [45.8,46.9], "ja": "僕がどう思うかは関係ないよ" },
    { "t": [47.4,48.5], "ja": "大事なのは、カーリーがどうしたいかだよ" },
    { "t": [48.8,51.3], "ja": "もちろん、完全に一人ってわけじゃないけどね" },
    { "t": [52,53.2], "ja": "新しいプロデューサーがいるし" },
    { "t": [53.7,54.1], "ja": "わあ" },
    { "t": [55.1,56.3], "ja": "それって僕のことだよね？" },
    { "t": [57.1,57.6], "ja": "うん" },
    { "t": [58.3,59.9], "ja": "あのフィルターで撮ってくれる？" },
    { "t": [59.9,60.9], "ja": "ほお骨がこう…なるやつ" },
    { "t": [62.9,64.7], "ja": "宇宙人みたいに見えるフィルター？" },
    { "t": [65,66], "ja": "セクシーな宇宙人ね" },
    { "t": [67.7,68.2], "ja": "いいよ" },
    { "t": [69.5,70.8], "ja": "あと一つだけ問題があるかな" },
    { "t": [71.8,74.4], "ja": "スペンサーが、ついにあのホームジムを作っちゃったかどうか" },
    { "t": [81.8,83.5], "ja": "ホームジムなんて、どうせ使う気なかったよ" },
    { "t": [87.7,88.1], "ja": "ああ！" },
    { "t": [89.9,91.2], "ja": "あ、そうだった！" },
    { "t": [91.6,93.5], "ja": "あやつり人形作りにはまってた時期を忘れてた" },
    { "t": [93.7,96.5], "ja": "ナイフから離れてるから、ここに置いてるんだ" },
    { "t": [98.5,99.9], "ja": "なんであれ、カーリーに似てるの？" },
    { "t": [100,101.5], "ja": "君に似たのも作ったよ、フレディ" },
    { "t": [101.9,103.7], "ja": "でもノラ・ダーシュリットに売っちゃった" },
    { "t": [106.4,107.6], "ja": "これっていい考えかな？" },
    { "t": [108.1,109.8], "ja": "だって、番組で何をするの？" },
    { "t": [110.3,111.4], "ja": "昔みたいなおバカなこと？" },
    { "t": [111.7,113], "ja": "新しい、大人っぽいこと？" },
    { "t": [113.4,115.2], "ja": "笑顔になれるものを見つけなよ" },
    { "t": [115.5,116.1], "ja": "そこから始めればいい" },
    { "t": [117.4,119.3], "ja": "あのダックスフントたち、いつも笑顔にしてくれた" },
    { "t": [119.3,120.9], "ja": "誰があそこに置いたの？" },
    { "t": [121.4,123], "ja": "あんなの、生まれて一度も見たことない" },
    { "t": [127.5,128], "ja": "わあ" },
    { "t": [128.9,130.1], "ja": "おバカな農場の娘だ" },
    { "t": [130.8,131.5], "ja": "ねえ" },
    { "t": [131.8,133.2], "ja": "これ、本当にリスみたいに見える" },
    { "t": [134.7,135.8], "ja": "うそ" },
    { "t": [136.6,137.3], "ja": "あの袋だ" },
    { "t": [138.1,139.2], "ja": "これ、すごく楽しかったよね" },
    { "t": [139.4,139.9], "ja": "うん" },
    { "t": [140.2,142.4], "ja": "サムが僕の袋のひもを接着剤でくっつけて" },
    { "t": [142.4,143.4], "ja": "ひと晩ここに置き去りにするまではね" },
    { "t": [144.1,145.6], "ja": "ああ、あれは僕にとってもつらい夜だった" },
    { "t": [145.8,146.8], "ja": "こいつ、ずっと叫びっぱなしでさ" },
    { "t": [148.9,150.9], "ja": "ジョージ、怪談を話すブラジャーだ" },
    { "t": [152.3,153.8], "ja": "結局、ぴったりにはならなかったね" },
    { "t": [155.7,158], "ja": "ほら、これ全部、子どもの頃に考えたんだよ" },
    { "t": [158.4,159.6], "ja": "今なら何ができるか考えてみて" },
    { "t": [160.1,161.8], "ja": "できることは何でも手伝うから" },
    { "t": [161.9,162], "ja": "うん" },
    { "t": [162.6,165.1], "ja": "そう言ってくれて本当にうれしい、だって…" },
    { "t": [167.8,170.2], "ja": "まだここにあるかもって思ったの" },
    { "t": [171.9,172.6], "ja": "もう" },
    { "t": [175.3,176.1], "ja": "復活だよ" },
    { "t": [177.4,178.8], "ja": "5秒前" },
    { "t": [179.6,180], "ja": "4" },
    { "t": [180.8,181.3], "ja": "3" },
    { "t": [182.1,182.4], "ja": "2" },
    { "t": [183.7,185.1], "ja": "新しいアイカーリーへようこそ" },
    { "t": [186.7,188.7], "ja": "おお、もう何人か見てるみたい" },
    { "t": [189.1,190.5], "ja": "たぶんブラジルのボットだよ" },
    { "t": [192,195.2], "ja": "これもアイカーリーだけど、今は大人になったの" },
    { "t": [195.3,197.5], "ja": "だから今日は、私の肌の手入れを紹介します" },
    { "t": [197.9,200.5], "ja": "私に届く、すごくたくさんのターゲット広告によると" },
    { "t": [200.7,206.2], "ja": "エイジングケア用品は、始めるのに早すぎることはないそうです" },
    { "t": [207,209.8], "ja": "赤ちゃんスペンサーにもね" },
    { "t": [210,210.3], "ja": "いえーい！" },
    { "t": [210.5,210.9], "ja": "いえーい！" },
    { "t": [211,212], "ja": "フー！" },
    { "t": [212.1,212.8], "ja": "僕だよ！" },
    { "t": [213.8,216.3], "ja": "この製品はどれも動物実験をしていません" },
    { "t": [216.7,219.3], "ja": "小さくてラッキーな赤ちゃん一人だけです" },
    { "t": [219.4,221], "ja": "ねえ、ラッキーだよね？" },
    { "t": [221.1,223], "ja": "全然心配なんかしてないよ" },
    { "t": [225.7,226.9], "ja": "いくよ" },
    { "t": [227.1,227.6], "ja": "痛っ！" },
    { "t": [228.8,230.5], "ja": "あら、もっとたくさん必要みたい" },
    { "t": [230.7,231.5], "ja": "もう少し？" },
    { "t": [231.6,232.9], "ja": "いや、もう十分だよ" },
    { "t": [232.9,233.4], "ja": "よし、うん" },
    { "t": [234.2,234.9], "ja": "よし、うん" },
    { "t": [235.8,238.2], "ja": "これ、やり方が違う気がする" },
    { "t": [239.1,240.2], "ja": "この美容液、大好きなの" },
    { "t": [240.3,242.3], "ja": "実はセブンイレブンにいた時、あわてて買ったの" },
    { "t": [242.4,243.6], "ja": "店員さんに「奥さん」って呼ばれてね" },
    { "t": [244.3,245.7], "ja": "なんでそんなに嫌がってるのか分からない" },
    { "t": [245.7,247.4], "ja": "お金を払って、これをやってもらってるのに" },
    { "t": [248.5,250.5], "ja": "スキンケアが必要になった時には" },
    { "t": [250.5,251.5], "ja": "もう手遅れだって言われてます" },
    { "t": [251.6,253.4], "ja": "でも、それでもお金は全部つぎこむべきです" },
    { "t": [253.7,256.1], "ja": "そして結局は、高いお金を払って思い出すだけ" },
    { "t": [256.2,257.5], "ja": "みんな、いつかは死ぬってことを" },
    { "t": [258.4,262.2], "ja": "お笑い番組にしては、ちょっと暗すぎない？" },
    { "t": [263,264], "ja": "シートマスク" },
    { "t": [264.1,265.2], "ja": "え？　そう" },
    { "t": [265.2,266.2], "ja": "やだ！　はい、できた" },
    { "t": [268.1,269.8], "ja": "なぜかみんな、すごく気に入ってる" },
    { "t": [269.9,272], "ja": "すっごくつらい！" },
    { "t": [272.1,273.2], "ja": "もうそのへんにしようね、赤ちゃん" },
    { "t": [273.3,275.3], "ja": "じゃあ次は、全部コロコロ伸ばしていきます" },
    { "t": [275.3,278], "ja": "冷たい！この感じ嫌い！　この感じ嫌い！" },
    { "t": [278.1,281.1], "ja": "保湿クリームを全部のせていきます" },
    { "t": [281.1,282.3], "ja": "冷たい！" },
    { "t": [282.4,283.6], "ja": "リップマスクの準備はいい？" },
    { "t": [283.6,286.1], "ja": "何か分からないけど、いいよ！" },
    { "t": [286.1,287.9], "ja": "ここね　うん" },
    { "t": [288,291.2], "ja": "はい、口はしっかり閉じておいてね" },
    { "t": [291.3,292.5], "ja": "いいね！" },
    { "t": [292.6,295.2], "ja": "このリップマスク、実は洗濯洗剤でできてるの" },
    { "t": [296.4,297.8], "ja": "なんだか、一度もやめてなかったみたい" }
  ]
}
