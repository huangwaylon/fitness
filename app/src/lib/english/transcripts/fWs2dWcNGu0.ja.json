{
  "video": "fWs2dWcNGu0",
  "lines": [
    { "t": [1, 3.3], "ja": "あら。やあ" },
    { "t": [3.3, 6.3], "ja": "ねえ、このチーズケーキ、絶対食べてみて" },
    { "t": [6.3, 8.5], "ja": "ああ、ほら、私、甘い物はそんなに好きじゃないの" },
    { "t": [8.5, 10.4], "ja": "ああ。私は…" },
    { "t": [10.4, 13.7], "ja": "うわ、すごい、なめらか。ああ" },
    { "t": [13.7, 16.5], "ja": "うそ、今まで食べた中で一番おいしいチーズケーキ" },
    { "t": [16.5, 19.1], "ja": "これ、どこで買ったの？" },
    { "t": [19.1, 20.6], "ja": "家に帰ったら、玄関の前にあったんだ" },
    { "t": [20.6, 23.7], "ja": "誰かが送ってくれたんだよ" },
    { "t": [23.7, 25.7], "ja": "チャンドラー、これ、あなた宛てじゃないよ" },
    { "t": [25.7, 28.5], "ja": "下の階のブレイバーマンさん宛てだよ" },
    { "t": [28.5, 31.6], "ja": "泥棒" },
    { "t": [31.6, 34.7], "ja": "いや、開ける前に箱（の宛名）を読まなかったんだよ" },
    { "t": [34.7, 36.9], "ja": "それに、一度開けた箱は返せないだろ" },
    { "t": [36.9, 39.4], "ja": "なんで？おいしすぎるから" },
    { "t": [42, 44.3], "ja": "チャンドラー、このチーズケーキを盗んだのね。それはだめよ" },
    { "t": [44.3, 46.4], "ja": "いや、いや、いや、大丈夫だよ" },
    { "t": [46.4, 49.3], "ja": "ブレイバーマンさんは、無料のをもう一つ取り寄せるから" },
    { "t": [49.3, 51.1], "ja": "そうすれば、みんな得をする" },
    { "t": [51.1, 55.6], "ja": "損をするのは、チーズケーキの大企業だけ…" },
    { "t": [55.6, 57.5], "ja": "ママズ・リトル・ベーカリーね" },
    { "t": [58.5, 60.6], "ja": "最低の気分" },
    { "t": [60.6, 63.6], "ja": "私って、ひどい、ひどい、ひどい人間" },
    { "t": [63.6, 64.7], "ja": "あら" },
    { "t": [64.7, 66.3], "ja": "えっと、ごめん、何？" },
    { "t": [68.3, 69.2], "ja": "私…" },
    { "t": [69.2, 70.9], "ja": "うん、チーズケーキが届いたんだ" },
    { "t": [70.9, 73], "ja": "また住所を間違えて配達されたんだよ" },
    { "t": [74.4, 76.1], "ja": "じゃあ、下に持っていけばいいじゃない" },
    { "t": [76.1, 77.2], "ja": "何が問題なの？" },
    { "t": [77.2, 79.1], "ja": "どうしても手放せないんだ" },
    { "t": [79.1, 80.8], "ja": "本気？" },
    { "t": [80.8, 83.1], "ja": "チャンドラー、2日前にチーズケーキを丸ごと食べたのに" },
    { "t": [83.1, 84.4], "ja": "まだ食べたいの？" },
    { "t": [84.4, 87.5], "ja": "だって、どんな味だったか忘れちゃったんだよ" },
    { "t": [87.5, 89.1], "ja": "チーズケーキよ" },
    { "t": [89.1, 90.5], "ja": "普通だったよ" },
    { "t": [90.5, 94.6], "ja": "バターたっぷりで、ほろほろのグラハムクラッカーの生地に" },
    { "t": [94.6, 101.1], "ja": "すごく濃厚なのに軽いクリームチーズが入ってた" },
    { "t": [104.1, 106.3], "ja": "うわ、口の中がよだれでいっぱいになった" },
    { "t": [106.3, 107.8], "ja": "（無音）" },
    { "t": [107.8, 108.4], "ja": "ねえ" },
    { "t": [108.4, 109.2], "ja": "もういい" },
    { "t": [109.2, 110.5], "ja": "私たち、おなかがすいてるだけよ" },
    { "t": [110.5, 111.8], "ja": "お昼を食べてないし" },
    { "t": [111.8, 113.1], "ja": "ふらふらしてるだけ" },
    { "t": [113.1, 117.1], "ja": "だから、外でお昼を食べて、チーズケーキのことは忘れましょう" },
    { "t": [117.1, 119.2], "ja": "うん、食べたくならないように、下の階に届けておこう" },
    { "t": [119.2, 120], "ja": "いい考えね" },
    { "t": [120, 120.9], "ja": "お昼はどこに行きたい？" },
    { "t": [120.9, 122.6], "ja": "ママズ・リトル・ベーカリー、イリノイ州シカゴ" },
    { "t": [127.4, 128.8], "ja": "お昼、ごちそうさま" },
    { "t": [128.8, 130.5], "ja": "ちょっと待って、私、払ってない" },
    { "t": [130.5, 131.5], "ja": "あなたが払ったと思ってた" },
    { "t": [131.5, 133.9], "ja": "どうやら、もう食べ物にお金を払わないらしいね" },
    { "t": [137.2, 138.1], "ja": "私が見てるもの、見える？" },
    { "t": [138.1, 139.1], "ja": "まだあるね" },
    { "t": [141.1, 142.5], "ja": "ブレイバーマンさんは出かけてるのね" },
    { "t": [147.2, 148.5], "ja": "町を離れてるのかも" },
    { "t": [148.5, 150], "ja": "何か月も留守かもしれない" },
    { "t": [150, 152.2], "ja": "その頃には、チーズケーキが傷んでるかも" },
    { "t": [152.2, 154.2], "ja": "帰ってきて、傷んだチーズケーキがあったら困るよね" },
    { "t": [154.2, 155.2], "ja": "うん、それで死んじゃうかもしれない" },
    { "t": [155.2, 156.2], "ja": "それは困るね" },
    { "t": [156.2, 157.4], "ja": "うん、だから僕たちが彼女を守ってるんだ" },
    { "t": [157.4, 158.2], "ja": "じゃあ、持っていこう" },
    { "t": [158.2, 159.2], "ja": "うん、でも急がないと" },
    { "t": [159.2, 159.8], "ja": "なんで？" },
    { "t": [159.8, 161.3], "ja": "今、中で彼女が動く音が聞こえた気がする" },
    { "t": [161.3, 163.4], "ja": "急いで、急いで、早く、早く！" },
    { "t": [169.3, 171.4], "ja": "私抜きでチーズケーキ食べてるの？" },
    { "t": [171.4, 172.4], "ja": "んーん" },
    { "t": [174.6, 177.5], "ja": "今すぐ口笛を吹けたら、100ドルあげる" },
    { "t": [182.9, 184.4], "ja": "なんで私抜きでチーズケーキが食べられるの？" },
    { "t": [184.4, 185.2], "ja": "へえ、どうするつもり？" },
    { "t": [185.2, 186.5], "ja": "モニカに言いつけに行く？" },
    { "t": [186.5, 187.6], "ja": "ジョーイに言う？" },
    { "t": [187.6, 189.4], "ja": "言えないよね。だって、そしたら私たちのしたことも話すことになるから" },
    { "t": [189.4, 190.8], "ja": "私たちはデザート泥棒なの" },
    { "t": [190.8, 192.6], "ja": "法の外で生きてるの" },
    { "t": [193.9, 195.9], "ja": "ねえ、もうこのケーキはあなたに任せられない" },
    { "t": [195.9, 198.3], "ja": "それに、最初にもらったのは僕だから、取り返す！" },
    { "t": [198.3, 199.1], "ja": "何？何？" },
    { "t": [199.1, 199.7], "ja": "そうだよ！" },
    { "t": [199.7, 200.3], "ja": "そうだよ！" },
    { "t": [200.3, 201.2], "ja": "だめ、だめ、だめ、だめ、だめ、させない" },
    { "t": [201.2, 202.1], "ja": "いや、取る！" },
    { "t": [202.1, 203], "ja": "信じて！" },
    { "t": [203, 204.6], "ja": "私があなたを信じると思う？" },
    { "t": [204.6, 205.5], "ja": "だめ、分けよう" },
    { "t": [205.5, 206.7], "ja": "半分ずつね" },
    { "t": [206.7, 207.4], "ja": "それはずるいよ" },
    { "t": [207.4, 208.4], "ja": "君はもう何口か食べたじゃないか" },
    { "t": [208.4, 209.4], "ja": "ふーん。あ、そうだ" },
    { "t": [209.4, 211.4], "ja": "モニカ、きっとすごく知りたがるだろうな" },
    { "t": [211.4, 214.6], "ja": "あなたが彼女のチーズケーキを、ぱさぱさでぼそぼそだって言ったこと" },
    { "t": [214.6, 216.2], "ja": "何で切り分ける？" },
    { "t": [216.2, 216.8], "ja": "よし" },
    { "t": [219.7, 221.2], "ja": "じゃあ、半分を選んで" },
    { "t": [221.2, 222], "ja": "分かった" },
    { "t": [222.5, 225], "ja": "えっと、こっちのほうが大きく見えるな" },
    { "t": [225, 226], "ja": "うん" },
    { "t": [226, 229.2], "ja": "えっと、こっちのほうが生地が多い気がする" },
    { "t": [229.2, 230.3], "ja": "うん" },
    { "t": [230.3, 231.3], "ja": "それで…" },
    { "t": [231.3, 232.3], "ja": "測ってみたら…" },
    { "t": [232.3, 233.5], "ja": "もう、いいから、さっさと選んで！" },
    { "t": [233.5, 234.5], "ja": "分かった、そっちにする" },
    { "t": [234.5, 236.8], "ja": "じゃあ、小さいほうね" },
    { "t": [236.8, 240.3], "ja": "はい、どうぞ" },
    { "t": [240.3, 243.4], "ja": "自分の半分を味わってね、相棒。でも、それでおしまい" },
    { "t": [243.4, 247.2], "ja": "分けるのもなし、交換もなし、泣きついてくるのもなしね" },
    { "t": [247.2, 249.6], "ja": "自分のを早く食べちゃってもね" },
    { "t": [249.6, 250.4], "ja": "わあ！" },
    { "t": [250.4, 251.3], "ja": "わあ！" },
    { "t": [251.3, 253.5], "ja": "ねえ、君の分を少しくれない？" },
    { "t": [253.5, 256.4], "ja": "ほほほ、だめ、だめ" },
    { "t": [256.4, 259.2], "ja": "交換なし、分けるのもなし、泣きついてこないで" },
    { "t": [259.2, 263.8], "ja": "一日中ここに座って、ケーキを食べてようかな" },
    { "t": [263.8, 268.9], "ja": "この廊下に座って、自分の…" },
    { "t": [272.9, 274.6], "ja": "見て、床についてないところがあるよ" },
    { "t": [274.6, 275.9], "ja": "自分の側だけにして" },
    { "t": [275.9, 277.2], "ja": "もう、いいじゃないか" }
  ]
}
