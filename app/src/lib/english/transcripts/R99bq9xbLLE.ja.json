{
  "video": "R99bq9xbLLE",
  "lines": [
    { "t": [1,2.8], "ja": "今日は本当にいい日だ" },
    { "t": [2.8,7], "ja": "いいか、家には妻と3人のかわいい娘がいる" },
    { "t": [7,12], "ja": "でもこの旅行は、年に一度だけ立っておしっこできる時なんだ" },
    { "t": [16,17], "ja": "あの音、大好き" },
    { "t": [19,21], "ja": "撃たれた！" },
    { "t": [22,24], "ja": "撃たれた！" },
    { "t": [30,32], "ja": "うっ！" },
    { "t": [32,34], "ja": "誰かに頭を撃たれた！" },
    { "t": [39,40], "ja": "うわ、うわ、うわ！" },
    { "t": [40,42], "ja": "うそ、うそ、うそでしょ！" },
    { "t": [42,45], "ja": "ロン、帽子を取って！　ロン、帽子は私が持ってる！" },
    { "t": [45,46], "ja": "すごく痛い？" },
    { "t": [46,48], "ja": "散弾銃で頭を撃たれたんだぞ！" },
    { "t": [48,52], "ja": "ロン、実はそんなに深刻じゃないの。とにかく落ち着いていてほしいの、いい？" },
    { "t": [52,55], "ja": "ああ、私は怒ったままでいる。そのほうが落ち着くんだ" },
    { "t": [55,58], "ja": "ロン、911に電話したから、レンジャーを送ってくれるって" },
    { "t": [58,60], "ja": "ああ、くそ！　めちゃくちゃだ" },
    { "t": [60,62], "ja": "来年はもうレンジャーに来させてもらえない" },
    { "t": [62,64], "ja": "ねえ、今はそのことは考えないでおこう" },
    { "t": [64,67], "ja": "みんな、彼を獲物部屋の寝台に寝かせてくれる？" },
    { "t": [67,68], "ja": "え、寝台？" },
    { "t": [68,69], "ja": "うん" },
    { "t": [71,72], "ja": "よし、待って" },
    { "t": [82,83], "ja": "大丈夫？" },
    { "t": [83,85], "ja": "どうしたの、心臓？" },
    { "t": [85,86], "ja": "息が苦しいの？" },
    { "t": [86,89], "ja": "そうなの、もう！　向こうに誰かいる！" },
    { "t": [93,95], "ja": "はい、スコッチよ、ロン" },
    { "t": [95,97], "ja": "よし、ジェリー、ジェリーが来たよ。はい、スコッチだ、ロン" },
    { "t": [97,98], "ja": "はい、どうぞ、ロン。よし" },
    { "t": [98,100], "ja": "ねえ、いいこと教えてあげる" },
    { "t": [100,102], "ja": "アンが手当てしてくれるのよ" },
    { "t": [102,104], "ja": "アンは北米でいちばんの看護師なんだから" },
    { "t": [104,106], "ja": "よし、はいどうぞ" },
    { "t": [107,108], "ja": "何、大丈夫？" },
    { "t": [108,110], "ja": "君が…君が私を撃ったのか？" },
    { "t": [110,111], "ja": "え？" },
    { "t": [111,112], "ja": "違う！" },
    { "t": [112,116], "ja": "私の近くに鳥がいたし、君がどれほど自分の腕を証明したがっていたか知っているからな" },
    { "t": [116,117], "ja": "違う" },
    { "t": [117,118], "ja": "違う、本当にやってない" },
    { "t": [118,120], "ja": "ロン、神に誓って、私は誰も撃ったことなんかない" },
    { "t": [120,125], "ja": "なら、誰がやったのか突き止めて、そいつに棺おけを買ってやれ。八つ裂きにしてやるからな！" },
    { "t": [125,126], "ja": "分かった" },
    { "t": [126,127], "ja": "分かった" },
    { "t": [127,128], "ja": "ねえ" },
    { "t": [128,129], "ja": "はい" },
    { "t": [129,130], "ja": "気分はどう？" },
    { "t": [130,131], "ja": "気分はどう？" },
    { "t": [131,132], "ja": "めまいがする？" },
    { "t": [132,133], "ja": "めまいとか…？" },
    { "t": [133,134], "ja": "頭がふらふらする？" },
    { "t": [134,136], "ja": "手のひらを見ると、女の口が犬とディープキスしているのが見える" },
    { "t": [136,137], "ja": "これは普通か？" },
    { "t": [137,138], "ja": "これは普通か？" },
    { "t": [138,140], "ja": "まあ、私があげた痛み止めはかなり強いからね" },
    { "t": [140,142], "ja": "ドナが生理痛のときに飲んでるやつ" },
    { "t": [142,143], "ja": "何錠飲んだの？" },
    { "t": [143,145], "ja": "7錠か8錠だ" },
    { "t": [145,148], "ja": "だが、たっぷりの飲み物で流し込んだ" },
    { "t": [148,150], "ja": "だめよ、ロン、これとスコッチを一緒に飲んじゃだめ" },
    { "t": [150,152], "ja": "今すぐ吐かなきゃだめよ、いい？" },
    { "t": [152,153], "ja": "いや、だめだ" },
    { "t": [153,154], "ja": "いいえ、吐くの" },
    { "t": [154,155], "ja": "いやだ、20年もののスコッチをむだにする気はない" },
    { "t": [155,156], "ja": "だめ、吐いて" },
    { "t": [156,157], "ja": "彼の口を開けてくれる？" },
    { "t": [157,158], "ja": "いやだ" },
    { "t": [158,159], "ja": "レスリー？" },
    { "t": [159,160], "ja": "何？" },
    { "t": [160,161], "ja": "彼の口を開けて" },
    { "t": [161,162], "ja": "いやだ" },
    { "t": [162,163], "ja": "口を開けて" },
    { "t": [163,164], "ja": "分かった" },
    { "t": [164,165], "ja": "自分で吐いたりはしないぞ" },
    { "t": [165,166], "ja": "ああ、ロン" },
    { "t": [166,167], "ja": "ロン、吐かなきゃだめ" },
    { "t": [167,168], "ja": "ごめんね、こうするしかないの" },
    { "t": [168,169], "ja": "あなたのためなのよ" },
    { "t": [169,170], "ja": "かまないから" },
    { "t": [170,171], "ja": "ロン" },
    { "t": [171,172], "ja": "レスリー、ひげをつかんで" },
    { "t": [172,173], "ja": "口を開けて" },
    { "t": [173,174], "ja": "胸を押さえて" },
    { "t": [174,175], "ja": "痛っ！" },
    { "t": [175,176], "ja": "口を開けて！" },
    { "t": [176,177], "ja": "肩を押さえて！" },
    { "t": [177,180], "ja": "さて、いい知らせは、ロンがゆっくり休んでるってこと" },
    { "t": [180,181], "ja": "大丈夫なの？" },
    { "t": [181,182], "ja": "助かるの？" },
    { "t": [182,184], "ja": "たぶんね" },
    { "t": [184,187], "ja": "まあ、少し記憶がなくなってるといいんだけど" },
    { "t": [187,190], "ja": "怒り具合で言うと、どのくらい？　大暴れするレベル？" },
    { "t": [190,192], "ja": "まあ、誰が撃ったのかすごく知りたがってる" },
    { "t": [192,196], "ja": "だから、やった人は、「私がやった」って言って" },
    { "t": [196,199], "ja": "さあ、ロンを撃った人" },
    { "t": [203,206], "ja": "ねえ、ロンの頭を撃ったって、誰も認めたがらないのは" },
    { "t": [206,207], "ja": "ちょっと変だと思うんだけど" },
    { "t": [207,209], "ja": "ロンが自分で撃ったのかも" },
    { "t": [209,210], "ja": "うーん" },
    { "t": [210,211], "ja": "最近、すごく落ち込んでるみたいだったし" },
    { "t": [211,213], "ja": "撃たれたのは後頭部よ" },
    { "t": [213,214], "ja": "その通り" },
    { "t": [214,215], "ja": "ロンは自分の後頭部が大好きだもんな" },
    { "t": [215,216], "ja": "あそこを自分で撃つはずがない" },
    { "t": [216,218], "ja": "ロンを撃ったのは、別の誰かかもしれない" },
    { "t": [218,219], "ja": "私たちのグループ以外の誰か" },
    { "t": [219,221], "ja": "誰かが僕たちを狩ってるって思うの？" },
    { "t": [221,224], "ja": "人間こそ、最も危険な獲物だ" },
    { "t": [224,225], "ja": "プレデターだ！" },
    { "t": [225,228], "ja": "たしかに外で何かのにおいがした。人間じゃなかった" },
    { "t": [228,229], "ja": "それは松の木よ" },
    { "t": [229,231], "ja": "プレデターは熱が見えるんだ" },
    { "t": [231,233], "ja": "体を泥で覆ったほうがいい" },
    { "t": [233,234], "ja": "まだ外にいるかもしれない" },
    { "t": [236,237], "ja": "今の聞こえた？" },
    { "t": [237,238], "ja": "実は、僕も何か聞こえた" },
    { "t": [238,239], "ja": "よし、外に誰かいる" },
    { "t": [239,240], "ja": "銃を取ってくる" },
    { "t": [240,241], "ja": "分かった、トム" },
    { "t": [241,242], "ja": "頭の上を撃って、追い払って" },
    { "t": [242,243], "ja": "それで何になるの？" },
    { "t": [243,244], "ja": "頭の下を撃ってやる" },
    { "t": [244,245], "ja": "うわっ！" },
    { "t": [245,246], "ja": "誰も撃たないで！" },
    { "t": [246,247], "ja": "何してるの？" },
    { "t": [247,248], "ja": "おい！" },
    { "t": [248,249], "ja": "撃つな！" },
    { "t": [249,250], "ja": "おい！" },
    { "t": [250,253], "ja": "レインホールド・メルセデスのクレイグだよ！" },
    { "t": [253,254], "ja": "クレイグ！" },
    { "t": [254,255], "ja": "クレイグ！" },
    { "t": [255,256], "ja": "任せろ、トム！" },
    { "t": [256,257], "ja": "クレイグ！" },
    { "t": [257,258], "ja": "心配するな！" },
    { "t": [258,259], "ja": "今行く！" },
    { "t": [259,260], "ja": "ねえ、ロンの様子は？" },
    { "t": [260,262], "ja": "かなりもうろうとしてる" },
    { "t": [262,263], "ja": "寝言であなたのことを話してるわ" },
    { "t": [263,264], "ja": "いい話？" },
    { "t": [264,265], "ja": "ううん" },
    { "t": [265,266], "ja": "そっか" },
    { "t": [266,267], "ja": "そっちはどう？" },
    { "t": [267,268], "ja": "最悪" },
    { "t": [268,271], "ja": "誰もロンを撃ったって認めないし、誰も見てないの" },
    { "t": [271,272], "ja": "何があったか分かった" },
