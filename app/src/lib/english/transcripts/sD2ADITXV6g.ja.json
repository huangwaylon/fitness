{
  "video": "sD2ADITXV6g",
  "lines": [
    { "t": [0,2.6], "ja": "本日は、レスリー・ノープが" },
    { "t": [2.6,4.7], "ja": "市の規則や法律に違反したかどうかを判断するために集まりました" },
    { "t": [4.7,8.2], "ja": "上司であるベン・ワイアットとの恋愛関係によるものです" },
    { "t": [8.3,9.6], "ja": "彼の審問は明日行われます" },
    { "t": [10.3,11.9], "ja": "今、何か陳述したいことはありますか？" },
    { "t": [13,15.7], "ja": "はい、交際の事実は素直に認めます" },
    { "t": [16.1,17.8], "ja": "そして、私たちがクリスの規則を破ったという" },
    { "t": [17.8,20], "ja": "訴えについては争いません" },
    { "t": [20.3,22.9], "ja": "でも、それ以外に悪いことや、倫理に反することは何もしていません" },
    { "t": [23.4,27.3], "ja": "1849年、サラ・ネルソン・クインドルは屋外でひじを出しました" },
    { "t": [27.6,28.9], "ja": "それは重い犯罪でした" },
    { "t": [29.3,31.4], "ja": "彼女はその法律が不当だと思っていましたが" },
    { "t": [31.8,33.6], "ja": "法を破ったことを認め" },
    { "t": [33.9,35.7], "ja": "潔く罰を受け入れました" },
    { "t": [36.2,39.2], "ja": "人間アイスキャンディーのように、ミシガン湖に流されたんです" },
    { "t": [39.9,41.2], "ja": "見てください、この落ち着いた顔" },
    { "t": [41.5,43.6], "ja": "私も同じ気持ちです。すっかり心穏やかです" },
    { "t": [44.4,48.1], "ja": "ノープさん、ベン・ワイアットとの交際は何日に始まりましたか？" },
    { "t": [48.8,50.8], "ja": "去年の5月、あなたに頼まれて" },
    { "t": [51.1,52.8], "ja": "ベンと私はインディアナポリスまで車で行きました" },
    { "t": [52.8,54.7], "ja": "州の少年野球大会の誘致のためです" },
    { "t": [55.4,57.2], "ja": "戻ってきた夜、初めて" },
    { "t": [57.2,58.6], "ja": "お互いの口にキスをしました" },
    { "t": [58.6,61.3], "ja": "最高でした" },
    { "t": [62.2,63.7], "ja": "それは付け加えなくてよかったのでは" },
    { "t": [63.8,64.7], "ja": "すみません。緊張していて" },
    { "t": [65.3,66.1], "ja": "次の質問です" },
    { "t": [66.5,68.8], "ja": "ベン・ワイアットとの交際の結果" },
    { "t": [68.8,71], "ja": "特別な扱いを受けたことはありますか？" },
    { "t": [71.2,73], "ja": "かわいいあだ名をもらいましたし" },
    { "t": [73,74.3], "ja": "すごく上手に背中をマッサージしてもらいました" },
    { "t": [75.4,76.6], "ja": "あ、仕事の上でってことですか？" },
    { "t": [76.9,77.1], "ja": "いいえ" },
    { "t": [77.3,78.6], "ja": "では、市や" },
    { "t": [79.2,80.6], "ja": "州、連邦の法律を破ったことはありますか？" },
    { "t": [80.6,81.9], "ja": "隠そうとして" },
    { "t": [81.9,83.3], "ja": "ベン・ワイアットとの交際を" },
    { "t": [83.4,84.5], "ja": "絶対にありません" },
    { "t": [85.8,86.3], "ja": "ありがとう" },
    { "t": [86.4,87.1], "ja": "ノープさん、以上です" },
    { "t": [87.4,88.2], "ja": "トレーガーさん" },
    { "t": [88.3,90.2], "ja": "ここには、あなたが14人の証人を呼ぶと書いてありますが" },
    { "t": [90.4,91.1], "ja": "間違いありませんか？" },
    { "t": [91.6,92.2], "ja": "はい" },
    { "t": [92.7,93.2], "ja": "14人？" },
    { "t": [93.3,94], "ja": "なんでそんなに？" },
    { "t": [94.1,96.3], "ja": "規則を破ったことは、もう認めたのに" },
    { "t": [96.3,98.3], "ja": "私の規則じゃないよ、レスリー" },
    { "t": [98.5,99.5], "ja": "これは大事な規則で" },
    { "t": [99.5,101.1], "ja": "どの役所にもあるものなんだ" },
    { "t": [101.5,102.5], "ja": "恋愛関係は" },
    { "t": [102.5,104.5], "ja": "上司と部下の間の" },
    { "t": [104.5,105.9], "ja": "詐欺や汚職" },
    { "t": [106,107.1], "ja": "それに公金の不正使用につながるんだ" },
    { "t": [107.3,108.5], "ja": "私がそれをやったと思ってるの？" },
    { "t": [108.7,110.2], "ja": "君はベン・ワイアットとの交際を" },
    { "t": [110.2,111.8], "ja": "言っているより早く始めていたと思う" },
    { "t": [111.9,114.2], "ja": "君は間違いなく特別扱いを受けていたと思うし" },
    { "t": [114.4,116.6], "ja": "もしかしたら、わいろの罪もあるかもしれない" },
    { "t": [116.8,118.2], "ja": "どれも事実じゃないわ" },
    { "t": [118.4,120.6], "ja": "それを証明してみせます、トレーガーさん" },
    { "t": [121,122.6], "ja": "では、10分休憩にします" },
    { "t": [123.1,123.7], "ja": "はい、どうぞ、ボス" },
    { "t": [124,124.9], "ja": "よし、みんな" },
    { "t": [125,127.3], "ja": "クリスが私に向けた訴えに" },
    { "t": [127.3,128.7], "ja": "ひとつ残らず反論しなきゃ" },
    { "t": [129.6,130.6], "ja": "アンディ、証拠が要るの" },
    { "t": [130.8,131.2], "ja": "了解" },
    { "t": [131.2,132.6], "ja": "待って、証拠が何か分かってないでしょ" },
    { "t": [132.6,133.4], "ja": "ああ、その通り" },
    { "t": [133.5,134.1], "ja": "はい、言ってみて" },
    { "t": [134.3,135.5], "ja": "私の机の横に、女性政治家" },
    { "t": [135.5,137.3], "ja": "ベラ・アブザグの写真があるの" },
    { "t": [137.4,139], "ja": "その写真の裏にテープで貼ってある鍵を取って" },
    { "t": [139.1,140.4], "ja": "それで机のいちばん下の引き出しが開くから" },
    { "t": [140.5,141.1], "ja": "中にファイルがいくつかあるの" },
    { "t": [141.4,142.4], "ja": "ちゃんと聞いて、どこ見てるの？" },
    { "t": [142.7,143.7], "ja": "こっちを見て、集中して" },
    { "t": [143.9,145.1], "ja": "引き出しの中のファイルを取って" },
    { "t": [145.2,146.9], "ja": "それからオフィスにあるファイルの箱を全部持ってきて" },
    { "t": [147,147.8], "ja": "ファイルを引き出しに入れる" },
    { "t": [147.9,148.2], "ja": "行こう" },
    { "t": [148.3,149.4], "ja": "いや、分かった、僕が一緒に行くよ" },
    { "t": [149.5,149.9], "ja": "ありがとう" },
    { "t": [150.2,152], "ja": "ロン、クリスには14人の証人がいるの" },
    { "t": [152.2,153.7], "ja": "部長たち全員と話して" },
    { "t": [153.7,154.7], "ja": "誰が証言するのか探ってほしいの" },
    { "t": [155,157.1], "ja": "ほかの部長の名前なんて知らん" },
    { "t": [157.2,157.7], "ja": "僕が一緒に行くよ" },
    { "t": [157.8,159.1], "ja": "本気？　このオフィスの男たちと？" },
    { "t": [159.3,159.5], "ja": "アン？" },
    { "t": [159.7,159.9], "ja": "うん" },
    { "t": [159.9,161.6], "ja": "30秒ごとに、全部うまくいくってメールを送ってほしいの" },
    { "t": [161.6,162.5], "ja": "大丈夫だよって" },
    { "t": [162.5,162.7], "ja": "分かった" },
    { "t": [166.8,167.5], "ja": "ありがとう、アン" },
    { "t": [168.3,169.6], "ja": "私が破った規則はひとつだけ" },
    { "t": [169.7,171.3], "ja": "軽い罰なら受け入れるわ" },
    { "t": [171.5,172.5], "ja": "でも、何もしないで" },
    { "t": [172.5,174], "ja": "自分の評判が壊されるのを見ていたら" },
    { "t": [174.3,177.2], "ja": "凍った女として歴史に残ることになる" },
    { "t": [178.9,179.6], "ja": "私は戦う" },
    { "t": [180.1,200], "ja": "また次回お会いしましょう" }
  ]
}
