{
  "video": "1QQBB3cwNM0",
  "lines": [
    { "t": [0,  1.2], "ja": "こうしよう" },
    { "t": [1.2,  3.3], "ja": "君を直さなきゃならない" },
    { "t": [3.3,  7.9], "ja": "君を管理する。もっと個人的な規模で" },
    { "t": [7.9,  10.5], "ja": "もっとミクロな管理の形でな" },
    { "t": [10.5,  11.5], "ja": "ジム、それって何て言うんだっけ？" },
    { "t": [11.5,  12.5], "ja": "マイクロマネジメント？" },
    { "t": [12.5,  13.5], "ja": "それだ、そう" },
    { "t": [13.5,  15.6], "ja": "では、ジムがお客さん役だ" },
    { "t": [15.6,  17.9], "ja": "ドワイト、君は彼に売り込むんだ" },
    { "t": [17.9,  21.7], "ja": "攻撃的にも、敵対的にも、面倒にもならずにな" },
    { "t": [21.7,  22.5], "ja": "さあ、始めよう" },
    { "t": [22.5,  24.8], "ja": "分かりましたよ" },
    { "t": [24.8,  27], "ja": "プルルル、プルルル" },
    { "t": [27,  27.9], "ja": "もしもし？" },
    { "t": [27.9,  28.9], "ja": "もしもし、ドワイト・シュルートと申します" },
    { "t": [28.9,  30.6], "ja": "ダンダー・ミフリン製紙会社の者です" },
    { "t": [30.6,  32.7], "ja": "ああ、ちょうどよかった、紙が必要なんだ" },
    { "t": [32.7,  33.8], "ja": "素晴らしい、では運がいいですよ" },
    { "t": [33.8,  35.7], "ja": "ただいま期間限定の特売を" },
    { "t": [35.7,  37.3], "ja": "全商品で実施中なんです" },
    { "t": [37.3,  38.6], "ja": "わあ、今日はついてるな" },
    { "t": [38.6,  39.5], "ja": "名前を聞いて" },
    { "t": [39.5,  40.8], "ja": "お名前をうかがえますか？" },
    { "t": [40.8,  42], "ja": "ビル・ケツナメだ" },
    { "t": [43.5,  45.3], "ja": "本当に？ それが本名ですか？" },
    { "t": [45.3,  47.3], "ja": "なんて失礼な！" },
    { "t": [47.3,  49.4], "ja": "言っておくが、うちの一族はこの国を築いたんだぞ" },
    { "t": [49.4,  50.8], "ja": "失礼のないようにな、ドワイト、頼むよ" },
    { "t": [50.8,  51.6], "ja": "はい、マイケル" },
    { "t": [51.6,  53], "ja": "ちょっと待ってくれ、別の電話が入った" },
    { "t": [53,  54.4], "ja": "えっ、いや、でも…" },
    { "t": [54.4,  55.7], "ja": "もしもし？" },
    { "t": [55.7,  57.3], "ja": "ああ" },
    { "t": [57.3,  59.4], "ja": "いや、今ばかな営業マンと電話してるところでさ" },
    { "t": [59.4,  61.1], "ja": "本当にまぬけなんだ" },
    { "t": [61.1,  63], "ja": "たぶん、ずっと電話につないだままにして" },
    { "t": [63,  64.2], "ja": "何も買わないつもりだよ" },
    { "t": [64.2,  65.6], "ja": "へへっ" },
    { "t": [65.6,  68.1], "ja": "よし、彼の気持ちを変えられるかは君次第だ" },
    { "t": [68.1,  70.7], "ja": "失礼、家族の緊急事態でね" },
    { "t": [70.7,  71.8], "ja": "えっ、大変、どうしたんですか？" },
    { "t": [71.8,  73.6], "ja": "いいかね、それは個人的なことだ" },
    { "t": [73.6,  75.1], "ja": "立ち入りすぎだぞ、ドワイト、まったく" },
    { "t": [75.1,  76.5], "ja": "失礼しました、ケツナメさん" },
    { "t": [76.5,  78.6], "ja": "先ほど申し上げたとおり、ただいま期間限定の…" },
    { "t": [78.6,  79.6], "ja": "君、もう少し大きな声で話してくれ" },
    { "t": [79.6,  80.5], "ja": "耳が遠いんだ" },
    { "t": [80.5,  81.4], "ja": "耳が遠いんだよ、お年寄りなんだから" },
    { "t": [81.4,  82.9], "ja": "さあ。はい、先ほど申し上げたとおり" },
    { "t": [82.9,  83.7], "ja": "ただいま実施中なのは…" },
    { "t": [83.7,  84.5], "ja": "ああ、もっと大きな声で話して" },
    { "t": [84.5,  86.3], "ja": "はい、当社の価格は過去最低です" },
    { "t": [86.3,  87.4], "ja": "君、もっと大きな声で" },
    { "t": [87.4,  88.5], "ja": "過去最低です" },
    { "t": [88.5,  89.5], "ja": "もっと大きく、君！" },
    { "t": [89.5,  90.3], "ja": "ケツナメ！" },
    { "t": [90.3,  92.3], "ja": "当社の価格は過去最低です！" },
    { "t": [92.3,  93.1], "ja": "よし、そこまで" },
    { "t": [93.1,  95], "ja": "おい！" },
    { "t": [95,  97.3], "ja": "それは完全に不適切だ" },
    { "t": [97.3,  98.6], "ja": "お客さんに怒鳴っちゃだめだ、絶対にだめだ" },
    { "t": [98.6,  100.4], "ja": "いいか、よく聞きなさい" },
    { "t": [100.4,  101.2], "ja": "始まったぞ" },
    { "t": [101.2,  103.3], "ja": "君を表す3つの言葉は" },
    { "t": [103.3,  106.6], "ja": "攻撃的、敵対的、そして間違いなく面倒、だ" },
    { "t": [106.6,  107.3], "ja": "お願いです、ケツナメさん。電話をよこせ" },
    { "t": [107.3,  109.8], "ja": "私は今、激怒している。どうかもう一度チャンスを" },
    { "t": [109.8,  110.7], "ja": "電話をよこせ" },
    { "t": [110.7,  111.5], "ja": "ケツナメさん！" },
    { "t": [111.5,  112.3], "ja": "電話をよこせ" },
    { "t": [112.3,  113.2], "ja": "上司に代わります" },
    { "t": [113.2,  114.4], "ja": "ああ、ぜひそうしてくれ" },
    { "t": [114.4,  115.3], "ja": "どなたかな？" },
    { "t": [115.3,  117.5], "ja": "もしもし、地域部長のマイケル・スコットです" },
    { "t": [117.5,  119.7], "ja": "ああ、私はウィリアム・ケツナメだ" },
    { "t": [119.7,  120.7], "ja": "こんにちは、ケツナメさん" },
    { "t": [120.7,  122.5], "ja": "どういったご用件でしょう？" },
    { "t": [122.5,  124.1], "ja": "マイケル、君の声の感じが気に入った" },
    { "t": [124.1,  125.2], "ja": "どうするか分かるか？" },
    { "t": [125.2,  127.7], "ja": "今日、100万ドル分の紙製品を買おう" },
    { "t": [129.8,  130.9], "ja": "どうやるか分かったか？" },
    { "t": [130.9,  132.3], "ja": "誠にありがとうございます" },
    { "t": [132.3,  133.7], "ja": "後悔はさせませんよ" },
    { "t": [133.7,  134.5], "ja": "私が何をしたか分かるか？" },
    { "t": [134.5,  135.3], "ja": "あなたは達人です" },
    { "t": [135.3,  136.3], "ja": "ひとつ条件がある、マイケル" },
    { "t": [136.3,  137.1], "ja": "はい" },
    { "t": [137.1,  139.2], "ja": "私をあんなにひどく扱った営業マンをクビにしてくれ" },
    { "t": [139.2,  140], "ja": "やめてください、マイケル" },
    { "t": [141.8,  143.7], "ja": "100万ドルの売り上げだぞ" }
  ]
}
