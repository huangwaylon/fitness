  "lines": [
    { "t": [0, 5], "ja": "やあ、トム・ハヴァフォードが「恋人のこと分かってる？」で戻ってきたよ" },
    { "t": [5, 7], "ja": "次の質問に行こう" },
    { "t": [7, 10], "ja": "恋人といちゃつくのに一番好きな場所は？" },
    { "t": [10, 12], "ja": "ドナ" },
    { "t": [12, 13], "ja": "私のベンツの後部座席" },
    { "t": [13, 15], "ja": "恋人に聞いてみよう" },
    { "t": [15, 18], "ja": "メルセデスの中だって！" },
    { "t": [18, 21], "ja": "ジェリーとドナ、絶好調" },
    { "t": [21, 22], "ja": "エイプリル？" },
    { "t": [22, 23], "ja": "この質問、気持ち悪い" },
    { "t": [23, 24], "ja": "それが狙いなんだよ" },
    { "t": [24, 25], "ja": "答えは？" },
    { "t": [25, 28], "ja": "私たちのベッドかな" },
    { "t": [28, 29], "ja": "アンディ？" },
    { "t": [29, 31], "ja": "恋人が一番好きないちゃつく場所は？" },
    { "t": [31, 33], "ja": "ニュートラル・ミルク・ホテル" },
    { "t": [33, 34], "ja": "もう、いいかげんにしてよ" },
    { "t": [34, 35], "ja": "いや、そっちこそいいかげんにしろよ" },
    { "t": [35, 36], "ja": "僕より、ほかの男のバンドのほうが好きなんだろ" },
    { "t": [36, 38], "ja": "マウス・ラットが世界一のバンドだって、そもそも思ってる？" },
    { "t": [38, 39], "ja": "だって、だんだんそうは思えなくなってきてるんだ" },
    { "t": [39, 41], "ja": "あのバンドは私にとってすごく大事なの" },
    { "t": [41, 43], "ja": "それに正直、もう何百回も聴いてって頼んだのに" },
    { "t": [43, 44], "ja": "一度も聴いてくれないじゃない" },
    { "t": [44, 47], "ja": "だって、あの音楽は暗くて、気がめいって、変なんだもん" },
    { "t": [47, 50], "ja": "芸術ってのは楽しくて明るいものだろ" },
    { "t": [50, 52], "ja": "みんな知ってるよ" },
    { "t": [52, 53], "ja": "あのさ" },
    { "t": [53, 55], "ja": "どうでもいい、もういいよ" },
    { "t": [55, 57], "ja": "ああ、もういいよ" },
    { "t": [57, 58], "ja": "すげえ！" },
    { "t": [58, 60], "ja": "このゲーム、盛り上がってきた" },
    { "t": [60, 62], "ja": "トミー・ヒルフィガーのアイフォンアプリ" },
    { "t": [62, 63], "ja": "やっとだ" },
    { "t": [63, 68], "ja": "ねえ、あなたのくだらない「恋人のこと分かってる？」ゲームのせいで、アンディと大げんかしたの" },
    { "t": [68, 71], "ja": "彼、ギターを売っちゃって、もう音楽をやめるとか言ってるの" },
    { "t": [71, 73], "ja": "で、僕にどうしろって言うの？" },
    { "t": [73, 77], "ja": "よし、超すごいボーナス早押しラウンドへようこそ" },
    { "t": [77, 78], "ja": "第1問" },
    { "t": [78, 83], "ja": "アンディ、恋人が宇宙一おいしいマカロニチーズを作るって言ったのは誰？" },
    { "t": [83, 84], "ja": "宇宙一？" },
    { "t": [84, 85], "ja": "おお" },
    { "t": [85, 86], "ja": "クラフト？" },
    { "t": [86, 87], "ja": "エイプリルの答えは…" },
    { "t": [87, 88], "ja": "アンディ！" },
    { "t": [88, 89], "ja": "史上最高のカップル" },
    { "t": [89, 90], "ja": "50点獲得" },
    { "t": [90, 91], "ja": "待って、なんで？" },
    { "t": [91, 92], "ja": "外れたのに" },
    { "t": [92, 93], "ja": "次の早押しの問題" },
    { "t": [93, 96], "ja": "世界一のコルツファンは誰？" },
    { "t": [96, 97], "ja": "ちょっと待って" },
    { "t": [97, 98], "ja": "僕が君に怒らなくなるように、全部仕組んだんだね" },
    { "t": [98, 99], "ja": "でも、おあいにくさま" },
    { "t": [99, 100], "ja": "そうはいかないよ" },
    { "t": [100, 101], "ja": "エイプリルがだまそうとしてるのを見破った" },
    { "t": [101, 102], "ja": "それは100点だ" },
