{
  "video": "er2IUxCT30U",
  "lines": [
    { "t": [0.9,1.8], "ja": "おはよう、アンディ" },
    { "t": [4.8,7.8], "ja": "よし、僕のパソコン、何かいつもと違うぞ" },
    { "t": [10,11.2], "ja": "あっ！" },
    { "t": [11.2,12], "ja": "なくなってる" },
    { "t": [14.6,17.5], "ja": "さあ、事件の始まりだ（言いまちがい）" },
    { "t": [17.5,19.8], "ja": "つまりね、警察学校の入学試験には" },
    { "t": [19.8,22.4], "ja": "犯罪の捜査っていうのがあるんだ" },
    { "t": [22.4,24.2], "ja": "だから1か月くらい前、オフィスのみんなに頼んだんだ" },
    { "t": [24.2,25.9], "ja": "いつか何か盗んでくれって" },
    { "t": [25.9,28.2], "ja": "僕の机から。練習できるようにね" },
    { "t": [28.2,29.7], "ja": "さあ、やるぞ" },
    { "t": [30,33.2], "ja": "待って、ねえ、私のめがねも取った？" },
    { "t": [33.2,35.3], "ja": "俺はサングラスも持ってるぞ" },
    { "t": [35.3,37.7], "ja": "先週末はマイアミにいたんだ" },
    { "t": [37.7,39.7], "ja": "サウスビーチで本領発揮してきたよ" },
    { "t": [39.7,41.2], "ja": "マイアミでは何をして過ごしてるの？" },
    { "t": [41.2,43.1], "ja": "盗んだパソコンを売りさばいてるとか？" },
    { "t": [43.1,45.7], "ja": "そうだよ、君の役所のパソコンを" },
    { "t": [45.7,49], "ja": "インディアナからマイアミまで持っていって" },
    { "t": [49,52.6], "ja": "闇市場で150ドルで売ったんだ" },
    { "t": [52.6,53.5], "ja": "はは！" },
    { "t": [53.5,56], "ja": "自分では気づいてないだろうけど、今ボロを出したね" },
    { "t": [56,59.3], "ja": "一日中、君の資料を見てたんだ" },
    { "t": [59.3,62.7], "ja": "ジェリー、それが本名ならね" },
    { "t": [62.7,63.5], "ja": "違うよ" },
    { "t": [63.5,64.7], "ja": "本名はゲイリーだ" },
    { "t": [64.7,69], "ja": "じゃあ、ゲイリー、それが本名ならね" },
    { "t": [69,70.5], "ja": "誰かが僕のパソコンを盗んだんだ" },
    { "t": [70.5,72.9], "ja": "さあ、君が犯人なら、僕の目を見て" },
    { "t": [72.9,75.5], "ja": "法律で、僕に言わなきゃいけないことになってるんだ" },
    { "t": [75.5,77.5], "ja": "そうしないと、おとり捜査になっちゃうからね" },
    { "t": [77.5,78.8], "ja": "悪いね、アンディ" },
    { "t": [78.8,80.7], "ja": "僕じゃないよ" },
    { "t": [80.7,81.7], "ja": "あーあ" },
    { "t": [81.7,82.7], "ja": "本当に？" },
    { "t": [82.7,83.2], "ja": "違うよ" },
    { "t": [83.2,83.7], "ja": "そっか" },
    { "t": [83.7,84.7], "ja": "うん" },
    { "t": [84.7,86.2], "ja": "よし、ジェリーじゃないってことは分かった" },
    { "t": [86.2,87.2], "ja": "僕にうそをついてなければね" },
    { "t": [87.2,90.5], "ja": "人がうそをついても、僕は全然見抜けないんだ" },
    { "t": [90.5,92.6], "ja": "警察の仕事で、それが問題にならないといいんだけど" },
    { "t": [92.6,95.2], "ja": "警察の仕事で、それが問題にならないといいんだけど" },
    { "t": [95.2,97], "ja": "クリス・トレーガー" },
    { "t": [97,97.5], "ja": "うん" },
    { "t": [97.5,98.7], "ja": "やあ、アンディ" },
    { "t": [98.7,99.9], "ja": "君がやったのは分かってる" },
    { "t": [99.9,100.7], "ja": "何を？" },
    { "t": [100.7,102.9], "ja": "…" },
    { "t": [102.9,105.7], "ja": "とぼけたって、ハンサムぶったってだめだよ" },
    { "t": [105.7,108.4], "ja": "君は僕のパソコンを盗んだ。僕が警察の試験の" },
    { "t": [108.4,110.2], "ja": "練習をできるようにね" },
    { "t": [110.2,112.1], "ja": "君はセクシーなのと同じくらい有罪だ" },
    { "t": [112.1,115], "ja": "アンディ、別のパソコンも盗まれたって届けがあったよ" },
    { "t": [115,117.5], "ja": "中庭の向こう側の事務所から" },
    { "t": [117.5,121], "ja": "これは君の警察の訓練の一部じゃないと思う" },
    { "t": [121,123.1], "ja": "市役所に泥棒が入ったんだと思うよ" },
    { "t": [123.1,124.2], "ja": "うそかどうか分からないよ" },
    { "t": [124.2,124.9], "ja": "本当に？" },
    { "t": [124.9,125.8], "ja": "たぶんね" },
    { "t": [125.8,126.7], "ja": "本物の犯罪ってこと？" },
    { "t": [126.7,127.7], "ja": "それならもっといいじゃん" },
    { "t": [128.7,129.7], "ja": "どういう作戦でいきます、おまわりさん？" },
    { "t": [129.7,132.4], "ja": "周りを封鎖して、電話を何台か盗聴するとか" },
    { "t": [132.4,134.1], "ja": "あっ、そうだ、盗ませるためのおとりのパソコンを置いて" },
    { "t": [134.1,137.5], "ja": "先に爆薬を詰めておくのは？" },
    { "t": [137.5,139.7], "ja": "ドカーン、全員やっつける" },
    { "t": [139.7,140.9], "ja": "いや、そういうのは一切やらないよ" },
    { "t": [140.9,142.5], "ja": "アンディ、やる気があるのはすごくいいけど" },
    { "t": [142.5,144.1], "ja": "でも、そこまでのお金は本当にないんだ" },
    { "t": [144.1,145.9], "ja": "大がかりな捜査を始めるほどのね" },
    { "t": [147.1,150.1], "ja": "このばかな書類を書くだけで終わりなんですか？" },
    { "t": [150.1,151.4], "ja": "未来の警官として分かってほしいんです" },
    { "t": [151.4,152.6], "ja": "こいつを逃がすわけにはいかないんです" },
    { "t": [152.6,156.3], "ja": "いいか、警察の仕事のほとんどはこういうものなんだ" },
    { "t": [156.3,158.3], "ja": "ただ書類を書くだけ" },
    { "t": [158.3,160.6], "ja": "スーパーヒーローの出番じゃない" },
    { "t": [160.6,164], "ja": "それが退屈だと思うなら、別のことをしたほうがいいかもな" },
    { "t": [166.2,167.9], "ja": "犯人を探したほうがいいかもね" },
    { "t": [167.9,169.9], "ja": "彼の前向きな気持ちを盗んだ犯人を" },
    { "t": [177.1,178.1], "ja": "また次回" },
    { "t": [178.1,179.1], "ja": "じゃあね" }
  ]
}
