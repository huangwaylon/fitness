{
  "video": "1JAE8kM_Uy4",
  "lines": [
    { "t": [1,2.7], "ja": "お前は趣味が悪いな、スタンリー・ハドソン" },
    { "t": [2.7,4.2], "ja": "いや、あるさ" },
    { "t": [4.2,5.3], "ja": "何の話をしてるの？" },
    { "t": [5.3,7.7], "ja": "ある女優が、セクシーかどうか" },
    { "t": [7.7,9.1], "ja": "その女性って誰なんだ？" },
    { "t": [9.1,10.5], "ja": "ヒラリー・スワンク" },
    { "t": [10.5,12.6], "ja": "ああ、ヒラリー・スワンクね" },
    { "t": [14.6,15.6], "ja": "全然" },
    { "t": [15.6,17.5], "ja": "目はきれいだけどね" },
    { "t": [17.5,18.7], "ja": "前髪を下ろしたところ、見たことある？" },
    { "t": [18.7,20.1], "ja": "怪物みたいだよ" },
    { "t": [20.1,22.8], "ja": "みんな、彼女は美しい映画スターなんだから" },
    { "t": [22.8,25], "ja": "だから、もう仕事に戻ろうか" },
    { "t": [25,27.1], "ja": "彼女はすばらしい女優よ" },
    { "t": [27.1,28.2], "ja": "そういう話じゃない" },
    { "t": [28.2,29.2], "ja": "セクシーじゃないよ" },
    { "t": [29.2,30.3], "ja": "ああ、ありがとな、みんな" },
    { "t": [30.3,31.1], "ja": "分かった、分かった、分かった" },
    { "t": [31.1,32.8], "ja": "もう多数決で決めようよ" },
    { "t": [32.8,34.1], "ja": "それで終わりにしよう" },
    { "t": [34.1,35], "ja": "私は投票しない" },
    { "t": [35,35.9], "ja": "誰も気にしてないよ" },
    { "t": [35.9,37.7], "ja": "ヒラリー・スワンクはセクシーだと思う人？" },
    { "t": [37.7,38.6], "ja": "手を挙げて" },
    { "t": [41.1,43.3], "ja": "はい、じゃあヒラリー・スワンクはセクシーじゃないと思う人？" },
    { "t": [43.3,44.1], "ja": "手を挙げて" },
    { "t": [47.6,48.4], "ja": "5人" },
    { "t": [48.4,49.8], "ja": "5対5" },
    { "t": [49.8,51.4], "ja": "ありがとう、経理部" },
    { "t": [51.4,53], "ja": "で、どうする？" },
    { "t": [53,55.7], "ja": "僕たちはみんな、有名人のことを" },
    { "t": [55.7,58.3], "ja": "神話の登場人物みたいに見がちだと思うんだ" },
    { "t": [58.3,59.9], "ja": "本物の人間として見ていない" },
    { "t": [59.9,61.9], "ja": "だから、本物の人間として評価しないんだよ" },
    { "t": [61.9,63.2], "ja": "本気で言ってる？" },
    { "t": [63.2,65], "ja": "ジム、とにかく写真を見せてよ" },
    { "t": [65,65.9], "ja": "ケビン、ちょっと" },
    { "t": [65.9,66.7], "ja": "そうだ、黙れ、ケビン" },
    { "t": [66.7,69.2], "ja": "いや、でも、こいつがいろいろ難しいことを…" },
    { "t": [69.2,71.4], "ja": "直感の問題なんだよ" },
    { "t": [71.4,72.6], "ja": "それはもっともだ" },
    { "t": [72.6,73.1], "ja": "なあ、ケブ" },
    { "t": [73.1,74.1], "ja": "頼みがあるんだ" },
    { "t": [74.1,76.1], "ja": "目を閉じてみてくれ" },
    { "t": [78.9,79.9], "ja": "よし" },
    { "t": [79.9,85.1], "ja": "じゃあ、ヒラリー・スワンクが本当にこのオフィスに来たと想像して" },
    { "t": [85.1,88.1], "ja": "君のところに歩いてきて、こう言うんだ" },
    { "t": [88.1,92.1], "ja": "「ケビン・マローン、あなたのネットのプロフィールを読んだの" },
    { "t": [92.1,97.1], "ja": "今すぐあなたといちゃいちゃすること以上に、したいことなんてない」" },
    { "t": [97.1,98.7], "ja": "さあ、教えてくれ" },
    { "t": [98.7,100.7], "ja": "彼女はセクシーか？" },
    { "t": [100.7,102.3], "ja": "彼女とヤれるかじゃないぞ" },
    { "t": [102.3,102.39999999999999], "ja": "ルールは守れよ" },
    { "t": [102.39999999999999,103.3], "ja": "うそでしょ" },
    { "t": [103.3,104.3], "ja": "ああ" },
    { "t": [104.3,105.3], "ja": "あと少しだった" },
    { "t": [105.3,107.3], "ja": "みなさん、あれが偽物だったとはいえ" },
    { "t": [107.3,109.9], "ja": "もう一回どんでん返しがあるんじゃないかと、ずっと思ってたんですよ" },
    { "t": [109.9,113.9], "ja": "ヒラリー・スワンクが実は男だったってね" },
    { "t": [113.9,114.9], "ja": "ケビン" },
    { "t": [114.9,115.9], "ja": "よし" },
    { "t": [115.9,116.9], "ja": "（聞き取れない）" },
    { "t": [116.9,117.9], "ja": "（聞き取れない）" },
    { "t": [117.9,119.9], "ja": "（聞き取れない）" },
    { "t": [119.9,120.9], "ja": "（聞き取れない）" },
    { "t": [120.9,121.9], "ja": "（聞き取れない）" },
    { "t": [129.9,130.9], "ja": "（聞き取れない）" },
    { "t": [130.9,132.9], "ja": "（聞き取れない）" },
    { "t": [153.5,164], "ja": "ねえ、ちょっと" },
    { "t": [164,165.4], "ja": "違う、違う、違うって" },
    { "t": [165.4,167], "ja": "彼女はセクシーよ、いい？" },
    { "t": [167,170.3], "ja": "だって、ヒラリー・スワンクがセクシーじゃないって言うなら" },
    { "t": [170.3,171.8], "ja": "私もセクシーじゃないって言ってるのと同じだから" },
    { "t": [171.8,176.8], "ja": "だって、私は明らかにヒラリー・スワンクほどセクシーじゃないもの" },
    { "t": [176.8,180], "ja": "みなさん、世の中のケビンみたいな人たちに" },
    { "t": [180,183.6], "ja": "私たちのことを何か決めさせていいんですか？　どんなことでも？" },
    { "t": [183.6,187.9], "ja": "彼にはインターネットを全部使わせてもいないのに" },
    { "t": [187.9,189.2], "ja": "え、何？" },
    { "t": [189.2,190.4], "ja": "見て" },
    { "t": [190.4,193.3], "ja": "顔の左右がはっきり対称だ" },
    { "t": [193.3,198.8], "ja": "これは、科学的な基準であるコイノフィリアによる自然な魅力だ" },
    { "t": [198.8,202.9], "ja": "たくさんの顔の特徴を平均して合わせたような顔だちってことだ" },
    { "t": [202.9,206.9], "ja": "たしかに魅力的だが、セクシーではない" },
    { "t": [206.9,210], "ja": "私はね、もっと" },
    { "t": [210,212.2], "ja": "前向きに生きようとしているんだ" },
    { "t": [212.2,217], "ja": "あと、そうだな、20年か30年は残っている" },
    { "t": [217,222.9], "ja": "でも、うちの家系からすると、もっと短い" },
    { "t": [222.9,225.9], "ja": "昔のスタンリー・ハドソンなら、この女優について" },
    { "t": [225.9,228.9], "ja": "何か文句を見つけていただろう" },
    { "t": [228.9,233.2], "ja": "でも、そんな生き方はだめだ" },
    { "t": [233.2,240.2], "ja": "見てくれ、この健康的で、セクシーで、きれいで、強い若い女性を" },
    { "t": [240.2,241.9], "ja": "ほら、みんな" },
    { "t": [241.9,246.2], "ja": "彼女はセクシーだ" },
    { "t": [246.2,247.9], "ja": "おっ、これは何？" },
    { "t": [247.9,249.2], "ja": "ヒラリー・スワンク" },
    { "t": [249.2,250.2], "ja": "ああ、セクシーだね" }
  ]
}
