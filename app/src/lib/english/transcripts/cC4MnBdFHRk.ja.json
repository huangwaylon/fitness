    { "t": [155.6,  155.7], "ja": "（音楽）" },
    { "t": [165.6,  168], "ja": "（聞き取れない）" },
    { "t": [168.5,  169.5], "ja": "何かしないと" },
    { "t": [169.5,  171], "ja": "外のみんなが取り乱してる" },
    { "t": [171,  171.9], "ja": "これからどうなるのかって" },
    { "t": [172.9,  173.3], "ja": "よし" },
    { "t": [173.5,  175.5], "ja": "みんなの気をそらす何かが必要だ" },
    { "t": [176.1,  177.2], "ja": "ユーチューブに何か新しいのはない？" },
    { "t": [177.5,  177.8], "ja": "マイケル" },
    { "t": [177.8,  178.9], "ja": "面白くなくてもいいから" },
    { "t": [180,  181.1], "ja": "ああ、もう" },
    { "t": [181.2,  181.9], "ja": "考えられない" },
    { "t": [182,  183.1], "ja": "もっと何か要る" },
    { "t": [183.2,  184.4], "ja": "笑顔だけでも" },
    { "t": [184.8,  185], "ja": "聞いてください" },
    { "t": [185.6,  187.3], "ja": "ウォレスは、ただのうわさだって言ったんですよね？" },
    { "t": [187.6,  188.7], "ja": "だから、考える理由はないんです" },
    { "t": [188.7,  190], "ja": "会社が大丈夫じゃないなんて" },
    { "t": [190.3,  191.9], "ja": "だから、僕たちが普通に仕事を続ければ" },
    { "t": [192,  192.5], "ja": "あなたと僕でね" },
    { "t": [192.8,  193.6], "ja": "みんなもついてきます" },
    { "t": [193.9,  194.9], "ja": "猿は見たとおりにまねする" },
    { "t": [195,  195.5], "ja": "そうだ" },
    { "t": [195.7,  196.9], "ja": "猿がお前にオシッコをかける" },
    { "t": [197.4,  198.5], "ja": "韻を踏んでる" },
    { "t": [198.7,  198.9], "ja": "じゃあ" },
    { "t": [198.9,  201.2], "ja": "今日の予定は何だ？" },
    { "t": [201.4,  202.4], "ja": "今日は" },
    { "t": [202.4,  203.4], "ja": "月例の" },
    { "t": [203.4,  204.6], "ja": "社員会議があります" },
    { "t": [205.1,  205.7], "ja": "よし" },
    { "t": [206.7,  207.6], "ja": "会議室に集合だ" },
    { "t": [207.9,  208.6], "ja": "いいか、みんな" },
    { "t": [208.6,  210.3], "ja": "今のところ新しい情報はない" },
    { "t": [210.4,  212.1], "ja": "だから、みんな仕事を続けよう" },
    { "t": [212.4,  213.4], "ja": "確かに少し不安だが" },
    { "t": [213.5,  214.4], "ja": "仕事をすれば" },
