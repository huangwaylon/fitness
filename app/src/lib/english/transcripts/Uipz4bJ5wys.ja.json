{
  "video": "Uipz4bJ5wys",
  "lines": [
    { "t": [0,3.6], "ja": "で、これってどういう仕組み？" },
    { "t": [3.6,7], "ja": "はい、名札に名前を書いたら、それで準備完了です" },
    { "t": [7,11.6], "ja": "分かった。でも、とにかく誰にでも話しかけに行けばいいの？" },
    { "t": [11.6,15.1], "ja": "それとも、向こうから話しかけてくるのを待つの？" },
    { "t": [15.1,17.8], "ja": "男性の口説き方を私に聞いてるんですか？" },
    { "t": [17.8,19.3], "ja": "そっか、分かった" },
    { "t": [19.3,20.9], "ja": "まったく新しいアン・パーキンスよ" },
    { "t": [20.9,24.1], "ja": "思い切って外に出て、新しい人に会って" },
    { "t": [24.1,28.6], "ja": "気軽に楽しんでるの。でも、ぎこちないのよね" },
    { "t": [30,37.4], "ja": "ドナ、うそ、ここで会えるなんてすごくうれしい" },
    { "t": [37.4,39.7], "ja": "こういうのって、一人だと最悪だから" },
    { "t": [39.7,42.8], "ja": "何？" },
    { "t": [42.8,45], "ja": "自分が今どこにいるか分かってる？" },
    { "t": [45,46.1], "ja": "ここはジャングルなの" },
    { "t": [46.1,47.5], "ja": "ここに友達なんていない" },
    { "t": [47.5,49.6], "ja": "女はみんな、自分のことは自分で守るのよ" },
    { "t": [49.6,51.5], "ja": "冗談でしょ？" },
    { "t": [51.5,53.1], "ja": "冗談に見える？" },
    { "t": [53.1,55.9], "ja": "恋愛は奪い合いのゲームなの" },
    { "t": [55.9,59.6], "ja": "あなたが男をつかまえたら、私はその男をつかまえられない" },
    { "t": [59.6,63.4], "ja": "ここに来たのは、もっと冒険しなさいってあなたがアドバイスしてくれたからなのに" },
    { "t": [63.4,65], "ja": "じゃあ、もうひとつアドバイスしてあげる" },
    { "t": [65,67.5], "ja": "消えて" },
    { "t": [67.5,68.5], "ja": "こんにちは" },
    { "t": [68.5,69.5], "ja": "アンです" },
    { "t": [69.5,70.5], "ja": "ブライアン" },
    { "t": [70.5,71.3], "ja": "お仕事は？" },
    { "t": [71.3,73.3], "ja": "スポーツ用品店の店長です" },
    { "t": [73.3,74.3], "ja": "うそ" },
    { "t": [74.3,75.3], "ja": "私も" },
    { "t": [75.3,76.3], "ja": "本当に？" },
    { "t": [76.3,77.3], "ja": "どこの店？" },
    { "t": [77.3,78.3], "ja": "いや、違うの" },
    { "t": [78.3,80.3], "ja": "ちょっとからかっただけ" },
    { "t": [80.3,82.3], "ja": "何飲んでるの？" },
    { "t": [82.3,83.3], "ja": "うん" },
    { "t": [83.3,84.3], "ja": "え？" },
    { "t": [84.3,85.3], "ja": "ああ、分からない" },
    { "t": [85.3,87], "ja": "聞こえなかったの" },
    { "t": [87,90], "ja": "それで、ただ笑って「うん」って言ったの？" },
    { "t": [90,91], "ja": "うん" },
    { "t": [91,92], "ja": "ちょっと失礼" },
    { "t": [92,96], "ja": "今のは、人生で見た中でいちばんひどかった" },
    { "t": [96,97], "ja": "森の中で育ったの？" },
    { "t": [97,98], "ja": "ネルなの？" },
    { "t": [98,99], "ja": "映画の「ネル」の？" },
    { "t": [99,100.7], "ja": "腕がなまってるって言ったでしょ" },
    { "t": [100.7,105.4], "ja": "いいわ、ついてきて" },
    { "t": [105.4,110.7], "ja": "名前はいつも、ぐちゃぐちゃに書くの。読ませて、引き寄せて、相手に努力させるのよ" },
    { "t": [110.7,111.7], "ja": "ね" },
    { "t": [111.7,112.7], "ja": "分かった" },
    { "t": [112.7,113.7], "ja": "ジェムソンのショットを2つ" },
    { "t": [113.7,116.4], "ja": "目を合わせすぎないで" },
    { "t": [116.4,119.4], "ja": "相手がいると思わせるのはいいけど、いすぎてもだめ" },
    { "t": [119.4,120.4], "ja": "ありがとう" },
    { "t": [120.4,121.4], "ja": "今はいいかな" },
    { "t": [121.4,122.4], "ja": "私は…" },
    { "t": [122.4,123.4], "ja": "うん" },
    { "t": [123.4,124.4], "ja": "だって…" },
    { "t": [125.4,126.4], "ja": "よし" },
    { "t": [126.4,128.4], "ja": "やるわよ" },
    { "t": [130.4,131.4], "ja": "もしもし？" },
    { "t": [131.4,132.4], "ja": "もしもし、アン" },
    { "t": [132.4,133.4], "ja": "レスリーよ" },
    { "t": [133.4,134.4], "ja": "公園課のレスリー・ノープ" },
    { "t": [134.4,135.4], "ja": "うん、知ってる" },
    { "t": [135.4,136.4], "ja": "どこにいるの？" },
    { "t": [136.4,138.4], "ja": "エイプリルとアンディが今夜結婚するの" },
    { "t": [138.4,139.4], "ja": "え？" },
    { "t": [139.4,140.4], "ja": "うん、そうなの" },
    { "t": [140.4,141.4], "ja": "アン、こっちに来てほしいの" },
    { "t": [141.4,144.4], "ja": "彼にもう一度キスするとか、彼女にキスするとか、誰かにキスしてほしいの" },
    { "t": [144.4,145.4], "ja": "分からないけど" },
    { "t": [145.4,146.4], "ja": "アン、助けて" },
    { "t": [146.4,147.4], "ja": "いいね" },
    { "t": [147.4,149.4], "ja": "また会えるかもね" },
    { "t": [149.4,151.4], "ja": "今のはうまくいったよね？" },
    { "t": [151.4,152.4], "ja": "ええ" },
    { "t": [152.4,155.4], "ja": "ただ、ヘルペスに勝ったって得意げに言ってたけどね" },
    { "t": [155.4,157.4], "ja": "ごめんね、ドナ" },
    { "t": [157.4,158.4], "ja": "家に帰るわ" },
    { "t": [158.4,160.4], "ja": "アンディが結婚するって今知ったの" },
    { "t": [160.4,161.4], "ja": "だから？" },
    { "t": [161.4,163.4], "ja": "だから、元カレなのよ" },
    { "t": [163.4,165.4], "ja": "すごく長い間付き合ってたの" },
    { "t": [165.4,166.4], "ja": "なるほど" },
    { "t": [166.4,167.4], "ja": "何？" },
    { "t": [167.4,168.4], "ja": "何？" },
    { "t": [168.4,171.4], "ja": "いい？　あなたは若くてセクシーな医者でしょ" },
    { "t": [171.4,172.4], "ja": "実は看護師なの" },
    { "t": [172.4,173.4], "ja": "まあ、あなたのことはよく知らないけど" },
    { "t": [173.4,175.4], "ja": "気持ちは切り替えられるはずよ" },
    { "t": [175.4,178.4], "ja": "結婚したくもなかった男のことで、家に帰って落ち込みたいの？" },
    { "t": [178.4,182.4], "ja": "それとも、ずっとあなたを見てるあのかわいい男の子に話しかけて、電話番号を渡す？" },
    { "t": [182.4,187.4], "ja": "私が自分用にさらっていく前に" },
    { "t": [187.4,189.4], "ja": "分かった" },
    { "t": [189.4,190.4], "ja": "分かった" },
    { "t": [190.4,190.5], "ja": "ありがとう" }
  ]
}
