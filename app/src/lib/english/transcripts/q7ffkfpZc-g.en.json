{"video":"q7ffkfpZc-g","lines":[{"t":[0,7.8],"en":"Hello?"},{"t":[8.2,9.9],"en":"Hey, where the hell have you been?"},{"t":[10.4,12.4],"en":"Hey, I spent the night out."},{"t":[12.6,14.6],"en":"I met this cute bridesmaid."},{"t":[15,16.2],"en":"She is so..."},{"t":[16.2,17.5],"en":"I don't want to hear about her."},{"t":[18.1,20.7],"en":"Aw, Thieves, you know you're still my number one girl."},{"t":[22.1,24.5],"en":"No, no, we have an emergency, okay?"},{"t":[24.7,25.8],"en":"Rachel's coming to London."},{"t":[26.1,27],"en":"Oh, great!"},{"t":[28,29.6],"en":"Well, it's not great."},{"t":[29.8,32.1],"en":"No, she's coming to tell Ross that she loves him."},{"t":[32.4,33.4],"en":"But he loves Emily."},{"t":[33.7,34.7],"en":"I know that!"},{"t":[36,37.5],"en":"You have to stop her."},{"t":[37.6,38.7],"en":"She's gonna ruin the wedding."},{"t":[39.2,39.6],"en":"Okay."},{"t":[41.1,43.5],"en":"Okay, so I've done my part, okay?"},{"t":[43.6,45],"en":"It's your responsibility now."},{"t":[45.1,46.6],"en":"The burden is off me, right?"},{"t":[46.9,47.3],"en":"Right."},{"t":[48.1,49.3],"en":"So tell me about this girl."},{"t":[54,55.8],"en":"Hey, have you seen Monica?"},{"t":[56,56.7],"en":"I'm not seeing Monica."},{"t":[58,61.9],"en":"What?"},{"t":[62.3,62.5],"en":"What?"},{"t":[64,65.1],"en":"Look, we gotta find her."},{"t":[65.2,65.8],"en":"Phoebe just called."},{"t":[65.9,67.6],"en":"Rachel's coming to tell Ross she loves him."},{"t":[67.9,68.6],"en":"Oh, my God."},{"t":[68.7,69],"en":"I know."},{"t":[69.1,70],"en":"That's why we gotta find Monica."},{"t":[70.1,70.8],"en":"Do you know where she is?"},{"t":[70.8,71.4],"en":"No, okay?"},{"t":[71.5,72.3],"en":"What's with the third degree?"},{"t":[72.4,73.8],"en":"Why don't you shine a light in my eyes?"},{"t":[73.8,74.8],"en":"Thank you."}]}
