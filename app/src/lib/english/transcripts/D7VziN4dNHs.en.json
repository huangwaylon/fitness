{"video":"D7VziN4dNHs","lines":[{"t":[0,3],"en":"Ryan Howard, everybody. Good job."},{"t":[4.8,6.1],"en":"That's some fun stuff."},{"t":[6.7,7.8],"en":"Where's the website go?"},{"t":[8,8.9],"en":"As fast as possible."},{"t":[9.1,10.7],"en":"We want to start retraining people ASAP"},{"t":[10.7,12.5],"en":"so we can hit the ground running with the new system."},{"t":[12.7,13.4],"en":"Cool beans."},{"t":[14.9,15.6],"en":"We're screwed."},{"t":[16.2,16.7],"en":"Who is?"},{"t":[17.1,19.2],"en":"Us. You and me, the old-timers."},{"t":[19.4,21.2],"en":"I am not old. You are old."},{"t":[21.5,23.1],"en":"You are like 100."},{"t":[23.5,25],"en":"You're over 40. That's the cutoff."},{"t":[25.3,27.3],"en":"Are you listening to what he's saying?"},{"t":[28.1,29.7],"en":"Retraining. New system."},{"t":[30,32.5],"en":"Youth. I'm telling you, this kid is the Grim Reaper."},{"t":[33,34.2],"en":"You deal with this,"},{"t":[34.5,37.3],"en":"or you, me, Sammy, Phyllis, the chick he hit with the car,"},{"t":[37.8,38.3],"en":"we're goners."},{"t":[59.5,61.3],"en":"Creed?"},{"t":[61.7,62.2],"en":"Yes, sir."},{"t":[62.9,63.5],"en":"Everything okay?"},{"t":[63.9,64.7],"en":"Everything's cool, dude."},{"t":[65.5,66],"en":"I'm 30."},{"t":[67.1,68.3],"en":"Well, in November, I'll be 30."},{"t":[68.9,70.4],"en":"Yes, I understand that, David."},{"t":[70.6,72.9],"en":"I just felt that if we were to downsize Kelly"},{"t":[72.9,74.9],"en":"and then outsource customer service to India,"},{"t":[75,76.8],"en":"which a lot of companies..."},{"t":[76.8,79],"en":"yeah, no, Kelly, yes, Kelly's Indian."},{"t":[80.1,81.7],"en":"I understand that's confusing."},{"t":[83,84.9],"en":"Hey, brah, I've been meaning to ask you,"},{"t":[85.2,86.9],"en":"can we get some Red Bull for these things?"},{"t":[87.3,88.7],"en":"Sometimes a guy's got to ride the bull."},{"t":[89,89.4],"en":"Am I right?"},{"t":[90.4,91.1],"en":"Later, skater."},{"t":[91.1,92.1],"en":"I'm here."},{"t":[92.1,92.19999999999999],"en":"I'm here."}]}
