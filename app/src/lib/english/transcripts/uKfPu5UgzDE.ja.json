    { "t": [112.8, 113.8], "ja": "フィービー、聞いて" },
    { "t": [113.8, 115.8], "ja": "ただ、ごめんねって言いたかったの" },
    { "t": [115.8, 128.3], "ja": "対応が本当にひどかったし、うそをつくべきじゃなかった" },
    { "t": [128.3, 130.4], "ja": "じゃあ、どうするべきだったの？" },
    { "t": [130.4, 132.5], "ja": "えっと、私…本当のことを言うべきだった" },
    { "t": [132.5, 133.6], "ja": "うん" },
    { "t": [133.6, 135.6], "ja": "それは？" },
    { "t": [135.6, 142.5], "ja": "えっと、ほら、あなたと一緒に走りたくなかった理由は、えっと…" },
    { "t": [142.5, 148.1], "ja": "その、あなたの走り方が、ちょっとだけ…" },
    { "t": [148.1, 149.1], "ja": "それで？" },
    { "t": [149.1, 150.1], "ja": "だって、恥ずかしいの" },
    { "t": [150.1, 152.3], "ja": "みんな、私たちのことを変な人を見るみたいに見てたし" },
    { "t": [152.3, 153.5], "ja": "なんで気にするの？" },
    { "t": [153.5, 155.9], "ja": "だって、人だから" },
    { "t": [155.9, 158.6], "ja": "でも、知らない人で、もう二度と会わない人たちじゃない" },
    { "t": [158.6, 164], "ja": "そうだけど、それでも目のある人たちなの" },
    { "t": [164, 166.5], "ja": "まあ、私はミス…の隣を走っても恥ずかしくなかったけど" },
    { "t": [166.5, 171.9], "ja": "でも…ああ、そう" },
    { "t": [171.9, 175.5], "ja": "ううん、ううん、私と走るのが恥ずかしい理由は分かる" },
    { "t": [175.5, 176.5], "ja": "うん" },
    { "t": [176.5, 177.5], "ja": "そっか" },
    { "t": [177.5, 178.5], "ja": "あなたって堅苦しいのね" },
