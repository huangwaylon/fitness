    { "t": [105.8, 106.8], "ja": "フィービー" },
    { "t": [106.8, 107.8], "ja": "ちょっと話せる？" },
    { "t": [107.8, 108.8], "ja": "いいよ" },
    { "t": [108.8, 109.8], "ja": "よし" },
    { "t": [109.8, 111.8], "ja": "えっと、私…" },
