    { "t": [54.6, 55.4], "ja": "本当のことを言いなよ" },
    { "t": [55.4, 56.5], "ja": "うん" },
    { "t": [56.5, 57.9], "ja": "その通りね" },
    { "t": [57.9, 58.8], "ja": "その通り。本当のことを言うべきよね" },
    { "t": [58.8, 60], "ja": "やあ" },
    { "t": [60, 61], "ja": "やあ" },
    { "t": [61, 62], "ja": "やあ、フィーブス" },
    { "t": [62, 62.8], "ja": "モニカに転ばされたの" },
    { "t": [62.8, 64.6], "ja": "もう二度と走れないと思う。二度と" },
    { "t": [66.6, 68.6], "ja": "え？なんでそんなことしたの？" },
    { "t": [68.6, 70], "ja": "分からない" },
    { "t": [72, 74], "ja": "レイチェル、足首を両方痛めちゃってごめんね" },
    { "t": [74, 75], "ja": "片方よ" },
    { "t": [75, 76.3], "ja": "どうなるかな" },
    { "t": [84.3, 84.9], "ja": "あ！" },
    { "t": [84.9, 86.3], "ja": "ああ、うん" },
    { "t": [86.3, 87.3], "ja": "あら、やあ。私よ" },
    { "t": [87.3, 89.3], "ja": "今朝、あなたがランニングシューズを持って" },
    { "t": [89.3, 90.3], "ja": "こっそり出かけるのを見たの" },
    { "t": [90.3, 91.5], "ja": "うそついたのね" },
    { "t": [91.5, 92.5], "ja": "一人で走るために、うそをついたのね" },
    { "t": [92.5, 93.5], "ja": "違う、違うの、フィービー" },
    { "t": [93.5, 94.5], "ja": "違う、私は…違うの、あのね" },
    { "t": [94.5, 99.5], "ja": "私は…実は、走れるかどうか確かめてただけなの" },
    { "t": [99.5, 100.3], "ja": "それで、走れたの" },
    { "t": [100.3, 101.5], "ja": "やめてよ、レイチェル" },
    { "t": [101.5, 102.5], "ja": "私、ばかじゃないから" },
    { "t": [102.5, 103.5], "ja": "違うの" },
    { "t": [103.5, 103.6], "ja": "待って" },
    { "t": [103.6, 104.5], "ja": "フィービー" },
