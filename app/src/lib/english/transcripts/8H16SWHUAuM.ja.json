{
  "video": "8H16SWHUAuM",
  "lines": [
    { "t": [0,  3], "ja": "…" },
    { "t": [3,  4.5], "ja": "ばかげてる" },
    { "t": [4.5,  7], "ja": "何時に帰れるか、分かってるんですか？" },
    { "t": [7,  9.2], "ja": "残業が好きな人なんていない" },
    { "t": [9.2,  12.4], "ja": "誰よりも私が嫌だよ" },
    { "t": [12.4,  14.5], "ja": "今夜、予定はあるの？ いいえ、ありません" },
    { "t": [14.5,  15.8], "ja": "予定を入れるなって言ったの、覚えてます？" },
    { "t": [15.8,  17.2], "ja": "仕事があるからって" },
    { "t": [17.2,  19.7], "ja": "ああ、覚えてる" },
    { "t": [19.7,  22.6], "ja": "うーん、こんなのでたらめだ。でたらめだよ" },
    { "t": [22.6,  23.9], "ja": "なんで私たちはここにいるんだ？" },
    { "t": [23.9,  25.5], "ja": "本社に電話してやる" },
    { "t": [25.5,  26.9], "ja": "もう我慢できない" },
    { "t": [26.9,  29.2], "ja": "私は…ああ、本当に腹が立つ" },
    { "t": [29.2,  31.7], "ja": "スクラントン支店のマイケル・スコットだ" },
    { "t": [31.7,  33.3], "ja": "ああ、私たちは働きたくない" },
    { "t": [33.3,  35], "ja": "そう、働きたくないんだ" },
    { "t": [35,  37.5], "ja": "この人たちに不公平だ" },
    { "t": [37.5,  41], "ja": "この人たちは私の友人で、大切なんだ" },
    { "t": [41,  44.5], "ja": "我々はやらないぞ" },
    { "t": [44.5,  47.3], "ja": "みんな、今本社との電話を切ったところだ" },
    { "t": [47.3,  50.2], "ja": "それで、まあ、要するに言ってやったよ" },
    { "t": [50.2,  52.3], "ja": "残業の仕事なんか、クソくらえってね" },
    { "t": [52.3,  53.4], "ja": "楽しい金曜日を過ごしてくれ" },
    { "t": [53.4,  55.5], "ja": "ありがとう、マイケル。どうも" },
    { "t": [55.5,  56.5], "ja": "どうも。いい金曜を" },
    { "t": [56.5,  58.4], "ja": "いやあ、危ないところを逃れたね。そうだね" },
    { "t": [58.4,  59.9], "ja": "お祝いしよう" },
    { "t": [59.9,  61.9], "ja": "君とパムと私でカーサに行って" },
    { "t": [61.9,  63], "ja": "夕食とダンスと一杯、なんてどうだ？" },
    { "t": [63,  67.7], "ja": "あ、私… 予定はないって言ったよね" },
    { "t": [67.7,  69.6], "ja": "確かにそう言った" },
    { "t": [69.6,  73.7], "ja": "マイケルは僕とパムを、少なくとも9回は夕食に誘ってきた" },
    { "t": [73.7,  76.7], "ja": "そして毎回、なんとか断ってこられた" },
    { "t": [76.7,  79.2], "ja": "でも、彼には参ったと言うしかない" },
    { "t": [79.2,  82.9], "ja": "してやられたよ。だって、怪しいと思い始めてるんだ" },
    { "t": [82.9,  85.6], "ja": "本社からの仕事なんて、なかったんじゃないかって" },
    { "t": [85.6,  88.5], "ja": "マイケル、何時に行けばいいですか？" },
    { "t": [88.5,  90], "ja": "ドワイト、カップル限定なんだ" },
    { "t": [90,  92.4], "ja": "それに、ワイングラスが6つしかない" },
    { "t": [92.4,  95.3], "ja": "だから私とジャン、パムとジム" },
    { "t": [95.3,  97.6], "ja": "それにアンジェラとアンディだ" },
    { "t": [97.6,  99.9], "ja": "万歳！" },
    { "t": [99.9,  101.4], "ja": "気にしてるかって？ 招かれなかったことを" },
    { "t": [101.4,  102.9], "ja": "マイケルの夕食会に" }
  ]
}
