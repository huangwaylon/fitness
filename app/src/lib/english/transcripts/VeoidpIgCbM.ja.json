{
  "video": "VeoidpIgCbM",
  "lines": [
    { "t": [0, 2.8], "ja": "ねえ、来てくれてよかった。計画をおさらいしよう" },
    { "t": [2.8, 6.8], "ja": "わかった、君と僕はハーベイ・ジェームズ公園で星を見る" },
    { "t": [6.8, 10.8], "ja": "その間、僕の両親はリビングでじわじわ首を絞め合う" },
    { "t": [10.8, 13.6], "ja": "違う。7時にあなたのお母さんが来る" },
    { "t": [13.6, 15.9], "ja": "冷えた白ワインを渡すの" },
    { "t": [15.9, 18.4], "ja": "それで「あら、見て、私のママが来たわ」" },
    { "t": [18.4, 20.1], "ja": "二人とも教育者で母親なのよ" },
    { "t": [20.1, 21.4], "ja": "なんてすてきな偶然！" },
    { "t": [21.4, 24.3], "ja": "それから、あとでスティーブン・ワイアットが来る。あなたのお父さんね" },
    { "t": [24.3, 25.9], "ja": "うん、恐ろしい人だよ" },
    { "t": [25.9, 28.6], "ja": "少し世間話をして、30分後に" },
    { "t": [28.6, 31.4], "ja": "みんなに大きなサプライズを見せるの" },
    { "t": [31.4, 33.9], "ja": "「ノープ・ワイアット団結キルト」よ" },
    { "t": [33.9, 35.9], "ja": "ベンと私は二人の人生を織り合わせていくから" },
    { "t": [35.9, 37.7], "ja": "このキルトを織ったの" },
    { "t": [37.7, 41.5], "ja": "新しく結ばれた家族の一人一人を表してるのよ" },
    { "t": [41.5, 43.5], "ja": "私が作ったたとえの芸術作品の中で" },
    { "t": [43.5, 45.7], "ja": "これがだんぜん一番あったかいの" },
    { "t": [45.7, 47.5], "ja": "これはすごいね" },
    { "t": [47.5, 49.2], "ja": "でしょ。すごく頑張ったの" },
    { "t": [49.2, 51.8], "ja": "それに敬意を表して、絵を入れなかった人がいるの" },
    { "t": [51.8, 54.2], "ja": "世界でただ一人、あなたと同じくらいセクシーな男性" },
    { "t": [54.2, 54.9], "ja": "ジョー・バイデンよ" },
    { "t": [54.9, 56.2], "ja": "いや、入ってるよ、そこに" },
    { "t": [56.2, 57.7], "ja": "ああ、それはちっちゃいのだけよ" },
    { "t": [57.7, 61.7], "ja": "要するに、このキルトでワイアット一族はひとつになるの" },
    { "t": [61.7, 63], "ja": "きれいだね" },
    { "t": [63, 65], "ja": "で、ならないよ" },
    { "t": [65, 68], "ja": "はい、みなさん、サプライズがあります" },
    { "t": [68, 69.5], "ja": "じゃーん！" },
    { "t": [69.5, 73.5], "ja": "「ノープ・ワイアット団結キルト」です" },
    { "t": [73.5, 76.1], "ja": "二つの家族がひとつになることを表していて" },
    { "t": [76.1, 78.5], "ja": "結ばれた家族の一人一人に" },
    { "t": [78.5, 80], "ja": "専用のマスがあるの。ほら" },
    { "t": [80, 82.4], "ja": "まあ、すてきね" },
    { "t": [82.4, 83.2], "ja": "ありがとう、ママ" },
    { "t": [83.2, 85.5], "ja": "私のマスはどこ？" },
    { "t": [85.5, 87.5], "ja": "えっと、あなたは厳密に言うと…" },
    { "t": [87.5, 88.5], "ja": "厳密に言うと何？" },
    { "t": [88.5, 89.5], "ja": "厳密に言うと大人じゃない" },
    { "t": [89.5, 92.5], "ja": "これはとても思いやりのない見落としよ、レスリー" },
    { "t": [92.5, 95.5], "ja": "それに私に言わせれば、ウラニのマスがないなら" },
    { "t": [95.5, 97.5], "ja": "これは正式な団結キルトじゃないわ" },
    { "t": [97.5, 99.5], "ja": "ああ、またその話ね" },
    { "t": [99.5, 102.5], "ja": "わかった、ウラニのマスを作るわ" },
    { "t": [102.5, 104.3], "ja": "とっても、とっても簡単" },
    { "t": [104.3, 105.8], "ja": "はい" },
    { "t": [105.8, 107.3], "ja": "ほら、これがあなたのマスよ" },
    { "t": [107.3, 108.8], "ja": "ウラニってどういう意味？" },
    { "t": [108.8, 109.8], "ja": "「明るい」よ" },
    { "t": [109.8, 111.3], "ja": "そうね" },
    { "t": [111.3, 112.8], "ja": "よし" },
    { "t": [112.8, 114.3], "ja": "見て" },
    { "t": [114.3, 115.8], "ja": "団結！" },
    { "t": [115.8, 116.8], "ja": "こんなに簡単なのよ" },
    { "t": [116.8, 117.8], "ja": "ただ必要だったのは…" },
    { "t": [117.8, 118.8], "ja": "私のキルトに、あの人の名前はいらない" },
    { "t": [118.8, 119.8], "ja": "あなたのじゃ…" },
    { "t": [119.8, 121.8], "ja": "みんなのキルトなの" },
    { "t": [121.8, 122.8], "ja": "団結キルトなのよ" },
    { "t": [122.8, 124.8], "ja": "私のマスを作ってくれないなんて、ひどいと思う" },
    { "t": [124.8, 126.6], "ja": "大失敗だよ、これは" },
    { "t": [126.6, 127.9], "ja": "まったくだよ、スティーブ" },
    { "t": [127.9, 129.9], "ja": "ほら、ベン、みんな意見が一致してる" },
    { "t": [129.9, 130.9], "ja": "うまくいってるわ" }
  ]
}
