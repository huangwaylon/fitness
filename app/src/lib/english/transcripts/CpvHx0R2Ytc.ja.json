  "lines": [
    { "t": [0,2.8], "ja": "よし　形容詞" },
    { "t": [2.8,7.5], "ja": "えっと、背が高い　いや、いや　えっと、すてきな" },
    { "t": [7.5,10.9], "ja": "いいね　よし　準備はいい？" },
    { "t": [10.9,11.9], "ja": "うん" },
    { "t": [11.9,20.9], "ja": "背が高い男がすてきなビルに入り、とてもすてきな男を訪ねた" },
    { "t": [20.9,27.9], "ja": "おかけください、スミスさん　いいキャットフードはいかがですか？" },
    { "t": [27.9,31.3], "ja": "人を食べるキャットフードです" },
    { "t": [31.3,33.7], "ja": "猫を食べる人間フードはどう？" },
    { "t": [33.7,36.2], "ja": "アンディとアンジェラはとても幸せそうだ" },
    { "t": [36.2,38.8], "ja": "二人にひどいことが何も起きないといいが" },
    { "t": [41.5,43.6], "ja": "エクステラに乗ってると、たくさんの女性と出会えるんだ" },
    { "t": [43.6,46.1], "ja": "信号で止まって横を見ると" },
    { "t": [46.1,48.1], "ja": "となりにもエクステラがいるんだよ" },
    { "t": [48.1,50.2], "ja": "運転してるのはいつも女の子" },
    { "t": [50.2,52], "ja": "それで会話のきっかけができるってわけ" },
    { "t": [53.5,54.5], "ja": "傷" },
    { "t": [54.5,56.3], "ja": "あ、それはレーシングストライプだよ" },
    { "t": [56.3,57.7], "ja": "あ、バンパーが下がってる" },
    { "t": [57.7,59.7], "ja": "うーん、それはどうかな" },
    { "t": [59.7,60.7], "ja": "この車はポンコツだ" },
    { "t": [60.7,62.7], "ja": "ほとんどただ同然で買ってやる" },
    { "t": [62.7,63.7], "ja": "ほとんどって、どのくらい？" },
    { "t": [63.7,65.1], "ja": "では、選択肢を教えてやる" },
    { "t": [65.1,68.7], "ja": "部品にして売るか、崖から落とすか" },
    { "t": [68.7,72.2], "ja": "車の事故で死んでほしいやつに寄付するか" },
    { "t": [72.2,76.7], "ja": "それとも私に売るかだ　私なら農場の荷車として使ってやる" },
    { "t": [76.7,79.1], "ja": "ロバに引かせてな" },
    { "t": [79.1,80.1], "ja": "その中から選ばなきゃいけないの？" },
    { "t": [80.1,81.1], "ja": "そうだ" },
    { "t": [81.1,82.1], "ja": "その選択肢、もう一回言ってくれる？" },
    { "t": [82.1,83.1], "ja": "いいか" },
    { "t": [83.1,86.1], "ja": "今すぐ1500ドル値引きしろ" },
    { "t": [86.1,87.7], "ja": "そしたら私が引き取ってやる" },
    { "t": [87.7,89.1], "ja": "今すぐじゃなきゃだめだ" },
    { "t": [89.1,91.1], "ja": "えっと、中古車の相場表があるんだけど" },
    { "t": [91.1,92.1], "ja": "やろう" },
    { "t": [92.1,93.1], "ja": "さあ、やるぞ" },
    { "t": [93.1,97.1], "ja": "3、2、1、5、4、3、2、3" },
    { "t": [97.1,99.5], "ja": "さあ、さあ、さあ、言え" },
    { "t": [99.5,100.5], "ja": "今だ" },
    { "t": [100.5,101.5], "ja": "今すぐだ" },
    { "t": [101.5,102.5], "ja": "やれ" },
    { "t": [102.5,103.3], "ja": "握手しろ" },
    { "t": [103.3,104.5], "ja": "この車を私に売るんだ" },
    { "t": [104.5,105.5], "ja": "握手しろ" },
    { "t": [105.5,106.5], "ja": "うん" },
    { "t": [106.5,107.9], "ja": "よし" },
    { "t": [107.9,109.9], "ja": "ロッカ・ドゥーパ・ドゥーパ・ドゥーパ・アウ" },
    { "t": [109.9,111.1], "ja": "サッカ・ドゥープ・ドゥー" },
    { "t": [111.1,112.7], "ja": "あら、ドワイトは何してるの？" },
    { "t": [112.7,114.3], "ja": "ああ、たぶん大したことじゃないよ" },
    { "t": [114.3,116.5], "ja": "ロッカ・ドゥーパ・ドゥーパ・ドゥーパ・ドゥーパ・ドゥーパ・ドゥーパ" },
    { "t": [116.5,117.5], "ja": "シャカ！" },
    { "t": [119.3,120.5], "ja": "これはいったいどういうこと？" },
    { "t": [123.3,125.1], "ja": "僕の車を転売してもうけてるじゃないか" },
    { "t": [125.1,126.3], "ja": "もう私の車だ" },
    { "t": [126.9,130.9], "ja": "君の言ったことを元に取引したんだ" },
    { "t": [131.5,134.5], "ja": "まあ、売り手は気をつけろってことだ" },
    { "t": [134.5,138.9], "ja": "では、失礼する　イーベイで私の車をめぐる3人の入札合戦を見張らなきゃいけないんでな" },
    { "t": [141.3,142.5], "ja": "君に穴うめ遊びを用意したぞ" },
    { "t": [143.7,155.9], "ja": "アンディ・バーナードというバカで、間抜けで、とんまなやつが、ドワイトという頭がよくて有能な男にエクステラを売った" },
    { "t": [155.9,159.9], "ja": "ドワイトにとって最高の一日になりそうだ" }
