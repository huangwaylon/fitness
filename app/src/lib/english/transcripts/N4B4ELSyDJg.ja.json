{
  "video": "N4B4ELSyDJg",
  "lines": [
    { "t": [0,  1.7], "ja": "やあ、みんな。入って" },
    { "t": [1.7,  3.3], "ja": "みんな、俺はロスコー" },
    { "t": [3.3,  6.5], "ja": "ここグリズルの「イケてる新ネタ」担当の副社長だ" },
    { "t": [6.5,  8.9], "ja": "この会議では、気軽に電子タバコを吸って" },
    { "t": [8.9,  10.1], "ja": "くつろいでくれ" },
    { "t": [10.1,  11.5], "ja": "さあ、これ見て" },
    { "t": [11.5,  13.4], "ja": "レスリー・ノープが、いろんな人と会ってる" },
    { "t": [13.4,  15.5], "ja": "プレゼンをセクシーにしようとしてね" },
    { "t": [15.5,  18], "ja": "だから俺たち、ぶっ飛んだ頭脳竜巻を起こしたんだ" },
    { "t": [18,  19], "ja": "いい考え" },
    { "t": [19,  21.2], "ja": "セレブを呼んで、俺たちとつるんでもらうんだ" },
    { "t": [21.2,  22.9], "ja": "ちょっとだけね。それで、こう言ってもらう" },
    { "t": [22.9,  24.8], "ja": "「よう、みんな、グリズルと仲良くしようぜ」" },
    { "t": [24.8,  25.8], "ja": "有名人が必要なの" },
    { "t": [25.8,  28.3], "ja": "少数株主になってもらえば、グリズルの入札が有利になる" },
    { "t": [28.3,  30.4], "ja": "有名人は必要なのか？" },
    { "t": [30.4,  32.7], "ja": "私は派手さより質を好む" },
    { "t": [32.7,  35.6], "ja": "だから、署名を筆記体で書くのを拒否しているんだ" },
    { "t": [35.6,  37.8], "ja": "有名人は、こういうことには本当に役立つんです" },
    { "t": [37.8,  40.1], "ja": "ジェイ・ジーがいなければ、ネッツはブルックリンにいなかった" },
    { "t": [40.1,  42.5], "ja": "それにチックフィレイの売り上げは急上昇した" },
    { "t": [42.5,  43.8], "ja": "エルトン・ジョンが買ってからね" },
    { "t": [43.8,  46.4], "ja": "そのとおり。グリズルは、ここポーニーではよそ者だ" },
    { "t": [46.4,  48.3], "ja": "だから地元の有名人がいれば、みんなが" },
    { "t": [48.3,  50], "ja": "俺たちに安心してくれる" },
    { "t": [50,  52.4], "ja": "だから、地元の皆さんを呼んだんだ" },
    { "t": [52.4,  53.6], "ja": "脳みそをフル回転させてもらうためにね" },
    { "t": [53.6,  56.4], "ja": "私たちは地元の人間だから、アイデアを出してほしいって…" },
    { "t": [56.4,  57.8], "ja": "文脈で分かった" },
    { "t": [57.8,  59], "ja": "そう" },
    { "t": [59,  62.3], "ja": "有名人とつき合うことには、まったく興味がない" },
    { "t": [62.3,  64.1], "ja": "私が認める有名人は" },
    { "t": [64.1,  66.3], "ja": "家具職人のゲイリー・ノックス・ベネット" },
    { "t": [66.3,  69.9], "ja": "あの悪名高い「16ペニー釘の戸棚」の設計者だ" },
    { "t": [69.9,  72.7], "ja": "それと、マグナス。5本角と5本角の雄のヘラジカで" },
    { "t": [72.7,  74.8], "ja": "2年前に小屋の近くで見かけた" },
    { "t": [74.8,  78.1], "ja": "あの野郎を撃ったら、やつは角を" },
    { "t": [78.1,  80.1], "ja": "私の肉小屋のドアに突き刺してきた" },
    { "t": [80.1,  83.8], "ja": "いつか、マグナス、お前を上着にして着てやる" },
    { "t": [83.8,  88.3], "ja": "ハート・ハプリー、クレイジー・アワー・イン・ザ・ドゥーシュ、トム・ハヴァフォード" },
    { "t": [88.3,  90], "ja": "うれしいけど、僕を有名人と呼べるかは" },
    { "t": [90,  91], "ja": "分からないな" },
    { "t": [91,  92.3], "ja": "ああ、それ、君の字だよね" },
    { "t": [92.3,  97.8], "ja": "どれもいい案だけど、ポーニーで一番の大物を狙うべきだと思う" },
    { "t": [97.8,  98.8], "ja": "「ブラッシュ」のアナベル・ポーターだ" },
    { "t": [98.8,  103.3], "ja": "ヴィーガンのレシピと無意味な小物だらけの、あのおぞましいライフスタイル情報誌か？" },
    { "t": [103.3,  104.3], "ja": "却下だ" },
    { "t": [104.3,  105.3], "ja": "あの女は私の悪夢だ" },
    { "t": [105.3,  106.8], "ja": "えーと、彼女は大物なんだよ、ロン" },
    { "t": [106.8,  112.8], "ja": "「ブラッシュ」は、ベスト10記事部門のピューリッツァー賞を2年連続で取ったばかりなんだ" },
    { "t": [112.8,  113.8], "ja": "わあ" },
    { "t": [113.8,  116.8], "ja": "私たちが思い描く天国そのものね" },
    { "t": [116.8,  119.8], "ja": "男女兼用のリネンのチュニックまでね" },
    { "t": [119.8,  120.8], "ja": "アナベル、モン・シェリー！" },
    { "t": [120.8,  121.8], "ja": "こんにちは" },
    { "t": [121.8,  122.8], "ja": "ごめんなさい" },
    { "t": [122.8,  123.8], "ja": "私たちの集まりに遅れちゃって" },
    { "t": [123.8,  127.8], "ja": "放し飼いのオリーブオイルで、牡蠣用のフォークを磨いてたの" },
    { "t": [127.8,  128.8], "ja": "謝罪は受け入れる" },
    { "t": [128.8,  131.8], "ja": "そして、君が言った他のことには何の反応もない" },
    { "t": [131.8,  133.8], "ja": "どうしても聞きたいんですけど" },
    { "t": [133.8,  136.3], "ja": "今、何がはやってるんですか？" },
    { "t": [136.3,  144.3], "ja": "そうね、今シーズン私が気になってるのは、左右非対称のオーバーオール、アンゴラ毛の歯ブラシ" },
    { "t": [144.3,  147.3], "ja": "それに地元産のイタリア製ビーチサンダル" },
    { "t": [147.3,  150.3], "ja": "それと、飲み物にちょっと遊び心のあるブームが来てるの" },
    { "t": [150.3,  152.3], "ja": "豆乳もアーモンドミルクも飲んだでしょ" },
    { "t": [152.3,  157.3], "ja": "今度は最新の大ブーム、ビーフミルクを試して" },
    { "t": [157.3,  163.3], "ja": "アーモンドミルクを、生きている牛の小さな穴から搾り出したようなものよ" },
    { "t": [163.3,  169.8], "ja": "…" },
    { "t": [169.8,  170.8], "ja": "牛乳だ" },
    { "t": [170.8,  171.8], "ja": "違う" },
    { "t": [171.8,  172.8], "ja": "牛乳は1ガロン3ドル" },
    { "t": [172.8,  174.8], "ja": "アナベルの本格的な手搾り、歯から食卓へのビーフミルクは？" },
    { "t": [174.8,  176.8], "ja": "1ガロン60ドルだ" },
    { "t": [176.8,  177.8], "ja": "ええ" },
    { "t": [177.8,  179.8], "ja": "しかも順番待ちがあるの" },
    { "t": [179.8,  181.8], "ja": "この女性は商売を分かっている" },
    { "t": [181.8,  184.3], "ja": "グリズルの入札に参加できたら、すごくワクワクするわ" },
    { "t": [184.3,  186.3], "ja": "私の遊牧民テントで話し合いましょうか？" },
    { "t": [186.3,  187.3], "ja": "いいね" },
    { "t": [187.3,  188.8], "ja": "ロン！" },
    { "t": [188.8,  189.8], "ja": "よし" },
    { "t": [189.8,  191.8], "ja": "もう一回やってみよう" },
    { "t": [191.8,  192.3], "ja": "よし" },
    { "t": [192.3,  194.3], "ja": "全ページそろってる" },
    { "t": [194.3,  196.3], "ja": "ここにサインするだけだ" },
    { "t": [196.3,  197.8], "ja": "レスリーの計画はどうなってる？" },
    { "t": [197.8,  203.3], "ja": "何度も言うけど、彼女の計画をあなたと話す気はないし、あなたの計画を彼女と話す気もない" },
    { "t": [203.3,  204.3], "ja": "分かってもらえるでしょ" },
    { "t": [204.3,  205.3], "ja": "もちろん" },
    { "t": [205.3,  206.8], "ja": "テリー、レスリーは何を企んでる？" },
    { "t": [206.8,  208.8], "ja": "ああ、大きな記者会見の準備をしてるよ" },
    { "t": [208.8,  209.8], "ja": "テリー、ちょっと" },
    { "t": [209.8,  211.3], "ja": "記者会見か" },
    { "t": [211.3,  214.3], "ja": "つまり、入札を有利にする何かを見つけたってことね" },
    { "t": [214.3,  215.3], "ja": "ポーターさん！" },
    { "t": [215.3,  216.3], "ja": "ん？" },
    { "t": [216.3,  218.3], "ja": "これ以上話し合う必要はない" },
    { "t": [218.3,  220.3], "ja": "あなたがグリズルの入札の顔だ" },
    { "t": [220.3,  221.3], "ja": "素敵" },
    { "t": [221.3,  224.8], "ja": "じゃあ、熟成グラッパでお祝いの一杯といきましょう" },
    { "t": [224.8,  226.3], "ja": "よし、ここにサインすればいいの？" },
    { "t": [231.3,  232.3], "ja": "よし" },
    { "t": [232.3,  233.3], "ja": "はい、どうぞ" },
    { "t": [233.3,  234.3], "ja": "ああ、それは無効だよ" },
    { "t": [234.3,  235.3], "ja": "ああ、分かってる" }
  ]
}
