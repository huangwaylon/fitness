{
  "video": "EkZrJC4_xHA",
  "lines": [
    { "t": [0, 1.7], "ja": "あらら。あらら" },
    { "t": [1.7, 2.8], "ja": "誰に電話してるの？" },
    { "t": [2.8, 4.1], "ja": "誰かを密告してるんだ" },
    { "t": [4.1, 5.6], "ja": "密告屋だ！" },
    { "t": [5.6, 7.7], "ja": "密告屋だ！ケビン！" },
    { "t": [7.7, 9.8], "ja": "最高だよ、マイケル。密告屋ネタ、覚えてる？" },
    { "t": [9.8, 12.3], "ja": "分かった、伝えておく" },
    { "t": [12.3, 13.5], "ja": "あらら" },
    { "t": [13.5, 15.2], "ja": "誰が困ったことに？皆さん、聞いてください" },
    { "t": [15.2, 17.2], "ja": "2時間後に薬物検査の人たちが来て" },
    { "t": [17.2, 19.7], "ja": "全員の尿を検査します" },
    { "t": [19.7, 22.9], "ja": "何？何の話だ？" },
    { "t": [22.9, 25.4], "ja": "会社の方針で、敷地内で薬物が見つかったら" },
    { "t": [25.4, 29.5], "ja": "24時間以内に自動的に薬物検査が行われるんです" },
    { "t": [29.5, 30.8], "ja": "本当か、トビー？" },
    { "t": [30.8, 33.2], "ja": "ええ、就職の申込書に署名した時点で" },
    { "t": [33.2, 35.9], "ja": "抜き打ちの薬物検査に応じることに同意してるんです" },
    { "t": [38.3, 40.5], "ja": "二日前の夜、モンタージュ・マウンテン舞台芸術センターで" },
    { "t": [40.5, 42.3], "ja": "アリシア・キーズのコンサートに行ったんだ" },
    { "t": [42.3, 44.3], "ja": "通路側のいい席が取れてね" },
    { "t": [44.3, 46], "ja": "とにかく、前座が終わったあと" },
    { "t": [46, 48], "ja": "きれいな女の子が隣に座ったんだ" },
    { "t": [48, 50], "ja": "唇にピアスをした女の子とはなかなか知り合えないんだが" },
    { "t": [50, 51.6], "ja": "彼女はしてたんだよ" },
    { "t": [51.6, 53.4], "ja": "どうしてこうなったのかよく分からないんだが" },
    { "t": [53.4, 56.8], "ja": "彼女の友達の一人が何かを回し始めて" },
    { "t": [56.8, 58.5], "ja": "クローブのたばこだって言ってた" },
    { "t": [58.5, 60.8], "ja": "私もクローブのたばこだったと確信してる" },
    { "t": [60.8, 63.2], "ja": "その列のみんながやってたんだ" },
    { "t": [63.2, 65], "ja": "よし、皆さん、聞いてくれ" },
    { "t": [65, 67.4], "ja": "薬物検査は中止になった" },
    { "t": [67.4, 70], "ja": "その代わり、私が一人ずつ回って" },
    { "t": [70, 71.8], "ja": "目で見て確認する" },
    { "t": [71.8, 73.4], "ja": "いや、それはできませんよ。私にはできない？" },
    { "t": [73.4, 74.4], "ja": "ここは私のオフィスだぞ" },
    { "t": [74.4, 77.3], "ja": "いいえ、だめです。正式なものじゃないといけないし" },
    { "t": [77.3, 79.4], "ja": "尿じゃないといけないんです" },
    { "t": [84.4, 85.8], "ja": "あー、分かった" },
    { "t": [85.8, 86.9], "ja": "よし" },
    { "t": [92.8, 95.4], "ja": "じゃあ、セント・アンドリュースの案件で仕事を頼みたい" },
    { "t": [95.4, 96.7], "ja": "君の尿が必要だ" },
    { "t": [96.7, 98.4], "ja": "書類整理を頼みたい" },
    { "t": [98.4, 99.2], "ja": "どんな書類整理ですか？" },
    { "t": [99.2, 101.7], "ja": "それは…忘れてくれ。尿だけでいい" },
    { "t": [101.7, 104.2], "ja": "それは直接、検査の人に渡すものですよ" },
    { "t": [104.2, 105.4], "ja": "とにかく…" },
    { "t": [111.7, 113.3], "ja": "君の尿が必要なんだ" },
    { "t": [116.3, 117.4], "ja": "カップに入れて？" },
    { "t": [117.4, 118.6], "ja": "そう、カップに入れて" },
    { "t": [118.6, 119.8], "ja": "私たちは動物じゃないんだぞ、ドワイト" },
    { "t": [119.8, 120.9], "ja": "何のためですか？" },
    { "t": [120.9, 122.3], "ja": "君には関係ない" },
    { "t": [122.3, 123.2], "ja": "では、お断りします" },
    { "t": [123.2, 124.5], "ja": "分かった、よし" },
    { "t": [124.5, 131.8], "ja": "週末にアリシア・キーズのコンサートに行ったんだが" },
    { "t": [131.8, 135.8], "ja": "うっかりハイになったかもしれないんだ" },
    { "t": [135.8, 138.8], "ja": "唇にピアスをした女の子のせいで" },
    { "t": [138.8, 140], "ja": "本気ですか？" },
    { "t": [143.8, 147.5], "ja": "あの女性に、きれいな尿を渡さないといけないんだ" },
    { "t": [152.1, 153.5], "ja": "でも、それは違法ですよ" },
    { "t": [153.5, 154.7], "ja": "そういうふうに考えるな" },
    { "t": [154.7, 156.7], "ja": "つまり…" },
    { "t": [156.7, 158.4], "ja": "尿はあちこちに飛び散るものだろ" },
    { "t": [158.4, 159.8], "ja": "ほら、コントロールできない" },
    { "t": [159.8, 160.9], "ja": "ただ…" },
    { "t": [160.9, 161.8], "ja": "私の尿は無理です" },
    { "t": [161.8, 163.9], "ja": "カップが、たまたま尿の下にあるかもしれない" },
    { "t": [163.9, 165.1], "ja": "事故かもしれない" },
    { "t": [165.1, 167.8], "ja": "コンサートで無理やり薬をやらされたんですか？" },
    { "t": [167.8, 168.5], "ja": "いや、いや、ただ聞け" },
    { "t": [168.5, 169.4], "ja": "何か問題でも？" },
    { "t": [169.4, 170.4], "ja": "いいか。とにかく…" },
    { "t": [173.3, 174.5], "ja": "とにかくカップを満たしてくれ" },
    { "t": [180.1, 182.1], "ja": "マイケルに尿をあげたいですか？" },
    { "t": [184.1, 187.1], "ja": "彼が必要なだけ、尿を持っていってほしい" },
    { "t": [188.1, 189.9], "ja": "この件について、僕は許可しませんよ" },
    { "t": [189.9, 190.7], "ja": "分かってる" },
    { "t": [190.7, 191.8], "ja": "私が分かってないとでも思うのか？" },
    { "t": [191.8, 192.8], "ja": "分かってるか？" },
    { "t": [200.6, 203.6], "ja": "父の名前はドワイト・シュルートだった" },
    { "t": [203.6, 208.4], "ja": "祖父の名前もドワイト・シュルート" },
    { "t": [208.4, 210.8], "ja": "その父の名前は？" },
    { "t": [210.8, 214.2], "ja": "ドワイト・シュルート" },
    { "t": [214.2, 215.5], "ja": "アーミッシュだ" },
    { "t": [221.4, 223.1], "ja": "父のことは大好きだった" },
    { "t": [223.1, 225.3], "ja": "毎朝、夜明けに起きて" },
    { "t": [225.3, 227.7], "ja": "グレイビーソースをかけたビスケットを作ってくれた" },
    { "t": [227.7, 230.1], "ja": "小さい頃、父とはよく一緒にゲームをした" },
    { "t": [230.1, 233.1], "ja": "父はよくずるをしたが、私はそれを見破ったことがなかった" },
    { "t": [233.1, 236.2], "ja": "見破っていたはずだ。知ってさえいればな" },
    { "t": [236.2, 238.1], "ja": "何年もたってから父に教えられて" },
    { "t": [238.1, 239.5], "ja": "知った時はショックだった" },
