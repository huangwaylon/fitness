    { "t": [221.4,  225.4], "ja": "えーと、今日ご予定の注文は、どれでも無料でお届けできます" },
    { "t": [225.4,  226.4], "ja": "もう" },
    { "t": [226.4,  227.4], "ja": "はい" },
    { "t": [227.4,  228.4], "ja": "はい" },
    { "t": [228.4,  229.4], "ja": "20箱ですか？" },
    { "t": [229.4,  230.4], "ja": "えー、できるのは…" },
    { "t": [230.4,  231.4], "ja": "少々お待ちください" },
    { "t": [231.4,  232.4], "ja": "ここ、ここ、ここ" },
    { "t": [232.4,  234.4], "ja": "20箱を1箱43ドルでご用意できます" },
    { "t": [234.4,  235.4], "ja": "書いて" },
    { "t": [235.4,  236.4], "ja": "はい" },
    { "t": [236.4,  237.4], "ja": "何の保証かって？" },
    { "t": [237.4,  239.4], "ja": "その言葉を言うだけ" },
    { "t": [239.4,  244.4], "ja": "きっとご満足いただけると保証します" },
    { "t": [244.4,  248.4], "ja": "お客様の満足こそが、私たちの保証だから" },
    { "t": [248.4,  249.4], "ja": "保証します" },
    { "t": [249.4,  252.4], "ja": "こちらこそ、お取引を楽しみにしています" },
    { "t": [252.4,  253.4], "ja": "ありがとう、ラッセルさん" },
    { "t": [253.4,  254.4], "ja": "やった！" },
    { "t": [254.4,  255.4], "ja": "売れた！" },
    { "t": [255.4,  256.4], "ja": "やったね！" },
    { "t": [256.4,  257.4], "ja": "よし！" },
    { "t": [257.4,  258.4], "ja": "やったぞ！" },
    { "t": [258.4,  259.4], "ja": "彼女がやった！" },
    { "t": [262.4,  269.4], "ja": "この会社を救うのが、仕事とパンケーキだなんて、誰が思っただろう？" },
    { "t": [269.4,  273.4], "ja": "結局、今日はたしかに、いい時も悪い時もあった" },
    { "t": [273.4,  281.4], "ja": "うちのオフィスは決して広くないと気づいた。165平方フィートって広そうに聞こえるから意外だった" },
    { "t": [281.4,  284.4], "ja": "でも、うちには一番大きな心を持った人たちがいる" },
    { "t": [284.4,  285.4], "ja": "小さな会社にとって、それこそが本当に…" },
    { "t": [285.4,  294.4], "ja": "あ、トイレに行ってたんだ" },
    { "t": [294.4,  296.4], "ja": "本当に大事なことだ" }
