{
  "video": "mywMUBxoLrY",
  "lines": [
    { "t": [0,  4.4], "ja": "マイケル・スコット製紙会社へようこそ" },
    { "t": [6.8,  9], "ja": "私たちはその真ん中にいて" },
    { "t": [9.3,  14.5], "ja": "押し寄せる水が、私たちの会社を海へと運んでいく" },
    { "t": [14.9,  15.8], "ja": "これからどうする？" },
    { "t": [16.7,  20.6], "ja": "待つんだ。パンケーキ昼食会に人が来てくれるのを願って" },
    { "t": [21.1,  24.4], "ja": "さあね。その日のための準備は、できることを全部やったと思う" },
    { "t": [25.1,  26.8], "ja": "取引先の連絡先も更新したし" },
    { "t": [26.8,  29], "ja": "仕入れ先から見積もりも取ったし" },
    { "t": [29.8,  34.7], "ja": "盛大な開店パンケーキ昼食会のネット招待状も送った" },
    { "t": [34.7,  37.9], "ja": "参加が6人、未定が1人、不参加はたった11人" },
    { "t": [39.6,  46.2], "ja": "返事がないのが788人。でもそのうち782人は見てくれてる" },
    { "t": [47.2,  49.9], "ja": "これが大事なことか、デスクトップに裸の写真を貼るのが" },
    { "t": [50,  51.6], "ja": "タイの友だちのジャスミンと僕だよ" },
    { "t": [51.8,  53.7], "ja": "一日中、あなたの友だちのジャスミンの胸なんて見たくない" },
    { "t": [53.9,  56.6], "ja": "君だって少しは努力すれば、セクシーになれるのに" },
    { "t": [57.2,  58.9], "ja": "どうやって？ 髪を金髪に染めるとか？" },
    { "t": [58.9,  60.1], "ja": "これは日焼けだよ" },
    { "t": [60.5,  61.1], "ja": "ええ、そうでしょうね" },
    { "t": [61.8,  63.1], "ja": "二人にイライラするんだよ、ママ" },
    { "t": [63.5,  64.1], "ja": "二人ともだ" },
    { "t": [65.1,  68.3], "ja": "アールは自分がここにいるのはもったいないと思ってるし、ピーはジムがいないとつまらない" },
    { "t": [69,  70], "ja": "マイケル、聞こえてますよ" },
    { "t": [70.1,  71.6], "ja": "電話中なんだ、頼むよ" },
    { "t": [72.9,  74.1], "ja": "ママ、かけ直すよ" },
    { "t": [74.6,  75.6], "ja": "ピーが、すごく感じ悪いんだ" },
    { "t": [75.7,  81.2], "ja": "友だちを雇うのは間違いだってよく言うけど、そのとおりだ" },
    { "t": [81.6,  85.5], "ja": "親友を雇ってやったのに、この仕打ちか？" },
    { "t": [85.9,  86.8], "ja": "私の番よ" },
    { "t": [87.3,  88.2], "ja": "だめ、それは持っていかないで" },
    { "t": [88.2,  88.7], "ja": "返して" },
    { "t": [88.9,  89], "ja": "コピーを取ってきて" },
    { "t": [89,  89.8], "ja": "何のために返すの？" },
    { "t": [89.8,  90.7], "ja": "それで何するつもり？" },
    { "t": [90.8,  91.9], "ja": "また表計算を作るんだよ" },
    { "t": [91.9,  93.1], "ja": "ええ、そのとおり" },
    { "t": [93.1,  94], "ja": "コピーを取ってきてよ、秘書さん" },
    { "t": [94,  94.1], "ja": "私の番よ" },
    { "t": [94.1,  94.7], "ja": "ちょっと" },
    { "t": [94.8,  95], "ja": "いい？" },
    { "t": [95.2,  95.4], "ja": "ライアン！" },
    { "t": [95.4,  99.1], "ja": "マイケル・スコット製紙会社は、大きな間違いだったのかもしれない" },
    { "t": [100.1,  101.2], "ja": "私が出ていくべきだ" },
    { "t": [102.4,  106.5], "ja": "出ていって、自分の製紙会社を始めるべきだ" },
    { "t": [106.5,  107.2], "ja": "思い知らせてやる" },
    { "t": [109.1,  110.1], "ja": "無料のパンケーキをどうぞ" },
    { "t": [111.1,  112.5], "ja": "おいしいですよ" },
    { "t": [112.9,  114.1], "ja": "栄養たっぷり" },
    { "t": [115.1,  116.3], "ja": "無料です" },
    { "t": [117.4,  119], "ja": "お若い方、無料のパンケーキはいかが？" },
    { "t": [119.4,  120], "ja": "メッセージ打ってるんで" },
    { "t": [120.2,  121], "ja": "手をベタベタにしたくない" },
    { "t": [121,  123.3], "ja": "ライアン、その携帯はもういいだろ" },
    { "t": [123.6,  124.2], "ja": "ほら" },
    { "t": [124.7,  125.4], "ja": "シャツをズボンに入れろ" },
    { "t": [125.5,  126.5], "ja": "君はこの会社の顔なんだぞ" },
    { "t": [126.9,  129.6], "ja": "小さな会社ですが、名を上げようと意欲に燃えています" },
    { "t": [131,  131.8], "ja": "名刺はありますか？" },
    { "t": [133.8,  134.2], "ja": "ないね" },
    { "t": [134.2,  136.2], "ja": "名刺はないけど、もっといいものがあります" },
    { "t": [137.1,  138.9], "ja": "小さな紙切れです" },
    { "t": [139.1,  140.8], "ja": "分かった" },
    { "t": [142.7,  144], "ja": "これ、ひどいですよ、ボス" },
    { "t": [144.1,  147], "ja": "均等に焼けるように、丸く作らないと" },
    { "t": [147.2,  148.1], "ja": "紙の形をしてるんです" },
    { "t": [148.3,  149.3], "ja": "こんなの、欲しくもない" },
    { "t": [153.5,  154.6], "ja": "子どもに持って帰るよ" },
    { "t": [169.1,  176.6], "ja": "前に、ピーナッツバターとツナのサンドイッチを食べる夢を見たことがある。言っておくけど" },
    { "t": [176.7,  177.2], "ja": "おいしかったんだ" },
    { "t": [178.2,  181.5], "ja": "だから次の日、そのサンドイッチを作ってみた" },
    { "t": [181.5,  183], "ja": "そしたら現実では、ひどくまずいんだ" },
    { "t": [183,  188], "ja": "なぜこの話をするのかって？" },
    { "t": [188,  189.1], "ja": "電話に出て" },
    { "t": [189.1,  189.8], "ja": "ほら…" },
    { "t": [189.8,  191.2], "ja": "マイケル・スコット製紙会社" },
    { "t": [191.2,  191.9], "ja": "パムです" },
    { "t": [191.9,  194.4], "ja": "あ、こんにちは。パンケーキ昼食会のラッセルさんですね" },
    { "t": [194.4,  196.4], "ja": "お元気ですか？" },
    { "t": [196.4,  198.9], "ja": "ええ、私たちもぜひお取引したいです" },
    { "t": [198.9,  200.6], "ja": "どうすれば実現できますか？" },
    { "t": [200.6,  202.6], "ja": "無料配達があるって言って" },
    { "t": [202.6,  203.6], "ja": "無料配達なら、もうやってるよ" },
    { "t": [203.6,  204.4], "ja": "向こうはそれを知らないだろ" },
    { "t": [204.4,  207.4], "ja": "えーと、今日ご予定の注文は、どれでも無料でお届けできます" },
    { "t": [207.4,  208.4], "ja": "もう！" },
    { "t": [208.4,  209.4], "ja": "はい" },
    { "t": [209.4,  210.4], "ja": "20箱ですか？" },
    { "t": [210.4,  211.4], "ja": "えー、できるのは…" },
    { "t": [211.4,  212.4], "ja": "少々お待ちください" },
    { "t": [212.4,  213.4], "ja": "ここ、ここ、ここ" },
    { "t": [213.4,  215.4], "ja": "20箱を1箱43ドルでご用意できます" },
    { "t": [215.4,  216.4], "ja": "よかった" },
    { "t": [216.4,  217.4], "ja": "ええ、私たちもぜひお取引したいです" },
    { "t": [217.4,  218.4], "ja": "どうすれば実現できますか？" },
    { "t": [218.4,  219.4], "ja": "無料配達があるって言って" },
    { "t": [219.4,  220.4], "ja": "無料配達なら、もうやってるよ" },
