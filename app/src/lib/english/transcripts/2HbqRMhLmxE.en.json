{"video":"2HbqRMhLmxE","lines":[{"t":[0,2],"en":"-Tammy?"},{"t":[2,4],"en":"-Tammy?"},{"t":[4,6],"en":"-Ronnie?"},{"t":[6,7],"en":"-What's going on?"},{"t":[7,9],"en":"-Welcome to the Battle Royale."},{"t":[9,11],"en":"Right here, right now."},{"t":[11,15],"en":"Operation Soaring Falcon is in its final stages."},{"t":[15,18],"en":"-It's time to settle this."},{"t":[18,21],"en":"-Ah."},{"t":[21,23],"en":"An old-fashioned prairie drink-off."},{"t":[23,25],"en":"-Oh, what's in that jug?"},{"t":[25,27],"en":"It smells like jet fuel."},{"t":[27,29],"en":"-That's Swanson family mash liquor."},{"t":[29,32],"en":"Made from the finest corn ever grown on American soil."},{"t":[32,36],"en":"Its only legal use is to strip varnish off of speedboats."},{"t":[36,38],"en":"-If you win, he's all yours."},{"t":[38,41],"en":"And if I win, I bring him back to the farm for good."},{"t":[41,43],"en":"-Wait, what? That wasn't the deal."},{"t":[43,44],"en":"-Pour it. I'm thirsty."},{"t":[44,46],"en":"-Pour me one, too, then. Let me in here."},{"t":[46,51],"en":"I'm gonna join you, and if I win, Ron stays here with us."},{"t":[51,53],"en":"-Leslie, no, don't drink that."},{"t":[53,56],"en":"We use it to burn warts off of the mules."},{"t":[58,68],"en":"-Poison!"},{"t":[68,69],"en":"Ugh!"},{"t":[69,70],"en":"I made a mistake."},{"t":[70,72],"en":"I made a mistake."},{"t":[72,73],"en":"-Had not?"},{"t":[73,79],"en":"Of this watered-down baby formula?"},{"t":[79,80],"en":"Not even close."},{"t":[80,81],"en":"-Not even close."},{"t":[81,83],"en":"-Not even close."},{"t":[83,86],"en":"Marvin close."},{"t":[86,88],"en":"Glenn close."},{"t":[88,90],"en":"-Leslie, you don't have to do this."},{"t":[90,92],"en":"-Shh. Go to bed, Jimmy."},{"t":[95,96],"en":"-Wah!"},{"t":[96,97],"en":"I can't feel my face."},{"t":[97,99],"en":"My face is numb."},{"t":[99,107],"en":"-What is that?"},{"t":[107,109],"en":"-Everybody pants now."},{"t":[109,111],"en":"Pants, pants, pants, pants, pants."},{"t":[111,112],"en":"-She's had enough."},{"t":[112,113],"en":"Call it off."},{"t":[113,114],"en":"-That's not how it works."},{"t":[114,115],"en":"She's out."},{"t":[115,116],"en":"-Wait, I'm subbing in."},{"t":[116,117],"en":"-April, no."},{"t":[117,119],"en":"That stuff will melt the shell off a garden snail."},{"t":[119,120],"en":"-Whatever."},{"t":[120,121],"en":"I'm Puerto Rican."},{"t":[121,122],"en":"I can handle it."},{"t":[125,126],"en":"Oh, ."},{"t":[129,130],"en":"-Okay."},{"t":[130,131],"en":"This ends now."},{"t":[150,151],"en":"-Duck."},{"t":[151,152],"en":"-Mom."},{"t":[152,154],"en":"You're going back to the farm."},{"t":[154,155],"en":"And you?"},{"t":[155,156],"en":"-Hmm."},{"t":[156,157],"en":"-You're going back to hell."},{"t":[157,158],"en":"-Fine."},{"t":[158,159],"en":"-That's not what I came for, anyway."},{"t":[159,160],"en":"I found your underground safe."},{"t":[160,162],"en":"I stole half your gold."},{"t":[162,163],"en":"-That's decoy gold."},{"t":[163,166],"en":"You think I'd leave my gold in a locked safe buried underground"},{"t":[166,168],"en":"where anyone could find it?"},{"t":[168,170],"en":"You don't know me at all."},{"t":[170,171],"en":"-Yes, I do."},{"t":[171,172],"en":"I knew you."},{"t":[172,175],"en":"The minute you were born, I intend to be there the minute you die."},{"t":[179,181],"en":"-Ron, your family's weird."},{"t":[192,193],"en":"Bye-bye."}]}
