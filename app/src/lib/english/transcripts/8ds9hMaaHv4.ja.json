{
  "video": "8ds9hMaaHv4",
  "lines": [
    { "t": [0, 3.8], "ja": "マイケルは俺たちに打ち解けてほしいんだって。だから話題がいる" },
    { "t": [3.8, 6], "ja": "ポニー。だめ" },
    { "t": [6, 8.3], "ja": "虹はどうだ？だめ" },
    { "t": [8.3, 10.3], "ja": "花。だめ" },
    { "t": [10.3, 12.8], "ja": "化粧。おい、けがするぞ" },
    { "t": [12.8, 14], "ja": "マイク。下がってろ" },
    { "t": [14, 15.8], "ja": "マイク、リフトから降りてくれ" },
    { "t": [15.8, 17.8], "ja": "おいおい。― 大丈夫、大丈夫だって" },
    { "t": [17.8, 19.8], "ja": "いくぞ。ちょっと…おい" },
    { "t": [19.8, 20.8], "ja": "降りろって…" },
    { "t": [20.8, 22.3], "ja": "うわ、うわ、うわ！" },
    { "t": [26.3, 27.8], "ja": "誰かに片付けさせよう" },
    { "t": [27.8, 30.6], "ja": "片付けるのは俺たちなんだよ" },
    { "t": [30.6, 32.6], "ja": "くそ、マイケル！" },
    { "t": [32.6, 35.6], "ja": "あれは使える状態にしておかないといけないんだ" },
    { "t": [35.6, 38.1], "ja": "さて、男同士の愚痴大会だ" },
    { "t": [38.1, 39.6], "ja": "始めよう" },
    { "t": [39.6, 43.6], "ja": "僕たちは確かに違う世界に住んでるけど" },
    { "t": [43.6, 45.6], "ja": "共通点もたくさんある" },
    { "t": [45.6, 49.1], "ja": "好きな女の子だって同じだったりする。一部はね" },
    { "t": [49.1, 50.6], "ja": "まあ、そういうこともある" },
    { "t": [50.6, 52.6], "ja": "ほら、俺たち男だからさ" },
    { "t": [52.6, 55.6], "ja": "なあ、俺、外そうか？" },
    { "t": [55.6, 58.4], "ja": "いや、なんで…いてもいいよ" },
    { "t": [58.4, 59.4], "ja": "俺が行くよ" },
    { "t": [59.4, 60.4], "ja": "いるか、それとも…" },
    { "t": [60.4, 62.1], "ja": "倉庫から始めよう" },
    { "t": [62.1, 64.6], "ja": "男として何が気に入らない？" },
    { "t": [64.6, 66.4], "ja": "俺が一番大事にしてるのは安全だ" },
    { "t": [66.4, 66.9], "ja": "うん" },
    { "t": [66.9, 68.9], "ja": "だから、誰かがここに来て" },
    { "t": [68.9, 71.4], "ja": "リフトを乗り回して、おもちゃみたいに遊ぶのは本当に気に入らない" },
    { "t": [71.4, 72.4], "ja": "ちょっとイラッとするんだよ、いいか？" },
    { "t": [72.4, 74.4], "ja": "うん、うん、うん、しーっ、しーっ、で…" },
    { "t": [74.4, 75.9], "ja": "おいおい、しーってするなよ" },
    { "t": [75.9, 77.4], "ja": "いや、それはただ…" },
    { "t": [77.4, 77.9], "ja": "それ、俺も嫌だ" },
    { "t": [77.9, 78.6], "ja": "息をしてただけだよ" },
    { "t": [78.6, 79.9], "ja": "パムにしーってされると、頭にくるんだ" },
    { "t": [79.9, 81.9], "ja": "しーってされるのは嫌だよな、そこなんだよ" },
    { "t": [81.9, 86.4], "ja": "よし、じゃあ…よし、人間の男として何が不満だ？" },
    { "t": [86.4, 88.7], "ja": "なあ、それはいい質問だな、ハッセルホフ" },
    { "t": [91.7, 92.2], "ja": "よし" },
    { "t": [92.2, 92.7], "ja": "何にイライラする？" },
    { "t": [92.7, 94.2], "ja": "よし、いいね" },
    { "t": [94.2, 95.7], "ja": "男同士でからかい合う" },
    { "t": [95.7, 98.7], "ja": "それが男のやることで、みんなそれが大好きなんだ" },
    { "t": [98.7, 102.1], "ja": "嫌なのはさ、女の子が新しいレストランに連れてけってせがむこと" },
    { "t": [102.1, 104.2], "ja": "週末の夜は毎回な。で、そのあと言うんだよ" },
    { "t": [104.2, 105.7], "ja": "「いつちゃんとしたデートに行くの？」って" },
    { "t": [105.7, 106.7], "ja": "ああ、それ俺も嫌だ" },
    { "t": [106.7, 107.7], "ja": "俺も嫌だ" },
    { "t": [107.7, 109], "ja": "最悪だよな" },
    { "t": [109, 110], "ja": "ほんと最悪" },
    { "t": [110, 112.5], "ja": "それに次の朝は教会まで車で送らされるしな" },
    { "t": [112.5, 114], "ja": "「ガソリンはタダじゃないんだぞ」って感じ" },
    { "t": [116.2, 117.5], "ja": "ああ、それに俺たちの給料だよ" },
    { "t": [117.5, 118.5], "ja": "何を期待してるんだって話だよ、わかるだろ？" },
    { "t": [118.5, 120.5], "ja": "毎週末連れていけってさ、わかるだろ？" },
    { "t": [120.5, 121], "ja": "わかるよ" },
    { "t": [121, 122], "ja": "金持ちじゃないんだ" },
    { "t": [122, 122.7], "ja": "わかるよ" },
    { "t": [122.7, 124.5], "ja": "いや、わかってない。あんたにはわからない" },
    { "t": [124.5, 126], "ja": "わかるわけないだろ？いいか" },
    { "t": [126, 127], "ja": "本当にわかるって意味じゃないよ" },
    { "t": [127, 130], "ja": "同じだって言うけど、もらう給料は全然違う" },
    { "t": [130, 130.5], "ja": "そうだ" },
    { "t": [130.5, 133.5], "ja": "俺たちはあんたと同じ時間働いてて、しかもあんたは俺たちのほうがずっと大変だって言った" },
    { "t": [133.5, 134.5], "ja": "えっと、実際そうだし…" },
    { "t": [134.5, 136.5], "ja": "でも給料はずっと少ない" },
    { "t": [136.5, 137.8], "ja": "その通り" },
    { "t": [137.8, 139], "ja": "福利厚生もほとんどない" },
    { "t": [139, 140.8], "ja": "だよな。まったく、何なんだよ" },
    { "t": [140.8, 141.8], "ja": "まさに" },
    { "t": [141.8, 142.8], "ja": "ひどいよ。ひどすぎるよ" },
    { "t": [142.8, 145.8], "ja": "なあ、組合があったら、こんなことにはならないぞ" },
    { "t": [145.8, 146.8], "ja": "そう、それだよ" },
    { "t": [146.8, 147.8], "ja": "おっ、おっ、おっ。そうだ" },
    { "t": [147.8, 148.8], "ja": "絶対にそうだ" },
    { "t": [148.8, 149.8], "ja": "いや、その通りだ" },
    { "t": [149.8, 151.8], "ja": "なあ、だから俺はずっとそう言ってたんだ" },
    { "t": [151.8, 152.8], "ja": "いよいよやらなきゃな" },
    { "t": [152.8, 154.3], "ja": "あのさ、それって必要？" },
    { "t": [154.3, 156.8], "ja": "だって、もう男の組合みたいなものがあるじゃない" },
    { "t": [156.8, 159.8], "ja": "必要どころじゃないよ、マイク。俺たちには必要なんだ" },
    { "t": [159.8, 162.8], "ja": "ロイ、港湾労働者の組合のカード、まだ持ってるか？" },
    { "t": [162.8, 163.8], "ja": "港湾労働者？" },
    { "t": [163.8, 167.1], "ja": "なあ、手配してくれよ。頼むよ" },
    { "t": [167.1, 170.1], "ja": "あのさ、問題は女の子たちだと思うんだ" },
    { "t": [170.1, 172.1], "ja": "問題は女の子たちだよ" },
    { "t": [172.1, 174.1], "ja": "女の子たちのせいにしないと" },
    { "t": [174.1, 177.1], "ja": "マイク、俺たちの味方か？" },
    { "t": [177.1, 178.1], "ja": "ああ" }
  ]
}
