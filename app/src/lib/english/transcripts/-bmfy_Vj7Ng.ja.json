{
  "video": "-bmfy_Vj7Ng",
  "lines": [
    { "t": [0.6,  3.7], "ja": "ジェリーをいじめるのが、世界で一番好きだった" },
    { "t": [3.7,  5.2], "ja": "あなたとイチャイチャするのの次にね" },
    { "t": [5.2,  7.4], "ja": "両方いっぺんにやったの、覚えてる？" },
    { "t": [7.4,  10.1], "ja": "彼、すごく気まずそうだった" },
    { "t": [10.1,  11.8], "ja": "悲しい日だな" },
    { "t": [11.8,  13], "ja": "これから誰をからかえばいいんだ？" },
    { "t": [13,  14], "ja": "心配いらないよ" },
    { "t": [14,  16.5], "ja": "私が働いたどの職場にも、ジェリーみたいな人がいた" },
    { "t": [16.5,  18.6], "ja": "ジェリーが一人いなくなると、職場は" },
    { "t": [18.6,  21.5], "ja": "自然と新しいジェリーを選んで、その役を埋めるんだ" },
    { "t": [21.5,  24.5], "ja": "社会的ダーウィニズムだよ。強い者が弱い者を食う" },
    { "t": [24.5,  28.8], "ja": "すぐに、君たちの誰かが容赦なく笑いものにされる" },
    { "t": [28.8,  32.8], "ja": "はは、自然の摂理だね" },
    { "t": [32.8,  38.8], "ja": "動物管理の報告書、これで最後です" },
    { "t": [38.8,  40.3], "ja": "何してるんだ、変なやつ" },
    { "t": [40.3,  42.8], "ja": "何もこぼさないようにしてるだけ" },
    { "t": [42.8,  45.8], "ja": "レスリーが、これを年ごとに整理しろって言ってたと思う" },
    { "t": [45.8,  46.8], "ja": "もうやってあるよ" },
    { "t": [46.8,  48.8], "ja": "「ファイルのやも」を2つ作った" },
    { "t": [48.8,  50.8], "ja": "「ファイルのやも」" },
    { "t": [50.8,  52.8], "ja": "「やまのやま」" },
    { "t": [52.8,  54.8], "ja": "「やまのやま」？ それも違うな" },
    { "t": [54.8,  55.8], "ja": "壊れちゃったの？" },
    { "t": [55.8,  57.6], "ja": "いや、何も問題ない" },
    { "t": [57.6,  60.6], "ja": "さて、新しいジェリーは決まりだな" },
    { "t": [60.6,  61.6], "ja": "いや、決まってない" },
    { "t": [61.6,  62.6], "ja": "ほとんど言い間違えてないし" },
    { "t": [62.6,  63.6], "ja": "言い間違えたよ" },
    { "t": [63.6,  65.6], "ja": "やめろ！" },
    { "t": [65.6,  67.6], "ja": "こうやって始まるんだ" },
    { "t": [67.6,  69.6], "ja": "次のジェリーが" },
    { "t": [69.6,  71.6], "ja": "たった一度、言い間違えただけで" },
    { "t": [71.6,  73.6], "ja": "30年後には水色のセーターベストを着て" },
    { "t": [73.6,  77.6], "ja": "ボニー・レイットと「ダ・ヴィンチ・コード」を音楽プレーヤーで聴いてるんだ" },
    { "t": [77.6,  83.6], "ja": "もう始まってる" },
    { "t": [83.6,  85.6], "ja": "おや、ファイロ・パイロじゃない" },
    { "t": [85.6,  86.6], "ja": "へえ、独創的だね、ドナ" },
    { "t": [86.6,  88.6], "ja": "それが流行るとでも思ってる？" },
    { "t": [88.6,  89.6], "ja": "ねえ、ペン" },
    { "t": [89.6,  91.6], "ja": "アンディを見て" },
    { "t": [91.6,  93.6], "ja": "おい、インクまみれだ" },
    { "t": [93.6,  94.6], "ja": "アンディが新しいジェリーだ" },
    { "t": [94.6,  95.6], "ja": "はい、決まり" },
    { "t": [95.6,  96.6], "ja": "最高" },
    { "t": [96.6,  98.6], "ja": "ほら、俺、巨大なイカみたい" },
    { "t": [98.6,  99.6], "ja": "ねえハニー、インクのドラキュラだぞ" },
    { "t": [99.6,  100.6], "ja": "だめ、やめて！" },
    { "t": [100.6,  103.6], "ja": "イカドラキュラが捕まえちゃうぞ！" },
    { "t": [103.6,  106.6], "ja": "見当違いだよ、ファイロ" },
    { "t": [106.6,  107.6], "ja": "どういう意味？" },
    { "t": [107.6,  109.6], "ja": "アンディは絶対に新しいジェリーにならない" },
    { "t": [109.6,  110.6], "ja": "何をされても恥ずかしがらないから" },
    { "t": [110.6,  112.6], "ja": "恥知らずの、でっかい子犬みたいなもんだ" },
    { "t": [112.6,  115.6], "ja": "必要なのは、職場に入る新しい獲物だよ" },
    { "t": [115.6,  117.6], "ja": "それか、僕をからかうのをやめればいいだろ" },
    { "t": [117.6,  120.6], "ja": "うん、それはない" },
    { "t": [120.6,  122.6], "ja": "今日は絶好調だな" },
    { "t": [122.6,  124.6], "ja": "ファイロ・パイロ" },
    { "t": [124.6,  125.6], "ja": "冗談だろ？" },
    { "t": [125.6,  129.6], "ja": "あの、ジェリーがいなくなったので、穴を埋める人を雇わないと" },
    { "t": [129.6,  130.6], "ja": "職場に新しい人を？" },
    { "t": [130.6,  131.6], "ja": "人じゃありません" },
    { "t": [131.6,  133.6], "ja": "インターンです" },
    { "t": [133.6,  135.6], "ja": "なんでわざわざインターンなんか取るんだ？" },
    { "t": [135.6,  138.6], "ja": "インターンは税金が一切かかりません" },
    { "t": [138.6,  141.6], "ja": "もっと大事なのは、たいてい頭が悪くてひどいので、仕事が全然進まないこと" },
    { "t": [141.6,  143.6], "ja": "給料のいらないジェリーみたいなもんです" },
    { "t": [143.6,  144.6], "ja": "やるじゃないか" },
    { "t": [144.6,  146.6], "ja": "実に説得力のある話だ" },
    { "t": [146.6,  147.6], "ja": "その調子だ、ファイロ" },
    { "t": [147.6,  150.6], "ja": "いつかこの政府を本当に壊せるかもな" },
    { "t": [154.6,  156.6], "ja": "ねえ、ここから抜け出さない？" },
    { "t": [156.6,  158.6], "ja": "仕事は始まったばかりですよ、ミーグルさん" },
    { "t": [158.6,  160.6], "ja": "そうね、でも私たちのお仕事はこれからよ" },
    { "t": [160.6,  161.6], "ja": "意味、わかるでしょ？" },
    { "t": [161.6,  163.6], "ja": "あら、ドナ、その新しい坊やは誰？" },
    { "t": [163.6,  165.6], "ja": "テイラーです、新しいインターンの" },
    { "t": [165.6,  166.6], "ja": "これが新しいインターン？" },
    { "t": [166.6,  167.6], "ja": "冗談だろ？" },
    { "t": [167.6,  169.6], "ja": "ええ、妹のナタリーと高校が一緒だったの" },
    { "t": [169.6,  170.6], "ja": "アメフト部のスターだったのよ" },
    { "t": [170.6,  173.6], "ja": "へえ、筋肉バカの体育会系か" },
    { "t": [173.6,  178.6], "ja": "実は、最終学年でアメフトはやめて、牧師のホームレス施設を手伝ってたんです" },
    { "t": [178.6,  181.6], "ja": "へえ、そんなにホームレスが好きなら、結婚すればいいのにな？" },
    { "t": [181.6,  183.6], "ja": "誰だって、彼と結婚できたら幸せよ" },
    { "t": [183.6,  185.6], "ja": "ねえテイラー、僕とエイプリルと結婚しない？" },
    { "t": [185.6,  186.6], "ja": "できたらいいんだけどね" },
    { "t": [186.6,  187.6], "ja": "でも、結婚するタイプじゃないんだ" },
    { "t": [187.6,  191.6], "ja": "愛はたくさんあるから、そこに線を引くのは不公平な気がしてさ" },
    { "t": [191.6,  192.6], "ja": "分かってるね" },
    { "t": [192.6,  193.6], "ja": "分かってる" },
    { "t": [193.6,  194.6], "ja": "すごく分かってる" },
    { "t": [199.6,  200.6], "ja": "ロン？" },
    { "t": [200.6,  201.6], "ja": "悲しいかって聞いてください" },
    { "t": [201.6,  202.6], "ja": "断る" },
    { "t": [202.6,  204.6], "ja": "ロン、僕が新しいジェリーなんです" },
    { "t": [204.6,  207.6], "ja": "で、泣き言を言えば何か変わるのか？" },
    { "t": [207.6,  209.6], "ja": "いじめられ役にはなりたくないだろう" },
    { "t": [209.6,  210.6], "ja": "自分で立ち向かえ" },
    { "t": [210.6,  211.6], "ja": "分かってないですよ、ロン" },
    { "t": [211.6,  213.6], "ja": "僕は前にもジェリーだったんです" },
    { "t": [213.6,  216.6], "ja": "サウスカロライナで、インド系のやせっぽちの子でした" },
    { "t": [216.6,  217.6], "ja": "最悪でしたよ" },
    { "t": [217.6,  218.6], "ja": "12年かかりました" },
    { "t": [218.6,  219.6], "ja": "でも、生まれ変わったんです" },
    { "t": [219.6,  220.6], "ja": "経営者になって" },
    { "t": [220.6,  221.6], "ja": "イケてるスーツを着て" },
    { "t": [221.6,  223.6], "ja": "毛皮の下着もはいてる" },
    { "t": [223.6,  225.6], "ja": "なのに、全部無駄だった" },
    { "t": [225.6,  227.6], "ja": "またジェリーに逆戻りだ" },
    { "t": [227.6,  228.6], "ja": "いいや" },
    { "t": [228.6,  231.6], "ja": "スウェットパンツとニコラス・スパークスの小説でも買ってきます" },
    { "t": [231.6,  233.6], "ja": "どうせなら、とことんなりきりますよ" },
    { "t": [233.6,  235.6], "ja": "トムは自分で何とかできる" },
    { "t": [235.6,  237.6], "ja": "大人の男だ" },
    { "t": [237.6,  238.6], "ja": "まあ、半人前だが" },
    { "t": [238.6,  242.6], "ja": "12歳の子に服を貸す商売をしてるくらいだからな" },
    { "t": [242.6,  244.6], "ja": "どうも" },
    { "t": [244.6,  245.6], "ja": "ここで何してるんだ、ジェリー？" },
    { "t": [245.6,  246.6], "ja": "クビになったと思ってた" },
    { "t": [246.6,  247.6], "ja": "クビじゃないよ" },
    { "t": [247.6,  248.6], "ja": "退職したんだ" },
    { "t": [248.6,  250.6], "ja": "みんなそう言うのよ" },
    { "t": [250.6,  252.6], "ja": "ジェリーを呼んだのは私だ" },
    { "t": [252.6,  255.6], "ja": "新しいインターンは使えなかったから、辞めさせた" },
    { "t": [255.6,  258.6], "ja": "改めて、断固として反対します" },
    { "t": [258.6,  260.6], "ja": "改めて、聞いておく" },
    { "t": [260.6,  263.6], "ja": "それと、ジェリーに週に数時間来てもらうことにした" },
    { "t": [263.6,  265.6], "ja": "正式な後任が見つかるまでな" },
    { "t": [265.6,  267.6], "ja": "えっ、やっと縁が切れたと思ったのに？" },
    { "t": [267.6,  268.6], "ja": "うーん、どうですかね、ロン" },
    { "t": [268.6,  269.6], "ja": "聞いてるのか、お前？" },
    { "t": [269.6,  272.6], "ja": "ジェリーは週に一度来る" },
    { "t": [272.6,  275.6], "ja": "そしてみんな、彼が食べるのを眺めたり、話しかけたりできる" },
    { "t": [275.6,  278.6], "ja": "彼のやること、言うこと、おならについて何でもな" },
    { "t": [278.6,  280.6], "ja": "おかえり、ジェリー" },
    { "t": [280.6,  281.6], "ja": "ああ、ありがとう" },
    { "t": [281.6,  282.6], "ja": "ああ、こうしてまた来られるだけで…" },
    { "t": [286.6,  287.6], "ja": "典型的な新入りね" }
  ]
}
