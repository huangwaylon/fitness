{
  "video": "C6Yx3f50e3M",
  "lines": [
    { "t": [0, 5.6], "ja": "それに、僕の新しいダーツボードで大会をやるのもいいかもね" },
    { "t": [5.8, 8], "ja": "どう？2日間ずっとダーツ" },
    { "t": [8.2, 8.9], "ja": "楽しいよ" },
    { "t": [11, 12.5], "ja": "来週末なら楽しそうだね" },
    { "t": [12.8, 14.5], "ja": "いやいや、違う、今週末だよ、みんな" },
    { "t": [14.7, 16], "ja": "来週末なら楽しそうだね" },
    { "t": [16.8, 18.7], "ja": "つまり、楽しそうってこと" },
    { "t": [22.7, 23.7], "ja": "どうしたの？" },
    { "t": [24, 27], "ja": "えっと、実は、まあ、スキーに誘われてて" },
    { "t": [27.4, 28.7], "ja": "ほら、レイチェルの姉妹の山小屋" },
    { "t": [29.7, 34.2], "ja": "ああ、いいよ" },
    { "t": [34.4, 36.9], "ja": "っていうか、みんなが最初の週末に出かけなきゃいけなくて" },
    { "t": [36.9, 38.4], "ja": "僕がひとりぼっちになるとしても、ね" },
    { "t": [38.5, 40.4], "ja": "それなら、全然、全然分かるよ" },
    { "t": [41.9, 43.8], "ja": "ねえ、私、残れるよ。残ることにする" },
    { "t": [44.3, 45.7], "ja": "だって、前にスキーに行った時" },
    { "t": [45.8, 47.4], "ja": "怖くてリフトから降りられなかったの" },
    { "t": [47.4, 48.3], "ja": "ずっとぐるぐる回ってた" },
    { "t": [50.8, 53], "ja": "フィービー、みんなを車で連れていってもらわないと困るんだ" },
    { "t": [53, 53.9], "ja": "おばあちゃんのタクシーでね" },
    { "t": [54, 55.7], "ja": "でも、ねえ、私が残るよ" },
    { "t": [55.9, 57], "ja": "いや、私が残る" },
    { "t": [57.7, 58.7], "ja": "私のお兄ちゃんだもん" },
    { "t": [59.2, 60.2], "ja": "何、同情して残るってこと？" },
    { "t": [60.5, 60.9], "ja": "違うよ" },
    { "t": [62.2, 63.6], "ja": "楽しくやろうよ" },
    { "t": [64.4, 65.9], "ja": "ファッジも作れるし" },
    { "t": [68.9, 69.7], "ja": "同情のファッジ？" },
    { "t": [71.2, 72.8], "ja": "いいか、大丈夫だから、いい？" },
    { "t": [72.9, 74.4], "ja": "誰にも残ってもらう必要はない、いい？" },
    { "t": [74.4, 75.4], "ja": "誰も残らなくていい" },
    { "t": [76.1, 78], "ja": "じゃあ、一応、残るって言っておこうかな" }
  ]
}
