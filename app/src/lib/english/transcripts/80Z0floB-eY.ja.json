{
  "video": "80Z0floB-eY",
  "lines": [
    { "t": [0,  2.2], "ja": "中ではすっかり取り乱してたね" },
    { "t": [2.2,  5.4], "ja": "分かってる、ごめん。でももう平気" },
    { "t": [5.4,  6.8], "ja": "ここからできるだけ早く出て" },
    { "t": [6.8,  8.9], "ja": "二度と戻ってこなければね" },
    { "t": [8.9,  9.9], "ja": "やあ、レスリー" },
    { "t": [11.8,  13.1], "ja": "デイブ。やあ" },
    { "t": [13.1,  16.1], "ja": "うそ、わあ" },
    { "t": [16.1,  17.3], "ja": "元気そうね" },
    { "t": [17.3,  20.7], "ja": "サンディエゴの太陽で、すっかり日焼けしたよ" },
    { "t": [20.7,  23.9], "ja": "で、今は何を…あ、ごめん、えーと、ベン" },
    { "t": [23.9,  26.7], "ja": "こちらは、えーと、私の…デイブ・サンダーソンよ" },
    { "t": [28.2,  30.3], "ja": "ああ、どうも。はじめまして" },
    { "t": [30.3,  33.8], "ja": "そう、レスリー・ノープは女性で" },
    { "t": [33.8,  36], "ja": "私が関係を持っていた人です" },
    { "t": [36,  38.3], "ja": "私たちは恋愛の" },
    { "t": [38.3,  42.2], "ja": "恋愛的な関係にありました。私がサンディエゴに移るまで" },
    { "t": [42.2,  45.4], "ja": "それはつまり、カリフォルニアにあって" },
    { "t": [45.4,  47.8], "ja": "ここから何マイルも南西です" },
    { "t": [47.8,  51], "ja": "なので、その時に関係を終わらせました" },
    { "t": [52.9,  54.3], "ja": "しばらくこっちにいるの？" },
    { "t": [54.3,  57], "ja": "いや、今夜だけ。署長の退職祝いでね" },
    { "t": [57,  59.6], "ja": "あ、そうなの、実は私たちも行くの" },
    { "t": [59.6,  60.7], "ja": "でも、少し後から行く予定" },
    { "t": [60.7,  61.8], "ja": "まず夕食に行くから" },
    { "t": [61.8,  63.8], "ja": "すごくおしゃれな、新しいフレンチレストランでね" },
    { "t": [63.8,  65.2], "ja": "いいね" },
    { "t": [65.2,  67], "ja": "私は、えーと、ガソリンスタンドに行って" },
    { "t": [67,  69], "ja": "冷凍ブリトーを買って" },
    { "t": [69,  71.1], "ja": "そこのテーブルで食べるよ" },
    { "t": [73.3,  74.9], "ja": "じゃあ" },
    { "t": [74.9,  77.3], "ja": "またね。一緒に夕食に来たら？" },
    { "t": [77.3,  78.4], "ja": "分かった" },
    { "t": [78.4,  80.7], "ja": "ベンは選挙対策責任者として、すごくよくやってくれてるの" },
    { "t": [80.7,  82.2], "ja": "どういたしまして、彼は本当に頭がいいのよ" },
    { "t": [82.2,  84.2], "ja": "いいかい、選挙対策責任者の腕は" },
    { "t": [84.2,  87.1], "ja": "その人が支える候補者次第なんだ" },
    { "t": [87.1,  89.6], "ja": "つまり、君は本当に賢い女性だって言いたいんだ" },
    { "t": [89.6,  90.6], "ja": "まったく、そのとおり" },
    { "t": [90.6,  92.2], "ja": "どちらかといえば、僕が足を引っぱってるくらいだ" },
    { "t": [92.2,  93.9], "ja": "もう、ベンったら" },
    { "t": [93.9,  95.1], "ja": "先に言ったのは私だ" },
    { "t": [95.1,  97], "ja": "実は、今日警察署にいたのもそのためなの" },
    { "t": [97,  99.1], "ja": "トランプル署長の支持をもらおうと思って" },
    { "t": [99.1,  100.4], "ja": "ああ、彼は私の仲間だったんだ" },
    { "t": [100.4,  101.9], "ja": "私なら、たぶん君を支持させられるよ" },
    { "t": [101.9,  103.3], "ja": "わあ、それはすごい" },
    { "t": [103.3,  104.4], "ja": "ああ。ありがとう" },
    { "t": [104.4,  106.9], "ja": "ねえ、ちょっと失礼。トイレに行きたい？" },
    { "t": [106.9,  108.5], "ja": "ああ、「おしっこ宮殿」のことね" },
    { "t": [108.5,  110.5], "ja": "ああ。リジーが時々そう呼ぶんだ" },
    { "t": [110.5,  112.5], "ja": "そうなの、ちょっとかわいいでしょ？" },
    { "t": [112.5,  113.8], "ja": "ああ、本当にかわいいね" },
    { "t": [117.6,  120.7], "ja": "それで、ダニーは元気…まだ君を愛してる" },
    { "t": [120.7,  121.6], "ja": "今、何て言った？" },
    { "t": [121.6,  123.7], "ja": "何も。何も言ってない" },
    { "t": [123.7,  125], "ja": "今、何も…" },
    { "t": [125,  126.4], "ja": "今、まだ私を愛してるって言った？" },
    { "t": [126.4,  127.9], "ja": "いや、そうは言ってないと思う" },
    { "t": [127.9,  130.1], "ja": "デイブ、なんで今ここでそんなこと言うの？" },
    { "t": [130.1,  131.4], "ja": "本当のことだからだ" },
    { "t": [132.7,  134.3], "ja": "それに、彼が今いないから" },
    { "t": [134.3,  135.9], "ja": "いいタイミングだと思ったんだ" },
    { "t": [135.9,  138], "ja": "5分だけ、この話をさせてもらえないか？" },
    { "t": [138,  139.8], "ja": "だめ、彼氏がいるときに" },
    { "t": [139.8,  141.2], "ja": "この話は絶対に持ち出しちゃだめ" },
    { "t": [141.2,  142.8], "ja": "そうか、じゃあ、彼を追い払えばいい。いい判断だ" },
    { "t": [142.8,  144.6], "ja": "違う、悪い判断よ。そういうことじゃない" },
    { "t": [144.6,  146.5], "ja": "よし、じゃあ、彼が「おしっこ宮殿」にいる間に出よう" },
    { "t": [146.5,  147.5], "ja": "違う、聞いて" },
    { "t": [147.5,  151.2], "ja": "やあ、「おしっこ御殿」" },
    { "t": [152.5,  155.8], "ja": "トイレの、もう一つの面白い呼び方を" },
    { "t": [155.8,  156.9], "ja": "思いついたんだ" },
    { "t": [158.4,  160.4], "ja": "向こうでの仕事はどう、ディック？" },
    { "t": [160.4,  162.8], "ja": "なかなかいいよ。悪いやつをたくさん捕まえた" },
    { "t": [163.8,  165.5], "ja": "6人くらいかな" },
    { "t": [165.5,  166.7], "ja": "じゃあ、明日帰るの？" },
    { "t": [166.7,  168.3], "ja": "明日の予定だ" },
    { "t": [168.3,  171.1], "ja": "ソルトレイクシティ経由の、12時15分の便でね" },
    { "t": [171.1,  173.1], "ja": "ああ、会えて本当によかった" },
    { "t": [173.1,  174.9], "ja": "でも、戻ってくるかもしれない" },
    { "t": [174.9,  175.8], "ja": "どういうこと？" },
    { "t": [175.8,  177.3], "ja": "実は、主にトランプルの後任の" },
    { "t": [177.3,  179.3], "ja": "警察署長の面接で来てるんだ" },
    { "t": [179.3,  180.5], "ja": "すごいじゃないか" },
    { "t": [180.5,  181.9], "ja": "絶対に署長になるべきだよ" },
    { "t": [181.9,  183.4], "ja": "そしたらレスリーを支持できる" },
    { "t": [183.4,  185.3], "ja": "もちろんレスリーを支持するよ" },
    { "t": [185.3,  187.8], "ja": "無理しなくていいのよ。いい候補者はたくさんいるし" },
    { "t": [189.3,  193.2], "ja": "ちょっと…外に出てくるよ" },
    { "t": [193.2,  195], "ja": "誰か一緒にいてほしそうな顔だな" },
    { "t": [195,  195.8], "ja": "え？" },
    { "t": [195.8,  196.8], "ja": "え？" },
    { "t": [196.8,  198.5], "ja": "一緒に外に出て、近況でも話さないか？" },
    { "t": [198.5,  199.8], "ja": "近況ならもう話したよ" },
    { "t": [199.8,  202.5], "ja": "サンディエゴの話も、悪いやつ6人の話もした" },
    { "t": [202.5,  203.6], "ja": "もう十分だと思う" },
    { "t": [203.6,  204.8], "ja": "一緒にちょっと散歩してもいいぞ" },
    { "t": [204.8,  207.1], "ja": "いや、それはいい" },
    { "t": [207.1,  209.3], "ja": "まあ、もう、行くって言っちゃったし" },
    { "t": [209.3,  211.6], "ja": "男に二言はないから、行くよ" },
    { "t": [211.6,  212.5], "ja": "ごゆっくり" },
    { "t": [212.5,  214.7], "ja": "ああ、ありがとう" },
    { "t": [214.7,  217], "ja": "ねえ、正直、僕どうかな？" },
    { "t": [217,  218.7], "ja": "結構うまくやれてる気がするんだけど" },
    { "t": [218.7,  220.2], "ja": "彼、まだ私を愛してるって" },
    { "t": [220.2,  221.1], "ja": "何だって？" },
    { "t": [221.1,  222.2], "ja": "あなたがトイレにいる間に" },
    { "t": [222.2,  224.5], "ja": "まだ私を愛してるって言ったの" },
    { "t": [224.5,  227.4], "ja": "なんてことだ、レスリー、彼は警官だぞ" },
    { "t": [227.4,  230], "ja": "君を愛してて、しかも銃を持ってるのか？" },
    { "t": [230,  230.9], "ja": "お願いだから、取り乱さないで" },
    { "t": [230.9,  231.7], "ja": "取り乱してないよ" },
    { "t": [231.7,  232.5], "ja": "そう" },
    { "t": [232.5,  235.7], "ja": "取り乱してない、分かってる、それは、分かってる" },
    { "t": [242.5,  243.5], "ja": "取り乱してないよ" }
  ]
}
