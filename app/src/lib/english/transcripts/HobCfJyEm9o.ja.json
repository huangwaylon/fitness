{
  "video": "HobCfJyEm9o",
  "lines": [
    { "t": [0, 6.5], "ja": "皆さん、ご注目ください" },
    { "t": [8.5, 10.3], "ja": "少しだけお時間をいただきます" },
    { "t": [12.7, 15.5], "ja": "私はこの会社を世界のほとんど何よりも愛しているが" },
    { "t": [16.1, 20], "ja": "職を辞して、家族ともっと時間を過ごすことに決めた" },
    { "t": [20.5, 21.7], "ja": "私は未知を恐れない" },
    { "t": [22.4, 25.7], "ja": "新しい挑戦に真っ向から立ち向かい、成功し" },
    { "t": [26, 28.6], "ja": "私を疑う者たちの顔を見て笑ってやる" },
    { "t": [28.9, 31.2], "ja": "一部の諸君と働けたのは喜びだった" },
    { "t": [31.8, 33.7], "ja": "その諸君のことはすぐには忘れない" },
    { "t": [34.2, 37.2], "ja": "だが覚えておけ、今日は私だが" },
    { "t": [39, 40.2], "ja": "いずれ我々はみな倒れる" },
    { "t": [44.2, 45.6], "ja": "つまり、辞めるということだ" },
    { "t": [46.5, 46.7], "ja": "以上" },
    { "t": [48.2, 51.9], "ja": "ウンパ・ルンパ・ドゥンパ・ディー・ドッサム" },
    { "t": [52.4, 56], "ja": "ドワイトは去った、最高にうれしいな" },
    { "t": [56.6, 58.1], "ja": "彼はなぜ去ったの？" },
    { "t": [58.1, 60.1], "ja": "すごくいい人だったのに" },
    { "t": [60.5, 61.8], "ja": "いや、違う" },
    { "t": [62, 63.9], "ja": "ただの嫌なやつだった" },
    { "t": [64.4, 65.8], "ja": "ドゥンパ・ディー・ドゥン" },
    { "t": [67.5, 69.7], "ja": "残りの私物は" },
    { "t": [69.7, 73.2], "ja": "マイケル・スコットに譲りたい" },
    { "t": [74.7, 75.7], "ja": "もらってくれ" },
    { "t": [76.6, 77.3], "ja": "これ以外はな" },
    { "t": [78.4, 79.3], "ja": "幸運を" },
    { "t": [79.3, 87.1], "ja": "ドワイトがいなくなると寂しくなる" },
    { "t": [87.1, 90.6], "ja": "僕はそれほどでもないけど、寂しくなる" },
    { "t": [90.6, 92.9], "ja": "ドワイト？" },
    { "t": [92.9, 94.9], "ja": "営業の？" },
    { "t": [94.9, 100], "ja": "この会社で一番立派で有能な社員の一人だったよ" },
    { "t": [100, 104.3], "ja": "私の人生の目標の一つは、ここで、この机の椅子で死ぬことだった" },
    { "t": [104.3, 108.9], "ja": "そして今日、その夢は打ち砕かれた" },
    { "t": [147.9, 150.4], "ja": "（音楽）" }
  ]
}
