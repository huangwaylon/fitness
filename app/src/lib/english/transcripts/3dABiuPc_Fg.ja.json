{
  "video": "3dABiuPc_Fg",
  "lines": [
    { "t": [0,  7], "ja": "いいね" },
    { "t": [14.3,  18.2], "ja": "ねえロン、7本倒すつもりだったの？ だとしたら、大成功だね" },
    { "t": [18.2,  22], "ja": "今、私はとても怒っている" },
    { "t": [22,  24.1], "ja": "痛っ！" },
    { "t": [24.1,  25.4], "ja": "何？" },
    { "t": [25.4,  27.7], "ja": "指が中に入ってたのに" },
    { "t": [27.7,  29.4], "ja": "ロンに指をつぶされた" },
    { "t": [29.4,  31.4], "ja": "折れてるかもしれない" },
    { "t": [31.4,  33.2], "ja": "お前はメスの鳥か？" },
    { "t": [33.2,  34.8], "ja": "事故だったんだ" },
    { "t": [34.8,  37.1], "ja": "うそ、もう腫れてる" },
    { "t": [37.1,  39.7], "ja": "トム、もう、プライドってものはないの？" },
    { "t": [39.7,  40.7], "ja": "わざとだよ" },
    { "t": [40.7,  42.2], "ja": "俺の腕前に嫉妬してるんだ" },
    { "t": [42.2,  44.9], "ja": "はいはい、ほら、トゥイーティー、氷を取りに行こう" },
    { "t": [44.9,  47.9], "ja": "さあ" },
    { "t": [47.9,  49.9], "ja": "いやあ、おめでとう" },
    { "t": [49.9,  52.1], "ja": "楽しい試合だったね、いい時間だった" },
    { "t": [52.1,  53], "ja": "楽しんだ？" },
    { "t": [53,  56.5], "ja": "ああ、ただのビールとただのボウリングに文句を言う気はないよ" },
    { "t": [56.5,  57.7], "ja": "じゃあ、またね" },
    { "t": [57.7,  59.7], "ja": "あ、ちょっと待って" },
    { "t": [59.7,  65.5], "ja": "知ってのとおり、市議会に立候補してるんだけど、えーと、私に投票してくれる？" },
    { "t": [65.5,  66.5], "ja": "いや" },
    { "t": [66.5,  69.1], "ja": "もう、デレクったら" },
    { "t": [69.1,  70.1], "ja": "本気で" },
    { "t": [70.1,  71.1], "ja": "あなたの票、当てにしていい？" },
    { "t": [71.1,  73.5], "ja": "いや、うーん、それはないかな" },
    { "t": [73.5,  79], "ja": "でも、一晩中ここでボウリングして、楽しく過ごしたじゃない" },
    { "t": [79,  81.3], "ja": "それでも私に投票しないの？" },
    { "t": [81.3,  82.3], "ja": "なんで？" },
    { "t": [82.3,  83.3], "ja": "あんたが嫌いなんだよ" },
    { "t": [83.3,  84.3], "ja": "レスリー？" },
    { "t": [84.3,  85.3], "ja": "レスリー？" },
    { "t": [85.3,  89], "ja": "それに、あなたはボウリングが下手だから、わざと負けてあげたのよ" },
    { "t": [89,  90], "ja": "へえ、どうだか" },
    { "t": [90,  91], "ja": "俺がこてんぱんにしてやったんだろ" },
    { "t": [91,  92], "ja": "違う" },
    { "t": [92,  93], "ja": "本当よ" },
    { "t": [93,  94], "ja": "私、すごくボウリングがうまいの" },
    { "t": [94,  95], "ja": "ロンに聞いてみて" },
    { "t": [95,  96], "ja": "ロンなんて知らねえよ" },
    { "t": [96,  98], "ja": "でも、そんなにうまいなら、もう一回やろうぜ" },
    { "t": [98,  99], "ja": "いいわ" },
    { "t": [99,  100], "ja": "喜んで" },
    { "t": [100,  101], "ja": "じゃあ、こうしよう" },
    { "t": [101,  102], "ja": "私が勝ったら、あなたの票をもらう" },
    { "t": [102,  104], "ja": "俺が勝ったら、1か月うちの掃除をしてもらう" },
    { "t": [104,  105], "ja": "決まり" },
    { "t": [105,  107.5], "ja": "紹介したい人がいるんだ、僕の親友の…" },
    { "t": [107.5,  108.5], "ja": "今はだめ、ベン" },
    { "t": [108.5,  110.8], "ja": "デレクのお尻を、私の足に紹介してあげたいの" },
    { "t": [110.8,  112.8], "ja": "ビールをもう1杯くれ" },
    { "t": [112.8,  113.8], "ja": "私はここの店員じゃない" },
    { "t": [113.8,  114.8], "ja": "20ドルだ" },
    { "t": [114.8,  118.8], "ja": "おお！" },
    { "t": [118.8,  122.8], "ja": "ひどいムーンウォークだ" },
    { "t": [122.8,  123.8], "ja": "知るか" },
    { "t": [123.8,  129.8], "ja": "どうだ、ほら？" },
    { "t": [129.8,  132.8], "ja": "あら、スペアね" },
    { "t": [132.8,  133.8], "ja": "かわいいじゃない" },
    { "t": [133.8,  136.1], "ja": "スコアボードを見て" },
    { "t": [136.1,  137.8], "ja": "だから？" },
    { "t": [137.8,  140.6], "ja": "よう、デレク、ひどい負けっぷりだな" },
    { "t": [140.6,  142.8], "ja": "いや、まさかこんなに差がつくとは思わなかったけど" },
    { "t": [142.8,  145.3], "ja": "言ったでしょ、ボウリングはうまいって" },
    { "t": [145.3,  146.3], "ja": "どうでもいい" },
    { "t": [146.3,  149.3], "ja": "冗談はさておき、本当に楽しかったって言いたいの" },
    { "t": [149.3,  151.8], "ja": "春の投票、すごく楽しみにしてるわ" },
    { "t": [151.8,  154.3], "ja": "ああ、投票用紙に「クソ女」って書いとくよ" },
    { "t": [154.3,  155.3], "ja": "何て？" },
    { "t": [155.3,  156.3], "ja": "今、何て言った？" },
    { "t": [156.3,  157.3], "ja": "相手にしないで" },
    { "t": [157.3,  158.3], "ja": "嫌なやつなだけ" },
    { "t": [158.3,  159.3], "ja": "彼女はクソ女だって言ったんだ" },
    { "t": [159.3,  161.3], "ja": "うそでしょ！" },
    { "t": [161.3,  162.3], "ja": "何なんだよ？" },
    { "t": [162.3,  163.3], "ja": "痛っ！" },
    { "t": [163.3,  165.3], "ja": "本当にごめん" },
    { "t": [165.3,  166.3], "ja": "本当にごめん" },
    { "t": [166.3,  167.3], "ja": "最高だった" },
    { "t": [167.3,  171.3], "ja": "本当にごめん" },
    { "t": [171.3,  172.3], "ja": "ほら、見て" },
    { "t": [172.3,  174.3], "ja": "欲しがってた写真のチャンスよ" },
    { "t": [174.3,  174.8], "ja": "痛っ" },
    { "t": [174.8,  175.3], "ja": "ごめん" },
    { "t": [175.3,  178.3], "ja": "で、ほら、起きたことは全部それで、つまりこういうことがあったんです" },
    { "t": [178.3,  181.3], "ja": "まるで…" },
    { "t": [181.3,  182.3], "ja": "どうしたんだ？" },
    { "t": [182.3,  183.3], "ja": "今、アドレナリンがすごく出てて" },
    { "t": [183.3,  185.3], "ja": "何回か深呼吸してくれ、いいね？" },
    { "t": [185.3,  187.3], "ja": "相手の男は、訴えるかもしれないと言ってる" },
    { "t": [187.3,  190.3], "ja": "ええ、ランディ、知っておいてほしいんだけど、こっちは訴えないから" },
    { "t": [190.3,  191.3], "ja": "ああ、それはそもそも選択肢になかったよ" },
    { "t": [191.3,  192.3], "ja": "ちょっと" },
    { "t": [192.3,  193.3], "ja": "あいつ、本当に嫌なやつだったのよ" },
    { "t": [193.3,  197.3], "ja": "ベンのしたことは正当だし、ちなみに、すごくかっこよかった" },
    { "t": [197.3,  199.3], "ja": "どれだけかっこよかったか、書いた？" },
    { "t": [199.3,  202.3], "ja": "公式の報告書には、「嫌なやつ」や「かっこいい」という言葉は使わないんだ" },
    { "t": [202.3,  203.3], "ja": "ほら、どうぞ" },
    { "t": [203.3,  204.3], "ja": "やあ" },
    { "t": [204.3,  205.3], "ja": "わあ" },
    { "t": [205.3,  206.3], "ja": "俺たち、お揃いだな？" },
    { "t": [206.3,  207.3], "ja": "指のけが仲間" },
    { "t": [207.3,  208.3], "ja": "いや、いや" },
    { "t": [208.3,  209.3], "ja": "全然違うけがだから" }
  ]
}
