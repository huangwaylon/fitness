  "lines": [
    { "t": [0.4,  2], "ja": "まず筆記試験を受けて" },
    { "t": [2,  4.4], "ja": "それから性格診断を受けるんだ" },
    { "t": [4.4,  5.6], "ja": "そっちはばっちり決められる気がする" },
    { "t": [5.6,  7], "ja": "だって、みんないつも言うんだ" },
    { "t": [7,  9], "ja": "「でも、彼は性格がすごくいい」って" },
    { "t": [10.6,  12.5], "ja": "よし、問題を出して" },
    { "t": [12.5,  16], "ja": "じゃあ、警官が「3542」と無線で言ったら、どういう意味？" },
    { "t": [16,  17.2], "ja": "暴行傷害" },
    { "t": [17.2,  18.2], "ja": "覚え方はね" },
    { "t": [18.2,  22.5], "ja": "35個のア・ソルト入れと、42個のバッテリーを思い浮かべるんだ" },
    { "t": [22.5,  24.8], "ja": "すごい。じゃあ、放火の犯罪コードは？" },
    { "t": [24.8,  27], "ja": "放火は533。覚え方、分かる？" },
    { "t": [27,  31.4], "ja": "533個の塩入れとバッテリーが、ビルに火をつけてるところを思い浮かべるんだ" },
    { "t": [31.4,  33.3], "ja": "ああ、緊張する" },
    { "t": [33.3,  34.4], "ja": "ねえ、こっち見て" },
    { "t": [34.4,  37.3], "ja": "あなたはこの試験に受かって、警官になるの" },
    { "t": [37.3,  40.7], "ja": "もし受からなかったら、あなたと離婚して他の人と結婚して" },
    { "t": [40.7,  42], "ja": "それから、あなたと浮気してあげる" },
    { "t": [42,  44.7], "ja": "ああ、すごく優しいね" },
    { "t": [44.7,  46.6], "ja": "それと、お守りを用意したの" },
    { "t": [47.8,  49.3], "ja": "道ばたで死んだウサギを見つけて" },
    { "t": [49.3,  51.4], "ja": "足を切り取って、お守りにしたの" },
    { "t": [51.4,  54.3], "ja": "ベイビー、めちゃくちゃ気味悪いね" },
    { "t": [54.3,  55.8], "ja": "ありがとう、大好きだよ" },
    { "t": [57,  59.1], "ja": "ドワイヤー、出番だ" },
    { "t": [59.1,  61.1], "ja": "さて、この検査で分かるのは、あなたが" },
    { "t": [61.1,  63.5], "ja": "警察官にふさわしい性格かどうかです" },
    { "t": [63.5,  65.6], "ja": "まず、機械が動いているか確かめます" },
    { "t": [65.6,  68], "ja": "あなたの名前はアンディですか？" },
    { "t": [68,  70.3], "ja": "どう答えたらいいか分からない" },
    { "t": [70.3,  71.7], "ja": "はいか、いいえで" },
    { "t": [71.7,  72.9], "ja": "えーと、みんなにはアンディって呼ばれてるけど" },
    { "t": [72.9,  75.9], "ja": "正式な名前はアンドリュー、だと思う" },
    { "t": [75.9,  79.6], "ja": "じゃあ、いいえ？" },
    { "t": [79.6,  80.8], "ja": "待って" },
    { "t": [80.8,  82.1], "ja": "はい" },
    { "t": [82.1,  83.1], "ja": "次に進みましょう" },
    { "t": [83.1,  85.1], "ja": "状況です。高校生くらいの子が" },
    { "t": [85.1,  87], "ja": "あなたの拳銃を持たせてほしいと言ってきました" },
    { "t": [87,  87.9], "ja": "どうしますか？" },
    { "t": [87.9,  90], "ja": "はい、渡しました" },
    { "t": [90,  92.3], "ja": "子どもの頃、ずっと警官の銃を持ってみたかったんです" },
    { "t": [92.3,  94.2], "ja": "だから、別の子のその夢をかなえてあげたくて" },
    { "t": [94.2,  98], "ja": "それこそが、警官ってものでしょ" },
    { "t": [98,  100.4], "ja": "状況です。スピード違反の車を止めました" },
    { "t": [100.4,  102], "ja": "運転していたのは、あなたの父親でした" },
    { "t": [102,  103.5], "ja": "どう対応しますか？" },
    { "t": [103.5,  106.9], "ja": "えーと、まず、こう言うかな" },
    { "t": [106.9,  109.9], "ja": "「父さん、生きてたの？" },
    { "t": [109.9,  111.1], "ja": "一体どういうこと？" },
    { "t": [111.1,  113.1], "ja": "それと、僕のキャッチャーミット、どこにあるか知ってる？」" },
    { "t": [119.5,  120.8], "ja": "こんにちは、フューゲルバーグ署長" },
    { "t": [120.8,  123.3], "ja": "やあ、あそこにいるのが君の友だちのアンディ・ドワイヤーだね" },
    { "t": [123.3,  124.5], "ja": "本当に惜しいよ" },
    { "t": [124.5,  125.8], "ja": "えっ、そんな" },
    { "t": [125.8,  127], "ja": "試験に落ちたんですか？" },
    { "t": [127,  129.6], "ja": "不思議なんだ、筆記試験は100%正解だった" },
    { "t": [129.6,  131.2], "ja": "史上初の満点だ" },
    { "t": [131.2,  133.4], "ja": "でも、性格診断で落ちた" },
    { "t": [133.4,  134.8], "ja": "いい子なんだがね" },
    { "t": [134.8,  137], "ja": "ただ、警官に必要なものがないんだ" },
    { "t": [137,  138.3], "ja": "ああ、アンディ" },
    { "t": [138.3,  141.1], "ja": "惜しいな。たしかに、なかなかの天才なのに" },
    { "t": [141.1,  143.3], "ja": "警察にあの頭脳があれば役に立つんだがな" },
    { "t": [143.3,  145.2], "ja": "警察公式の手首固め、これで殴れないぞ" },
    { "t": [145.2,  146.8], "ja": "殴ってみろ" },
    { "t": [146.8,  149], "ja": "あ、ほら、違う、こうだ、こっちの手" },
    { "t": [149,  150.5], "ja": "手首固め、ドーン、痛すぎて" },
    { "t": [150.5,  152.3], "ja": "殴ることすらできない、殴ってみろ" },
    { "t": [152.3,  154.1], "ja": "まあ、銃を持ってたら、殴ろうとはしないだろうけどね" },
    { "t": [154.1,  155.2], "ja": "そういうこと" },
    { "t": [155.2,  156.1], "ja": "また次回" },
    { "t": [156.1,  157.2], "ja": "また次回" },
    { "t": [157.2,  158.2], "ja": "また次回" }
