{
  "video": "C-TY__6zWhA",
  "lines": [
    { "t": [0,  1], "ja": "何だ？" },
    { "t": [1,  3], "ja": "あの、マイケル。経理がこれの承認を求めてます" },
    { "t": [3,  4], "ja": "いや、今は忙しい" },
    { "t": [4,  7], "ja": "メレディスがネット招待状をもらってる" },
    { "t": [7,  9], "ja": "今夜、ジムの家でバーベキューだって" },
    { "t": [9,  11], "ja": "今夜か" },
    { "t": [11,  13], "ja": "私の招待状はどこかな" },
    { "t": [13,  17], "ja": "上司と社員の間には、いつも距離があるものだ" },
    { "t": [17,  20], "ja": "みんな思ってるんだ、「わあ、マイケル・スコットだ" },
    { "t": [20,  22], "ja": "本当に尊敬してる" },
    { "t": [22,  25], "ja": "パーティーで彼にほうれん草のディップをこぼしたらどうしよう？" },
    { "t": [25,  26], "ja": "どう思われるだろう？" },
    { "t": [26,  28], "ja": "給料に響くかな？」って" },
    { "t": [28,  29], "ja": "さあね" },
    { "t": [29,  36], "ja": "仲間の一人として、私はすごく話しやすいと思うんだけどね" },
    { "t": [36,  39], "ja": "でも、もっと気さくになったほうがいいのかもな" },
    { "t": [44,  45], "ja": "ネクタイはどうしたの？" },
    { "t": [45,  46], "ja": "さあね" },
    { "t": [46,  48], "ja": "外したい気分でさ" },
    { "t": [48,  49], "ja": "どうしたの、マイケル？" },
    { "t": [49,  50], "ja": "話してよ" },
    { "t": [50,  52], "ja": "ああ、ほら、いつものことさ" },
    { "t": [52,  54], "ja": "いつもの、ね" },
    { "t": [54,  56], "ja": "上司にずっと、うるさく言われててさ" },
    { "t": [56,  57], "ja": "あらら" },
    { "t": [57,  58], "ja": "ジム？" },
    { "t": [58,  60], "ja": "どうしたの？" },
    { "t": [60,  61], "ja": "ただ一緒に過ごしたいんだ" },
    { "t": [61,  62], "ja": "仲間の一人になりたい" },
    { "t": [62,  64], "ja": "仲間の中で、一番大事な一人にね" },
    { "t": [64,  65], "ja": "そういうことじゃない" },
    { "t": [65,  66], "ja": "ただ…" },
    { "t": [66,  67], "ja": "まさにそういうことでしょ" },
    { "t": [67,  68], "ja": "スランプなんだよ" },
    { "t": [68,  69], "ja": "誰にでもあることだよ" },
    { "t": [69,  74], "ja": "自分がどこから来て、何者なのかを忘れないことだね" },
    { "t": [74,  75], "ja": "分かった" },
    { "t": [76,  79], "ja": "ほら、このためにすごくがんばってきたんだし" },
    { "t": [79,  80], "ja": "あなたが上司なんだ" },
    { "t": [80,  83], "ja": "小指をパチンと鳴らすだけで、僕らを売り買いできる" },
    { "t": [83,  84], "ja": "そうだ" },
    { "t": [84,  86], "ja": "まあ、そんなことは絶対にしないけど" },
    { "t": [86,  88], "ja": "うん、小指で鳴らせる人なんていないからね" },
    { "t": [88,  90], "ja": "ジム、今はそんなときじゃない" },
    { "t": [90,  92], "ja": "いや、まさにそのときですよ" },
    { "t": [92,  93], "ja": "最高のタイミングです" },
    { "t": [93,  98], "ja": "これはただ、男同士が軽くからかい合ってるだけ" },
    { "t": [98,  100], "ja": "それが大事なんですよ" },
    { "t": [101,  103], "ja": "一緒に食べる？" },
    { "t": [103,  104], "ja": "もちろん" },
    { "t": [104,  105], "ja": "仲間たちとつるむよ" },
    { "t": [105,  107], "ja": "私もその一員の仲間とね" },
    { "t": [107,  111], "ja": "カップ麺と一緒につるむ" },
    { "t": [111,  114], "ja": "これぞカップに入った食事だ" },
    { "t": [114,  115], "ja": "熱くて、うまい" },
    { "t": [115,  116], "ja": "ああ、まったく" },
    { "t": [116,  117], "ja": "で、今日はどんな感じ？" },
    { "t": [117,  118], "ja": "遅くなってすみません" },
    { "t": [118,  119], "ja": "ああ" },
    { "t": [119,  121], "ja": "お客さんの前に大口の注文があって" },
    { "t": [121,  123], "ja": "でも、ピリ辛のツナ巻きをおまけしておきました" },
    { "t": [123,  124], "ja": "何がいらないか、分かる？" },
    { "t": [124,  125], "ja": "昼ごはんはあるから" },
    { "t": [125,  126], "ja": "え？" },
    { "t": [126,  127], "ja": "昼ごはんはあるんだ" },
    { "t": [127,  128], "ja": "いや、いいよ" },
    { "t": [128,  129], "ja": "ほんとにいい" },
    { "t": [129,  130], "ja": "これ、いらないの？" },
    { "t": [130,  131], "ja": "いらない" },
    { "t": [131,  132], "ja": "いらないんだね" },
    { "t": [132,  133], "ja": "取っておいて" },
    { "t": [133,  134], "ja": "本当だよ" },
    { "t": [134,  135], "ja": "パーティーを開くんだ" },
    { "t": [135,  137], "ja": "輸入ビールが3ケースに" },
    { "t": [137,  139], "ja": "カラオケマシン" },
    { "t": [139,  141], "ja": "で、マイケルは招待してない" },
    { "t": [141,  142], "ja": "別に個人的な理由じゃないんだ" },
    { "t": [142,  143], "ja": "ただ、あなたがいたら" },
    { "t": [143,  145], "ja": "みんなくつろげないと思うんだよ" },
    { "t": [145,  146], "ja": "分かるでしょ？" },
    { "t": [146,  147], "ja": "楽しんでね" },
    { "t": [147,  148], "ja": "それに、ルームメイトがみんなに会いたがってて" },
    { "t": [148,  151], "ja": "たぶん、ドワイトのことを僕の作り話だと思ってるから" },
    { "t": [153,  154], "ja": "ちゃんと実在するんだけどね" },
    { "t": [154,  156], "ja": "ネットで調べたら、今夜のパーティーで君の家へ行くのに" },
    { "t": [156,  158], "ja": "いくつか違う行き方があるんだ" },
    { "t": [158,  159], "ja": "ああ" },
    { "t": [159,  160], "ja": "どうしようかと思って" },
    { "t": [160,  161], "ja": "声を小さくして" },
    { "t": [161,  162], "ja": "なんで？" },
    { "t": [162,  166], "ja": "パーティーのことを、みんなが知ってるわけじゃないから" },
    { "t": [166,  167], "ja": "例えば誰？" },
    { "t": [167,  168], "ja": "マイケル" },
    { "t": [168,  170], "ja": "なんでマイケルだけ？" },
    { "t": [170,  172], "ja": "サプライズだからだよ" },
    { "t": [172,  173], "ja": "そうなのか？" },
    { "t": [173,  174], "ja": "うん" },
    { "t": [174,  175], "ja": "おお、それは完璧だ" },
    { "t": [175,  176], "ja": "だから言わないで" },
    { "t": [176,  177], "ja": "言わない" },
    { "t": [177,  178], "ja": "よし" },
    { "t": [178,  179], "ja": "5時だ" },
    { "t": [179,  183], "ja": "即興コメディの時間だ" },
    { "t": [183,  187], "ja": "ちょっとした笑いの元気ジュースさ" },
    { "t": [187,  188], "ja": "うーん" },
    { "t": [188,  189], "ja": "よし" },
    { "t": [189,  191], "ja": "これが何か当ててみて" },
    { "t": [195,  209], "ja": "即興の教室に行く準備をしている恐竜だ" },
    { "t": [209,  210], "ja": "やあ、パム" },
    { "t": [210,  212], "ja": "車という乗り物まで送っていこうか？" },
    { "t": [212,  213], "ja": "いえ、結構です" },
    { "t": [213,  214], "ja": "そうか" },
    { "t": [214,  215], "ja": "オスカー、今夜は何か大きな予定ある？" },
    { "t": [215,  216], "ja": "電話中なんです" },
    { "t": [216,  217], "ja": "そうか" },
    { "t": [217,  218], "ja": "大将、大将" },
    { "t": [218,  219], "ja": "今夜は何するんだ？" },
    { "t": [219,  220], "ja": "どこに行くんだ？" },
    { "t": [220,  224], "ja": "兄が来てるので、アラスカ映画祭を見に行くんです、あの…" },
    { "t": [224,  225], "ja": "そうか" },
    { "t": [225,  226], "ja": "分かった" },
    { "t": [226,  227], "ja": "おお" },
    { "t": [227,  228], "ja": "ドワイト！" },
    { "t": [228,  230], "ja": "おお、ドワイト、私の忠実な相棒" },
    { "t": [230,  232], "ja": "今夜は君と私でつるもう" },
    { "t": [232,  233], "ja": "二人きりでな" },
    { "t": [233,  237], "ja": "自由と男らしさを祝うんだ" },
    { "t": [237,  238], "ja": "そうだ" },
    { "t": [238,  239], "ja": "君が見たがってた、あの番組を見ようじゃないか" },
    { "t": [239,  242], "ja": "あのくだらない「バトルシップ・ギャラクシー」" },
    { "t": [242,  243], "ja": "「バトルスター・ギャラクティカ」です" },
    { "t": [243,  246], "ja": "とにかく、君が見たいくだらない番組なら何でも見よう" },
    { "t": [246,  247], "ja": "今夜は無理です" },
    { "t": [247,  248], "ja": "あいにく予定があって" },
    { "t": [248,  250], "ja": "練習に行かないと" },
    { "t": [250,  252], "ja": "サッカーの練習です" },
    { "t": [252,  254], "ja": "ドワイト、サッカーをやってたなんて知らなかったよ" },
    { "t": [254,  255], "ja": "クラリネットの" },
    { "t": [255,  257], "ja": "君もな、ドワイト" },
    { "t": [257,  263], "ja": "今夜は何をするにせよ楽しんでくれ。また月曜日に" },
    { "t": [265,  266], "ja": "彼は何も知らない" }
  ]
}
