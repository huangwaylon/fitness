{
  "video": "sLo1Q4xRGBs",
  "lines": [
    { "t": [0, 1.5], "ja": "はい、ポーニー公園課のみんな" },
    { "t": [1.5, 3.5], "ja": "もうすぐ、ある人とペアになってもらいます" },
    { "t": [3.5, 5.8], "ja": "イーグルトンで、だいたい同じ立場にいる人です" },
    { "t": [5.8, 7.9], "ja": "ドナ、あなたはクレイグと" },
    { "t": [7.9, 10.6], "ja": "エイプリル、あなたはティニファーっていう人と" },
    { "t": [10.6, 12.7], "ja": "それからロン、あなたの相手もロンって名前よ" },
    { "t": [12.7, 15], "ja": "俺に相当する人はいないみたいだな" },
    { "t": [15, 17.1], "ja": "驚かないよ。俺は唯一無二だから" },
    { "t": [17.1, 18.5], "ja": "俺がデザインした特注のナイキみたいにね" },
    { "t": [18.5, 21.4], "ja": "つま先に「トミーのあんよ」って書いてあるやつ" },
    { "t": [21.4, 22.7], "ja": "実はあなたにも相手がいるのよ" },
    { "t": [22.7, 25.3], "ja": "エリックっていう人で、すごいって聞いてる" },
    { "t": [25.3, 27.1], "ja": "とにかく、ちょっとしたサプライズもあるの" },
    { "t": [27.1, 29.7], "ja": "新しい書類整理の臨時スタッフを紹介します" },
    { "t": [29.7, 31.1], "ja": "やあ、みんな！" },
    { "t": [31.1, 32.4], "ja": "うそ！" },
    { "t": [32.4, 33.8], "ja": "なんで？こんなのありえない" },
    { "t": [33.8, 35.7], "ja": "なんでよ、レスリー？" },
    { "t": [35.7, 36.7], "ja": "どうも、ドナよ" },
    { "t": [36.7, 38.1], "ja": "ああ、あなたにぴったりの名前だ" },
    { "t": [38.1, 40.7], "ja": "大好き。絶対に変えないで！" },
    { "t": [40.7, 42.3], "ja": "変える気なかったけど" },
    { "t": [42.3, 43.3], "ja": "あなた、クレイグよね？" },
    { "t": [43.3, 45.3], "ja": "ああ、そう。その名前、大嫌いなんだ" },
    { "t": [45.3, 46.5], "ja": "すごくつまらない" },
    { "t": [46.5, 49.2], "ja": "誰かのいとこみたいな名前。クレイグ、クレイグ" },
    { "t": [49.2, 50.8], "ja": "テレンスっていうスペイン人の男になりたかった" },
    { "t": [50.8, 52.8], "ja": "でも、そうはならなかった" },
    { "t": [52.8, 54.1], "ja": "そう" },
    { "t": [54.1, 56.9], "ja": "じゃあ、これが私の仕事のリスト" },
    { "t": [56.9, 59.3], "ja": "私はまあ、事務の責任者ね" },
    { "t": [59.3, 60.2], "ja": "あなたは？" },
    { "t": [60.2, 61.7], "ja": "ああ、何でもやったよ" },
    { "t": [61.7, 62.6], "ja": "全部だ" },
    { "t": [62.6, 64.6], "ja": "イーグルトンの部署を何年も一人で背負ってきたんだ" },
    { "t": [64.6, 65.8], "ja": "しかも、その一瞬一瞬が大好きだった" },
    { "t": [65.8, 68.6], "ja": "君には分からないだろうね！" },
    { "t": [68.6, 71], "ja": "じゃあ、バミューダグラスに変えてもいいですよ" },
    { "t": [71, 72.8], "ja": "1平方フィートあたり、たった80セント高いだけです" },
    { "t": [72.8, 73.8], "ja": "何だって！？" },
    { "t": [73.8, 75.3], "ja": "貸して、貸して、貸して" },
    { "t": [75.3, 78.1], "ja": "バミューダグラスを大陸性気候の場所に植えろって？" },
    { "t": [78.1, 79.9], "ja": "ビューフォート風力6の風が吹く" },
    { "t": [79.9, 81.7], "ja": "水はけゼロの公園に？" },
    { "t": [81.7, 84.1], "ja": "ケンタッキーブルーグラスがほしい。1割引きがほしい" },
    { "t": [84.1, 86.7], "ja": "それに、親友のドナに謝ってほしい！" },
    { "t": [90.1, 90.9], "ja": "ええ、どうも" },
    { "t": [90.9, 92.7], "ja": "もしかして、これはただの推測なんだけど" },
    { "t": [92.7, 96.1], "ja": "たくさん飲む必要がある薬があって" },
    { "t": [96.1, 98.4], "ja": "今日は全然飲んでないとか、逆に飲みすぎたとか？" },
    { "t": [98.4, 100.3], "ja": "ああ、持病があるんだよ、いい？" },
    { "t": [100.3, 103.8], "ja": "人のことを気にかけすぎる病気で、治らないんだ！" },
    { "t": [105.1, 106.4], "ja": "それに、湿疹もある" },
    { "t": [108.6, 110.7], "ja": "いい、ドナ、少し人を減らさないといけないの" },
    { "t": [110.7, 112.5], "ja": "もちろん、あなたの仕事は大丈夫よ" },
    { "t": [112.5, 114.6], "ja": "あなたはこの部署の「のり」、まとめ役だもの" },
    { "t": [114.6, 116.7], "ja": "でも、クレイグには辞めてもらうことになると思う" },
    { "t": [116.7, 118.5], "ja": "だめ、彼は残すべきよ" },
    { "t": [118.5, 120.9], "ja": "すごく暑苦しいけど、ここまでの人には会ったことがない" },
    { "t": [120.9, 122.5], "ja": "この仕事をあれほど大事にする人なんて" },
    { "t": [122.5, 124.7], "ja": "あの、ドナ、私ここにいるんだけど" },
    { "t": [124.7, 126.6], "ja": "冗談じゃなく、あなたより大事にしてるかも" },
    { "t": [126.6, 128.7], "ja": "正直、彼と私のどっちかを選ぶなら" },
    { "t": [128.7, 129.5], "ja": "彼を選ぶ" },
    { "t": [129.5, 130.4], "ja": "待って、どういうこと？" },
    { "t": [130.4, 131.4], "ja": "辞めようと思ってるの？" },
    { "t": [131.4, 132.6], "ja": "そのつもりはなかったけど、辞めてもいいよ" },
    { "t": [132.6, 134.5], "ja": "ほら、シアトルにマンションもあるし" },
    { "t": [134.5, 135.7], "ja": "デンバーには婚約者もいるし" },
    { "t": [135.7, 137], "ja": "え？" },
    { "t": [137, 137.8], "ja": "長くは続かないよ" },
    { "t": [137.8, 140], "ja": "レスリー、喜んでまた引退するよ" },
    { "t": [140, 141.3], "ja": "人を減らさないといけないならね" },
    { "t": [141.3, 142.1], "ja": "何？" },
    { "t": [142.1, 143], "ja": "ラリーまで辞めたいの？" },
    { "t": [143, 144.3], "ja": "いったいどうなってるの？" },
    { "t": [144.3, 145.9], "ja": "みんな、町を運営するのは" },
    { "t": [145.9, 148.3], "ja": "ただのゲームで、好きに来て" },
    { "t": [148.3, 149.5], "ja": "好きに去っていいとでも思ってるの？" },
    { "t": [149.5, 151.6], "ja": "りょうかーい、レスリー" },
    { "t": [151.6, 153.1], "ja": "クレイグ、今夜は何か予定ある？" },
    { "t": [153.1, 155], "ja": "ああ、仕事が山ほどあるんだ" },
    { "t": [155, 156.9], "ja": "それに、録画機が13か月分でパンパンなんだ" },
    { "t": [156.9, 158.4], "ja": "「スキャンダル」の録画でね" },
    { "t": [158.4, 160.2], "ja": "「スキャンダル」は私の一番好きなドラマよ" },
    { "t": [160.2, 162], "ja": "どのキャラも大好き、ただし…" },
    { "t": [162, 163.5], "ja": "メリー以外、だろ" },
    { "t": [163.5, 165.8], "ja": "ああ、もちろん君は「スキャンダル」が好きだよね" },
    { "t": [165.8, 167.6], "ja": "だって君は最高だから" },
    { "t": [167.6, 168.7], "ja": "大好きだよ" },
    { "t": [168.7, 170.6], "ja": "この仕事がどうなっても" },
    { "t": [170.6, 172.4], "ja": "ずっと大好きだよ" },
    { "t": [172.4, 173.9], "ja": "ちょっと！" },
    { "t": [173.9, 175.7], "ja": "あなた、そもそも誰なの？" }
  ]
}
