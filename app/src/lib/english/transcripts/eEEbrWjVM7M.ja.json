{
  "video": "eEEbrWjVM7M",
  "lines": [
    { "t": [1,3.2], "ja": "私に用か" },
    { "t": [3.2,5.9], "ja": "なんてことだ。いったい何をしている？" },
    { "t": [5.9,7.2], "ja": "逆さ腹筋だよ" },
    { "t": [7.2,9.9], "ja": "すごくいい運動だし、文字通り世界を" },
    { "t": [9.9,11.1], "ja": "違う角度から見られるんだ" },
    { "t": [11.1,14.2], "ja": "男性用のジムでやったらどうだ？" },
    { "t": [14.2,16.1], "ja": "世界全体が僕のジムなんだよ、ロン" },
    { "t": [16.1,18.7], "ja": "でも、君が落ち着かないならやめるよ" },
    { "t": [18.7,21.1], "ja": "降りるとき、支えてくれる？" },
    { "t": [24.6,26], "ja": "本当にありがとう　さよなら、兄弟" },
    { "t": [26,28.4], "ja": "ひとつ質問がある。この規模の町なら" },
    { "t": [28.4,31.3], "ja": "公園課の職員は普通10人いるんだ" },
    { "t": [31.3,33.8], "ja": "君のところは7人しかいない。なぜかな？" },
    { "t": [33.8,35.6], "ja": "私の課ができるだけ小さく、役に立たないように" },
    { "t": [35.6,38.1], "ja": "懸命に努力しているからだ" },
    { "t": [38.1,40.4], "ja": "課がこんなに小さいのは、レスリー・ノープが" },
    { "t": [40.4,42.7], "ja": "一人で4人分の仕事をこなしているからなんだ" },
    { "t": [42.7,44.5], "ja": "しかも彼女は、すでに仕事の時間を減らしている" },
    { "t": [44.5,46.6], "ja": "もし当選したら、時間を公園課と" },
    { "t": [46.6,48.4], "ja": "市議会に分けることになる" },
    { "t": [48.4,50.9], "ja": "その穴を埋めるために、副部長を雇わなきゃいけない" },
    { "t": [50.9,52.6], "ja": "だめだ！" },
    { "t": [52.6,54.5], "ja": "クリス、その必要はない" },
    { "t": [54.5,56.6], "ja": "課はレスリーがいなくても、ちゃんとやっている" },
    { "t": [56.6,57.5], "ja": "じゃあ、それを証明して" },
    { "t": [57.5,58.9], "ja": "大きなプロジェクトを1つ完成させるんだ" },
    { "t": [58.9,61.7], "ja": "役所のプロジェクトを完成させるか" },
    { "t": [61.7,63.1], "ja": "それは私にとっては忌まわしいことだ" },
    { "t": [63.1,65.3], "ja": "課に新しい人間を入れるか" },
    { "t": [65.3,67.2], "ja": "それは心の底からぞっとする" },
    { "t": [67.2,69.7], "ja": "父に選ばされたときのことを思い出す" },
    { "t": [69.7,72.6], "ja": "6歳の誕生日に、飼っていた子牛のうち" },
    { "t": [72.6,74.9], "ja": "どちらを自分の手でつぶすかをな" },
    { "t": [74.9,78.3], "ja": "選べなかったから、両方つぶした" },
    { "t": [78.3,82.3], "ja": "そして、どちらもうまかった" },
    { "t": [82.3,83.9], "ja": "こんにちは、アン・パーキンス" },
    { "t": [83.9,86.4], "ja": "私のフルネームを正しく言ってくれたの、初めてね" },
    { "t": [86.4,88.7], "ja": "何を言う。私たちは親しい友人だ" },
    { "t": [88.7,90.3], "ja": "いい知らせがある" },
    { "t": [90.3,92.8], "ja": "水飲み場の衛生改善を" },
    { "t": [92.8,94.4], "ja": "最優先にすることにした" },
    { "t": [94.4,95.5], "ja": "まあ、よかった！" },
    { "t": [95.5,98.9], "ja": "なぜかポーニーの人たちって、水飲み場を使うとき" },
    { "t": [98.9,102.2], "ja": "口で蛇口を完全にくわえちゃうのよ" },
    { "t": [102.2,105.8], "ja": "変で気持ち悪い、この町だけのくせみたい" },
    { "t": [105.8,108], "ja": "水飲み場で水を飲む人とキスしたら" },
    { "t": [108,111.2], "ja": "ポーニーの全員とキスしてるのと同じよ" },
    { "t": [111.2,112.3], "ja": "彼も含めてね" },
    { "t": [112.3,117], "ja": "このプロジェクトは明日までに完成させたい" },
    { "t": [117,118], "ja": "あら" },
    { "t": [118,118.9], "ja": "うちの部屋で作業してくれ" },
    { "t": [118.9,120.2], "ja": "なんなら、レスリーの机を使え" },
    { "t": [120.2,122.5], "ja": "分かった、そうする。ありがとう。よかった" },
    { "t": [122.5,124.4], "ja": "ドアは開けておくか、閉めるか？" },
    { "t": [124.4,126], "ja": "えっと、開けたままでいいわ。はい" },
    { "t": [132,134.4], "ja": "君の将来について話したい" },
    { "t": [134.4,136.6], "ja": "なんでこのベンチに座ってるの？　変な感じ" },
    { "t": [136.6,140], "ja": "今日はあの問題をよく解決してくれたね" },
    { "t": [140,141.3], "ja": "君が見せたリーダーシップのおかげで" },
    { "t": [141.3,142.7], "ja": "いろいろ考えさせられたよ" },
    { "t": [142.7,144.1], "ja": "あの問題を解決したのは私じゃない" },
    { "t": [144.1,145.3], "ja": "エイプリルだ" },
    { "t": [145.3,146.9], "ja": "本当に？" },
    { "t": [146.9,149], "ja": "じゃあなんで、彼女は君がやったって言ったんだろう？" },
    { "t": [149,150], "ja": "エイプリルだからさ" },
    { "t": [150,151.2], "ja": "自分が何かを本気で気にかけているなんて" },
    { "t": [151.2,154.5], "ja": "君に思われたくないんだ" },
    { "t": [154.5,155.7], "ja": "レスリーの代わりを手伝ってくれる人を" },
    { "t": [155.7,157.6], "ja": "探しているなら" },
    { "t": [157.6,158.7], "ja": "エイプリルは厄介なやつだが" },
    { "t": [158.7,161.3], "ja": "どう見ても答えは彼女だ" },
    { "t": [161.3,163.3], "ja": "君の言う通りかもしれないね" },
    { "t": [167.7,169.4], "ja": "私、行ったほうがいい？" },
    { "t": [169.4,170.3], "ja": "あら、まだいたの？" },
    { "t": [170.3,171.8], "ja": "ええ" },
    { "t": [175.9,176.9], "ja": "水飲み場、よくやったな" },
    { "t": [176.9,178], "ja": "私じゃないよ" },
    { "t": [178,179], "ja": "否定するな" },
    { "t": [179,180.2], "ja": "あの看護師じゃないのは分かっている" },
    { "t": [180.2,181.7], "ja": "もっと力を発揮してほしいんだ" },
    { "t": [181.7,183.5], "ja": "レスリーの代わりになれというんじゃない" },
    { "t": [183.5,184.8], "ja": "少し穴を埋めるだけだ" },
    { "t": [184.8,186.5], "ja": "何かをするのは嫌なの" },
    { "t": [186.5,187.8], "ja": "何もしたくないの" },
    { "t": [187.8,189.3], "ja": "あなたが教えてくれた通りにね" },
    { "t": [189.3,190.3], "ja": "そして私はよく教えた" },
    { "t": [190.3,193.3], "ja": "だが、お前が頭をむだにしているのは見ていたくない" },
    { "t": [193.3,196.1], "ja": "それにお前は、いつまでも私のアシスタントでいるには頭がよすぎる" },
    { "t": [196.1,199.2], "ja": "商売を始めるか、自分の手で農業でもしてほしいところだ" },
    { "t": [199.2,201.3], "ja": "だが今は、課にお前が必要なんだ" },
    { "t": [201.3,204.7], "ja": "頼む" },
    { "t": [204.7,205.7], "ja": "分かった" },
    { "t": [205.7,207.8], "ja": "でも、あなたが頼み込んだからってだけだよ" },
    { "t": [207.8,209.2], "ja": "いい子だ" },
    { "t": [211.2,212.7], "ja": "クリス・トレーガーです" },
    { "t": [212.7,214.2], "ja": "ロン・スワンソンだ" },
    { "t": [214.2,216.9], "ja": "エイプリルがレスリーの仕事の一部を引き受けることになった" },
    { "t": [216.9,217.4], "ja": "すばらしい" },
    { "t": [217.4,219.5], "ja": "僕は最初の日からエイプリルのファンなんだ" },
    { "t": [219.5,221.5], "ja": "僕は言ったんだ…" }
  ]
}
