{
  "video": "D_Ny_S2UC_U",
  "lines": [
    { "t": [0,  2], "ja": "もう、あなたの服、どれもセクシーすぎ" },
    { "t": [2,  4], "ja": "これなんて、ジュリア・ロバーツが着たドレスよ" },
    { "t": [4,  5], "ja": "「プリティ・ウーマン」で娼婦役のときに" },
    { "t": [5,  7], "ja": "そうなの。着ると私、すごく似合うのよ" },
    { "t": [7,  9], "ja": "なんか、スウェットの上下とかが必要ね" },
    { "t": [9,  11], "ja": "何も起きないってサインを出さなきゃ" },
    { "t": [11,  13], "ja": "ああ、どうかしてる" },
    { "t": [13,  16], "ja": "二人が一緒になりたくてたまらないのは見え見えよ" },
    { "t": [16,  17], "ja": "なのに今度は車で旅行？" },
    { "t": [17,  20], "ja": "もう、本当に二人で部屋を取ればいいのに" },
    { "t": [20,  21], "ja": "ええ、それで本当にクビにされちゃうけどね" },
    { "t": [21,  24], "ja": "わかった。彼を誘惑しない作戦、手伝ってあげる" },
    { "t": [24,  26], "ja": "他に何が必要か言って" },
    { "t": [26,  29], "ja": "色気のない、退屈な話題を考えなきゃ" },
    { "t": [29,  30], "ja": "車の中で話せるようなね" },
    { "t": [30,  32], "ja": "いくつか案があるの" },
    { "t": [32,  34], "ja": "「ニューヨーカー」誌の記事について話せる" },
    { "t": [34,  36], "ja": "「はしごの歴史」っていう" },
    { "t": [36,  37], "ja": "いいわね" },
    { "t": [37,  38], "ja": "いろんな寮の話もできる" },
    { "t": [38,  40], "ja": "ジョンズ・ホプキンス大学の" },
    { "t": [40,  42], "ja": "それに、電動歯ブラシの説明書を読み上げられる" },
    { "t": [42,  44], "ja": "あ、いい考えがある。何？" },
    { "t": [44,  46], "ja": "彼のアソコについて聞いてみたら？" },
    { "t": [48,  51], "ja": "そう、だから基本的にどの寮でもベッドを高くしていいんだけど" },
    { "t": [51,  53], "ja": "学生たちが特に気に入ってるのが" },
    { "t": [53,  54], "ja": "ウールマン寮とマッコイ寮なの" },
    { "t": [54,  56], "ja": "ジョンズ・ホプキンスに通ってたの？" },
    { "t": [56,  58], "ja": "いいえ" },
    { "t": [58,  61], "ja": "音楽でもかける？" },
    { "t": [61,  62], "ja": "いいよ" },
    { "t": [62,  64], "ja": "アンと私で、旅行用に最高の音楽ディスクを焼いたの" },
    { "t": [64,  66], "ja": "ジミー・カーターの「信頼の危機」演説" },
    { "t": [66,  68], "ja": "中国語の学習" },
    { "t": [68,  71], "ja": "16分間の昔の車のクラクション" },
    { "t": [71,  75], "ja": "それに「バンジョー・ブギー・ボナンザ」っていうの" },
    { "t": [75,  81], "ja": "すごい楽器よね、バンジョーって" },
    { "t": [81,  86], "ja": "ああ、こんなにうるさいとは知らなかった" },
    { "t": [90,  91], "ja": "これは何？" },
    { "t": [91,  93], "ja": "クジラの声？" },
    { "t": [93,  94], "ja": "そう" },
    { "t": [94,  96], "ja": "変えたかったら変えていいよ" },
    { "t": [96,  97], "ja": "うん" },
    { "t": [97,  98], "ja": "何これ？" },
    { "t": [98,  102], "ja": "あら、いえいえ、いい曲みたいね" },
    { "t": [102,  107], "ja": "ええ、アル・グリーンの曲をこっそり入れたの" },
    { "t": [107,  109], "ja": "二人にくっついてほしいの" },
    { "t": [109,  110], "ja": "文句ある？" },
    { "t": [110,  111], "ja": "これ見た？" },
    { "t": [111,  112], "ja": "規則によると" },
    { "t": [112,  114], "ja": "市内に十分なホテルの部屋がないかもしれない" },
    { "t": [114,  117], "ja": "ああ、ばかげた規則よね" },
    { "t": [117,  119], "ja": "でも、話が分かる人たちで、気にしないかも" },
    { "t": [119,  121], "ja": "うん、指摘すればいいかもね" },
    { "t": [121,  123], "ja": "市のすぐ外にホテルの部屋はたくさんあるって" },
    { "t": [123,  124], "ja": "ああ、そうね" },
    { "t": [124,  127], "ja": "グランビル・ホテル・アンド・スパって行ったことある？" },
    { "t": [127,  128], "ja": "ううん" },
    { "t": [128,  130], "ja": "あそこのタオル、すごくふわふわなの" },
    { "t": [130,  131], "ja": "ああ、言わせてもらうと" },
    { "t": [131,  133], "ja": "僕は、いいタオルが大好きなんだ" },
    { "t": [133,  134], "ja": "私も。分かる" },
    { "t": [134,  135], "ja": "つまり、一番シンプルな贅沢だけど" },
    { "t": [135,  137], "ja": "それで全然違うのよね" },
    { "t": [137,  139], "ja": "バスマットも最高なの" },
    { "t": [139,  140], "ja": "子羊を踏んでるみたい" },
    { "t": [140,  141], "ja": "…" },
    { "t": [141,  144], "ja": "あ、待って" },
    { "t": [144,  146], "ja": "ほら、こっち来て" },
    { "t": [146,  148], "ja": "顔にまつげがついてる" },
    { "t": [148,  150], "ja": "取れた" },
    { "t": [150,  151], "ja": "願い事をして" },
    { "t": [151,  153], "ja": "中国語を話そう。第3課" },
    { "t": [153,  154], "ja": "離れて" },
    { "t": [154,  155], "ja": "ごめん" },
    { "t": [158,  160], "ja": "私、指アレルギーなの" },
    { "t": [160,  161], "ja": "どこへ行きますか？" },
    { "t": [161,  162], "ja": "チュイナール" },
    { "t": [162,  164], "ja": "もう、旅行が終わるまで" },
    { "t": [164,  165], "ja": "お互い話さないほうがいいかも" },
    { "t": [165,  167], "ja": "私はプレゼンに集中するから" },
    { "t": [167,  168], "ja": "チュイナール" },
    { "t": [168,  169], "ja": "はい" },
    { "t": [169,  170], "ja": "これは私の弟です" },
    { "t": [170,  172], "ja": "…" }
  ]
}
