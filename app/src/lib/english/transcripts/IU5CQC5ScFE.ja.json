{
  "video": "IU5CQC5ScFE",
  "lines": [
    { "t": [0.7,  2.2], "ja": "よく考えてみよう" },
    { "t": [2.2,  6.2], "ja": "本社にそれを頼んだら…" },
    { "t": [6.2,  11.2], "ja": "イエスかノーか、どちらかを言うだろう" },
    { "t": [11.6,  12.5], "ja": "どっちに転ぶか分からない" },
    { "t": [12.5,  15.2], "ja": "何て言うかは分からないからね" },
    { "t": [15.2,  16.5], "ja": "よく考えろ！" },
    { "t": [16.5,  17.5], "ja": "よく考えなきゃだめだ！" },
    { "t": [17.5,  20.5], "ja": "もしノーと言われたら…" },
    { "t": [22.6,  23.4], "ja": "やめません？" },
    { "t": [23.4,  24.5], "ja": "いや、だめだ、やらなきゃ" },
    { "t": [24.5,  25.4], "ja": "なぜか分かるか？" },
    { "t": [25.4,  27.3], "ja": "一日中、あのオフィスに" },
    { "t": [27.3,  29.3], "ja": "あの箱の中に閉じこもっていたくないんだ" },
    { "t": [29.3,  30.3], "ja": "ハイズマン！" },
    { "t": [30.3,  32.1], "ja": "考える必要があるからだ" },
    { "t": [32.1,  33.3], "ja": "いいか、ジム？" },
    { "t": [33.3,  34.1], "ja": "おお、ケビン！" },
    { "t": [34.1,  34.9], "ja": "おお！" },
    { "t": [39.5,  40.3], "ja": "ナイスキャッチ" },
    { "t": [40.3,  41.3], "ja": "んー、んー、んー、んー！" },
    { "t": [41.3,  42.2], "ja": "オスカー！" },
    { "t": [43.7,  44.7], "ja": "インターセプトだ！" },
    { "t": [44.7,  46.1], "ja": "こっちだ、よこせ" },
    { "t": [46.1,  46.9], "ja": "フィリップス、ボールをよこせ" },
    { "t": [46.9,  48.4], "ja": "よし、ボールをよこせ" },
    { "t": [48.4,  50.5], "ja": "みんな、クリード、今すぐボールをよこせ" },
    { "t": [50.5,  51.4], "ja": "よこせ" },
    { "t": [51.4,  52.2], "ja": "ライアン！" },
    { "t": [54.2,  55.4], "ja": "ファンブル！" },
    { "t": [58.6,  59.4], "ja": "ああ！" },
    { "t": [59.4,  60.1], "ja": "よし、おい！" },
    { "t": [60.1,  61], "ja": "ああ！" },
    { "t": [61,  61.9], "ja": "ははは！" },
    { "t": [61.9,  62.9], "ja": "うわっ！" },
    { "t": [62.9,  65.4], "ja": "ハット、ハット、ハット、ハット、ハイク！" },
    { "t": [69.4,  70.3], "ja": "大丈夫か、ライアン？" },
    { "t": [70.3,  71.5], "ja": "ライアン" },
    { "t": [71.5,  72.4], "ja": "うん" },
    { "t": [75,  76.1], "ja": "パム！" },
    { "t": [76.1,  80.3], "ja": "でも真面目な話、セールスマンとセールスウーマンの違いは何だ？" },
    { "t": [80.3,  81.6], "ja": "セールスウーマンには女性器がある" },
    { "t": [81.6,  82.4], "ja": "冗談だよ、ドワイト" },
    { "t": [82.4,  83.3], "ja": "性教育の授業じゃないんだ" },
    { "t": [83.3,  84], "ja": "でも、合ってます" },
    { "t": [84,  87], "ja": "ああ、男と女の違いについては合ってる。でも、冗談のオチとしては" },
    { "t": [87,  88], "ja": "違う" },
    { "t": [88,  89.1], "ja": "だろ？" },
    { "t": [89.1,  93.4], "ja": "セールスマンとセールスウーマンの違いは、おっぱいだ" },
    { "t": [93.4,  96.3], "ja": "ねえ、自分がしたスピーチって覚えてます？" },
    { "t": [96.3,  97.3], "ja": "覚えてるよ、二つともね" },
    { "t": [97.3,  98.7], "ja": "どっちか一つ、写しをもらえませんか？" },
    { "t": [98.7,  99.7], "ja": "だめ、だめ、みんな覚えてるから" },
    { "t": [99.7,  104.5], "ja": "いいか、何を言うかは関係ない。大事なのは、みんなが関心を持つことを" },
    { "t": [104.5,  105.4], "ja": "話してるってことなんだ" },
    { "t": [105.4,  106.4], "ja": "いいね？" },
    { "t": [106.4,  107.4], "ja": "よし" },
    { "t": [107.4,  108.4], "ja": "いくぞ" },
    { "t": [108.4,  109.4], "ja": "見てろ" },
    { "t": [109.4,  110.4], "ja": "みんな、注目" },
    { "t": [110.4,  111.4], "ja": "注目してくれ" },
    { "t": [111.4,  114], "ja": "本社から、とてもいい知らせがある" },
    { "t": [114,  119.9], "ja": "素晴らしい四半期だったので、その結果、全員に1000ドルのボーナスが出る" },
    { "t": [119.9,  120.9], "ja": "やった！" },
    { "t": [120.9,  122.3], "ja": "おめでとう" },
    { "t": [128.3,  129.3], "ja": "見たか？" },
    { "t": [129.3,  130.5], "ja": "私への反応を見たか？" },
    { "t": [130.5,  132.6], "ja": "あの瞬間、みんなの心をつかんでいたんだ" },
    { "t": [132.6,  134.4], "ja": "ボーナスのこと、本当にうれしい" },
    { "t": [134.4,  136], "ja": "いや、いや、本当じゃないよ" },
    { "t": [136,  137.5], "ja": "ただしゃべってただけだ" },
    { "t": [137.5,  140.2], "ja": "だから、とにかく行って何か言えばいい" },
    { "t": [140.2,  141], "ja": "堂々と話すんだ" },
    { "t": [141,  142.3], "ja": "いい聴衆だから" },
    { "t": [142.3,  144.3], "ja": "さあ、思い切りやれ" },
    { "t": [144.3,  145.8], "ja": "とことん盛り上げていいぞ" },
    { "t": [145.8,  146.5], "ja": "何ですって？" },
    { "t": [146.5,  147.6], "ja": "（聞き取れない）" },
    { "t": [147.6,  149.5], "ja": "皆さん、注目してください" },
    { "t": [149.5,  153], "ja": "84号線西行きで事故がありました" },
    { "t": [153,  156.1], "ja": "車が道路から滑って、ガードレールに突っ込みました" },
    { "t": [156.1,  157.9], "ja": "何台かが横転しました" },
    { "t": [157.9,  159.7], "ja": "ガラスの破片があちこちに散らばっています" },
    { "t": [159.7,  162], "ja": "何人かがけがをしています" },
    { "t": [162,  165.5], "ja": "事故に遭った人の中に、知り合いはいる？" },
    { "t": [165.5,  168.9], "ja": "ブラッド・ピットです" },
    { "t": [168.9,  170.7], "ja": "それと、ボーナスはありません" },
    { "t": [170.7,  172.7], "ja": "なんでそれがボーナスに関係あるの？" },
    { "t": [172.7,  173.6], "ja": "関係はありません" },
    { "t": [173.6,  174.8], "ja": "ブラッドは無事なの？" },
    { "t": [174.8,  176.8], "ja": "彼はもう二度と演技できません" },
    { "t": [176.8,  179], "ja": "それと、この支店は閉鎖されます" },
    { "t": [179,  180.2], "ja": "一体どうなってるんだ？" },
    { "t": [180.2,  181.3], "ja": "私たち、失業するの？" },
    { "t": [181.3,  182.1], "ja": "はい" },
    { "t": [182.1,  184.7], "ja": "これは、ジェニファー・アニストンにしたことの報いよ" },
    { "t": [184.7,  185.5], "ja": "冗談だよ" },
    { "t": [185.5,  186.4], "ja": "ドワイトは冗談を言ったんだ" },
    { "t": [186.4,  189.1], "ja": "なぜかは分からない。面白くなかったし" },
    { "t": [189.1,  190.9], "ja": "ひどいだけだった" },
    { "t": [191.7,  192.9], "ja": "マイケル。何だ" },
    { "t": [192.9,  194.3], "ja": "ボーナスが出るって言ったわよね" },
    { "t": [194.3,  196.4], "ja": "よし、みんな、今すぐ会議室に" },
    { "t": [196.4,  197.4], "ja": "さあ" },
    { "t": [197.4,  198.2], "ja": "やろう" },
    { "t": [198.2,  218.8], "ja": "やろう" }
  ]
}
