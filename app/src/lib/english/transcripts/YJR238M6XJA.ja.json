{
  "video": "YJR238M6XJA",
  "lines": [
    { "t": [0.8,2.6], "ja": "誘ってくれてありがとうございます" },
    { "t": [2.6,4], "ja": "ああ、いいよ" },
    { "t": [4,5.4], "ja": "全然深く考えてなかったけどな" },
    { "t": [5.4,6.6], "ja": "待てよ、お前、来ていいのか？" },
    { "t": [9.4,11], "ja": "もしもし、あなた" },
    { "t": [11,12.4], "ja": "マイケル？－やあ、かわいい人" },
    { "t": [12.4,13.4], "ja": "どうも。－今向かってるところだ" },
    { "t": [13.4,14.8], "ja": "あと15分くらいで着く…" },
    { "t": [14.8,16.4], "ja": "パーティーなんてすっぽかしちゃいましょうよ" },
    { "t": [16.4,17.3], "ja": "それ、エッチな意味に聞こえるね" },
    { "t": [17.3,18.5], "ja": "うん" },
    { "t": [18.5,19.8], "ja": "私、スピーカーフォンになってる？" },
    { "t": [19.8,21.7], "ja": "ああ、なってるよ" },
    { "t": [21.7,22.9], "ja": "ほかに誰かいるの？" },
    { "t": [22.9,23.9], "ja": "どうも、ジャン" },
    { "t": [23.9,24.8], "ja": "こんにちは、ドワイト" },
    { "t": [24.8,26.8], "ja": "じゃあ、マイケル、スピーカーフォンを切って" },
    { "t": [26.8,28.2], "ja": "了解" },
    { "t": [30,32.9], "ja": "ねえ、モーテルに行って" },
    { "t": [32.9,35.5], "ja": "ジャマイカの黒い砂のビーチでしたみたいに" },
    { "t": [35.5,36.8], "ja": "激しく求め合いましょう" },
    { "t": [36.8,39.4], "ja": "ジャン、ジャン、このパーティーは実は" },
    { "t": [39.4,41.9], "ja": "僕たちにとってすごく大きな一歩なんだ。だから…" },
    { "t": [41.9,43.3], "ja": "まだスピーカーになってる？" },
    { "t": [43.3,46.1], "ja": "えっと、さあ、どうかな" },
    { "t": [46.1,47.4], "ja": "カメラがいるの？" },
    { "t": [47.4,48.8], "ja": "かもね" },
    { "t": [48.8,50.5], "ja": "分かった、またあとで" },
    { "t": [50.5,51.8], "ja": "じゃあ。－またあとで話しましょう、ジャン" },
    { "t": [51.8,53], "ja": "うん、じゃあね" },
    { "t": [54.4,56.2], "ja": "すばらしい" },
    { "t": [56.2,57.1], "ja": "ありがとうございます" },
    { "t": [57.1,59], "ja": "たくさん、ありがとう、みなさん" },
    { "t": [60,63.8], "ja": "お前、使用人とまったく同じかっこうをしてるぞ" },
    { "t": [63.8,64.9], "ja": "うるさい" },
    { "t": [64.9,67], "ja": "よし、シャツを交換しろ" },
    { "t": [67,67.9], "ja": "待って" },
    { "t": [67.9,70.3], "ja": "あなたのじゃ、私には合わないと思います" },
    { "t": [70.3,71.3], "ja": "かまうもんか" },
    { "t": [78.1,79.5], "ja": "うわあ" },
    { "t": [79.5,84.5], "ja": "ほら、俺の上着は着るな、それはよこすな" },
    { "t": [84.5,87.5], "ja": "あれは本当に恥ずかしいことになるところだった" },
    { "t": [87.5,90.1], "ja": "はい、危機一髪でした" },
    { "t": [90.1,91], "ja": "よし" },
    { "t": [92.7,94.4], "ja": "どうも" },
    { "t": [94.4,98.8], "ja": "実は、早く着くのは礼儀正しいことなんだ。それに賢い" },
    { "t": [99.7,102.3], "ja": "本当に仲のいい友だちしか、早くは来ない" },
    { "t": [102.3,104.8], "ja": "だから当然、パーティーに早く行けば" },
    { "t": [104.8,106.3], "ja": "本当に仲のいい友だちになれるってわけだ" },
    { "t": [106.3,108.3], "ja": "あら、ポテトサラダ" },
    { "t": [108.3,109.3], "ja": "それは僕たち二人からです" },
    { "t": [109.3,110.4], "ja": "いいえ、違います" },
    { "t": [110.4,111.8], "ja": "まあ、すてき" },
    { "t": [111.8,114.9], "ja": "どこに置けるか見てみましょう" },
    { "t": [116.6,118.7], "ja": "あ、ほら、ふたはしておいたほうがいいですよ" },
    { "t": [118.7,120.3], "ja": "お客さんが来るまでは" },
    { "t": [120.3,122.8], "ja": "一日中、私の車の中に置いてあったので" },
    { "t": [124,125.8], "ja": "太陽がマヨネーズに照りつけてたんです" },
    { "t": [126.8,129.9], "ja": "まあ、何があるか分かりませんから" },
    { "t": [129.9,132], "ja": "ああ、どういたしまして" }
  ]
}
