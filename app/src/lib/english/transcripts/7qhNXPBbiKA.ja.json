{
  "video": "7qhNXPBbiKA",
  "lines": [
    { "t": [0,  1.2], "ja": "ハヤブサ、進入！" },
    { "t": [1.2,  2.3], "ja": "キジバト、了解" },
    { "t": [2.3,  3.3], "ja": "ねえ、どこにいるの？" },
    { "t": [3.3,  4], "ja": "ここよ" },
    { "t": [4,  5.8], "ja": "よし、今すぐ役割分担を確認しよう" },
    { "t": [5.8,  7.8], "ja": "アン、ドレスと髪とメイクを担当して" },
    { "t": [7.8,  11.2], "ja": "イメージは、エレノア・ルーズベルトの色気と" },
    { "t": [11.2,  13.8], "ja": "レスリー・スタールの野性的な魅力を合わせた感じ" },
    { "t": [13.8,  14.5], "ja": "朝飯前よ" },
    { "t": [14.5,  16], "ja": "あ、ウエディングケーキも用意しなきゃ" },
    { "t": [16,  17], "ja": "それも私がやる" },
    { "t": [17,  19], "ja": "私はいたって冷静よ" },
    { "t": [19,  21.6], "ja": "レスリーにやらされてきたとんでもないことは全部" },
    { "t": [21.6,  24.5], "ja": "訓練みたいなもので、今日が本番って気がするの" },
    { "t": [24.5,  27.5], "ja": "準備はできてる。世界一の先生がいたから" },
    { "t": [27.5,  29.9], "ja": "いかれたレスリーっていう先生がね" },
    { "t": [29.9,  32], "ja": "それと、指輪と結婚許可証も要る" },
    { "t": [32,  33.2], "ja": "あ、指輪は僕にやらせて" },
    { "t": [33.2,  34.1], "ja": "指輪の意味が大好きなんだ" },
    { "t": [34.1,  34.6], "ja": "いいね" },
    { "t": [34.6,  35.6], "ja": "それと許可証は私がやれる" },
    { "t": [35.6,  37], "ja": "市役所に知り合いがいるの" },
    { "t": [37,  38.1], "ja": "その知り合いは僕の妻" },
    { "t": [38.1,  39.8], "ja": "えーと、あなたもそこで働いてるでしょ" },
    { "t": [39.8,  41], "ja": "あ、そうだった" },
    { "t": [41,  41.7], "ja": "ねえ、すごくない？" },
    { "t": [41.7,  43.1], "ja": "僕、明日から警官になるんだ" },
    { "t": [43.1,  44.9], "ja": "今夜のうちに、できるだけたくさん犯罪をしておいたほうがいいな" },
    { "t": [44.9,  45.9], "ja": "すっきり済ませておくために" },
    { "t": [45.9,  46.8], "ja": "ピッ" },
    { "t": [46.8,  48.4], "ja": "結婚許可証、見っけ" },
    { "t": [48.4,  50], "ja": "全部持っていっちゃう" },
    { "t": [50,  51.6], "ja": "この町で他の人に結婚してほしくないの" },
    { "t": [51.6,  53.3], "ja": "私たちの特別感が薄れるから" },
    { "t": [53.3,  54.5], "ja": "いい判断だね、ベイブ" },
    { "t": [54.5,  55.3], "ja": "行こう" },
    { "t": [55.3,  56.6], "ja": "よし" },
    { "t": [58.6,  59.7], "ja": "大丈夫" },
    { "t": [59.7,  61.2], "ja": "完成してない" },
    { "t": [61.2,  62.9], "ja": "どうして仕立て屋さんは仕上げてくれなかったの？" },
    { "t": [62.9,  64.7], "ja": "3か月前に仕上げるつもりがないなら" },
    { "t": [64.7,  65.8], "ja": "仕事を引き受けちゃだめでしょ" },
    { "t": [65.8,  67.3], "ja": "何かできることがあるはず" },
    { "t": [67.3,  68.3], "ja": "この結婚式は運命なんだから" },
    { "t": [68.3,  69.2], "ja": "何とかなるわ" },
    { "t": [69.2,  72.3], "ja": "さて、シンデレラはどうやってあんなに早くドレスを仕上げたんだっけ？" },
    { "t": [72.3,  73.7], "ja": "リスと鳥ね" },
    { "t": [73.7,  74.8], "ja": "あまり役に立たないわね" },
    { "t": [74.8,  75.9], "ja": "ねえ、手に入れたよ" },
    { "t": [75.9,  76.7], "ja": "結婚許可証" },
    { "t": [76.7,  77.6], "ja": "完了" },
    { "t": [77.6,  78.1], "ja": "ちょっと待って" },
    { "t": [78.1,  78.7], "ja": "待って" },
    { "t": [78.7,  81], "ja": "市の書記官室の誰かのサインが必要なんだ" },
    { "t": [81,  81.8], "ja": "私が偽造する" },
    { "t": [81.8,  83.3], "ja": "役所の書類なんて、しょっちゅう偽造してるし" },
    { "t": [83.3,  83.8], "ja": "本当だよ" },
    { "t": [83.8,  84.2], "ja": "はい" },
    { "t": [84.2,  86.5], "ja": "ああ、まずい" },
    { "t": [86.5,  87.3], "ja": "もしもし" },
    { "t": [87.3,  88.2], "ja": "もしもし" },
    { "t": [88.2,  90], "ja": "それで、指輪が見つからなかったの" },
    { "t": [90,  91.7], "ja": "ええ、こっちもいくつか壁にぶつかってる" },
    { "t": [91.7,  93.3], "ja": "なんだか全部うまくいかなくなってる気がする" },
    { "t": [93.3,  94.1], "ja": "慌てないで" },
    { "t": [94.1,  97.6], "ja": "絶対、ママにもらった古い箱の中に指輪があるはずなの" },
    { "t": [97.6,  99.3], "ja": "まだエイプリルとアンディの家にある" },
    { "t": [99.3,  100.4], "ja": "探すの、手伝いに来てくれる？" },
    { "t": [100.4,  101.1], "ja": "いいよ" },
    { "t": [101.1,  101.7], "ja": "アンはドレス係" },
    { "t": [101.7,  102.9], "ja": "エイプリルとアンディは許可証係" },
    { "t": [102.9,  104.3], "ja": "動詞を使う暇もないの" },
    { "t": [104.3,  105.4], "ja": "急いでるのは分かるけどさ、レスリー" },
    { "t": [105.4,  107.4], "ja": "「係」って言ったよね" },
    { "t": [107.4,  108.4], "ja": "2回も" },
    { "t": [108.4,  109.4], "ja": "分かった" },
    { "t": [113.4,  115.2], "ja": "ビーバーズさん、警察の公式な用件です" },
    { "t": [115.2,  116.1], "ja": "起こしてなければいいんですけど" },
    { "t": [116.1,  118.4], "ja": "もう10時過ぎよ" },
    { "t": [118.4,  120.3], "ja": "4時間前から寝てたの" },
    { "t": [120.3,  121.1], "ja": "何の用？" },
    { "t": [121.1,  123.1], "ja": "これにサインしてほしいんです" },
    { "t": [123.1,  124.4], "ja": "結婚許可証です" },
    { "t": [124.4,  126.5], "ja": "エセル、泥棒かい？" },
    { "t": [126.5,  128.2], "ja": "違うわ、寝てなさい" },
    { "t": [128.2,  129.7], "ja": "あ、あれって旦那さん？" },
    { "t": [129.7,  130.5], "ja": "結婚してないわ" },
    { "t": [130.5,  132], "ja": "今夜デートだったの" },
    { "t": [132,  132.7], "ja": "うまくいったわ" },
    { "t": [132.7,  135.1], "ja": "彼は泊まっていくの" },
    { "t": [135.1,  136.4], "ja": "いいね" },
    { "t": [136.4,  137.7], "ja": "サインしてもらえたら、本当にうれしいんです" },
    { "t": [137.7,  139.4], "ja": "レスリー・ノープとベン・ワイアットのです" },
    { "t": [139.4,  140.4], "ja": "知ってますよね？" },
    { "t": [140.4,  142.9], "ja": "一度、凍えるほど寒い中に私を引っぱり出したのよ" },
    { "t": [142.9,  145.1], "ja": "二人で「愛してる」って言い合うために" },
    { "t": [145.1,  146.2], "ja": "迷惑だったわ" },
    { "t": [146.2,  148.2], "ja": "わあ、本当にありがとう" },
    { "t": [148.2,  150.2], "ja": "すごい家だし、パジャマもすごくかっこいいし" },
    { "t": [150.2,  151.5], "ja": "デートもすごく上手そうですね" },
    { "t": [151.5,  153.5], "ja": "うん、だから僕らのおばあちゃんになってもらっていい？" },
    { "t": [153.5,  154.3], "ja": "いいわよ" },
    { "t": [154.3,  154.8], "ja": "やった" },
    { "t": [154.8,  155.6], "ja": "じゃあね、大好きだよ、おばあちゃん" },
    { "t": [155.6,  157.4], "ja": "大好きだよ、おばあちゃん" },
    { "t": [157.4,  161.1], "ja": "あなたの仕事の中から、思い出深い法案や写真、書類" },
    { "t": [161.1,  163.4], "ja": "メモを全部集めたの" },
    { "t": [163.4,  163.9], "ja": "どう思う？" },
    { "t": [163.9,  164.9], "ja": "いいかな？" },
    { "t": [164.9,  166.9], "ja": "今まで見た中で、一番きれいなものよ" },
    { "t": [166.9,  169.7], "ja": "ドレスでいえば、アン・パーキンスみたいな存在ね" },
    { "t": [169.7,  170.8], "ja": "やった" },
    { "t": [170.8,  172.3], "ja": "本当に素晴らしい" },
    { "t": [172.3,  173.8], "ja": "準備できた" },
    { "t": [173.8,  175.7], "ja": "レスリー、わあ" },
    { "t": [175.7,  177.4], "ja": "すごくきれい" },
    { "t": [177.4,  178.6], "ja": "うそでしょ" },
    { "t": [178.6,  179.3], "ja": "何？" },
    { "t": [179.3,  180.9], "ja": "結婚式の前に、あなたを見ちゃいけないのに" },
    { "t": [180.9,  181.5], "ja": "いや、それは花婿の話よ" },
    { "t": [181.5,  182.2], "ja": "台無しにしちゃった" },
    { "t": [182.2,  183.6], "ja": "アンディ、それは花婿よ" },
    { "t": [183.6,  185.1], "ja": "まあ、彼のことも見ちゃったし" },
    { "t": [185.1,  186.9], "ja": "念のため、目を隠しておくよ" },
    { "t": [186.9,  190.7], "ja": "よし、あなたの結婚式とかの準備、外はできたわよ" },
    { "t": [190.7,  191.2], "ja": "うそでしょ" },
    { "t": [191.2,  193.7], "ja": "許可証も、指輪も、司式者も、全部？" },
    { "t": [193.7,  196.2], "ja": "ええ、全部そろった" },
    { "t": [196.2,  197], "ja": "行きましょう" }
  ]
}
