{
  "video": "5KuiOGNpa-0",
  "lines": [
    { "t": [0.8,2.9], "ja": "男の子だったら、僕はすごくうれしいな" },
    { "t": [2.9,5.6], "ja": "僕は人の顔をそる技を極めたから" },
    { "t": [5.6,7.5], "ja": "それを受け継がせたいんだ" },
    { "t": [7.5,9.8], "ja": "おもちゃのトラックに、ヒーローの衣装" },
    { "t": [9.8,12.4], "ja": "どんぐりみたいなちっちゃいおちんちん、もうたまらない" },
    { "t": [12.4,14.2], "ja": "変な想像だけど、それでも" },
    { "t": [14.2,15.5], "ja": "僕のやる気は少しも下がらないよ" },
    { "t": [15.5,17.9], "ja": "ウィリアム・パーキンス、知る準備はできてる？" },
    { "t": [17.9,19.1], "ja": "私たちの赤ちゃんの性別" },
    { "t": [20.1,21], "ja": "できてるよ" },
    { "t": [21,23.7], "ja": "私たちの赤ちゃんは…" },
    { "t": [23.7,24.7], "ja": "「分配」" },
    { "t": [25.8,27.2], "ja": "そう読めるよ、「分配」って" },
    { "t": [27.2,29], "ja": "ちょっと見せて" },
    { "t": [29,31.2], "ja": "「おめでとう」って書いてあると思う" },
    { "t": [31.2,34.1], "ja": "それから「アイ・レッグ・スマーフ」って" },
    { "t": [34.1,35.4], "ja": "スマーフが生まれるの？" },
    { "t": [35.4,38.8], "ja": "「11ジュールのトイレ」が生まれるんだって" },
    { "t": [38.8,41.1], "ja": "どれが文字でどれが記号なのか分からない" },
    { "t": [41.1,42.3], "ja": "気になって死にそう" },
    { "t": [42.3,43.4], "ja": "サパースタイン先生に電話する" },
    { "t": [43.4,45.1], "ja": "僕はドミノ・ピザに電話する" },
    { "t": [45.1,47.4], "ja": "ドミノってこのレストランにも配達してくれると思う。だといいな" },
    { "t": [47.4,49.7], "ja": "ああ、だめだ。先生は今日はもう戻らないって" },
    { "t": [49.7,54], "ja": "こんなにストレスを感じたこと、本当に生まれて初めて" },
    { "t": [56.7,59.2], "ja": "朝の6時に、いったい何の用だい？" },
    { "t": [59.2,60.9], "ja": "先生の字が読めなくて" },
    { "t": [60.9,62.1], "ja": "赤ちゃんの性別を知りたいんです" },
    { "t": [62.1,64.8], "ja": "息子とアニメを見ているところなんだ" },
    { "t": [64.8,67.9], "ja": "見てる番組が始まったんだ、邪魔しないで" },
    { "t": [67.9,69], "ja": "やあ、美人さん" },
    { "t": [69,71], "ja": "ジャン・ラルフィオ。離れに住んでるんだ" },
    { "t": [71,74], "ja": "俺と君で、ちょっと特別な感じで仲良くならない？" },
    { "t": [74,74.8], "ja": "私、妊娠してるの" },
    { "t": [74.8,75.7], "ja": "多いほうが楽しいじゃん" },
    { "t": [75.7,76.6], "ja": "僕の子をね" },
    { "t": [76.6,78.4], "ja": "じゃあ君も来なよ、美人さん" },
    { "t": [78.4,79.3], "ja": "見てよ、これ" },
    { "t": [79.3,81.2], "ja": "俺、男にも「美人」って言っちゃうんだよね" },
    { "t": [81.2,84.9], "ja": "めちゃくちゃ心が広いんだろうな" },
    { "t": [84.9,87], "ja": "君、なかなかイケてると思うよ" },
    { "t": [87,87.8], "ja": "ありがとう" },
    { "t": [87.8,90], "ja": "とにかくそれを読んで、性別を教えてください" },
    { "t": [90,91.1], "ja": "うわ" },
    { "t": [91.1,92.6], "ja": "これを書いたニワトリが" },
    { "t": [92.6,94.7], "ja": "紙の上で発作でも起こしたみたいだな" },
    { "t": [94.7,97], "ja": "まあ、聞いてくれ。なんとなく覚えてはいるんだが" },
    { "t": [97,99.3], "ja": "間違ったことは言いたくない" },
    { "t": [99.3,100.4], "ja": "15分待ってくれ" },
    { "t": [100.4,101.5], "ja": "着替えるから" },
    { "t": [101.5,102.9], "ja": "診療所へ行こう" },
    { "t": [102.9,103.7], "ja": "はい" },
    { "t": [103.7,105.4], "ja": "じゃあ、今日もお仕事がんばってね、パパ" },
    { "t": [105.4,106.9], "ja": "あと、もしまだ知らなかったら言っとくけど" },
    { "t": [106.9,108.9], "ja": "テレビが故障しててさ" },
    { "t": [108.9,111.5], "ja": "勝手にポルノを注文しちゃうんだ。それも山ほど" },
    { "t": [111.5,114.3], "ja": "一度にあんな量のポルノを見られる人なんて、いるわけないよね" },
    { "t": [114.3,115.3], "ja": "しかもパパが家にいないときだけ" },
    { "t": [115.3,116.8], "ja": "だから請求書に載ってたら、それが理由だから" },
    { "t": [116.8,118], "ja": "いい？" },
    { "t": [118,120.5], "ja": "さあ、いよいよだ。運命の瞬間だよ" },
    { "t": [121.7,123.5], "ja": "どっちがいい？" },
    { "t": [123.5,126.2], "ja": "正直、どっちでもうれしい" },
    { "t": [126.2,127.2], "ja": "僕も" },
    { "t": [127.2,130.1], "ja": "男の子でも女の子でも関係ない" },
    { "t": [130.1,132.3], "ja": "だって間違いなく" },
    { "t": [132.3,134.9], "ja": "史上最高の子どもになるんだから" },
    { "t": [134.9,137.2], "ja": "本当に希望はないって誓える？" },
    { "t": [137.2,138.6], "ja": "あなたは？" },
    { "t": [138.6,140.5], "ja": "全然ないよ" },
    { "t": [140.5,142.4], "ja": "準備はいいかな？　手を挙げて" },
    { "t": [142.4,143.2], "ja": "男の子だ！" },
    { "t": [143.2,144.6], "ja": "やった！" },
    { "t": [144.6,146], "ja": "希望はないって言ってなかった？" },
    { "t": [146,148.3], "ja": "言ったよ。でも本当は、男の子がいいなってすごく思ってた" },
    { "t": [148.3,150.5], "ja": "僕も。なんでか分からないけど" },
    { "t": [150.5,152.5], "ja": "君たちは本当に素敵だね" },
    { "t": [152.5,154.8], "ja": "私の子どもたちを養子にもらう気はないかい？" },
    { "t": [154.8,157.2], "ja": "20代後半なんだがね。ひどい連中だよ" },
    { "t": [157.2,158.4], "ja": "いいえ。だめかい？" },
    { "t": [158.4,160.8], "ja": "はは、患者さん全員に聞いてるんだ" },
    { "t": [164.9,169.3], "ja": "（音楽）" },
    { "t": [169.3,171.3], "ja": "（音楽）" }
  ]
}
