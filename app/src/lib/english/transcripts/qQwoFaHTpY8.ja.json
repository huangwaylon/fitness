{
  "video": "qQwoFaHTpY8",
  "lines": [
    { "t": [0,2.4], "ja": "このオフィスでは13人が働いています" },
    { "t": [2.4,7.3], "ja": "だから年に13回、マイケルはケーキと風船と" },
    { "t": [7.3,11.2], "ja": "何かしらのジョーク・プレゼントを用意して、乾杯のあいさつをします" },
    { "t": [11.2,12.5], "ja": "乾杯のあいさつには2種類あります" },
    { "t": [12.5,15.4], "ja": "一つは年齢をネタにした冗談" },
    { "t": [15.4,16.9], "ja": "そのしわを見てよ" },
    { "t": [16.9,19.6], "ja": "黒人は肌が老けないって言うけど、麻薬のクラックの話じゃないぞ" },
    { "t": [19.6,24], "ja": "もう一つは、何か不適切なことか、ひどいこと" },
    { "t": [24,25.7], "ja": "あるいはその両方" },
    { "t": [25.7,26.6], "ja": "ほかには？" },
    { "t": [26.6,28.5], "ja": "「ハッピーバースデー」では高いハモりのパートしか歌いません" },
    { "t": [30,33.9], "ja": "それに、サプライズパーティーが大好き" },
    { "t": [33.9,36.5], "ja": "もしかしたら、ちょっと好きすぎるくらいかも" },
    { "t": [36.5,37.6], "ja": "お誕生日おめでとう！" },
    { "t": [37.6,39.1], "ja": "お誕生日おめでとう！" },
    { "t": [39.1,41.9], "ja": "…" },
    { "t": [41.9,43.9], "ja": "お誕生日おめでとう！" },
    { "t": [43.9,47.3], "ja": "だから、うん、これを一気に片付けたほうが" },
    { "t": [47.3,49.6], "ja": "効率的かもしれないと思って" },
    { "t": [49.6,52.5], "ja": "大きな楽しいパーティーを1回やればいい" },
    { "t": [52.5,55], "ja": "そうすればみんな幸せだし、誰も時間をむだにしない" },
    { "t": [55,56.5], "ja": "気に入らないな" },
    { "t": [60,64.6], "ja": "へえ、ちょっと改革しようってわけね" },
    { "t": [64.6,66.5], "ja": "なかなかいいアイデアだと思わない？" },
    { "t": [66.5,67.6], "ja": "いいアイデアだと思う？" },
    { "t": [67.6,68.8], "ja": "いや" },
    { "t": [68.8,71.2], "ja": "最高のアイデアだと思う" },
    { "t": [71.2,73.6], "ja": "ふーん" },
    { "t": [73.6,76.7], "ja": "あのさ、もう一回請求書を送ってみたら" },
    { "t": [76.7,77.5], "ja": "分かった" },
    { "t": [77.5,78.5], "ja": "よし" },
    { "t": [78.5,81], "ja": "あ、ところで、僕のメモ見てくれた？" },
    { "t": [81,85.2], "ja": "正直に言うと、誕生日は楽しいけど" },
    { "t": [85.2,87.1], "ja": "毎回毎回のケーキから、みんなちょっと休みたいよね" },
    { "t": [87.1,91.1], "ja": "だから、今日は誕生日月をおしゃれにお祝いしよう" },
    { "t": [91.1,94.1], "ja": "これ、すごくいいわね" },
    { "t": [94.1,95], "ja": "でしょ？" },
    { "t": [95,96.5], "ja": "ちょうど思ってたんだけど…" },
    { "t": [96.5,98.5], "ja": "いや、本当に、本当にそう" },
    { "t": [98.5,100.3], "ja": "こうすれば一度に全部済ませられるし" },
    { "t": [100.3,102.1], "ja": "実際、楽しいかもしれない" },
    { "t": [102.1,103.4], "ja": "そうね" },
    { "t": [103.4,106.2], "ja": "そうだよ" },
    { "t": [106.2,109.5], "ja": "君なら頼りになると思ってた" },
    { "t": [109.5,112], "ja": "ねえ、ジム、私だけのケーキってもらえる？" },
    { "t": [112,112.9], "ja": "何？" },
    { "t": [112.9,114.5], "ja": "デビルズフードケーキがすごく好きなの" },
    { "t": [114.5,115.8], "ja": "ああ、いいよ" },
    { "t": [115.8,117.1], "ja": "ええ　分かった" },
    { "t": [117.1,119.5], "ja": "わあ、簡単だったな" },
    { "t": [119.5,121.4], "ja": "うん、まあ、僕って好かれてるんだろうね" },
    { "t": [121.4,123.4], "ja": "ジム！" },
    { "t": [123.4,124.4], "ja": "デビルズフードは大嫌いなの" },
    { "t": [124.4,125.5], "ja": "いや、メレディスが…" },
    { "t": [125.5,126.4], "ja": "メレディスなんて知らない" },
    { "t": [126.4,127.9], "ja": "私の誕生日に、ほかの人が" },
    { "t": [127.9,129.3], "ja": "ケーキを選ぶのは不公平だと思う" },
    { "t": [129.3,130.1], "ja": "みんなの誕生日だよ" },
    { "t": [130.1,131.5], "ja": "今日は実際に私の誕生日なんだ" },
    { "t": [131.5,133.4], "ja": "だからケーキは私が選びたい" },
    { "t": [133.4,134.4], "ja": "何がいいの？" },
    { "t": [134.4,135.4], "ja": "パイがいい、ピーチパイがいい" },
    { "t": [135.4,136], "ja": "誕生日のパイがほしい" },
    { "t": [136,137], "ja": "おいしいコブラーがいい" },
    { "t": [137,138], "ja": "じゃあ、アンジェラと話して" },
    { "t": [138,139.1], "ja": "パイを何とかできるか見てみるよ" },
    { "t": [139.1,140.3], "ja": "誰と話そうとかまわない" },
    { "t": [140.3,141.1], "ja": "とにかく何とかしてくれ" },
    { "t": [141.1,141.9], "ja": "アンジェラだね" },
    { "t": [141.9,143.4], "ja": "クリードのためだって言え" },
    { "t": [143.4,144.6], "ja": "それで意味が分かるはずだ" },
    { "t": [148.6,149.7], "ja": "やあ、ジム" },
    { "t": [149.7,150.9], "ja": "トビー" },
    { "t": [150.9,153.3], "ja": "ねえ、合同誕生日のこと聞いたよ" },
    { "t": [153.3,157.1], "ja": "いいアイデアだね" },
    { "t": [157.1,158.3], "ja": "ああ、ありがとう" },
    { "t": [158.3,160.3], "ja": "うん" },
    { "t": [160.3,163.1], "ja": "わあ" },
    { "t": [163.1,164.1], "ja": "何か僕にできることは…" },
    { "t": [164.1,166.3], "ja": "僕の誕生日は2か月前だったんだ" },
    { "t": [166.3,167.5], "ja": "ああ、そう" },
    { "t": [167.5,169.1], "ja": "パーティーはなかった" },
    { "t": [169.1,169.6], "ja": "え？" },
    { "t": [169.6,171.2], "ja": "いや、あったんだけど" },
    { "t": [171.2,175.3], "ja": "マイケルが金曜の4時58分に入れたんだ" },
    { "t": [175.3,177], "ja": "ほら、みんな駐車場で歌ってくれてさ" },
    { "t": [177,178.3], "ja": "ああ、それ覚えてる" },
    { "t": [178.3,181.6], "ja": "分からないけど、僕も入れてもらえたらって思って" },
    { "t": [181.6,182.1], "ja": "本気？" },
    { "t": [182.1,183.3], "ja": "入れてくれるかなと思っただけで" },
    { "t": [183.3,185.5], "ja": "それの何が悪いのか分からないし" },
    { "t": [185.5,186.6], "ja": "トビーはいい人です" },
    { "t": [186.6,187.4], "ja": "いい人ですよ" },
    { "t": [187.4,189.9], "ja": "でも、時々ちょっとうっとうしいんです" },
    { "t": [189.9,191.4], "ja": "別に悪くないと思うけど" },
    { "t": [191.4,192.8], "ja": "まあ、ケーキだしね、トビー" },
    { "t": [192.8,195], "ja": "いいよ" },
    { "t": [195,196.1], "ja": "よし、うん、じゃあさ" },
    { "t": [196.1,197.1], "ja": "君も入れちゃおう" },
    { "t": [197.1,198.5], "ja": "多いほうが楽しいからね、だろ？" },
    { "t": [198.5,199.8], "ja": "だめ" },
    { "t": [199.8,200.9], "ja": "絶対だめ" },
    { "t": [200.9,202.2], "ja": "私は機械じゃないのよ、ジム" },
    { "t": [202.2,204.2], "ja": "好き勝手に計画を変えて" },
    { "t": [204.2,207], "ja": "小さな魔法のパーティー妖精が言うことを聞くと思わないで" },
    { "t": [207,208.4], "ja": "もうデビルズフードと" },
    { "t": [208.4,211.6], "ja": "ピーチコブラー、ファッジー・ザ・ホエール、マッシュルームのつまみがあるのよ" },
    { "t": [211.6,213.2], "ja": "マッシュルームはアレルギーなんだ" },
    { "t": [213.2,214.1], "ja": "それは残念" },
    { "t": [214.1,217.8], "ja": "よし、じゃあ…" },
    { "t": [217.8,218.6], "ja": "ねえ、みんな" },
    { "t": [218.6,219.7], "ja": "やあ、元気？" },
    { "t": [219.7,220.7], "ja": "ちょっと聞いてくれるかな？" },
    { "t": [220.7,223], "ja": "誕生日のことで話し合わなきゃいけないんだ" },
    { "t": [223,223.7], "ja": "会議室？" },
    { "t": [223.7,225.3], "ja": "うん、会議室に5分後…" },
    { "t": [225.3,227.5], "ja": "いや" },
    { "t": [227.5,228.4], "ja": "いや" },
    { "t": [228.4,229.5], "ja": "ここで解決しよう" },
    { "t": [229.5,231.3], "ja": "ここで話し合おう" },
    { "t": [231.3,234.9], "ja": "じゃあ、誕生日の件で不満がある人は？" },
    { "t": [234.9,236.5], "ja": "1、2、3、全員だ" },
    { "t": [236.5,238.8], "ja": "よし、じゃあ、やめたほうがいいね" },
    { "t": [238.8,240.9], "ja": "ケーキ2つとパイ1つ、どうすればいいの？" },
    { "t": [240.9,242.5], "ja": "あ、私がもらうよ" },
    { "t": [242.5,244.2], "ja": "私のコブラーには誰も手を出すな" },
    { "t": [244.2,245], "ja": "ねえ、マイケル" },
    { "t": [245,247.7], "ja": "じゃなくて、ジム" },
    { "t": [247.7,249.2], "ja": "うん" },
    { "t": [249.2,251.8], "ja": "フィリスにマイケルって呼ばれた" },
    { "t": [251.8,255], "ja": "この事実は、この先ずっと僕につきまとうだろうね" },
    { "t": [255,259.7], "ja": "ハッピーバースデー・トゥー・ユー" },
    { "t": [259.7,263.9], "ja": "ハッピーバースデー・トゥー・ユー" },
    { "t": [263.9,269.5], "ja": "ハッピーバースデー、ディア・クリード" },
    { "t": [269.5,275], "ja": "ハッピーバースデー・トゥー・ユー" },
    { "t": [275,276.4], "ja": "いえい" },
    { "t": [276.4,277.4], "ja": "よし" },
    { "t": [277.4,279.2], "ja": "部屋をスキップして回ろう" },
    { "t": [279.2,280.8], "ja": "部屋をスキップして回ろう" },
    { "t": [280.8,281.8], "ja": "それは…　分かった" },
    { "t": [281.8,282.6], "ja": "よし" },
    { "t": [282.6,284.1], "ja": "いや、それはやめて" },
    { "t": [299.5,303.9], "ja": "ありがとう" }
  ]
}
