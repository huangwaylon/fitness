{
  "video": "B0zV8l9YiL8",
  "lines": [
    { "t": [0, 3], "ja": "よし！やった！" },
    { "t": [3, 5.3], "ja": "家から病院まで7分かからなかった" },
    { "t": [5.3, 6.3], "ja": "やったね" },
    { "t": [6.3, 9.3], "ja": "ええ、大変なところはもう終わったもんね" },
    { "t": [9.3, 11], "ja": "いや、でもさ" },
    { "t": [11, 12.9], "ja": "すごくいいスタートだろ？" },
    { "t": [12.9, 14.1], "ja": "早く連れてこられるとは思ってたけど" },
    { "t": [14.1, 16], "ja": "これは記録ものだよ" },
    { "t": [16, 18.6], "ja": "あ、着いたのね！" },
    { "t": [18.6, 20], "ja": "やあ！" },
    { "t": [20, 22.8], "ja": "いったいどうやって僕たちより先に着いたんだ？" },
    { "t": [22.8, 24.9], "ja": "タクシーで来たのよ。あなたたち歩いてきたの？" },
    { "t": [24.9, 28.9], "ja": "いや、僕たちもタクシーだよ。しかも予行演習までしたのに" },
    { "t": [28.9, 32.6], "ja": "どうも。あら、着いたのね！" },
    { "t": [32.6, 37], "ja": "ねえ、この病院に魔法のトンネルでもあるの？" },
    { "t": [37, 38.2], "ja": "ロス、あなたはここでおしゃべりしてて" },
    { "t": [38.2, 40.4], "ja": "私は赤ちゃんを産んでくるから" },
    { "t": [40.4, 42.1], "ja": "わかった、わかった" },
    { "t": [42.1, 44], "ja": "えっと、どうも。レイチェル・グリーンです" },
    { "t": [44, 46.1], "ja": "ロス・ゲラーです。車から電話しました" },
    { "t": [46.1, 49.2], "ja": "はい。相部屋の分娩室をご用意しています" },
    { "t": [49.2, 51.3], "ja": "ちょっと、待って待って。え、すみません" },
    { "t": [51.3, 55.1], "ja": "相部屋？個室をお願いしたんですけど" },
    { "t": [55.1, 56.6], "ja": "ええ、ここにそう書いてあります" },
    { "t": [56.6, 57.8], "ja": "あいにく、保証はできないんです、" },
    { "t": [57.8, 61.4], "ja": "個室は。それに今は、すべてふさがっていて" },
    { "t": [61.4, 63.5], "ja": "ああ、もっと早く来ていればねえ" },
    { "t": [65.3, 66.4], "ja": "すみません" },
    { "t": [66.4, 69.3], "ja": "相部屋しかないんです" },
    { "t": [69.3, 71.3], "ja": "わかりました、えっと、ちょっと待ってください" },
    { "t": [71.3, 72.3], "ja": "ロス" },
    { "t": [74.2, 75.8], "ja": "うん" },
    { "t": [75.8, 77.3], "ja": "彼女にお金を渡して" },
    { "t": [78.5, 80.1], "ja": "本当に部屋がないんだと思うよ" },
    { "t": [80.1, 81.2], "ja": "そんなことないって、ロス" },
    { "t": [81.2, 83.4], "ja": "大事な人のために取ってあるだけなの、わかる？" },
    { "t": [83.4, 84.8], "ja": "じゃ、じゃあ、僕が大統領だったら？" },
    { "t": [84.8, 86.4], "ja": "それなら大変なことになるね" },
    { "t": [86.4, 88.4], "ja": "あなた、どの国がどこにあるかも知らないもの" },
    { "t": [90.6, 91.4], "ja": "わかった" },
    { "t": [93.4, 96.3], "ja": "あの、えっと、もう一度確認していただけませんか" },
    { "t": [96.3, 100.5], "ja": "個室が、えっと、空いたかもしれないので" },
    { "t": [102.1, 103.7], "ja": "ここは病院です" },
    { "t": [103.7, 105.7], "ja": "ねえ、言わせてもらうけど" },
    { "t": [105.7, 107.7], "ja": "その言い方、あまり気に入らないんだけど" },
    { "t": [107.7, 110.5], "ja": "それに、この街の病院はここだけじゃないし" },
    { "t": [110.5, 112.6], "ja": "私たちは別に…うわ" },
    { "t": [112.6, 113.6], "ja": "ああ、もう、うわ" },
    { "t": [113.6, 114.6], "ja": "何、何？" },
    { "t": [114.6, 119.8], "ja": "ああ、痛い、陣痛、痛い、痛い、痛い、痛い、うっ、うっ、痛い" },
    { "t": [119.8, 121.6], "ja": "相部屋をご覧になりますか？" },
    { "t": [121.6, 123], "ja": "ええ、見るだけなら損はないかも" }
  ]
}
