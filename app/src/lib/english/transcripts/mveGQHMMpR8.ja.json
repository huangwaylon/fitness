{
  "video": "mveGQHMMpR8",
  "lines": [
    { "t": [0,  4], "ja": "実は、ゲイルとはこのシャームトンで出会ったんだ" },
    { "t": [4,  4.8], "ja": "うんうん" },
    { "t": [4.8,  8.7], "ja": "ほっそりしてて、金髪で、胸が大きくて、脚が長かった" },
    { "t": [8.7,  10.8], "ja": "うっ。まったく好みじゃない" },
    { "t": [10.8,  14.5], "ja": "で、二人が意気投合したきっかけは何だったんだ？" },
    { "t": [14.5,  16], "ja": "彼女、病気だったのか？" },
    { "t": [16,  19.2], "ja": "それとも、君の父親が彼女の父親の犯罪を目撃したとか？" },
    { "t": [19.2,  20.3], "ja": "それとも、一時的に金髪だったのか？" },
    { "t": [20.3,  22.4], "ja": "あのさ、大事なのは、二人が結婚して" },
    { "t": [22.4,  23.3], "ja": "幸せだってことだよ" },
    { "t": [23.3,  25.3], "ja": "だから、史上最高の花婿付添人として" },
    { "t": [25.3,  27.8], "ja": "ジェリー・ガーギッチにコーンを掲げて乾杯しよう" },
    { "t": [27.8,  29.3], "ja": "ジェリー・ガーギッチに！ ジェリー・ガーギッチに！" },
    { "t": [29.3,  31.3], "ja": "ありがとう！ ジェリー・ガーギッチに！" },
    { "t": [31.3,  33.8], "ja": "ああ、もう。気にするな、ゲイリー" },
    { "t": [33.8,  36.4], "ja": "ありがとう。うん" },
    { "t": [36.4,  38.4], "ja": "どうしてそんなにすぐ用意できたんだ？" },
    { "t": [38.4,  39.8], "ja": "いつも予備のコーンを用意してるんだ" },
    { "t": [39.8,  42.9], "ja": "半分くらいの確率で落とすからね" },
    { "t": [42.9,  44.2], "ja": "アンディ、次は君だ" },
    { "t": [44.2,  46.3], "ja": "世界中のどんな遊びでもいい、何がしたい？" },
    { "t": [46.3,  48], "ja": "いや、僕のは無理だよ" },
    { "t": [48,  49.3], "ja": "コルツの試合を見に行きたい" },
    { "t": [49.3,  51.4], "ja": "コルツがペイトリオッツに49対0で勝つのを見て" },
    { "t": [51.4,  53.1], "ja": "トム・ブレイディを怒鳴りつけて泣かせて" },
    { "t": [53.1,  54.3], "ja": "それからデイブ・マシューズと会って" },
    { "t": [54.3,  56.3], "ja": "二人で10時間ゴルフゲームをするんだ" },
    { "t": [56.3,  57.5], "ja": "ねえ、赤ちゃん！" },
    { "t": [57.5,  60.4], "ja": "ずいぶん具体的な夢だな、坊主" },
    { "t": [60.4,  63.6], "ja": "やあ、ジム、クリス・トレーガーだ。頼みがあるんだ" },
    { "t": [65.6,  67.3], "ja": "僕、死んだんだ。死んだんだよ" },
    { "t": [67.3,  69.9], "ja": "天国ってこういう所なんだ" },
    { "t": [69.9,  71.4], "ja": "やっぱりね" },
    { "t": [71.4,  74.5], "ja": "おお、ここで試合をするんだ" },
    { "t": [74.5,  76], "ja": "出番だぞ、アンディ" },
    { "t": [76,  77], "ja": "やあ、みんな！" },
    { "t": [77,  78.6], "ja": "みんな、こっちに来て" },
    { "t": [78.6,  81.1], "ja": "アンディ、紹介しよう。インディアナポリス・コルツのオーナー" },
    { "t": [81.1,  82], "ja": "ジム・アーセイだ" },
    { "t": [82,  84.1], "ja": "アンディ、会えてうれしいよ" },
    { "t": [84.1,  85.8], "ja": "ありがとうございます。あなたのチームが大好きです" },
    { "t": [85.8,  87.4], "ja": "自分の子どもみたいに愛してます" },
    { "t": [87.4,  89.3], "ja": "君なら自分でフットボールができそうな体格だな" },
    { "t": [89.3,  90.1], "ja": "私にはそう見えるよ" },
    { "t": [90.1,  92.5], "ja": "冗談か分からないけど、本気だといいな" },
    { "t": [92.5,  95], "ja": "この場所全部、あなたのものなんですね" },
    { "t": [95,  96.7], "ja": "ジム・アーセイとは友だちになったんだ" },
    { "t": [96.7,  99.5], "ja": "インディアナポリスの十代の若者を指導するボランティアでね" },
    { "t": [99.5,  101.4], "ja": "僕は州議会議事堂を案内した" },
    { "t": [101.4,  105.1], "ja": "ジムはコルツのチケットとサイン入りのユニフォームをあげた" },
    { "t": [105.1,  106.6], "ja": "若者たちはジムのほうが好きだった" },
    { "t": [106.6,  107.8], "ja": "レジー・ウェイン！" },
    { "t": [107.8,  109.7], "ja": "まともに見られないよ、レジー・ウェイン" },
    { "t": [109.7,  110.7], "ja": "おお" },
    { "t": [110.7,  112.1], "ja": "あなたのユニフォームを着て結婚したんです" },
    { "t": [112.1,  112.9], "ja": "本当の話です" },
    { "t": [112.9,  114.3], "ja": "それは変だな" },
    { "t": [114.3,  115.5], "ja": "でも、そういうのは認めるよ" },
    { "t": [115.5,  117.2], "ja": "大ファンです、ラックさん" },
    { "t": [117.2,  118.8], "ja": "はいはい、君。落ち着いて" },
    { "t": [118.8,  119.8], "ja": "はい" },
    { "t": [119.8,  122.2], "ja": "アンドリュー・ラックさん、花婿なら誰でも夢見るんです" },
    { "t": [122.2,  124.1], "ja": "あなたが投げたタッチダウンパスを取るのを" },
    { "t": [124.1,  125.2], "ja": "お願いできますか？" },
    { "t": [125.2,  126.2], "ja": "ああ、やろう" },
    { "t": [126.2,  127.1], "ja": "きれいな回転で投げてくれる？" },
    { "t": [127.1,  127.7], "ja": "やってみるよ" },
    { "t": [127.7,  128.7], "ja": "よし" },
    { "t": [132.7,  134.7], "ja": "おお！" },
    { "t": [134.7,  135.7], "ja": "行くぞ！" },
    { "t": [135.7,  137.3], "ja": "よっしゃ！" },
    { "t": [140.3,  141.3], "ja": "じゃあな" },
    { "t": [141.3,  147.2], "ja": "ねえ、そうさ、撃ちたいんだ、ベイビー、撃て" },
    { "t": [147.2,  149.8], "ja": "さあ行くぞ、行くぞ、また行くぞ" },
    { "t": [149.8,  151.6], "ja": "俺の弱点は何だ？" },
    { "t": [151.6,  152.6], "ja": "よし、それじゃ" },
    { "t": [152.6,  155], "ja": "アンにさっと電話して、自慢してやろう" },
    { "t": [155,  156.5], "ja": "もしもし？" },
    { "t": [156.5,  157.2], "ja": "アン・パーキンス" },
    { "t": [157.2,  158.2], "ja": "アン・パーキンス！" },
    { "t": [158.2,  160.2], "ja": "アン・パーキンス！" },
    { "t": [160.2,  163.3], "ja": "人生最高の時間を過ごしてて、自慢しようと電話してるんだ" },
    { "t": [163.3,  164.3], "ja": "本当？" },
    { "t": [164.3,  165.9], "ja": "すごいバーに行ったんだ" },
    { "t": [165.9,  167.3], "ja": "コルツとフットボールをした！" },
    { "t": [167.3,  168.1], "ja": "コルツと！" },
    { "t": [168.1,  169.7], "ja": "コルツと！" },
    { "t": [169.7,  171.8], "ja": "これからステーキハウスに行くんだ" },
    { "t": [171.8,  172.8], "ja": "君は何してるの？" },
    { "t": [172.8,  175.6], "ja": "あー、えっと、イケメンに囲まれてるところ" },
    { "t": [175.6,  177.5], "ja": "イケメンに囲まれてるの" },
    { "t": [177.5,  178.7], "ja": "ドーン！" },
    { "t": [178.7,  181.5], "ja": "あら、ドナがストリッパーの下着を" },
    { "t": [181.5,  182.5], "ja": "歯で引きちぎったところ" },
    { "t": [182.5,  183.5], "ja": "ひゅー！" },
    { "t": [183.5,  184.5], "ja": "アン、誰に嘘をついてるんだ？" },
    { "t": [184.5,  185.5], "ja": "あーあ！" },
    { "t": [185.5,  186.5], "ja": "何？" },
    { "t": [186.5,  187.5], "ja": "休憩してもいいですか？" },
    { "t": [187.5,  188.5], "ja": "手が疲れちゃって" },
    { "t": [188.5,  189.5], "ja": "だめ" },
    { "t": [189.5,  190.9], "ja": "1時間分払ったんだから、1時間掘ってもらう" },
    { "t": [190.9,  194], "ja": "諸君、セント・エルモのステーキハウスへようこそ！" },
    { "t": [194,  195], "ja": "よっしゃ！" },
    { "t": [195,  196.6], "ja": "生き物の肉を食べるときだ！" },
    { "t": [196.6,  198.2], "ja": "肉をよこせ！" },
    { "t": [198.2,  200.2], "ja": "ジェリー、本当にここが俺たちの席か？" },
    { "t": [200.2,  201.2], "ja": "4人分しか用意されてないぞ" },
    { "t": [201.2,  202], "ja": "失礼ですが、お客様" },
    { "t": [202,  203.2], "ja": "こちらはお客様のお席ではございません" },
    { "t": [203.2,  204.6], "ja": "あれ、「ガーギッチ様」って言ったと思ったんだけど" },
    { "t": [204.6,  205.2], "ja": "いえ、いえ" },
    { "t": [205.2,  206.6], "ja": "「ギングリッチ様」と申しました" },
    { "t": [206.6,  209.3], "ja": "ああ、なんてことだ、本当にすみません" },
    { "t": [209.3,  210.3], "ja": "まったく、ジェリー" },
    { "t": [210.3,  211.3], "ja": "でもさ、ほら" },
    { "t": [211.3,  212.3], "ja": "ギングリッチ、ガーギッチ" },
    { "t": [212.3,  214.3], "ja": "親戚だったりしてね" },
    { "t": [214.3,  216.3], "ja": "それはないと思うぞ、ジェリー" },
    { "t": [216.3,  217.3], "ja": "はい" },
    { "t": [217.3,  222.3], "ja": "レアのポーターハウスを1つ、レアのサーロインを1つ、それとベーコンをひと切れ" },
    { "t": [222.3,  224.3], "ja": "君は神の仕事をしているよ、ジョン" },
    { "t": [224.3,  228.3], "ja": "ラガヴーリンをあと4杯、液体の形で頼む" },
    { "t": [228.3,  230.3], "ja": "わざわざ言う必要はないと思うけど" },
    { "t": [230.3,  232.3], "ja": "それが、意外と必要なんだ" },
    { "t": [232.3,  235.3], "ja": "で、独身くん、ダイアンとはどうなんだ？" },
    { "t": [235.3,  236.3], "ja": "ふむ" },
    { "t": [236.3,  238.3], "ja": "みんなに正直に言おう" },
    { "t": [238.3,  240.3], "ja": "彼女が好きだ" },
    { "t": [240.3,  243.3], "ja": "おお！" },
    { "t": [243.3,  245.3], "ja": "よし、よし、よし" },
    { "t": [245.3,  248.3], "ja": "ロンについて言えることは山ほどあるけど" },
    { "t": [248.3,  250.3], "ja": "花婿付添人のスピーチは" },
    { "t": [250.3,  252.3], "ja": "花婿らしくあるべきだと思う" },
    { "t": [252.3,  255.3], "ja": "だから一言だけ。ロンに" },
    { "t": [255.3,  257.3], "ja": "ああ、ロンに！" },
    { "t": [257.3,  258.3], "ja": "ロンに！" },
    { "t": [258.3,  259.3], "ja": "完璧だ" },
    { "t": [259.3,  260.3], "ja": "完璧だよ、クリス" },
    { "t": [260.3,  261.3], "ja": "こちらでございます、お客様" },
    { "t": [261.3,  262.3], "ja": "それと、お知らせしておいたほうがいいかと" },
    { "t": [262.3,  264.3], "ja": "お食事代はすでにお支払いいただいております" },
    { "t": [264.3,  265.3], "ja": "ヒバート様から" },
    { "t": [265.3,  266.3], "ja": "何？" },
    { "t": [266.3,  267.3], "ja": "えっ、何？" },
    { "t": [270.3,  271.3], "ja": "ヒバート！" },
    { "t": [271.3,  272.3], "ja": "よう、元気か、相棒？" },
    { "t": [272.3,  273.3], "ja": "やあ" },
    { "t": [273.3,  275.3], "ja": "ロイ・ヒバートだ。エンターテイメント720の再会だな" },
    { "t": [275.3,  276.3], "ja": "やあ、トム" },
    { "t": [276.3,  277.3], "ja": "あいつの分は払わないぞ" },
    { "t": [277.3,  279.3], "ja": "俺に大金の借りがあるんだ" },
    { "t": [279.3,  280.3], "ja": "本当だよ" },
    { "t": [280.3,  281.3], "ja": "本当だよ" }
  ]
}
