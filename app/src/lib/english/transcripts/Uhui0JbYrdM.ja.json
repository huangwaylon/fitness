{
  "video": "Uhui0JbYrdM",
  "lines": [
    { "t": [0,10.5], "ja": "北シアトル地区のブイアイピー・ダイヤモンド販売員になったんだ" },
    { "t": [10.7,13.5], "ja": "信じられる？　北シアトル地区のブイアイピー・ダイヤモンド販売員だよ" },
    { "t": [13.9,15.8], "ja": "しかも、このすごいサンドスクーターまでもらった" },
    { "t": [17.1,18.8], "ja": "私にとっては全然楽しくない" },
    { "t": [19.5,21.2], "ja": "1箱しか売ってないんだと思ってた" },
    { "t": [21.2,25], "ja": "そうだよ。でもそれで5万サンドコインのボーナスがもらえて" },
    { "t": [25.1,27.3], "ja": "それでサンドをもっと買ったんだ" },
    { "t": [27.9,31.8], "ja": "ああ、僕はお金持ちになるぞ。だから仕事を辞めたんだ" },
    { "t": [32.7,33.9], "ja": "仕事を辞めたの？" },
    { "t": [34.3,35.5], "ja": "辞めちゃだめよ" },
    { "t": [35.6,37.8], "ja": "養わなきゃいけない娘も、なだめなきゃいけない母親もいるでしょ" },
    { "t": [38.9,41.9], "ja": "勇敢なるフレディは、命綱なしで飛ぶのさ" },
    { "t": [42,45.8], "ja": "この「アイカーリー」センセーショナル販売イベントの準備は万全だ" },
    { "t": [45.9,47.5], "ja": "ウー！　ウー！" },
    { "t": [48.4,49.8], "ja": "今日は車輪を手に入れた" },
    { "t": [50,51.3], "ja": "明日は空を飛ぶ" },
    { "t": [52.3,53.9], "ja": "ええ、借金の中にね" },
    { "t": [54.5,56.3], "ja": "気づくのに少し時間がかかったけど" },
    { "t": [56.7,57.8], "ja": "サンドは怪しいの" },
    { "t": [58.1,59.1], "ja": "マルチ商法よ" },
    { "t": [59.5,60], "ja": "違うよ" },
    { "t": [60.8,61.6], "ja": "それって何？" },
    { "t": [63.4,65], "ja": "マルチレベル・マーケティング" },
    { "t": [65.3,66.6], "ja": "ねずみ講よ" },
    { "t": [67.1,69.5], "ja": "会社が、効果のない偽物の商品の在庫を買わせるの" },
    { "t": [69.5,71.4], "ja": "効果がないから売れないのよ" },
    { "t": [71.5,74.7], "ja": "だから抜け出すには、もっと販売員を勧誘するしかないの" },
    { "t": [75.1,77.2], "ja": "大好きなポッドキャストで全部知ったのよ" },
    { "t": [77.5,78.2], "ja": "「詐欺の女帝」でね" },
    { "t": [79,80.4], "ja": "ここで起きてるのは、そういうことじゃないよ" },
    { "t": [80.8,81.4], "ja": "ふーん" },
    { "t": [81.4,84.6], "ja": "安い景品や" },
    { "t": [84.9,87.5], "ja": "立派な肩書き、価値のない偽のお金で、売る人をつなぎとめるの" },
    { "t": [87.8,89.1], "ja": "チェットチェットとチャチャック" },
    { "t": [90.5,92.5], "ja": "マルチ商法の商品はインチキだって言ったけど" },
    { "t": [93,93.9], "ja": "サンドは効くよ" },
    { "t": [94.5,95.1], "ja": "僕は落ち着いてる" },
    { "t": [95.4,96.3], "ja": "スペンサーは繊細になった" },
    { "t": [97,99.7], "ja": "それにフレディはすごく勇敢になって、無謀にも仕事を辞めた" },
    { "t": [100.4,102.3], "ja": "さて、悪いけど失礼するよ" },
    { "t": [102.4,105], "ja": "サンドセーショナルな販売イベントの準備があるんだ" },
    { "t": [105.6,106.9], "ja": "僕は現実から目をそらしてるし" },
    { "t": [107.2,108], "ja": "ずっとそうするつもりさ" },
    { "t": [111,112.8], "ja": "みんな、準備はいい？" },
    { "t": [113.8,115.2], "ja": "サンドストーム！" },
    { "t": [120.4,123.2], "ja": "フレディです。北シアトル地区のブイアイピー・ダイヤモンド販売員" },
    { "t": [123.3,126.7], "ja": "そしてグリフィンです。北シアトル地区と東部標準時のブイアイピーピーエスシー" },
    { "t": [126.8,127.9], "ja": "催眠術師の免許はありません" },
    { "t": [129.5,130.8], "ja": "そしてカーリーです" },
    { "t": [132.1,132.5], "ja": "こんにちは" },
    { "t": [133.4,136.6], "ja": "今日は、私たちが大好きな商品を紹介します" },
    { "t": [137,137.5], "ja": "サンド！" },
    { "t": [137.9,141.5], "ja": "サンドは、元気の出る成分がいっぱいの、気分を上げるアイテムです" },
    { "t": [141.7,142.9], "ja": "でも、私たちの言葉をうのみにしないで" },
    { "t": [143,144.5], "ja": "本物のサンドのファンに聞いてみましょう" },
    { "t": [144.8,145.9], "ja": "スペンサー・シェイ！" },
    { "t": [147.5,149.8], "ja": "本当の気持ちを話させてくれて、ありがとう" },
    { "t": [150.4,153.2], "ja": "サンドに出会う前の僕は" },
    { "t": [153.5,155.3], "ja": "耳を傾けても、聞こえていなかった" },
    { "t": [155.6,157.7], "ja": "聞こえても、理解していなかった" },
    { "t": [158.3,161.1], "ja": "理解しても、分からないふりをしていた" },
    { "t": [161.2,163.5], "ja": "グリーンピースの人にメールアドレスを教えなくて済むようにね" },
    { "t": [164.4,167.2], "ja": "繊細サンドのおかげで、すべてが変わったんだ" },
    { "t": [167.9,169.9], "ja": "そしてサンドを1箱買うごとに" },
    { "t": [169.9,171.5], "ja": "割引コード「フレディビー」を使えば" },
    { "t": [171.7,173.7], "ja": "5パーセント引きにします" },
    { "t": [173.8,175.7], "ja": "さらにスペンサーが、僕たちのすてきな表に" },
    { "t": [175.7,176.6], "ja": "印をつけるところが見られます" },
    { "t": [176.9,177.6], "ja": "スクーター休憩！" },
    { "t": [177.8,178], "ja": "ウー！" },
    { "t": [178.7,179.2], "ja": "イエー！" },
    { "t": [180.4,181.7], "ja": "カーリー！" },
    { "t": [182.1,182.6], "ja": "カーリー！" },
    { "t": [183.2,183.5], "ja": "サンド！" },
    { "t": [183.8,184], "ja": "もしもし！" },
    { "t": [184.4,185.5], "ja": "今、取り込み中なの" },
    { "t": [185.6,189.4], "ja": "では、落ち着きサンドでどれだけ心穏やかになれるか聞いてみましょう" },
    { "t": [189.5,190.9], "ja": "最高のおもてなしの司会者" },
    { "t": [191,192.7], "ja": "いちばんクールでイケてる人" },
    { "t": [192.7,193.9], "ja": "みんなが愛して" },
    { "t": [194.1,195.6], "ja": "知っていて、信頼している女性…" },
    { "t": [195.6,197.1], "ja": "サンドって魚のえさなの？" },
    { "t": [197.2,197.9], "ja": "カーリー！" },
    { "t": [197.9,198], "ja": "カーリー！" },
    { "t": [198,199.9], "ja": "シェリー！" },
    { "t": [199.9,200.4], "ja": "ウー！" },
    { "t": [200.4,202.3], "ja": "ウーフーフー！" },
    { "t": [203.8,205.7], "ja": "よし、手伝って" },
    { "t": [205.9,207], "ja": "サンドを売って、カーリー" },
    { "t": [207.3,207.7], "ja": "うん" },
    { "t": [208.5,209.1], "ja": "ええ" },
    { "t": [210.6,213.2], "ja": "落ち着きサンドのおかげで、私はとても落ち着いています" },
    { "t": [213.7,216.3], "ja": "ツンドラにいるシロフクロウみたいに" },
    { "t": [217.2,218.6], "ja": "ネズミが欲しくてたまらないの" },
    { "t": [219.1,221.4], "ja": "でも、ネズミだと思い込んでいるだけだったら？" },
    { "t": [221.4,222.5], "ja": "それで飲み込んで" },
    { "t": [222.9,224.3], "ja": "あとで魚のえさだったと分かったら？" },
    { "t": [224.8,226.5], "ja": "そのフクロウは詐欺師だと思う？" },
    { "t": [226.7,227.7], "ja": "知らなかったとしても？" },
    { "t": [229.4,230], "ja": "うそでしょ" },
    { "t": [230,231], "ja": "吐きそう" },
    { "t": [232.3,233.4], "ja": "カーリーは見せようとしてるんだ" },
    { "t": [233.4,235.4], "ja": "落ち着きサンドを使う前の自分がどうだったかをね" },
    { "t": [236.4,237.4], "ja": "はい、カーリー" },
    { "t": [237.5,239.4], "ja": "ぐっと大きく飲んだらどう？" },
    { "t": [239.8,241.1], "ja": "ウーフー、でしょ？" },
    { "t": [242.2,243.8], "ja": "一気、一気、一気、一気！" },
    { "t": [243.9,245], "ja": "これは飲めない" },
    { "t": [245.1,245.5], "ja": "なんで？" },
    { "t": [245.9,247.3], "ja": "サンドは魚のえさだから" },
    { "t": [248.3,248.7], "ja": "え？" },
    { "t": [249.1,250.5], "ja": "抗酸化物質なんていっぱい入ってない" },
    { "t": [250.8,252.2], "ja": "魚のえさがいっぱい入ってるの" },
    { "t": [252.5,253.3], "ja": "うそだろ" },
    { "t": [253.4,254.5], "ja": "サンドって魚のえさなの？" },
    { "t": [254.8,255.3], "ja": "いいえ" },
    { "t": [255.4,256.5], "ja": "法的には、どんな種類の食べ物とも" },
    { "t": [256.5,257.5], "ja": "証明されていません" },
    { "t": [259.7,260.2], "ja": "え？" },
    { "t": [260.7,261.5], "ja": "知ってたの？" },
    { "t": [262.8,263.2], "ja": "待って" },
    { "t": [263.6,264.9], "ja": "だから会いたがってたのね" },
    { "t": [265,266.3], "ja": "私にこのガラクタを売るために" },
    { "t": [267.2,268.5], "ja": "よりを戻すためじゃなくて" },
    { "t": [269,269.5], "ja": "そう" },
    { "t": [269.9,270.8], "ja": "いや、たぶん" },
    { "t": [272.1,273.3], "ja": "よりを戻してもいいよ" },
    { "t": [273.9,275.3], "ja": "カーリー、愛してる" },
    { "t": [275.8,276], "ja": "うえっ" },
    { "t": [276.5,278.8], "ja": "一瞬たりとも考えたことないわ" },
    { "t": [280.3,281.5], "ja": "フレディ、大丈夫？" },
    { "t": [284.4,285.7], "ja": "サンドが偽物なら" },
    { "t": [285.9,288], "ja": "ミリセントに立ち向かったのは、全部自分の力だったんだ" },
    { "t": [288.3,289.6], "ja": "僕は本当に勇敢なんだ" },
    { "t": [289.8,291.4], "ja": "だから、全然受け止められるよ" },
    { "t": [291.4,292.9], "ja": "仕事を辞めたことも" },
    { "t": [292.9,294.6], "ja": "全財産を使っちゃったことも" },
    { "t": [294.6,295.7], "ja": "それに…" },
    { "t": [295.7,296.1], "ja": "ああ、うわ" },
    { "t": [296.3,296.5], "ja": "よし" },
    { "t": [296.6,297.4], "ja": "まあ、すごく汗をかいてる" },
    { "t": [298,299.6], "ja": "たぶん興奮と" },
    { "t": [299.6,300.3], "ja": "勇気のせいだ" },
    { "t": [301.2,301.9], "ja": "僕は何をしちゃったんだ？" },
    { "t": [303.1,303.9], "ja": "いつでも頼りになる商品って" },
    { "t": [303.9,305.3], "ja": "何か分かる？" },
    { "t": [305.7,307.1], "ja": "怒りの鉄拳だ" },
    { "t": [307.5,308.3], "ja": "スクーターで退場！" },
    { "t": [311.1,312.2], "ja": "信じられない" },
    { "t": [313.2,314.9], "ja": "君が傷ついているのが分かるよ" },
    { "t": [314.9,316.4], "ja": "そして君の気持ちを感じる…" },
    { "t": [316.4,317.2], "ja": "いや、ちょっと、やめて" },
    { "t": [317.6,318.8], "ja": "繊細サンドは偽物なんだ" },
    { "t": [319.5,319.9], "ja": "そうね" },
    { "t": [320.9,322.5], "ja": "ってことは、僕はもともとこんなに繊細だったんだ" },
    { "t": [323,323.2], "ja": "わあ" },
    { "t": [323.3,324.9], "ja": "僕って完璧すぎない？" }
  ]
}
