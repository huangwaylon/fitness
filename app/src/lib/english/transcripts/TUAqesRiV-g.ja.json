  "lines": [
    { "t": [0.9, 2.3], "ja": "どうも" },
    { "t": [2.3, 4.8], "ja": "今夜のパーティーについてのインタビューに来た" },
    { "t": [4.8, 7.9], "ja": "ええ、あのね、ちょっと体調が悪くて" },
    { "t": [7.9, 9.4], "ja": "先週、お酒を飲むクルーズに行ってね" },
    { "t": [9.4, 12.4], "ja": "1時間前にやっと終わったところ" },
    { "t": [12.4, 17.2], "ja": "まったく関係ない話だけど、ひどいアレルギーなの" },
    { "t": [17.2, 18], "ja": "それはお気の毒に" },
    { "t": [18, 19], "ja": "ええ" },
    { "t": [19, 21.1], "ja": "でも、このイベントの宣伝はどうしてもしないと" },
    { "t": [21.1, 21.8], "ja": "まあ、私のことは心配しないで" },
    { "t": [21.8, 23], "ja": "私は本物のプロだから" },
    { "t": [23, 24.9], "ja": "ショーは続けなきゃ" },
    { "t": [24.9, 27], "ja": "2" },
    { "t": [27, 30.1], "ja": "こんにちは、ジョーン・カラメッゾです" },
    { "t": [30.1, 33.5], "ja": "今日の番組は、やりません" },
    { "t": [39.8, 42.9], "ja": "アレルギーの症状が出てきたようだな" },
    { "t": [42.9, 45.1], "ja": "私はロン・スワンソンだ" },
    { "t": [45.1, 48.1], "ja": "今夜開かれる正装のチャリティーパーティーについて話しに来た" },
    { "t": [48.1, 50.6], "ja": "ポーニー・コモンズのためのものだ" },
    { "t": [50.6, 53.4], "ja": "収益はすべて公園の建設に使われる" },
    { "t": [53.4, 54.8], "ja": "楽しい会になるだろう" },
    { "t": [54.8, 56], "ja": "ほら、出て、出て" },
    { "t": [56, 57.3], "ja": "電話だよ" },
    { "t": [57.3, 59.9], "ja": "では、皆さんの電話を受けよう。どうやら、そういうことらしい" },
    { "t": [59.9, 60.9], "ja": "もしもし" },
    { "t": [60.9, 61.7], "ja": "ねえ、ジョーン" },
    { "t": [61.7, 62.8], "ja": "賭けの決着をつけてよ" },
    { "t": [62.8, 64.9], "ja": "史上一番セクシーなカップルは誰？" },
    { "t": [64.9, 68.2], "ja": "ロバート・パティンソンとクリステン・スチュワート、それともビーバー？" },
    { "t": [68.2, 70.5], "ja": "彼女をどこかで横にならせてあげたほうがいいんじゃないか？" },
    { "t": [70.5, 71], "ja": "いや、だめだよ" },
    { "t": [71, 72.7], "ja": "カメラから外したなんて彼女に知られたら" },
    { "t": [72.7, 74], "ja": "全員クビになる" },
    { "t": [74, 75.6], "ja": "だから、そのまま電話を受け続けて" },
    { "t": [75.6, 76], "ja": "いい感じだよ" },
    { "t": [76, 78.1], "ja": "3、2…" },
    { "t": [78.1, 79.3], "ja": "改めまして、こんにちは" },
    { "t": [79.3, 82.5], "ja": "ロン・スワンソンだ。引き続き電話を受けている" },
    { "t": [82.5, 84.9], "ja": "できれば今夜のパーティーについての質問を" },
    { "t": [84.9, 85.9], "ja": "どうぞ、放送中だ" },
    { "t": [85.9, 88.2], "ja": "もしもし、えっと、ジョーンはどうしたの？" },
    { "t": [88.2, 92.4], "ja": "ひどい二日酔いだ。本人はアレルギーのふりをしている" },
    { "t": [92.4, 94], "ja": "彼女は大丈夫なの？" },
    { "t": [94, 94.8], "ja": "さあね、分からない" },
    { "t": [94.8, 96.7], "ja": "二日酔いになったことがないからな" },
    { "t": [96.7, 101.4], "ja": "ウイスキーを飲みすぎたら、大きなステーキを焼く。有塩バターでフライパン焼きだ" },
    { "t": [101.4, 104.4], "ja": "それを食べて、ぬれた靴下をはいて寝るんだ" },
    { "t": [104.4, 105.2], "ja": "それで効くの？" },
    { "t": [105.2, 106.4], "ja": "効く" },
    { "t": [106.4, 112.2], "ja": "今夜のパーティーについて質問があれば、今すぐ電話を。私のほかの趣味についてでもいい" },
    { "t": [112.2, 118.9], "ja": "木工とか、大型帆船の小説とか、肉とか、そういうものだ" },
    { "t": [118.9, 119.7], "ja": "ロンだ" },
    { "t": [119.7, 121.1], "ja": "どうぞ、話して" },
    { "t": [121.1, 121.6], "ja": "もしもし" },
    { "t": [121.6, 125.7], "ja": "うちのヨークシャーテリアが、台所のテーブルの脚をかじっちゃったの" },
    { "t": [125.7, 127.9], "ja": "安く直す方法はある？" },
    { "t": [127.9, 129.4], "ja": "いい質問だ" },
    { "t": [129.4, 132.2], "ja": "クルミをテーブルの脚にこすりつけるといい" },
    { "t": [132.2, 133.8], "ja": "傷が目立たなくなる" },
    { "t": [133.8, 137.8], "ja": "次にやるべきことは、そのテリアを手放して、ちゃんとした犬を飼うことだ" },
    { "t": [137.8, 141.3], "ja": "50ポンド未満の犬は猫だ。そして猫なんて意味がない" },
    { "t": [141.3, 142.5], "ja": "パーティーに来てくれ" },
    { "t": [142.5, 143.5], "ja": "次の方" },
    { "t": [143.5, 147.4], "ja": "「怒りの葡萄」、チョコチップアイス、それにジョニー・キャッシュだ" },
    { "t": [147.4, 152.3], "ja": "大きな銀行も小さな銀行も信用するな。銀行は、ばかが運営するねずみ講だ" },
    { "t": [152.3, 153.9], "ja": "君の家に幽霊なんていない" },
    { "t": [153.9, 154.9], "ja": "君は寂しいだけだ" },
    { "t": [154.9, 157], "ja": "昔はこうだったろう？「やあ、リンゴがあるんだけど" },
    { "t": [157, 158], "ja": "買いませんか？」" },
    { "t": [158, 159], "ja": "「ああ" },
    { "t": [159, 160], "ja": "ありがとう」" },
    { "t": [160, 162.8], "ja": "この国で商売を始めるのは、それくらい簡単であるべきなんだ" },
    { "t": [162.8, 165.3], "ja": "私が人生で見た映画は3本だけだ" },
    { "t": [165.3, 169.7], "ja": "「戦場にかける橋」「パットン大戦車軍団」「ハービー」" },
    { "t": [169.7, 172], "ja": "恋人の子どもたちが大好きでな" },
    { "t": [172, 174.2], "ja": "けっこう笑える" },
    { "t": [174.2, 175.2], "ja": "次の方" },
    { "t": [175.2, 178.2], "ja": "おはよう" },
    { "t": [178.2, 179.2], "ja": "さようなら" },
    { "t": [179.2, 179.29999999999998], "ja": "さようなら" }
