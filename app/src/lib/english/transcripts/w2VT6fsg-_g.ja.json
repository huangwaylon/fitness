{
  "video": "w2VT6fsg-_g",
  "lines": [
    { "t": [0,  1.9], "ja": "やあ、アン・パーキンス" },
    { "t": [1.9,  4.8], "ja": "私のフルネームを正しく言ったの、初めてね" },
    { "t": [4.8,  6.8], "ja": "何を言う。我々は親友じゃないか" },
    { "t": [6.8,  8.3], "ja": "いい知らせがあるんだ" },
    { "t": [8.3,  10.8], "ja": "水飲み場の衛生改善を" },
    { "t": [10.8,  12.4], "ja": "我々の最優先事項にするよ" },
    { "t": [12.4,  13.6], "ja": "まあ、よかった" },
    { "t": [13.6,  17.1], "ja": "なぜかポーニーの人たちは、水飲み場を使うとき" },
    { "t": [17.1,  20.4], "ja": "飲み口を口ですっぽりくわえるの" },
    { "t": [20.4,  23.9], "ja": "この土地の、変で気持ち悪いクセみたいなものよ" },
    { "t": [23.9,  26.1], "ja": "水飲み場で飲む人に一人キスしたら" },
    { "t": [26.1,  27.9], "ja": "ポーニーの全員とキスしてるのと同じ" },
    { "t": [29.6,  31.1], "ja": "彼も含めてね" },
    { "t": [31.1,  35.1], "ja": "この計画は明日までに終わらせたい" },
    { "t": [35.1,  36.1], "ja": "あら" },
    { "t": [36.1,  37.1], "ja": "うちのオフィスを仕事場にしてくれ" },
    { "t": [37.1,  38.4], "ja": "なんなら、レスリーの机を使っていい" },
    { "t": [38.4,  40.4], "ja": "分かりました、そうします。ありがとう。よかった" },
    { "t": [40.4,  42.4], "ja": "ドアは開けておく？ 閉める？" },
    { "t": [42.4,  44.4], "ja": "あー、開けたままで大丈夫。分かった" },
    { "t": [46.4,  48.6], "ja": "はい、みんな。保健局がいま取り組んでいるのが" },
    { "t": [48.6,  52.2], "ja": "病気を知らせるポスターキャンペーンです" },
    { "t": [52.2,  56.2], "ja": "そこで私たちは、公園用にもっといい水飲み場を作ります" },
    { "t": [56.2,  59.2], "ja": "アンディが、水飲み場の公式テスト係です" },
    { "t": [59.2,  60.7], "ja": "よし、こいつを試してみよう" },
    { "t": [65.7,  69.9], "ja": "そう、つまり、彼がああいうことをできない水飲み場を作るのが狙い" },
    { "t": [71.5,  72.5], "ja": "いいね" },
    { "t": [72.5,  74.5], "ja": "じゃあ、何か案はある、ジェリー？" },
    { "t": [74.5,  79.4], "ja": "えーと、このかごみたいなのを周りにつけたらどうかな" },
    { "t": [79.4,  82.2], "ja": "なるほど、いけるかも。アンディは？" },
    { "t": [89.7,  90.9], "ja": "ありがとう、アンディ" },
    { "t": [90.9,  92], "ja": "まだ大丈夫" },
    { "t": [92,  92.7], "ja": "トムは？" },
    { "t": [92.7,  96.9], "ja": "正直に言っておくと、アンと俺は恋愛関係で結ばれてる" },
    { "t": [96.9,  97.9], "ja": "うわあ" },
    { "t": [97.9,  100.4], "ja": "だから、彼女が俺の案を採用しても驚かないでくれ" },
    { "t": [100.4,  101.7], "ja": "いいから、さっさと言って、おばかさん" },
    { "t": [101.7,  103.4], "ja": "最高の水飲み場とは何か？" },
    { "t": [103.4,  105.4], "ja": "水飲み場なしってのはどう？" },
    { "t": [105.4,  111.9], "ja": "こちらはトゥミの「ヴォス・ウォーター・バトラー」、1袋たった600ドル" },
    { "t": [111.9,  112.9], "ja": "エイプリル！" },
    { "t": [112.9,  113.9], "ja": "あなたの案は？" },
    { "t": [113.9,  116], "ja": "あの部屋に行って、この本を読み終えること" },
    { "t": [116,  117], "ja": "へえ、そう？" },
    { "t": [117,  118], "ja": "うん" },
    { "t": [118,  119], "ja": "面白いの？" },
    { "t": [119,  120], "ja": "うん" },
    { "t": [120,  121.5], "ja": "どうでもいい。あなたも手伝うの" },
    { "t": [121.5,  122.5], "ja": "ドナは？" },
    { "t": [122.5,  123.5], "ja": "私が水なんか飲むように見える？" },
    { "t": [123.5,  125.5], "ja": "水の勢いを上げればいいんじゃない？" },
    { "t": [125.5,  127.5], "ja": "そうすれば、口をそんなに近づけなくて済むし" },
    { "t": [127.5,  130.5], "ja": "よし、いくぞ" },
    { "t": [130.5,  131.5], "ja": "おお！" },
    { "t": [131.5,  132.5], "ja": "やめて！" },
    { "t": [132.5,  133.5], "ja": "ハニー、ごめんね" },
    { "t": [133.5,  135.5], "ja": "これで懲りたでしょ。ちゃんと見てないからよ" },
    { "t": [135.5,  137.5], "ja": "いい考えがある" },
    { "t": [137.5,  142.5], "ja": "えーと、こういうのはどうかなって思ったんだけど" },
    { "t": [142.5,  143.5], "ja": "あ、待って！" },
    { "t": [143.5,  144.5], "ja": "おい！" },
    { "t": [144.5,  146.5], "ja": "何なんだよ？" },
    { "t": [146.5,  149.5], "ja": "レスリーの代わりの人の面接を始めたんだ" },
    { "t": [149.5,  152.5], "ja": "雇いたい候補者が5人見つかった" },
    { "t": [152.5,  154.5], "ja": "そして、一生の友だちになりたい人が2人" },
    { "t": [154.5,  156.5], "ja": "いや、誰も雇わせないよ" },
    { "t": [156.5,  159.5], "ja": "うちの部署は、大きな計画を仕上げているところだから" },
    { "t": [168.5,  169.5], "ja": "すみません" },
    { "t": [173.5,  174.5], "ja": "すみません、皆さん" },
    { "t": [174.5,  175.5], "ja": "注目！" },
    { "t": [179.5,  183.5], "ja": "この部署に少しリーダーシップが必要なのは、分かってもらえると思う" },
    { "t": [183.5,  184.5], "ja": "特攻だ！" },
    { "t": [189.5,  190.5], "ja": "やあ、みんな" },
    { "t": [190.5,  191.5], "ja": "何がそんなに大事なんだい？" },
    { "t": [191.5,  195.5], "ja": "えーと、昨日の実践的な話し合いの後…" },
    { "t": [195.5,  196.5], "ja": "水風船の投げ合いね" },
    { "t": [196.5,  197.5], "ja": "まあ、そうだな" },
    { "t": [197.5,  200.5], "ja": "本当に使える水飲み場の案を思いついたんです" },
    { "t": [200.5,  204.5], "ja": "ご紹介します、驚きの「飲み口なし水飲み場」" },
    { "t": [204.5,  205.5], "ja": "え？" },
    { "t": [205.5,  206.5], "ja": "何？" },
    { "t": [206.5,  207.5], "ja": "はね防止の部品を外しただけなの" },
    { "t": [207.5,  209.5], "ja": "それがなければ、口をつけられないでしょ" },
    { "t": [209.5,  211.5], "ja": "ほう、じゃあ試してみよう" },
    { "t": [214.5,  216.5], "ja": "はは！ できた！" },
    { "t": [216.5,  217.5], "ja": "よくやったね、さすが" },
    { "t": [217.5,  220.5], "ja": "シンプルで、上品で、安上がりだ" },
    { "t": [220.5,  224.5], "ja": "君たちがこの調子でいけば、レスリーの穴を埋めるのは待てそうだ" },
    { "t": [224.5,  227.5], "ja": "レスリーの穴なら、もうベンが埋めてると思うけど" }
  ]
}
