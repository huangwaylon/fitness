.6,272.3],"en":"I'm sorry."},{"t":[272.3,273.3],"en":"I'm such a doofus."},{"t":[273.3,274.3],"en":"I'm so sorry."},{"t":[274.3,275.3],"en":"I'm so sorry."},{"t":[276.9,278.8],"en":"My God, what happened?"},{"t":[278.8,281.5],"en":"Ah, these new kids, they never last."},{"t":[282.3,284.1],"en":"Sooner or later, they all..."},{"t":[285.3,286.4],"en":"stop lasting."},{"t":[288.4,289.6],"en":"Listen, uh..."},{"t":[289.6,291.6],"en":"What do you say I buy you that cup of coffee now?"},{"t":[292.3,292.9],"en":"Sure."},{"t":[301.6,302.1],"en":"What do you say I buy you that cup of coffee?"}]}
