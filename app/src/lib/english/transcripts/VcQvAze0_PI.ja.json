{
  "video": "VcQvAze0_PI",
  "lines": [
    { "t": [0,  4.7], "ja": "これから見せるものは、最高機密だ" },
    { "t": [4.7,  6.8], "ja": "あれ、あなたのオフィス？ そうだ、ジム" },
    { "t": [6.8,  9.1], "ja": "でも少し手を加えれば、別の会社のオフィスになる" },
    { "t": [9.1,  11.5], "ja": "ダニーをそこにおびき寄せて、売り込むところを見るんだ" },
    { "t": [11.5,  13.3], "ja": "どうも。私は帰る" },
    { "t": [13.3,  15.3], "ja": "変なの。これが何か分かる？" },
    { "t": [15.3,  18], "ja": "これは「スティンガー」だ。何だって？" },
    { "t": [18,  21.1], "ja": "映画みたいな。「スティング」のことでしょ" },
    { "t": [21.1,  22.9], "ja": "ポール・ニューマン、ロバート・レッドフォード、銀行強盗の" },
    { "t": [22.9,  26.2], "ja": "「スティンガー」っていうんだ。「スティング」だよ" },
    { "t": [30,  34.6], "ja": "2時のお約束の方？ ありがとう、あなた" },
    { "t": [34.6,  38], "ja": "会社の社長役には、メレディスがぴったりだった" },
    { "t": [38,  40.9], "ja": "彼女の昼休みが、ダニーとの約束の時間と重なってたし" },
    { "t": [40.9,  43.3], "ja": "それだけ" },
    { "t": [43.3,  45.3], "ja": "求めてたのは本当にそれだけなの" },
    { "t": [45.3,  47], "ja": "ダニー・コードレイです、お会いできてうれしいです" },
    { "t": [47,  48.7], "ja": "メレディス・ヴァン・ヘルシングよ、よろしく" },
    { "t": [48.7,  50.2], "ja": "メレディス・ヴァン・ヘルシング？" },
    { "t": [50.2,  53.3], "ja": "ヴァン・ヘルシングは、吸血鬼ハンターになる前は尊敬される教授だったんだ" },
    { "t": [53.3,  54.8], "ja": "はいはい、でも有名なのはどっち？" },
    { "t": [54.8,  56.7], "ja": "しーっ。そうだ" },
    { "t": [56.7,  59.1], "ja": "ねえ、それ私のマグカップ" },
    { "t": [59.1,  61], "ja": "これ、本物のテレビじゃないって分かってるよね？" },
    { "t": [61,  61.7], "ja": "ええ" },
    { "t": [61.7,  63.7], "ja": "もしよければ、上着を脱いでもいいかしら" },
    { "t": [63.7,  65.3], "ja": "ちょっと暑くて" },
    { "t": [68.3,  71.4], "ja": "こんにちは。あ、だめ、だめ、だめ、やめて" },
    { "t": [71.4,  73.4], "ja": "人は本性を長く隠しておけないものよ" },
    { "t": [73.4,  75.6], "ja": "そして、この人はタイヤが燃えてるみたいに色気がむんむん出てる" },
    { "t": [75.6,  77.7], "ja": "そのとおり。いや、そこまでイケメンじゃないよ" },
    { "t": [77.7,  79.2], "ja": "ああ。みんなが夢中になるのも分かる" },
    { "t": [79.2,  81.6], "ja": "それくらいイケメンなのよ。すごく、すごくハンサム" },
    { "t": [81.6,  84.1], "ja": "立派な肩をしてるわね" },
    { "t": [84.1,  85.2], "ja": "それって何？" },
    { "t": [85.2,  86.5], "ja": "遺伝？" },
    { "t": [86.5,  87.7], "ja": "クレアチン？" },
    { "t": [87.7,  89.6], "ja": "ごめん" },
    { "t": [89.6,  92.4], "ja": "何？ しっかりして、いい？" },
    { "t": [92.4,  94], "ja": "彼を見るのはやめろ" },
    { "t": [94,  95.3], "ja": "ごめんなさい" },
    { "t": [98.3,  99.6], "ja": "紙を売りに来たのよね" },
    { "t": [99.6,  102.8], "ja": "いや、実は、えー、違うんです、ヴァン・ヘルシングさん" },
    { "t": [102.8,  103.7], "ja": "それが目的で来たんじゃありません" },
    { "t": [103.7,  107.6], "ja": "あなたに会って、ほら、相性がいいか確かめに来たんです" },
    { "t": [107.6,  108.8], "ja": "どういう意味？" },
    { "t": [108.8,  110.6], "ja": "うそでしょ" },
    { "t": [110.6,  112.6], "ja": "彼が彼女に売り込ませてる" },
    { "t": [112.6,  114.5], "ja": "これは初デートだと思いましょう" },
    { "t": [114.5,  116.6], "ja": "すごくうまくいってると思うよ" },
    { "t": [116.6,  117.5], "ja": "あなたはどう？" },
    { "t": [117.5,  118.9], "ja": "すごく" },
    { "t": [118.9,  122], "ja": "えー、私には3回目のデートみたいな感じ" },
    { "t": [122,  123.5], "ja": "いいぞ" },
    { "t": [123.5,  125.5], "ja": "いやみだな" },
    { "t": [125.5,  127.3], "ja": "私にやらせて" },
    { "t": [127.3,  132.3], "ja": "ねえ、この机、なんで私たちをこんなに離しておくのかしら？" },
    { "t": [132.3,  134.3], "ja": "僕はずっと机仕事が苦手でね" },
    { "t": [134.3,  135.6], "ja": "いつも外回りなんです" },
    { "t": [135.6,  136.9], "ja": "ねえ、ほら" },
    { "t": [136.9,  137.9], "ja": "いいじゃない？" },
    { "t": [137.9,  138.9], "ja": "ね？" },
    { "t": [138.9,  140.3], "ja": "ほら、僕が払いますよ" },
    { "t": [140.3,  141.4], "ja": "うん" },
    { "t": [142.9,  144.2], "ja": "うわあ。うわあ" },
    { "t": [144.2,  145.8], "ja": "で、何を飲む？" },
    { "t": [145.8,  146.9], "ja": "ウォッカ派？" },
    { "t": [146.9,  148.5], "ja": "私もよ" },
    { "t": [148.5,  150.4], "ja": "今すぐ別の誰かを送り込まないと" },
    { "t": [150.4,  152.8], "ja": "君はペンシルベニア・ソーラーテックの重役だ" },
    { "t": [152.8,  154], "ja": "それ、うそっぽい。どういう意味？" },
    { "t": [154,  156.6], "ja": "言っただろ、君はスターク・インダストリーズの重役だ" },
    { "t": [156.6,  158.9], "ja": "父親から受け継いだ会社だ。やめて、やめて" },
    { "t": [158.9,  159.7], "ja": "筋書きはこうだ" },
    { "t": [159.7,  161.6], "ja": "メレディスが至急、他の場所に呼ばれてる、いいね？" },
    { "t": [161.6,  162.7], "ja": "はい。で、君が代わりに入る" },
    { "t": [162.7,  164.5], "ja": "とにかく、できるだけ早く彼女を外に出して" },
    { "t": [164.5,  165.5], "ja": "分かった。はい、できるよ" },
    { "t": [165.5,  166.2], "ja": "それから？" },
    { "t": [166.2,  167.5], "ja": "それから、彼に売り込ませて。そう" },
    { "t": [167.5,  169], "ja": "彼の実力を見なきゃ。そのとおり" },
    { "t": [169,  170], "ja": "よし、それと忘れないで。君ならできる" },
    { "t": [170,  171.3], "ja": "君はゲイじゃない。やめて" },
    { "t": [171.3,  172.6], "ja": "きっとうまくいく" },
    { "t": [172.6,  174.8], "ja": "いいか、他に何か起きても、とにかく合わせて" },
    { "t": [177.8,  179.9], "ja": "メレディス。あら、マヌエル" },
    { "t": [179.9,  182], "ja": "こちらはマヌエル、うちの清掃係よ" },
    { "t": [182,  183.8], "ja": "英語は全然話せないの" },
    { "t": [184,  186.3], "ja": "オラ、ケ・タル" },
    { "t": [186.3,  188.4], "ja": "コモ・エスタス？" },
    { "t": [188.4,  191.6], "ja": "あー、マヌエル、窓、おそうじ" },
    { "t": [191.6,  193.9], "ja": "英語は話さなくていいの。何かあった？" },
    { "t": [196,  198.7], "ja": "よし、君はスターク・インダストリーズの若きやり手だ" },
    { "t": [198.7,  199.9], "ja": "この会社を買ったばかりで" },
    { "t": [199.9,  200.9], "ja": "メレディスはクビ" },
    { "t": [200.9,  202.2], "ja": "まったく新しい体制だ" },
    { "t": [202.2,  203.6], "ja": "今度は彼が君に売り込まなきゃならない" },
    { "t": [203.6,  205.4], "ja": "よし、スターク・インダストリーズは実在しない" },
    { "t": [205.4,  206.7], "ja": "僕はグーグルを経営してる" },
    { "t": [206.7,  208.5], "ja": "ラリーとセルゲイに呼ばれたんだ。いいね、最高だ" },
    { "t": [208.5,  209.6], "ja": "とにかく彼に売り込ませて" },
    { "t": [209.6,  211.3], "ja": "がっかりさせないで。させます" },
    { "t": [211.3,  213.2], "ja": "させません、だろ。ああ、そうだね" },
    { "t": [213.2,  215], "ja": "これはどっちかというと、さそり座だな" },
    { "t": [215,  218.2], "ja": "こちらはエステバン、もう一人の清掃係よ" },
    { "t": [218.2,  220.4], "ja": "彼も英語は話せないの" },
    { "t": [220.4,  222.4], "ja": "エステバン、床、おそうじ" },
    { "t": [229.9,  230.6], "ja": "ねえ" },
    { "t": [230.6,  232.6], "ja": "僕、車を小型車専用の場所に停めちゃったかも" },
    { "t": [232.6,  233.6], "ja": "他の人がそうするのを見るのは嫌なのに、だから…" },
    { "t": [233.6,  235.8], "ja": "ダニー、あなたとは本当に心が通じ合ってる気がするの" },
    { "t": [235.8,  237], "ja": "だから正直に言わなきゃ" },
    { "t": [237,  239.8], "ja": "だめ、だめ、だめ、だめ、だめ、僕が行く" },
    { "t": [239.8,  241], "ja": "僕が行く。いいぞ！" },
    { "t": [241,  242.6], "ja": "やめて！ やめて、やめて！" },
    { "t": [242.6,  245.4], "ja": "うそでしょ、もう、やめて、やめて！" },
    { "t": [245.4,  247.8], "ja": "やめて、気持ち悪い、やめて、お願い" },
    { "t": [247.8,  249], "ja": "みんな、やめろ" },
    { "t": [249,  251.4], "ja": "マイケル・スコット。やめろって言っただろ" },
    { "t": [251.4,  272.9], "ja": "（音楽）" }
  ]
}
