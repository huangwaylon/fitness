    { "t": [204.9, 206.1], "ja": "♪あなたが倒れたら" },
    { "t": [206.2, 207.2], "ja": "♪私が受け止める" },
    { "t": [207.4, 209], "ja": "♪待ってるから" },
    { "t": [218.8, 219.4], "ja": "よかった" },
    { "t": [219.6, 220.3], "ja": "今のはなかったことにして" },
    { "t": [224.2, 225.9], "ja": "はい、あなたの推薦状" },
    { "t": [225.9, 227.4], "ja": "これでもう解放よ" },
    { "t": [227.7, 229.6], "ja": "もう友だちのふりをしなくていいよ" },
    { "t": [229.9, 230.5], "ja": "助かった" },
    { "t": [231.5, 233.5], "ja": "本当に私が嫌いなのか" },
    { "t": [233.5, 234.8], "ja": "それともただそういう性格なのかわからないけど" },
    { "t": [234.8, 236.8], "ja": "あなたと一緒に過ごせて楽しかった" },
    { "t": [236.8, 239.4], "ja": "だから、あなたが何と言おうと" },
    { "t": [239.6, 240.4], "ja": "あなたは私の友だちよ" },
    { "t": [240.4, 242.1], "ja": "獣医学校に受かるといいな" },
    { "t": [242.1, 243], "ja": "だってあなたのことが好きだから" },
    { "t": [243.1, 243.6], "ja": "以上" },
    { "t": [245.1, 246.2], "ja": "私もあなたにプレゼントがあるの" },
    { "t": [247.8, 248.9], "ja": "赤ちゃんの名前の本" },
    { "t": [249.2, 250.3], "ja": "クリスとうまくいくといいね" },
    { "t": [250.3, 251.2], "ja": "もしだめでも" },
    { "t": [251.3, 252.2], "ja": "誰かとうまくいくといいな" },
    { "t": [253.5, 254.6], "ja": "じゃあ、今からハグするよ" },
    { "t": [254.8, 255.1], "ja": "いや" },
    { "t": [255.2, 255.4], "ja": "するの" },
    { "t": [256.1, 257.3], "ja": "痛い、痛いってば" },
