{
  "video": "50d2x7j2dZ4",
  "lines": [
    { "t": [1,2.5], "ja": "－この地雷、まだ使える？" },
    { "t": [2.5,3.5], "ja": "－部分的にはな" },
    { "t": [6.3,7.2], "ja": "なぜだ？" },
    { "t": [7.2,8.8], "ja": "－ドナの机を吹き飛ばしたいの" },
    { "t": [8.8,10.6], "ja": "仕事をサボったらどうなるか" },
    { "t": [10.6,11.6], "ja": "思い知らせてやるために" },
    { "t": [11.6,13.7], "ja": "－そういうやり方はどうかと思うが" },
    { "t": [13.7,15.7], "ja": "－私、いちおう今は彼女の上司なんだけど" },
    { "t": [15.7,18], "ja": "彼女を叱るのは、まだ変な感じがするの" },
    { "t": [18,19], "ja": "どうしたらいい？" },
    { "t": [19,20.7], "ja": "－彼女の目を見て、伝えるんだ" },
    { "t": [20.7,22.7], "ja": "彼女に何をしてほしいのか、はっきりとな" },
    { "t": [22.7,25.1], "ja": "大人らしく、率直に、きっぱりと" },
    { "t": [26.3,29.1], "ja": "－何これ？　どこかのバカが、口コミサイトで私をこき下ろしてる" },
    { "t": [29.1,30.6], "ja": "－ロンのアドバイスに従ったの" },
    { "t": [30.6,33.5], "ja": "とっても大人らしく、率直に" },
    { "t": [33.5,36.8], "ja": "ネットにドナについての匿名コメントを書いたの" },
    { "t": [36.8,38.5], "ja": "－「犬を引き取りに寄ったのに" },
    { "t": [38.5,42.2], "ja": "職員のドナ・ミーグルはどこにもいなかった" },
    { "t": [42.2,44.5], "ja": "何の役にも立たなかったよ、ドナ・ミーグル" },
    { "t": [44.5,45.6], "ja": "ブー" },
    { "t": [45.6,47.4], "ja": "オーが5つのブーね」" },
    { "t": [47.4,48.8], "ja": "－うわ、それはひどいね" },
    { "t": [48.8,50.9], "ja": "もっとがんばって働くしかないんじゃない？" },
    { "t": [50.9,52], "ja": "－この変人、匿名の名前の陰に" },
    { "t": [52,54.1], "ja": "隠れられると思ってるの？" },
    { "t": [54.1,57], "ja": "今から追い詰めてやる" },
    { "t": [58,59.5], "ja": "とにかく、あのイカれた口コミを書いた" },
    { "t": [59.5,62.2], "ja": "男のアイピーアドレスを教えて" },
    { "t": [62.2,63.3], "ja": "－分かった、出たよ" },
    { "t": [63.3,64.8], "ja": "アイピーアドレスによると、送ったのは" },
    { "t": [64.8,66.7], "ja": "市役所の中にいる誰かだね" },
    { "t": [66.7,67.9], "ja": "－この建物の中？" },
    { "t": [67.9,69.4], "ja": "冗談じゃないわよ！" },
    { "t": [69.4,70.4], "ja": "－まあ、そんなのどうでもよくない？" },
    { "t": [70.4,72.2], "ja": "ネットのどこかのバカでしょ" },
    { "t": [72.2,73.1], "ja": "無視しなよ" },
    { "t": [73.1,74], "ja": "－無視しろって？" },
    { "t": [74,75.5], "ja": "そいつに、雷神トールのハンマー、ミョルニルみたいに" },
    { "t": [75.5,77.6], "ja": "鉄槌を下してやる" },
    { "t": [77.6,80.4], "ja": "ミョルニルでぶちのめしてやるわ" },
    { "t": [81.8,83.8], "ja": "－悪い口コミと言えば" },
    { "t": [83.8,85.8], "ja": "コンピューターはたいてい役に立たないが" },
    { "t": [85.8,88.6], "ja": "あの口コミサイトのおかげで、いい考えが浮かんだ" },
    { "t": [88.6,90.9], "ja": "人をきちんと批判するやり方だ" },
    { "t": [91.9,94.4], "ja": "私は気に入らないものについて" },
    { "t": [94.4,96.3], "ja": "厳しい言葉の手紙を書いている" },
    { "t": [96.3,98.9], "ja": "そしてネットで住所を調べて" },
    { "t": [98.9,100.1], "ja": "そこに送っているんだ" },
    { "t": [100.1,102.4], "ja": "これまでに書いた相手は、野菜農場" },
    { "t": [102.4,104.4], "ja": "ヨーロッパの大使数人" },
    { "t": [104.4,107], "ja": "男性用コロンの会社" },
    { "t": [107,109.7], "ja": "それに無脂肪のフローズンヨーグルト店だ" },
    { "t": [110.7,111.9], "ja": "親愛なるフローズンヨーグルトへ" },
    { "t": [111.9,114.1], "ja": "お前はデザートのセロリだ" },
    { "t": [114.1,116.6], "ja": "アイスクリームになるか、消えるかにしろ" },
    { "t": [116.6,118], "ja": "星ゼロ" },
    { "t": [120.2,121.7], "ja": "－ドナ、僕に用？" },
    { "t": [121.7,122.6], "ja": "－ええ、そうよ" },
    { "t": [122.6,123.6], "ja": "－荒らし" },
    { "t": [123.6,124.4], "ja": "－え？" },
    { "t": [124.4,125.8], "ja": "－あなた、先週、猫を引き取ろうとしたでしょ" },
    { "t": [125.8,126.8], "ja": "私は断った" },
    { "t": [126.8,128.3], "ja": "猫を6匹も飼うなんて" },
    { "t": [128.3,130], "ja": "悲しすぎると思ったから" },
    { "t": [130,132.5], "ja": "そしたら、ネットで私の顔をつぶそうとした" },
    { "t": [132.5,133.7], "ja": "あなたはクビよ" },
    { "t": [133.7,134.9], "ja": "－君は僕の上司じゃないよ" },
    { "t": [134.9,136.5], "ja": "僕は市の法務局で働いてるんだ" },
    { "t": [136.5,139.2], "ja": "あなたはクビ" },
    { "t": [141,142.5], "ja": "－カナダに手紙を送るには" },
    { "t": [142.5,144.4], "ja": "切手はいくら要る？" },
    { "t": [144.4,145.3], "ja": "－誰あてですか？" },
    { "t": [145.3,146.7], "ja": "－カナダだ" },
    { "t": [146.7,149], "ja": "「親愛なるカナダへ。くたばれ」と書いてある" },
    { "t": [152.1,152.9], "ja": "何か用か？" },
    { "t": [152.9,154.4], "ja": "－ええ、僕はロウエル通りのビーガンレストラン" },
    { "t": [154.4,156.5], "ja": "「レタス・イート」のオーナーです" },
    { "t": [156.5,157.4], "ja": "知りたいことがあって" },
    { "t": [157.4,159.6], "ja": "なんでこの手紙を、うちのドアに釘で打ちつけたんですか" },
    { "t": [159.6,161.5], "ja": "－ビーガン主義は" },
    { "t": [161.5,163.4], "ja": "道徳的に腐った心の悲しい結果だ" },
    { "t": [163.4,165.2], "ja": "自分の人生を考え直せ" },
    { "t": [166.3,168], "ja": "－そう信じているからだ" },
    { "t": [168,168.9], "ja": "では失礼" },
    { "t": [168.9,170.2], "ja": "－肉食の人たちって" },
    { "t": [170.2,171.3], "ja": "みんな同じだ" },
    { "t": [172.7,174.7], "ja": "－あの人、どうやってあなたの居場所が分かったの？" },
    { "t": [174.7,176.4], "ja": "－たぶん、私の名前と住所を見たんだろう" },
    { "t": [176.4,177.5], "ja": "ドアに打ちつけた手紙の" },
    { "t": [177.5,178.8], "ja": "いちばん下に書いてあったからな" },
    { "t": [178.8,180.1], "ja": "－本名を書いたの？" },
    { "t": [180.1,181.1], "ja": "－もちろんだ" },
    { "t": [181.1,181.9], "ja": "何が起こるというんだ？" },
    { "t": [181.9,184], "ja": "ビーガンに殴られるとでも？" },
    { "t": [185,187], "ja": "あいつらはほとんどガラスでできてるようなものだ" },
    { "t": [187,187.9], "ja": "だが、もっと大事なのは" },
    { "t": [187.9,189], "ja": "何かを信じているなら" },
    { "t": [189,190.3], "ja": "それに自分の名前を書くことだ" },
    { "t": [190.3,192.8], "ja": "だから炭酸水のメーカーも" },
    { "t": [192.8,195.3], "ja": "もうすぐ私の居場所を正確に知ることになる" },
    { "t": [198.4,202], "ja": "－ドナ、あれを書いたのはカイルじゃないの、いい？" },
    { "t": [202,202.8], "ja": "私なの" },
    { "t": [202.8,204.4], "ja": "－知ってる" },
    { "t": [204.4,205.2], "ja": "－知ってたの？" },
    { "t": [205.2,207.3], "ja": "－そのユーザーがほかに何を書いたか調べたの" },
    { "t": [207.3,208.6], "ja": "葬儀場の口コミがあって" },
    { "t": [208.6,210.9], "ja": "「初デートにぴったり」って書いてあった" },
    { "t": [210.9,212.8], "ja": "あなたが白状するか見るために、ここでカイルを犯人扱いしてみたの" },
    { "t": [212.8,214.2], "ja": "－まあ、カイルがどうなろうと" },
    { "t": [214.2,216.7], "ja": "私はそこまで気にしてないから、買いかぶりすぎ" },
    { "t": [216.7,218.2], "ja": "ていうか、誰がどうなっても" },
    { "t": [218.2,222.1], "ja": "でも、ちゃんと直接話さなくてごめん" },
    { "t": [222.1,223.7], "ja": "－私も、仕事をサボってごめん" },
    { "t": [223.7,224.8], "ja": "それに、正面から言わずに" },
    { "t": [224.8,226.5], "ja": "あなたをもてあそんでごめん" },
    { "t": [226.5,229.3], "ja": "これからは、思ったことを言い合いましょう" },
    { "t": [229.3,230.1], "ja": "いい？" },
    { "t": [230.1,231.2], "ja": "－いいよ" },
    { "t": [231.2,232.7], "ja": "その口紅、変だよ" },
    { "t": [232.7,234.6], "ja": "－今すぐ黙ったほうが身のためよ" },
    { "t": [234.6,235.6], "ja": "－いい話し合いだった" },
    { "t": [246.7,247.5], "ja": "－また次回" },
    { "t": [247.5,248.5], "ja": "－また次回" },
    { "t": [248.5,249.5], "ja": "－じゃあね" }
  ]
}
