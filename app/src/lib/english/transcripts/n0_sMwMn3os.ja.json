{
  "video": "n0_sMwMn3os",
  "lines": [
    { "t": [0, 2.2], "ja": "ベンは選挙参謀としてすばらしい仕事をしてるね" },
    { "t": [2.2, 3.7], "ja": "ありがとう。どういたしまして" },
    { "t": [3.7, 4.7], "ja": "本当に頭がいい" },
    { "t": [4.7, 6.7], "ja": "まあ、選挙参謀の出来は" },
    { "t": [6.7, 9.6], "ja": "その参謀が支えている候補者次第だからね" },
    { "t": [9.6, 11.9], "ja": "つまり、君は本当に頭のいい女性だって言いたいんだ" },
    { "t": [11.9, 13], "ja": "ああ、まったくその通りだね" },
    { "t": [13, 14.5], "ja": "むしろ僕が彼女の足を引っぱってるくらいだ" },
    { "t": [14.5, 17.6], "ja": "ああ、ベン。先に僕が言ったんだけど" },
    { "t": [17.6, 19.5], "ja": "実は、だから今日警察署に行ってたの" },
    { "t": [19.5, 21.6], "ja": "トランプル署長の支持をもらおうとしてて" },
    { "t": [21.6, 22.9], "ja": "へえ、そう？彼とは仲がよかったんだ" },
    { "t": [22.9, 24.4], "ja": "たぶん僕が頼めば支持してくれるよ" },
    { "t": [24.4, 25.7], "ja": "うわ、それはすごく助かる" },
    { "t": [25.7, 26.8], "ja": "うん。ありがとう" },
    { "t": [26.8, 27.9], "ja": "ねえ。ちょっと失礼" },
    { "t": [27.9, 29.4], "ja": "トイレに行ってくる" },
    { "t": [29.4, 30.9], "ja": "ああ、「おしっこ宮殿」のことだね" },
    { "t": [30.9, 32.8], "ja": "うん、リジーがときどきそう呼ぶんだ" },
    { "t": [32.8, 35], "ja": "知ってる。ちょっとかわいいよね" },
    { "t": [35, 36.3], "ja": "うん、本当にかわいい" },
    { "t": [40, 42.9], "ja": "で、ダニーは元気？まだ君を愛してる" },
    { "t": [42.9, 44], "ja": "今何て言ったの？" },
    { "t": [44, 46], "ja": "何も。何も言ってない" },
    { "t": [46, 47.3], "ja": "今のは何も…" },
    { "t": [47.3, 48.8], "ja": "今、まだ私を愛してるって言った？" },
    { "t": [48.8, 50.2], "ja": "いや、そんなこと言ってないと思う" },
    { "t": [50.2, 52.5], "ja": "デイブ、なんで今ここでそんなことを言うの？" },
    { "t": [52.5, 54.9], "ja": "本当のことだからだよ" },
    { "t": [54.9, 56.7], "ja": "それに今は彼がいないから" },
    { "t": [56.7, 58.7], "ja": "いいタイミングだと思って" },
    { "t": [58.7, 60.5], "ja": "5分だけでいいから、このことを話させてくれない？" },
    { "t": [60.5, 62.3], "ja": "だめ、恋人がいるときに" },
    { "t": [62.3, 63.7], "ja": "その話を持ち出すなんて絶対だめ" },
    { "t": [63.7, 65.3], "ja": "わかった、じゃあ彼を追い払って。それはいい判断だ" },
    { "t": [65.3, 67.1], "ja": "だめ、悪い判断よ。そういう判断じゃないの" },
    { "t": [67.1, 69.1], "ja": "わかった、じゃあ彼が「おしっこ宮殿」にいる間に出れば…" },
    { "t": [69.1, 70.1], "ja": "だめ、聞いて" },
    { "t": [70.1, 71.4], "ja": "やあ" },
    { "t": [71.4, 74.9], "ja": "「おしっこ城」" },
    { "t": [74.9, 78.3], "ja": "これもトイレの面白い呼び方なんだ" },
    { "t": [78.3, 80.7], "ja": "僕が考えたんだよ" },
    { "t": [80.7, 83], "ja": "向こうでの仕事はどう、デイブ？" },
    { "t": [83, 86.4], "ja": "かなりいいよ。悪いやつをたくさん捕まえた" },
    { "t": [86.4, 88], "ja": "6人くらいね" },
    { "t": [88, 89.5], "ja": "じゃあ、明日帰るの？" },
    { "t": [89.5, 90.8], "ja": "明日の予定だよ" },
    { "t": [90.8, 93.7], "ja": "ソルトレイクシティ経由の12時15分の便でね" },
    { "t": [93.7, 95.7], "ja": "ああ、会えて本当によかった" },
    { "t": [95.7, 97.5], "ja": "でも、戻ってくるかもしれない" },
    { "t": [97.5, 98.4], "ja": "それはどういうこと？" },
    { "t": [98.4, 101.1], "ja": "実は、ここに来た一番の目的は、トランプルの後任の面接なんだ" },
    { "t": [101.1, 101.9], "ja": "警察署長のね" },
    { "t": [101.9, 103.1], "ja": "ねえ、それはすごい" },
    { "t": [103.1, 104.5], "ja": "絶対に署長になるべきだよ" },
    { "t": [104.5, 105.9], "ja": "そしたらレスリーを支持できる" },
    { "t": [105.9, 107.8], "ja": "レスリーは絶対に支持するよ" },
    { "t": [107.8, 111.8], "ja": "しなくていいのよ、いい候補者はたくさんいるし" },
    { "t": [111.8, 115.7], "ja": "ちょっと外を歩いてこようかな" },
    { "t": [115.7, 117.5], "ja": "誰か一緒にいてくれるといいんだけど" },
    { "t": [117.5, 118.5], "ja": "え？え？" },
    { "t": [118.5, 121], "ja": "一緒に外に出て、近況を話さない？" },
    { "t": [121, 121.9], "ja": "もう近況は話したわ" },
    { "t": [121.9, 125], "ja": "サンディエゴの話も、6人の悪いやつの話もしたし" },
    { "t": [125, 126.1], "ja": "もう十分だと思う" },
    { "t": [126.1, 127.4], "ja": "ちょっと一緒にぶらぶらしてもいいけど" },
    { "t": [127.4, 129.6], "ja": "いいえ、それは嫌" },
    { "t": [129.6, 131.9], "ja": "まあ、もう…もう行くって言っちゃったし" },
    { "t": [131.9, 134.2], "ja": "有言実行の男だから行くよ" },
    { "t": [134.2, 135], "ja": "ごゆっくり" },
    { "t": [135, 137.1], "ja": "うん、ありがとう" },
    { "t": [137.1, 139.6], "ja": "ねえ、正直、僕どんな感じ？" },
    { "t": [139.6, 141.4], "ja": "けっこううまくやれてる気がするんだけど" },
    { "t": [141.4, 142.8], "ja": "彼、まだ私を愛してるって言ったの" },
    { "t": [142.8, 143.7], "ja": "何だって？" },
    { "t": [143.7, 144.7], "ja": "あなたがトイレにいる間に" },
    { "t": [144.7, 147.1], "ja": "まだ私を愛してるって言ったのよ" },
    { "t": [147.1, 149.9], "ja": "うわ、レスリー、あいつ警官だよ" },
    { "t": [149.9, 152.5], "ja": "君を愛してて、しかも銃を持ってるの？" },
    { "t": [152.5, 153.5], "ja": "お願いだから取り乱さないで" },
    { "t": [153.5, 154.2], "ja": "取り乱してないよ" },
    { "t": [154.2, 155.1], "ja": "わかった" },
    { "t": [155.1, 159.3], "ja": "取り乱して…わかってる、それは…わかってる" },
    { "t": [159.3, 161.1], "ja": "えっと…外は雨が降ってたから" },
    { "t": [161.1, 164.2], "ja": "濡れたくなくてね" },
    { "t": [164.2, 165.3], "ja": "ご注文のお会計です" },
    { "t": [165.3, 166.4], "ja": "はい、クレジットカード。急いで" },
    { "t": [166.4, 167.9], "ja": "お会計？うん" },
    { "t": [167.9, 168.8], "ja": "デザートを頼めばいいのに" },
    { "t": [168.8, 169.7], "ja": "デザートを頼んだら？" },
    { "t": [169.7, 172.7], "ja": "ああ、デザートなんて過大評価されてるし、まずいよ" },
    { "t": [172.7, 174.9], "ja": "デイブ、素敵な夜を本当にありがとう" },
    { "t": [174.9, 179.3], "ja": "あ、実は、ベン、レスリーと二人で話してもいいかな？" },
    { "t": [179.3, 181.9], "ja": "えっと、実は、デイブ、僕が君と話したいんだ" },
    { "t": [181.9, 184], "ja": "僕は君とじゃなくて、レスリーと話したいんだ" },
    { "t": [184, 186.2], "ja": "まあ、僕は君と話したい。だめなら" },
    { "t": [186.2, 187.7], "ja": "レスリーと話したい" },
    { "t": [187.7, 188.8], "ja": "じゃあ、私はベンと話して" },
    { "t": [188.8, 191.3], "ja": "それから三人で話したいわ" },
    { "t": [191.3, 193.8], "ja": "じゃあ、僕がベンと話して、それから君と…" },
    { "t": [193.8, 196.6], "ja": "それから僕が君と話して、それから君たち二人が話して" },
    { "t": [196.6, 198.6], "ja": "それから三人で話そう" },
    { "t": [198.6, 199.8], "ja": "わかった" },
    { "t": [199.8, 202.3], "ja": "で、今は誰が話すの？" },
    { "t": [202.3, 204.4], "ja": "男同士として知っておいてほしいことがある" },
    { "t": [204.4, 208.2], "ja": "僕はまだ、女性らしいやり方でレスリーに気持ちがあるんだ" },
    { "t": [208.2, 213.4], "ja": "それに彼女も、男らしいやり方で同じ気持ちだと思う" },
    { "t": [213.4, 217.9], "ja": "彼女は同じ気持ちじゃないよ。恋人がいるんだから" },
    { "t": [217.9, 221.8], "ja": "えっと、僕がね。それで、僕たちは愛し合ってる" },
    { "t": [221.8, 224.3], "ja": "それは…その情報は…関係ないんだ" },
    { "t": [224.3, 225.9], "ja": "いや…はっきり言って、今の時点ではね" },
    { "t": [225.9, 229.6], "ja": "僕がひとつ言っただけなのに、君は僕にはんたいりんぐしてくる" },
    { "t": [229.6, 231.4], "ja": "そんな言葉、ないと思うけど" },
    { "t": [231.4, 233.5], "ja": "三分だけ彼女と二人にしてくれたら" },
    { "t": [233.5, 237.3], "ja": "みんなありがたいと思うよ" },
    { "t": [237.3, 239.9], "ja": "したがって、この場から離れてくれ" },
    { "t": [239.9, 240.9], "ja": "いや、ごめん" },
    { "t": [240.9, 243.9], "ja": "君が僕の恋人を奪おうとするのを" },
    { "t": [243.9, 246.4], "ja": "認めるつもりはないよ" },
    { "t": [246.4, 249.8], "ja": "それは筋が通ってると思う" },
    { "t": [249.8, 251.5], "ja": "わかった" },
    { "t": [251.5, 253], "ja": "わかった。それから、お礼を言いたい" },
    { "t": [253, 255], "ja": "この話をしてくれてありがとう" },
    { "t": [255, 256.8], "ja": "ああ、こちらこそありがとう。本当にありがとう" },
    { "t": [256.8, 260.5], "ja": "な、何してるの？こうしてるんだ" },
    { "t": [260.5, 262.5], "ja": "本気？自業自得だよ" },
    { "t": [262.5, 264], "ja": "何だって？！" },
    { "t": [270.9, 272.9], "ja": "また次回お会いしましょう。また次回" }
  ]
}
