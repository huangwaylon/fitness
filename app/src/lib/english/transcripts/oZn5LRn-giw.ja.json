{
  "video": "oZn5LRn-giw",
  "lines": [
    { "t": [0, 2.2], "ja": "気にしないで。全然大丈夫よ" },
    { "t": [2.2, 3.5], "ja": "いや、大丈夫じゃない" },
    { "t": [3.5, 6.2], "ja": "僕が押しに弱いって、彼女が言いふらし始めたらどうする？" },
    { "t": [6.2, 7.5], "ja": "誰も信じないわよ" },
    { "t": [7.5, 10.2], "ja": "初めて会ったとき、あなたのこと独裁的な堅物だと思ったもの" },
    { "t": [10.2, 11.2], "ja": "え？" },
    { "t": [11.2, 14.5], "ja": "かわいい独裁的な堅物ね。でもやっぱり、あなたからはすごく…" },
    { "t": [15.8, 19.5], "ja": "教育局が正式に、スクールバス10台を要求してきたよ" },
    { "t": [19.5, 21.3], "ja": "4台だけって言ってたと思ったけど" },
    { "t": [21.3, 23.7], "ja": "まあ、僕は押しに弱いんだから、10台頼んで当然だろ？" },
    { "t": [23.7, 26.3], "ja": "それか20台？それとも新しいスクールバス100台？" },
    { "t": [26.3, 28.4], "ja": "ついでに学校のヨットの船団も？どう？" },
    { "t": [28.4, 30.3], "ja": "うーん。こうしましょう" },
    { "t": [30.3, 33.4], "ja": "あなたのお母さんについて知ってることを全部教えて" },
    { "t": [33.4, 35.2], "ja": "それで私がもう一度お母さんと会って" },
    { "t": [35.2, 36.4], "ja": "決着をつけるわ" },
    { "t": [36.4, 39.7], "ja": "それか、ベリーズに行ってスキューバダイビングして" },
    { "t": [39.7, 40.8], "ja": "ジンベエザメを見るのもいいよ" },
    { "t": [40.8, 42.7], "ja": "君、ダイビングの資格持ってるよね？取りに行こうよ" },
    { "t": [43.9, 46.8], "ja": "いい、強く、力強く、きっぱりしてなきゃだめ" },
    { "t": [46.8, 48.9], "ja": "これは会議じゃない。戦いよ" },
    { "t": [48.9, 50.9], "ja": "普通の会議のルールは通用しないの" },
    { "t": [50.9, 53.9], "ja": "私がママの役をやって、あなたにすごく厳しくするわ" },
    { "t": [53.9, 55.9], "ja": "それはあなたのことが大好きだからよ" },
    { "t": [55.9, 57.5], "ja": "わかった。始め！" },
    { "t": [58.4, 61.3], "ja": "こんにちは。違う" },
    { "t": [61.3, 63.3], "ja": "え？前置きもあいさつもなし" },
    { "t": [63.3, 65.4], "ja": "とにかく入ってきて話し始めるの" },
    { "t": [65.4, 67.4], "ja": "新しいスクールバスについて話したいのですが" },
    { "t": [67.4, 71.1], "ja": "あなたの韻の踏み方について話したいわ、ドクター・スース" },
    { "t": [71.1, 72.4], "ja": "それに、もう座ってなきゃだめよ" },
    { "t": [72.4, 74.5], "ja": "え？とにかく入ってきて座るの" },
    { "t": [74.5, 77.5], "ja": "えっと…「えっと」はばかの音よ" },
    { "t": [77.5, 78.7], "ja": "ママが人によく言うセリフなの" },
    { "t": [78.7, 80.4], "ja": "しかも今、女の人みたいに脚を組んだわね" },
    { "t": [80.4, 82], "ja": "もう、わかったよ、最初からやり直す？" },
    { "t": [82, 83.9], "ja": "だめ。いえ、いったん保留にしましょう" },
    { "t": [83.9, 87.8], "ja": "これがママの好きな話題トップ100のリストよ" },
    { "t": [87.8, 90.4], "ja": "ペルシャじゅうたんから始まって、ダニエル・クレイグで終わるの" },
    { "t": [90.4, 92.8], "ja": "覚える時間は10分" },
    { "t": [92.8, 94.3], "ja": "「脱出」って、あの映画？" },
    { "t": [94.3, 96.6], "ja": "うん。ああもう" },
    { "t": [96.6, 98.9], "ja": "ママ？あら！" },
    { "t": [98.9, 102.9], "ja": "まあ、なんて気が利くの" },
    { "t": [102.9, 104.2], "ja": "もちろんよ" },
    { "t": [104.2, 107.8], "ja": "ただ、ママの機嫌をよくしてあげてもいいかなって思って" },
    { "t": [107.8, 112.3], "ja": "では、会議で私が言ったにもかかわらず" },
    { "t": [112.3, 116.6], "ja": "なぜかスクールバスの要求を増やしたそうですね？" },
    { "t": [116.6, 119], "ja": "すみませんけど、今は娘とコーヒーを飲んでるの" },
    { "t": [119, 120.6], "ja": "また別の機会にしましょう" },
    { "t": [120.6, 123.8], "ja": "いいえ、今この話をします" },
    { "t": [123.8, 125.7], "ja": "それとも、お望みなら教育予算を" },
    { "t": [125.7, 127.1], "ja": "永久に凍結することもできますよ" },
    { "t": [127.1, 128.8], "ja": "どうするかはあなた次第です" },
    { "t": [128.8, 130.2], "ja": "ねえ、ママ、彼と話したほうがいいかもよ" },
    { "t": [130.2, 132.9], "ja": "すごく自信がありそうだし" },
    { "t": [132.9, 135.7], "ja": "いいですか、それは無理です" },
    { "t": [135.7, 137.8], "ja": "それに、裏をかこうとしても無駄ですよ" },
    { "t": [137.8, 139.1], "ja": "失敗しますから" },
    { "t": [139.1, 141.3], "ja": "いったい急にどこからそんな自信が出てきたの？" },
    { "t": [141.3, 142.7], "ja": "ねえ、二人とも、まあまあ、落ち着いて" },
    { "t": [142.7, 144], "ja": "あの、グリッグス・ノープさん" },
    { "t": [144, 144.9], "ja": "マーリーンよ" },
    { "t": [144.9, 146.4], "ja": "たぶん、ここには妥協点がありますよ" },
    { "t": [146.4, 148.3], "ja": "妥協は、たいてい弱さのしるしよ" },
    { "t": [148.3, 150.7], "ja": "ええ、アンドリュー・カーネギーによればね" },
    { "t": [150.7, 152.7], "ja": "でもあなたの要求を聞いて、別の名言を思い出しました" },
    { "t": [152.7, 155], "ja": "偉大なビル・ワターソンの言葉です" },
    { "t": [155, 158.7], "ja": "「頭の手術が必要なら、のこぎりを持ってくるよ」" },
    { "t": [158.7, 160.5], "ja": "「カルビンとホッブス」大好き" },
    { "t": [160.5, 161.5], "ja": "僕もです" },
    { "t": [162.9, 166.2], "ja": "言わせてもらうと、これは私の最高傑作のひとつよ" },
    { "t": [166.2, 168.4], "ja": "これ以上ないくらいうまくいった" },
    { "t": [168.4, 170.2], "ja": "二人はすごく意気投合してる" },
    { "t": [170.2, 171.3], "ja": "よかった" },
    { "t": [171.3, 173.5], "ja": "危機回避よ" },
    { "t": [173.5, 177], "ja": "ねえ、また来てくれて本当にうれしいわ" },
    { "t": [177, 179.1], "ja": "ええ、僕もです" },
    { "t": [179.1, 180.9], "ja": "はい。で、取引成立ですか？" },
    { "t": [180.9, 182.5], "ja": "まあ、全部じっくり考えさせて" },
    { "t": [182.5, 186.1], "ja": "それからまた会って話を詰めましょう" },
    { "t": [186.1, 188.9], "ja": "厳しい話になるかもしれないけど、それも楽しいものよ" },
    { "t": [188.9, 189.7], "ja": "ベンなら大丈夫よ" },
    { "t": [189.7, 190.9], "ja": "ええ、大丈夫です" },
    { "t": [190.9, 192.5], "ja": "はい、よかった" },
    { "t": [192.5, 193.2], "ja": "楽しかったわ" },
    { "t": [193.2, 197.1], "ja": "ああ、ええ" },
    { "t": [197.1, 198.6], "ja": "すごいのは、ママもあなたに感心してたことよ" },
    { "t": [198.6, 199.7], "ja": "だって、すぐにわかったもの" },
    { "t": [199.7, 201.7], "ja": "二人の通じ合い方が本当にすごかったって" },
    { "t": [201.7, 203.2], "ja": "で、考えてるんだけど" },
    { "t": [203.2, 204.2], "ja": "ママの家に行ってみるのはどうかな" },
    { "t": [204.2, 205.6], "ja": "言わせて、私って天才" },
    { "t": [205.6, 207.9], "ja": "ママがオルゴールより好きなものは" },
    { "t": [207.9, 209.5], "ja": "「グレイズ・アナトミー」のマクスティーミーだけなの" },
    { "t": [209.5, 213.4], "ja": "だからマクスティーミー風のオルゴールを作ったの" },
    { "t": [213.4, 214.6], "ja": "それで、あなたから渡してもらえたらと思って" },
    { "t": [214.6, 216], "ja": "ママ、あなたのことが大好きになるわ" },
    { "t": [216, 218], "ja": "それはあまりいい考えじゃないかも" },
    { "t": [218, 218.8], "ja": "なんで？" },
    { "t": [218.8, 221], "ja": "まあ、彼の一番いい写真じゃないけど…" },
    { "t": [221, 223.4], "ja": "君のお母さん、ちょっと…" },
    { "t": [225.4, 228.9], "ja": "えっと、僕に言い寄ってきたんだ" },
    { "t": [231.1, 232.6], "ja": "ちょっとふざけてただけだよ" },
    { "t": [232.6, 235.1], "ja": "本気で僕に気があるわけじゃないと思う" },
    { "t": [235.1, 237.2], "ja": "うそでしょ。こんな話できない" },
    { "t": [237.2, 239.1], "ja": "もう全部めちゃくちゃよ" },
    { "t": [239.1, 241], "ja": "気分をぶち壊す方法はいろいろあるけど" },
    { "t": [241, 244.7], "ja": "ママがあなたに言い寄るのはその中でも最悪だわ" },
    { "t": [244.7, 246.7], "ja": "それに、ごめん、これは言わせて" },
    { "t": [246.7, 249], "ja": "あなた、何か誘うようなことした？" },
    { "t": [249, 250.1], "ja": "してない" },
    { "t": [250.1, 251], "ja": "どんな服を着てたの？" },
    { "t": [251, 252.8], "ja": "なんてこと。これを着てたよ" },
    { "t": [252.8, 253.6], "ja": "こうしましょう" },
    { "t": [253.6, 256], "ja": "あなたは役所全体にセクハラについての通達を出して" },
    { "t": [256, 257.5], "ja": "それからメキシコに行くの" },
    { "t": [257.5, 259.5], "ja": "2、3週間だけね" },
    { "t": [259.5, 260.6], "ja": "どこ行くの？" },
    { "t": [260.6, 262], "ja": "ベン" },
    { "t": [262, 263.5], "ja": "ベン、待って、ちょっと…" },
    { "t": [263.5, 265.1], "ja": "どうも" },
    { "t": [265.1, 266.1], "ja": "こんにちは、お母さん" },
    { "t": [266.1, 266.8], "ja": "あら、また会ったわね" },
    { "t": [266.8, 269], "ja": "レスリーと僕は付き合ってるんです" },
    { "t": [269, 270.6], "ja": "誰にも言ってないのは、職場恋愛を禁じる規則があるからです" },
    { "t": [270.6, 274], "ja": "でも、付き合ってます" },
    { "t": [274, 276.2], "ja": "ひざをさわられる前に言わなくてすみません" },
    { "t": [276.2, 278], "ja": "これで誰にも言わないと信じてます" },
    { "t": [278, 282.4], "ja": "娘さんがクビになるかもしれないので" },
    { "t": [282.4, 287.2], "ja": "…" },
    { "t": [287.2, 290.3], "ja": "それは傑作ね" },
    { "t": [290.3, 292.9], "ja": "僕たちもそう思いました" },
    { "t": [292.9, 296.4], "ja": "まあ…" },
    { "t": [296.4, 297.4], "ja": "バス4台" },
    { "t": [297.4, 298.3], "ja": "2台" },
    { "t": [298.3, 299.2], "ja": "決まり" },
    { "t": [304.2, 306.3], "ja": "この人、気に入ったわ" },
    { "t": [306.3, 308], "ja": "私もよ" },
    { "t": [308, 309.5], "ja": "彼に手を出さないでね" }
  ]
}
