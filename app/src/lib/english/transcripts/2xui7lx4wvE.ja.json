{
  "video": "2xui7lx4wvE",
  "lines": [
    { "t": [0, 2], "ja": "はは、みんな、すごく面白いね" },
    { "t": [2, 3], "ja": "本物の横断幕はどこ？" },
    { "t": [3, 4], "ja": "1時間しかなかったんだ" },
    { "t": [4, 7], "ja": "私もよ。私が作ったのを見て" },
    { "t": [7, 8], "ja": "やあ、みんな" },
    { "t": [8, 9], "ja": "ジェリー！" },
    { "t": [9, 10], "ja": "おかえり！" },
    { "t": [10, 12], "ja": "やあ！" },
    { "t": [12, 14], "ja": "いやあ、こんなに手間をかけてくれなくてよかったのに" },
    { "t": [14, 17], "ja": "仲間のためなら手間じゃないよ。はい、どうぞ" },
    { "t": [17, 19], "ja": "いいか、今日はジェリーの日だ" },
    { "t": [19, 21], "ja": "何でも好きなことをしよう、本当に何でも" },
    { "t": [21, 23], "ja": "正直に言うと、私がしたいのは" },
    { "t": [23, 25], "ja": "全部いつも通りに戻ることだけなんだ" },
    { "t": [25, 26], "ja": "それはいいね" },
    { "t": [26, 27], "ja": "よし" },
    { "t": [27, 29], "ja": "確か、発表をする予定だったよね" },
    { "t": [29, 31], "ja": "はい、そうです。準備してきます" },
    { "t": [31, 33], "ja": "よし" },
    { "t": [33, 37], "ja": "いいか、みんな、冗談もコメントもなし、応援だけだ" },
    { "t": [37, 39], "ja": "彼にはたくさんの支えが必要だ" },
    { "t": [39, 40], "ja": "トム" },
    { "t": [40, 42], "ja": "男性用のブラみたいな支えね" },
    { "t": [42, 46], "ja": "よし、本当に今のが最後だ" },
    { "t": [46, 50], "ja": "さて、ご存じの通り、春の狩猟シーズンがやってきました" },
    { "t": [50, 56], "ja": "えー、とにかく、これが新しい許可証の制度の情報です" },
    { "t": [56, 57], "ja": "えっと…" },
    { "t": [57, 58], "ja": "ジェリー？" },
    { "t": [58, 60], "ja": "たぶん、その、パソコンの電源が入ってないと思う" },
    { "t": [60, 62], "ja": "すみません、みんな" },
    { "t": [62, 63], "ja": "電源を入れないと" },
    { "t": [63, 67], "ja": "まずは、シーズンについての私のグラフです" },
    { "t": [67, 68], "ja": "え？" },
    { "t": [68, 69], "ja": "ちょっと待って、違う" },
    { "t": [69, 70], "ja": "これはグラフじゃない" },
    { "t": [70, 72], "ja": "マンシーへ旅行した時の写真だ" },
    { "t": [72, 75], "ja": "旅行先に、インディアナ州のマンシーを選んだの？" },
    { "t": [75, 76], "ja": "ああ" },
    { "t": [76, 78], "ja": "妻と一緒に、向こうに共有の別荘があるんだ" },
    { "t": [78, 79], "ja": "マンシーに？" },
    { "t": [79, 82], "ja": "トム、マンシーはすてきな町だよ" },
    { "t": [82, 86], "ja": "とにかく、狩猟と釣りのシーズンはもうすぐ終わりです、いいね？" },
    { "t": [86, 89], "ja": "それに、もうマスは禁漁期になってます" },
    { "t": [89, 93], "ja": "それで…マスをちゃんと言えなかった" },
    { "t": [93, 95], "ja": "誰にでもあるよ" },
    { "t": [95, 98], "ja": "今日は口がうまく回らないな" },
    { "t": [98, 99], "ja": "あれ？" },
    { "t": [99, 100], "ja": "誰か私の眼鏡、見なかった？" },
    { "t": [100, 105], "ja": "これじゃ、たぶん…" },
    { "t": [105, 110], "ja": "あ" },
    { "t": [116, 117], "ja": "よく分からない" }
  ]
}
