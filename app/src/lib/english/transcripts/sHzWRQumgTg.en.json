{"video":"sHzWRQumgTg","lines":[{"t":[0,2.3],"en":"The stop is Martin Frior."},{"t":[5.6,6.2],"en":"What?"},{"t":[11.5,14.3],"en":"I made a bet with myself that you had beautiful eyes."},{"t":[15.1,17.4],"en":"Now that I see them, I win."},{"t":[20.5,21.1],"en":"What?"},{"t":[22.8,24.2],"en":"We're at my stop."},{"t":[25,26.2],"en":"But would you like to have coffee?"},{"t":[30,32],"en":"Are we really in Montreal?"},{"t":[32.7,33.7],"en":"Yes, we are."},{"t":[34.7,35.4],"en":"So, coffee?"},{"t":[37.8,39.2],"en":"Coffee sounds great."},{"t":[41.8,43],"en":"Wait, so..."},{"t":[43,45.3],"en":"So you live in Montreal?"},{"t":[45.8,48.5],"en":"Oh, no, but it's just a two-hour ferry ride to Nova Scotia."},{"t":[60,90],"en":"Transcription by CastingWords"}]}
