  "lines": [
    { "t": [0.2, 0.9], "ja": "聞いて" },
    { "t": [1.4, 2.2], "ja": "仕事が決まったの？" },
    { "t": [2.4, 3.2], "ja": "冗談でしょ？" },
    { "t": [3.5, 4.8], "ja": "私にできる仕事なんて何もないのよ" },
    { "t": [6.9, 8.9], "ja": "今日は12回の面接で笑いものにされたわ" },
    { "t": [9.3, 10.8], "ja": "なのに、意外と元気だね" },
    { "t": [11.1, 15.8], "ja": "まあ、ジョーン＆デイビッドのブーツが半額セールだったら、あなたたちも元気になるわよ" },
    { "t": [16.7, 18.3], "ja": "さすが、よく分かってるわね" },
    { "t": [19.9, 24.1], "ja": "これは私の新しい「仕事もいらない、親もいらない、すてきなブーツがあるもの」ブーツなの" },
    { "t": [26.1, 27.2], "ja": "どうやって払ったの？" },
    { "t": [27.9, 28.6], "ja": "クレジットカード" },
    { "t": [28.6, 30.3], "ja": "で、そのカードは誰が払うの？" },
    { "t": [31.6, 32.9], "ja": "えっと、パパ" },
    { "t": [35.9, 38.1], "ja": "ねえ、一生親に頼って生きるわけにはいかないよ" },
    { "t": [38.2, 39.2], "ja": "分かってる" },
    { "t": [39.4, 40.7], "ja": "だから結婚しようとしてたのよ" },
    { "t": [42.3, 45.2], "ja": "大目に見てあげなよ。初めて一人で生きるのは大変なんだから" },
    { "t": [45.8, 46.5], "ja": "ありがとう" },
    { "t": [46.7, 47.1], "ja": "どういたしまして" },
    { "t": [47.5, 49.8], "ja": "私が初めてこの町に来た時、14歳だったの" },
    { "t": [50.3, 52.9], "ja": "ママが自殺したばかりで、継父はまた刑務所に戻ってた" },
    { "t": [53.4, 55.2], "ja": "ここに来た時、知り合いは誰もいなかった" },
    { "t": [55.2, 60.1], "ja": "結局、バスターミナルの外で車の窓ふきをしてた、アルビノの男の人と住むことになったの" },
    { "t": [60.3, 61.7], "ja": "それから、その人も自殺しちゃった" },
    { "t": [63.4, 64.7], "ja": "それで私、アロマテラピーに出会ったの" },
    { "t": [65.5, 67.5], "ja": "だから、本当にあなたの気持ちはよく分かる" },
    { "t": [71.4, 75.4], "ja": "こういう時は「とにかく」って言うのよ" },
    { "t": [80, 81.5], "ja": "よし、準備はいい？" },
    { "t": [81.7, 82.6], "ja": "無理だと思う" },
    { "t": [82.6, 83.4], "ja": "ほら、いいから" },
    { "t": [83.9, 89.8], "ja": "切って、切って、切って、切って、切って、切って、切って、切って" },
    { "t": [89.8, 90.2], "ja": "やった！" },
    { "t": [92.9, 94.5], "ja": "現実の世界へようこそ" },
    { "t": [94.9, 95.6], "ja": "最悪だよ" },
    { "t": [95.9, 96.5], "ja": "きっと気に入るよ" },
    { "t": [98.5, 100.4], "ja": "信じられない、こんなこと聞くなんて" },
    { "t": [100.4, 102.2], "ja": "信じられない、こんなこと聞くなんて" },
    { "t": [102.2, 102.5], "ja": "何？" },
    { "t": [102.6, 103.4], "ja": "あなたが…って言ったの" },
    { "t": [103.4, 103.5], "ja": "何？" },
    { "t": [103.6, 104.6], "ja": "あなたが…って言ったの" },
    { "t": [104.6, 106.3], "ja": "やめてくれない？" },
    { "t": [107.2, 108.2], "ja": "あら、また歌ってた？" },
    { "t": [108.3, 108.6], "ja": "うん" },
    { "t": [110.7, 112.2], "ja": "コーヒーのおかわりがほしい人いる？" },
    { "t": [114.8, 116.9], "ja": "それ、君がいれたの？それとも運んでるだけ？" },
    { "t": [117.6, 118.5], "ja": "運んでるだけ" },
    { "t": [118.5, 119.5], "ja": "じゃあ、1杯もらうよ" },
