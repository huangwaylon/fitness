    { "t": [0,1.3], "ja": "何を言ってないっていうの？" },
    { "t": [1.9,3.1], "ja": "さあね" },
    { "t": [3.5,6.7], "ja": "えっと、たとえば、外の電柱に引っかかってる下着が" },
    { "t": [6.7,8.3], "ja": "あなたのだってこととか" },
    { "t": [8.3,10.9], "ja": "テラスでファン・ボビーとエッチしてた時のね" },
    { "t": [11.2,11.5], "ja": "何？" },
    { "t": [12.5,14.4], "ja": "ちょっと、ちょっと、誰に聞いたの？" },
    { "t": [18.7,20.4], "ja": "ただじゃおかないから" },
    { "t": [20.9,22.5], "ja": "そんなに大きな秘密だとは知らなかったんだ" },
    { "t": [23.5,25.7], "ja": "ううん、大したことじゃない　全然ね" },
    { "t": [26.1,28.6], "ja": "そうね、たとえば、うーん、何だろう" },
    { "t": [28.6,29.7], "ja": "乳首が3つあるのと同じくらいかな" },
    { "t": [30,30.4], "ja": "何？" },
    { "t": [32.3,33.7], "ja": "乳首が3つあるの？" },
    { "t": [36.7,38.1], "ja": "ひどいやつ" },
    { "t": [41.4,42.6], "ja": "見せろ、見せろ" },
    { "t": [42.7,43], "ja": "そうだ、そうだ" },
    { "t": [43.2,45.4], "ja": "やめろよ　見るものなんて何もないって" },
    { "t": [45.5,47.6], "ja": "ただの小さなでっぱりだよ　何の役にも立たない" },
    { "t": [48,50.3], "ja": "へえ、ほかの乳首はいろいろ役に立つみたいね" },
    { "t": [52.4,54], "ja": "信じられないよ" },
    { "t": [54.4,55.8], "ja": "こぶだって言ってたじゃないか" },
    { "t": [57.9,59.8], "ja": "ジョーイ、こぶって何だと思ってたの？" },
    { "t": [59.8,61.4], "ja": "分からないよ" },
    { "t": [61.4,62.8], "ja": "何か見て、言葉を聞いたら、そういうものかなって" },
