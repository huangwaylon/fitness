{
  "video": "iahcJPo9Dwg",
  "lines": [
    { "t": [0,9.9], "ja": "えっと、うん、友だちの家に泊まって" },
    { "t": [9.9,12.6], "ja": "コンタクトの保存液を忘れちゃったの" },
    { "t": [12.6,15.5], "ja": "だから予備のメガネをかけるしかなくて" },
    { "t": [17.6,19.2], "ja": "やめてよ" },
    { "t": [19.2,21], "ja": "よし、みんな" },
    { "t": [21,23.6], "ja": "うわ、パム" },
    { "t": [23.6,25.2], "ja": "そのメガネ、すごくブサイクに見えるぞ" },
    { "t": [25.2,28.5], "ja": "あのね、パム、かわいくなりたいならメガネは外すものだ" },
    { "t": [28.5,30.5], "ja": "逆の方向に進んでるぞ" },
    { "t": [30.5,34.2], "ja": "コンタクトがないんです　悪いけど、何も聞こえないな" },
    { "t": [34.2,36.9], "ja": "ブサイクな科学者から雑音が出てるだけだ" },
    { "t": [36.9,39.8], "ja": "えー、みんな、ちょっと" },
    { "t": [39.8,42.1], "ja": "会議室でブレインストーミングをするぞ" },
    { "t": [42.1,44.8], "ja": "元気を出そう！" },
    { "t": [44.8,47.4], "ja": "僕が元気になる方法、知ってる？" },
    { "t": [47.4,50.1], "ja": "もし君が、パメラ・モーガン・ビーズリーが…" },
    { "t": [50.1,51.4], "ja": "やめてよ　…もし" },
    { "t": [51.4,53], "ja": "マイケルの会議中にプロポーズなんてしたら" },
    { "t": [53,53.8], "ja": "断るからね" },
    { "t": [53.8,56.3], "ja": "もう遅いよ、だって僕がお願いするのは" },
    { "t": [56.3,58], "ja": "コーヒーを1杯入れてくれることだから" },
    { "t": [58,59.5], "ja": "そしたら僕はすごく元気になって" },
    { "t": [59.5,61.4], "ja": "世界一幸せな男になれるよ" },
    { "t": [61.4,66], "ja": "みんな、どうやってこのオフィスを元気にする？" },
    { "t": [66,68.6], "ja": "だって、クリスマスから何もしてないし" },
    { "t": [68.6,72.1], "ja": "パムはもう明らかにあきらめちゃってるし" },
    { "t": [72.1,74.4], "ja": "だから、物事を動かさなきゃいけない" },
    { "t": [74.4,75.8], "ja": "少しずつ盛り上げていかなきゃ" },
    { "t": [75.8,78.7], "ja": "何かいいアイデアがある人は？" },
    { "t": [78.7,79.9], "ja": "何か提案は？" },
    { "t": [79.9,80.8], "ja": "はい、アンディ" },
    { "t": [80.8,84.7], "ja": "留守電の応答メッセージを変えて" },
    { "t": [84.7,88.8], "ja": "もう少し元気で、勢いのあるものにしたらどうですか？" },
    { "t": [88.8,89.3], "ja": "元気と勢い" },
    { "t": [89.3,91.2], "ja": "ほら、それだよ…　そういう言葉を探してたんだ" },
    { "t": [91.2,92], "ja": "はい、ジム" },
    { "t": [92,95], "ja": "それよりさらに新しい留守電メッセージにして" },
    { "t": [95,97], "ja": "もっともっと元気と勢いを出したらどうでしょう？" },
    { "t": [97,98.2], "ja": "いい感じになってきた" },
    { "t": [98.2,99], "ja": "これはいいな" },
    { "t": [99,101.6], "ja": "テーマを決めてもいいかもな、ラップとか、ラップの韻とか" },
    { "t": [101.6,102.2], "ja": "都会っぽいやつ" },
    { "t": [102.2,103], "ja": "都会っぽい、そうだ" },
    { "t": [103,105.6], "ja": "スタンリー、手伝ってくれるか？" },
    { "t": [105.6,107.1], "ja": "スタンリー、おーい、スタンリー" },
    { "t": [107.1,108], "ja": "私は無理" },
    { "t": [108,108.6], "ja": "いや、君だよ" },
    { "t": [108.6,110.9], "ja": "ほら、スタンリー、そのちっちゃいゲームは置いて" },
    { "t": [110.9,112.3], "ja": "みんなに加わってくれ" },
    { "t": [112.3,113.1], "ja": "いやだ" },
    { "t": [113.1,114.4], "ja": "スタンリー、今ちょっと…" },
    { "t": [114.4,115.4], "ja": "ほっといてくれ、まったく" },
    { "t": [115.4,117.4], "ja": "ブレインストーミング中なんだよ" },
    { "t": [117.4,118.7], "ja": "聞こえなかったのか？" },
    { "t": [125.5,125.9], "ja": "よし" },
    { "t": [125.9,126.5], "ja": "いいね" }
  ]
}
