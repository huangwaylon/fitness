{
  "video": "yRXDKvoPsyY",
  "lines": [
    { "t": [0,  4.2], "ja": "おお！ 顔に命中！" },
    { "t": [4.2,  7.5], "ja": "ジョーズのことは残念だったな、坊主" },
    { "t": [7.5,  9.3], "ja": "すごく無力な気分" },
    { "t": [9.3,  11.8], "ja": "物事が好転し始めたと思ったら、崩れていくんだから" },
    { "t": [11.8,  15], "ja": "今なら、真珠湾のあとのルーズベルトの気持ちがよく分かる" },
    { "t": [15,  16.8], "ja": "ねえ、みんなここまで乗り越えてきたじゃない" },
    { "t": [16.8,  18.8], "ja": "これで今夜を台無しにしないで" },
    { "t": [18.8,  21], "ja": "楽しもうよ。ハロウィンだよ。ハロウィン大好きでしょ" },
    { "t": [21,  23.8], "ja": "ねえ、元気が出ることを思いついた" },
    { "t": [23.8,  27], "ja": "トイレの外でトムを待ち伏せして、驚かそう" },
    { "t": [27,  28.8], "ja": "それなら元気が出るわ" },
    { "t": [28.8,  30.8], "ja": "うん" },
    { "t": [30.8,  32.8], "ja": "よし" },
    { "t": [32.8,  34.8], "ja": "いくよ…" },
    { "t": [34.8,  35.8], "ja": "わっ！" },
    { "t": [35.8,  37.8], "ja": "いやっ！" },
    { "t": [37.8,  41.8], "ja": "ジェリー！ もう、気持ち悪い" },
    { "t": [41.8,  42.8], "ja": "ああ" },
    { "t": [42.8,  44.8], "ja": "ジェリー！" },
    { "t": [44.8,  45.8], "ja": "みんな、僕…" },
    { "t": [45.8,  48.8], "ja": "うそ。ああ、心臓発作かもしれない" },
    { "t": [48.8,  50.8], "ja": "何？ 本気で？" },
    { "t": [50.8,  51.8], "ja": "ああ、今いろんなことが起きすぎてる" },
    { "t": [51.8,  52.8], "ja": "911に電話して" },
    { "t": [52.8,  53.8], "ja": "分かった" },
    { "t": [53.8,  55.8], "ja": "とにかく息をして、いい？ 大丈夫だから" },
    { "t": [55.8,  57.5], "ja": "うわ、今、恐竜がおならした？" },
    { "t": [57.5,  58.5], "ja": "ジェリー、しっかりしろ" },
    { "t": [58.5,  59.5], "ja": "ごめん、みんな" },
    { "t": [59.5,  60.5], "ja": "くそっ！" },
    { "t": [60.5,  61.5], "ja": "謝っても許さない" },
    { "t": [61.5,  63.5], "ja": "しゃべるな、まぬけ" },
    { "t": [63.5,  64.5], "ja": "においを感じなくなりたい" },
    { "t": [64.5,  65.5], "ja": "おい！" },
    { "t": [65.5,  67.5], "ja": "本気でさ、ジェリー、昼におならでも食べたの？" },
    { "t": [67.5,  68.5], "ja": "トム！" },
    { "t": [68.5,  69.5], "ja": "ジェリーが心臓発作なの！" },
    { "t": [69.5,  70.5], "ja": "あ、それは知らなかった" },
    { "t": [70.5,  71.5], "ja": "ジェリー、大丈夫？" },
    { "t": [71.5,  72.5], "ja": "ジェリー、大丈夫？" },
    { "t": [72.5,  80.5], "ja": "はい、雑誌と、あなたが好きな退屈な単語パズルを持ってきたよ" },
    { "t": [80.5,  81.5], "ja": "他に何か要る、ジェイ？" },
    { "t": [81.5,  82.5], "ja": "おなら止めの薬とか？" },
    { "t": [82.5,  83.5], "ja": "はいはい、トム" },
    { "t": [83.5,  84.5], "ja": "彼の具合はどう、アン？" },
    { "t": [84.5,  85.5], "ja": "はっきり言って" },
    { "t": [85.5,  86.5], "ja": "元気よ" },
    { "t": [86.5,  88.5], "ja": "1日か2日で退院できるはず" },
    { "t": [88.5,  90.5], "ja": "先生、医学的に言うと、ジェリーに起きたことはどう表現しますか？" },
    { "t": [90.5,  91.5], "ja": "軽い心臓発作です" },
    { "t": [91.5,  97.5], "ja": "ええ、でも彼は、おならもすごく出してましたよね" },
    { "t": [97.5,  101.5], "ja": "大量のガスを出しながら心臓発作を起こすことに、何か呼び名はあります？" },
    { "t": [101.5,  102.5], "ja": "特には" },
    { "t": [102.5,  105.5], "ja": "心臓の発作中に、胃腸が苦しくなるのはよくあることです" },
    { "t": [105.5,  108.5], "ja": "先生に、ジェリーは「おなら発作」だったって言ってほしいだけなの" },
    { "t": [108.5,  109.5], "ja": "それって無理なお願い？" },
    { "t": [109.5,  110.5], "ja": "本当にありがとう" },
    { "t": [110.5,  113.5], "ja": "風船も花も食べ物も、こんなに" },
    { "t": [113.5,  116.5], "ja": "それに、まあ、こんなによくお見舞いに来てくれるなんて優しいね" },
    { "t": [116.5,  118.5], "ja": "まあ、原因は彼らだからな" },
    { "t": [118.5,  119.5], "ja": "ちょっと" },
    { "t": [119.5,  120.5], "ja": "いや、いいんだ" },
    { "t": [120.5,  121.5], "ja": "こうなってよかったよ" },
    { "t": [121.5,  125.5], "ja": "つまり、まあ、莫大な入院費はないほうがいいけど、いや、これで目が覚めた" },
    { "t": [125.5,  126.5], "ja": "生活を変えるよ" },
    { "t": [126.5,  129.5], "ja": "ゲイルと娘たちと、少なくともあと30年は一緒にいたいんだ" },
    { "t": [129.5,  131.5], "ja": "心配しないで、ジェリー、いい？" },
    { "t": [131.5,  134.5], "ja": "あなたはずっと思い描いてきた未来を手に入れられる" },
    { "t": [134.5,  135.5], "ja": "私たちに任せて" }
  ]
}
