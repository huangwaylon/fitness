{
  "video": "HxOryxpZAng",
  "lines": [
    { "t": [0,  2], "ja": "ジム、パム" },
    { "t": [2,  6], "ja": "そして、神の最高のすべてが詰まった大切な赤ちゃん" },
    { "t": [6,  8], "ja": "お二人とも、よい一日を" },
    { "t": [8,  10], "ja": "そちらこそ。ええ、神に感謝を" },
    { "t": [10,  13], "ja": "はい。今日はセシの洗礼式なんです" },
    { "t": [13,  16], "ja": "大事な日です。職場のみんなが来てる" },
    { "t": [16,  18], "ja": "呼ぶつもりはなかったけどね。全然" },
    { "t": [18,  20], "ja": "日曜の朝、ごきげんよう" },
    { "t": [20,  22], "ja": "あなたにも、ごきげんよう" },
    { "t": [22,  23], "ja": "パイプは持ってきたかい" },
    { "t": [23,  25], "ja": "これから大衆のアヘンを吸うところだからな" },
    { "t": [25,  27], "ja": "ああ、そうさ。ドゥビドゥビドゥー" },
    { "t": [27,  30], "ja": "職場のみんなを招待したんだ" },
    { "t": [30,  35], "ja": "だって今日は、ジムやパムだけの日じゃない" },
    { "t": [35,  37], "ja": "赤ちゃんや僕だけの日でもない" },
    { "t": [37,  39], "ja": "みんなの日なんだ" },
    { "t": [39,  43], "ja": "だから、みんなで祝うべきだと思ったんだ、僕の喜びを" },
    { "t": [43,  45], "ja": "それと、みんなの喜びもね" },
    { "t": [45,  47], "ja": "いやあ、まいった" },
    { "t": [50,  52], "ja": "ナード・ドッグは子犬が欲しいかって？" },
    { "t": [52,  54], "ja": "ああ、ナードの子犬をたくさん欲しいね" },
    { "t": [54,  56], "ja": "みんな跳ね回って、お乳を吸って" },
    { "t": [56,  58], "ja": "箱に入れて、近所の人にあげるんだ" },
    { "t": [58,  59], "ja": "私はいいわ" },
    { "t": [59,  60], "ja": "ああ、子どもは欲しいよ" },
    { "t": [69,  71], "ja": "日曜の礼拝か" },
    { "t": [71,  72], "ja": "何年ぶりかな" },
    { "t": [72,  75], "ja": "神様とは、積もる話があるんだ" },
    { "t": [77,  78], "ja": "やあ！" },
    { "t": [78,  79], "ja": "やあ！" },
    { "t": [79,  82], "ja": "断れない申し出があるんだが" },
    { "t": [82,  83], "ja": "詰めてくれ！" },
    { "t": [83,  85], "ja": "あ、マイケル、ここは家族席なの" },
    { "t": [85,  86], "ja": "でも、私はゴッドファーザーだぞ！" },
    { "t": [86,  88], "ja": "すごく面白いけど、ほら、紛らわしいでしょ" },
    { "t": [88,  91], "ja": "洗礼式だと。だって、あなたは代父じゃないから" },
    { "t": [91,  93], "ja": "俺に言ってるのか？" },
    { "t": [93,  94], "ja": "はい、あなたの番" },
    { "t": [94,  97], "ja": "詰めろ、頭を撃ち抜かれる前にな！" },
    { "t": [97,  98], "ja": "分かったよ、マイケル" },
    { "t": [98,  101], "ja": "えっと、その声まね、大好きなのは知ってるよね" },
    { "t": [101,  104], "ja": "でも今日は、本当にごめん" },
    { "t": [104,  108], "ja": "あなたがセシの代父じゃないって分かってる、って言ってほしいの" },
    { "t": [108,  109], "ja": "うん！" },
    { "t": [110,  111], "ja": "ごめんね、マイケル" },
    { "t": [111,  112], "ja": "言ってほしいの" },
    { "t": [112,  113], "ja": "本当にごめん" },
    { "t": [115,  117], "ja": "僕は代父じゃない" },
    { "t": [117,  118], "ja": "よし" },
    { "t": [118,  119], "ja": "ありがとう" },
    { "t": [119,  120], "ja": "じゃあ、代父は誰なんだ？" },
    { "t": [120,  122], "ja": "友だちのセス" },
    { "t": [122,  123], "ja": "それと、あそこにいる奥さん" },
    { "t": [123,  124], "ja": "うん" },
    { "t": [124,  125], "ja": "そうか" },
    { "t": [126,  127], "ja": "昔からの友だち？" },
    { "t": [127,  129], "ja": "ほら、幼稚園からとか？" },
    { "t": [129,  130], "ja": "ううん" },
    { "t": [130,  132], "ja": "奥さんとは、親子教室で知り合ったの" },
    { "t": [132,  133], "ja": "素敵な夫婦なのよ" },
    { "t": [133,  134], "ja": "後で会ってみて" },
    { "t": [134,  135], "ja": "いや、いいよ" },
    { "t": [135,  137], "ja": "友だちは十分いるから…" },
    { "t": [137,  138], "ja": "分かった" },
    { "t": [138,  139], "ja": "まあ、いい席だから" },
    { "t": [139,  140], "ja": "楽しんでね" },
    { "t": [140,  141], "ja": "そうか" },
    { "t": [141,  142], "ja": "来てくれてありがとう、マイケル" },
    { "t": [142,  143], "ja": "どう言えばいいかも分からないが" },
    { "t": [143,  148], "ja": "セシはちょっと「ア・バ・ズ・レ」になりつつある" },
    { "t": [148,  150], "ja": "いや、それは本当じゃない" },
    { "t": [150,  154], "ja": "でも、両親がなんだか僕を締め出してるんだ" },
    { "t": [167,  169], "ja": "なんて素晴らしい日でしょう" },
    { "t": [169,  171], "ja": "イーグルスの試合があるからだけではありません" },
    { "t": [171,  174], "ja": "表のバスを見た方もいるでしょう" },
    { "t": [174,  177], "ja": "今日は、青年会の皆さんとのお別れの日でもあります" },
    { "t": [177,  182], "ja": "メキシコのカボ・コリエンテスにある村に学校を建てるため、3か月間出発します" },
    { "t": [182,  184], "ja": "その場所、聞いたことある" },
    { "t": [184,  188], "ja": "カボ・サン・ルーカスに行けば、売春婦はみんなカボ・コリエンテス出身だよ" },
    { "t": [191,  219.6], "ja": "はい、これは…よし、ばかげてる。だめ、だめ、だめ、だめ、だめ、だめ、だめ、だめ、だめ" }
  ]
}
