{
  "video": "73u88Fka8k4",
  "lines": [
    { "t": [1,  5], "ja": "記録破りの年月を経て、ダンダー・ミフリンを辞めた" },
    { "t": [5,  7], "ja": "そして、正式に求職中だ" },
    { "t": [7,  9], "ja": "とてもワクワクしている" },
    { "t": [9,  11], "ja": "分かりやすいように、3つに分けておいた" },
    { "t": [11,  13], "ja": "仕事の履歴書" },
    { "t": [13,  15], "ja": "運動と特技の履歴書" },
    { "t": [15,  18], "ja": "そして、ドワイト・シュルートの豆知識" },
    { "t": [18,  20], "ja": "どんな挑戦にも立ち向かう準備はできている" },
    { "t": [20,  22], "ja": "私に挑むほど愚かな挑戦ならな" },
    { "t": [22,  23], "ja": "自分をどう表現するか？" },
    { "t": [23,  24], "ja": "3つの言葉で" },
    { "t": [24,  25], "ja": "働き者" },
    { "t": [25,  27], "ja": "ボス気質" },
    { "t": [27,  29], "ja": "削岩機" },
    { "t": [30,  31], "ja": "容赦なし" },
    { "t": [31,  33], "ja": "飽くなき欲求" },
    { "t": [33,  35], "ja": "私の行く手には、すべてしかない" },
    { "t": [35,  37], "ja": "すべてが私の行く手にある" },
    { "t": [37,  39], "ja": "この仕事に就いたのは、お金を稼ぐためだ" },
    { "t": [39,  41], "ja": "就職活動を続ける間のね" },
    { "t": [41,  43], "ja": "それと、えー…" },
    { "t": [43,  45], "ja": "当面はこれでいい" },
    { "t": [45,  46], "ja": "おっと" },
    { "t": [46,  47], "ja": "休憩は終わりだ" }
  ]
}
