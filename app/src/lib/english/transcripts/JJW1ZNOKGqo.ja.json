{
  "video": "JJW1ZNOKGqo",
  "lines": [
    { "t": [0, 3.7], "ja": "はい、みんな、1時間から7時間くらいオフィスにいるわね" },
    { "t": [3.7, 5.3], "ja": "毎週のアンとのおしゃべりよ" },
    { "t": [5.3, 6.7], "ja": "新鮮なおやつを持ってきたし" },
    { "t": [6.8, 9.3], "ja": "出店の配置図の予備の案も作っておいたわ" },
    { "t": [9.3, 11], "ja": "ほら、あなたたちのがよくなかったときのためにね" },
    { "t": [11.4, 12.8], "ja": "実は、トイレに行ってる間にアンから電話があったの" },
    { "t": [13.2, 15], "ja": "急用ができたって。あとで電話するってさ" },
    { "t": [15.1, 16.1], "ja": "よく知らないけど。留守電に入れてって言っておいた" },
    { "t": [16.2, 17.9], "ja": "もう、なんであんなこと全部言わせたの？" },
    { "t": [18.1, 19.7], "ja": "今行くわよ、留守電。今行く！" },
    { "t": [20.4, 22.2], "ja": "よく聞いて" },
    { "t": [22.3, 23.9], "ja": "私はさらわれてない" },
    { "t": [24.3, 26.3], "ja": "私がつかまらないと、真っ先にそれを心配するのはわかってる" },
    { "t": [26.3, 29.1], "ja": "でも、これはリーアム・ニーソンの「96時間」みたいな状況じゃないの" },
    { "t": [29.1, 30.4], "ja": "それこそ、犯人が言わせそうなセリフね" },
    { "t": [30.4, 32.3], "ja": "それに、誰にも言わされてないから" },
    { "t": [32.4, 35.9], "ja": "私は自由な女。さらわれてもいないし、ただ自分の用事をしてるだけ" },
    { "t": [36, 37.6], "ja": "ちょっと急がなきゃいけないの。急用ができて" },
    { "t": [37.8, 38.9], "ja": "愛してる。あとで電話するね" },
    { "t": [40.7, 43], "ja": "ドナ？ ねえ、調子どう？" },
    { "t": [43.4, 45.3], "ja": "ドナ町では何が起きてる？" },
    { "t": [45.8, 47.4], "ja": "ミーグル村のニュースは？" },
    { "t": [47.9, 49.5], "ja": "「ジャリール・オア・ノー・ディール」を聞いてるの" },
    { "t": [49.8, 51.3], "ja": "アーケルを演じてた子が" },
    { "t": [51.3, 53.1], "ja": "昔の「ディール・オア・ノー・ディール」を批評するポッドキャストよ" },
    { "t": [53.5, 54.6], "ja": "意味はないけど大好き" },
    { "t": [54.6, 55.7], "ja": "わかった、邪魔しないわ" },
    { "t": [56.1, 57.8], "ja": "エイプリル、最新情報は、お嬢ちゃん？" },
    { "t": [57.9, 59.9], "ja": "アツいうわさは？最近、誰に夢中なの？" },
    { "t": [59.9, 61.6], "ja": "うわ、夫よ、変な人" },
    { "t": [62.1, 63.8], "ja": "もう仕事に戻っていい？ありがと。じゃあね" },
    { "t": [64.9, 67.8], "ja": "仕事？仕事なんていつでもできるわ、今以外はね" },
    { "t": [68.1, 70.5], "ja": "だって今は女子の時間なんだから" },
    { "t": [70.6, 71.9], "ja": "生理用品のコマーシャルみたい" },
    { "t": [72.2, 74.5], "ja": "急きょ、ギャレンタインデーを開くことにしたの" },
    { "t": [75, 75.4], "ja": "本当？" },
    { "t": [75.6, 75.9], "ja": "ええ" },
    { "t": [76.2, 78.4], "ja": "待って、今年はギャレンタインデーはやらないと思ってた" },
    { "t": [78.4, 80.3], "ja": "あの悪魔みたいな女が引っ越しちゃったから" },
    { "t": [80.5, 82.6], "ja": "名前はたしかサタンだったわね" },
    { "t": [82.9, 84.7], "ja": "アンよ。彼女はいなくなったけど" },
    { "t": [84.8, 85.9], "ja": "もう受け入れたの" },
    { "t": [86, 87.5], "ja": "だからギャレンタインデーをやるのよ" },
    { "t": [87.8, 88.4], "ja": "女子は前へ" },
    { "t": [89.3, 91.1], "ja": "ポーニーに住んでるアンが必要なの" },
    { "t": [91.2, 93.1], "ja": "でも、はっきりした候補はいない" },
    { "t": [93.3, 95], "ja": "だから試してみるつもり" },
    { "t": [95, 97.6], "ja": "女の友情の究極の戦場でね" },
    { "t": [98.4, 99.6], "ja": "ギャレンタインデーのブランチよ" },
    { "t": [99.8, 102.7], "ja": "女性だけの長時間の絆づくり会で" },
    { "t": [102.7, 103.8], "ja": "ホイップクリームがたっぷり" },
    { "t": [104.6, 106.7], "ja": "ちなみに、この言葉はネットで検索しないでね" },
    { "t": [108, 109.6], "ja": "シャウナ、来てくれてうれしいわ" },
    { "t": [109.7, 110.5], "ja": "すごく日焼けしてる" },
    { "t": [110.7, 111.3], "ja": "あ、ありがとう" },
    { "t": [111.5, 113.5], "ja": "ローマへの一人旅から帰ってきたばかりなの" },
    { "t": [113.8, 115], "ja": "彼氏と行くつもりだったんだけど" },
    { "t": [115.3, 116.2], "ja": "彼は来られなくて" },
    { "t": [116.2, 118.9], "ja": "奥さんと一緒にいることにしたから" },
    { "t": [119.2, 119.5], "ja": "うわ" },
    { "t": [120.1, 121.1], "ja": "ローマ大好き" },
    { "t": [121.4, 122.9], "ja": "本当にいいところよね" },
    { "t": [123.1, 123.8], "ja": "ローマなんてもう古いわ" },
    { "t": [124.4, 125.7], "ja": "みんな、クアラルンプールに行ったことある？" },
    { "t": [126.1, 127.4], "ja": "いつアジアに行ったの？" },
    { "t": [127.5, 128.4], "ja": "しょっちゅう行ってるわ" },
    { "t": [128.5, 130], "ja": "あのクリスタルの仏像の頭、どこで手に入れたと思う？" },
    { "t": [130, 130.8], "ja": "うちのジャグジーの上にあるやつよ" },
    { "t": [131, 131.7], "ja": "ジャグジーがあるの？" },
    { "t": [131.9, 132.4], "ja": "いいこと聞いた" },
    { "t": [133.1, 134.9], "ja": "ポーニーの新しい親友候補" },
    { "t": [135.2, 137], "ja": "ドナ・ミーグル。自信があって、世慣れてる" },
    { "t": [137.2, 138], "ja": "昔からの付き合い" },
    { "t": [138.1, 139.7], "ja": "エイプリル・ラドゲート。想像力が豊か" },
    { "t": [140, 140.8], "ja": "若くて元気" },
    { "t": [141.3, 143], "ja": "シャウナ・マルウェイ・トゥイープ。きれいで、もろくて" },
    { "t": [143.2, 144.2], "ja": "人生の選択がひどい" },
    { "t": [144.3, 145.1], "ja": "かなり手直しが必要" },
    { "t": [145.2, 147.2], "ja": "でも、アンだって出会ったときは" },
    { "t": [147.2, 147.7], "ja": "そんなに調子よくなかったし" },
    { "t": [148.1, 149.7], "ja": "エセル・ビーバーズ。ちょっと未知数" },
    { "t": [149.8, 151.3], "ja": "気難しいけど、たぶん賢い" },
    { "t": [151.8, 152.9], "ja": "それからエブリン" },
    { "t": [153.3, 154.3], "ja": "またの名を「にせアン」" },
    { "t": [154.7, 155.5], "ja": "名字は知らない" },
    { "t": [155.6, 156.7], "ja": "正直、人数合わせよ" },
    { "t": [157.2, 158.7], "ja": "みなさん、急な呼びかけにもかかわらず" },
    { "t": [158.7, 159.6], "ja": "集まってくれてありがとう" },
    { "t": [159.6, 161.3], "ja": "ハッピー・ギャレンタインデー" },
    { "t": [161.9, 163.6], "ja": "厳密に言うと" },
    { "t": [163.6, 164.6], "ja": "今日は正しい日付じゃないけど" },
    { "t": [164.7, 166.1], "ja": "女性たちが集まって" },
    { "t": [166.1, 167], "ja": "ブランチをするときはいつでも" },
    { "t": [167.4, 169.2], "ja": "この祝日の精神を体現してるの" },
    { "t": [169.7, 171.1], "ja": "今日は友情を祝って" },
    { "t": [171.4, 172.5], "ja": "何時間か一緒に過ごして" },
    { "t": [172.6, 174.1], "ja": "私がまとめた質問に" },
    { "t": [174.1, 174.7], "ja": "いくつか答えてもらうわ" },
    { "t": [175.1, 176.6], "ja": "ただのお遊びよ、真剣なものじゃないわ" },
    { "t": [176.9, 177.9], "ja": "でも答えるときは" },
    { "t": [177.9, 178.7], "ja": "正直にね" },
    { "t": [178.7, 179.5], "ja": "わかるから" },
    { "t": [179.5, 180], "ja": "うそをついたらね" },
    { "t": [180.3, 180.9], "ja": "女友だちに乾杯！" },
    { "t": [181.4, 181.8], "ja": "イエー！" },
    { "t": [181.8, 184.4], "ja": "はい、それでは" },
    { "t": [184.4, 186.5], "ja": "ギャレンタインデーの質問コーナーよ" },
    { "t": [186.8, 187.8], "ja": "ドナ、最初に引いて" },
    { "t": [189.2, 191.2], "ja": "好きなテレビ番組は？" },
    { "t": [192.4, 193.5], "ja": "そうね、実況しながら見るなら" },
    { "t": [193.8, 194.3], "ja": "「スキャンダル」" },
    { "t": [194.7, 196.2], "ja": "一気に見るなら" },
    { "t": [196.5, 197.1], "ja": "「スキャンダル」" },
    { "t": [197.4, 198.3], "ja": "でもファッションなら" },
    { "t": [198.8, 199.7], "ja": "実は「スキャンダル」" },
    { "t": [199.9, 200.7], "ja": "私の答えは「スキャンダル」" },
    { "t": [201.1, 201.4], "ja": "ふーん" },
    { "t": [201.7, 202], "ja": "エイプリル？" },
    { "t": [202.5, 204.5], "ja": "うーん、見るのが好きなのは" },
    { "t": [204.5, 205.9], "ja": "ロシアの交通事故の動画" },
    { "t": [205.9, 206.6], "ja": "ネットでね" },
    { "t": [206.6, 208.5], "ja": "子ども向けの音楽を" },
    { "t": [208.5, 209.3], "ja": "間違った回転数でかけながら" },
    { "t": [209.7, 210.8], "ja": "私は美人コンテストが好き" },
    { "t": [211.1, 213.3], "ja": "みんなすごく幸せで完璧だから" },
    { "t": [213.6, 216], "ja": "私は「ダイアグノーシス・マーダー」と" },
    { "t": [216, 218], "ja": "エッチな映画が好き" },
    { "t": [218.3, 220.2], "ja": "誰か私に注いでくれる？" },
    { "t": [220.4, 221.3], "ja": "好きなテレビ番組の" },
    { "t": [221.3, 222.6], "ja": "正解は" },
    { "t": [222.6, 224.3], "ja": "「フライデー・ナイト・ライツ」よ" },
    { "t": [224.5, 225.5], "ja": "正解？" },
    { "t": [225.7, 226.4], "ja": "次の質問" },
    { "t": [228.3, 229.1], "ja": "女性が選ぶ" },
    { "t": [229.3, 230.4], "ja": "あら、何でもありの質問ね" },
    { "t": [230.5, 231.3], "ja": "はい、誰か何でもいいから" },
    { "t": [231.3, 232.1], "ja": "自分の人生について" },
    { "t": [232.1, 232.7], "ja": "打ち明けてくれる？" },
    { "t": [232.8, 233.8], "ja": "私は婚姻の取り消しを2回してるわ" },
    { "t": [234.7, 235.9], "ja": "1回は楽しみのため" },
    { "t": [235.9, 238.2], "ja": "もう1回は長い詐欺の仕上げのため" },
    { "t": [238.2, 239.6], "ja": "キース・スウェットと張り合ってたの" },
    { "t": [239.7, 240.2], "ja": "わあ" },
    { "t": [240.5, 241.2], "ja": "エセル、あなたは…" },
    { "t": [241.2, 242.2], "ja": "はい、エセルは寝てる" },
    { "t": [242.8, 243.1], "ja": "シャウナ？" },
    { "t": [243.4, 244.5], "ja": "回顧録を書いてるの" },
    { "t": [244.5, 245.6], "ja": "私のブログをもとにしてね" },
    { "t": [245.8, 246.2], "ja": "タイトルは" },
    { "t": [246.2, 247.4], "ja": "「つぶやきで見栄を張る」" },
    { "t": [247.4, 248.9], "ja": "幸せを見つけるまでの" },
    { "t": [248.9, 250], "ja": "私の旅の話なの" },
    { "t": [250, 251.9], "ja": "痛みに耐えて笑顔でいることでね" },
    { "t": [252.1, 253.4], "ja": "うん、それなら何とかなるわ" },
    { "t": [253.9, 254.2], "ja": "だめ" },
    { "t": [254.5, 255.2], "ja": "そのノートに" },
    { "t": [255.2, 255.6], "ja": "何を書いてるの？" },
    { "t": [256, 257.6], "ja": "思い出を書き留めてるだけよ" },
    { "t": [257.6, 258.9], "ja": "頼れる古い日記にね" },
    { "t": [260.2, 261.2], "ja": "友情ランキング" },
    { "t": [261.8, 262.3], "ja": "それ何？" },
    { "t": [262.4, 263.8], "ja": "聞こえたままの意味じゃないの" },
    { "t": [263.8, 264.7], "ja": "ただ私が" },
    { "t": [264.7, 265.2], "ja": "見極めるための方法なの" },
    { "t": [265.2, 265.7], "ja": "あなたたちの誰が" },
    { "t": [265.7, 267], "ja": "一番いいかをね" },
    { "t": [268.2, 269.1], "ja": "それってひどい" },
    { "t": [269.2, 270.6], "ja": "ええ、本当にダサい" },
    { "t": [270.6, 271.5], "ja": "私は帰る" },
    { "t": [271.9, 272.8], "ja": "あなたはそんな人じゃないでしょ" },
    { "t": [272.9, 274.2], "ja": "ドナ、なんで怒ってるの？" },
    { "t": [274.3, 275.2], "ja": "あなたは1位だったのよ" },
    { "t": [275.3, 275.9], "ja": "じゃあね、みんな" },
    { "t": [276.3, 278.3], "ja": "これは本当に…" },
    { "t": [278.3, 280.6], "ja": "…ブランチだったわ" },
    { "t": [281, 281.5], "ja": "バッグは置いていって" },
    { "t": [282, 284.1], "ja": "もし来年もこれをやるなら" },
    { "t": [284.2, 285.8], "ja": "私には電話しないで" },
    { "t": [287, 288.1], "ja": "まあ、消去法で" },
    { "t": [288.2, 288.8], "ja": "シャウナね" },
    { "t": [289.2, 290.1], "ja": "それが新しい親友の" },
    { "t": [290.1, 291.1], "ja": "見つけ方なの？" },
    { "t": [291.4, 292], "ja": "消去法で？" },
    { "t": [292, 293], "ja": "（音楽）" },
    { "t": [293, 293.1], "ja": "（音楽）" }
  ]
}
