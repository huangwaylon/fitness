    { "t": [228.9,230.1], "ja": "－そうだった" },
    { "t": [230.1,231.3], "ja": "僕の名前はアンドリュー・ベインズ・バーナード" },
    { "t": [231.3,232.2], "ja": "これを見ているということは" },
    { "t": [232.2,233.8], "ja": "僕が証人になったからです" },
    { "t": [233.8,236.2], "ja": "知りすぎてしまって、命が危ないからです" },
    { "t": [236.2,237.5], "ja": "－もっと高い声で話したほうがいいぞ" },
    { "t": [237.5,239.5], "ja": "カメラだと変な声に聞こえるから" },
    { "t": [239.5,240.4], "ja": "－高く？分かった" },
    { "t": [240.4,242.7], "ja": "最近、ある出来事に気づきました" },
