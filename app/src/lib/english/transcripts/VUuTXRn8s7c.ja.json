{
  "video": "VUuTXRn8s7c",
  "lines": [
    { "t": [0,1.8], "ja": "－やあ、ゲイブ、ちょっと話があるんだ" },
    { "t": [1.8,3.2], "ja": "すごく大事な話" },
    { "t": [3.2,5.4], "ja": "－ここにアーモンドバターなんて、あるわけないよね？" },
    { "t": [5.4,6.2], "ja": "－さあ、どうかな" },
    { "t": [6.2,7.7], "ja": "あのさ、客の一人から電話があったんだ" },
    { "t": [7.7,9], "ja": "大量に印刷してる最中に" },
    { "t": [9,10.7], "ja": "プリンターの後ろから煙が出てきて" },
    { "t": [10.7,12.9], "ja": "それから用紙トレーが燃えだしたんだって" },
    { "t": [12.9,13.8], "ja": "－それは変だね" },
    { "t": [13.8,16.3], "ja": "そんな話は聞いたことないな" },
    { "t": [16.3,18.2], "ja": "アプリコットジャムでもいいんだけど" },
    { "t": [18.2,19.7], "ja": "－これ、どうする？" },
    { "t": [19.7,20.5], "ja": "－分からない" },
    { "t": [20.5,22.8], "ja": "本社に電話して、何か知ってるか聞いてみるよ" },
    { "t": [22.8,24.6], "ja": "うん、今日そうする" },
    { "t": [27.3,29], "ja": "－何て言ってたか教えて" },
    { "t": [30,32.9], "ja": "－うわ、あいつ、うまいな" },
    { "t": [32.9,34.3], "ja": "－どういう意味？" },
    { "t": [34.3,36.6], "ja": "－何か隠してるって感じなかったか？" },
    { "t": [36.6,38], "ja": "－さあ" },
    { "t": [38,40.6], "ja": "－何かをもみ消してるみたいな？" },
    { "t": [40.6,41.4], "ja": "かもね" },
    { "t": [52.3,54.4], "ja": "2年前、アンディは倉庫のせいにしたんだ" },
    { "t": [54.4,57.1], "ja": "自分が処理し忘れた出荷の遅れをね" },
    { "t": [57.1,58.8], "ja": "俺たち、こっぴどく怒られた" },
    { "t": [58.8,60.3], "ja": "俺はクビになりかけた" },
    { "t": [60.3,63], "ja": "いやあ、あのときは頭にきたよ" },
    { "t": [63,64.8], "ja": "でも自分に言い聞かせた。「ダリル、待つんだ" },
    { "t": [64.8,66.4], "ja": "あいつはバカだ" },
    { "t": [66.4,68.8], "ja": "チャンスは来る」って" },
    { "t": [68.8,70.2], "ja": "とにかく辛抱だ" },
    { "t": [71.4,71.9], "ja": "－どうした？" },
    { "t": [71.9,72.8], "ja": "メール見たよ" },
    { "t": [72.8,73.8], "ja": "－ドアを閉めて" },
    { "t": [75.2,76.7], "ja": "－分かった" },
    { "t": [76.7,78.7], "ja": "－はっきりした計画があるわけじゃない" },
    { "t": [78.7,80.8], "ja": "ゆるい骨組みって感じかな" },
    { "t": [80.8,82.7], "ja": "そのほうが自由にアドリブできる" },
    { "t": [82.7,83.7], "ja": "ジャズみたいなもんさ" },
    { "t": [83.7,86.5], "ja": "アンディ、俺に手を出すなよ" },
    { "t": [86.5,88.2], "ja": "何か考えるさ" },
    { "t": [88.2,89.8], "ja": "－何かヤバいことが起きてる" },
    { "t": [89.8,91.2], "ja": "戻る途中で、ゲイブ、いろいろ聞こえたんだ" },
    { "t": [91.2,92.1], "ja": "－たとえば？" },
    { "t": [92.1,93.1], "ja": "－ちょっとボソボソしてて" },
    { "t": [93.1,94.1], "ja": "よく分からない" },
    { "t": [94.1,97.1], "ja": "はっきり聞き取れたのは、アンディ、問題" },
    { "t": [97.1,98.3], "ja": "消す、とか何とか" },
    { "t": [98.3,99.3], "ja": "どういう意味かは分からない" },
    { "t": [99.3,100.1], "ja": "－何？" },
    { "t": [100.1,101.2], "ja": "どういう意味か分からないって？" },
    { "t": [101.2,105.1], "ja": "アンディが問題だから消さなきゃいけない、ってことだろ？" },
    { "t": [105.1,106.9], "ja": "－うわ、そんなこと考えもしなかった" },
    { "t": [106.9,108.1], "ja": "－だろ" },
    { "t": [108.1,109.1], "ja": "はっ" },
    { "t": [109.1,110.1], "ja": "－ふう" },
    { "t": [110.1,111.1], "ja": "－おい" },
    { "t": [111.1,114.1], "ja": "－クリードは品質保証の責任者だ" },
    { "t": [114.1,115.7], "ja": "だから絶対にこれに関わってるはずだ" },
    { "t": [115.7,117], "ja": "－何か言えばいいのかな、どういう意味か分からないって？" },
    { "t": [117,118.2], "ja": "－ただ何かが聞こえただけで、どういう意味かは分からない" },
    { "t": [118.2,119], "ja": "－何？" },
    { "t": [119,119.9], "ja": "どういう意味か分からないって？" },
    { "t": [119.9,122], "ja": "アンディが問題だから消さなきゃいけない、ってことだろ？" },
    { "t": [122,123], "ja": "－うわ、そんなこと考えもしなかった" },
    { "t": [123,124], "ja": "－だろ" },
    { "t": [124,125], "ja": "－はっ" },
    { "t": [125,126], "ja": "－ふう" },
