    { "t": [130.6,132.8], "ja": "－クリードは品質保証の責任者だ" },
    { "t": [132.8,134.9], "ja": "だから絶対にこれに関わってるはずだ" },
    { "t": [134.9,137.2], "ja": "－で、俺が自分のことをしてたら" },
    { "t": [137.2,139.6], "ja": "ダーネルが3ドルくれるって言うんだ" },
    { "t": [139.6,142.6], "ja": "アンディの横を通って、こうするだけでいいって" },
    { "t": [142.6,144], "ja": "ダーネルは甘いね" },
    { "t": [144,145.6], "ja": "何もらってもやったのに" },
    { "t": [145.6,147.5], "ja": "もっと安くて、もっとすごいことをやってきたからな" },
    { "t": [147.5,149.3], "ja": "－いいか、俺はもう下の倉庫にはいないから" },
    { "t": [149.3,150.6], "ja": "みんながお前をからかい始めたら" },
    { "t": [150.6,152.9], "ja": "お前、ちゃんと言い返さなきゃだめだぞ" },
    { "t": [152.9,154.2], "ja": "－分かってる。ただ、怖いんだ" },
    { "t": [154.2,155.7], "ja": "－メッセージ見たよ" },
    { "t": [155.7,157.4], "ja": "「緊急」って書いてあった" },
    { "t": [157.4,158.6], "ja": "－グレン、ちょっと外してくれる？" },
    { "t": [164.9,165.8], "ja": "－まずいことになった" },
    { "t": [165.8,166.7], "ja": "－何がまずいの？" },
    { "t": [166.7,167.7], "ja": "－かなりまずい" },
    { "t": [167.7,168.9], "ja": "－まだ計画はない" },
    { "t": [168.9,169.9], "ja": "－うわ、なんてこった" },
    { "t": [169.9,171], "ja": "－どんどん大きくなってる" },
    { "t": [171,172.2], "ja": "－公表しなきゃいけないかもしれない" },
    { "t": [172.2,174], "ja": "でも誰も信じてくれないだろうな" },
    { "t": [174,177.3], "ja": "証拠が必要だ。プリンターが燃えるところとか" },
    { "t": [177.3,178.3], "ja": "－俺がビデオに撮ってやるよ" },
    { "t": [178.3,179.1], "ja": "－うん" },
    { "t": [182.1,183.4], "ja": "－ほら来た" },
    { "t": [183.4,184.9], "ja": "－何が来たって？" },
    { "t": [184.9,185.8], "ja": "－え？" },
    { "t": [185.8,187], "ja": "－本社と話したよ" },
    { "t": [187,190.1], "ja": "プリンターの不具合の報告は12件あったそうだ" },
    { "t": [190.1,192.2], "ja": "40万台のうちね" },
    { "t": [192.2,194.4], "ja": "調べたら、毎回使う人のミスだった" },
    { "t": [194.4,196.5], "ja": "通気口をふさいだりとかね、よく分からないけど" },
    { "t": [196.5,198.4], "ja": "だから細かい注意書きがあるんだ" },
    { "t": [198.4,200.2], "ja": "知らせてくれてありがとう" },
    { "t": [200.2,202.3], "ja": "それで、お礼をしたいんだ" },
    { "t": [205.1,207.5], "ja": "ダンキンドーナツで5ドル分使えるよ" },
    { "t": [207.5,209.5], "ja": "どのダンキンドーナツでも" },
    { "t": [209.5,210.2], "ja": "ふむ" },
    { "t": [215.8,222.8], "ja": "－24ポンドの高級紙に印刷中" },
    { "t": [222.8,227.4], "ja": "これまでに約300枚、異常なし" },
