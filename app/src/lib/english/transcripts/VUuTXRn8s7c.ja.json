    { "t": [244.3,245.3], "ja": "分かった" },
    { "t": [245.3,246.5], "ja": "－僕はある結論に達しました" },
    { "t": [246.5,249.5], "ja": "セイバー社は、ある安全規則を" },
    { "t": [249.5,252.4], "ja": "見逃しているかもしれない、その…" },
    { "t": [252.4,257.2], "ja": "－煙が出てる？" },
