{
  "video": "w0Y5yHEOE10",
  "lines": [
    { "t": [0.3, 3.7], "ja": "え、俺のテーブルだったからって、新しいのも俺が買うの？" },
    { "t": [3.9, 4.5], "ja": "それがルールだろ" },
    { "t": [6.4, 10.1], "ja": "ルールって何？そんなのないよ。むしろ、お前がテーブル1個分の借りがあるだろ" },
    { "t": [10.5, 11.2], "ja": "なんでそうなるんだよ" },
    { "t": [11.5, 16.3], "ja": "だってこの家具、お前がアンジェラ・デル・ヴェッキオと朝食でお楽しみするまでは無事だったんだぞ" },
    { "t": [17.3, 18.2], "ja": "知ってたのか？" },
    { "t": [18.4, 21.3], "ja": "まあ、バターについた跡を見れば何があったか一目瞭然だったね" },
    { "t": [23.8, 25.7], "ja": "わかった、わかった。じゃあ割り勘にするのは？" },
    { "t": [26.6, 28.6], "ja": "どういうこと？一緒に買うってこと？" },
    { "t": [28.9, 29.3], "ja": "そう" },
    { "t": [30, 31.6], "ja": "俺たち、そういうことをする準備ができてると思う？" },
    { "t": [33.6, 34.1], "ja": "なんでダメなの？" },
    { "t": [34.4, 37.4], "ja": "いや、ただけっこう大きな約束だろ。どっちかが出ていきたくなったらどうする？" },
    { "t": [38.7, 39.4], "ja": "え、出ていくの？" },
    { "t": [39.4, 40], "ja": "出ていかないよ" },
    { "t": [40.9, 42.5], "ja": "出ていくなら言ってくれるよな？" },
    { "t": [42.6, 44.8], "ja": "うん、うん。ただ前のルームメイトのキップとさ…" },
    { "t": [44.8, 46.7], "ja": "ああ、キップの話なら全部知ってるよ" },
    { "t": [47.7, 52.3], "ja": "一緒に小さなグリルを買ったら、あいつが出ていって結婚して、かなりもめたんだ" },
    { "t": [53.2, 54.3], "ja": "じゃあ、ひとつ聞くけど" },
    { "t": [55.7, 57.2], "ja": "キップのほうが俺よりいいルームメイトだった？" },
    { "t": [58.3, 59.2], "ja": "おい、それはやめろよ" },
    { "t": [59.9, 67.3], "ja": "お前が選べよ" },
    { "t": [67.4, 68.5], "ja": "いいから選べって" },
    { "t": [68.7, 69.8], "ja": "ほら、あれはどう？" },
    { "t": [70.6, 71.8], "ja": "あれは屋外用の家具だよ" },
    { "t": [73.1, 73.8], "ja": "それが何？" },
    { "t": [74.1, 76.9], "ja": "客が入ってきて「あれ、また外に出ちゃった」って思うだろ" },
    { "t": [77.8, 78.2], "ja": "わかったよ" },
    { "t": [79.4, 80.4], "ja": "鳥の柄のはどう？" },
    { "t": [82.5, 86.1], "ja": "どうかな。鳥って「どうぞ座って、何か食べて」って感じじゃないんだよな" },
    { "t": [87.9, 89], "ja": "お前が選べよ" },
    { "t": [89.4, 89.8], "ja": "わかった" },
    { "t": [90, 90.9], "ja": "テントウムシのはどう？" },
    { "t": [91.6, 95.6], "ja": "へえ、鳥はダメなのに、でかい赤い虫なら高級レストランっぽいってわけ？" },
    { "t": [96.2, 97.4], "ja": "いいよ。鳥のがいいの？" },
    { "t": [97.5, 98.3], "ja": "鳥のにしろよ" },
    { "t": [98.5, 99.2], "ja": "そんな言い方されたら買わないよ" },
    { "t": [103.7, 104.7], "ja": "キップなら鳥のを気に入っただろうな" },
    { "t": [106.9, 107.7], "ja": "で、どう思う？" },
    { "t": [108.7, 111], "ja": "今まで見た中で一番きれいなテーブルだと思う" },
    { "t": [111.5, 112], "ja": "だよな" },
    { "t": [112.5, 113.6], "ja": "で、これどうやって使うの？" },
    { "t": [113.7, 115.8], "ja": "皿をこの小さい人形たちの頭の上に乗せるの？" },
    { "t": [116.2, 116.8], "ja": "どうでもいいだろ" },
    { "t": [116.8, 117.6], "ja": "食事は流しで食べればいい" },
    { "t": [117.9, 118.2], "ja": "いくぞ" },
    { "t": [120.8, 121.6], "ja": "ロス、気をつけろ" },
    { "t": [122.6, 123.1], "ja": "ゴール！" },
    { "t": [123.6, 124.6], "ja": "お前ら最低" },
    { "t": [131.4, 133], "ja": "彼女、けっこう落ち着いて受け止めたと思うよ" },
    { "t": [133.7, 136], "ja": "ほら、今パオロがあっちにいるからさ…" },
    { "t": [136, 137.6], "ja": "よし、向こうに行って彼女が大丈夫か見に行こう" },
    { "t": [137.9, 140.1], "ja": "ちょっと待って" },
    { "t": [141.5, 141.9], "ja": "ゴール！" },
    { "t": [142.4, 143.4], "ja": "ゲームポイント" },
    { "t": [145.9, 146.6], "ja": "さあ、いけ" },
    { "t": [149.3, 151.9], "ja": "どうやら俺たちがお前らをボコボコにしたみたいだな" },
    { "t": [152.2, 153.5], "ja": "いやいや、ボコボコにしたのは彼女だよ" },
    { "t": [153.6, 155.3], "ja": "お前なら「突っ立ってるだけ」のオリンピック代表になれるよ" },
    { "t": [156.5, 157], "ja": "さあ来い" },
    { "t": [157.2, 157.7], "ja": "2対1だ" },
    { "t": [158, 159.3], "ja": "お前、まだここにいるの？" },
    { "t": [159.4, 160.9], "ja": "彼女、あいつと別れたばかりだぞ" },
    { "t": [160.9, 162.2], "ja": "今こそ彼女にさっと近づくときだ" },
    { "t": [163.9, 164.5], "ja": "え、今？" },
    { "t": [165.3, 165.8], "ja": "そう" },
    { "t": [165.9, 166.9], "ja": "今こそ近づくんだよ" },
    { "t": [167.3, 169.2], "ja": "パオロがあそこから出てきたとき" },
    { "t": [169.2, 170.8], "ja": "レイチェルが最初に見る男が、お前じゃなきゃダメなんだ" },
    { "t": [171.2, 173.4], "ja": "お前があいつにないものを全部持ってるって、わからせないと" },
    { "t": [173.8, 174.3], "ja": "お前はまるで…" },
    { "t": [174.3, 175.5], "ja": "そう、反パオロだ" },
    { "t": [177.5, 178.9], "ja": "カトリックの友だちの言う通りだ" },
    { "t": [180, 181], "ja": "彼女は取り乱してる" },
    { "t": [181.3, 182.3], "ja": "お前が彼女を支えてあげる" },
    { "t": [182.4, 183.4], "ja": "傷ついた彼女を立ち直らせて" },
    { "t": [183.4, 185.4], "ja": "そしてやってくるのが…" },
    { "t": [185.4, 187.4], "ja": "ロスの時代だ" },
    { "t": [190.3, 195.1], "ja": "やった！" },
    { "t": [195.5, 197], "ja": "これで完封だな" },
    { "t": [197.6, 198.6], "ja": "完封だ！" },
    { "t": [200.7, 202.9], "ja": "みんなどこ行くんだよ？" },
    { "t": [203.3, 204.5], "ja": "ねえ、もう1試合" },
    { "t": [204.6, 206.4], "ja": "もう夜中の2時半だよ" },
    { "t": [206.5, 206.7], "ja": "そうだよ" },
    { "t": [207.3, 208], "ja": "出てけよ！" },
    { "t": [208.8, 210.9], "ja": "みんな、いつも俺の部屋に入りびたってるくせに" },
    { "t": [211.9, 213.8], "ja": "いいだろ、左手だけでやるからさ" },
    { "t": [214.6, 216.5], "ja": "来いよ、弱虫ども" },
    { "t": [220.4, 221.3], "ja": "わかった、わかったよ" },
    { "t": [221.6, 222.2], "ja": "もう行かなきゃ" },
    { "t": [222.4, 222.7], "ja": "うん" },
    { "t": [223.1, 223.7], "ja": "行くよ" },
    { "t": [224.8, 225.6], "ja": "もういないよ" },
    { "t": [228.9, 229.5], "ja": "もう1試合やる？" },
    { "t": [229.6, 229.9], "ja": "ああ、やろう" },
    { "t": [230.7, 232.7], "ja": "（笑い声）" }
  ]
}
