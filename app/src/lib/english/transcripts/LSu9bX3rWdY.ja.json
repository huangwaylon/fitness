{
  "video": "LSu9bX3rWdY",
  "lines": [
    { "t": [0, 4.5], "ja": "この子たちはみんな、自分を産んだ父親と母親がいて" },
    { "t": [4.5, 6.5], "ja": "人生を導いてもらってるんだ" },
    { "t": [7.3, 9.6], "ja": "そう、そういうものだよ" },
    { "t": [10.2, 10.9], "ja": "気分はどう？" },
    { "t": [11.3, 13], "ja": "父親になる件、もう決めた？" },
    { "t": [13.3, 17.2], "ja": "自分がどうするか、0パーセントしかわからないことを100パーセント確信してる" },
    { "t": [17.6, 20.1], "ja": "アン・パーキンスに、精子を提供してくれないかって頼まれたんだ" },
    { "t": [20.1, 21.4], "ja": "彼女が赤ちゃんを持てるようにね" },
    { "t": [21.6, 25.6], "ja": "この世に子どもを生み出したいという本能的な願いと" },
    { "t": [25.6, 29.8], "ja": "生き物に悪い影響を与えることへの、身動きがとれないほどの恐怖との戦いなんだ" },
    { "t": [30.3, 32.2], "ja": "レジから60ドルなくなってる" },
    { "t": [32.3, 33.7], "ja": "モナリザが盗んでると思う" },
    { "t": [34, 35.5], "ja": "ああ、間違いなくモナリザだよ" },
    { "t": [35.6, 39.3], "ja": "100パーセント、あの子は盗み癖があって、男好きで、放火魔で、全部そろってる" },
    { "t": [39.5, 42.2], "ja": "財務責任者として、すぐに辞めさせることをすすめるよ" },
    { "t": [42.5, 45.1], "ja": "明日、一番の顧客を集めて大きなカクテルパーティーを開くんだ" },
    { "t": [45.1, 46.4], "ja": "新しい人を探す時間なんてない" },
    { "t": [46.9, 47.7], "ja": "最悪だよ" },
    { "t": [48.2, 50.3], "ja": "ねえ、僕が高校生のとき" },
    { "t": [50.5, 53.2], "ja": "小麦粉の袋を一週間持ち歩いて" },
    { "t": [53.2, 54.4], "ja": "赤ちゃんのふりをする授業があったんだ" },
    { "t": [55.2, 58.2], "ja": "トムを君の小麦粉の袋にしたら？" },
    { "t": [58.2, 60.5], "ja": "ちょっと親の役をやってみて、どんな感じか試すんだ" },
    { "t": [61.2, 65.2], "ja": "ベン、それは文字どおり人類史上最高のアイデアだよ" },
    { "t": [65.4, 67.3], "ja": "小麦粉の袋と高校って聞こえたけど" },
    { "t": [67.4, 69.6], "ja": "お前らまぬけ、高校2年生向けに偽の薬でも作ってるの？" },
    { "t": [69.7, 71.9], "ja": "もしそうなら、俺も混ぜてくれ" },
    { "t": [73.9, 75.6], "ja": "トム、話さなきゃいけないことがあるんだ" },
    { "t": [75.9, 76.9], "ja": "こんなふうに座らなきゃいけないの？" },
    { "t": [77.4, 77.8], "ja": "うん" },
    { "t": [78.6, 80.2], "ja": "モナリザは君を利用してる" },
    { "t": [80.5, 81.9], "ja": "それに、親友の妹となると" },
    { "t": [81.9, 83.7], "ja": "簡単じゃないのはわかるよ" },
    { "t": [84, 85.3], "ja": "いや、そういうことじゃないんだ" },
    { "t": [85.4, 86.7], "ja": "あの子がめちゃくちゃ怖いんだよ" },
    { "t": [87, 89], "ja": "前に、警察の馬の顔をなぐるところを見たことがある" },
    { "t": [89.6, 91.6], "ja": "彼女にはっきり言うんだ" },
    { "t": [91.6, 93.9], "ja": "「なめるな」って" },
    { "t": [94.8, 95.9], "ja": "君はトム・ハヴァフォードだ" },
    { "t": [96.5, 99], "ja": "頭がよくて成功している若者だ" },
    { "t": [99, 100.5], "ja": "かわいいおなかもある" },
    { "t": [101, 101.9], "ja": "自分の身を守るんだ" },
    { "t": [102.5, 102.8], "ja": "うん" },
    { "t": [103.3, 104.4], "ja": "パーティーの前に彼女と話すよ" },
    { "t": [104.6, 105.4], "ja": "もし殺されたら" },
    { "t": [105.6, 107.3], "ja": "ジャン・ラルフィオに、ブラウザの履歴を消してって伝えて" },
    { "t": [107.3, 109.7], "ja": "アドバイスありがとう" },
    { "t": [110.5, 112.8], "ja": "どういたしまして、息子よ" },
    { "t": [113.6, 114.2], "ja": "今の何？" },
    { "t": [114.4, 114.7], "ja": "何でもない" },
    { "t": [115.1, 115.5], "ja": "わかった" },
    { "t": [116.2, 117.9], "ja": "トム、モナリザとはどうだった？" },
    { "t": [118.2, 120.5], "ja": "態度を改めないと" },
    { "t": [120.5, 122], "ja": "クビにするしかないって言ったよ" },
    { "t": [122.1, 125.3], "ja": "それはとても責任感があって大人だね" },
    { "t": [125.6, 126.5], "ja": "彼女、ちゃんと受け止めた？" },
    { "t": [127.4, 128.9], "ja": "えっと、うん" },
    { "t": [129.3, 132], "ja": "なぜか、すごくその気になっちゃって" },
    { "t": [132.4, 133.9], "ja": "激しくキスし始めて" },
    { "t": [134.8, 137.7], "ja": "気づいたらうちに戻って、エッチしてた" },
    { "t": [138.4, 139.4], "ja": "今、付き合ってるんだ" },
    { "t": [139.6, 141.4], "ja": "ちょっと、あんた、お金借りたいの" },
    { "t": [141.4, 143.7], "ja": "あんたには関係ないことに使うから" },
    { "t": [143.9, 146.4], "ja": "要するに、ミツバチにワックスをかけるのよ" },
    { "t": [146.9, 147.5], "ja": "はい、どうぞ" },
    { "t": [148.2, 149], "ja": "それでもいけるな" },
    { "t": [149.6, 150.7], "ja": "あなたに冷めてきてる" },
    { "t": [151.7, 152.1], "ja": "ほらね？" },
    { "t": [152.8, 153.2], "ja": "完璧" },
    { "t": [154.7, 157.3], "ja": "うーん、今夜はいい男がいっぱいね" },
    { "t": [157.8, 159.5], "ja": "あら、あのがっしりしたイケメン見て" },
    { "t": [159.8, 160.9], "ja": "あそこに行って話しかけて" },
    { "t": [160.9, 162.1], "ja": "どんな人か聞いてきて" },
    { "t": [162.4, 164.1], "ja": "いや、ほかの男と話すつもりはないよ" },
    { "t": [164.3, 166.1], "ja": "付き合ってるんだから、ほかの男をじろじろ見ちゃだめだ" },
    { "t": [166.3, 166.8], "ja": "それが約束だ" },
    { "t": [166.9, 167.9], "ja": "じゃないと、僕たちはおしまいだよ" },
    { "t": [168, 168.3], "ja": "わかった？" },
    { "t": [168.8, 170.9], "ja": "うーん、トミーったら、決まりを作っちゃって" },
    { "t": [171, 171.7], "ja": "ちょっと強気ね" },
    { "t": [171.9, 172.9], "ja": "そういうの好きよ" },
    { "t": [173.2, 174.1], "ja": "ジュースを取ってくる" },
    { "t": [174.5, 176.5], "ja": "そのあと、どこかでエッチする？" },
    { "t": [177, 177.2], "ja": "いいよ" },
    { "t": [177.5, 177.8], "ja": "わかった" },
    { "t": [182.5, 186.4], "ja": "まあ、モナリザとのことは…" },
    { "t": [186.4, 187.3], "ja": "続いてるみたいだね" },
    { "t": [187.9, 190.2], "ja": "うん、少しずつ彼女を変えてるんだと思う" },
    { "t": [190.2, 191.9], "ja": "本当にひどいから、ちょっとだけひどいくらいにね" },
    { "t": [192.3, 193.4], "ja": "小さな勝利ってやつだよ" },
    { "t": [193.8, 195.1], "ja": "まったくだ" },
    { "t": [196.1, 197], "ja": "小さな勝利だね" },
    { "t": [197.3, 197.7], "ja": "わかってる" },
    { "t": [197.8, 199.8], "ja": "ちょっと怪物みたいな子だけど、まあいいや" },
    { "t": [200.3, 200.9], "ja": "僕は若いし" },
    { "t": [201, 201.6], "ja": "彼女はセクシーだし" },
    { "t": [202.6, 204], "ja": "このジェットコースターがどこに行くか見てみるよ" },
    { "t": [204.5, 205.1], "ja": "もっともだね" },
    { "t": [206, 207.6], "ja": "ほかに助けが必要なことはある？" },
    { "t": [208.2, 209.5], "ja": "もう自転車に乗れるようになった？" },
    { "t": [209.8, 211.3], "ja": "うん、僕28歳だよ" },
