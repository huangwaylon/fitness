{
  "video": "TvJzrKFPm60",
  "lines": [
    { "t": [0,  2.2], "ja": "女性や子どもはなし。挑発されない限りは" },
    { "t": [2.2,  3.5], "ja": "なるほど。ロイは？" },
    { "t": [3.5,  5.6], "ja": "倉庫のやつだ。数に入らない" },
    { "t": [5.6,  7.9], "ja": "なるほど。じゃあ、マイケルは？ マイケルを倒せる？" },
    { "t": [7.9,  10.2], "ja": "ああ。いや、それはありえないと思う" },
    { "t": [10.2,  13.1], "ja": "友だちだからな。私が彼をぶちのめすからだ" },
    { "t": [13.1,  15.8], "ja": "でも、彼は紫帯だから…" },
    { "t": [15.8,  18.8], "ja": "だから？ 私は黒帯だって倒したことがある" },
    { "t": [18.8,  20.8], "ja": "黒帯だって、どうして分かったんですか？" },
    { "t": [20.8,  23.4], "ja": "後で教えてもらった" },
    { "t": [23.4,  25.8], "ja": "ほら、昔はすごく荒っぽい連中とつるんでたんだ" },
    { "t": [25.8,  30.3], "ja": "ストリートファイター系の、本当に本当に悪いやつらさ" },
    { "t": [30.3,  32.6], "ja": "抜け出せたのは運が良かっただけだ" },
    { "t": [32.6,  35.8], "ja": "それ以来、ダム・ラスカルズに手を出すやつは誰もいなかった" },
    { "t": [35.8,  37.7], "ja": "大変そうですね" },
    { "t": [37.7,  40.1], "ja": "ジェット団に入ったら、一生ジェット団だろ？" },
    { "t": [40.1,  41.2], "ja": "ジェット団なんですか？" },
    { "t": [41.2,  42.7], "ja": "経費報告書にはもうサインしました？" },
    { "t": [42.7,  44.6], "ja": "ああ。理論上はした" },
    { "t": [44.6,  48.6], "ja": "細かいところを少し仕上げるだけだ" },
    { "t": [48.6,  50.3], "ja": "よし" },
    { "t": [50.3,  54.5], "ja": "何かあったら、私は部屋にいるから" },
    { "t": [54.5,  56.5], "ja": "ほっ！ はっ！ おお！" },
    { "t": [56.5,  58.8], "ja": "マイケル！ すごい！ スリーパーホールド！" },
    { "t": [58.8,  60.7], "ja": "「ボンゾ」はおねんねの時間だ！ほら！" },
    { "t": [60.7,  62], "ja": "おっと、しーっ！" },
    { "t": [62,  64.9], "ja": "おお！ お前が一番の役立たずだ！" },
    { "t": [64.9,  68.5], "ja": "おお！ 私はこの職場の全員と友だちだ" },
    { "t": [68.5,  69.8], "ja": "みんな大親友なんだ" },
    { "t": [69.8,  71.5], "ja": "ここの全員が大好きだ" },
    { "t": [71.5,  74.5], "ja": "でも時々、その大親友が" },
    { "t": [74.5,  76.9], "ja": "遅刻してくるようになって" },
    { "t": [76.9,  79.1], "ja": "歯医者の予約を入れ始めるんだ" },
    { "t": [79.1,  80.4], "ja": "実は歯医者じゃない予約をね" },
    { "t": [80.4,  82.6], "ja": "そういうときに、知らせておくといい" },
    { "t": [82.6,  84.9], "ja": "いつでもぶちのめせるんだぞって" },
    { "t": [84.9,  86.7], "ja": "とにかく殴ってみろ。分かるから" },
    { "t": [86.7,  89.1], "ja": "できません、あの、ネイルをしたばかりなので" },
    { "t": [89.1,  91], "ja": "おお、クィア！" },
    { "t": [91,  92.2], "ja": "アイ。「クィア・アイ」" },
    { "t": [92.2,  94.3], "ja": "いい番組だ。大事な番組だよ" },
    { "t": [94.3,  95.8], "ja": "さあ、やれ" },
    { "t": [95.8,  98.2], "ja": "ドワイトに殴らせればいいじゃない。ああ、そうだな" },
    { "t": [98.2,  99.4], "ja": "まあ、それはあまり意味がないな" },
    { "t": [99.4,  101.6], "ja": "だって、彼をぶちのめせる14歳の女の子を" },
    { "t": [101.6,  102.5], "ja": "たくさん知ってるからね" },
    { "t": [102.5,  104.2], "ja": "14歳の女の子をたくさん知ってるの？" },
    { "t": [104.2,  105.5], "ja": "その子たちは何帯ですか？" },
    { "t": [105.5,  107.8], "ja": "いいか、ドワイトは弱虫だ" },
    { "t": [107.8,  109], "ja": "「アルマゲドン」を借りて見たとき" },
    { "t": [109,  110.1], "ja": "違う。最後に泣いたんだ" },
    { "t": [110.1,  111.4], "ja": "見たよな。マイケル、言ったでしょう" },
    { "t": [111.4,  112.9], "ja": "あれは大みそかで" },
    { "t": [112.9,  115.2], "ja": "ちょうど午前0時に雪が降り始めたからです" },
    { "t": [115.2,  116.2], "ja": "おお、ブルース・ウィリスが" },
    { "t": [116.2,  117.7], "ja": "小惑星に残るところか？" },
    { "t": [117.7,  119.2], "ja": "ブー！ 分かりました。殴ります" },
    { "t": [119.2,  120.7], "ja": "おお、よし。いくぞ" },
    { "t": [120.7,  122], "ja": "よし！ 来い！" },
    { "t": [122,  123], "ja": "うわっ！" },
    { "t": [123,  125.4], "ja": "くそっ！" },
    { "t": [125.4,  128], "ja": "うわっ！" },
    { "t": [128,  129.7], "ja": "マイケルを傷つけたかったか？" },
    { "t": [129.7,  131.8], "ja": "私が守るために雇われている、ただ一人の人を？" },
    { "t": [131.8,  133.4], "ja": "いいえ、そんなことはない" },
    { "t": [133.4,  135.1], "ja": "大丈夫ですか？ ああ" },
    { "t": [135.1,  136.2], "ja": "本当に大丈夫？ ああ" },
    { "t": [136.2,  139.8], "ja": "ありがとう。ありがとう" }
  ]
}
