{
  "video": "fDzT9ZqaGrM",
  "lines": [
    { "t": [0.7,2.2], "ja": "鍵はどこ？" },
    { "t": [2.2,3.3], "ja": "開いてるみたいだよ" },
    { "t": [3.3,4.2], "ja": "本当？" },
    { "t": [4.2,5.1], "ja": "うん" },
    { "t": [14.9,16], "ja": "ピキティス！" },
    { "t": [19.9,22.4], "ja": "あの子のことは2、3時間ずっと尾行してたんですよ" },
    { "t": [22.4,24.4], "ja": "だから、誰か別の人に違いありません" },
    { "t": [24.4,25.4], "ja": "ピキティスよ" },
    { "t": [27.6,29.3], "ja": "これで信じてくれるでしょ" },
    { "t": [29.3,31.6], "ja": "それを見ても、私には何の意味もありませんね" },
    { "t": [31.6,33.4], "ja": "これは桃の種よ" },
    { "t": [33.4,34.3], "ja": "はあ" },
    { "t": [34.3,36.9], "ja": "私が話しに行ったとき、あの子は桃を食べてたの" },
    { "t": [36.9,38.4], "ja": "これはあの子の切り札" },
    { "t": [38.4,39.3], "ja": "あの子の名刺みたいなもの" },
    { "t": [39.3,40.7], "ja": "被害者にはいつもこれを残していくの" },
    { "t": [40.7,41.6], "ja": "しかも、まだ温かい" },
    { "t": [41.6,43.9], "ja": "さあ、逮捕しに行って、これを鑑識に回して" },
    { "t": [43.9,45.7], "ja": "鑑識なんてありませんよ" },
    { "t": [45.7,46.5], "ja": "来たよ" },
    { "t": [46.5,48.4], "ja": "像は無事だ" },
    { "t": [48.4,50], "ja": "ひどいハロウィーンの連中だな" },
    { "t": [50,51], "ja": "笑えるよ" },
    { "t": [51,52.1], "ja": "あの子はどこ？" },
    { "t": [52.1,53.2], "ja": "会議室よ" },
    { "t": [53.2,55.2], "ja": "バレバレの罪を隠そうとしてる" },
    { "t": [55.2,56.4], "ja": "レスリー、何と言ったらいいか" },
    { "t": [56.4,57.8], "ja": "彼がやったとは思えません" },
    { "t": [57.8,58.5], "ja": "いいえ、やったわ" },
    { "t": [58.5,60.9], "ja": "だから自白が必要なの" },
    { "t": [60.9,61.9], "ja": "いい？" },
    { "t": [61.9,64.7], "ja": "アンディと私はちょっと散歩してくるから" },
    { "t": [64.7,68.3], "ja": "あなたとピキティスと、このペンチだけにしてあげる" },
    { "t": [68.3,69.8], "ja": "いいですか、私はこの子を拷問なんかしませんよ" },
    { "t": [69.8,72], "ja": "誰も拷問なんて言ってないわ" },
    { "t": [72,74.5], "ja": "ボス、僕にやらせてみない？" },
    { "t": [74.5,77.6], "ja": "こういうやつらみたいに考えるには" },
    { "t": [77.6,79.6], "ja": "こういうやつらみたいに考えなきゃいけないんだ" },
    { "t": [79.6,80.6], "ja": "そうね" },
    { "t": [80.6,81.9], "ja": "あの子はあなたに会ったことがない" },
    { "t": [81.9,84.1], "ja": "だから、自分はすごく偉い人で" },
    { "t": [84.1,86.3], "ja": "あの子の人生をめちゃくちゃにできるって、ほのめかすの" },
    { "t": [89.3,91.3], "ja": "グレッグ・ピキティス" },
    { "t": [91.3,93.9], "ja": "煮えたぎるほど熱いコーヒーはいかが？" },
    { "t": [93.9,95.3], "ja": "顔にかけてやろうか" },
    { "t": [99.3,101.3], "ja": "私の名はバート・マックリン" },
    { "t": [101.3,104.3], "ja": "エフビーアイの者だ" },
    { "t": [106.7,108.6], "ja": "アンディが追い詰めてるみたいね" },
    { "t": [108.6,110.6], "ja": "私がとどめを刺してくる" },
    { "t": [110.6,114.2], "ja": "それって、今まで聞いた中でいちばんばかな話だね" },
    { "t": [114.2,115.7], "ja": "ちょっと黙っててくれないか？" },
    { "t": [115.7,116.6], "ja": "ここで何が起きてるの？" },
    { "t": [116.6,117.9], "ja": "こいつ、嫌なやつなんだ" },
    { "t": [117.9,119.6], "ja": "すっごく嫌なやつなんだよ" },
    { "t": [119.6,121.9], "ja": "人間に向かって言うなんて、ひどいことだよ" },
    { "t": [121.9,123], "ja": "泣いてるの？" },
    { "t": [123,124.7], "ja": "泣いてないよ、いい？" },
    { "t": [124.7,126.4], "ja": "嫌なやつアレルギーなんだ" },
    { "t": [126.4,127.6], "ja": "分かった、アンディは退場" },
    { "t": [127.6,128.9], "ja": "いいよ、別にどうでもいいし" },
    { "t": [128.9,129.9], "ja": "ばかばかしい" },
    { "t": [131.3,132.8], "ja": "さて" },
    { "t": [132.8,134.1], "ja": "本気でいくわよ" },
    { "t": [136.4,137.3], "ja": "それ何？" },
    { "t": [137.3,138.5], "ja": "何か分かってるでしょ" },
    { "t": [139.7,140.9], "ja": "学校にあなたを訪ねたとき" },
    { "t": [140.9,142.2], "ja": "あなたは桃を食べてた" },
    { "t": [143.1,144.5], "ja": "そのあと私のオフィスが荒らされて" },
    { "t": [144.5,146.6], "ja": "誰かが私の机に桃の種を置いていった？" },
    { "t": [146.6,150.5], "ja": "それが偶然だとは思えないわ、グレッグ" },
    { "t": [150.5,152], "ja": "うわ、完全にバレちゃった" },
    { "t": [152,154.8], "ja": "だって、別々の二人が同じ果物を" },
    { "t": [154.8,156.5], "ja": "同じ日に、インディアナの同じ地域で" },
    { "t": [156.5,159.7], "ja": "食べるなんて、ありえないもんね" },
    { "t": [159.7,163.3], "ja": "さっき会ったとき、僕が実はプラムを食べてたってことは" },
    { "t": [163.3,164.7], "ja": "気にしないでおいてあげるよ" },
    { "t": [169,170.2], "ja": "あなたがやったのは分かってる" },
    { "t": [170.2,171.6], "ja": "何と言おうと関係ない" },
    { "t": [171.6,173.6], "ja": "一晩中駐車場にいたことなんて関係ない" },
    { "t": [173.6,175.1], "ja": "どうにかしてここに入る方法を見つけたのよ" },
    { "t": [175.1,176.3], "ja": "待って、待って、待って" },
    { "t": [176.3,178.1], "ja": "僕が一晩中駐車場にいたって、なんで知ってるの？" },
    { "t": [178.1,180.9], "ja": "尾行してたからよ、天才くん" },
    { "t": [180.9,182.9], "ja": "一晩中尾行してたなら" },
    { "t": [182.9,185], "ja": "僕じゃないって分かるでしょ" },
    { "t": [185,186.9], "ja": "ねえ、何が問題なの？" },
    { "t": [186.9,188.3], "ja": "いい？　私はずっと礼儀正しくしてきたけど" },
    { "t": [188.3,190.3], "ja": "水責めにしてやるわよ" },
    { "t": [190.3,191.3], "ja": "いや、だめです" },
    { "t": [192.7,194.2], "ja": "彼女はいい警官にはなれないと思いますね" },
    { "t": [194.2,196.7], "ja": "正直、彼女が警官の町には" },
    { "t": [196.7,198.8], "ja": "怖くて住めませんよ" },
    { "t": [198.8,200.5], "ja": "…" },
    { "t": [218.5,248.4], "ja": "（音楽）" }
  ]
}
