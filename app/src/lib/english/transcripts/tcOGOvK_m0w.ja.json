{
  "video": "tcOGOvK_m0w",
  "lines": [
    { "t": [0, 1.3], "ja": "で、今週はどうだった？" },
    { "t": [1.4, 3.8], "ja": "ああ、よかったよ。実は、赤ちゃんがおなかをけり始めたんだ" },
    { "t": [4.2, 4.9], "ja": "すごいね" },
    { "t": [5, 6.7], "ja": "うん、でしょ。ほんと、すごかったよ" },
    { "t": [7.1, 10.6], "ja": "ただ残念なのは、初めてけったときにそばにいなかったことなんだ" },
    { "t": [10.9, 11.4], "ja": "あら、かわいそう" },
    { "t": [11.5, 14.5], "ja": "うん、でしょ。それに、ほかのこともいろいろ見逃してて" },
    { "t": [14.6, 17.3], "ja": "それで、ジョーイがレイチェルをうちに住まわせたらって言うんだ" },
    { "t": [17.9, 18.8], "ja": "まさかね" },
    { "t": [21.2, 21.6], "ja": "何？" },
    { "t": [22.2, 24], "ja": "ジョーイには笑っちゃうよ。だってさ" },
    { "t": [24.2, 26.1], "ja": "「元妻を家に住まわせればいいじゃん」って" },
    { "t": [26.2, 27.3], "ja": "気まずくも何ともないよね" },
    { "t": [30, 34], "ja": "ねえ、想像できる？" },
    { "t": [34.2, 36.1], "ja": "私が何日か出かけて、帰ってきたら" },
    { "t": [36.2, 38.6], "ja": "彼氏が、自分の子を妊娠した女の人と住んでるのよ" },
    { "t": [42.9, 43.9], "ja": "それで、彼には何て言ったの？" },
    { "t": [46.3, 47.5], "ja": "はは、はは、はは" },
    { "t": [60, 90], "ja": "（音楽）" }
  ]
}
