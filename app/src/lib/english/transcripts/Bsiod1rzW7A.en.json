{"video":"Bsiod1rzW7A","lines":[{"t":[0.7,1.5],"en":"That's it."},{"t":[1.5,3.3],"en":"I cannot make this decision."},{"t":[3.3,4.9],"en":"It is too difficult."},{"t":[4.9,7.9],"en":"So I'm just going to leave it entirely up to the gods of fate."},{"t":[10.8,12.5],"en":"A magic eight ball?"},{"t":[12.5,13.4],"en":"Well, you can't be serious."},{"t":[13.4,15.2],"en":"You can't make this decision with a toy."},{"t":[15.2,16.4],"en":"Oh, it's not a toy."},{"t":[19,21.5],"en":"Well, I don't know what else to do."},{"t":[21.5,25.8],"en":"I mean, I either keep my wife and lose one of my best friends,"},{"t":[25.8,28.7],"en":"or I keep my friend and get divorced for the second time"},{"t":[28.7,30],"en":"before I'm 30."},{"t":[30,32.9],"en":"So if anyone else has a better suggestion,"},{"t":[32.9,35],"en":"let's hear it, because I got nothing."},{"t":[35,36.1],"en":"All right, don't be shy."},{"t":[36.1,38.2],"en":"Any suggestion will do."},{"t":[43.9,44.8],"en":"Okay, then."},{"t":[48.8,49.6],"en":"Here we go."},{"t":[51.6,53.4],"en":"Magic eight ball."},{"t":[53.4,55.6],"en":"Should I never see Rachel again?"},{"t":[60,61],"en":"Ask again later."},{"t":[63.1,65.3],"en":"Later is not good enough."},{"t":[72.3,73.3],"en":"Ask again later."},{"t":[73.3,74.5],"en":"What the hell?"},{"t":[74.5,75.2],"en":"This is broken."},{"t":[75.2,75.6],"en":"This is broken."},{"t":[75.6,76.7],"en":"It is broken."},{"t":[78.5,79.4],"en":"Let me see."},{"t":[81.1,82.7],"en":"Will Chandler have sex tonight?"},{"t":[84.6,85.7],"en":"Don't count on it."},{"t":[90.2,91.4],"en":"Seems like it works to me."}]}
