{
  "video": "zEQaedWeLO0",
  "lines": [
    { "t": [0,  0.8], "ja": "呼んだ？" },
    { "t": [0.8,  1.7], "ja": "ああ" },
    { "t": [1.7,  6.8], "ja": "頼みがあるんだ" },
    { "t": [6.8,  8.1], "ja": "何？" },
    { "t": [8.1,  10], "ja": "ロン・スワンソンが助けを求めてる？" },
    { "t": [10,  12.7], "ja": "声を小さくしろ" },
    { "t": [12.7,  15.9], "ja": "団結コンサートの一部に、子どもたちの出し物がある" },
    { "t": [15.9,  17.9], "ja": "ポーニーの歴史についてだ" },
    { "t": [17.9,  20.6], "ja": "ボランティアが必要なので、一緒に来てほしい" },
    { "t": [20.6,  25.1], "ja": "娘が通う公立の小学校へ" },
    { "t": [25.1,  27], "ja": "衣装作りを手伝いにな" },
    { "t": [27,  29], "ja": "小学校ね" },
    { "t": [29,  30.3], "ja": "いいわ、借りを作ってあげる" },
    { "t": [30.3,  31.5], "ja": "でも、見張っててもらうわよ" },
    { "t": [31.5,  33.4], "ja": "元彼のジョーを" },
    { "t": [33.4,  36], "ja": "あの学校で音楽を教えてて、最悪なの" },
    { "t": [36,  37.4], "ja": "私にとってのタミーよ" },
    { "t": [37.4,  38.7], "ja": "君にとってのタミーか" },
    { "t": [38.7,  42.3], "ja": "ドナ、私の二人の元妻は世界で最悪の人間だ" },
    { "t": [42.3,  44.3], "ja": "二人目のタミーは、かつて検視官を誘惑して" },
    { "t": [44.3,  46.2], "ja": "私を法的に死亡扱いにした" },
    { "t": [46.2,  49], "ja": "飛行機のチケットを割引にするためだけにな" },
    { "t": [49,  51.2], "ja": "ジョーといると、私、自分でも嫌な" },
    { "t": [51.2,  53.1], "ja": "知らない人間になっちゃうの" },
    { "t": [53.1,  54.7], "ja": "おかしくなるのよ" },
    { "t": [54.7,  58.1], "ja": "お願いしたいのは、彼を私に近づけないことだけ" },
    { "t": [58.1,  60.5], "ja": "この問題はよく分かる" },
    { "t": [60.5,  62.7], "ja": "この取引に応じよう" },
    { "t": [67.7,  68.7], "ja": "何してる？" },
    { "t": [68.7,  70.8], "ja": "写真を撮ってるの。公立小学校で" },
    { "t": [70.8,  72.3], "ja": "ボランティアしてるところをね" },
    { "t": [72.3,  74.2], "ja": "いつか、あなたを脅す必要があるときのために" },
    { "t": [74.2,  76.6], "ja": "あ、あれがジョー。正面" },
    { "t": [76.6,  79], "ja": "ドナ、元気？" },
    { "t": [79,  81], "ja": "本当に、会えてうれしいよ" },
    { "t": [81,  82], "ja": "ふーん" },
    { "t": [82,  83.2], "ja": "手伝いに来てくれて、本当にありがとう" },
    { "t": [83.2,  85.6], "ja": "子どもたちは、君のファッションの腕が借りられて幸運だよ" },
    { "t": [85.6,  86.2], "ja": "どうも、ジョー" },
    { "t": [86.2,  88.2], "ja": "ロン・スワンソンだ" },
    { "t": [88.2,  90.2], "ja": "ドナの職場の近所の同僚だ" },
    { "t": [90.2,  93], "ja": "うわあ、ドナから君の話はたくさん聞いてるよ" },
    { "t": [93,  95.5], "ja": "名前と顔が一致してうれしいな" },
    { "t": [95.5,  96.5], "ja": "ふむ" },
    { "t": [96.5,  97.5], "ja": "おっと！" },
    { "t": [97.5,  99.5], "ja": "教室に戻らないと" },
    { "t": [99.5,  101.5], "ja": "会えてうれしいよ、ロン" },
    { "t": [101.5,  103.7], "ja": "それと今日、二人とも何か必要なものがあったら" },
    { "t": [103.7,  105.7], "ja": "遠慮なく言ってね、いい？" },
    { "t": [105.7,  106.5], "ja": "分かった" },
    { "t": [106.5,  107.5], "ja": "お前の魂胆は分かってるぞ" },
    { "t": [107.5,  108.6], "ja": "うん" },
    { "t": [108.6,  109.6], "ja": "慎重にな" },
    { "t": [110.6,  111.4], "ja": "分かった" },
    { "t": [113.4,  114.3], "ja": "ロン！" },
    { "t": [114.3,  116], "ja": "ロン、一緒に遊ぼう！" },
    { "t": [116,  116.8], "ja": "はいはい" },
    { "t": [116.8,  119.3], "ja": "みんな、今ロンはとがった道具を持ってるからね" },
    { "t": [119.3,  120.2], "ja": "ロン、ロン！" },
    { "t": [120.2,  124.2], "ja": "みんな、目は見てる、耳は聞いてる" },
    { "t": [124.2,  128.6], "ja": "口は閉じて、手は止めて、足はとっても静か" },
    { "t": [128.6,  132.8], "ja": "みんなもやってみて、よく聞こう、よく聞こう" },
    { "t": [134.5,  137.1], "ja": "うまいことやったな" },
    { "t": [137.1,  139], "ja": "あの年の子どもは" },
    { "t": [139,  140.4], "ja": "メロディーと韻によく反応するんだ" },
    { "t": [140.4,  141.9], "ja": "いい子たちだね" },
    { "t": [141.9,  144.4], "ja": "継父になれて、きっと幸せだろうね" },
    { "t": [144.4,  146], "ja": "実にそうだ" },
    { "t": [147.7,  149], "ja": "失礼するよ、ジョー" },
    { "t": [149,  150.8], "ja": "この相欠き継ぎの部分を" },
    { "t": [150.8,  152.2], "ja": "削り終えなきゃならないんでね" },
    { "t": [152.2,  154.7], "ja": "ああ、僕が作ったこの治具を使うといいかも" },
    { "t": [154.7,  156.5], "ja": "固い木の締め付け台に" },
    { "t": [156.5,  158.1], "ja": "エノキの小さな木片をつないだだけなんだけど" },
    { "t": [158.1,  160], "ja": "これで切る位置を決められるんだ" },
    { "t": [160,  162.1], "ja": "内側の肩の部分をね、わざわざ" },
    { "t": [162.1,  163.3], "ja": "定規を合わせ直さなくても。定規を合わせ直さなくても" },
    { "t": [163.3,  165.5], "ja": "そのとおり" },
    { "t": [165.5,  166.5], "ja": "マフィンは？" },
    { "t": [169.3,  172.5], "ja": "正直どうでもいいが、言わせてもらう" },
    { "t": [172.5,  174], "ja": "私はジョーが気に入った" },
    { "t": [174,  175.8], "ja": "子どもの扱いがうまい、いい男だ" },
    { "t": [175.8,  177.9], "ja": "頭も良くて、辛抱強そうだ" },
    { "t": [177.9,  180.5], "ja": "分かってる、だから私にとってのタミーなのよ" },
    { "t": [180.5,  181.8], "ja": "私は社交的なタイプなの" },
    { "t": [181.8,  184.2], "ja": "一緒にいると、することといえば、エッチして" },
    { "t": [184.2,  186.3], "ja": "ソファに座って、手作りパスタを食べて" },
    { "t": [186.3,  187.9], "ja": "またエッチ。もういい" },
    { "t": [187.9,  189.8], "ja": "彼はいつも私を大切にしてくれて" },
    { "t": [189.8,  191], "ja": "私と一緒に過ごしたがって" },
    { "t": [191,  193.3], "ja": "心を通わせようとしてくる" },
    { "t": [193.3,  194.8], "ja": "悪夢よ" },
    { "t": [194.8,  196.1], "ja": "私、退屈な人になっちゃった" },
    { "t": [196.1,  198.6], "ja": "好きなように生きればいい" },
    { "t": [198.6,  201.9], "ja": "だが、もめごとと幸せを混同するな" },
    { "t": [201.9,  204.1], "ja": "気を悪くしないといいんだけど" },
    { "t": [204.1,  207], "ja": "君の車の右の後ろのタイヤ、少し空気が抜けてたから" },
    { "t": [207,  209.5], "ja": "穴をふさいで、空気を入れておいたよ" },
    { "t": [209.5,  211.2], "ja": "でも、一応修理工場には行ったほうがいいよ" },
    { "t": [211.2,  213.2], "ja": "私はいろんなことをしたいの。ちょっと失礼" },
    { "t": [213.2,  215.9], "ja": "美術館、オペラ、ナイトクラブ" },
    { "t": [215.9,  218.1], "ja": "時々、一日か二日いなくなるのは" },
    { "t": [218.1,  219.1], "ja": "フライフィッシングに行ってるから" },
    { "t": [219.1,  220.9], "ja": "それか、シアトル・サウンダーズの試合を見に行ってる" },
    { "t": [220.9,  224], "ja": "浮気はしないって約束する" },
    { "t": [224,  228], "ja": "あなたが、私をすぐに縛ろうとしないって約束してくれるならね" },
    { "t": [228,  230], "ja": "それなら全然かまわないよ" },
    { "t": [230,  232.7], "ja": "金曜に夕食に連れていっていいわよ" },
    { "t": [232.7,  234.7], "ja": "お願いは一つだけ" },
    { "t": [234.7,  237.1], "ja": "あの、赤いのを着てきてほしい" },
    { "t": [237.1,  238.8], "ja": "あの赤いのは着てあげる" },
    { "t": [238.8,  241.7], "ja": "あなたが、あの赤いのを着た私を見るのにふさわしくなったらね" },
    { "t": [241.7,  246.1], "ja": "よし、マフィンを作りに行かなきゃ" },
    { "t": [246.1,  249.7], "ja": "ロン、カップケーキの森のキラキラ王だよ" },
    { "t": [249.7,  252.8], "ja": "感謝する" },
    { "t": [252.8,  255.5], "ja": "それで、来週ジョーと夕食に行くの" },
    { "t": [255.5,  256.7], "ja": "それは何よりだ" },
    { "t": [256.7,  257.8], "ja": "誰かが本当にいい方向に変わるのを見るのは" },
    { "t": [257.8,  259.5], "ja": "いつだっていいものね" },
    { "t": [259.5,  261.6], "ja": "ああ、ジョーはいい男のようだ" },
    { "t": [261.6,  263.9], "ja": "だが、もう彼の話は終わりにしよう" },
    { "t": [263.9,  265.8], "ja": "あなたのことを言ってたのよ" },
    { "t": [265.8,  269.2], "ja": "家族のおかげで、あなたはもっと辛抱強くて、思いやりのある人になった" },
    { "t": [269.2,  270.6], "ja": "今の言葉を取り消せ" },
    { "t": [270.6,  271.7], "ja": "ほら、スワンソン" },
    { "t": [271.7,  273], "ja": "2年前に想像できた？" },
    { "t": [273,  274.7], "ja": "キラキラの王冠をかぶって" },
    { "t": [274.7,  276.3], "ja": "私の縁結び役をするなんて" },
    { "t": [276.3,  277.4], "ja": "今はパパでしょ" },
    { "t": [277.4,  279.5], "ja": "友だちのことも、ほんのちょっぴり気にかけてる" },
    { "t": [279.5,  282.6], "ja": "あなたはカップケーキの森のキラキラ王なの" },
    { "t": [282.6,  284.3], "ja": "よく似合ってるわ" }
  ]
}
