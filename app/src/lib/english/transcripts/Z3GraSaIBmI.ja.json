{
  "video": "Z3GraSaIBmI",
  "lines": [
    { "t": [0,  2.5], "ja": "うわあ、どの授業もすごく面白そう" },
    { "t": [2.5,  3.4], "ja": "選べないよ" },
    { "t": [3.4,  4.9], "ja": "「お試し期間」っていうのがあって" },
    { "t": [4.9,  6.8], "ja": "好きなだけいろんな授業を体験できるの" },
    { "t": [6.8,  7.8], "ja": "本当に？ うん" },
    { "t": [7.8,  11.9], "ja": "スポーツと社会、物理科学" },
    { "t": [11.9,  13.3], "ja": "「クラッシュ・コース」？" },
    { "t": [13.3,  14.9], "ja": "ええ、でも思ってるのとは違うわよ" },
    { "t": [14.9,  15.7], "ja": "へえ" },
    { "t": [15.7,  19.1], "ja": "僕は大学を卒業してない。通ってなかったからね" },
    { "t": [19.1,  20.9], "ja": "でも、自分を高めようとしてるんだ" },
    { "t": [20.9,  23.8], "ja": "だから、まずは授業を一つだけ取ってみる" },
    { "t": [23.8,  25.7], "ja": "大学の授業を取るなら、アンドリュー" },
    { "t": [25.7,  27.8], "ja": "新しい分野を探るべきだ" },
    { "t": [27.8,  29.2], "ja": "視野を広げるんだ" },
    { "t": [29.2,  31.5], "ja": "えー、視野なんてくだらない。絶対に広げちゃだめ" },
    { "t": [31.5,  32.5], "ja": "そうそう" },
    { "t": [32.5,  34.5], "ja": "得意なものを取って、楽にいい成績をもらえばいいの" },
    { "t": [34.5,  38], "ja": "悪いけど、ロン、エイプリルのやり方のほうがずっと楽そうだ" },
    { "t": [38,  40.6], "ja": "初心者向けギター" },
    { "t": [40.6,  42.4], "ja": "私は良い教育を大切にしている" },
    { "t": [42.4,  45.6], "ja": "だから、アンディには大学で時間を無駄にしてほしくない" },
    { "t": [45.6,  48.1], "ja": "同僚の中で、彼は数少ない" },
    { "t": [48.1,  50.2], "ja": "私が積極的に失敗を願っていない人間の一人だ" },
    { "t": [50.2,  53.9], "ja": "おっと、また感傷的になってしまった" },
    { "t": [53.9,  57.4], "ja": "はい、これが何と呼ばれるか分かる人は？" },
    { "t": [57.4,  58.7], "ja": "ああ、それは、えー、フレット" },
    { "t": [58.7,  59.7], "ja": "そうだね" },
    { "t": [59.7,  61.4], "ja": "それと、そこに付いてる小さいのは？" },
    { "t": [61.4,  62.7], "ja": "カポっていうんだ" },
    { "t": [62.7,  63.7], "ja": "キーを変えるやつ" },
    { "t": [63.7,  66.1], "ja": "えー、上級クラスにいたほうがいいんじゃない？" },
    { "t": [66.1,  67.8], "ja": "うん、そうかもね" },
    { "t": [67.8,  69.4], "ja": "ちょっと、やめときなって" },
    { "t": [69.4,  73.1], "ja": "でも、そんなの無理だよ、僕はただの初心者だから" },
    { "t": [73.1,  76.9], "ja": "「ゴーター」なんて、ほとんど見たこともないし" },
    { "t": [76.9,  78.2], "ja": "はい" },
    { "t": [78.2,  81.7], "ja": "最初の4週間は、基本のコードを練習します" },
    { "t": [81.7,  84], "ja": "うそだろ、4週間も" },
    { "t": [84,  85.2], "ja": "もう退屈だよ" },
    { "t": [85.2,  86], "ja": "当然だ" },
    { "t": [86,  88], "ja": "自分に挑戦していないからな" },
    { "t": [88,  90.9], "ja": "他の授業もいくつか体験してみるといい" },
    { "t": [90.9,  91.9], "ja": "いいよ" },
    { "t": [91.9,  93], "ja": "よろしい" },
    { "t": [96.9,  97.7], "ja": "さようなら、みんな" },
    { "t": [97.7,  98.7], "ja": "実はね" },
    { "t": [98.7,  101.3], "ja": "ずっと、こっそり正体を隠したロックスターだったんだ" },
    { "t": [103.7,  104.7], "ja": "言っておくけど" },
    { "t": [104.7,  107.8], "ja": "君は茶髪もきっとすごく似合うよ" },
    { "t": [107.8,  108.8], "ja": "ロン・スワンソン" },
    { "t": [111.4,  112.6], "ja": "皆さん、こんにちは" },
    { "t": [112.6,  114], "ja": "バーンズ教授です" },
    { "t": [114,  116.2], "ja": "今学期、私が教えるのは" },
    { "t": [116.2,  118.2], "ja": "レーザー入門です" },
    { "t": [118.2,  120.4], "ja": "「レーザー」という言葉は" },
    { "t": [120.4,  124.6], "ja": "「放射の誘導放出による光の増幅」の略です" },
    { "t": [124.6,  126], "ja": "レーザーはどこ？" },
    { "t": [126,  127.6], "ja": "この図が表しているのは" },
    { "t": [127.6,  130.6], "ja": "電磁波のスペクトルで、低い周波数から並べて…" },
    { "t": [130.6,  132.8], "ja": "レーザーポインターすら使ってない" },
    { "t": [132.8,  134.5], "ja": "その通り。この授業はつまらない" },
    { "t": [134.5,  136.8], "ja": "続けてみろ。何か学べるかもしれない" },
    { "t": [136.8,  138.6], "ja": "すみません、教授？" },
    { "t": [138.6,  140], "ja": "どうも。アンディ・ドワイヤーです" },
    { "t": [140,  142.7], "ja": "気になるんですけど、いつレーザーを出して" },
    { "t": [142.7,  143.7], "ja": "遊ばせてくれるんですか？" },
    { "t": [143.7,  145.4], "ja": "それと、小さいレーザーから始めるんですか？" },
    { "t": [145.4,  147.4], "ja": "それとも、いきなり大きいレーザーで" },
    { "t": [147.4,  149.4], "ja": "遊べるんですか？" },
    { "t": [149.4,  151.1], "ja": "この授業では、本物のレーザーは使いません" },
    { "t": [151.1,  153], "ja": "レーザーを可能にする理論についての授業です" },
    { "t": [155,  159.2], "ja": "人生で一番がっかりしたことの一つだ" },
    { "t": [159.2,  160.1], "ja": "おお、見て" },
    { "t": [160.1,  162.7], "ja": "校内のフリスビーゴルフで単位がもらえるんだって" },
    { "t": [162.7,  163.7], "ja": "はいはい" },
    { "t": [163.7,  165.8], "ja": "南北戦争の授業も取れる" },
    { "t": [165.8,  168.2], "ja": "なんで、もう起きたことの授業なんて取るの？" },
    { "t": [168.2,  170], "ja": "いいかい、二人とももう意見は言ったよね" },
    { "t": [170,  173], "ja": "今度は、僕がやってみたいことをやってみたい" },
    { "t": [173,  177.4], "ja": "だから、いつもどおり、適当に選ぶよ" },
    { "t": [181.4,  184.7], "ja": "火あぶりにされたとき、ジャンヌ・ダルクはひるまなかった" },
    { "t": [184.7,  185.9], "ja": "命ごいもしなかった" },
    { "t": [185.9,  191.3], "ja": "力強く、はっきりした声でこう言った。「私は怖くない" },
    { "t": [191.3,  192.9], "ja": "このために生まれてきたのだ」" },
    { "t": [192.9,  194], "ja": "私も火あぶりになりたい" },
    { "t": [194,  197.4], "ja": "多くの社会制度は、ひたすら" },
    { "t": [197.4,  198.9], "ja": "女性を抑圧するために作られました" },
    { "t": [198.9,  203.3], "ja": "今日でも、結婚を美化された奴隷制度だと" },
    { "t": [203.3,  205.8], "ja": "非難するフェミニストさえいます" },
    { "t": [205.8,  208.4], "ja": "そのとおり" },
    { "t": [208.4,  210.2], "ja": "あの授業、最高だった" },
    { "t": [210.2,  212.4], "ja": "心から同意する" },
    { "t": [212.4,  214.8], "ja": "あの女性が、あれほど激しく結婚に反対していなければ" },
    { "t": [214.8,  217.5], "ja": "プロポーズしたいくらいだ" },
    { "t": [217.5,  219.1], "ja": "じゃあ、決まりだね" },
    { "t": [219.1,  221.8], "ja": "アンディ・ドワイヤーは「女性レーザー」を取ります" },
    { "t": [221.8,  223.3], "ja": "女性学よ" },
    { "t": [223.3,  226.3], "ja": "ごめん、もう、レーザーのことが頭から離れなくて" },
    { "t": [226.3,  228.5], "ja": "女性学ね。「女性レーザー」なんてものはあるの？" },
    { "t": [228.5,  229.9], "ja": "あったら、私の一番のおすすめね" }
  ]
}
