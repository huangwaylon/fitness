{
  "video": "33Z9lQQywjg",
  "lines": [
    { "t": [0, 1.8], "ja": "どいて、どいて、みんな！" },
    { "t": [1.8, 3.8], "ja": "やる気応援隊だ！通るよ！" },
    { "t": [3.8, 5.8], "ja": "ホーホー！" },
    { "t": [5.8, 8.6], "ja": "じゃあ、二人で一緒にトレーニングしに行くのか" },
    { "t": [8.6, 10.4], "ja": "いいね。どこで？" },
    { "t": [10.4, 12.7], "ja": "コミュニティカレッジ。ああ、それは遠すぎる" },
    { "t": [12.7, 14.4], "ja": "クリスとトムが、警察官になるための" },
    { "t": [14.4, 16.6], "ja": "トレーニングを手伝ってくれることになったんだ" },
    { "t": [16.6, 18.9], "ja": "体力テストまで、あと3か月くらい" },
    { "t": [18.9, 21.4], "ja": "今の僕は体力がひどいけど" },
    { "t": [21.4, 23.5], "ja": "これはもうできるんだ" },
    { "t": [26.2, 29.1], "ja": "だから、少しずつ近づいてる" },
    { "t": [29.1, 31], "ja": "警察学校に入るためにできないといけないことの" },
    { "t": [31, 32.3], "ja": "リストをもらったんだけど" },
    { "t": [32.3, 35], "ja": "一つ目が、2マイルを" },
    { "t": [35, 36.8], "ja": "25分以内で走れること" },
    { "t": [36.8, 39], "ja": "これ、書き間違いだよね？だって、人間には無理だよ" },
    { "t": [39, 42.2], "ja": "心と体を集中させることができれば" },
    { "t": [42.2, 43.5], "ja": "何だって可能なんだ" },
    { "t": [43.5, 47.3], "ja": "何だって可能だ！" },
    { "t": [47.3, 49.1], "ja": "行け、アンディ。行け。君ならできる" },
    { "t": [49.1, 50.9], "ja": "行け、行け、行け、行け、行け、行け、行け、行け、行け" },
    { "t": [50.9, 52.5], "ja": "君ならできる、アンディ。踏んばれ、踏んばれ、踏んばれ" },
    { "t": [52.5, 54.1], "ja": "うわあ！やった！" },
    { "t": [54.1, 56.3], "ja": "うわ、すごくセクシー" },
    { "t": [56.3, 58.2], "ja": "ひどかった" },
    { "t": [58.2, 60.1], "ja": "ああ、死にそう" },
    { "t": [60.1, 61.9], "ja": "すごく疲れた" },
    { "t": [61.9, 64.2], "ja": "全身が痛い" },
    { "t": [64.2, 65.6], "ja": "走るなんて無理だ" },
    { "t": [65.6, 68.4], "ja": "何してるんだ？" },
    { "t": [68.4, 70.7], "ja": "トム、今は批判する時じゃない" },
    { "t": [70.7, 71.7], "ja": "どうだった？" },
    { "t": [71.7, 73.1], "ja": "アンディの2マイル走のタイムは" },
    { "t": [73.1, 75.2], "ja": "29分43秒だった" },
    { "t": [75.2, 76.4], "ja": "そんな！" },
    { "t": [76.4, 78], "ja": "僕は絶対に警官になれない" },
    { "t": [78, 80.4], "ja": "泥棒になるしかない" },
    { "t": [80.4, 81.9], "ja": "おいおい、がんばれよ" },
    { "t": [81.9, 83.1], "ja": "俺は車で回ってくる" },
    { "t": [83.1, 87.1], "ja": "アンディ、君を誇りに思う" },
    { "t": [87.1, 89.1], "ja": "君がやったことにじゃない。それはひどかった" },
    { "t": [89.1, 92.3], "ja": "これから私が君にやらせられることに、だ" },
    { "t": [92.3, 93.7], "ja": "つまり、自分を誇りに思ってるんだな" },
    { "t": [93.7, 95.2], "ja": "ありがとう。僕もだよ" },
    { "t": [95.2, 97.2], "ja": "やることがたくさんあるな" }
  ]
}
