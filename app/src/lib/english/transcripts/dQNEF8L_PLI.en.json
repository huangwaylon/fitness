{"video":"dQNEF8L_PLI","lines":[{"t":[0,2],"en":"I couldn't do that to her. She's my best friend."},{"t":[2.4,3.8],"en":"Well, Joey's my best friend."},{"t":[4.6,5.8],"en":"I'm not your best friend."},{"t":[7.9,9.8],"en":"You just said..."},{"t":[9.8,12.4],"en":"Of course you're my best friend."},{"t":[13.8,15.4],"en":"Would you please tell Rachel, though?"},{"t":[16,18],"en":"All right. At least I'm prepared."},{"t":[18.3,18.6],"en":"Okay."},{"t":[20.5,21.3],"en":"Oh, yes."},{"t":[21.6,21.8],"en":"Hey!"},{"t":[22.3,22.9],"en":"Hey, hey!"},{"t":[23.8,25.3],"en":"These aren't for you. Are you upset?"},{"t":[25.5,26.3],"en":"I am now."},{"t":[29.5,30.5],"en":"Hey, roomie."},{"t":[31.5,32.5],"en":"Okay, bye."},{"t":[36.6,39.3],"en":"Rach, there's something, um,"},{"t":[39.9,41.1],"en":"important I have to tell you."},{"t":[41.6,42.6],"en":"Are you pregnant?"},{"t":[44.3,46.1],"en":"No, but I'm throwing this shirt away."},{"t":[47.9,49.3],"en":"I think there was a little, um,"},{"t":[49.3,50.4],"en":"misunderstanding before."},{"t":[50.6,50.9],"en":"Mm-hmm."},{"t":[51.4,53.3],"en":"Um, when I said that, uh,"},{"t":[53.8,55.7],"en":"that Chandler and I wanted to, um,"},{"t":[55.7,56.4],"en":"live together,"},{"t":[57.1,59.4],"en":"we meant alone"},{"t":[59.4,60.1],"en":"together."},{"t":[62.7,63.8],"en":"Oh, God."},{"t":[64.5,65.5],"en":"Oh, my God."},{"t":[65.8,66.7],"en":"Oh, that's funny."},{"t":[66.8,67.7],"en":"I can't believe I did that."},{"t":[67.7,68.4],"en":"Oh, no, sweetie."},{"t":[68.7,69.5],"en":"No, you know what?"},{"t":[69.5,70.4],"en":"This is my fault."},{"t":[70.5,71.8],"en":"I-I wasn't clear."},{"t":[72,73.8],"en":"I-I'm really sorry."},{"t":[74.6,75.9],"en":"And, hey, listen."},{"t":[76.6,78.1],"en":"You take as much time as you need"},{"t":[78.1,78.8],"en":"to move out, okay?"},{"t":[79,80.7],"en":"There's absolutely no rush."},{"t":[82.1,82.5],"en":"Okay."},{"t":[82.5,94.8],"en":"I-I-I-I-I-I-I-I-I-I-I-I-I-I."},{"t":[94.8,124.8],"en":"Thank you."}]}
