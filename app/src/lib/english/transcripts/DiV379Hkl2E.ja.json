{
  "video": "DiV379Hkl2E",
  "lines": [
    { "t": [1,  2], "ja": "やあ、ジャニス" },
    { "t": [2,  4.5], "ja": "ああ、もう。電話してくれて本当にうれしい" },
    { "t": [4.5,  7.8], "ja": "最高に最悪な一日だったの" },
    { "t": [9.8,  11.3], "ja": "おや、それはよくないね" },
    { "t": [12.3,  15.3], "ja": "すみません、エスプレッソとラテをお願い" },
    { "t": [15.3,  17.3], "ja": "ねえ、あの撮影の試し刷りが戻ってきたの" },
    { "t": [17.3,  18.8], "ja": "ほら、小さな野菜のやつ" },
    { "t": [18.8,  20.1], "ja": "とにかく、ほぼ最悪の出来だった" },
    { "t": [20.1,  21.8], "ja": "だから午後の仕事はすっぽかして" },
    { "t": [21.8,  23.2], "ja": "買い物に行ったの" },
    { "t": [23.2,  26.4], "ja": "それで、あなたに買ってきたの" },
    { "t": [30.9,  32.9], "ja": "あなたに買ってきたのよ" },
    { "t": [35.9,  37.9], "ja": "…どこに入れたっけ？" },
    { "t": [37.9,  42.9], "ja": "これを買ってきたの" },
    { "t": [42.9,  44.9], "ja": "ブルウィンクルの靴下" },
    { "t": [44.9,  45.9], "ja": "すごく優しいね" },
    { "t": [45.9,  47.9], "ja": "ほら、ロッキーのは持ってるって知ってたから、思ったの" },
    { "t": [47.9,  49.9], "ja": "ブルウィンクルとブルウィンクルで履いてもいいし" },
    { "t": [49.9,  51.9], "ja": "ロッキーとロッキーで履いてもいいし" },
    { "t": [51.9,  54.9], "ja": "ヘラジカとリスを組み合わせてもいいって" },
    { "t": [54.9,  56.9], "ja": "好きなようにね" },
    { "t": [59.8,  63.8], "ja": "じゃあ、エスプレッソをもう一杯もらうわ" },
    { "t": [63.8,  64.8], "ja": "ラテのおかわりは？" },
    { "t": [64.8,  65.8], "ja": "いや" },
    { "t": [65.8,  66.8], "ja": "いや" },
    { "t": [66.8,  69.8], "ja": "まだ飲んでるところだから" },
    { "t": [69.8,  71.8], "ja": "それだけ？" },
    { "t": [71.8,  72.8], "ja": "ああ、本当につらかったよ" },
    { "t": [72.8,  74.8], "ja": "ああ、あのハグは相当きつそうだったね" },
    { "t": [74.8,  75.8], "ja": "はいはい" },
    { "t": [75.8,  76.8], "ja": "お前はその場にいなかっただろ" },
    { "t": [76.8,  77.8], "ja": "その場にいなかっただろ" }
  ]
}
