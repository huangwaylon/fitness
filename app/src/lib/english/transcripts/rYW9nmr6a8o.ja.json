{
  "video": "rYW9nmr6a8o",
  "lines": [
    { "t": [0,  8.5], "ja": "今度は南極だ！" },
    { "t": [8.5,  10], "ja": "氷が降ってる！" },
    { "t": [10,  11.5], "ja": "今、ペンギンを見たな" },
    { "t": [11.5,  14.4], "ja": "小さな執事みたいだけど、話はできない" },
    { "t": [14.4,  16.4], "ja": "トイレに行く時間ある？" },
    { "t": [16.4,  17.2], "ja": "ない！" },
    { "t": [17.2,  18.4], "ja": "走りながらしろ、カーリー！" },
    { "t": [18.4,  21.4], "ja": "走りながらしろ！" },
    { "t": [21.4,  26.2], "ja": "はい、私のかわいいリース軍団、緊急のお直しを4回して" },
    { "t": [26.2,  29], "ja": "「リスペクト」をアカペラで何回も歌って" },
    { "t": [29,  31.3], "ja": "やっと準備はできた？" },
    { "t": [31.3,  32.8], "ja": "できたわ！" },
    { "t": [32.8,  33.8], "ja": "ひゅー！" },
    { "t": [33.8,  37.8], "ja": "しかも最高にきれい！" },
    { "t": [37.8,  39.9], "ja": "ハニー、最高に仕上げてくれたわね" },
    { "t": [42.4,  48], "ja": "私はクリスマスの…ジングル！" },
    { "t": [48,  50], "ja": "ハーパーにはこれが無理だなんて言った人は" },
    { "t": [50,  53], "ja": "本当に見当違いだったわね" },
    { "t": [53,  56.7], "ja": "でも、お嬢さんたち、私が見事にあなたたちを" },
    { "t": [56.7,  58.7], "ja": "ウィザースプーン映画の世界に織り込んだ話は" },
    { "t": [58.7,  60], "ja": "いくらでもできるけど" },
    { "t": [60,  62.1], "ja": "早く行かないと、女装ナイトに遅れちゃうわよ" },
    { "t": [62.1,  66.8], "ja": "ああ、女装ナイト！" },
    { "t": [66.8,  68.7], "ja": "中止になったの" },
    { "t": [68.7,  70.5], "ja": "ええ、司会から2時間前に電話があったの" },
    { "t": [70.5,  71.5], "ja": "クラブが売られちゃって" },
    { "t": [71.5,  75.9], "ja": "ベビー服のお店になるんだって" },
    { "t": [75.9,  78.5], "ja": "じゃあ、この苦労は全部むだだったの？" },
    { "t": [78.5,  80.9], "ja": "待って、じゃあなんであんな派手な登場をしたの？" },
    { "t": [80.9,  81.8], "ja": "それが私たちのさがなの" },
    { "t": [81.8,  82.8], "ja": "うそでしょ" },
    { "t": [82.8,  94.7], "ja": "こんなこと、絶対に許さない人って誰だと思う？" },
    { "t": [94.7,  96.2], "ja": "リース・ウィザースプーンよ" },
    { "t": [96.2,  103.7], "ja": "女装ナイトは絶対に開いてあげる。たとえ誰かの首をへし折ってでもね" },
    { "t": [103.7,  109.4], "ja": "オーディションにリムジンで行くの？" },
    { "t": [109.4,  110.4], "ja": "ああ" },
    { "t": [110.4,  111.9], "ja": "そのほうが早く着く" },
    { "t": [111.9,  112.8], "ja": "車が長いからな" },
    { "t": [112.8,  113.7], "ja": "理屈は通ってる" },
    { "t": [113.7,  116.1], "ja": "じゃあ、なんで前の席に座ってるの？" },
    { "t": [116.1,  117.5], "ja": "そのほうが早く着くからさ" },
    { "t": [117.5,  118], "ja": "話についてこいよ！" },
    { "t": [118,  120], "ja": "どうも、カーリーです" },
    { "t": [120,  121], "ja": "ラウルです" },
    { "t": [121,  124.9], "ja": "初日から有名人を乗せられるなんて、信じられますか？" },
    { "t": [124.9,  125.7], "ja": "初日？" },
    { "t": [125.7,  128.6], "ja": "妻がサンドイッチを作ってくれたんです" },
    { "t": [128.6,  133.1], "ja": "ディルがちょうどいい具合の卵サラダが好きなら、お楽しみですよ" },
    { "t": [133.1,  137.1], "ja": "ラウル、運転してほしいんだ。奥さんのサンドイッチを忘れたって気づいたときみたいに" },
    { "t": [137.1,  138.1], "ja": "家にね" },
    { "t": [138.1,  139.1], "ja": "ああ" },
    { "t": [139.1,  140.1], "ja": "それ、本当にありそうで怖い" },
    { "t": [140.1,  141.1], "ja": "君ならできるよ、ラウル" },
    { "t": [141.1,  142.1], "ja": "はい！" },
    { "t": [142.1,  145.1], "ja": "本当にリムジンに乗ってるなんて信じられない！" },
    { "t": [145.1,  146.1], "ja": "ひゃっほー！" },
    { "t": [146.1,  151.3], "ja": "目的地まで、あと17分です" },
    { "t": [151.3,  153.2], "ja": "800メートル先、右に曲がってください" },
    { "t": [153.2,  154.2], "ja": "そうだ、ラウル" },
    { "t": [154.2,  155.2], "ja": "この先を左に曲がって" },
    { "t": [155.2,  156.2], "ja": "カット" },
    { "t": [156.2,  157.2], "ja": "何？" },
    { "t": [157.2,  158.2], "ja": "だめ" },
    { "t": [158.2,  159.2], "ja": "ナビが、はっきり言ってるのに…" },
    { "t": [159.2,  160.2], "ja": "新しいルートを検出しました" },
    { "t": [160.2,  162.2], "ja": "到着まで、あと23分です" },
    { "t": [162.2,  163.2], "ja": "おお" },
    { "t": [163.2,  164.2], "ja": "リムジンの時間が増えた" },
    { "t": [164.2,  165.2], "ja": "スペンサー" },
    { "t": [165.2,  166.2], "ja": "大丈夫" },
    { "t": [166.2,  167.2], "ja": "大丈夫" },
    { "t": [167.2,  168.2], "ja": "あ、ねえ、右に曲がって" },
    { "t": [168.2,  169.2], "ja": "右に曲がります" },
    { "t": [169.2,  171.2], "ja": "到着まで、あと31分です" },
    { "t": [171.2,  173.2], "ja": "ラウル、スペンサーの言うことは聞かないで" },
    { "t": [173.2,  174.2], "ja": "高速に乗って" },
    { "t": [174.2,  175.2], "ja": "だめだ" },
    { "t": [175.2,  176.2], "ja": "ラウル、カーリーの言うことは聞くな" },
    { "t": [176.2,  177.2], "ja": "あいつはいつも間違ってる" },
    { "t": [177.2,  178.2], "ja": "私のことを少し言わせてもらうと" },
    { "t": [178.2,  180.2], "ja": "もめごとがあると、湿疹がひどくなるんです" },
    { "t": [180.2,  182.2], "ja": "どなたか、私の塗り薬を取ってもらえますか" },
    { "t": [182.2,  184.6], "ja": "卵サラダのすぐ隣にあります" },
    { "t": [184.6,  186.6], "ja": "お願いだから、高速に乗ってくれない？" },
    { "t": [186.6,  187.6], "ja": "そのほうが早いの" },
    { "t": [187.6,  188.6], "ja": "入口は右よ" },
    { "t": [188.6,  189.6], "ja": "いや、バラード橋を通って" },
    { "t": [189.6,  190.6], "ja": "遅れた分を取り戻せる" },
    { "t": [190.6,  191.6], "ja": "左に曲がって" },
    { "t": [191.6,  193.6], "ja": "たまには私の言うことを聞いてくれない？" },
    { "t": [193.6,  194.6], "ja": "左ですか、右ですか？" },
    { "t": [194.6,  195.6], "ja": "右！" },
    { "t": [195.6,  196.6], "ja": "ラウル、今すぐ左に曲がれ！" },
    { "t": [196.6,  197.6], "ja": "なんで止まったの？" },
    { "t": [197.6,  198.6], "ja": "どうしたの？" },
    { "t": [198.6,  199.6], "ja": "バラード橋" },
    { "t": [199.6,  200.6], "ja": "フェリー通過のため上げられています" },
    { "t": [200.6,  201.6], "ja": "到着まで、あと57分です" },
    { "t": [201.6,  202.6], "ja": "なんてことだ" },
    { "t": [202.6,  205.6], "ja": "橋が真っ二つに割れる！" },
    { "t": [205.6,  209.6], "ja": "ラウル、ほら、塗り薬" },
    { "t": [209.6,  222.6], "ja": "スペンサー・シェイ！" },
    { "t": [222.6,  223.6], "ja": "カーリー・シェイ！" },
    { "t": [223.6,  224.6], "ja": "着いたよ" },
    { "t": [224.6,  225.6], "ja": "間に合った" },
    { "t": [225.6,  228.6], "ja": "あら、オーディションの課題は20分前に始まりました" },
    { "t": [228.6,  230.6], "ja": "申し訳ないけど、失格です" },
    { "t": [230.6,  233.6], "ja": "うそでしょ、ここまで来るのにあんなに頑張ったのに" },
    { "t": [233.6,  235.6], "ja": "これで、あっさり終わり？" },
    { "t": [235.6,  241.6], "ja": "有名人だから、オーディションの手順をほとんど飛ばせたってこと？" },
    { "t": [241.6,  243.6], "ja": "自分が恵まれてるのは認めるよ" },
    { "t": [243.6,  245.6], "ja": "言いにくいけど、カーリー、全部お前のせいだ" },
    { "t": [245.6,  246.6], "ja": "謝ってくれてありがとう" },
    { "t": [246.6,  248.6], "ja": "私のせい？" },
    { "t": [248.6,  249.6], "ja": "ナビを無視したのはそっちでしょ" },
    { "t": [249.6,  251.6], "ja": "ああ、ナビが知ってて、俺が知らないことなんてある？" },
    { "t": [251.6,  252.6], "ja": "全部よ！" },
    { "t": [252.6,  255.6], "ja": "ナビは全部知ってるの！" },
    { "t": [259.6,  260.6], "ja": "今の、デコピン？" },
    { "t": [268.6,  269.6], "ja": "みんな、みんな、みんな！" },
    { "t": [269.6,  273.6], "ja": "この兄妹げんか、すごくいいわ" },
    { "t": [273.6,  275.6], "ja": "課題に戻ってほしいの" },
    { "t": [275.6,  277.6], "ja": "それに、僕のベッドにも来てほしい" },
    { "t": [277.6,  278.6], "ja": "おっと" },
    { "t": [278.6,  281.6], "ja": "今のはすごく不適切だった" },
    { "t": [281.6,  283.6], "ja": "でも、わざと言ったんです" },
    { "t": [284.6,  285.6], "ja": "ねえ、彼を連れていっていいよ" },
    { "t": [285.6,  287.6], "ja": "もう彼の相手はできない" },
    { "t": [287.6,  288.6], "ja": "ああ、生々しいのは分かってる" },
    { "t": [288.6,  290.6], "ja": "つらいのも分かってる" },
    { "t": [290.6,  294.6], "ja": "でも、それはカメラの前まで取っておいて" },
    { "t": [294.6,  295.6], "ja": "お前は外れろ" },
    { "t": [295.6,  298.6], "ja": "あなた、動画の配信者でしょ？" },
    { "t": [298.6,  304.6], "ja": "うちの番組の出場者には、新しいフォロワーが100万人以上つく人もいるのよ" },
    { "t": [304.6,  307.6], "ja": "課題やろうよ、兄貴" },
    { "t": [307.6,  309.6], "ja": "とても簡単よ" },
    { "t": [309.6,  314.6], "ja": "パチンコでメロンを飛ばして的を倒せば、レースに出られるの" },
    { "t": [314.6,  317.6], "ja": "あの的って、赤ちゃんを抱いたお母さん？" },
    { "t": [317.6,  321.6], "ja": "ええ、消防署が救助の練習に使うものなの" },
    { "t": [322.6,  324.6], "ja": "で、どっちが果物を飛ばす？" },
    { "t": [324.6,  325.6], "ja": "私" },
    { "t": [325.6,  326.6], "ja": "わかったよ！" },
    { "t": [327.6,  329.6], "ja": "俺のメロンの腕は、後に取っておくよ" },
    { "t": [338.6,  339.6], "ja": "だめ！" },
    { "t": [339.6,  340.6], "ja": "的に当たった？" },
    { "t": [340.6,  341.6], "ja": "いいえ！" },
    { "t": [341.6,  343.6], "ja": "同僚のベンジャミンに当たったのよ！" },
    { "t": [343.6,  345.6], "ja": "どうも、アイカーリーのミランダ・コスグローブです" },
    { "t": [345.6,  346.6], "ja": "見てくれてありがとう" },
    { "t": [346.6,  348.6], "ja": "いいねとチャンネル登録をよろしくね" }
  ]
}
