{
  "video": "iz6p2OgH-Z4",
  "lines": [
    { "t": [0,  0.8], "ja": "どうかな" },
    { "t": [0.8,  1.8], "ja": "だって、よく考えてみると" },
    { "t": [1.8,  3.2], "ja": "カボって、まさに発展途上国だろ" },
    { "t": [3.2,  5.7], "ja": "ああいう所に、わざわざ貧しさを見に行くわけじゃないんだよ" },
    { "t": [5.7,  7], "ja": "行けば、華やかさが味わえるってわけさ" },
    { "t": [7,  8.8], "ja": "やあ" },
    { "t": [8.8,  10.3], "ja": "マイク？ やあ" },
    { "t": [10.3,  11.3], "ja": "ここで何してるの？" },
    { "t": [11.3,  13.9], "ja": "いや、ほら、パーティーの誘いに乗ってみたんだよ" },
    { "t": [13.9,  15.6], "ja": "じゃーん" },
    { "t": [15.6,  18.8], "ja": "最高だね。よし" },
    { "t": [18.8,  21.4], "ja": "しかも、この人も連れてきたんだ。ああ" },
    { "t": [21.4,  24.6], "ja": "おお！" },
    { "t": [24.6,  26.2], "ja": "ライアン、マイケルとドワイトだよ" },
    { "t": [26.2,  27.7], "ja": "二人なのは分かってるよ。そうか" },
    { "t": [27.7,  29.1], "ja": "来てくれて、すごくうれしいよ" },
    { "t": [29.1,  33.3], "ja": "よし、一杯やろう" },
    { "t": [33.3,  34.2], "ja": "そうしよう" },
    { "t": [36.8,  39.3], "ja": "みんな、すごく仲のいい友だちを紹介するよ" },
    { "t": [39.3,  40.2], "ja": "トロイだ" },
    { "t": [40.2,  42.3], "ja": "やあ、はじめまして。元気？" },
    { "t": [42.3,  44.3], "ja": "やあ、ドワイト" },
    { "t": [44.3,  46.2], "ja": "トールキンの登場人物に似てるね" },
    { "t": [46.2,  47.7], "ja": "ああ、ほぼそのものだよ" },
    { "t": [47.7,  49.2], "ja": "まさに銀行の魔法使いさ" },
    { "t": [49.2,  50.6], "ja": "いや、いや、いや、魔法使いじゃない" },
    { "t": [50.6,  52.6], "ja": "ホビットだ" },
    { "t": [52.6,  54], "ja": "ボトルでご注文ですか？" },
    { "t": [54,  55.1], "ja": "ああ、そうか" },
    { "t": [55.1,  58.2], "ja": "とにかく、チキンフィンガーを" },
    { "t": [58.2,  59.4], "ja": "それとメロンリキュールのサワーを頼む" },
    { "t": [59.4,  61.4], "ja": "当店はお食事は出していません" },
    { "t": [61.4,  62.4], "ja": "ああ、そうか" },
    { "t": [62.4,  64.3], "ja": "じゃあ、カップを2つ持ってきてくれ" },
    { "t": [64.3,  68.3], "ja": "1つはオリーブ、もう1つはカクテル用のチェリーでいっぱいにして" },
    { "t": [70.3,  73.3], "ja": "普通サイズの家に住んでるの？" },
    { "t": [73.3,  74.4], "ja": "うん、普通のやつだよ" },
    { "t": [74.4,  75.4], "ja": "いいやつさ" },
    { "t": [75.4,  77.4], "ja": "待って、シュルート" },
    { "t": [77.4,  78.4], "ja": "シュルート農場はどう？" },
    { "t": [78.4,  79.3], "ja": "順調だ" },
    { "t": [79.3,  81.9], "ja": "こいつ、自分のビート農場を持ってるんだ" },
    { "t": [81.9,  82.8], "ja": "すげえ" },
    { "t": [82.8,  85.1], "ja": "まあ、ゾウムシの季節だが、備えはできていた" },
    { "t": [85.1,  86.3], "ja": "ゾウムシ？" },
    { "t": [86.3,  88], "ja": "変な言葉だな" },
    { "t": [88,  89.2], "ja": "意味すら分からないよ" },
    { "t": [89.2,  90.2], "ja": "どういう意味？" },
    { "t": [90.2,  92.9], "ja": "熟していないビートの根の中に卵を産むんだ" },
    { "t": [92.9,  95.1], "ja": "そして春になると、幼虫が中から食い破って出てくる" },
    { "t": [95.1,  96.3], "ja": "すげえ！" },
    { "t": [96.3,  98.5], "ja": "俺にはちょっと刺激が強すぎるよ" },
    { "t": [98.5,  99.8], "ja": "トイレに行ってくる" },
    { "t": [99.8,  101.3], "ja": "もう何回も行ってるじゃないか" },
    { "t": [101.3,  102.8], "ja": "そう？" },
    { "t": [102.8,  104.4], "ja": "ぼうこうの病気か何かかもしれないぞ" },
    { "t": [104.4,  105.5], "ja": "さあね、そうかもね" },
    { "t": [105.5,  107.4], "ja": "クランベリージュースを頼んでおく" },
    { "t": [107.4,  108.8], "ja": "ウォッカでね、最高だよ" },
    { "t": [110.9,  112.3], "ja": "何か特別な力はあるの？" },
    { "t": [112.3,  132.6], "ja": "なあ、あんた最高だよ" }
  ]
}
