  "lines": [
    { "t": [0, 3.9], "ja": "3時間のツアー、3時間のツアー" },
    { "t": [4.2, 5.7], "ja": "パム、君はメアリー・アンだ" },
    { "t": [5.9, 8], "ja": "教授とジンジャーもいる" },
    { "t": [8.5, 9.6], "ja": "ようこそ" },
    { "t": [10.1, 13.9], "ja": "アンジェラ、君はハウエル夫人だ。愛しい人、地元の人" },
    { "t": [14.3, 15.4], "ja": "時々、近くから来るんだ" },
    { "t": [16, 18.7], "ja": "おお、グローブトロッターズの一人もいるぞ" },
    { "t": [18.9, 19.9], "ja": "私は船長だ" },
    { "t": [20.4, 22.4], "ja": "そしてドワイト、君はギリガンだ" },
    { "t": [22.8, 23.3], "ja": "いいね" },
    { "t": [23.5, 24.8], "ja": "実は、僕が船長です" },
    { "t": [25, 25.9], "ja": "でも、あなたはギリガンになれますよ" },
    { "t": [26, 27], "ja": "ああ、死んだほうがましだ" },
    { "t": [27.3, 28.8], "ja": "どうも、マイケル・スコットです" },
    { "t": [28.8, 30.4], "ja": "このパーティーの船長です" },
    { "t": [30.9, 32], "ja": "私はキャプテン・ジャックだ" },
    { "t": [32.1, 32.9], "ja": "この船の船長だ" },
    { "t": [33.1, 35.2], "ja": "この船に足を踏み入れた全員の船長でもある" },
    { "t": [35.3, 36], "ja": "どうも、ようこそ" },
    { "t": [37.3, 37.7], "ja": "はい" },
    { "t": [38.3, 40.2], "ja": "会社の中で、人を順位づけするなら" },
    { "t": [40.7, 43], "ja": "部長のほうが船長より上だ" },
    { "t": [43.7, 45.2], "ja": "船の上では、どうだろう？" },
    { "t": [45.5, 46.5], "ja": "あいまいだな" },
    { "t": [48.3, 48.8], "ja": "ねえ、見て" },
    { "t": [49.4, 50.8], "ja": "僕は世界の王様だ！" },
    { "t": [57.6, 61.6], "ja": "よし、分かった" },
    { "t": [62.4, 63.3], "ja": "ようこそ" },
    { "t": [63.6, 65.5], "ja": "私が船長の、キャプテン・ジャックです" },
    { "t": [65.9, 69.9], "ja": "そして私が、ダンダー・ミフリンの地域部長、マイケル・スコットです" },
    { "t": [70.3, 71], "ja": "ようこそ、ようこそ" },
    { "t": [71.2, 75.3], "ja": "はい、では、救命胴衣について" },
    { "t": [75.6, 78.2], "ja": "船の周りの、座席の下に置いてあります" },
    { "t": [78.2, 81], "ja": "心配いりません、今夜は救命胴衣は必要ありませんよ" },
    { "t": [81, 81.6], "ja": "まあ、必要になるかもしれないけど" },
    { "t": [81.6, 81.9], "ja": "ただ…" },
    { "t": [81.9, 82.7], "ja": "はい、最後まで言わせてください" },
    { "t": [82.7, 83.3], "ja": "まあ…" },
    { "t": [83.3, 84.9], "ja": "はい、ありがとう" },
    { "t": [85.5, 88.4], "ja": "沿岸警備隊の決まりで、非常口の場所をお伝えしないといけません" },
    { "t": [88.7, 90.1], "ja": "この船では、とても簡単です" },
    { "t": [90.2, 91.5], "ja": "船べりからならどこでも" },
    { "t": [92.8, 96.6], "ja": "私は皆さんの船の船長であるだけでなく、パーティーの船長でもあります！" },
    { "t": [97, 97.2], "ja": "いえーい！" },
    { "t": [97.3, 98.6], "ja": "あと数分で盛り上げていきますよ" },
    { "t": [98.6, 100.7], "ja": "私もパーティーの船長だ！" },
    { "t": [100.8, 103.5], "ja": "あとで、みんなダンスシューズをはくことになるぞ！" },
    { "t": [103.5, 104.1], "ja": "はい、マイク、マイク、マイク" },
    { "t": [104.1, 105.1], "ja": "それで、これから…" },
    { "t": [105.1, 106.2], "ja": "ああ、よかったら、いいかな？" },
    { "t": [106.2, 107.3], "ja": "盛り上げろ！" },
    { "t": [107.4, 107.6], "ja": "何？" },
    { "t": [108, 109], "ja": "お願いします、いいですか？" },
    { "t": [109.6, 112], "ja": "船が揺れてたら、ノックはするな！" },
    { "t": [112.5, 112.8], "ja": "マイケル" },
    { "t": [112.9, 113.1], "ja": "ああ" },
    { "t": [113.6, 116.6], "ja": "えっと、今夜この船に乗っているのは、あなたの会社の社員だけじゃないんですよ、いいですか？" },
    { "t": [116.7, 117.9], "ja": "みんなで楽しい時間を過ごしましょう" },
    { "t": [118, 118.4], "ja": "おやすみ！" },
    { "t": [118.7, 119.2], "ja": "いいですか、マイク" },
    { "t": [120, 121.9], "ja": "私と船員たちに、仕事をさせてくれませんか？" },
    { "t": [122.1, 123.2], "ja": "あなたはゆっくりして、楽しんでください" },
    { "t": [123.2, 123.4], "ja": "分かった" },
    { "t": [123.7, 123.8], "ja": "ああ" },
    { "t": [124.2, 125.3], "ja": "じゃあ、いいですね？" },
    { "t": [125.3, 145.3], "ja": "あなたはゆっくりして、楽しんでください" }
  ]
