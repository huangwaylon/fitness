{
  "video": "6G3L94NXGc4",
  "lines": [
    { "t": [0,1.3], "ja": "こんにちは" },
    { "t": [1.3,2.6], "ja": "おっ、ピンポンピンポン" },
    { "t": [2.6,3.6], "ja": "最初の到着だ" },
    { "t": [3.6,5.2], "ja": "スクラントンへようこそ" },
    { "t": [5.2,8], "ja": "こちらはハンナ・スモルトリッジ＝バー" },
    { "t": [8,9.6], "ja": "ハンナ・スモルトリッジ＝バー" },
    { "t": [9.6,12.1], "ja": "わがささやかな住まいへようこそ" },
    { "t": [12.1,14.5], "ja": "君の机へ案内しよう" },
    { "t": [14.5,18.6], "ja": "君をしばりつける足かせは、こちらだ" },
    { "t": [18.6,19.7], "ja": "ここの人たちの多くは" },
    { "t": [19.7,21.6], "ja": "ここしか家族がいないんだ" },
    { "t": [21.6,27.8], "ja": "だから、私に言わせれば、これには「世界一のパパ」と書いてある" },
    { "t": [27.8,30.2], "ja": "ああ、来たね" },
    { "t": [30.2,31.8], "ja": "トニー…名字は何だっけ？" },
    { "t": [31.8,33.5], "ja": "ガードナーです　ガードナー" },
    { "t": [33.5,35.1], "ja": "知ってたよ。はい、どうぞ" },
    { "t": [35.1,38], "ja": "君にギフトバッグだ" },
    { "t": [38,40.5], "ja": "ありがとう、マイケル。僕はギフトバッグもらってないけど" },
    { "t": [40.5,41.7], "ja": "まあ、これはお客さん用だからな" },
    { "t": [41.7,43.4], "ja": "余ったら、あとで買えばいい" },
    { "t": [43.4,44.9], "ja": "僕の袋、ほとんど鉛筆だ" },
    { "t": [44.9,48.8], "ja": "おっ、それにスクラントンのいろんな人気スポットのクーポンも入ってるぞ" },
    { "t": [48.8,52.4], "ja": "よし、君の場所に案内しよう" },
    { "t": [52.4,53.6], "ja": "さあ、大将" },
    { "t": [53.6,56.2], "ja": "鉛筆もらっていい？　だめ" },
    { "t": [56.2,57.4], "ja": "こんにちは　こんにちは" },
    { "t": [57.4,58.8], "ja": "パムです　カレンよ" },
    { "t": [58.8,60.1], "ja": "そのセーター、すてきね" },
    { "t": [60.1,62.4], "ja": "あ、ありがとう。母が編んでくれたの" },
    { "t": [62.4,63.7], "ja": "本当に？　すごくいいわね" },
    { "t": [63.7,64.8], "ja": "私もずっと習ってみたかったの…" },
    { "t": [64.8,68.4], "ja": "ようこそ、ようこそ、ようこそ！" },
    { "t": [68.4,70.6], "ja": "お前たちのリーダーのところへ連れていけ" },
    { "t": [70.6,75.4], "ja": "おっと、待てよ、私がリーダーだった" },
    { "t": [75.4,78.7], "ja": "待って、あなたはロボット？　それとも火星人？" },
    { "t": [78.7,81], "ja": "うーん、違うな" },
    { "t": [81,83.5], "ja": "実は私が君のボス、マイケル・スコットだ" },
    { "t": [83.5,85.6], "ja": "ようこそ。わあ、ずいぶんエキゾチックな顔立ちだね" },
    { "t": [85.6,87], "ja": "お父さんは米兵だったとか…" },
    { "t": [98.5,101], "ja": "6週間で、僕はここスクラントンのナンバー2になる" },
    { "t": [101,101.7], "ja": "どうやって？" },
    { "t": [101.7,104], "ja": "相手の名前をくり返し、相手の性格をまねて" },
    { "t": [104,106], "ja": "握手は決して自分から放さない" },
    { "t": [106,108.5], "ja": "僕はいつも一歩先を考えてるんだ" },
    { "t": [108.5,113.7], "ja": "階段を作る大工みたいにね" },
    { "t": [113.7,116.7], "ja": "こんにちは" },
    { "t": [116.7,120], "ja": "ああ、君がアンディ・バーナードだね" },
    { "t": [120,122.7], "ja": "アロハ、ようこそ" },
    { "t": [122.7,124.3], "ja": "そしてあなたがマイケル・スコットですね" },
    { "t": [124.3,127.6], "ja": "アロハ、こんにちは" },
    { "t": [127.6,129.2], "ja": "おお、いいね" },
    { "t": [129.2,132.8], "ja": "われらの小さな王国へようこそ" },
    { "t": [132.8,136.5], "ja": "えー、君にはすてきなプレゼントの袋がある" },
    { "t": [136.5,139.1], "ja": "マイケル、歓迎してくれてありがとう" },
    { "t": [139.1,141.1], "ja": "あなたの小さな王国へ、マイク" },
    { "t": [141.1,142.7], "ja": "おお" },
    { "t": [142.7,143.8], "ja": "すてき！" },
    { "t": [143.8,145.5], "ja": "すてきだろう" },
    { "t": [145.5,147.4], "ja": "すてきなプレゼントだ" },
    { "t": [147.4,148.7], "ja": "私が本当に気に入ってるのは誰か分かる？" },
    { "t": [148.7,150.1], "ja": "アンディ・バーナードって男だ" },
    { "t": [150.1,153.3], "ja": "彼にはすごく感じのいいところがあるんだ" },
    { "t": [155.4,158.3], "ja": "だから、パスを使った攻撃が必要なんだよな？" },
    { "t": [158.3,159.3], "ja": "まさか" },
    { "t": [159.3,160.4], "ja": "そいつをつまみ出せ" },
    { "t": [160.4,162.1], "ja": "ここにそういうのはいらないんだ" },
    { "t": [162.1,163.1], "ja": "会えてうれしいよ" },
    { "t": [163.1,163.6], "ja": "あ、どうも" },
    { "t": [163.6,164.2], "ja": "元気？" },
    { "t": [164.2,166.1], "ja": "マーティン・ナッシュだね？" },
    { "t": [166.1,168.9], "ja": "ささやかなギフトバッグだ。無料だよ" },
    { "t": [168.9,169.5], "ja": "ついてきて" },
    { "t": [169.5,171.3], "ja": "奴隷たちが働いている場所を案内しよう" },
    { "t": [171.3,172.2], "ja": "いや…" },
    { "t": [172.2,174.9], "ja": "それで、君の机は…" },
    { "t": [174.9,175.9], "ja": "やあ、ジムです" },
    { "t": [175.9,176.8], "ja": "ここは初めてで　うそ" },
    { "t": [176.8,179.2], "ja": "本当にあなたなのね" },
    { "t": [179.2,180.7], "ja": "ちょっと冗談を言ってみたんだ" },
    { "t": [180.7,181.7], "ja": "初対面のふりをしてね" },
    { "t": [181.7,183.2], "ja": "分かってる。どうでもいい" },
    { "t": [183.2,184.4], "ja": "最高" },
    { "t": [184.4,186.2], "ja": "戻ってこられてうれしいよ" },
    { "t": [186.2,187.4], "ja": "ここ、すごくよくなったね" },
    { "t": [187.4,188.6], "ja": "会えて本当にうれしい" },
    { "t": [188.6,190], "ja": "僕もだよ" },
    { "t": [190,192.9], "ja": "パムとの関係はどうなってるかって？" },
    { "t": [192.9,195.4], "ja": "うーん、分からない" },
    { "t": [195.4,197.5], "ja": "まあ、友達だよ" },
    { "t": [197.5,198.7], "ja": "ずっと友達だった" },
    { "t": [198.7,202], "ja": "うん、そういう関係" },
    { "t": [202,203.9], "ja": "おやおや" },
    { "t": [203.9,206.6], "ja": "スタンフォードから誰かと思えば、お前か" },
    { "t": [206.6,207.9], "ja": "やあ、ドワイト" },
    { "t": [207.9,209.3], "ja": "事実" },
    { "t": [209.3,211.7], "ja": "私は年上だ。私のほうが賢い" },
    { "t": [211.7,212.8], "ja": "私をなめるなよ" },
    { "t": [212.8,215.1], "ja": "分かった。了解" },
    { "t": [215.1,216.2], "ja": "何してるんだ？" },
    { "t": [216.2,217.4], "ja": "何の話か分からないな" },
    { "t": [217.4,218.4], "ja": "おでこに何かついてるのか？" },
    { "t": [218.4,220.7], "ja": "いや。まあ、よかった" },
    { "t": [220.7,221.7], "ja": "なぜ私のおでこを見ている？" },
    { "t": [221.7,224.1], "ja": "見てないよ" },
    { "t": [224.1,225.3], "ja": "目を合わせろ、ジム" },
    { "t": [225.3,226.6], "ja": "合わせてるよ" },
    { "t": [226.6,228.4], "ja": "ばかなまねはやめろ" },
    { "t": [228.4,230.3], "ja": "分かった" },
    { "t": [230.3,232], "ja": "やあ、相棒" },
    { "t": [232,232.7], "ja": "おかえり" },
    { "t": [232.7,233.6], "ja": "やあ。元気かい？" },
    { "t": [233.6,234], "ja": "会えてうれしいよ" },
    { "t": [234,234.6], "ja": "会えてうれしいよ" },
    { "t": [234.6,236.1], "ja": "うん。元気？" },
    { "t": [238.6,240.6], "ja": "それで…" },
    { "t": [240.6,242.8], "ja": "あ、ごめん。今はここに座ってるの？" },
    { "t": [242.8,244.1], "ja": "うん" },
    { "t": [244.1,245.1], "ja": "そっか" },
    { "t": [247.3,250.6], "ja": "えっと、君がどうしても返してほしいなら別だけど" },
    { "t": [252.6,253.9], "ja": "いや、君が決めていいよ" },
    { "t": [253.9,255.4], "ja": "よかった。ありがとう" },
    { "t": [261.7,262.7], "ja": "いいよ" },
    { "t": [262.7,268.3], "ja": "ここ、誰か使ってる？" },
    { "t": [268.3,268.8], "ja": "いや" },
    { "t": [268.8,269.3], "ja": "よかった" },
    { "t": [271.9,273.3], "ja": "ああ、ジムはいいやつだよ" },
    { "t": [274.4,275.8], "ja": "だから僕がこの机をもらえたんだ" },
