    { "t": [116.4, 117.9], "ja": "変なしゃべり方はいつから？" },
    { "t": [119, 119.9], "ja": "5分くらい前" },
    { "t": [120, 120.8], "ja": "うん、5分くらい。5分くらい" },
    { "t": [121.7, 125.2], "ja": "じゃあ、三人とも食べたり飲んだりしたものはある？" },
    { "t": [125.9, 127.3], "ja": "いや、ないと思う" },
