    { "t": [238.7, 240.5], "ja": "よし、ネビルはもう十分こりたと思う" },
    { "t": [240.6, 241.8], "ja": "そいつのロープをほどくのを手伝って" },
    { "t": [242.9, 243.6], "ja": "うん" },
