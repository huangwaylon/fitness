    { "t": [135.4, 136.2], "ja": "わからない" },
    { "t": [136.6, 139], "ja": "よし、あの紫のロボットを見つけて" },
    { "t": [139.1, 140.8], "ja": "中にいるやつをボコボコにしてやる！" },
    { "t": [143.6, 144.4], "ja": "お前！" },
