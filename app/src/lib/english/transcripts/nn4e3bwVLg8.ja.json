    { "t": [150.2, 151.1], "ja": "誰だ？" },
    { "t": [151.2, 152.7], "ja": "昔からの友だちさ" },
    { "t": [153.4, 156.6], "ja": "今からドラマチックにロボットの頭を外す友だちだ" },
    { "t": [161, 161.9], "ja": "ネビル" },
