  "lines": [
    { "t": [0, 2], "ja": "私たちは、まったく新しい祝日をお祝いしてるの" },
    { "t": [2.1, 3.8], "ja": "私たちが考えた、その名も…" },
    { "t": [3.8, 6.8], "ja": "ハーフォウィーン！ハーフォウィーン！" },
    { "t": [9.6, 12.8], "ja": "ハーフォウィーンは、ここ「アイカーリー」で私たちが考えた新しい祝日" },
    { "t": [12.8, 15.6], "ja": "ハロウィンを、ちょうど中間の時点でお祝いする日なの" },
    { "t": [15.7, 18.7], "ja": "去年のハロウィンと次のハロウィンの、ちょうど真ん中でね" },
    { "t": [18.8, 21.4], "ja": "書面による許可なしにハーフォウィーンをまねすると" },
    { "t": [21.5, 23.8], "ja": "アイカーリー社により、逮捕とボコボコの刑が下されます" },
    { "t": [23.9, 25.3], "ja": "あなたのお母さん、および／または猫に" },
    { "t": [25.4, 26.8], "ja": "はい、パーティーに行きましょう、カーリー" },
    { "t": [30, 38.7], "ja": "リサ、着いたよ。やあ！" },
