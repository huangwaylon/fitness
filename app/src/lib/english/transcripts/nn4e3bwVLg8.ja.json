    { "t": [40.8, 42.6], "ja": "ハッピー・ハーフォウィーン！" },
    { "t": [42.7, 45.6], "ja": "パーティーに招いてくれてありがとう" },
    { "t": [45.7, 49], "ja": "お菓子はいかが？えっと、どれどれ、うん！" },
    { "t": [51.3, 53.6], "ja": "あっ！どうも！" },
    { "t": [53.7, 56.7], "ja": "ねえ、パーティーの客がお菓子を持ってきてくれるって最高じゃない？" },
    { "t": [56.8, 59.9], "ja": "こんにちは、カーリー。お菓子をどうぞ" },
    { "t": [60, 60.9], "ja": "ありがとう！" },
    { "t": [62.4, 66.5], "ja": "よし、何事だ？ルーバートだ、いぼがあるぞ！" },
    { "t": [67.8, 69], "ja": "ははは！" },
    { "t": [69.1, 71.4], "ja": "あなたのいぼ、ぷっくりして毛が生えてる" },
    { "t": [72.4, 73.4], "ja": "お菓子どう？" },
    { "t": [74.1, 75.2], "ja": "うん、ありがとう" },
    { "t": [77.1, 78.6], "ja": "私がサム！私がカーリー！" },
    { "t": [78.6, 79.8], "ja": "違う！違う！" },
    { "t": [81.7, 83.8], "ja": "コーンドッグでも買ってきたら？" },
    { "t": [83.8, 85.6], "ja": "うん。いいよ" },
    { "t": [85.7, 87.6], "ja": "私がカーリー！本当に違うから！" },
    { "t": [92.5, 95], "ja": "ねえ、失礼なことを言うつもりはないけど、もし君が女の子だったら" },
    { "t": [95.1, 96.9], "ja": "男が君みたいな格好をしてたら、嫌だろ" },
    { "t": [97, 98.3], "ja": "君のふりをしようとしてたら…" },
    { "t": [99.8, 101.5], "ja": "君のふりをしようとしてたら…" },
    { "t": [103, 104.8], "ja": "なんで声が変なの？" },
    { "t": [106, 107.7], "ja": "なんで声が変なの？" },
    { "t": [109.2, 111.4], "ja": "ねえ、みんなの声どうしちゃったの？" },
