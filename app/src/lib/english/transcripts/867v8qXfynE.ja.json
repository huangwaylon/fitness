{
  "video": "867v8qXfynE",
  "lines": [
    { "t": [0,  4.1], "ja": "やあ、みんな" },
    { "t": [4.2,  5.4], "ja": "あら、フィービー" },
    { "t": [5.4,  6.8], "ja": "ねえ、どうだった？" },
    { "t": [6.8,  8], "ja": "うーん、あまり良くなかった" },
    { "t": [8.1,  9.4], "ja": "地下鉄の駅まで送ってくれて、こう言ったの" },
    { "t": [9.5,  10.5], "ja": "「また会おうね」って" },
    { "t": [10.6,  11.9], "ja": "あら" },
    { "t": [11.9,  12.9], "ja": "何？" },
    { "t": [12.9,  14.1], "ja": "また会おうって言われたんでしょ" },
    { "t": [14.2,  15.3], "ja": "それっていいことよね？" },
    { "t": [15.3,  16.1], "ja": "ううん、違う" },
    { "t": [16.2,  18.6], "ja": "ざっくり訳すと、「また会おうね」の意味は" },
    { "t": [18.6,  19.9], "ja": "「君の裸を見ることは絶対にない」よ" },
    { "t": [20,  22], "ja": "えっ" },
    { "t": [22,  23.4], "ja": "いつからそうなの？" },
    { "t": [23.5,  24.7], "ja": "昔からずっとよ" },
    { "t": [24.7,  26.8], "ja": "デート用の言葉みたいなものよ" },
    { "t": [26.8,  29.6], "ja": "ほら、「君のせいじゃない」の意味は…" },
    { "t": [29.6,  31], "ja": "「君のせいだ」" },
    { "t": [31,  32.8], "ja": "それに、「君って本当にいい人だね」の意味は" },
    { "t": [32.8,  34.9], "ja": "「これから革ジャンを着た酒飲みとデートして" },
    { "t": [34.9,  37.8], "ja": "その愚痴をあなたに聞かせるつもり」" },
    { "t": [37.9,  41], "ja": "それとか、ほら、「他の人とも付き合ってみるべきだと思う」は" },
    { "t": [41.1,  44.3], "ja": "「ははっ、もう付き合ってるけど」って意味" },
    { "t": [44.4,  45.5], "ja": "しかも、みんな知ってることよ" },
    { "t": [45.5,  46.8], "ja": "ああ、そうね" },
    { "t": [46.9,  48], "ja": "ショックを和らげるのよ" },
    { "t": [48.1,  49.1], "ja": "そう、子どもの頃に" },
    { "t": [49.1,  50.6], "ja": "親が飼い犬を安楽死させたのに" },
    { "t": [50.7,  53.3], "ja": "「どこかの農場で暮らすことになった」って言うようなものよ" },
    { "t": [53.4,  56.9], "ja": "それは面白いね。いや、だってうちの親は本当に" },
    { "t": [57,  59.2], "ja": "犬を農場に送って暮らさせたんだ" },
    { "t": [59.2,  61.2], "ja": "あの、ロス" },
    { "t": [63,  63.9], "ja": "何？" },
    { "t": [63.9,  64.7], "ja": "ねえ、気づいてる？" },
    { "t": [64.8,  66.4], "ja": "コネチカットのミルナーさんの農場だよ？" },
    { "t": [66.4,  68.9], "ja": "ミルナーさんの家には、すごい農場があったんだ" },
    { "t": [69,  71.9], "ja": "馬がいて、犬が追いかけられるウサギもいて" },
    { "t": [72,  72.6], "ja": "それで、あの…" },
    { "t": [76.4,  77], "ja": "なんてことだ" },
    { "t": [77,  77.7], "ja": "チーチ…？" }
  ]
}
