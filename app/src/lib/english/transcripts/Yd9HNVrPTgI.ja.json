    { "t": [266, 268], "ja": "残りの人たちとは絶交です" },
    { "t": [268, 270], "ja": "人生で一番ばかな決断をしましたね" },
    { "t": [270, 272], "ja": "いや、いや、いや" },
    { "t": [272, 275], "ja": "でもお会いできてよかったです。僕の連絡先はお持ちですね" },
    { "t": [275, 276], "ja": "いつでも気軽に電話してください" },
    { "t": [276, 277], "ja": "すばらしいセミナーだった" },
    { "t": [277, 281], "ja": "ワタシたちが初めて会った日と同じくらい" },
    { "t": [281, 284], "ja": "アナタ、ワタシの人生の恋人" },
    { "t": [284, 287], "ja": "おいで、ネクロポリス" },
    { "t": [287, 289], "ja": "くちびる、くちびるに重ねて" },
    { "t": [289, 290], "ja": "さあ" },
