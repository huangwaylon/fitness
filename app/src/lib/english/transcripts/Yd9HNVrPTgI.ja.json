  "lines": [
    { "t": [0, 6], "ja": "こんにちは、中小企業セミナーに来ました" },
    { "t": [6, 7], "ja": "マイケル？" },
    { "t": [7, 10], "ja": "ナイン、ワタシ、ギリシャ人。名前、ミコノス" },
    { "t": [10, 12], "ja": "あら、まあ" },
    { "t": [12, 15], "ja": "待って、マイケル？マイケル？" },
    { "t": [15, 16], "ja": "わかった" },
    { "t": [16, 19], "ja": "僕はサクラだ。すばらしいセミナーには必ずいる" },
    { "t": [19, 21], "ja": "僕の仕事は、講師をよく見せることだ" },
    { "t": [21, 24], "ja": "そのために、答えを誘う質問をしたり" },
    { "t": [24, 27], "ja": "どの冗談にも笑ったりする" },
    { "t": [27, 31], "ja": "で、ミコノスというキャラクターは、ちょっとした味付けさ" },
    { "t": [31, 36], "ja": "ミコノスは、僕がやる別のキャラ、スパイロスをゆるくもとにしてる" },
    { "t": [36, 38], "ja": "スパイロスはもっと女好きなんだ" },
    { "t": [38, 39], "ja": "ねえ、ちょっと楽しいかもしれないことがあるんだ" },
    { "t": [39, 42], "ja": "考えてたんだけど、今日アンディがセミナーをやるだろ" },
    { "t": [42, 46], "ja": "ギリシャ人の夫婦として参加するのはどう？ミコノスと…" },
    { "t": [46, 48], "ja": "うーん、どうかな、マイケル。そんな気分じゃないの" },
    { "t": [48, 49], "ja": "わかった" },
    { "t": [49, 51], "ja": "ホリーは先週、エージェーと別れた" },
    { "t": [51, 55], "ja": "僕の人生で最高の出来事だ" },
    { "t": [55, 58], "ja": "ホリーにとっては、人生最悪の週だった" },
    { "t": [58, 62], "ja": "でも確かな事実として、高校時代に" },
    { "t": [62, 65], "ja": "単核症になって初めての生理が来た週もあったんだ" },
    { "t": [65, 68], "ja": "情報が多すぎる？そう思ったよ" },
    { "t": [68, 72], "ja": "でもね、ほら、今それを使ってる" },
    { "t": [72, 77], "ja": "気が変わったら、ミコノスに声をかけて" },
    { "t": [77, 80], "ja": "ミコノスってギリシャ人？イタリア人みたいに聞こえるけど" },
    { "t": [80, 82], "ja": "うー、今日それを言われたの5人目だよ" },
    { "t": [82, 85], "ja": "ミコノスはイタリアのサーカスに入るために家出したのかも" },
    { "t": [85, 88], "ja": "そうね、キャラクターの過去みたいな感じ。いいわ" },
    { "t": [88, 89], "ja": "トム・ハンクスもそうしてる" },
    { "t": [89, 92], "ja": "たばこを吸う人みたいに、もう少し声をガラガラにしてみて" },
    { "t": [92, 95], "ja": "ワタシ、ワタシ" },
    { "t": [95, 96], "ja": "怖い" },
    { "t": [96, 97], "ja": "それはかなり痛いね" },
    { "t": [97, 98], "ja": "怖くなりそう、うん" },
    { "t": [98, 99], "ja": "暇なときは何をしてるの？" },
    { "t": [99, 101], "ja": "オリンピックの練習" },
    { "t": [102, 103], "ja": "映画は好き？" },
    { "t": [103, 109], "ja": "ミュージカルの「グリース」が好き。ワタシたちは「ふるさと」と呼ぶ" },
    { "t": [112, 114], "ja": "誰かで試してみなきゃ" },
    { "t": [115, 116], "ja": "私は…" },
    { "t": [116, 118], "ja": "ねえ、何か注文する？" },
    { "t": [118, 121], "ja": "彼女には、すごいカプチーノを" },
    { "t": [121, 123], "ja": "それが何なのかわかりません" },
    { "t": [125, 129], "ja": "私のヤギのための、ミルク入りのすごく濃いコーヒーね" },
    { "t": [130, 132], "ja": "信じられない！" },
    { "t": [132, 134], "ja": "奇跡だ！" },
    { "t": [134, 135], "ja": "彼女がしゃべった！" },
    { "t": [136, 137], "ja": "脳の障害は治った" },
    { "t": [137, 139], "ja": "脳の障害は治った！" },
    { "t": [140, 142], "ja": "昼休みのあとにこっそり入るわけにはいかないわ" },
    { "t": [142, 143], "ja": "ああ、遅刻しちゃう" },
    { "t": [143, 144], "ja": "ちゃんとした…が必要ね" },
    { "t": [144, 146], "ja": "金融危機で足止めされた" },
    { "t": [146, 148], "ja": "本当っぽい理由じゃないと" },
    { "t": [148, 149], "ja": "信じてもらえる理由が" },
    { "t": [149, 150], "ja": "最高" },
    { "t": [150, 151], "ja": "あ" },
    { "t": [151, 154], "ja": "ピーナッツバターのトラックがジャムのトラックに衝突したんだ" },
    { "t": [154, 156], "ja": "ヘリコプターでパンを運んでる" },
    { "t": [156, 157], "ja": "ああ、いいわね" },
    { "t": [157, 159], "ja": "マイケル、このセミナーをアンディから引き取らなきゃ" },
    { "t": [159, 160], "ja": "彼は売り込みを台無しにするわ" },
    { "t": [160, 162], "ja": "よし、アンドリュー、ちょっと来てくれる？" },
    { "t": [165, 167], "ja": "本当にこの売り込みを決められるのか？" },
    { "t": [167, 168], "ja": "大丈夫、ちゃんとできます" },
    { "t": [168, 169], "ja": "いや、いや、いや" },
    { "t": [169, 172], "ja": "やり遂げられるって自信を持ってほしいんだ" },
    { "t": [172, 173], "ja": "持ってます" },
    { "t": [173, 176], "ja": "誰よりも一生懸命やり遂げようとする自信があります" },
    { "t": [176, 177], "ja": "うわ、なんてこった" },
    { "t": [177, 178], "ja": "わあ" },
    { "t": [178, 179], "ja": "すごい一日だった" },
    { "t": [179, 180], "ja": "でしょ？" },
    { "t": [180, 182], "ja": "みなさん、そろそろお帰りの準備ができてますよね" },
    { "t": [182, 184], "ja": "僕の名刺も渡しましたし…" },
    { "t": [184, 187], "ja": "その、その、その、あの、ほら" },
    { "t": [187, 188], "ja": "アナタ、好き" },
    { "t": [188, 191], "ja": "ワタシの秘密のギロのレシピ、教える" },
    { "t": [191, 192], "ja": "こっち来て" },
    { "t": [192, 194], "ja": "秘密だから、教えない" },
    { "t": [196, 197], "ja": "よし、契約を決めないと" },
    { "t": [197, 198], "ja": "今すぐ" },
    { "t": [198, 199], "ja": "うん、今やろうとしてるところ" },
    { "t": [199, 200], "ja": "いや、してない" },
    { "t": [200, 201], "ja": "通り過ぎてる" },
    { "t": [201, 202], "ja": "決めなきゃ" },
    { "t": [202, 203], "ja": "やれ" },
    { "t": [203, 204], "ja": "できるよ" },
    { "t": [204, 205], "ja": "うん、うん" },
    { "t": [205, 206], "ja": "アンディ、何が問題なの？" },
    { "t": [206, 207], "ja": "ぼ、ぼ、僕には難しいんだ" },
    { "t": [207, 208], "ja": "僕はいい人だから" },
    { "t": [208, 211], "ja": "ほら、ケリーもクリードもケビンも、君を信じてる" },
    { "t": [211, 213], "ja": "がっかりさせるな" },
    { "t": [213, 216], "ja": "自分をがっかりさせるな、アンディ" },
    { "t": [216, 221], "ja": "はい、この中小企業パッケージを今すぐ僕から買いたい人は？" },
    { "t": [221, 224], "ja": "はい、一人いました" },
    { "t": [224, 227], "ja": "よし、雪だるまが転がり始めた" },
    { "t": [227, 228], "ja": "ほかには？" },
    { "t": [230, 232], "ja": "2、3日先延ばしにしてもいいですよ" },
    { "t": [232, 238], "ja": "でも保証します、結局これが必要だって気づきます" },
    { "t": [239, 247], "ja": "だから違うのは、今すぐ僕から買った場合より2、3日遅れることだけです" },
    { "t": [250, 252], "ja": "で、今すぐ買う人は？" },
    { "t": [252, 253], "ja": "一つください" },
    { "t": [253, 254], "ja": "はい" },
    { "t": [254, 255], "ja": "最高" },
    { "t": [255, 256], "ja": "よし" },
    { "t": [256, 257], "ja": "ほかには？" },
