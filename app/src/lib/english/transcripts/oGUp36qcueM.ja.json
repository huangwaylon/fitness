{
  "video": "oGUp36qcueM",
  "lines": [
    { "t": [0, 1.9], "ja": "使えるのはこれで全部？" },
    { "t": [1.9, 3.4], "ja": "頼んだものはどこ？" },
    { "t": [3.4, 4.6], "ja": "スモークマシンは？" },
    { "t": [4.6, 6.1], "ja": "テディベアの着ぐるみの女の子たちは？" },
    { "t": [6.1, 7.3], "ja": "「イーザス」の山は？" },
    { "t": [7.3, 8.1], "ja": "まったくだよ" },
    { "t": [8.1, 10.4], "ja": "レコードプレーヤー用に" },
    { "t": [10.4, 12.3], "ja": "楕円形の針をちゃんと頼んだのに" },
    { "t": [12.3, 14], "ja": "これでハスカー・ドゥのレコードを" },
    { "t": [14, 15.4], "ja": "新品同様に保てっていうの？" },
    { "t": [15.4, 16.4], "ja": "ねえ、いい考えがある" },
    { "t": [16.4, 18], "ja": "それ、ゴミ箱に捨てたら？" },
    { "t": [18, 20.2], "ja": "僕のプロムは市長をクビになったすぐ後だったから" },
    { "t": [20.2, 23.1], "ja": "家を出たら卵を投げつけられた" },
    { "t": [23.1, 25.6], "ja": "でも両親が、うちのリビングでプロムを開いてくれたんだ" },
    { "t": [27.2, 29.5], "ja": "たぶん今でもそれを引きずってる" },
    { "t": [29.5, 31.8], "ja": "実は僕、プロムには15分しかいなかったんだ" },
    { "t": [31.8, 33.6], "ja": "アルマーニのスーツにアイロンをかけて" },
    { "t": [33.6, 36.7], "ja": "ネクタイのくぼみをちょうどよく決めたころには" },
    { "t": [36.7, 38.5], "ja": "夜の11時45分だった" },
    { "t": [38.5, 41.6], "ja": "デート相手はかなり怒ってたけど、僕はめちゃくちゃイケてたよ" },
    { "t": [43.4, 45], "ja": "レスリー、本当にありがとう" },
    { "t": [45, 47], "ja": "あなたがいなければプロムはできなかったわ" },
    { "t": [47, 49.1], "ja": "これは満点の仕事よ" },
    { "t": [49.1, 50], "ja": "満点？" },
    { "t": [50, 51.3], "ja": "ありがとうございます、ラッセル校長" },
    { "t": [51.3, 52.5], "ja": "それ、書面でもらえます？" },
    { "t": [52.5, 56.1], "ja": "ああ、レスリー、高校のときから変わらないわね" },
    { "t": [56.1, 57.6], "ja": "校長が満点をくれたなんて信じられない" },
    { "t": [57.6, 58.4], "ja": "あら、そうだった？" },
    { "t": [58.4, 59], "ja": "気づきもしなかったわ" },
    { "t": [59, 60], "ja": "大したことないわよ" },
    { "t": [60, 61.5], "ja": "ねえ、アリソン、聞きたいことがあるの" },
    { "t": [61.5, 63.2], "ja": "すごく大事で、すごく真剣な話よ" },
    { "t": [63.2, 64], "ja": "よく聞いて" },
    { "t": [64, 65.6], "ja": "はい！" },
    { "t": [65.6, 67.6], "ja": "風船を落とす演出を一緒に仕切ってくれない？" },
    { "t": [70, 72], "ja": "ノープさん、光栄です" },
    { "t": [72, 73.2], "ja": "わあ、やった！" },
    { "t": [73.2, 74.3], "ja": "アリソン" },
    { "t": [74.3, 75.1], "ja": "あ" },
    { "t": [75.1, 77], "ja": "政府の下請けで" },
    { "t": [77, 78.7], "ja": "照明の骨組みを作ることになった" },
    { "t": [78.7, 80.6], "ja": "木材にかぎ形の金具をねじで留めるのを" },
    { "t": [80.6, 82.1], "ja": "手伝ってくれないか？" },
    { "t": [82.1, 83], "ja": "40ドル払う" },
    { "t": [83, 84], "ja": "はい、いいですよ" },
    { "t": [84, 85.9], "ja": "私はここで楽しくやってるからね！" },
    { "t": [85.9, 87.1], "ja": "またあとでね！" },
    { "t": [87.1, 89.8], "ja": "何をしてるかわかってるわよ、ロン。絶対に負けないから" },
    { "t": [89.8, 90.9], "ja": "覚えてなさい" },
    { "t": [90.9, 92.6], "ja": "ヘリウムを無駄にするな" },
    { "t": [92.6, 94.9], "ja": "溶接や飛行船を膨らませるためのものだ" },
    { "t": [94.9, 99.8], "ja": "私はスーザン・ホフラーとプロムに行った。トラックで迎えに行ってな" },
    { "t": [99.8, 103.8], "ja": "マール・ハガードの曲でスローダンスを踊ってから、早めに抜けて" },
    { "t": [103.8, 105.8], "ja": "採石場の仕事に行った" },
    { "t": [105.8, 110.8], "ja": "12歳だった。それ以来、行っていない" },
    { "t": [110.8, 113.8], "ja": "もう卒業した気がしたからな" },
    { "t": [113.8, 115.8], "ja": "ありがとう" },
    { "t": [115.8, 116.8], "ja": "さあ、やったわね" },
    { "t": [116.8, 117.8], "ja": "プロムに来たわ" },
    { "t": [117.8, 118.8], "ja": "やった！" },
    { "t": [118.8, 119.8], "ja": "もう帰りましょう" },
    { "t": [119.8, 120.8], "ja": "え、何？" },
    { "t": [120.8, 121.8], "ja": "冗談でしょ？" },
    { "t": [121.8, 122.8], "ja": "これ最高だよ" },
    { "t": [122.8, 123.8], "ja": "周りを見て" },
    { "t": [123.8, 128.8], "ja": "青春の花盛り、まるでワシの詩の夕日に咲く花のようだ" },
    { "t": [128.8, 130.8], "ja": "アンディ、私、十代の子って嫌いなの" },
    { "t": [130.8, 132.8], "ja": "チャンスをあげれば、絶対好きになるよ" },
    { "t": [132.8, 133.8], "ja": "約束する" },
    { "t": [133.8, 134.8], "ja": "映画の「エクスペンダブルズ2」みたいなもんだよ" },
    { "t": [134.8, 136.3], "ja": "1回目は大嫌いだった" },
    { "t": [136.3, 138.3], "ja": "2回目も大嫌いだった" },
    { "t": [138.3, 140.7], "ja": "3回目はまあまあだった" },
    { "t": [140.7, 143.7], "ja": "でも4回目、5回目、6回目、7回目、10回目に見て" },
    { "t": [143.7, 145.7], "ja": "あることに気づいたんだ" },
    { "t": [145.7, 147.2], "ja": "あれは…いい映画じゃない" },
    { "t": [147.2, 148.7], "ja": "全然いい映画じゃないんだよ" },
    { "t": [148.7, 152.2], "ja": "納得してもらえたところで、踊りに行かない？" },
    { "t": [152.2, 154.6], "ja": "えっと、女子トイレに行って" },
    { "t": [154.6, 156.2], "ja": "ゴミ箱に赤ちゃんがいないか確かめてくる" },
    { "t": [156.2, 157.7], "ja": "でも、踊りたいなら踊っていいよ" },
    { "t": [157.7, 158.7], "ja": "本当？" },
    { "t": [158.7, 159.7], "ja": "愛してる" },
    { "t": [159.7, 160.7], "ja": "ありがとう" },
    { "t": [160.7, 161.7], "ja": "イエー！" },
    { "t": [161.7, 162.7], "ja": "どいてどいて" },
    { "t": [162.7, 165.6], "ja": "ユー・オン・バケーション、ユー・オン・バケーション、ウィー・ゲッティング・ペイド…" },
    { "t": [165.6, 167.6], "ja": "あの、誰もノッてないよ" },
    { "t": [167.6, 168.6], "ja": "わかった" },
    { "t": [168.6, 169.6], "ja": "2チェインズが好きな客じゃないな" },
    { "t": [169.6, 171.6], "ja": "すぐにイーズィーをかけるよ" },
    { "t": [171.6, 172.6], "ja": "イーズィー？" },
    { "t": [172.6, 173.6], "ja": "ウィーズィー？" },
    { "t": [173.6, 178.6], "ja": "ああ、昔の名曲がいいんだね" },
    { "t": [178.6, 180.6], "ja": "ジャ・ルールでもかけてやろうか？" },
    { "t": [180.6, 181.5], "ja": "ジャ・ルールって誰？" },
    { "t": [181.5, 183.5], "ja": "ジャ・ルールって誰？" },
    { "t": [183.5, 184.5], "ja": "何？" },
    { "t": [184.5, 185.5], "ja": "どうやって…" },
    { "t": [185.5, 186.5], "ja": "何？" },
    { "t": [186.5, 187.5], "ja": "誰が何？" },
    { "t": [187.5, 188.5], "ja": "あんたがかけてるの、古すぎて" },
    { "t": [188.5, 190.5], "ja": "たぶん「グリズルダムでトリンキン」だよ" },
    { "t": [190.5, 192.5], "ja": "ねえ、グリズルダムって何？" },
    { "t": [192.5, 193.5], "ja": "それに、それでトリンキンするのがなんでダメなの？" },
    { "t": [193.5, 195.5], "ja": "なんてこと" },
    { "t": [195.5, 197.5], "ja": "もう何がかっこいいのかわからない" },
    { "t": [197.5, 198.5], "ja": "グリズルダムって何、ベン？" },
    { "t": [198.5, 199.5], "ja": "グリズルダムって何？" },
    { "t": [199.5, 206.4], "ja": "で、記念のひもを引いたことはある？" },
    { "t": [206.4, 207.4], "ja": "ちょっとしたコツがあるの" },
    { "t": [207.4, 208.4], "ja": "強く握りすぎないで" },
    { "t": [208.4, 210.4], "ja": "しっかりした握手みたいにね" },
    { "t": [210.4, 214.4], "ja": "それから、ロープを引くように下へ動かすの" },
    { "t": [214.4, 217.4], "ja": "じゃあ、ロープを引くだけ？その通り" },
    { "t": [217.4, 220.4], "ja": "ありがとう、レスリー。これも、それに" },
    { "t": [220.4, 221.4], "ja": "そもそもプロムを実現してくれたことも" },
    { "t": [221.4, 223.4], "ja": "あら、お礼なんていいのよ" },
    { "t": [223.4, 225.4], "ja": "役所で働くこと自体がごほうびだもの" },
    { "t": [225.4, 226.4], "ja": "逃げろ、アリソン、逃げろ" },
    { "t": [226.4, 228.3], "ja": "無駄だよ、レスリー" },
    { "t": [228.3, 230.4], "ja": "アリソンと私はもう、汗水たらして稼いだ1ドルの力について" },
    { "t": [230.4, 232.4], "ja": "いい話をしたんだ" },
    { "t": [232.4, 233.4], "ja": "聞いちゃだめ" },
    { "t": [233.4, 236.4], "ja": "いい、ロープを引くとき、風船を見ちゃだめよ" },
    { "t": [236.4, 239.4], "ja": "風船が落ちるときの、みんなの顔を見て" },
    { "t": [239.4, 241.4], "ja": "それが行政というものなの" },
    { "t": [241.4, 242.4], "ja": "みんなの顔を見て" },
    { "t": [242.4, 245.4], "ja": "違う、風船を全部閉じこめているあのかごを見ろ" },
    { "t": [245.4, 248.4], "ja": "私があのかごを組み立てて、その労働の対価を得た" },
    { "t": [248.4, 251.4], "ja": "その金で、住まいと燃料と郵便を買う" },
    { "t": [251.4, 252.4], "ja": "顔を見て" },
    { "t": [252.4, 253.4], "ja": "かごを見ろ" },
    { "t": [253.4, 254.4], "ja": "ロープを引いて" },
    { "t": [254.4, 255.4], "ja": "顔を見て" },
    { "t": [255.4, 256.4], "ja": "かごを見ろ" },
    { "t": [256.4, 257.4], "ja": "顔を見て！" },
    { "t": [261.4, 262.4], "ja": "おめでとう、ロン" },
    { "t": [262.4, 263.4], "ja": "プロムを台無しにしたわね" },
