{
  "video": "gE5CQopQEdc",
  "lines": [
    { "t": [0, 1.5], "ja": "生き返ってよ、もう！" },
    { "t": [2.5, 4.8], "ja": "カーリー、停電の電流で携帯が壊れちゃったんだよ" },
    { "t": [4.9, 6.1], "ja": "もうあきらめる時だ" },
    { "t": [6.8, 7.8], "ja": "分かった" },
    { "t": [9.2, 10.2], "ja": "ここまでにしよう" },
    { "t": [11.5, 13.2], "ja": "大丈夫。ペア・ストアに行って" },
    { "t": [13.2, 14.2], "ja": "新しい携帯を買おう" },
    { "t": [14.2, 15.3], "ja": "うそでしょ" },
    { "t": [15.4, 18.1], "ja": "本当に消えちゃった。写真が全部" },
    { "t": [18.1, 19.3], "ja": "よし、大丈夫。何とかできるよ" },
    { "t": [19.4, 20.5], "ja": "僕たちで…" },
    { "t": [20.6, 21.8], "ja": "君の思い出を再現しよう" },
    { "t": [22.2, 23.1], "ja": "これって…？" },
    { "t": [23.2, 24.8], "ja": "あなたがイタリアに来た時のね" },
    { "t": [24.9, 27], "ja": "あのおしゃれなディナーのためにおめかししたのに" },
    { "t": [27, 28.3], "ja": "レストランが閉まってたのよね" },
    { "t": [28.4, 29.8], "ja": "聖ゼペットの祝日で" },
    { "t": [29.9, 31.9], "ja": "小さな木の男の子たちの守護聖人" },
    { "t": [34.2, 35.8], "ja": "それから川沿いを散歩して" },
    { "t": [35.9, 37.5], "ja": "あのカフェを見つけたの" },
    { "t": [38, 39.3], "ja": "そしたら、かわいい小さなおじいさんが来て" },
    { "t": [39.4, 40.5], "ja": "写真を撮らせてって言ったのよね" },
    { "t": [41.8, 43.7], "ja": "美しい若い二人を見てごらん" },
    { "t": [43.7, 46.2], "ja": "写真を撮らせてくれないかね" },
    { "t": [46.2, 48.2], "ja": "それで私が「パルミジャーナって言って」って言ったの" },
    { "t": [48.3, 50.8], "ja": "いや。ここでは、チャンタニって言うんだ" },
    { "t": [51.8, 54.9], "ja": "僕の人生で最悪の夜を再現するなんて、信じられない" },
    { "t": [56.3, 57], "ja": "え？" },
    { "t": [58.2, 59.6], "ja": "全然そんなふうじゃなかったよ" },
    { "t": [59.7, 62.5], "ja": "君がイタリアに行く直前" },
    { "t": [62.5, 63.9], "ja": "僕にキスしたよね" },
    { "t": [63.9, 64.7], "ja": "覚えてる？" },
    { "t": [64.7, 65.7], "ja": "うん" },
    { "t": [65.7, 68.3], "ja": "それに引っ越したあと、君はすごく寂しがってた" },
    { "t": [68.3, 69.7], "ja": "毎日、何時間も話してたよね" },
    { "t": [69.8, 71.2], "ja": "それで僕は、あのおしゃれなディナーを計画したんだ" },
    { "t": [71.2, 73.6], "ja": "君に彼女になってって言うつもりだったから" },
    { "t": [73.6, 75.1], "ja": "え？" },
    { "t": [75.1, 76.1], "ja": "そんなこと言わなかったじゃない" },
    { "t": [76.2, 78], "ja": "そんなこと言わなかったじゃない" },
    { "t": [78.1, 78.9], "ja": "そう" },
    { "t": [79, 80.3], "ja": "あのおじいさんが来たからね" },
    { "t": [80.4, 81.1], "ja": "このおじいさん？" },
    { "t": [81.2, 84.1], "ja": "座らせてもらうよ、失礼" },
    { "t": [86.7, 88.7], "ja": "彼が「おや、美しいカップルだね」って言って" },
    { "t": [90.7, 92.4], "ja": "君は笑った" },
    { "t": [92.5, 96], "ja": "君は言ったんだ。「いいえ、絶対にカップルじゃない" },
    { "t": [96.1, 97.2], "ja": "友達です" },
    { "t": [97.2, 98.1], "ja": "アミーチ」" },
    { "t": [98.1, 100.7], "ja": "でも、あなたは怒ってなかったじゃない" },
    { "t": [100.7, 101.9], "ja": "平気だったでしょ" },
    { "t": [101.9, 104.3], "ja": "あのメッセージが来るまで、ジェラートを食べてたよね" },
    { "t": [104.4, 105.6], "ja": "僕の家族の緊急事態？" },
    { "t": [105.7, 106.8], "ja": "うん、あれは作り話だよ" },
    { "t": [106.8, 109.7], "ja": "帰りの飛行機に乗れるまで、空港で寝てたんだ" },
    { "t": [109.7, 111.9], "ja": "空港で寝てたの？" },
    { "t": [112, 115.9], "ja": "それで、もう二度と君に振り回されないって誓ったんだ" },
    { "t": [116, 120.4], "ja": "フレディ、悪いけど、私は振り回してない" },
    { "t": [120.4, 121.8], "ja": "君がキスしたんだよ" },
    { "t": [121.9, 125.7], "ja": "それから1か月後、僕たちがカップルなんて考えを笑ったんだ" },
    { "t": [125.8, 127.8], "ja": "居心地が悪かったから笑ったの" },
    { "t": [127.9, 131.1], "ja": "百年たっても、僕は君の友達にしかなれないって言ったよね" },
    { "t": [131.2, 135], "ja": "私たちの友情が、人生で一番大切だって言ったの" },
    { "t": [135.1, 137.5], "ja": "私にとっては意味のあることだったのよ" },
    { "t": [137.6, 142.5], "ja": "でも君にとっては、僕が友達なのはただの残念賞なんだね" },
    { "t": [142.6, 144.9], "ja": "わあ、ハウス・オブ・グッチね" },
    { "t": [147.5, 148.6], "ja": "それはずるいよ" },
    { "t": [148.6, 152], "ja": "いや、ずるいのは、僕を好きになれなかったってだけで" },
    { "t": [152, 153.6], "ja": "何年も僕を悪者にしたことだよ" },
    { "t": [153.7, 156.9], "ja": "好きじゃなかったなら、なんでキスしたの？" },
    { "t": [157, 160.5], "ja": "二人ともけじめをつけて、前に進めるようにするためよ" },
    { "t": [160.6, 164.6], "ja": "へえ、そうかい、けじめをありがとう" },
    { "t": [164.6, 167.1], "ja": "ずいぶん気前がいいね" },
    { "t": [168.6, 169.5], "ja": "今日、彼女と話した？" },
    { "t": [169.5, 170.7], "ja": "彼女、大丈夫？" },
    { "t": [170.8, 173.8], "ja": "正直、昨日の夜のことで、すごく動揺してる" },
    { "t": [173.8, 176.2], "ja": "あなたがもう友達でいたくないんじゃないかって心配してるの" },
    { "t": [176.2, 177.7], "ja": "え？" },
    { "t": [177.7, 178.7], "ja": "彼女に会わないと" },
    { "t": [178.8, 179.8], "ja": "家にいる？" },
    { "t": [179.8, 181.6], "ja": "スタジオに、あなたあての置き手紙を残していったわよ" },
    { "t": [183.7, 186.5], "ja": "どうやって…" },
    { "t": [190.5, 193.5], "ja": "ザコのいとこのギズモに、ハードディスクを直してもらったの" },
    { "t": [195.7, 198.5], "ja": "ここ数日、悪い思い出のことばかり考えてたから" },
    { "t": [198.6, 204.4], "ja": "いい思い出も見なきゃって思ったの" },
    { "t": [204.5, 206.3], "ja": "うそだろ" },
    { "t": [206.4, 209.1], "ja": "（聞き取れず）" },
    { "t": [209.2, 210.9], "ja": "覚えてない？" },
    { "t": [211, 213.3], "ja": "あの日、あなたが「アイカーリー」って名前をつけたのよ" },
    { "t": [213.4, 217.9], "ja": "アイはインターネット、カーリー、それに「あなた」" },
    { "t": [218, 220.8], "ja": "でも、それをくっつけようなんて、ほかに誰が思いついた？" },
    { "t": [223.3, 226.5], "ja": "そもそも、番組の名前をつけたのはあなたよ" },
    { "t": [226.5, 230.4], "ja": "それに、一人でもできるって言ってくれたのもあなた" },
    { "t": [230.4, 234.9], "ja": "私の命を救うために、タコスのトラックの前に飛び出してくれた" },
    { "t": [235, 237.7], "ja": "それから、ヒーローみたいな気持ちが冷めるまで" },
    { "t": [237.8, 238.6], "ja": "付き合うのは待とうって言ったわよね" },
    { "t": [238.7, 245.3], "ja": "でも、フレディ、あなたは今でも私のヒーローよ" },
    { "t": [245.3, 251.4], "ja": "カーリー、分かってほしいんだ。君の友達でいることは" },
    { "t": [251.4, 255.4], "ja": "残念賞なんかじゃない" },
    { "t": [255.5, 257.7], "ja": "僕がなれる中で、一番いいものなんだ" },
    { "t": [261.7, 267.4], "ja": "もし付き合ってみて、うまくいかなかったら" },
    { "t": [267.5, 270.4], "ja": "あなたを失うわけにはいかない" },
    { "t": [270.5, 274.7], "ja": "約束する。何があっても、絶対に失ったりしないよ" },
    { "t": [279.3, 281.7], "ja": "これ、本当に起きてるの？" },
    { "t": [281.8, 283.3], "ja": "そうだといいな" },
    { "t": [283.4, 284.6], "ja": "ずいぶん時間がかかったわね" },
    { "t": [291.7, 298.1], "ja": "わあ、もう一回やろう" },
    { "t": [298.1, 300.1], "ja": "5秒前、4" }
  ]
}
