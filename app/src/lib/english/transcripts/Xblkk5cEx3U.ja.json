    { "t": [98.4,  100.1], "ja": "これ、毎日飲んでるの？" },
    { "t": [100.1,  101.2], "ja": "毎朝ね" },
    { "t": [101.2,  107.2], "ja": "2週間たって、まあまあ順調だし、楽しくやってる" },
    { "t": [107.2,  108.2], "ja": "えー、うん" },
    { "t": [108.2,  109.2], "ja": "あれが20個ある" },
    { "t": [109.2,  110.2], "ja": "おお！" },
