    { "t": [113.2,  114.2], "ja": "ごめん！" },
    { "t": [114.2,  117.2], "ja": "違うよ、今は紙の会社なんだ" },
    { "t": [117.2,  127.2], "ja": "教会のためじゃない！" },
    { "t": [128.2,  129.2], "ja": "おお！" },
    { "t": [129.2,  130.2], "ja": "何が必要か分かる？" },
    { "t": [130.2,  131.2], "ja": "ここにはソファが要る" },
    { "t": [131.2,  134.2], "ja": "マイケル、配達係を雇うことを本気で考えたほうがいいよ" },
    { "t": [134.2,  136.2], "ja": "ああ、君が気に入りそうなもの、分かるか？" },
    { "t": [136.2,  138.2], "ja": "ロフトを作るんだ" },
    { "t": [138.2,  140.2], "ja": "なんで私が気に入るの？" },
    { "t": [140.2,  141.2], "ja": "配達係を雇う余裕はある？" },
    { "t": [141.2,  142.2], "ja": "寮の部屋みたいな" },
    { "t": [142.2,  145.2], "ja": "机を下に置いて、ロフトを上に作る" },
    { "t": [145.2,  147.2], "ja": "上で寝られるんだ" },
    { "t": [147.2,  149.2], "ja": "うん、ロフトが何かぐらい知ってる" },
    { "t": [149.2,  151.2], "ja": "ほとんどの寮の部屋にはそんなのないし" },
    { "t": [151.2,  153.2], "ja": "雑誌の中ではほとんどあるぞ" },
    { "t": [153.2,  155.2], "ja": "配達係にいくらかかるか見てみよう" },
    { "t": [157.2,  159.2], "ja": "調べたほうがいいね" },
    { "t": [160.2,  162.2], "ja": "それか、ロフトにしちゃうか" },
    { "t": [162.2,  164.2], "ja": "配達係にいくらまでなら払える？" },
    { "t": [164.2,  166.2], "ja": "まあ、もらった数字が正しければ" },
    { "t": [166.2,  168.2], "ja": "正しいですよ" },
    { "t": [168.2,  170.2], "ja": "それなら、一銭も払えない" },
    { "t": [170.2,  171.2], "ja": "そうか" },
    { "t": [171.2,  174.2], "ja": "下手な冗談だな" },
    { "t": [174.2,  175.2], "ja": "空振りだ" },
    { "t": [175.2,  177.2], "ja": "値段が安すぎるんです" },
    { "t": [177.2,  178.2], "ja": "町で一番安い" },
    { "t": [178.2,  182.2], "ja": "なぜステープルズもダンダー・ミフリンも、あなたたちの価格に合わせられないと思います？" },
    { "t": [182.2,  183.2], "ja": "企業の強欲さ" },
    { "t": [183.2,  185.2], "ja": "いい？うちの価格設定は大丈夫" },
    { "t": [185.2,  187.2], "ja": "私が自分で数字を確認したから" },
    { "t": [187.2,  189.2], "ja": "時間がたって量が増えれば、利益が出る" },
    { "t": [189.2,  191.2], "ja": "ええ、固定費の価格モデルなら、そのとおり" },
    { "t": [191.2,  192.2], "ja": "そうでしょ" },
    { "t": [192.2,  194.2], "ja": "でも、変動費の価格モデルを使わないと" },
    { "t": [194.2,  195.2], "ja": "ああ、そうだな" },
    { "t": [195.2,  196.2], "ja": "そのとおり" },
    { "t": [196.2,  200.2], "ja": "じゃあ、それが何か説明してあげてくれ、みんなが分かるように…" },
    { "t": [200.2,  201.2], "ja": "ああ" },
    { "t": [201.2,  202.2], "ja": "それが何か説明して" },
    { "t": [202.2,  203.2], "ja": "それが何だと思うか、説明して" },
    { "t": [203.2,  204.2], "ja": "よし" },
    { "t": [204.2,  205.2], "ja": "とにかく説明してくれ" },
    { "t": [205.2,  207.2], "ja": "紙が売れて会社が大きくなるほど、経費も増えるんです" },
    { "t": [207.2,  211.2], "ja": "たとえば配達係、医療保険、事業の拡大" },
    { "t": [211.2,  212.2], "ja": "何でもいいよ" },
    { "t": [212.2,  213.2], "ja": "ああ" },
    { "t": [213.2,  216.2], "ja": "だから、この価格だと、紙を売れば売るほど、もうけが減るんです" },
    { "t": [216.2,  219.2], "ja": "この価格のおかげで、うちはやっていけてるんだ" },
    { "t": [219.2,  221.2], "ja": "実は、その値段のせいで会社がつぶれかけてるんです" },
    { "t": [221.2,  222.2], "ja": "分かった" },
