    { "t": [72.1,  76], "ja": "バンは中古車屋で手に入れたの" },
    { "t": [76,  80], "ja": "韓国語で「スクラントン・ハレルヤ教会」って書いてあるみたい" },
    { "t": [80,  83.6], "ja": "これか、フクロウが住みついた古いスクールバスかの、どちらかだった" },
    { "t": [83.6,  88.6], "ja": "コーヒーなんて持ってこなくてよかったのに、マイケル？" },
    { "t": [88.6,  89.6], "ja": "ミルクと砂糖！" },
    { "t": [89.6,  90.6], "ja": "わあ、最高" },
    { "t": [90.6,  91.6], "ja": "助かる" },
    { "t": [95.7,  97.2], "ja": "待って、これってミルクと砂糖だけ？" },
