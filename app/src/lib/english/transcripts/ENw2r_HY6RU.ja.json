{
  "video": "ENw2r_HY6RU",
  "lines": [
    { "t": [0, 1.6], "ja": "はい、ポーニー公園課のみなさん" },
    { "t": [1.6, 3.5], "ja": "もうすぐ、イーグルトンで" },
    { "t": [3.5, 5.9], "ja": "自分とだいたい同じ立場の人とペアになります" },
    { "t": [5.9, 7.9], "ja": "ドナはクレイグと組んでね" },
    { "t": [7.9, 10.6], "ja": "エイプリルはティニファーっていう人と" },
    { "t": [10.6, 12.8], "ja": "それからロン、あなたの相手もロンっていう名前よ" },
    { "t": [12.8, 15], "ja": "トム・ハヴァフォードに相当する人はいないみたいだな" },
    { "t": [15, 17.1], "ja": "驚かないね。俺はひとりしかいない存在だから" },
    { "t": [17.1, 18.5], "ja": "俺がデザインしたオーダーメイドのナイキみたいにね" },
    { "t": [18.5, 21.4], "ja": "つま先に「トミーの足ちゃん」って書いてあるやつ" },
    { "t": [21.4, 22.7], "ja": "実は、あなたにも相手がいるのよ" },
    { "t": [22.7, 25.4], "ja": "エリックっていう名前で、すごい人だって聞いたわ" },
    { "t": [25.4, 27.1], "ja": "それはともかく、ちょっとしたサプライズもあるの" },
    { "t": [27.1, 29.7], "ja": "新しい書類整理の臨時職員を紹介します" },
    { "t": [29.7, 31.1], "ja": "みんな、こんにちは！" },
    { "t": [31.1, 32.5], "ja": "やめて！　やめて！" },
    { "t": [32.5, 33.9], "ja": "なんで？　こんなのありえない" },
    { "t": [33.9, 35.8], "ja": "なんでなの、レスリー？" },
    { "t": [35.8, 36.8], "ja": "どうも、ドナよ" },
    { "t": [36.8, 38.2], "ja": "ああ、あなたにぴったりの名前ね" },
    { "t": [38.2, 40.7], "ja": "大好き。絶対に変えないで！" },
    { "t": [40.7, 42.4], "ja": "変えるつもりはなかったけど" },
    { "t": [42.4, 43.4], "ja": "あなたがクレイグね？" },
    { "t": [43.4, 45.4], "ja": "ああ、そう、その名前は大嫌い" },
    { "t": [45.4, 46.6], "ja": "すごく退屈" },
    { "t": [46.6, 49.3], "ja": "誰かのいとこのクレイグって感じでさ" },
    { "t": [49.3, 50.9], "ja": "テレンスっていうスペイン人男性になりたかったけど" },
    { "t": [50.9, 52.9], "ja": "そうはならなかった" },
    { "t": [52.9, 54.2], "ja": "そう" },
    { "t": [54.2, 57], "ja": "で、これが私の仕事のリスト" },
    { "t": [57, 59.3], "ja": "基本的に私はオフィスマネージャーなの" },
    { "t": [59.3, 60.3], "ja": "あなたは？" },
    { "t": [60.3, 61.6], "ja": "ああ、僕は全部やってた" },
    { "t": [61.6, 62.6], "ja": "全部だよ" },
    { "t": [62.6, 64.6], "ja": "何年もイーグルトンの課を一人で背負ってきたんだ" },
    { "t": [64.6, 65.7], "ja": "しかも、その一瞬一瞬が大好きだった" },
    { "t": [65.7, 68.5], "ja": "あなたにはわからないよ！" },
    { "t": [68.5, 70.9], "ja": "バミューダグラスに変えてもいいかな" },
    { "t": [70.9, 72.7], "ja": "1平方フィートあたり80セント高いだけだし" },
    { "t": [72.7, 73.7], "ja": "何だって？！" },
    { "t": [73.7, 75.2], "ja": "貸して、貸して、貸して" },
    { "t": [75.2, 77.9], "ja": "バミューダグラスを大陸性気候の場所に植えろって？" },
    { "t": [77.9, 79.7], "ja": "ビューフォート風力階級6の場所で" },
    { "t": [79.7, 81.5], "ja": "しかも排水設備ゼロの公園に？" },
    { "t": [81.5, 83.8], "ja": "ケンタッキーブルーグラスにしろ、1割引きにしろ" },
    { "t": [83.8, 89.8], "ja": "それから僕の親友のドナに謝れ！" },
    { "t": [89.8, 90.8], "ja": "ええ、どうも" },
    { "t": [90.8, 92.7], "ja": "ちょっと想像で言うんだけど" },
    { "t": [92.7, 95.9], "ja": "たくさん飲まなきゃいけない薬があって" },
    { "t": [95.9, 98.2], "ja": "今日は全然飲んでないか、飲みすぎたんじゃない？" },
    { "t": [98.2, 100.2], "ja": "ああ、病気だよ、そうだよ" },
    { "t": [100.2, 104.9], "ja": "「気にかけすぎる病」っていって、治らないんだ！" },
    { "t": [104.9, 106.4], "ja": "それに湿疹もある" },
    { "t": [108.7, 110.8], "ja": "いいわ、ドナ、人員を削減しないといけないの" },
    { "t": [110.8, 112.6], "ja": "もちろん、あなたの仕事は安泰よ" },
    { "t": [112.6, 114.7], "ja": "あなたは基本的に、この課のまとめ役だもの" },
    { "t": [114.7, 116.8], "ja": "でも、クレイグには辞めてもらわないといけないと思う" },
    { "t": [116.8, 118.6], "ja": "だめ、彼は残すべきよ" },
    { "t": [118.6, 121], "ja": "ものすごく暑苦しいけど、この仕事を" },
    { "t": [121, 122.5], "ja": "彼ほど大事に思ってる人には会ったことがない" },
    { "t": [122.5, 124.8], "ja": "あの、ドナ、ここにいるんだけど" },
    { "t": [124.8, 126.7], "ja": "冗談抜きで、あなたより大事に思ってるかも" },
    { "t": [126.7, 128.8], "ja": "正直、彼と私のどちらかを選ぶなら" },
    { "t": [128.8, 129.6], "ja": "彼を選ぶわ" },
    { "t": [129.6, 130.3], "ja": "待って、どういうこと？" },
    { "t": [130.3, 131.2], "ja": "辞めること考えてるの？" },
    { "t": [131.2, 132.7], "ja": "そのつもりはなかったけど、辞めてもいいわよ" },
    { "t": [132.7, 134.6], "ja": "ほら、シアトルにマンションもあるし" },
    { "t": [134.6, 135.8], "ja": "デンバーに婚約者もいるし" },
    { "t": [135.8, 137], "ja": "え？" },
    { "t": [137, 137.8], "ja": "長くは続かないわ" },
    { "t": [137.8, 140.1], "ja": "レスリー、人員を減らす必要があるなら" },
    { "t": [140.1, 141.4], "ja": "私は喜んでまた引退しますよ" },
    { "t": [141.4, 143.1], "ja": "何、ラリーまで辞めたいの？" },
    { "t": [143.1, 144.4], "ja": "いったいどうなってるの？" },
    { "t": [144.4, 146], "ja": "みんな、町の運営なんて" },
    { "t": [146, 148.4], "ja": "好きなときに来て好きなときに帰れる" },
    { "t": [148.4, 149.6], "ja": "ただのゲームだと思ってるわけ？" },
    { "t": [149.6, 151.6], "ja": "はいはい、レスリー" },
    { "t": [151.6, 153.2], "ja": "今夜は何か予定ある、クレイグ？" },
    { "t": [153.2, 155.1], "ja": "ああ、仕事が山ほどあるんだ" },
    { "t": [155.1, 157], "ja": "それに録画機が、妊娠13か月みたいにパンパンなんだ" },
    { "t": [157, 158.3], "ja": "「スキャンダル」の録画でね" },
    { "t": [158.3, 160.3], "ja": "「スキャンダル」は私の大好きな番組よ" },
    { "t": [160.3, 162.1], "ja": "どのキャラクターも大好き、ただ…" },
    { "t": [162.1, 163.6], "ja": "メリーは除いてね" },
    { "t": [163.6, 165.9], "ja": "ああ、もちろん「スキャンダル」が好きだよね" },
    { "t": [165.9, 167.6], "ja": "だって君は最高だから" },
    { "t": [167.6, 168.8], "ja": "愛してるよ" },
    { "t": [168.8, 170.6], "ja": "この仕事がどうなろうと" },
    { "t": [170.6, 172.5], "ja": "ずっと君を愛してる" },
    { "t": [172.5, 174], "ja": "今なんて？" },
    { "t": [174, 175.7], "ja": "あなた、いったい誰？" },
    { "t": [175.7, 195.7], "ja": "（音楽）" }
  ]
}
