{
  "video": "wFv3SQ0YTv0",
  "lines": [
    { "t": [0,2], "ja": "こんにちは！" },
    { "t": [2,3], "ja": "いらっしゃい！" },
    { "t": [3,4], "ja": "元気？" },
    { "t": [4,5], "ja": "さあ、入って" },
    { "t": [8,11], "ja": "やっと二人とこうして集まれて、本当にうれしいよ" },
    { "t": [11,12], "ja": "最高だ" },
    { "t": [12,15], "ja": "二人のコート、預かってくれる、ハニー？" },
    { "t": [15,16], "ja": "ええ、もちろん" },
    { "t": [16,17], "ja": "よし" },
    { "t": [17,19], "ja": "で、最近どうしてた？" },
    { "t": [19,21], "ja": "えっと、1時間前に会ってからってこと？" },
    { "t": [21,22], "ja": "ああ" },
    { "t": [22,24], "ja": "準備して、それから車でここに来ました" },
    { "t": [24,26], "ja": "まあ、私たちもだいたい同じことをしてたわ" },
    { "t": [26,27], "ja": "そうなんですか？" },
    { "t": [27,28], "ja": "運転以外はね" },
    { "t": [28,31], "ja": "これ、どうぞ" },
    { "t": [31,32], "ja": "あら、まあ、パム" },
    { "t": [32,33], "ja": "ありがとう" },
    { "t": [33,34], "ja": "すごくうれしい" },
    { "t": [34,36], "ja": "これは料理に使うのにすごくいいわね" },
    { "t": [36,41], "ja": "座って…　いや、入って…　いや、何ていうか、くつろいでくれ" },
    { "t": [41,42], "ja": "ここが我が家だ" },
    { "t": [42,43], "ja": "すごくすてき" },
    { "t": [43,44], "ja": "で、どうする？" },
    { "t": [44,45], "ja": "先に家の案内をしようか？" },
    { "t": [45,46], "ja": "前菜を先にする？" },
    { "t": [46,47], "ja": "案内を" },
    { "t": [47,48], "ja": "先に案内しよう" },
    { "t": [48,49], "ja": "分かった" },
    { "t": [49,50], "ja": "何か希望はある、ハニー？" },
    { "t": [50,51], "ja": "まず2階？" },
    { "t": [51,52], "ja": "完全に君に任せるよ、ハニー" },
    { "t": [52,53], "ja": "分かった" },
    { "t": [53,54], "ja": "じゃあ、行きましょう" },
    { "t": [54,55], "ja": "こっそり2階に行くわね" },
    { "t": [55,56], "ja": "あ" },
    { "t": [56,58], "ja": "ちょっと工事中なんですか？" },
    { "t": [58,60], "ja": "ああ、ガラスの引き戸を直してるだけよ" },
    { "t": [60,61], "ja": "うん" },
    { "t": [61,63], "ja": "このひどいカーペット、ごめんなさいね" },
    { "t": [63,65], "ja": "ここはまだ手を入れてる途中なの" },
    { "t": [65,66], "ja": "わあ" },
    { "t": [66,67], "ja": "それは…" },
    { "t": [67,69], "ja": "ここは私のオフィス" },
    { "t": [69,70], "ja": "うん" },
    { "t": [70,71], "ja": "一度も使ってない" },
    { "t": [71,72], "ja": "あまり面白くないわね" },
    { "t": [72,73], "ja": "ええ" },
    { "t": [73,74], "ja": "で、ここが私の作業スペース" },
    { "t": [74,75], "ja": "ここよ" },
    { "t": [75,76], "ja": "見てみて" },
    { "t": [76,77], "ja": "においがする？" },
    { "t": [77,78], "ja": "はい" },
    { "t": [78,80], "ja": "分かると思うけど、ここにはいろんなにおいがあるの" },
    { "t": [80,82], "ja": "オフィスと作業スペースがあるんですね" },
    { "t": [82,83], "ja": "そうなの" },
    { "t": [83,84], "ja": "ほら、私って…" },
    { "t": [84,87], "ja": "仕事をする場所と同じところでは、何かを生み出せないの" },
    { "t": [87,89], "ja": "あなたも落書きをする時はきっと同じでしょ" },
    { "t": [89,90], "ja": "かいでみて" },
    { "t": [91,92], "ja": "炎だ" },
    { "t": [92,93], "ja": "うん" },
    { "t": [93,94], "ja": "たき火" },
    { "t": [94,95], "ja": "ボン" },
    { "t": [95,96], "ja": "これ大好き" },
    { "t": [96,97], "ja": "ジェームズ・ボンファイア" },
    { "t": [97,98], "ja": "ボンファイアだ" },
    { "t": [98,99], "ja": "ジェームズ・ボンファイア" },
    { "t": [99,100], "ja": "マイケルがいない" },
    { "t": [101,102], "ja": "ねえ" },
    { "t": [102,106], "ja": "イライラしたり、むかついたり、怒ったりしたら" },
    { "t": [106,109], "ja": "ここに来て、キャンドルのにおいを全部かぐの" },
    { "t": [109,110], "ja": "そうすると、パッと消えちゃうの" },
    { "t": [110,111], "ja": "そんな簡単に？" },
    { "t": [111,112], "ja": "そんな簡単に" },
    { "t": [112,115], "ja": "で、ここが主寝室" },
    { "t": [115,117], "ja": "この壁、前は真っ白だったの" },
    { "t": [117,118], "ja": "精神病院みたいにね" },
    { "t": [118,120], "ja": "だから、もっと柔らかい感じにしたくて" },
    { "t": [120,121], "ja": "エッグシェルホワイトに塗ってもらったの" },
    { "t": [121,122], "ja": "そしたらね" },
    { "t": [122,124], "ja": "白とエッグシェルホワイトって、まったく同じ色だったのよ" },
    { "t": [124,125], "ja": "へえ" },
    { "t": [125,126], "ja": "そうかもね" },
    { "t": [126,127], "ja": "そうなのよ" },
    { "t": [127,129], "ja": "片付けておくって言ってたと思ったけど" },
    { "t": [129,130], "ja": "いや、私は…" },
    { "t": [130,132], "ja": "最低ね" },
    { "t": [132,135], "ja": "かわいいベンチですね" },
    { "t": [135,136], "ja": "ありがとう" },
    { "t": [136,137], "ja": "それは私のベッドだ" },
    { "t": [137,139], "ja": "ジャンは、えっと、スペースの問題があってね" },
    { "t": [139,141], "ja": "だから、あいつの上で丸くなって寝てる" },
    { "t": [141,142], "ja": "本当に？" },
    { "t": [142,144], "ja": "だって、かなり細いですよ" },
    { "t": [144,145], "ja": "それに短いし" },
    { "t": [145,147], "ja": "実は見た目よりずっと大きいんだ" },
    { "t": [147,148], "ja": "これを見て" },
    { "t": [148,149], "ja": "ほら" },
    { "t": [149,151], "ja": "ぴったり収まるだろ" },
    { "t": [151,158], "ja": "とうとう我慢できなくなって、自分に買ったんだ" },
    { "t": [158,162], "ja": "プラズマテレビを" },
    { "t": [162,163], "ja": "見てくれ" },
    { "t": [163,165], "ja": "実は自分で壁にかけたんだ" },
    { "t": [165,166], "ja": "いいですね" },
    { "t": [166,167], "ja": "見せたいものがある" },
    { "t": [167,169], "ja": "部屋に人が多いから" },
    { "t": [169,170], "ja": "スペースが必要だろ" },
    { "t": [170,171], "ja": "じゃーん" },
    { "t": [171,173], "ja": "壁にぴったり埋めこんだ" },
    { "t": [173,174], "ja": "わあ" },
    { "t": [174,178], "ja": "時々ここに立って、何時間もテレビを見るんだ" },
    { "t": [178,179], "ja": "最高だよ" },
    { "t": [179,181], "ja": "このテレビが大好きなんだ" },
    { "t": [181,182], "ja": "あっ！" },
    { "t": [182,184], "ja": "それに、このテーブルも作ったんだ" },
    { "t": [184,185], "ja": "それは何ですか？" },
    { "t": [185,186], "ja": "クリ？" },
    { "t": [186,187], "ja": "いや" },
    { "t": [187,188], "ja": "パインか、ノルディックチェリーのどっちかだと思う" },
    { "t": [188,189], "ja": "パインよ" },
    { "t": [189,190], "ja": "ああ" },
    { "t": [190,191], "ja": "マイケル、僕はこういうのが本当に苦手で" },
    { "t": [191,192], "ja": "だから、すごいですよ" },
    { "t": [192,193], "ja": "本当に？" },
    { "t": [193,194], "ja": "ええ" },
    { "t": [194,195], "ja": "彼がティーボを設定してくれようとしたら" },
    { "t": [195,197], "ja": "1週間、音が出なくなっちゃって" },
    { "t": [197,201], "ja": "もし何か手伝いが必要なら、電話1本で行くよ" },
    { "t": [201,204], "ja": "でしょうね" },
    { "t": [204,207], "ja": "そういえば、見たよ…　あ、ダンディー賞だ" },
    { "t": [207,209], "ja": "みんなに見えるように、コーヒーテーブルに飾ってないなんて意外ですね" },
    { "t": [209,214], "ja": "まあ、ネオンのビールの看板とダンディー賞のどっちかだったからね" },
    { "t": [214,217], "ja": "だから言ったの、「ハニー、トロフィーは残して」って" },
    { "t": [217,220], "ja": "ああ、ハニー、最高のトロフィーならここにいるよ" },
    { "t": [220,221], "ja": "まあ！" },
    { "t": [221,222], "ja": "ダンディー賞は別としてね" },
    { "t": [222,223], "ja": "あら" }
  ]
}
