{"video":"0Bq9TOA7EiQ","lines":[{"t":[0,2],"en":"Ron."},{"t":[2,4],"en":"Ron."},{"t":[4,6],"en":"Last name?"},{"t":[6,8],"en":"Dun."},{"t":[8,10],"en":"Is that your name, or are you telling me"},{"t":[10,12],"en":"you're finished talking?"},{"t":[12,14],"en":"Both."},{"t":[14,16],"en":"Dun and Dun."},{"t":[16,20],"en":"I like Ron."},{"t":[20,22],"en":"Okay, Eagleton Ron."},{"t":[22,24],"en":"Tell me a little about yourself."},{"t":[24,26],"en":"Well, I love the outdoors."},{"t":[26,28],"en":"Love nature. Amen."},{"t":[28,30],"en":"I'm a big believer in environmental"},{"t":[30,32],"en":"conservation. Recycling"},{"t":[32,34],"en":"and composting and the like."},{"t":[34,36],"en":"I'm a yoga nut."},{"t":[36,38],"en":"And I'm a nut nut."},{"t":[38,40],"en":"They make delicious milk, man."},{"t":[40,42],"en":"And I'm a vegan, of course."},{"t":[42,44],"en":"Slowly working towards full freegan vegan."},{"t":[44,46],"en":"What in God's name is freegan vegan?"},{"t":[46,48],"en":"You only eat vegetables"},{"t":[48,50],"en":"that have been thrown out in people's dumpsters."},{"t":[50,52],"en":"What is on your foot, sir?"},{"t":[52,54],"en":"My trusty sandals."},{"t":[54,56],"en":"I believe a man's feet should remain"},{"t":[56,58],"en":"uncaged."},{"t":[58,60],"en":"Same goes for all chickens."},{"t":[60,62],"en":"Well, uh, Eagleton Ron,"},{"t":[62,64],"en":"we here in Pawnee value loyalty"},{"t":[64,66],"en":"above all else."},{"t":[66,68],"en":"So, would you be opposed to signing"},{"t":[68,70],"en":"an official loyalty pledge to our new town?"},{"t":[70,72],"en":"As long as that new town"},{"t":[72,74],"en":"were open to the ideals of communal living,"},{"t":[74,76],"en":"where everyone pitches in"},{"t":[76,78],"en":"towards a common good."},{"t":[78,80],"en":"Any immortal words of Cat Stevens?"},{"t":[80,82],"en":"You want to be free?"},{"t":[82,84],"en":"Be free."},{"t":[84,86],"en":"I no longer like Ron."},{"t":[86,88],"en":"You can't force friendship, Leslie."},{"t":[88,90],"en":"It takes time."},{"t":[90,92],"en":"I once thought I had a friend."},{"t":[92,94],"en":"Then it turned out he was the single"},{"t":[94,96],"en":"worst person I have ever met."},{"t":[96,98],"en":"I agree with Ron, Leslie."},{"t":[98,102],"en":"It's like Maz once said."},{"t":[102,104],"en":"Hold on to your friends."},{"t":[104,106],"en":"Morrissey."},{"t":[106,107],"en":"The Smiths."},{"t":[107,108],"en":"You don't know meat is murder?"},{"t":[108,110],"en":"It's one of the best songs ever written"},{"t":[110,112],"en":"about industrialized beef consumption."},{"t":[112,114],"en":"Okay, Eagleton Ron."},{"t":[114,115],"en":"I think it might be time for you to go."},{"t":[115,118],"en":"This Ron has a position pretty much locked up,"},{"t":[118,120],"en":"and, uh, I don't think we have"},{"t":[120,122],"en":"any room for you in our department."},{"t":[122,123],"en":"Fair enough."},{"t":[123,125],"en":"I should have seen it."},{"t":[125,127],"en":"Tars and Capricorns."},{"t":[127,129],"en":"They were mixed, do they?"},{"t":[129,131],"en":"Just remember, Ron,"},{"t":[131,133],"en":"giving it a hate"},{"t":[133,135],"en":"is like drinking salt water."},{"t":[135,138],"en":"The thirst only grows worse."},{"t":[138,140],"en":"Leslie, remove this man"},{"t":[140,142],"en":"before I commit an act of violence against him."},{"t":[142,144],"en":"Whatever you do,"},{"t":[144,146],"en":"I won't fight back."},{"t":[155,158.5],"en":"We'll be right back."}]}
