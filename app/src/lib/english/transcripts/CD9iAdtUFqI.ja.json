{
  "video": "CD9iAdtUFqI",
  "lines": [
    { "t": [0, 3], "ja": "エイプリル！メッセージ聞いたよ！" },
    { "t": [3, 4], "ja": "どこにいるの？" },
    { "t": [4, 6], "ja": "机の下" },
    { "t": [6, 8], "ja": "なんで隠れてるの？" },
    { "t": [8, 10], "ja": "俺も隠れたほうがいい？" },
    { "t": [10, 11], "ja": "どうしたの？" },
    { "t": [11, 12], "ja": "課のファイルを全部" },
    { "t": [12, 14], "ja": "ユーエスビーメモリーにコピーすることになってたんだけど、何度も固まって" },
    { "t": [14, 16], "ja": "イライラしてたら、何が起きたのかわからないけど" },
    { "t": [16, 19], "ja": "どのパソコンからもファイルが全部消えちゃったの" },
    { "t": [19, 20], "ja": "全部消えちゃった。ねえ、全部消えちゃったの" },
    { "t": [20, 22], "ja": "わかった、わかった、落ち着いて" },
    { "t": [22, 23], "ja": "まず、この机の下に隠れたのは" },
    { "t": [23, 25], "ja": "正しい判断だよ" },
    { "t": [25, 27], "ja": "次に、君の男がここにいる" },
    { "t": [27, 29], "ja": "俺たちのためにこれを何とかするよ" },
    { "t": [29, 32], "ja": "何年もエックスボックスをやってきたんだ" },
    { "t": [32, 34], "ja": "固まったときに直すのはすごく得意なんだよ" },
    { "t": [34, 36], "ja": "どうすればいいか、ちゃんとわかってる" },
    { "t": [42, 43], "ja": "今やってみて" },
    { "t": [43, 45], "ja": "急いでお願い" },
    { "t": [45, 47], "ja": "生きるか死ぬかの問題だって言ったの" },
    { "t": [47, 48], "ja": "ハニー、ドナはずっと昔からここにいるんだ" },
    { "t": [48, 49], "ja": "きっとどうすればいいかわかるよ" },
    { "t": [49, 52], "ja": "わからなかったら？クビになるかも" },
    { "t": [52, 54], "ja": "もっと悪いと、レスリーにまた責任について" },
    { "t": [54, 56], "ja": "説教されるかも。そんなの無理" },
    { "t": [56, 58], "ja": "じゃあこうしよう、ハニー" },
    { "t": [58, 61], "ja": "君がクビになったら、俺も辞める。一緒に出ていこう" },
    { "t": [61, 63], "ja": "本気だよ。新しい街に引っ越して" },
    { "t": [63, 66], "ja": "名前を変えて、酸で指紋を焼き消して" },
    { "t": [66, 68], "ja": "顔を取りかえる" },
    { "t": [68, 69], "ja": "何？" },
    { "t": [69, 70], "ja": "必要ならね" },
    { "t": [70, 72], "ja": "よし、住む場所はそれでいい" },
    { "t": [72, 74], "ja": "次は夢の仕事の話に戻ろう" },
    { "t": [74, 76], "ja": "新しい人生を始めるなら、俺のはこれ" },
    { "t": [76, 79], "ja": "刑事、エフビーアイ捜査官、警察官、シーアイエー捜査官" },
    { "t": [79, 81], "ja": "だから、君のがもっと必要だ。さあ" },
    { "t": [81, 82], "ja": "ねえ、私はいらない…" },
    { "t": [82, 84], "ja": "楽しいだろ。君が犯したこのひどい失敗から" },
    { "t": [84, 86], "ja": "気をそらしてあげようとしてるんだよ" },
    { "t": [86, 88], "ja": "ファイルを全部消しちゃったことからね" },
    { "t": [88, 90], "ja": "たぶん公園課の歴史で" },
    { "t": [90, 91], "ja": "一番ひどい出来事だよ" },
    { "t": [91, 92], "ja": "ああもう" },
    { "t": [92, 93], "ja": "俺たちきっとクビになるし" },
    { "t": [93, 94], "ja": "俺は助けようとしてるんだ" },
    { "t": [94, 95], "ja": "ああもう" },
    { "t": [95, 96], "ja": "で、夢の仕事。どうぞ" },
    { "t": [96, 97], "ja": "大きな夢を持てよ" },
    { "t": [97, 98], "ja": "わかった" },
    { "t": [98, 101], "ja": "霊能者でもある歯科衛生士" },
    { "t": [101, 103], "ja": "そうすれば人の歯を掃除しながら" },
    { "t": [103, 104], "ja": "いつ死ぬか教えてあげられる" },
    { "t": [104, 105], "ja": "天才的だね" },
    { "t": [105, 106], "ja": "さっさと済ませましょう" },
    { "t": [106, 108], "ja": "ハウザー議員とあと少しでうまくいくところだったのに" },
    { "t": [108, 109], "ja": "あんたたちに邪魔されたのよ" },
    { "t": [109, 110], "ja": "どのファイルを消したの？" },
    { "t": [110, 111], "ja": "全部" },
    { "t": [111, 113], "ja": "ばかみたいなユーエスビーメモリーを差して" },
    { "t": [113, 114], "ja": "全部をドラッグして移そうとしたら" },
    { "t": [114, 115], "ja": "それで…" },
    { "t": [115, 116], "ja": "直ったわ" },
    { "t": [116, 117], "ja": "え？" },
    { "t": [117, 118], "ja": "え？どうやって？" },
    { "t": [118, 119], "ja": "ジェリーがしょっちゅううっかり消すのよ" },
    { "t": [119, 122], "ja": "10年前、自分だけの秘密のバックアップを入れておいたの" },
    { "t": [122, 123], "ja": "助かったよ、ドナ" },
    { "t": [123, 124], "ja": "あら" },
    { "t": [124, 125], "ja": "愛してる" },
    { "t": [125, 126], "ja": "あら、まあね" },
    { "t": [126, 127], "ja": "おいで、坊や" },
    { "t": [127, 128], "ja": "愛してる" }
