{
  "video": "6ILnFPZtOKY",
  "lines": [
    { "t": [0,2.7], "ja": "うわっ！" },
    { "t": [2.7,3.7], "ja": "パム？" },
    { "t": [3.7,4.6], "ja": "ああっ！" },
    { "t": [4.6,8.6], "ja": "パム、よし、分かった、よし、病院に行く時間だ" },
    { "t": [8.6,10.1], "ja": "誰かジムを呼んでくれ" },
    { "t": [10.1,10.9], "ja": "もう夜中の12時？" },
    { "t": [10.9,12], "ja": "いいえ、4時35分です" },
    { "t": [12,15], "ja": "4時35分か、よし、惜しかった、あと少しだった" },
    { "t": [15,18.2], "ja": "エッチするのがあと7時間半遅ければよかったのにな" },
    { "t": [18.2,19.6], "ja": "でも昼間からお楽しみしちゃったんだな" },
    { "t": [19.6,21.5], "ja": "分かるよ、時には勢いが大事だからな" },
    { "t": [21.5,23], "ja": "さあ、病院に行こうか？" },
    { "t": [23,24.6], "ja": "いいえ、まだです、マイケル" },
    { "t": [24.6,25.9], "ja": "いいですよ…　わあ、もうすぐ" },
    { "t": [25.9,27.1], "ja": "ウルトラ・フィーストの時間だ" },
    { "t": [27.1,28.7], "ja": "あっ　ケビンはどこ？" },
    { "t": [28.7,31.6], "ja": "何？　ケビンとキャットフードを食べたいから" },
    { "t": [31.6,32.7], "ja": "病院に行かないって？" },
    { "t": [32.7,34], "ja": "それはファンシー・フィーストです" },
    { "t": [34,35.7], "ja": "ウルトラ・フィーストは二人がでっちあげたもので" },
    { "t": [35.7,38.4], "ja": "儀式だって言い訳して、一緒にたらふく食べるんです" },
    { "t": [38.4,39.6], "ja": "オクトーバー・フィーストって何だ？" },
    { "t": [39.6,42.2], "ja": "急いで病院に行く必要はないの" },
    { "t": [42.2,44.8], "ja": "大丈夫、そのうち行くから" },
    { "t": [46.1,48.8], "ja": "もし間に合わなかったら、それはそれでいい" },
    { "t": [51.2,56.4], "ja": "今年のウルトラ・フィーストのテーマはハリウッド" },
    { "t": [56.4,58.9], "ja": "映画「レミーのおいしいレストラン」のラタトゥイユと" },
    { "t": [58.9,62.4], "ja": "「未来を写した子どもたち」のタンドリーチキン" },
    { "t": [62.4,66], "ja": "「第9地区」のエビみたいなケーキも焼こうとしたけど" },
    { "t": [66,69.2], "ja": "でも…　大丈夫？" },
    { "t": [69.2,70.6], "ja": "うん" },
    { "t": [70.6,74.1], "ja": "ええ、大丈夫、えっと…　本当に？" },
    { "t": [74.1,76.3], "ja": "うん、お医者さんが言ってたの、話しながら耐えられるうちは" },
    { "t": [76.3,78.9], "ja": "まだ軽い陣痛なんだって" },
    { "t": [78.9,81.1], "ja": "よし、よし、ジム" },
    { "t": [81.1,83.8], "ja": "このパーティーは終わりだ、病院に行く時間だぞ" },
    { "t": [83.8,86.1], "ja": "もう行く時間だ　そうだ、行こう" },
    { "t": [86.1,87.3], "ja": "とにかく行ってみよう　いや、いや、ましになった" },
    { "t": [87.3,88.6], "ja": "さあ行こう　今のは一番ひどいのでもなかったし" },
    { "t": [88.6,89.8], "ja": "大丈夫　ねえ、行こうよ" },
    { "t": [89.8,91.3], "ja": "まだそんなにひどくないよ、ハニー" },
    { "t": [91.3,92.6], "ja": "パム、行こう　いや、もう治まってきた、大丈夫" },
    { "t": [92.6,93.7], "ja": "パム、時間だ、病院に行こう" },
    { "t": [93.7,94.6], "ja": "行こう、パム　大丈夫だよ" },
    { "t": [94.6,95.7], "ja": "あ、マイケルが今すぐ行けって" },
    { "t": [95.7,97.2], "ja": "うん、そろそろ出たほうがいいと思う" },
    { "t": [97.2,98.9], "ja": "パム　ううん、もう過ぎた、大丈夫" },
    { "t": [98.9,100.2], "ja": "さあ行こう　よし、行こう" },
    { "t": [100.2,101.2], "ja": "行こう、病院に行かなきゃ" },
    { "t": [101.2,102.5], "ja": "ハニー、私は行かない、行かない…　大丈夫だから" },
    { "t": [102.5,103.7], "ja": "さあ、行こう　ほら、ほら" },
    { "t": [103.7,106.2], "ja": "いいえ、行かない、絶対に行かないから、いい？" },
    { "t": [106.2,107.2], "ja": "分かった、いいよ" },
    { "t": [107.2,109.6], "ja": "今日は行かない、だって私には無理だもの" },
    { "t": [109.6,110.7], "ja": "できる気がしないの" },
    { "t": [110.7,114.8], "ja": "おい、おい、おい、冗談だろ？" },
    { "t": [114.8,116.9], "ja": "冗談でしょ？" },
    { "t": [116.9,119], "ja": "誰かにできるとしたら、それは君だよ" },
    { "t": [119,120.8], "ja": "君ならできる、君ならできるよ" },
    { "t": [120.8,123], "ja": "パム、僕も怖いよ、すごく怖い" },
    { "t": [123,125.1], "ja": "私も怖い　僕なんか震え上がってる" },
    { "t": [125.1,128.5], "ja": "でも一番いい知らせは、今日、僕たちに赤ちゃんが生まれるってこと" },
    { "t": [128.5,129.3], "ja": "うん" },
    { "t": [129.3,130.6], "ja": "最高にかわいい赤ちゃんがね" },
    { "t": [130.6,132.3], "ja": "赤ちゃんが生まれるのよ" },
    { "t": [132.3,133.8], "ja": "だから病院で産もう" },
    { "t": [133.8,135.4], "ja": "そうしよう" },
    { "t": [135.4,136.8], "ja": "陣痛の間隔はどうだ？" },
    { "t": [136.8,139], "ja": "2分おきです　2分か" },
    { "t": [139,140.7], "ja": "ああ、もう" },
    { "t": [140.7,142.1], "ja": "マイケル、言ったでしょ…　大丈夫だ" },
    { "t": [142.1,143.6], "ja": "いや、5分になったら知らせろって言ったでしょ" },
    { "t": [143.6,144.8], "ja": "ジム、待ちすぎたな" },
    { "t": [144.8,146.2], "ja": "分かってる　待ちすぎたよ" },
    { "t": [146.2,147.5], "ja": "2分じゃもう遅いんだよ" },
    { "t": [147.5,148.9], "ja": "4分や3分の時はどうしたんだ？" },
    { "t": [148.9,149.7], "ja": "大丈夫だよ、ジム" },
    { "t": [149.7,152.6], "ja": "よし、パメラ、今何の時間か分かるか？" },
    { "t": [152.6,154.2], "ja": "ここで赤ちゃんを産みたくない" },
    { "t": [154.2,156.2], "ja": "ここでは産まないさ、どこに行くか分かってるだろ" },
    { "t": [156.2,157.1], "ja": "病院" },
    { "t": [157.1,158.9], "ja": "そうだ、それで何が生まれるか分かるか？" },
    { "t": [158.9,159.7], "ja": "赤ちゃん" },
    { "t": [159.7,161], "ja": "そうだ、病院に行って" },
    { "t": [161,161.9], "ja": "赤ちゃんを産むんだ" },
    { "t": [161.9,163.9], "ja": "任せろ、任せろ、みんな、出発の時間だ" },
    { "t": [163.9,166], "ja": "持ち場につけ、スタンリーは電話番だ" },
    { "t": [166,167.8], "ja": "メレディス、水を1本頼む" },
    { "t": [167.8,169.1], "ja": "エリン、救急車を呼んでくれ" },
    { "t": [169.1,171.6], "ja": "だめ、だめ、だめ、救急車は緊急の時だけだ" },
    { "t": [171.6,173.5], "ja": "救急車を呼んだら、警察に通報するぞ" },
    { "t": [173.5,174.7], "ja": "分かった、実は自分たちで運転して行くよ" },
    { "t": [174.7,176.5], "ja": "だめだ、ジム、君は運転できる状態じゃない" },
    { "t": [176.5,178.4], "ja": "私が運転する、確認、了解" },
    { "t": [178.4,179.7], "ja": "よし、財布はある" },
    { "t": [179.7,180.5], "ja": "うん" },
    { "t": [180.5,181.5], "ja": "緊急用バッグは車の中" },
    { "t": [181.5,182.5], "ja": "あれが緊急用バッグだ、あれだ" },
    { "t": [182.5,183.5], "ja": "鍵がいる" },
    { "t": [183.5,184.5], "ja": "何も入ってないぞ" },
    { "t": [184.5,185.5], "ja": "今になって、何も入ってないって言うのか？" },
    { "t": [185.5,186.5], "ja": "ああ、最高だな" },
    { "t": [186.5,189.2], "ja": "あ、ねえ、病院に辞書を持っていったほうがいい？" },
    { "t": [189.2,190.6], "ja": "辞書は病院にあるよ" },
    { "t": [190.6,191.8], "ja": "類語辞典を持っていけ" },
    { "t": [191.8,193.3], "ja": "子宮口がどれくらい開いてるか誰か確かめたか？" },
    { "t": [193.3,194.3], "ja": "こんなのばかげてる" },
    { "t": [194.3,195.2], "ja": "ドワイト、離れて" },
    { "t": [195.2,197], "ja": "だめ、だめ、ドワイト、それはジムにやらせてくれ" },
    { "t": [197,198.6], "ja": "うちにメジャーがあるなんて知らなかった" },
    { "t": [198.6,199.7], "ja": "ないよ" },
    { "t": [199.7,202], "ja": "よし、鍵が見つからない、鍵がどこにもない" },
    { "t": [202,204], "ja": "あった、さあ行こう、行こう" },
    { "t": [204,205], "ja": "さあ行こう" },
    { "t": [205,206], "ja": "頑張って" },
    { "t": [206,207], "ja": "頑張ってね、パム" },
    { "t": [207,208], "ja": "またね、パム" },
    { "t": [208,209], "ja": "ありがとう" },
    { "t": [209,210], "ja": "応援してね" },
    { "t": [210,211], "ja": "楽しんで" },
    { "t": [213,215], "ja": "おい、5時だ" },
    { "t": [215,218], "ja": "さあ行くぞ、行くぞ、出発だ" },
    { "t": [218,219], "ja": "よし" },
    { "t": [219,222], "ja": "来いよ、スタンリー、よし" },
    { "t": [222,223], "ja": "もう行くぞ" },
    { "t": [223,224], "ja": "いや、あと一人" },
    { "t": [224,227], "ja": "だめ、だめ、出ろ、出ろ、バカ" },
    { "t": [227,228], "ja": "ドワイト、道の混み具合は？" },
    { "t": [228,229], "ja": "関係ない、私が先導する" },
    { "t": [229,231.4], "ja": "どうした？　先導してやる　分かった" },
    { "t": [233.4,236.2], "ja": "行くぞ！　落ち着け、ドワイト" },
    { "t": [240.9,242.1], "ja": "マイケル！　何だ？" },
    { "t": [242.1,243.9], "ja": "マイケル！　何だ？" },
    { "t": [243.9,246], "ja": "ここで先週シカを見たんだ" },
    { "t": [246,248.2], "ja": "どこ？　あのフェンスのすぐそば" },
    { "t": [248.2,249.9], "ja": "しげみのところ？　マイケル、集中して" },
    { "t": [249.9,252.5], "ja": "よし、行け、行け、行け！　行こう！" },
    { "t": [259,263], "ja": "どうした？　いや　えっと…" }
  ]
}
