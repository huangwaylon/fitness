  "lines": [
    { "t": [0, 2], "ja": "さて、ここがバンドの場所で" },
    { "t": [2, 3.6], "ja": "ここがバーの場所" },
    { "t": [3.6, 6], "ja": "それで、このピン全部に人の名前が書いてあるの" },
    { "t": [6, 8.3], "ja": "あ、レイチ、あなたはここよ" },
    { "t": [8.3, 10], "ja": "わあ" },
    { "t": [10, 11.5], "ja": "じゃあ、私をこう持っていって" },
    { "t": [11.5, 13.7], "ja": "マンハッタンを片手に持たせて" },
    { "t": [13.7, 15.9], "ja": "かわいいバーテンダーと話してるところにしてよ" },
    { "t": [19.9, 21.9], "ja": "このピン、遊ぶためのものじゃないよね？" },
    { "t": [23.4, 25.1], "ja": "いい、赤いのが私のお客さんで" },
    { "t": [25.1, 26.1], "ja": "青いピンがあなたのね" },
    { "t": [26.1, 29.3], "ja": "悲しすぎる。だって、僕のピンは10本くらいしかない" },
    { "t": [29.3, 31.8], "ja": "ねえ、落ち着いて。競争じゃないんだから" },
    { "t": [31.8, 33.8], "ja": "少なくとも接戦じゃないね" },
    { "t": [36.3, 37.3], "ja": "こんにちは" },
    { "t": [37.3, 38.5], "ja": "やあ" },
    { "t": [38.5, 40.7], "ja": "わあ、みんな楽しそうだね" },
    { "t": [42.1, 44.2], "ja": "ねえ、それで僕の両親はどこになるの？" },
    { "t": [44.2, 45.8], "ja": "ええと、どれどれ" },
    { "t": [45.8, 47.8], "ja": "じゃあ、ここが結婚式の会場だとすると" },
    { "t": [47.8, 51.7], "ja": "えっと、あなたのご両親は、ここ、クイーンズの家ね" },
    { "t": [52.9, 54.5], "ja": "え？招待されてないの？" },
    { "t": [54.5, 57.1], "ja": "うそ、ひどいよ。すごく落ち込むだろうな" },
    { "t": [57.1, 58.6], "ja": "なんで招待されてると思ってるの？" },
    { "t": [58.6, 61.1], "ja": "さあね、分からない…" },
    { "t": [62.6, 63.4], "ja": "ジョーイ" },
    { "t": [63.4, 65.7], "ja": "ごめん。だって、親は来るものだと思ってたんだ" },
    { "t": [65.7, 67.5], "ja": "ほら、君の両親は来るだろ" },
    { "t": [67.5, 69], "ja": "チャンドラーの両親も来るし" },
    { "t": [69, 70.8], "ja": "ロスの両親も来る" },
    { "t": [72.2, 74.3], "ja": "ロスの両親は私の両親よ" },
    { "t": [75.9, 77.3], "ja": "ほら、親は来るじゃないか" },
    { "t": [79.1, 80.6], "ja": "ねえ、招待したほうがいいと思う" },
    { "t": [80.6, 82.9], "ja": "もう、やめてよ。青いピンを増やしたいだけでしょ" },
    { "t": [82.9, 84.3], "ja": "これは本当に悲しいね" },
