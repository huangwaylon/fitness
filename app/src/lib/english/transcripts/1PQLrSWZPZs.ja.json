{
  "video": "1PQLrSWZPZs",
  "lines": [
    { "t": [0, 5.5], "ja": "（音楽）" },
    { "t": [5.5, 8.5], "ja": "（音楽）" },
    { "t": [8.5, 12.5], "ja": "（音楽）" },
    { "t": [17.5, 21], "ja": "（音楽）" },
    { "t": [21, 23.5], "ja": "（音楽）" },
    { "t": [23.5, 26], "ja": "「ロスト」で、あの人たちに会った時のこと覚えてる？" },
    { "t": [28.7, 31.4], "ja": "本当にごめん" },
    { "t": [31.4, 33.1], "ja": "それで、どこまで話したっけ？" },
    { "t": [33.2, 35], "ja": "パム、じゃあメモを取ってくれる？" },
    { "t": [35.3, 37.3], "ja": "お願い、どうもありがとう" },
    { "t": [37.3, 39.3], "ja": "じゃあ、倉庫のみんなに会おう" },
    { "t": [39.3, 41.6], "ja": "映像を撮ろう" },
    { "t": [41.6, 44.2], "ja": "ぐるっと映して" },
    { "t": [44.2, 47.7], "ja": "こちらはダリル、倉庫のスタッフの一人だ" },
    { "t": [47.7, 49.7], "ja": "ダリル、一番怖いことは何？" },
    { "t": [50.5, 52.6], "ja": "一番怖いのは、誰かに邪魔されて" },
    { "t": [52.6, 53.9], "ja": "荷物を時間通りに全部出せなくなることです" },
    { "t": [53.9, 56.6], "ja": "実はね、ここの現場主任はダリルなんだ" },
    { "t": [56.6, 57.9], "ja": "ロイじゃなくて。いいことだよ" },
    { "t": [57.9, 60.3], "ja": "あれが大型トラックに乗ってるロイだ" },
    { "t": [60.3, 64.2], "ja": "ロイは、実はこの夏のいつか、パムと結婚するんだ" },
    { "t": [64.2, 66.8], "ja": "彼女はうちの受付係だよ" },
    { "t": [66.8, 68.1], "ja": "ブランジェリーナみたいなものだね" },
    { "t": [68.1, 69.2], "ja": "なんで？" },
    { "t": [70.3, 73.3], "ja": "ブランジェリーナっていうのは、ブラッド・ピットとアンジェリーナで" },
    { "t": [73.3, 74], "ja": "分かります" },
    { "t": [74, 76.1], "ja": "ロイとパムで、ラムだ" },
    { "t": [76.1, 77.8], "ja": "ラムってやつだよ" },
    { "t": [77.8, 80.4], "ja": "ロイはきっと、お前がパムを好きなことを聞いたぞ" },
    { "t": [80.4, 83.5], "ja": "きっと殴りに来るぞ" },
    { "t": [83.5, 85.3], "ja": "教えてくれてありがとう、ケブ" },
    { "t": [85.3, 87.7], "ja": "もしそうなったら、俺が味方してやる" },
    { "t": [87.7, 93.1], "ja": "私はなるべく関わらないようにしてる" },
    { "t": [93.1, 96.7], "ja": "ここに、いるべきじゃない人がいるといけないからね" },
    { "t": [96.7, 98.5], "ja": "ちょっとした「グッド・ウィル・ハンティング」みたいな状況だ" },
    { "t": [98.5, 100.3], "ja": "よし、諸君" },
    { "t": [100.3, 103.1], "ja": "今日は大事な日だ" },
    { "t": [103.1, 104], "ja": "大切な日だ" },
    { "t": [104, 109.4], "ja": "さて、周りを見ると、ここには二つのグループがいるだろう" },
    { "t": [109.4, 111.9], "ja": "ホワイトカラーとブルーカラーだ" },
    { "t": [111.9, 113.4], "ja": "でも、私はそうは見ていない" },
    { "t": [113.4, 114.2], "ja": "なぜだか分かるか？" },
    { "t": [115, 116.7], "ja": "私にはカラーの違いが見えないからだ" }
  ]
}
