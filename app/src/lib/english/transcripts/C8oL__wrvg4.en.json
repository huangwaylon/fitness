{"video":"C8oL__wrvg4","lines":[{"t":[0,1],"en":"I'm gonna miss you."},{"t":[1,2],"en":"Don't."},{"t":[2,3],"en":"What?"},{"t":[3,4],"en":"Don't make me cry."},{"t":[20,22],"en":"Thanks for taking care of me."},{"t":[23,25],"en":"Come on."},{"t":[25,28],"en":"You both know I'm a big, tall, goofy man-child."},{"t":[29,31],"en":"You took care of yourself."},{"t":[31,32],"en":"Yeah."},{"t":[32,35],"en":"Maybe in some ways, but..."},{"t":[36,38],"en":"you've always made me laugh."},{"t":[39,42],"en":"And feel safe."},{"t":[43,48],"en":"Showing me that being a grown-up doesn't mean you have to stop being silly..."},{"t":[49,51],"en":"and creative..."},{"t":[52,54],"en":"and fun."},{"t":[58,60],"en":"Well, now you made me cry."},{"t":[67,68],"en":"I love you."},{"t":[69,70],"en":"I love you too, kid."}]}
