{
  "video": "jOoTPjSrFXw",
  "lines": [
    { "t": [0, 3], "ja": "先生方、手術はこれで終わりです" },
    { "t": [3, 5], "ja": "ゾーイ先生、反射ハンマーを使って" },
    { "t": [5, 6.4], "ja": "彼女が大丈夫か確かめてくれますか？" },
    { "t": [6.4, 9.6], "ja": "子どもたちとこんなに楽しく過ごしたのは初めて" },
    { "t": [9.6, 12.4], "ja": "大きくなったらお医者さんになりたいって言ってたの" },
    { "t": [12.4, 14.5], "ja": "ベビーシッターの皆さんにとっておきの情報" },
    { "t": [14.5, 17.3], "ja": "子どもには、いつでも医療器具で遊ばせてあげて" },
    { "t": [17.3, 18.6], "ja": "問題発生だ。何？" },
    { "t": [18.6, 19.8], "ja": "うそでしょ" },
    { "t": [19.8, 22], "ja": "お嬢さんたち、これは交渉じゃないの" },
    { "t": [22, 23.6], "ja": "今すぐドアの鍵を開けて" },
    { "t": [23.6, 25.5], "ja": "いや！手術中なの" },
    { "t": [25.5, 27.4], "ja": "ここに入れるのはお医者さんだけ" },
    { "t": [27.4, 28.7], "ja": "分かった" },
    { "t": [28.7, 30.4], "ja": "下がってて、お嬢さんたち" },
    { "t": [30.4, 32.2], "ja": "だめ、だめ、だめ、だめ、それは危ないよ" },
    { "t": [32.2, 33.7], "ja": "ここにいる誰かが鍵を持ってるはずでしょ？" },
    { "t": [33.7, 35], "ja": "僕が鍵を持ってるかって？何？" },
    { "t": [35, 37.3], "ja": "ジェリー、まさかこんなことを言う日が来るとは思わなかったけど" },
    { "t": [37.3, 38.8], "ja": "あなたがいてくれて本当によかった" },
    { "t": [38.8, 42.9], "ja": "まあ、このどれかだよね？" },
    { "t": [42.9, 43.9], "ja": "うわ" },
    { "t": [43.9, 45.4], "ja": "お嬢さんたち、だめ、だめ、だめ、だめ、だめ、だめ" },
    { "t": [45.4, 47.1], "ja": "患者さんは髪を切らないといけません" },
    { "t": [47.1, 48.6], "ja": "髪がばい菌にやられてるの" },
    { "t": [48.6, 50.6], "ja": "急いで、ジェリー！分かった、分かった、これを強く回そうとしてるんだ" },
    { "t": [50.6, 51.3], "ja": "だめ" },
    { "t": [51.3, 53.2], "ja": "よし、こういうプレッシャーには弱いんだよ" },
    { "t": [53.2, 54.9], "ja": "ゾーイ、やめて、お願い" },
    { "t": [54.9, 55.7], "ja": "いや" },
    { "t": [55.7, 57.4], "ja": "ゾーイ、はさみを置いて" },
    { "t": [57.4, 60.9], "ja": "ああ" },
    { "t": [60.9, 62.3], "ja": "だめ！" },
    { "t": [62.3, 64.8], "ja": "（無音）" },
    { "t": [64.8, 66.7], "ja": "これだ。これが…" },
    { "t": [66.7, 69.2], "ja": "ああ、なんでこんなにたくさん鍵を持ってるんだ？" },
    { "t": [69.2, 71.5], "ja": "教えてもらった通りに手術したの" },
    { "t": [71.5, 72.6], "ja": "よし、いい？" },
    { "t": [72.6, 74.5], "ja": "あなたたちはこの髪を全部片付けて" },
    { "t": [74.5, 75.7], "ja": "私はロンと話してくるから" },
    { "t": [75.7, 76.9], "ja": "足の指を切り落とそう！" },
    { "t": [76.9, 78], "ja": "だめ、やめようね" },
    { "t": [78, 80.1], "ja": "このバッグも持っていくわね" },
    { "t": [80.1, 81.8], "ja": "これを何とかしてくれ" },
    { "t": [81.8, 83.8], "ja": "そんなにひどくないわよ。誰もけがしてないし" },
    { "t": [83.8, 85.3], "ja": "ものすごくひどい" },
    { "t": [85.3, 87.3], "ja": "私はこの女性を愛していて、ただ見せたいんだ" },
    { "t": [87.3, 89.2], "ja": "ひどいことが起きないように" },
    { "t": [89.2, 91.1], "ja": "彼女の子どもたちの面倒を見られるってことを" },
    { "t": [91.1, 93], "ja": "何？" },
    { "t": [93, 95.1], "ja": "今、ダイアンを愛してるって言った？" },
    { "t": [95.1, 97.1], "ja": "言ってない" },
    { "t": [97.1, 99.7], "ja": "言ったわよ。すごくかわいい" },
    { "t": [99.7, 102], "ja": "頼むから、ハンソン、もっと大きな問題に" },
    { "t": [102, 103.2], "ja": "集中してくれないか？" },
    { "t": [103.2, 105.1], "ja": "（無音）" },
    { "t": [105.1, 107.4], "ja": "ロンはママが大好き" },
    { "t": [107.4, 109.8], "ja": "ロンはママが大好き" },
    { "t": [109.8, 112.4], "ja": "お嬢さんたち、何を聞いたと思ってるのか分からないが" },
    { "t": [112.4, 115.4], "ja": "間違って聞いたと思ってることを" },
    { "t": [115.4, 116.3], "ja": "お母さんには言わないでくれ" },
    { "t": [116.3, 118.4], "ja": "ロンはママが大好き" },
    { "t": [118.4, 120.4], "ja": "ロンはママが大好き" },
    { "t": [120.4, 122.8], "ja": "私は何も愛していない！" },
    { "t": [122.8, 125], "ja": "まず、みんな大丈夫" },
    { "t": [125, 128], "ja": "誰もけがしてない。でも、ちょっとした出来事があって" },
    { "t": [128, 130.4], "ja": "なんてこと。何があったの？" },
    { "t": [132.4, 134.6], "ja": "ダイアン、全部私のせいなの" },
    { "t": [134.6, 136.8], "ja": "私の看護師のバッグを、あの子たちに触らせちゃって" },
    { "t": [136.8, 137.9], "ja": "あら！" },
    { "t": [137.9, 139.9], "ja": "（無音）" },
    { "t": [139.9, 142.2], "ja": "さて、はさみで遊んで楽しんでたのは誰かな？" },
    { "t": [142.2, 143], "ja": "おっと！" },
    { "t": [143, 144.6], "ja": "それに、お医者さんのやり方も教えてくれたの！" },
    { "t": [144.6, 145.5], "ja": "わーい！" },
    { "t": [145.5, 146.6], "ja": "怒ってないのか" },
    { "t": [146.6, 148.3], "ja": "ああ、大丈夫よ。子どもだもの" },
    { "t": [148.3, 150.6], "ja": "前にゾーイがアイビーを乾燥機の上にのせたこともあったしね" },
    { "t": [150.6, 152.1], "ja": "それでも、本当に申し訳ない" },
    { "t": [152.1, 153.6], "ja": "君の期待を裏切ってしまった気がする" },
    { "t": [153.6, 157.2], "ja": "あなたがそんなに気にかけてくれるのが、すごくうれしい" },
    { "t": [157.2, 159.4], "ja": "だから、あなたが大好きなの" },
    { "t": [159.4, 160.6], "ja": "ああ" },
    { "t": [160.6, 163.8], "ja": "そうか、私も君を愛してる" },
    { "t": [163.8, 165.2], "ja": "（無音）" },
    { "t": [165.2, 166.5], "ja": "私はそろそろ失礼するわね" },
    { "t": [166.5, 168.1], "ja": "じゃあね、お嬢さんたち、楽しかったわ" },
    { "t": [168.1, 170.1], "ja": "バイバイ、アン！" },
    { "t": [178.3, 180.3], "ja": "（無音）" }
  ]
}
