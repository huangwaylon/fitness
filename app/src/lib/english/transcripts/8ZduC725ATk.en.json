{"video":"8ZduC725ATk","lines":[{"t":[0,3.7],"en":"Okay, this is it."},{"t":[4.7,5.9],"en":"Are you sure you want to do this?"},{"t":[10.3,12.3],"en":"Hello, Mrs. Ross."},{"t":[13,14.9],"en":"Hello, Mr. Rachel."},{"t":[14.9,15.4],"en":"Whoa."},{"t":[23.3,23.8],"en":"Whoa."},{"t":[24.1,25.4],"en":"Oh, my God."},{"t":[27,28.2],"en":"Come on, please. Hurry."},{"t":[28.6,29.5],"en":"Hurry, hurry, hurry, hurry."},{"t":[29.7,30],"en":"Okay."},{"t":[32.9,34.2],"en":"Oh, my God."},{"t":[34.4,35.7],"en":"Is everybody getting married?"},{"t":[38.8,40.5],"en":"No running in the chapel."},{"t":[40.7,42.7],"en":"Hey, don't you give me any of your..."},{"t":[42.7,43.5],"en":"Hey!"},{"t":[43.7,44.1],"en":"Hey."},{"t":[45.6,46.7],"en":"What are you guys doing here?"},{"t":[47.1,48.6],"en":"Ross and Rachel left us a message"},{"t":[48.6,49.7],"en":"saying they were getting married."},{"t":[50.5,51.5],"en":"Isn't that why you guys are here?"},{"t":[51.6,52.1],"en":"Yes, we do."},{"t":[52.2,53.6],"en":"Why else will we be here?"},{"t":[57.6,58.8],"en":"Well, what happened?"},{"t":[58.8,59.4],"en":"Did we miss it?"},{"t":[59.4,61.2],"en":"We actually missed it."},{"t":[61.2,62.2],"en":"Well, maybe you wouldn't have"},{"t":[62.2,63.4],"en":"if you could run in the chapel!"},{"t":[65.4,66.5],"en":"This is insane."},{"t":[66.9,67.8],"en":"That's the big deal."},{"t":[67.9,69.4],"en":"You know, it's not like it's a real marriage."},{"t":[70.7,71.1],"en":"What?"},{"t":[72.7,74.2],"en":"Yeah, if you get married in Vegas,"},{"t":[74.4,75.6],"en":"you're only married in Vegas."},{"t":[78.2,79.1],"en":"What are you talking about?"},{"t":[79.2,80.2],"en":"If you get married in Vegas,"},{"t":[80.2,81],"en":"you're married everywhere."},{"t":[81.3,81.6],"en":"Really?"},{"t":[83.1,83.4],"en":"Yeah."},{"t":[84.9,85.9],"en":"Oh, my God."},{"t":[87.9,88.5],"en":"Ah, well."},{"t":[88.5,88.6],"en":"Ah, well."},{"t":[88.6,89.4],"en":"- No."}]}
