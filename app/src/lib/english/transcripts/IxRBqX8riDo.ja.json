{
  "video": "IxRBqX8riDo",
  "lines": [
    { "t": [0.6, 2.9], "ja": "うわ、新しいオフィス見てよ" },
    { "t": [2.9, 4.1], "ja": "ここすごいね" },
    { "t": [4.1, 5.1], "ja": "来てくれてありがとう、みんな" },
    { "t": [5.1, 7.8], "ja": "仕事が山積みで、手伝ってほしいんだ" },
    { "t": [7.8, 8.6], "ja": "パス" },
    { "t": [8.6, 11], "ja": "わざわざここまで来て、手伝いを断るの？" },
    { "t": [11, 12.7], "ja": "うん、断ったときのあなたの顔が" },
    { "t": [12.7, 14.1], "ja": "見たかったの" },
    { "t": [14.1, 15.4], "ja": "来たかいがあった" },
    { "t": [16.4, 18], "ja": "アンディ、大丈夫？" },
    { "t": [18, 20.4], "ja": "大丈夫だよ。ただ人生に意味はないし" },
    { "t": [20.4, 22.4], "ja": "何も大事じゃないし、いつも疲れてるだけ" },
    { "t": [22.4, 24.8], "ja": "それに眠れないし、食べすぎてる" },
    { "t": [24.8, 27], "ja": "昔の趣味にも全然興味がわかない" },
    { "t": [27, 29.5], "ja": "アンディは警察学校の試験に落ちてから" },
    { "t": [29.5, 32.2], "ja": "自信がどん底なの" },
    { "t": [32.2, 33.8], "ja": "いつも悲しそうで汗だくなの" },
    { "t": [34.9, 37.4], "ja": "ふだんは楽しそうで汗だくなのに" },
    { "t": [37.4, 39.6], "ja": "明日までに最初の寄付先を選ばなきゃいけないんだけど" },
    { "t": [39.6, 41.9], "ja": "申し込みが山ほどあるんだ" },
    { "t": [41.9, 43.8], "ja": "整理するのを手伝ってくれない？" },
    { "t": [43.8, 46.4], "ja": "ねえ、これ楽しそうだよ、ベイビー" },
    { "t": [46.4, 49.5], "ja": "ほら、手伝ってあげよう。楽しいよ" },
    { "t": [49.5, 51.5], "ja": "まあ、君たちで何とかなりそうだね" },
    { "t": [51.5, 53.3], "ja": "僕は帰るよ。実は自分の慈善活動があってさ" },
    { "t": [53.3, 55.9], "ja": "「トミーのおなか基金」っていうんだ" },
    { "t": [55.9, 57.4], "ja": "ここ、豪華なランチが出るんだよ" },
    { "t": [57.4, 59], "ja": "残るなら食べていいよ" },
    { "t": [59, 60.1], "ja": "え？" },
    { "t": [60.1, 61.7], "ja": "カニとキャビア？" },
    { "t": [61.7, 64.2], "ja": "「トミーのおなか基金」を代表して" },
    { "t": [64.2, 66], "ja": "この寛大な寄付を喜んでお受けします" },
    { "t": [67.2, 68], "ja": "ベン？" },
    { "t": [69.2, 70.6], "ja": "ベン？" },
    { "t": [70.6, 71.5], "ja": "うん、アンディ" },
    { "t": [71.5, 73], "ja": "けっこうかっこいいものを" },
    { "t": [73, 74.1], "ja": "見つけたかも" },
    { "t": [74.1, 76.4], "ja": "わかった、とりあえず置いておいて、あとで読むよ" },
    { "t": [76.4, 77.7], "ja": "だめ、アンディが見つけたんだから" },
    { "t": [77.7, 79.5], "ja": "今すぐ説明してもらうから" },
    { "t": [79.5, 80.7], "ja": "さあ、話して、ベイビー" },
    { "t": [80.7, 83], "ja": "レッドウッド音楽プログラムっていうんだ" },
    { "t": [83, 86.9], "ja": "非行が心配な子ども向けの、放課後の音楽教室だよ" },
    { "t": [86.9, 88.5], "ja": "子どもたちを路上（悪い道）から遠ざけられる" },
    { "t": [88.5, 89.7], "ja": "わあ" },
    { "t": [89.7, 91.6], "ja": "ご存じの通り、路上は危険です" },
    { "t": [91.6, 93.8], "ja": "たとえば、僕は一度、下水の格子ぶたに落ちました" },
    { "t": [93.8, 95], "ja": "一日中そこにいました" },
    { "t": [95, 98.4], "ja": "結論として、子どもたちを下水で暮らさせるわけにはいきません" },
    { "t": [98.4, 99.3], "ja": "これ以上は" },
    { "t": [99.3, 100.9], "ja": "レッドウッド音楽プログラム、いけ" },
    { "t": [100.9, 102.4], "ja": "裁判長、アーメン" },
    { "t": [102.4, 104.1], "ja": "それはいい考えだね" },
    { "t": [104.1, 106.2], "ja": "ほかに何かいいのあった？" },
    { "t": [106.2, 107.1], "ja": "トム？" },
    { "t": [109.1, 110.1], "ja": "えっと、うん" },
    { "t": [110.1, 111.3], "ja": "いいのがあるよ" },
    { "t": [111.3, 115], "ja": "「クリーン・シーツ財団」っていうんだ" },
    { "t": [115, 116.9], "ja": "それが僕のおすすめ" },
    { "t": [116.9, 122.4], "ja": "彼らはクー・クラックス・クランに法律支援をしてる" },
    { "t": [122.4, 123.9], "ja": "これが君のおすすめ？" },
    { "t": [123.9, 125.7], "ja": "うん、ボンボン取ってくれる？" },
    { "t": [127.2, 129.6], "ja": "トム、それ今かけなきゃだめ？" },
    { "t": [129.6, 130.5], "ja": "いやいや、ベン" },
    { "t": [130.5, 132.4], "ja": "スムージーが勝手にできるとでも？" },
    { "t": [137.3, 138.1], "ja": "よし" },
    { "t": [140.7, 142.9], "ja": "これで決まりだと思う" },
    { "t": [142.9, 145], "ja": "「ルーラル・アンビュケア」っていう団体だ" },
    { "t": [145, 146.8], "ja": "救急車を買いたいんだって" },
    { "t": [146.8, 148.7], "ja": "病院から遠くに住んでいる人のためにね" },
    { "t": [148.7, 149.9], "ja": "救急車なんてくだらない" },
    { "t": [149.9, 151.3], "ja": "救急車が誰かの役に立ったことなんてある？" },
    { "t": [151.3, 153], "ja": "アンディの音楽のやつはどうなの？" },
    { "t": [153, 154], "ja": "いや、これはすばらしい活動だよ" },
    { "t": [154, 155.9], "ja": "困っている人をたくさん助けられる" },
    { "t": [155.9, 156.9], "ja": "ごめんね、アンディ" },
    { "t": [156.9, 159], "ja": "なんで？いや、全然大丈夫だよ" },
    { "t": [159, 160], "ja": "その人たちにとってよかったよ" },
    { "t": [160, 160.9], "ja": "最高だよ" },
    { "t": [160.9, 161.8], "ja": "ねえ、俺どうすると思う？" },
    { "t": [161.8, 164], "ja": "車に行ってくるよ" },
    { "t": [164, 165.5], "ja": "ここ暑いし、ちょっと汗かいてきた" },
    { "t": [165.5, 167.5], "ja": "まあ、すごくがっかりだけど" },
    { "t": [167.5, 171.8], "ja": "きっと医者だか、キリンだか、何だか知らないけど" },
    { "t": [171.8, 173.4], "ja": "あなたが助けることにした相手は大喜びでしょうね" },
    { "t": [173.4, 176.6], "ja": "あなたが何だかを決めたその何だかに" },
    { "t": [176.6, 177.5], "ja": "じゃあね" },
    { "t": [177.5, 180.3], "ja": "みんな、よくやった" },
    { "t": [180.3, 181.2], "ja": "何？" },
    { "t": [181.2, 182.9], "ja": "アンディは警察の試験に落ちてから" },
    { "t": [182.9, 184.5], "ja": "ずっと落ち込んでるの" },
    { "t": [184.5, 185.6], "ja": "くだらない寄付先選びが" },
    { "t": [185.6, 187.5], "ja": "ここ何週間かで一番わくわくしてたことなのに" },
    { "t": [187.5, 188.7], "ja": "あなたって本当に自分勝手" },
    { "t": [188.7, 189.4], "ja": "自分勝手？" },
    { "t": [189.4, 190.8], "ja": "慈善団体を運営してるんだけど" },
    { "t": [190.8, 193.5], "ja": "ほら、いつも自分のことばっかりでしょ" },
    { "t": [193.5, 194.4], "ja": "いかにもベンらしい" },
    { "t": [194.4, 196.2], "ja": "ごめん" },
    { "t": [196.2, 198.1], "ja": "カキを忘れた" },
    { "t": [198.1, 200.5], "ja": "今日はよくやったね" },
    { "t": [200.5, 220.6], "ja": "（音楽）" }
  ]
}
