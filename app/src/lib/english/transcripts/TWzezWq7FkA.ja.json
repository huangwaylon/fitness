    { "t": [191, 193], "ja": "名前は書かなくていいから" },
    { "t": [193, 194], "ja": "それに、誰も見るなよ" },
    { "t": [194, 196], "ja": "みんな、目をそらして" },
    { "t": [196, 197], "ja": "目をそらせ" },
    { "t": [197, 200], "ja": "まあ、本当はボードに書きたくなかったんだけど" },
    { "t": [200, 203], "ja": "どうせいつかばれると思って" },
    { "t": [203, 205], "ja": "だから、まあ、仕方ないよね" },
    { "t": [211, 212], "ja": "よし" },
    { "t": [212, 220], "ja": "気づいてる人もいるかもしれないけど、私、はっきりしない関係みたいなのになってて" },
    { "t": [220, 221], "ja": "よし、何て書いてほしい？" },
    { "t": [221, 222], "ja": "ケリーって書いて" },
    { "t": [222, 223], "ja": "あら" },
    { "t": [223, 224], "ja": "まだ続いてたの？" },
    { "t": [224, 226], "ja": "その小さい鼻、引っかいてもぎ取ってやる" },
    { "t": [226, 227], "ja": "リストに書いてあるぞ" },
    { "t": [227, 228], "ja": "クリード？" },
