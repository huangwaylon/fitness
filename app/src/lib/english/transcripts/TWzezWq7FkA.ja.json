{
  "video": "TWzezWq7FkA",
  "lines": [
    { "t": [0, 2], "ja": "人権研修で一番大事なのは" },
    { "t": [2, 5], "ja": "人のことをからかってはいけないということだ" },
    { "t": [5, 7], "ja": "何かや、その人がしてしまった行動のうち" },
    { "t": [7, 9], "ja": "本人が後悔していることについてはな" },
    { "t": [9, 13], "ja": "からかっていいのは、本人が自分で決められることだけだ" },
    { "t": [13, 15], "ja": "たとえば、オスカーはゲイだ" },
    { "t": [15, 17], "ja": "それは彼の選択だ" },
    { "t": [17, 18], "ja": "だから、それはからかっていい" },
    { "t": [18, 21], "ja": "私は自分で選んで鯉の池に落ちたわけじゃない" },
    { "t": [21, 24], "ja": "たぶん、人種や性別や" },
    { "t": [24, 26], "ja": "性的指向や宗教でからかうのも、やっぱりだめですよ" },
    { "t": [26, 29], "ja": "誰がこのレモン頭を部屋に入れたんだ？" },
    { "t": [29, 32], "ja": "お前は生きてる価値がない。もうあきらめろ" },
    { "t": [33, 36], "ja": "…と言いたいところだが、言わない" },
    { "t": [36, 39], "ja": "だって、そのために今これをやってるんだからな" },
    { "t": [39, 42], "ja": "さて、トビー、本物の人権研修へようこそ" },
    { "t": [42, 43], "ja": "手を挙げてくれ" },
    { "t": [43, 46], "ja": "この中で、鯉の池に落とされたことがある人は？" },
    { "t": [46, 50], "ja": "この中で、行きすぎた冗談の的にされたことがある人は？" },
    { "t": [50, 51], "ja": "フィリス" },
    { "t": [51, 53], "ja": "マイケル、あなたは毎日私たちをからかってるじゃない" },
    { "t": [53, 54], "ja": "えっと…" },
    { "t": [54, 55], "ja": "うん、毎日毎日" },
    { "t": [55, 57], "ja": "君たちは何も言わなかったじゃないか" },
    { "t": [57, 58], "ja": "数えきれないくらい言ったよ" },
    { "t": [58, 62], "ja": "まあ、君たちの「やめて」は区別しにくいんだよ" },
    { "t": [62, 64], "ja": "本当にやめてほしい「やめて」なのか" },
    { "t": [64, 66], "ja": "それとも「やめて！" },
    { "t": [66, 68], "ja": "笑いが止まらない" },
    { "t": [68, 70], "ja": "あなたのやってること、面白すぎる" },
    { "t": [70, 71], "ja": "絶好調ね" },
    { "t": [71, 72], "ja": "お腹がよじれる" },
    { "t": [72, 73], "ja": "やめて！」の「やめて」なのか" },
    { "t": [73, 75], "ja": "そんなことは一度もない" },
    { "t": [75, 85], "ja": "「からかい禁止リスト」を作ろう、いいな？" },
    { "t": [85, 89], "ja": "触れちゃいけないと思うことは、何でもこのリストに書く" },
    { "t": [89, 93], "ja": "このリストに書いたことは、からかわれない" },
    { "t": [93, 94], "ja": "分かったか？" },
    { "t": [94, 95], "ja": "私から始めよう" },
    { "t": [95, 101], "ja": "さて、何をリストに書こうかな？" },
    { "t": [101, 102], "ja": "よし" },
    { "t": [102, 107], "ja": "私はスチームタウン・モールの噴水にも落ちたことがある" },
    { "t": [107, 110], "ja": "二つ目の噴水にも落ちたの？" },
    { "t": [110, 112], "ja": "もう会議から追い出してもらえますか？" },
    { "t": [112, 113], "ja": "行け" },
    { "t": [113, 114], "ja": "行け" },
    { "t": [114, 120], "ja": "今日から、からかいはもう許さない" },
    { "t": [120, 123], "ja": "からかいは一切なしってこと？" },
    { "t": [123, 124], "ja": "いや、いや、いや、いや" },
    { "t": [124, 125], "ja": "リストに書いてあることだけだ" },
    { "t": [125, 126], "ja": "そこがいいところなんだ" },
    { "t": [126, 127], "ja": "よし" },
    { "t": [127, 128], "ja": "ほかには？" },
    { "t": [128, 129], "ja": "ほかには？" },
    { "t": [129, 130], "ja": "ドワイト、ほら" },
    { "t": [130, 131], "ja": "鼻のことをからかわれたくありません" },
    { "t": [131, 132], "ja": "鼻？" },
    { "t": [132, 134], "ja": "小さすぎるんです" },
    { "t": [134, 139], "ja": "私の顔の幾何学的なバランスは、一つを除いて全て完璧です" },
    { "t": [139, 141], "ja": "鼻が小さすぎるんです" },
    { "t": [141, 142], "ja": "まあ、ちゃんと機能はしますよ" },
    { "t": [142, 143], "ja": "においも分かります" },
    { "t": [143, 146], "ja": "ただ、ほとんどの人よりかなり近づかないといけないだけです" },
    { "t": [146, 147], "ja": "うわあ" },
    { "t": [147, 148], "ja": "それは小さいな" },
    { "t": [148, 150], "ja": "とにかく書いてください" },
    { "t": [150, 151], "ja": "ちゃんと息できる？" },
    { "t": [151, 153], "ja": "眼鏡はどうやって止まってるの？" },
    { "t": [153, 155], "ja": "おい、リストに書いてあるぞ、みんな" },
    { "t": [155, 157], "ja": "いえ、まだ書き終わってません" },
    { "t": [157, 158], "ja": "くしゃみで飛ばしちゃった？" },
    { "t": [158, 159], "ja": "そこまで" },
    { "t": [159, 160], "ja": "もうやめろ" },
    { "t": [160, 161], "ja": "よし" },
    { "t": [161, 162], "ja": "ほかには？" },
    { "t": [162, 163], "ja": "ほかには？" },
    { "t": [163, 164], "ja": "みんなに順番があるぞ" },
    { "t": [164, 166], "ja": "体重のことをからかわれたくない" },
    { "t": [166, 168], "ja": "うーん、それは範囲が広すぎる" },
    { "t": [168, 169], "ja": "何か別のものにしないと" },
    { "t": [169, 170], "ja": "お腹はどう？" },
    { "t": [170, 171], "ja": "おいしそう？" },
    { "t": [173, 174], "ja": "ほかには？" },
    { "t": [174, 176], "ja": "私、小柄な体型をすごく気にしてるの" },
    { "t": [176, 178], "ja": "うわ" },
    { "t": [178, 179], "ja": "本当だって" },
    { "t": [179, 182], "ja": "フットボールみたいに投げ飛ばされるのが怖いの" },
    { "t": [182, 184], "ja": "まあ、ほら、ニコール・リッチーなら君を太ってると思うかもね" },
    { "t": [184, 186], "ja": "それで少しは気が楽になった？" },
    { "t": [186, 187], "ja": "メレディス？" },
    { "t": [187, 188], "ja": "声に出して言いたくない" },
    { "t": [188, 189], "ja": "よし、分かった" },
    { "t": [189, 190], "ja": "ここに来て" },
