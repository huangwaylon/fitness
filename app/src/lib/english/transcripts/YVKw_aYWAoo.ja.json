{
  "video": "YVKw_aYWAoo",
  "lines": [
    { "t": [0,  1.8], "ja": "すごくワクワクする" },
    { "t": [1.8,  3.4], "ja": "いらっしゃいませ" },
    { "t": [3.4,  4.5], "ja": "式はいつですか？" },
    { "t": [4.5,  6.9], "ja": "きっと、その、つまり…" },
    { "t": [6.9,  10.9], "ja": "いえ、違うんです、これはできちゃった結婚じゃないんです" },
    { "t": [10.9,  13.1], "ja": "確かに、彼女は妊娠してますけど" },
    { "t": [13.1,  15.3], "ja": "それに確かに、今日結婚を決めたばかりですけど" },
    { "t": [15.3,  18.8], "ja": "家族にもまだ言ってないし、会場も決めてないけど" },
    { "t": [18.8,  20.8], "ja": "できちゃった結婚じゃないんです" },
    { "t": [20.8,  22.6], "ja": "私たちは何か月も前から準備してるの" },
    { "t": [22.6,  24.2], "ja": "やることがどれだけあるか、信じられないくらい" },
    { "t": [24.2,  27.5], "ja": "招待状、テーブルセッティング、配色、ダンスのレッスン" },
    { "t": [27.5,  28.8], "ja": "しかも、それは前夜祭の食事会だけの話" },
    { "t": [28.8,  31.9], "ja": "本当に、前夜祭の食事会だけでそれだよ" },
    { "t": [31.9,  33.9], "ja": "大がかりですね" },
    { "t": [33.9,  37.4], "ja": "私たちがしたのは、車のナビに「宝石店」って入れただけ" },
    { "t": [37.4,  39.4], "ja": "あのロマンチックな瞬間、覚えてる、クリス？" },
    { "t": [39.4,  41.3], "ja": "ガソリンを入れてたからね" },
    { "t": [41.3,  43.3], "ja": "いや、覚えてない" },
    { "t": [43.3,  44.8], "ja": "そうよね" },
    { "t": [44.8,  46.7], "ja": "おめでとうございます。これは見事な品ですよ" },
    { "t": [46.7,  48.2], "ja": "よろしければ、指輪の内側に" },
    { "t": [48.2,  49.6], "ja": "日付を彫りましょうか" },
    { "t": [49.6,  50.7], "ja": "それは難しいかも" },
    { "t": [50.7,  53.2], "ja": "実はまだ話し合ってなくて" },
    { "t": [53.2,  57.8], "ja": "2014か「未定」って彫ってもらえば" },
    { "t": [57.8,  60.9], "ja": "待って、二人ともこういうことを一度も考えたことがないなら" },
    { "t": [60.9,  62.9], "ja": "何か理由があるのかも" },
    { "t": [62.9,  65.3], "ja": "考えてみると、私たちってもう" },
    { "t": [65.3,  66.4], "ja": "たいていの夫婦より夫婦らしいよね" },
    { "t": [66.4,  68.4], "ja": "でしょ？ だって、二人の子どもが生まれるんだし" },
    { "t": [68.4,  70], "ja": "新しい町に引っ越すし" },
    { "t": [70,  71.5], "ja": "ドアを開けたまま、おしっこさせてくれたよね" },
    { "t": [71.5,  73.1], "ja": "「グレイズ・アナトミー」の最後が見られるように" },
    { "t": [73.1,  75.3], "ja": "あれは最高のシーズン最終回だった" },
    { "t": [75.3,  77.3], "ja": "それにあの番組は文字どおり" },
    { "t": [77.3,  79.4], "ja": "感情のジェットコースターが永遠に続くんだ" },
    { "t": [79.4,  81.4], "ja": "つまり、なんで何千ドルもかけて" },
    { "t": [81.4,  83.4], "ja": "もう分かってることを確かめなきゃいけないの？" },
    { "t": [83.4,  84.9], "ja": "私たちが愛し合ってるってことを" },
    { "t": [84.9,  87.4], "ja": "それって、すごくすてき" },
    { "t": [87.4,  91.2], "ja": "セオドア、あの指輪を返品して" },
    { "t": [91.2,  92.7], "ja": "返金してもらいたいの" },
    { "t": [92.7,  94.4], "ja": "僕らも話し合ったほうがいいかも" },
    { "t": [94.4,  95.4], "ja": "ちょっと、やめてよ" },
    { "t": [95.4,  96.9], "ja": "この指輪を買わなかったら、そのお金で" },
    { "t": [96.9,  98.8], "ja": "つまり、家を買う足しにできるんじゃないかな" },
    { "t": [98.8,  101.8], "ja": "すてきなお店ですね" },
    { "t": [101.8,  104.8], "ja": "一方で、結婚にはいくつか利点もある" },
    { "t": [104.8,  108.8], "ja": "税金とか、医療保険とか、それにホテルの従業員に" },
    { "t": [108.8,  110.5], "ja": "「パーキンスさん」って呼ばれても、変な気分にならずに済む" },
    { "t": [110.5,  112.8], "ja": "うん、それは私も変な気分になる" },
    { "t": [112.8,  115.1], "ja": "やっぱりしたほうがいいのかも。もう分からない" },
    { "t": [115.1,  117.7], "ja": "やっぱりしたほうがいいのかも。もう分からない" },
    { "t": [117.7,  119.6], "ja": "それに、それはすてきな気持ちね" },
    { "t": [119.6,  120.8], "ja": "はい、手続き完了です" },
    { "t": [120.8,  122.3], "ja": "クレジットカードは全額返金されました" },
    { "t": [122.3,  123.5], "ja": "ちょうどいいタイミングね" },
    { "t": [123.5,  125.4], "ja": "やっぱり、この指輪を買います" },
    { "t": [125.4,  127], "ja": "カードで" },
    { "t": [130.4,  133.9], "ja": "アン・パーキンス、結婚してくれる？" },
    { "t": [133.9,  135.3], "ja": "分からない" },
    { "t": [135.3,  136.7], "ja": "僕もだ" },
    { "t": [136.7,  137.6], "ja": "やめておこうか" },
    { "t": [137.6,  139.6], "ja": "うん、やめておこう" },
    { "t": [139.6,  141.8], "ja": "はい、また指輪はあなたのものです" },
    { "t": [141.8,  142.9], "ja": "もしもし？" },
    { "t": [142.9,  145.2], "ja": "実は、指輪はいらないんです" },
    { "t": [145.2,  147.3], "ja": "信じられない" },
    { "t": [147.3,  148.3], "ja": "ごめんな、坊や" },
    { "t": [148.3,  150], "ja": "パパは家に帰って寝かしつけてあげられないんだ" },
    { "t": [150,  151.3], "ja": "あら、息子さんはおいくつ？" },
    { "t": [151.3,  152.7], "ja": "とにかく何か選んでください" },
    { "t": [152.7,  154.3], "ja": "ハニー、これ見て" },
    { "t": [154.3,  155.7], "ja": "これが欲しいの" },
    { "t": [155.7,  157.3], "ja": "指輪はいらない。結婚式もいらない" },
    { "t": [157.3,  158.9], "ja": "このロケットが欲しいだけ" },
    { "t": [158.9,  160.7], "ja": "私たちの子どもの写真を入れたね" },
    { "t": [160.7,  162.7], "ja": "つまり、僕らは一度も型どおりじゃなかったよね" },
    { "t": [162.7,  165.1], "ja": "出会った最初の夜にキスしちゃったし" },
    { "t": [165.1,  167.1], "ja": "それに付き合ったときも、結局別れたし" },
    { "t": [167.1,  168.2], "ja": "でも、あなたは気づいてなくて" },
    { "t": [168.2,  169.4], "ja": "それで、すごく恥ずかしい思いをしたよね" },
    { "t": [169.4,  171.4], "ja": "うん、その話は今はやめておこうか" },
    { "t": [171.4,  173.1], "ja": "それから友だちのまま妊娠して" },
    { "t": [173.1,  174.8], "ja": "それから恋に落ちた" },
    { "t": [174.8,  176.2], "ja": "私たち、型どおりだったことなんてない" },
    { "t": [176.2,  178.6], "ja": "なのに、なんで今さら？" },
    { "t": [178.6,  181.4], "ja": "セオドア、指輪は必要ないわ" },
    { "t": [181.4,  183.9], "ja": "でも、このロケットを買いたいの" },
    { "t": [183.9,  184.9], "ja": "おいくら？" },
    { "t": [184.9,  186.5], "ja": "いいから持っていって、出ていってください" },
    { "t": [186.5,  189], "ja": "ありがとう。どうも" }
  ]
}
