{
  "video": "O4LLO6fjKoU",
  "lines": [
    { "t": [0,1.3], "ja": "－わあ、ハッピー・ハロウィーン" },
    { "t": [1.3,4], "ja": "－イモムシね！　ありがとう！" },
    { "t": [4,6.3], "ja": "－やあ、みんな、入って" },
    { "t": [6.3,8.4], "ja": "恐怖の館へようこそ" },
    { "t": [8.4,9.7], "ja": "－怖いものはどこ？" },
    { "t": [9.7,11.6], "ja": "－怖いものは目に見えないのよ、リア" },
    { "t": [11.6,13.7], "ja": "砕けた夢、失望" },
    { "t": [13.7,15], "ja": "いちばん大きな目標を達成して" },
    { "t": [15,16.6], "ja": "それが全部崩れ去って" },
    { "t": [16.6,18.8], "ja": "もうこれ以上は上れないと知ること" },
    { "t": [18.8,20.3], "ja": "－お菓子もらえる？" },
    { "t": [20.3,22.8], "ja": "－お菓子より甘いものをあげるわ、ライアン" },
    { "t": [22.8,24], "ja": "真実よ" },
    { "t": [24,27], "ja": "あなたたちの中には、もう人生のピークを過ぎた子もいるかもしれない" },
    { "t": [27,28.7], "ja": "ここからは下り坂よ、おばかさんたち" },
    { "t": [28.7,31.4], "ja": "－はい、みんな、ノープさんにさよならしましょう" },
    { "t": [31.4,33.6], "ja": "－そう、ノープさんよ。ノープ市議会議員じゃないの" },
    { "t": [33.6,35.8], "ja": "だって、私の人生のその章はもう終わったから" },
    { "t": [35.8,39.9], "ja": "覚えておいてね、みんな。輝くものは長くは続かないの" },
    { "t": [39.9,40.9], "ja": "－はい" },
    { "t": [44.9,47.5], "ja": "－怖がらせてるぞ！" },
    { "t": [47.5,48.9], "ja": "－見えてたよ" },
    { "t": [48.9,51.4], "ja": "目の前に鏡が100万枚くらいあるんだから" },
    { "t": [51.4,53.8], "ja": "それに、何をしたってアンディがいなくて寂しいのは変わらないからね" },
    { "t": [53.8,54.8], "ja": "－じゃあ、これはどう？" },
    { "t": [54.8,58], "ja": "僕はバート・マックリン、親切なライフガード" },
    { "t": [58,60.1], "ja": "－バート・マックリンはライフガードじゃない" },
    { "t": [60.1,61.7], "ja": "エフビーアイ捜査官だよ" },
    { "t": [61.7,63.1], "ja": "－本当？" },
    { "t": [63.1,64.2], "ja": "そのほうがもっと信じられないな" },
    { "t": [64.2,65.6], "ja": "－もうやめて、いい？" },
    { "t": [65.6,68.6], "ja": "私を元気づけようとする、そのしょぼい努力は効いてないから" },
    { "t": [68.6,70.1], "ja": "今はアンディがいなくて寂しいし" },
    { "t": [70.1,72.8], "ja": "あなたまでバカにできないのも寂しいんだよ、アンディ" },
    { "t": [72.8,74.2], "ja": "－分かった" },
    { "t": [74.2,75.2], "ja": "ごめん" },
    { "t": [75.2,78.5], "ja": "怖いモンスターとしても、友達としても、君をがっかりさせちゃった" },
    { "t": [78.5,79.3], "ja": "ごめん" },
    { "t": [79.3,80], "ja": "ごめん" },
    { "t": [80,81.4], "ja": "きっとつらいよね" },
    { "t": [81.4,82.6], "ja": "－つらくなんかないわ" },
    { "t": [82.6,85.6], "ja": "実はね、やっと肩の力を抜ける気がするの" },
    { "t": [85.6,87.6], "ja": "ピークを過ぎたって受け入れると、すごく気が楽になるのよ" },
    { "t": [87.6,89], "ja": "－うん、その気持ち分かるよ" },
    { "t": [89,92], "ja": "僕は18歳で市長をやめさせられて、すごくつらかった" },
    { "t": [92,93.4], "ja": "でも、とにかくまたあの坂を上り続けるしかないんだ" },
    { "t": [93.4,94.2], "ja": "－本当にそう？" },
    { "t": [94.2,97], "ja": "人生を立て直すために必死にがんばる代わりに" },
    { "t": [97,98.5], "ja": "こう言ってみたら？　「私はピークを迎えた" },
    { "t": [98.5,99.3], "ja": "すごい" },
    { "t": [99.3,100.4], "ja": "いい人生だった」って" },
    { "t": [100.4,102], "ja": "それで、残りの人生はのんびり過ごすの" },
    { "t": [102,104.1], "ja": "－まあ、たしかに、その一部はすごく魅力的に聞こえるけど" },
    { "t": [104.1,105.1], "ja": "－でしょ" },
    { "t": [105.1,107], "ja": "－でも、いや、ほら、僕にとっては大事だったんだ…" },
    { "t": [107,109], "ja": "市の予算危機対策の仕事に就いて" },
    { "t": [109,111.3], "ja": "今はお菓子の慈善団体で働いてる" },
    { "t": [111.3,115.1], "ja": "でも、いや、ほら、僕にとっては大事だったんだ…" },
    { "t": [115.1,117.6], "ja": "ほら、市の予算危機対策の仕事に就いて" },
    { "t": [117.6,121.6], "ja": "今はお菓子の慈善団体で働いてる" },
    { "t": [121.6,124.1], "ja": "それで、残りの人生はのんびり過ごすの" },
    { "t": [124.1,126.3], "ja": "－まあ、たしかに、その一部はすごく魅力的に聞こえるけど" },
    { "t": [126.3,127], "ja": "－でしょ" },
    { "t": [127,129.7], "ja": "－でも、いや、ほら、僕にとっては大事だったんだ…" },
    { "t": [129.7,132], "ja": "ほら、市の予算危機対策の仕事に就いて" },
    { "t": [132,133.4], "ja": "－ああ、もう" },
    { "t": [133.4,134.8], "ja": "僕のピークは18歳だったのか？" },
    { "t": [134.8,136], "ja": "－そういうこと" },
    { "t": [136,137], "ja": "飲んで" },
    { "t": [140.3,141.6], "ja": "わあ！　ショットだ！" },
    { "t": [141.6,143], "ja": "ねえ、私にも輝いた時期があったの" },
    { "t": [143,143.9], "ja": "自分のやりたいことはやったのよ" },
    { "t": [143.9,145.9], "ja": "市議会議員になりたくて、なって、務めたの" },
    { "t": [145.9,147.4], "ja": "それで「やった！」って感じで" },
    { "t": [147.4,149.2], "ja": "みんなも…" },
    { "t": [149.2,151.3], "ja": "－でも、少なくとも僕たちにはお互いがいる" },
    { "t": [151.3,152.9], "ja": "－本当に愛してる" },
    { "t": [152.9,154.5], "ja": "－僕も愛してる" },
    { "t": [154.5,155.4], "ja": "－これは本物よ" },
    { "t": [155.4,155.9], "ja": "－分かってる" },
    { "t": [155.9,156.6], "ja": "－あなたは私の夫" },
    { "t": [156.6,157.3], "ja": "－君は僕の妻" },
    { "t": [157.3,158.7], "ja": "－みんなの前で私と結婚してくれた" },
    { "t": [158.7,159.8], "ja": "－したよ。その場にいたし" },
    { "t": [159.8,161.3], "ja": "－ピークは過ぎたかもしれないけど、そんなの関係ない" },
    { "t": [161.3,163.3], "ja": "－何か大きなことをしなきゃ" },
    { "t": [163.3,164.9], "ja": "僕たちが永遠に愛し合うって" },
    { "t": [164.9,166.4], "ja": "みんなに本当に分かってもらえるような何かを" },
    { "t": [166.4,168.5], "ja": "－そうね。何がいい？" },
    { "t": [168.5,169.7], "ja": "－思いついた" },
    { "t": [169.7,171.9], "ja": "－こんにちは。私たち、しらふです" },
    { "t": [171.9,173.4], "ja": "－体にタトゥーを入れたいんです" },
    { "t": [173.4,174.4], "ja": "愛し合ってるから" },
    { "t": [174.4,177.2], "ja": "－タトゥー？　ここは質屋だぞ" },
    { "t": [177.2,178.4], "ja": "でも、まあ、いいよ。できるよ" },
    { "t": [178.4,179.4], "ja": "－わあ！" },
    { "t": [179.4,181.6], "ja": "－やった！　これが起きたことよ！" },
    { "t": [181.6,182.7], "ja": "見て、何してるか！" },
    { "t": [182.7,184], "ja": "ペンを折ってる！" },
    { "t": [184,187.4], "ja": "－これは世紀の名案だ" },
    { "t": [187.4,188.2], "ja": "－ここに" },
    { "t": [188.2,189.5], "ja": "－痛っ！" },
    { "t": [189.5,192.9], "ja": "こっち来て" },
    { "t": [192.9,194.4], "ja": "－ひとつ聞いてもいい？" },
    { "t": [194.4,196.4], "ja": "私たちって、今まで見た中でいちばんかわいいカップル？" },
    { "t": [196.4,197.3], "ja": "－いや" },
    { "t": [197.3,199.7], "ja": "で、長い針と短い針、どっちがいい？" },
    { "t": [199.7,201.1], "ja": "どっちでもいいか。短い針が見つからない" },
    { "t": [201.1,202.3], "ja": "長い針に決まりだ" },
    { "t": [202.3,203.4], "ja": "－すごいことを思いついた" },
    { "t": [203.4,207], "ja": "エレノア・ルーズベルトの肖像画を入れたいの" },
    { "t": [207,211.3], "ja": "品よくね。それで、彼女の腕には" },
    { "t": [211.3,214.3], "ja": "パット・ベネターのすごく上品なタトゥーがあって、それがすごくさりげないの" },
    { "t": [214.3,215.4], "ja": "－いや、やっぱりやめ" },
    { "t": [215.4,216.7], "ja": "全部なし。ただ「ベン」って書いて" },
    { "t": [216.7,218.5], "ja": "－痛みを和らげるものはある？" },
    { "t": [218.5,221.9], "ja": "－あるよ。その薬のバケツからひとすくい取りな" },
    { "t": [221.9,224.6], "ja": "－よし、口をきれいにしたいって言ってたよね？" },
    { "t": [224.6,225.8], "ja": "－だめ、やめて。やめなさい" },
    { "t": [225.8,227.7], "ja": "今やってること、全部やめて。やめて" },
    { "t": [227.7,228.7], "ja": "－アンが来た！" },
    { "t": [228.7,230], "ja": "アンもタトゥーを入れたいって！" },
    { "t": [230,231.1], "ja": "－アン！" },
    { "t": [231.1,233.2], "ja": "－アン！" },
    { "t": [233.2,234.6], "ja": "－アンはタトゥーなんて入れたくない" },
    { "t": [234.6,235.8], "ja": "誰もタトゥーなんて入れたくないの" },
    { "t": [235.8,237.6], "ja": "－アン、落ち着いて" },
    { "t": [237.6,239.8], "ja": "ちょっとはちゃんとしてよ、いい？" },
    { "t": [239.8,241.4], "ja": "私たちがやってることは、おかしくないの" },
    { "t": [241.4,243.6], "ja": "ただタトゥーを入れるだけ。みんなに分かってもらうために" },
    { "t": [243.6,245.4], "ja": "私たちが愛し合ってて、まだピークを過ぎてないってね" },
    { "t": [245.4,247.7], "ja": "－すごく筋が通ってる" },
    { "t": [247.7,249.2], "ja": "－はい、帰るわよ、いい？" },
    { "t": [249.2,251], "ja": "親切なおじさんにさよならして" },
    { "t": [251,253.5], "ja": "事件番組に出ずに済んだことを、私に感謝して" },
    { "t": [253.5,254.4], "ja": "はい、行くわよ" },
    { "t": [254.4,256.4], "ja": "－さよなら、世界旅行" },
    { "t": [256.4,257.7], "ja": "－またな、ブロハイゼン" },
    { "t": [257.7,258.8], "ja": "－ベン" },
    { "t": [258.8,260.1], "ja": "－ほら" },
    { "t": [271.4,272.4], "ja": "－さよなら" }
  ]
}
