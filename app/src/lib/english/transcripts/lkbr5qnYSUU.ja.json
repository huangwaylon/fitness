  "lines": [
    { "t": [0,  4], "ja": "よし、よし、妹に乾杯" },
    { "t": [4,  6.3], "ja": "新しく任命された、ランチ担当の料理長に" },
    { "t": [6.3,  8.3], "ja": "仕入れ担当でもあるの" },
    { "t": [8.3,  10], "ja": "新しく任命されたランチ担当の料理長で" },
    { "t": [10,  11.6], "ja": "仕入れ担当でもある" },
    { "t": [11.6,  14.1], "ja": "ローランドがいないときは、自分専用の小さな机もあるの" },
    { "t": [16,  17.7], "ja": "ランチ担当の料理長、仕入れ担当" },
    { "t": [17.7,  19.6], "ja": "ローランドがいないときは自分専用の小さな机" },
    { "t": [19.6,  20.8], "ja": "かわいい妹に乾杯" },
    { "t": [20.8,  22.8], "ja": "あ、待って、それとポケベルももらったの" },
    { "t": [22.8,  24.3], "ja": "へえ、いいね" },
    { "t": [26.3,  27.9], "ja": "いいよ、待ってるから" },
    { "t": [27.9,  29.1], "ja": "あ、ごめん" },
    { "t": [29.1,  30], "ja": "ごめん、ごめん" },
    { "t": [31.5,  32.2], "ja": "モニカ！" },
    { "t": [35.6,  37], "ja": "ご注文はお決まりですか？" },
    { "t": [37,  38.8], "ja": "あ、実は、まだメニューを見てもいないの" },
    { "t": [38.8,  40.6], "ja": "では、お決まりになったら声をかけてください" },
    { "t": [40.6,  43], "ja": "すぐそこで、わくわくしながら待ってますので" },
    { "t": [49,  50.7], "ja": "うわ、この値段見てよ" },
    { "t": [50.7,  53.2], "ja": "うん、かなりお高いね" },
    { "t": [54.5,  57], "ja": "うわ、これ何？ 有名なニワトリとか？" },
    { "t": [57,  58.2], "ja": "聞いてみる勇気ある？" },
    { "t": [58.2,  59.4], "ja": "はい、カルパッチョから始めて" },
    { "t": [59.4,  61.4], "ja": "それから、エビのグリルをお願いします" },
    { "t": [61.4,  63.5], "ja": "いいね、僕も同じので" },
    { "t": [63.5,  64.5], "ja": "で、お客様は？" },
    { "t": [64.5,  66.4], "ja": "ああ、タイ風チキンのピザを。でも、ねえ" },
    { "t": [66.4,  69.2], "ja": "ナッツとネギとかを抜いたら" },
    { "t": [69.2,  71.1], "ja": "安くなる？" },
    { "t": [71.1,  73.5], "ja": "そう思いますよね？" },
    { "t": [73.5,  74.5], "ja": "お客様は？" },
    { "t": [74.5,  76.6], "ja": "はい、付け合わせのサラダにします" },
    { "t": [76.6,  79.4], "ja": "何の付け合わせでしょう？" },
    { "t": [79.4,  80.6], "ja": "分からない" },
    { "t": [80.6,  83.6], "ja": "この水の隣に置いてくれればいいんじゃない？" },
    { "t": [83.6,  84.8], "ja": "で、お客様は？" },
    { "t": [84.8,  96.8], "ja": "えーと、キュウリのスープをカップで。えーと…（メニューに）元気でね" },
    { "t": [96.8,  97.8], "ja": "ケイジャン風のナマズにします" },
    { "t": [97.8,  98.9], "ja": "他に何か？" },
    { "t": [98.9,  100.9], "ja": "ええ、「やさしく歌って」を1曲歌ってくれない？" },
    { "t": [100.9,  102], "ja": "お一人28ドルね" },
    { "t": [102,  103], "ja": "ああ、そうか" },
    { "t": [103,  105], "ja": "え、えーと、全員？" },
    { "t": [105,  106], "ja": "あ、そうね" },
    { "t": [106,  107], "ja": "ごめん" },
    { "t": [107,  108], "ja": "ありがとう" },
    { "t": [108,  109], "ja": "今日はモニカの晴れの日だ" },
    { "t": [109,  110], "ja": "彼女は払わなくていい" },
    { "t": [110,  111.1], "ja": "まあ、ありがとう" },
    { "t": [111.1,  116.1], "ja": "じゃあ、5人で1人33ドル50セントね" },
    { "t": [116.1,  117.1], "ja": "いや、だめ" },
    { "t": [117.1,  118.1], "ja": "絶対いや" },
    { "t": [118.1,  119.1], "ja": "悪いけど、ありえない" },
    { "t": [119.1,  120.1], "ja": "おっと、おっと" },
    { "t": [120.1,  121.1], "ja": "卒業パーティーの悪夢がよみがえる" },
    { "t": [121.1,  122.1], "ja": "ごめんね、モニカ" },
    { "t": [122.1,  123.1], "ja": "ごめんね、モニカ" },
    { "t": [123.1,  126.1], "ja": "昇進は本当にうれしいけど、でも、だめ、絶対いや" },
    { "t": [126.1,  127.2], "ja": "悪いけど、ありえない" },
    { "t": [127.2,  129.1], "ja": "おっと、おっと、卒業パーティーの悪夢がよみがえる" },
    { "t": [129.1,  133.1], "ja": "ごめんね、モニカ、昇進は本当にうれしいけど" },
    { "t": [133.1,  135.2], "ja": "でも、だめ、絶対いや、悪いけど、ありえない" },
    { "t": [135.2,  137.2], "ja": "おっと、おっと、卒業パーティーの悪夢がよみがえる" },
    { "t": [137.2,  139.1], "ja": "ごめんね、モニカ、昇進は本当にうれしいけど" },
    { "t": [139.1,  142.2], "ja": "冷たいキュウリのどろどろに30ドルちょっと？" },
    { "t": [142.2,  144.4], "ja": "はは、ありえない" },
    { "t": [144.4,  147.2], "ja": "レイチェルなんて、あの、あの、小さいサラダだけだし" },
    { "t": [147.2,  150.2], "ja": "ジョーイだって、あの、ちっちゃいピザだけ！" },
    { "t": [150.2,  151.2], "ja": "ほんとに…" },
    { "t": [151.2,  153.3], "ja": "分かった、フィービー、しーっ、しーっ" },
    { "t": [153.3,  156.3], "ja": "じゃあ、それぞれ、それぞれ自分が食べた分を払うことにしよう" },
    { "t": [156.3,  157.1], "ja": "いい？" },
    { "t": [157.1,  158.1], "ja": "大したことじゃないよ" },
    { "t": [158.1,  159.1], "ja": "あなたにはね" },
    { "t": [163.1,  165.1], "ja": "よし、どうしたの？" },
    { "t": [165.1,  168.1], "ja": "ねえ、みんな、今はこの話は" },
    { "t": [168.1,  169.2], "ja": "したくないの" },
    { "t": [169.2,  170.2], "ja": "みんな気まずくなると思うし" },
    { "t": [170.2,  171.2], "ja": "え、何？" },
    { "t": [171.2,  172.2], "ja": "分かった、分かった、いいよ、分かった" },
    { "t": [172.2,  173.2], "ja": "おっと、おっと、おっと、おっと" },
    { "t": [173.2,  174.2], "ja": "話していいんだよ" },
    { "t": [174.2,  176.2], "ja": "そうだよ、ちょっと、僕たちでしょ？" },
    { "t": [176.2,  177.2], "ja": "大丈夫だから" },
    { "t": [177.2,  178.2], "ja": "うん" },
    { "t": [182.2,  187.2], "ja": "分かった、えー、あの、私たち3人はね、えー" },
    { "t": [187.2,  199.4], "ja": "時々、あなたたちには分からないんだって感じるの、その…" },
    { "t": [199.4,  202.4], "ja": "私たちは、あなたたちほどお金がないってこと" },
    { "t": [202.4,  204.5], "ja": "そっか" },
    { "t": [204.5,  205.5], "ja": "分かるよ" },
    { "t": [205.5,  208.5], "ja": "その話、しようよ" },
    { "t": [208.5,  210.5], "ja": "じゃあ、まあ…" },
    { "t": [210.5,  211.5], "ja": "何？" },
    { "t": [211.5,  214.5], "ja": "いや、えー、僕は、お金のことを問題だと" },
    { "t": [214.5,  215.5], "ja": "考えたことがなかったんだ" },
    { "t": [215.5,  216.5], "ja": "それは、あなたが持ってるからよ" },
    { "t": [216.5,  217.5], "ja": "確かにそうだね" },
    { "t": [217.5,  219.6], "ja": "で、えー、どうして今まで話してくれなかったの？" },
    { "t": [219.6,  220.6], "ja": "だって、いつも何かあるでしょ" },
    { "t": [220.6,  222.7], "ja": "モニカの新しい仕事とか、ロスの誕生日の大騒ぎとか" },
    { "t": [222.7,  223.7], "ja": "何？" },
    { "t": [223.7,  224.7], "ja": "おっと、ねえ、僕の誕生日が" },
    { "t": [224.7,  228.7], "ja": "何か悪いことの原因になるのは嫌だ…" },
    { "t": [228.7,  229.7], "ja": "大騒ぎがあるの？" },
    { "t": [229.7,  230.7], "ja": "うん" },
    { "t": [230.7,  231.7], "ja": "要するに、僕の誕生日が" },
    { "t": [231.7,  234.7], "ja": "何か悪いことの原因になるのは嫌だ…" },
    { "t": [234.7,  236.7], "ja": "大騒ぎがあるの？" },
    { "t": [236.7,  237.7], "ja": "うん" },
    { "t": [237.7,  239.7], "ja": "要するに、僕の誕生日が" },
    { "t": [239.7,  241.8], "ja": "何か悪いことの原因になるのは嫌だ…" },
    { "t": [241.8,  243.7], "ja": "大騒ぎがあるの？" },
    { "t": [243.7,  244.7], "ja": "うん" },
    { "t": [244.7,  246.7], "ja": "要するに、僕の誕生日が" },
    { "t": [246.7,  249.7], "ja": "何か悪いことの原因になるのは嫌だ…" },
    { "t": [249.7,  251.9], "ja": "要するに、「あれ」があって" },
    { "t": [251.9,  254.3], "ja": "「あれ」の後のこともあって" },
