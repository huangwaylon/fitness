{
  "video": "5gDVzMcpE1s",
  "lines": [
    { "t": [0,  2.4], "ja": "ねえ、ハニー、女の子の絵のほうを買ってきたのね" },
    { "t": [2.4,  4.3], "ja": "赤ちゃんの絵のほうを買うって言ってたじゃない" },
    { "t": [4.3,  6.2], "ja": "いや、赤ちゃんは気味が悪いって言ったのは君だよ" },
    { "t": [6.2,  7.9], "ja": "違う、女の子が気味悪いって言ったの" },
    { "t": [7.9,  9], "ja": "赤ちゃんって言ったよ" },
    { "t": [9,  10.4], "ja": "なんで赤ちゃんが気味悪いのよ？" },
    { "t": [10.4,  13.2], "ja": "なんで女の子が気味悪いんだよ？" },
    { "t": [13.2,  14.2], "ja": "二人とも、ごめんね" },
    { "t": [14.2,  16.2], "ja": "もう少しゆっくり話してくれる？" },
    { "t": [16.2,  17.4], "ja": "これ、君の本に載るの？" },
    { "t": [17.4,  18.8], "ja": "うん、恋愛についての本なの" },
    { "t": [18.8,  21.5], "ja": "ほら、わな、落とし穴、やっちゃいけないこと" },
    { "t": [21.5,  22], "ja": "続けて" },
    { "t": [22,  23.3], "ja": "これ、すごくいいわ" },
    { "t": [23.3,  24.5], "ja": "何？" },
    { "t": [24.5,  26.2], "ja": "ちょっと" },
    { "t": [26.2,  28.4], "ja": "それに、本当に愛し合っていれば" },
    { "t": [28.4,  29.9], "ja": "そんなことは全部どうでもいいってこともね" },
    { "t": [29.9,  31.8], "ja": "ふむ" },
    { "t": [31.8,  34.1], "ja": "それに、ほめ言葉なら" },
    { "t": [34.1,  35.3], "ja": "人は何でも信じちゃうってこともね" },
    { "t": [41.1,  43.7], "ja": "じゃあ、ジョーイのほうが僕より魅力的だと思う？" },
    { "t": [43.7,  44.4], "ja": "ええ" },
    { "t": [44.4,  46.4], "ja": "だから彼とこっそり寝てるのよ" },
    { "t": [46.4,  47.2], "ja": "へえ、そうだったらいいのにね" },
    { "t": [51.8,  53.8], "ja": "そうだったらいいのにね" },
    { "t": [53.8,  55.2], "ja": "フィービー、僕らのことを書くのはやめて" },
    { "t": [55.2,  56.6], "ja": "あなたたちのことは書いてないわ" },
    { "t": [56.6,  58.4], "ja": "他の人のことを書いてるの" },
    { "t": [59.8,  60.8], "ja": "誰？" },
    { "t": [60.8,  62.2], "ja": "マーシャとチェスター" },
    { "t": [63.8,  64.7], "ja": "いいよ、分かった" },
    { "t": [64.7,  65.2], "ja": "分かった" },
    { "t": [65.2,  65.8], "ja": "じゃあ、いいかい" },
    { "t": [65.8,  68.1], "ja": "僕はフィリスのことを書くよ" },
    { "t": [68.1,  68.6], "ja": "ふーん" },
    { "t": [68.6,  69.2], "ja": "へえ" },
    { "t": [69.2,  71.1], "ja": "フィリスは椅子に座っている" },
    { "t": [71.1,  71.6], "ja": "あら" },
    { "t": [71.6,  72.7], "ja": "何をしてるか分かったわ" },
    { "t": [72.7,  73.5], "ja": "フィリス？" },
    { "t": [73.5,  74.5], "ja": "彼女が、僕のしてることさ" },
    { "t": [74.5,  75.3], "ja": "あら" },
    { "t": [76.7,  80.2], "ja": "ああ、自分がやったことを、やり返されたわ。苦いものね" },
