{
  "video": "FLfZaYRHKGc",
  "lines": [
    { "t": [0, 1.6], "ja": "あ、ねえ、トム、これ見て" },
    { "t": [2.1, 3.6], "ja": "ノートン建設がこれを送ってきたの" },
    { "t": [4.3, 5.3], "ja": "うわあ、すげえ" },
    { "t": [5.9, 7.2], "ja": "グレート・レイクス・ワイン大好き" },
    { "t": [7.3, 8.1], "ja": "ワインはあげるよ" },
    { "t": [8.1, 10.4], "ja": "僕はあのチーズにひどいことをしたいんだ" },
    { "t": [11.1, 13.4], "ja": "だめ、だめ、だめ、だめ、だめ、だめ、だめ" },
    { "t": [14.3, 15.9], "ja": "あなたも私と同じくらいわかってるでしょ" },
    { "t": [16, 18.3], "ja": "私たちは25ドルを超える贈り物は受け取れないの" },
    { "t": [18.3, 20.1], "ja": "汚職を防ぐためにね" },
    { "t": [20.4, 23.2], "ja": "私たちは金魚鉢の中で暮らしてるようなもので、市民はいつも見てるの" },
    { "t": [23.6, 24.8], "ja": "だから私は、二つ先の町まで行くの" },
    { "t": [24.8, 26.6], "ja": "裸が出てくる映画を借りたいときはね" },
    { "t": [26.9, 29], "ja": "うん、今のは言わないほうがよかったね" },
    { "t": [29.8, 31.4], "ja": "でも、このかごを楽しんじゃだめ" },
    { "t": [31.5, 32], "ja": "本当にごめんね" },
    { "t": [32.3, 34.2], "ja": "だから誘惑に負けないように、鍵をかけてしまっておくね" },
    { "t": [35.6, 37.6], "ja": "何、面倒な手続きと苦しい戦いが本当に好きなの？" },
    { "t": [38, 38.8], "ja": "やあ、レスリー" },
    { "t": [39.1, 39.4], "ja": "どうも" },
    { "t": [39.5, 40.1], "ja": "どうしたの？" },
    { "t": [40.5, 41.5], "ja": "どうしたか教えてあげる" },
    { "t": [41.6, 44.2], "ja": "女性が何人か、あなたたちの男だけの集まりをぶち壊しに来たの" },
    { "t": [45.5, 45.9], "ja": "いいね" },
    { "t": [46, 46.6], "ja": "来てくれてうれしいよ" },
    { "t": [47.2, 47.9], "ja": "ビールを持ってくるね" },
    { "t": [49.1, 49.5], "ja": "入れた" },
    { "t": [50, 50.8], "ja": "やあ、ブライアンだ" },
    { "t": [51, 51.5], "ja": "どうも、ブライアン" },
    { "t": [51.6, 53.3], "ja": "レスリー・ノープです、公園課の副…" },
    { "t": [53.3, 53.5], "ja": "（聞き取れない）" },
    { "t": [53.6, 53.8], "ja": "はい" },
    { "t": [54.6, 55.9], "ja": "みんな、アンだよ" },
    { "t": [56, 56.9], "ja": "ここで働いてるわけじゃないの" },
    { "t": [57.7, 58.1], "ja": "アン" },
    { "t": [58.6, 59.5], "ja": "それで、みんな何の話をしてるの？" },
    { "t": [59.5, 60.6], "ja": "話題は何？" },
    { "t": [60.7, 61], "ja": "彼は…" },
    { "t": [61, 61.2], "ja": "あ" },
    { "t": [63.2, 63.4], "ja": "あ" },
    { "t": [64.3, 65.2], "ja": "今の聞こえた？" },
    { "t": [66.4, 69.5], "ja": "ガラスの天井が割れる音よ" },
    { "t": [70.3, 73.3], "ja": "男だけの集まりは、仕事より付き合いのためなんだよ" },
    { "t": [73.8, 74.6], "ja": "ほら、肩の力を抜かなきゃ" },
    { "t": [75.3, 77.2], "ja": "私はもう男だけの集まりの一員みたいな気がする" },
    { "t": [77.3, 80.6], "ja": "だって、あの女たちが私の後片付けをするのを見てよ" },
    { "t": [82.3, 83.4], "ja": "さあ、正式に発表だ、みんな" },
    { "t": [83.9, 84.6], "ja": "ビールが切れた" },
    { "t": [85.1, 86.4], "ja": "ああ、お開きの合図だな" },
    { "t": [87.1, 87.9], "ja": "またね、レスリー" },
    { "t": [88.1, 90.2], "ja": "仕事の後に一緒に過ごせて楽しかったよ" },
    { "t": [90.5, 90.8], "ja": "待って" },
    { "t": [90.9, 92.1], "ja": "僕もそろそろ帰ろうかな" },
    { "t": [92.4, 93.2], "ja": "うん、僕も行かなきゃ、レスリー" },
    { "t": [93.4, 94], "ja": "待って、みんな" },
    { "t": [94.1, 95.2], "ja": "このいい感じを続けようよ" },
    { "t": [95.4, 96.2], "ja": "まだ始まったばかりじゃない" },
    { "t": [96.6, 99.4], "ja": "ああ、そうだね。パーティーって酒が切れてから始まるもんな" },
    { "t": [99.7, 100.1], "ja": "わかった、待って" },
    { "t": [100.6, 102.6], "ja": "ちょっと待ってて" },
    { "t": [117.9, 118.8], "ja": "ワインあるよ" },
    { "t": [119.1, 119.3], "ja": "おお！" },
    { "t": [119.3, 121.1], "ja": "それにチーズも" },
    { "t": [121.4, 121.8], "ja": "おお！" },
    { "t": [121.8, 128.2], "ja": "おはようございます" },
    { "t": [128.2, 135], "ja": "昨夜、男だけの集まりに入りこもうという愚かな試みで、私は" },
    { "t": [135, 136.6], "ja": "インディアナ州の公務員倫理規定に違反しました" },
    { "t": [137.1, 140.7], "ja": "私はいつも倫理的に生きようとしてきましたが、昨夜は失敗しました" },
    { "t": [141.2, 146.5], "ja": "アメリカのすべての女性公務員を失望させたことに気づいたので、今から謝りたいと思います" },
    { "t": [146.5, 149.9], "ja": "一人ずつ、アルファベット順に" },
    { "t": [151.1, 151.9], "ja": "ミシェル・バックマン" },
    { "t": [153.1, 153.7], "ja": "共和党" },
    { "t": [154.5, 154.9], "ja": "ミネソタ州" },
    { "t": [155.9, 156.8], "ja": "ごめんなさい" },
    { "t": [158.4, 159.2], "ja": "タミー・ボールドウィン" },
    { "t": [159.8, 160.2], "ja": "民主党" },
    { "t": [160.7, 161.2], "ja": "ウィスコンシン州" },
    { "t": [161.9, 163.1], "ja": "本当にごめんなさい、タミー" },
    { "t": [164.8, 165.7], "ja": "メリッサ・ビーン" },
    { "t": [167.6, 168.5], "ja": "ほら、これ" },
    { "t": [169.2, 170.2], "ja": "はっきりさせましょう" },
    { "t": [170.5, 174], "ja": "昨夜、私は自分の楽しみのために、この贈り物のかごを開けたの" },
    { "t": [174.6, 174.9], "ja": "本当に？" },
    { "t": [175.5, 176.3], "ja": "レスリー・ノープが" },
    { "t": [176.5, 178.5], "ja": "いつもは規則にうるさいお堅い人なのに" },
    { "t": [178.9, 180.3], "ja": "私だってうれしくないの、ダーリン" },
    { "t": [180.6, 181.8], "ja": "もう君のことがわからないよ" },
    { "t": [182.3, 185.1], "ja": "去年、母親に私用電話をかけたことで、僕を注意したよね" },
    { "t": [185.4, 186.7], "ja": "ええ、したよ。またやる" },
    { "t": [187, 188.3], "ja": "悪いことに悪いことを重ねても、正しくはならないの" },
    { "t": [188.6, 189.8], "ja": "そうだけど、母は入院してたんだよ" },
    { "t": [191.7, 193], "ja": "そのときは知らなかったの" },
    { "t": [193.9, 194.7], "ja": "じゃあ、そのかごもらっていい？" },
    { "t": [195, 195.7], "ja": "だめ、ごめんね" },
    { "t": [195.7, 196.1], "ja": "証拠品だから" },
    { "t": [196.6, 197.5], "ja": "いいかごだね" },
    { "t": [197.8, 198.5], "ja": "何を入れるの？" },
    { "t": [199.7, 200.3], "ja": "わからない" },
    { "t": [200.5, 200.9], "ja": "ポプリかな" },
    { "t": [201, 201.9], "ja": "ポプリをたくさん" },
    { "t": [202.1, 203.5], "ja": "ちょっと、裁かれてるのはこっちじゃないよ" },
    { "t": [203.8, 207.1], "ja": "揺るぎない応援を、前もってどうもありがとう" },
    { "t": [207.2, 208.2], "ja": "刑務所に入ったほうがいいと思う" },
    { "t": [208.4, 209.2], "ja": "自分のしたことをよく考えなよ" },
    { "t": [211, 211.7], "ja": "刑務所？" },
    { "t": [211.8, 212.4], "ja": "どうしたんだ？" },
    { "t": [212.9, 216], "ja": "ロン、すごく大事で、すごく長い話があるの" },
    { "t": [218.6, 219.4], "ja": "メールにしてくれるか？" },
    { "t": [219.7, 219.9], "ja": "いいえ" },
    { "t": [221.4, 222.7], "ja": "あそこで起きたの" },
    { "t": [223.5, 224.7], "ja": "この窓のすぐ外でね" },
    { "t": [225.7, 226.9], "ja": "なぜ目をそらせないんだ？" },
    { "t": [227.4, 229.1], "ja": "大げさに騒ぐのはよそう" },
    { "t": [229.3, 231.5], "ja": "ちょうどいい大きさで騒ぐの" },
    { "t": [232.6, 236.5], "ja": "これの最低限の罰でも、市の管理官からの正式な注意なの" },
    { "t": [236.9, 238.1], "ja": "そこまで大したことじゃない" },
    { "t": [238.2, 240], "ja": "あなたの世界では大したことじゃないかもね" },
    { "t": [240.2, 243.3], "ja": "あなたは豊かで立派な口ひげの白人プロテスタント男性だもの" },
    { "t": [243.9, 247.4], "ja": "でも私は女性だから、自分にもっと高い基準を課さなきゃいけないの" },
    { "t": [247.7, 248.5], "ja": "ばかげている" },
    { "t": [248.7, 252], "ja": "誰が君を罰するより、君自身が君を罰している" },
    { "t": [252.1, 252.3], "ja": "いいえ" },
    { "t": [252.8, 254], "ja": "じゃあ、どうしろって言うの？" },
    { "t": [254.3, 255.3], "ja": "もみ消せって言うの？" },
    { "t": [255.9, 257.2], "ja": "いや、そうは言っていない" },
    { "t": [257.2, 258.4], "ja": "誰ももみ消せとは言っていない" },
    { "t": [258.8, 259.1], "ja": "よかった" },
    { "t": [259.2, 261.2], "ja": "だって、もみ消しは罪そのものより悪いもの" },
    { "t": [261.9, 267.1], "ja": "何かをこぼして、汚いもので拭こうとしたら、二倍汚くなるでしょ" },
    { "t": [267.8, 269.2], "ja": "頼むから、これ以上ひどくしないでくれ" },
    { "t": [269.3, 269.7], "ja": "なんてこと" },
    { "t": [270.4, 271.2], "ja": "こんにちは" },
    { "t": [272.7, 278.4], "ja": "前回お話ししてから、私はさらに罪をつぐなうため、特別な手段をとりました" },
    { "t": [279, 285.4], "ja": "全面的な告白文を書いたので、ポーニー市役所の全員にメールで送ります" },
    { "t": [286.3, 291.8], "ja": "私の課のウェブページへのリンクもつけました。私のいい仕事を思い出してもらうためにね" },
    { "t": [292.7, 295.1], "ja": "ロンに私を告発してと頼んだけど、断られました" },
    { "t": [295.5, 297.6], "ja": "だから自分で自分を告発するしかなかったんです" },
    { "t": [297.6, 308.63], "ja": "（音楽）" },
    { "t": [308.63, 317.7], "ja": "（音楽）" },
    { "t": [317.7, 318.4], "ja": "（音楽）" }
  ]
}
