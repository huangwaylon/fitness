{
  "video": "u2AFI_M-QGg",
  "lines": [
    { "t": [0,5], "ja": "左を見て、右を見て、適当に" },
    { "t": [5,7.3], "ja": "あんたって、自分の薬にはまっちゃうタイプの医者？" },
    { "t": [7.3,8.4], "ja": "きっとそうだよね" },
    { "t": [8.4,9.7], "ja": "じゃあ、アンディ、何があったか話して" },
    { "t": [9.7,12.1], "ja": "百科事典を読んでたら" },
    { "t": [12.1,16.1], "ja": "つまずいたか転んだかして、頭を打ったんだ" },
    { "t": [16.1,19.4], "ja": "先生たちの言う「脳のヘルメット」をね" },
    { "t": [19.4,22.1], "ja": "うん、くしゃみをして壁に頭をぶつけたの" },
    { "t": [22.1,23.7], "ja": "なるほど、ありそうですね" },
    { "t": [23.7,25.8], "ja": "まあ、脳しんとうだとしても、ごく軽いものです" },
    { "t": [25.8,27.4], "ja": "心配はいらないでしょう" },
    { "t": [27.4,29.1], "ja": "ほかに気になるところは？" },
    { "t": [29.1,30.3], "ja": "ないよ" },
    { "t": [30.3,34.7], "ja": "いや、えっと、あるよ。ひざの裏に変な発疹がある" },
    { "t": [34.7,38.4], "ja": "それに、舌のこっち側はもう何の味もしないんだ" },
    { "t": [38.4,42.2], "ja": "歩くとたまに、足首がガラガラヘビみたいな変な音を立てる" },
    { "t": [42.2,43.2], "ja": "ほかには？" },
    { "t": [43.2,46], "ja": "目から遠くにあるものがぼやける" },
    { "t": [46,48.8], "ja": "前にツイックスを包み紙ごと食べたんだけど" },
    { "t": [48.8,50.6], "ja": "包み紙が出てきたのを一度も見てないんだ" },
    { "t": [50.6,52.1], "ja": "それに、ガムは一つ残らず飲み込んできた" },
    { "t": [52.1,54.1], "ja": "この25年間にかんだやつを全部ね" },
    { "t": [54.1,55.5], "ja": "アンディ　分かんないけど" },
    { "t": [55.5,57.1], "ja": "それと、ここに来る途中で親指を折った" },
    { "t": [57.1,59.5], "ja": "とにかく治してよ" },
    { "t": [59.5,61.3], "ja": "まあ、親指なら診られますが" },
    { "t": [61.3,63.8], "ja": "専門医への紹介状を書くことになります" },
    { "t": [63.8,65.7], "ja": "ほかの1000個については" },
    { "t": [65.7,68.2], "ja": "わあ、何もしてくれなくてどうも、ハリス先生" },
    { "t": [68.2,69.8], "ja": "どういたしまして" },
    { "t": [69.8,78.1], "ja": "イー、エイチ、4、エム、ジャガイモの形、マグカップの形、にじみ" },
    { "t": [78.1,81.5], "ja": "にじみ、中指、にじみ、あとは全部にじみ" },
    { "t": [81.5,83.6], "ja": "やだ、ここまで運転してきたの、あんたじゃん" },
    { "t": [83.6,85.7], "ja": "私たち、1億回くらい病院の予約を入れたの" },
    { "t": [85.7,87.5], "ja": "自分たちのために、1週間でね" },
    { "t": [87.5,90.9], "ja": "これが終われば、10年くらい病院に行かなくて済むでしょ" },
    { "t": [90.9,93.6], "ja": "だって私たち、頭がいいから" },
    { "t": [93.6,95.3], "ja": "まあ、眼鏡は絶対に必要ですね" },
    { "t": [95.3,96.5], "ja": "だめ、この人は眼鏡なんてかけない" },
    { "t": [96.5,97.7], "ja": "今の顔が好きなの" },
    { "t": [97.7,99.7], "ja": "眼鏡をかけたら離婚だから" },
    { "t": [99.7,100.7], "ja": "ほら、聞いたでしょ、先生" },
    { "t": [100.7,102.2], "ja": "眼鏡をかけるにはハンサムすぎるんだ" },
    { "t": [102.2,103.5], "ja": "悪く思わないで" },
    { "t": [103.5,105.6], "ja": "はい、食べ物のアレルギーがあれば" },
    { "t": [105.6,106.7], "ja": "数日で分かります" },
    { "t": [106.7,108.1], "ja": "この赤みからすると" },
    { "t": [108.1,110.4], "ja": "僕、針で刺されることにアレルギーがあるのかも" },
    { "t": [110.4,112.7], "ja": "もう5人くらいの医者に診てもらったんだ" },
    { "t": [112.7,114.6], "ja": "足首を電子レンジにかけてもらった" },
    { "t": [114.6,115.5], "ja": "レントゲン" },
    { "t": [115.5,117.1], "ja": "血を取られて、科学のために使われた" },
    { "t": [117.1,118.1], "ja": "コレステロールの検査" },
    { "t": [118.1,120.6], "ja": "エイプリルは鼻の奥を取ってもらった" },
    { "t": [120.6,121.6], "ja": "診てもらっただけ" },
    { "t": [121.6,123.6], "ja": "どこかの男が僕のアレを見て、触った" },
    { "t": [123.6,124.5], "ja": "あれは変だったな" },
    { "t": [124.5,125.9], "ja": "しかもあの人、医者でもなかったし" },
    { "t": [125.9,126.8], "ja": "それは…" },
    { "t": [128.8,129.6], "ja": "え？" },
    { "t": [129.6,130.6], "ja": "ああ" },
    { "t": [130.6,132.6], "ja": "あなたを家に連れて帰って、私はアイスを買おう" },
    { "t": [132.6,134.4], "ja": "こちらが請求書です" },
    { "t": [134.4,136], "ja": "ああ、うん、それはいらないよ" },
    { "t": [136,137.6], "ja": "ただで薬がもらえるカードがあるから" },
    { "t": [137.6,140.8], "ja": "えー、歯の治療には500ドルの自己負担があります" },
    { "t": [140.8,142.5], "ja": "あれ、たぶん、えー、それは違うよ" },
    { "t": [142.5,144.9], "ja": "保険ってやつに入ってるんだ" },
    { "t": [144.9,145.8], "ja": "保険がきくはずだよ" },
    { "t": [145.8,147.5], "ja": "それでも500ドルです" },
    { "t": [147.5,149.5], "ja": "えっと、どれどれ" },
    { "t": [149.5,151.4], "ja": "あ、だって…" },
    { "t": [151.4,152.3], "ja": "ねえ" },
    { "t": [152.3,153.9], "ja": "行け！　ダッシュだ" },
    { "t": [153.9,156.1], "ja": "どいて！" },
    { "t": [156.1,157], "ja": "イエー！" },
    { "t": [157,158.6], "ja": "ウーフーフー！" },
    { "t": [158.6,159.7], "ja": "あらら" },
    { "t": [159.7,160.6], "ja": "あらら！" },
    { "t": [160.6,161.9], "ja": "救急車を呼んだよ！" },
    { "t": [161.9,164.7], "ja": "別の救急車ね。僕がぶつかったやつ！" },
    { "t": [164.7,167.2], "ja": "ほかの医者に診てもらったほうがいいかも" },
    { "t": [167.2,169.4], "ja": "だめ、もう医者はなし" },
    { "t": [169.4,171.2], "ja": "あいつらは詐欺師の集まりだ" },
    { "t": [171.2,172.9], "ja": "ただのもので釣って" },
    { "t": [172.9,174.8], "ja": "気づいたら、ドカン！" },
    { "t": [174.8,177.4], "ja": "救急車にぶつかってる" },
    { "t": [177.4,178.7], "ja": "毎回そうさ" },
    { "t": [178.7,180.8], "ja": "家に帰って、お互いに看病し合おう" },
    { "t": [180.8,182], "ja": "裁縫セットを買えばいい" },
    { "t": [182,183.5], "ja": "僕の唇を縫ってくれていいよ" },
    { "t": [183.5,185], "ja": "どこかの橋の下でさ" },
    { "t": [185,187.2], "ja": "うーん、すごくロマンチック" },
    { "t": [187.2,188.5], "ja": "あっ" },
    { "t": [188.5,189.9], "ja": "ごめん、忘れてた" },
    { "t": [189.9,190.7], "ja": "行こう" },
    { "t": [190.7,193.6], "ja": "ねえ、裁縫セットって保険がきくと思う？" },
    { "t": [193.6,195.6], "ja": "食料品とか、ゲームとかは？" },
    { "t": [195.6,196.7], "ja": "保険って何？" },
    { "t": [196.7,197.5], "ja": "知らない" },
    { "t": [197.5,198.4], "ja": "どうでもいいよ" }
  ]
}
