{"video":"fjq7zU7u_Mg","lines":[{"t":[0,0.8],"en":"Hey, Terry."},{"t":[1,1.9],"en":"Nice to see you again."},{"t":[2,2.9],"en":"It's been a while, huh?"},{"t":[3.4,4],"en":"Well, it's funny."},{"t":[4.1,5.9],"en":"These halls look smaller than they used to."},{"t":[6.8,7.8],"en":"It's a different building."},{"t":[9.8,10.2],"en":"So,"},{"t":[11.6,13.2],"en":"Stryker Ramore, huh?"},{"t":[14,15],"en":"When do you want me to start?"},{"t":[15.4,16.5],"en":"Why don't we start right now?"},{"t":[16.6,17],"en":"Okay."},{"t":[18.2,19.7],"en":"Here are the audition scenes."},{"t":[24.4,24.8],"en":"Audition?"},{"t":[25.3,26.7],"en":"I thought you were going to offer me the part."},{"t":[27.1,27.9],"en":"Why would you think that?"},{"t":[27.9,29.9],"en":"Well, it was Dr. Drake Ramore."},{"t":[30,31],"en":"Stryker's twin brother."},{"t":[31.8,33.7],"en":"Who looks more like me than me, right?"},{"t":[35.3,36.9],"en":"Everybody has to audition."},{"t":[39.5,40.4],"en":"You know, Terry,"},{"t":[40.4,42.5],"en":"I don't really need to do this."},{"t":[43,44.6],"en":"I got my own cable TV series."},{"t":[45.8,46.8],"en":"With a robot."},{"t":[49,50],"en":"I'm sorry, Joey."},{"t":[50.1,51.7],"en":"That's the way it is."},{"t":[52.9,53.2],"en":"Well,"},{"t":[54.8,56.7],"en":"I guess you think you're pretty special, huh?"},{"t":[57.5,58.4],"en":"Sitting up here"},{"t":[58.4,60.4],"en":"in your fancy small hall building."},{"t":[62.6,64.8],"en":"Making stars jump through hoops for you, huh?"},{"t":[65.5,66.2],"en":"Well, you know what?"},{"t":[68.6,70.4],"en":"This is one star who's hoop."},{"t":[71.9,73.8],"en":"This is a star that the hoop,"},{"t":[73.8,74.2],"en":"this hoop."},{"t":[74.4,75.8],"en":"I was Dr. Drake Ramore!"},{"t":[75.8,77.5],"en":"This is a star that the hoop,"}]}
