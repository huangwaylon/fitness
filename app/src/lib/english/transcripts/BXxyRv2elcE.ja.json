{
  "video": "BXxyRv2elcE",
  "lines": [
    { "t": [0,  5], "ja": "はいはい、落ち着いて。僕だよ、トム・セレックじゃない" },
    { "t": [5,  7], "ja": "いいね！" },
    { "t": [7,  10], "ja": "トビーが僕らみんなを「モーベンバー」に参加させたんだ" },
    { "t": [10,  13], "ja": "前立腺がんのための慈善活動だよ" },
    { "t": [13,  16], "ja": "お金の寄付を約束して、11月の1か月間、口ひげを伸ばすんだ" },
    { "t": [16,  18], "ja": "だから今、僕らはこんな見た目なのさ" },
    { "t": [18,  21], "ja": "ずっとムラムラさせられっぱなしでもいいならね" },
    { "t": [21,  25], "ja": "すげえ！ どんどん生えてくるな？" },
    { "t": [25,  27], "ja": "毛の腺がすごく豊かなんだ" },
    { "t": [27,  32], "ja": "男たちみんなをモーベンバーに参加させられて、本当によかった" },
    { "t": [32,  35], "ja": "別館で、最高にイケてる時間を過ごしてるよ" },
    { "t": [35,  36], "ja": "もう！" },
    { "t": [36,  39], "ja": "ランチにも一緒に行って、女の子をナンパするんだ" },
    { "t": [39,  42], "ja": "男の前立腺が好きなら、笑って" },
    { "t": [43,  45], "ja": "よし、始めよう" },
    { "t": [45,  46], "ja": "よし、了解。全員つながった？" },
    { "t": [46,  50], "ja": "いや、つながってるのは君だけだよ。僕らはみんなここにいる" },
    { "t": [50,  52], "ja": "そうか" },
    { "t": [52,  54], "ja": "では、この先3か月で…" },
    { "t": [54,  57], "ja": "冬のシーズンだ。3か月" },
    { "t": [57,  60], "ja": "実は、いくつかアイデアがあってさ" },
    { "t": [60,  62], "ja": "今、自分のオフィスにいるの？" },
    { "t": [62,  63], "ja": "うん" },
    { "t": [63,  65], "ja": "本当は、そっちでみんなと一緒にいたいよ" },
    { "t": [65,  66], "ja": "そうか" },
    { "t": [66,  69], "ja": "ああ、こっちで聞くと、なんか不気味にセクシーな声だぞ、ハルパート" },
    { "t": [69,  70], "ja": "あら" },
    { "t": [71,  74], "ja": "ごめん、たぶん電話をかけ直してもらったほうがいいって言ったんだ、その…" },
    { "t": [74,  79], "ja": "何かの間違いだと思う。かけたかったのはジム・ハルパートで、バットマンじゃない" },
    { "t": [79,  80], "ja": "うん" },
    { "t": [80,  85], "ja": "あー、そうだ。最初から携帯にかけてもらえばよかった" },
    { "t": [85,  86], "ja": "うん" },
    { "t": [86,  87], "ja": "別の場所で試してみるよ、いい？" },
    { "t": [87,  88], "ja": "うん、わかった" },
    { "t": [88,  89], "ja": "よし、すぐかけ直すね" },
    { "t": [89,  90], "ja": "了解" },
    { "t": [90,  91], "ja": "3か月後に何があるの？" },
    { "t": [91,  92], "ja": "そうだね" },
    { "t": [92,  93], "ja": "ああ" },
    { "t": [93,  94], "ja": "いいね" },
    { "t": [94,  95], "ja": "楽しいね" },
    { "t": [95,  96], "ja": "いや" },
    { "t": [96,  97], "ja": "でしょ？" },
    { "t": [97,  99], "ja": "いや、楽しいよ" },
    { "t": [99,  101], "ja": "エリン、どうかした？" },
    { "t": [101,  102], "ja": "うん" },
    { "t": [102,  103], "ja": "ごめんなさい" },
    { "t": [103,  104], "ja": "ただ、あなたの顔を見ちゃって" },
    { "t": [104,  105], "ja": "ああ" },
    { "t": [105,  106], "ja": "ごめんね" },
    { "t": [106,  107], "ja": "あれのためなんだ" },
    { "t": [107,  108], "ja": "分かってる" },
    { "t": [108,  109], "ja": "すごくいいと思う" },
    { "t": [109,  112], "ja": "ただ、顔の真ん中に眉毛があるみたいに見えるの" },
    { "t": [112,  113], "ja": "へえ" },
    { "t": [113,  118], "ja": "かっこいい眉毛よ。でも、えーと、口が目の穴みたいに見える" },
    { "t": [118,  119], "ja": "それも悪くないけど" },
    { "t": [119,  120], "ja": "へえ" },
    { "t": [120,  124], "ja": "でも、えーと、目が抜け落ちた一つ目の巨人みたい" },
    { "t": [124,  126], "ja": "それって素敵" },
    { "t": [126,  128], "ja": "すごく立派な活動だもの" },
    { "t": [128,  130], "ja": "そうだね" },
    { "t": [130,  154.4], "ja": "うそでしょ" }
  ]
}
