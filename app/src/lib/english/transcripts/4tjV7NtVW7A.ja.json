{
  "video": "4tjV7NtVW7A",
  "lines": [
    { "t": [0.2,1.8], "ja": "本当にあなたに謝らなきゃいけないの" },
    { "t": [2.5,3.2], "ja": "何を？" },
    { "t": [3.7,5.5], "ja": "ほら、初めて会ったとき" },
    { "t": [5.6,9.1], "ja": "あなたのこと、偉そうで、うぬぼれてて、感じの悪い人だと思ってたの" },
    { "t": [9.2,10.3], "ja": "謝るの、初めて？" },
    { "t": [11.8,13.2], "ja": "違うの、ただ言いたいのは" },
    { "t": [13.4,14.9], "ja": "第一印象なんて当てにならないってこと" },
    { "t": [15.6,17.6], "ja": "あなたは本当にいい人だと思う" },
    { "t": [17.7,19.8], "ja": "誤解してて、ごめんなさい" },
    { "t": [20.5,20.9], "ja": "おはよう" },
    { "t": [21.7,22.1], "ja": "どうも" },
    { "t": [23.1,23.7], "ja": "でもね" },
    { "t": [23.8,25.8], "ja": "ほら、新しい一日、心を入れかえて" },
    { "t": [26.3,28.7], "ja": "今、本当に、本当に幸せなの" },
    { "t": [29.7,32], "ja": "あら、ごめんなさいね" },
    { "t": [32.1,34.6], "ja": "どうやら、ヘザーのお尻のほうが大事な話があるみたいだから" },
    { "t": [34.6,36.1], "ja": "終わるまで待ってるから" },
    { "t": [37.8,38.2], "ja": "何？" },
    { "t": [38.5,40], "ja": "私が謝ってるのに" },
    { "t": [40.1,41.7], "ja": "あなた、完全に彼女を見てたでしょ" },
    { "t": [41.9,43], "ja": "見てないよ" },
    { "t": [43,43.7], "ja": "僕はファッションの仕事をしてるんだ" },
    { "t": [43.8,44.7], "ja": "彼女のスカートを見てたんだよ" },
    { "t": [44.7,44.9], "ja": "へえ" },
    { "t": [46.1,47.4], "ja": "それともズボンだったかな？" },
    { "t": [47.4,49.6], "ja": "お尻から下は、よく見てなかったんだ" },
    { "t": [51.1,53.7], "ja": "まあ、あなたって本当に、本当に気持ち悪い人ね" },
    { "t": [54.5,56.3], "ja": "僕が彼女を見てたって、君には関係ないだろ？" },
    { "t": [56.9,57.6], "ja": "やきもち？" },
    { "t": [58,58.7], "ja": "ええ、そうですとも" },
    { "t": [59.2,60], "ja": "やきもちですとも" },
    { "t": [60.3,63.1], "ja": "ああ、ギャビン、お願い、私のお尻も見て" },
    { "t": [64.3,65.7], "ja": "私のお尻を見るのはやめて" },
    { "t": [67.3,70.5], "ja": "とにかく、あなたは完全に不適切だと思うの、いい？" },
    { "t": [70.6,71.6], "ja": "ここは職場なのよ" },
    { "t": [72.3,73.1], "ja": "彼女はあなたの部下でしょ" },
    { "t": [73.7,76], "ja": "でも、君が前のアシスタントのタグと寝たのは、よかったわけ？" },
    { "t": [77.7,80.4], "ja": "それは全然違うわ。理由は2つ" },
    { "t": [81.1,83.9], "ja": "ひとつ目、あなたがそれを知ってるとは知らなかった" },
    { "t": [85.8,89.8], "ja": "2つ目、私は彼のお尻をじろじろ見る気持ち悪い人じゃなかった" },
    { "t": [89.9,93.2], "ja": "私たちは、深くて意味のある関係だったの" },
    { "t": [94.7,95.1], "ja": "へえ" },
    { "t": [95.7,97], "ja": "タグの名字は何だった？" },
    { "t": [97.5,97.9], "ja": "それは…" },
    { "t": [97.9,102.1], "ja": "うそでしょ" },
    { "t": [103.5,105.6], "ja": "彼には名字がなかったの" },
    { "t": [105.6,106], "ja": "それは…" },
    { "t": [106,107], "ja": "うそでしょ" }
  ]
}
