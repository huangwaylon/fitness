{
  "video": "YFzyMAN9Ojk",
  "lines": [
    { "t": [1, 2.1], "ja": "で、二人はどうやって知り合ったの？" },
    { "t": [2.1, 3.6], "ja": "スーパーで会ったの" },
    { "t": [3.6, 5.4], "ja": "俺の定番の口説き文句を使ったんだ" },
    { "t": [5.4, 7.9], "ja": "「ドゥーシュをお探しなら、この俺の売り場にございます」ってね" },
    { "t": [9.2, 10.3], "ja": "最高" },
    { "t": [10.3, 11.4], "ja": "あ、ところで、たぶん" },
    { "t": [11.4, 14.2], "ja": "あの人から本を返してもらうのは無理そう。えっと、名前なんだっけ？" },
    { "t": [14.2, 15.2], "ja": "ああ、いいのよ" },
    { "t": [15.2, 17.7], "ja": "だって、物を貸すなんてやめておけばよかったのよ" },
    { "t": [17.7, 18.8], "ja": "あなたの彼氏にね" },
    { "t": [18.8, 20.4], "ja": "すぐ来ては、すぐいなくなるんだから" },
    { "t": [20.4, 22.4], "ja": "それってどういう意味？" },
    { "t": [22.4, 23.4], "ja": "だって、正直に言いましょうよ" },
    { "t": [23.4, 24.9], "ja": "この人とはいつまで続くの？" },
    { "t": [24.9, 26], "ja": "ここに座ってるんだけど" },
    { "t": [26, 28.6], "ja": "さあね。彼はおバカだけど楽しいの" },
    { "t": [28.6, 29.6], "ja": "ありがとう" },
    { "t": [29.6, 31.1], "ja": "だって、それがいろんな人とデートする意味でしょ" },
    { "t": [31.1, 33.1], "ja": "いろんな帽子を試せるの" },
    { "t": [33.1, 35], "ja": "へえ、この帽子はばかだけどね" },
    { "t": [35, 36.6], "ja": "はは、名作だ" },
    { "t": [36.6, 39.4], "ja": "レスリー、私がここに来たことを怒ってる？" },
    { "t": [39.4, 40.2], "ja": "え？" },
    { "t": [40.2, 43], "ja": "怒ってないわよ。あなたこそ、私に怒ってるみたい" },
    { "t": [43, 44.2], "ja": "いいえ、怒ってない。あなたに怒ってなんかない" },
    { "t": [44.2, 45], "ja": "あなたに怒ってない" },
    { "t": [45, 45.9], "ja": "全然怒ってないわ" },
    { "t": [45.9, 46.7], "ja": "私もよ" },
    { "t": [46.7, 47.6], "ja": "ええ" },
    { "t": [49.4, 51.1], "ja": "二人とも、キスして仲直りしたほうがいいみたいだな" },
    { "t": [51.1, 51.9], "ja": "いいわ" },
    { "t": [52.7, 55], "ja": "悪く思わないでね。でも私のペースが速すぎると思うのは" },
    { "t": [55, 56.4], "ja": "あなたがベンとのことに慎重すぎるからじゃない？" },
    { "t": [56.4, 57.8], "ja": "悪く思わないでね。でも私が慎重なのは" },
    { "t": [57.8, 59.2], "ja": "仕事を失うかもしれないからよ" },
    { "t": [59.2, 60.8], "ja": "悪く思わないでね。でもそれって" },
    { "t": [60.8, 62.8], "ja": "自分の気持ちに従って動かない言い訳じゃない？" },
    { "t": [62.8, 63.9], "ja": "悪く思わないでね。でもあなたが" },
    { "t": [63.9, 66], "ja": "気持ちの看護師の資格を持ってたなんて知らなかったわ" },
    { "t": [66, 67.8], "ja": "悪く思うわよ。失礼ね" },
    { "t": [67.8, 69.4], "ja": "踊ってくる" },
    { "t": [69.4, 70.4], "ja": "さあ、ドゥーシュの出番だ" },
    { "t": [70.4, 72.5], "ja": "ああ、うん、うん" },
    { "t": [72.5, 73.7], "ja": "ねえ、大丈夫？" },
    { "t": [73.7, 74.7], "ja": "どなり声が聞こえたけど" },
    { "t": [74.7, 76.5], "ja": "ええ、すごく怒ってるし、すごく酔ってる" },
    { "t": [76.5, 77.4], "ja": "私と踊る？" },
    { "t": [77.4, 78.8], "ja": "もう1杯お酒を持ってきて" },
    { "t": [78.8, 81.4], "ja": "ああ、それはあまりいい考えじゃないかも" },
    { "t": [81.4, 82.4], "ja": "もういいわ！" },
    { "t": [82.4, 83.4], "ja": "ジャン・ラルフィオ！" },
    { "t": [83.4, 84.4], "ja": "はい、ここにいるよ" },
    { "t": [84.4, 85.4], "ja": "私にくっついて踊って" },
    { "t": [85.4, 86.4], "ja": "いいね、いいね、いいね" },
    { "t": [86.4, 89.7], "ja": "これはアンとの初めてのけんかで、しかもすごく大きいの" },
    { "t": [89.7, 93], "ja": "でも、友だち同士の正直な話し合いは" },
    { "t": [93, 94.7], "ja": "もっと深い絆につながると思う" },
    { "t": [94.7, 96.6], "ja": "二人の関係の大事な分かれ目だから" },
    { "t": [96.6, 98.7], "ja": "正々堂々とけんかしなきゃ" },
    { "t": [98.7, 102.2], "ja": "集中して、落ち着いていればいいの" },
    { "t": [102.2, 106.1], "ja": "あなたはばか、そのジャケットもばか、とにかくばか" },
    { "t": [106.1, 108.7], "ja": "ねえ、なんでこれが私のせいなのかわからない" },
    { "t": [108.7, 111.1], "ja": "違う、いつも全部があなたのせいなわけじゃない" },
    { "t": [111.1, 112.9], "ja": "いつも何でも自分のせいにしないで" },
    { "t": [112.9, 113.8], "ja": "よかった、よかった、全部私のせいじゃないのね" },
    { "t": [113.8, 114.6], "ja": "わかった、私のせいよ" },
    { "t": [114.6, 116.2], "ja": "私はばかな嫌な女じゃない" },
    { "t": [116.2, 118.2], "ja": "今あなたにばかなことをしてるのは私じゃないわ" },
    { "t": [118.2, 119], "ja": "そういう意味じゃなかったの" },
    { "t": [119, 120], "ja": "いいえ、そういう意味じゃなかった" },
    { "t": [120, 121.3], "ja": "ただ、あなたがばかで" },
    { "t": [121.3, 122.6], "ja": "嫌な態度だったって意味よ" },
    { "t": [122.6, 125.5], "ja": "ねえ、あなたを仕事の候補に考えて悪かったわね" },
    { "t": [125.5, 128], "ja": "でも、ときどき私が正しい方向に押してあげないと" },
    { "t": [128, 129.8], "ja": "あなたは結局立ち止まったままなのよ" },
    { "t": [129.8, 131.3], "ja": "あなたのためを思ってやっただけ" },
    { "t": [131.3, 134.3], "ja": "もう、あなたの「ためを思って」はたくさん" },
    { "t": [134.3, 135.1], "ja": "やめて" },
    { "t": [139.7, 141.5], "ja": "じゃあ、もう一緒に働かないほうがいいのかも" },
    { "t": [142.7, 143.5], "ja": "そうかもね" },
    { "t": [161.3, 166.1], "ja": "また次回お会いしましょう" }
  ]
}
