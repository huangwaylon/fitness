{
  "video": "Xh1oUOm6EGQ",
  "lines": [
    { "t": [0, 1.5], "ja": "おはよう、アンディ" },
    { "t": [4.5, 7.5], "ja": "よし、僕のパソコン、何か違うぞ" },
    { "t": [9.7, 11.7], "ja": "あっ、なくなってる" },
    { "t": [14.2, 17.2], "ja": "事件の始まりだ" },
    { "t": [17.2, 19.5], "ja": "実は、警察学校の入学試験の一部に" },
    { "t": [19.5, 22.1], "ja": "犯罪の捜査があるんだ" },
    { "t": [22.1, 24], "ja": "だから1か月くらい前、オフィスのみんなに" },
    { "t": [24, 25.6], "ja": "いつか僕の机から何か盗んでって頼んでおいたんだ" },
    { "t": [25.6, 27.9], "ja": "練習できるようにね" },
    { "t": [27.9, 29.4], "ja": "さあ、始めよう" },
    { "t": [30, 33.3], "ja": "待って、ねえ、僕の眼鏡も持っていった？" },
    { "t": [33.3, 35.7], "ja": "私はサングラスも持ってきた" },
    { "t": [35.7, 37.9], "ja": "先週末、マイアミに行ってたんだ" },
    { "t": [37.9, 39.7], "ja": "サウスビーチで本領を発揮してきた" },
    { "t": [39.7, 41.2], "ja": "マイアミではどうやって過ごしたの？" },
    { "t": [41.2, 43.1], "ja": "盗んだパソコンを売りさばいてたとか？" },
    { "t": [43.1, 45.6], "ja": "そうだよ、君の役所のパソコンを" },
    { "t": [45.6, 49], "ja": "インディアナからマイアミまで持っていって" },
    { "t": [49, 52.7], "ja": "闇市場で150ドルで売ったんだ" },
    { "t": [52.7, 56.1], "ja": "はは、気づいてないだろうけど、今ので自分からばらしたね" },
    { "t": [57.7, 60], "ja": "一日中、君の資料を見てたんだ" },
    { "t": [60, 62.9], "ja": "ジェリー、それが本当の名前ならね" },
    { "t": [62.9, 64.1], "ja": "違うよ" },
    { "t": [64.1, 65.7], "ja": "本当の名前はゲーリーだ" },
    { "t": [65.7, 69.2], "ja": "じゃあ、ゲーリー、それが本当の名前ならね" },
    { "t": [69.2, 70.9], "ja": "誰かが僕のパソコンを盗んだ" },
    { "t": [70.9, 73.7], "ja": "もし犯人なら、僕の目を見て" },
    { "t": [73.7, 76.2], "ja": "法律で、言わなきゃいけないことになってるんだ" },
    { "t": [76.2, 78.7], "ja": "じゃないと、おとり捜査になっちゃう" },
    { "t": [78.7, 81.3], "ja": "ごめん、アンディ、僕じゃないよ" },
    { "t": [81.3, 82.7], "ja": "うわあ、本当に？" },
    { "t": [82.7, 83.9], "ja": "違う" },
    { "t": [83.9, 84.4], "ja": "そうか" },
    { "t": [84.4, 85.4], "ja": "うん" },
    { "t": [85.4, 86.8], "ja": "よし、じゃあ、ジェリーじゃないってことは分かった" },
    { "t": [86.8, 88.9], "ja": "僕にうそをついてなければね" },
    { "t": [88.9, 92.2], "ja": "人がうそをついてるか、僕は全然見抜けないんだ" },
    { "t": [92.2, 95.7], "ja": "警察の仕事で、それが問題にならないといいけど" },
    { "t": [95.7, 96.6], "ja": "どういう作戦でいきますか、お巡りさん？" },
    { "t": [96.6, 99.4], "ja": "周りを封鎖して、電話を何台か盗聴するとか？" },
    { "t": [99.4, 100.9], "ja": "あ、そうだ。盗ませるためのおとりのパソコンを置いて" },
    { "t": [100.9, 103.7], "ja": "先に爆薬を詰めておくのはどう？" },
    { "t": [103.7, 106], "ja": "ドーン、全員やっつける" },
    { "t": [106, 107.7], "ja": "いや、そういうことは一切やらないよ" },
    { "t": [107.7, 109.4], "ja": "アンディ、君のやる気は大好きだけど" },
    { "t": [109.4, 110.9], "ja": "うちには、そこまでのお金はないんだ" },
    { "t": [110.9, 113.8], "ja": "大がかりな捜査を始めるほどのね" },
    { "t": [113.8, 115.8], "ja": "このくだらない報告書を書くだけ？" },
    { "t": [115.8, 116.8], "ja": "それで終わり？" },
    { "t": [116.8, 118.2], "ja": "将来の警官として、分かってほしいんだけど" },
    { "t": [118.2, 119.5], "ja": "こいつを逃がすわけにはいかないんだ" },
    { "t": [119.5, 123.1], "ja": "いいかい、警察の仕事って、ほとんどこういうことなんだ" },
    { "t": [123.1, 125.1], "ja": "ただ書き留めるだけ" },
    { "t": [125.1, 127.4], "ja": "スーパーヒーローの出番じゃない" },
    { "t": [127.4, 131], "ja": "つまらなそうに聞こえるなら、別のことをしたほうがいいかもね" },
    { "t": [133.1, 134.8], "ja": "彼の前向きな気持ちを盗んだ犯人を" },
    { "t": [134.8, 137.9], "ja": "見つけたほうがいいかもね" },
    { "t": [137.9, 139.2], "ja": "やあ、キャプテン" },
    { "t": [139.2, 140.6], "ja": "えっと、最新の報告です" },
    { "t": [140.6, 144.1], "ja": "新しい容疑者は、カーペット・エンポリウムを経営してる男です" },
    { "t": [144.1, 145.5], "ja": "僕の考えでは、犯罪者は物をじゅうたんで" },
    { "t": [145.5, 147.8], "ja": "くるむのが大好きだから" },
    { "t": [147.8, 150.2], "ja": "それに、全部広げようとしたら怒鳴られたし…" },
    { "t": [150.2, 152.4], "ja": "アンディ、犯人を見つけようとする君の熱意は" },
    { "t": [152.4, 153.7], "ja": "ありがたいけど" },
    { "t": [153.7, 155.5], "ja": "警官が言ったことも" },
    { "t": [155.5, 156.6], "ja": "考えたほうがいいと思う" },
    { "t": [156.6, 161.4], "ja": "だって、悪いやつを捜査すらできないなら" },
    { "t": [161.4, 164.1], "ja": "警官になる意味なんてないじゃないか" },
    { "t": [164.1, 165.1], "ja": "何してるの？" },
    { "t": [165.1, 166.5], "ja": "落ち込むとシャツを脱ぐんだ" },
    { "t": [166.5, 168.7], "ja": "嫌な気分になると汗が出てくるから" },
    { "t": [168.7, 170.8], "ja": "ああ" },
    { "t": [170.8, 171.7], "ja": "あのさ" },
    { "t": [171.7, 174.2], "ja": "警官になるのはやめたほうがいいかも" },
    { "t": [174.2, 177.6], "ja": "市役所で、週末だけのパートの警備員を" },
    { "t": [177.6, 178.8], "ja": "新しく探してるんだ" },
    { "t": [178.8, 179.7], "ja": "やってみる？" },
    { "t": [179.7, 181.2], "ja": "警官になりたいか、確かめる" },
    { "t": [181.2, 182.9], "ja": "方法だと思えばいい" },
    { "t": [182.9, 185.1], "ja": "でも、覚えておいて。この仕事を引き受けるなら" },
    { "t": [185.1, 187.2], "ja": "いつも服を着ていないといけない" },
    { "t": [187.2, 188.7], "ja": "悲しくなってもね" },
    { "t": [188.7, 191.3], "ja": "それはできない" },
    { "t": [191.3, 192.4], "ja": "分かった、やるよ" },
    { "t": [192.4, 193.2], "ja": "それでこそ" },
    { "t": [193.2, 194.3], "ja": "やるよ、約束する" },
    { "t": [194.3, 198], "ja": "それに銃をもらって、人の顔に向けられるんだよね" },
    { "t": [198, 198.8], "ja": "違う" }
  ]
}
