{
  "video": "Lgfqhhf-WSk",
  "lines": [
    { "t": [0, 1.3], "ja": "次はユニティ・コンサートね" },
    { "t": [1.3, 5], "ja": "ベンはテントの業者と会って、契約をまとめる" },
    { "t": [5, 6.3], "ja": "エイプリルとドナは私を手伝って" },
    { "t": [6.3, 7.8], "ja": "出店の配置図を作ってもらう" },
    { "t": [7.8, 9.4], "ja": "それから私は測量士と会って" },
    { "t": [9.4, 10.6], "ja": "コンサート会場の打ち合わせをする" },
    { "t": [10.6, 13.7], "ja": "公園の調査は、私が一人でやりたいと思う" },
    { "t": [13.7, 16.7], "ja": "わあ、ロン、いつかそんな日が来るってずっと分かってた" },
    { "t": [16.7, 18.3], "ja": "私の思いがあなたに伝わって" },
    { "t": [18.3, 20.3], "ja": "あなたが役所の仕事を好きになる日がね" },
    { "t": [20.3, 21.8], "ja": "今日がその歴史的な日なのね" },
    { "t": [21.8, 24.1], "ja": "ああ、まさにそういうことだ" },
    { "t": [24.1, 28.8], "ja": "一日外で一人で過ごせるなんて、夢のようだ" },
    { "t": [28.8, 32.4], "ja": "父親でいるのは好きだが、恋しいものもいくつかある" },
    { "t": [32.4, 37.2], "ja": "静けさ、音のない状態、たった一瞬でいい" },
    { "t": [37.2, 40.2], "ja": "子ども番組の音に邪魔されない時間だ" },
    { "t": [40.2, 42.9], "ja": "「ドック・マクスタッフィン」という番組のな" },
    { "t": [42.9, 44.9], "ja": "もう静けさはない" },
    { "t": [45.8, 48.3], "ja": "あるのは「ドック・マクスタッフィン」だけだ" },
    { "t": [49.3, 50.2], "ja": "すまない、エミリー" },
    { "t": [50.2, 52.4], "ja": "あ、アンディ、ロンと一緒に行って手伝ったら？" },
    { "t": [52.4, 53.6], "ja": "いや、その必要は…" },
    { "t": [53.6, 55], "ja": "助手席！助手席は僕がもらった" },
    { "t": [55, 56.1], "ja": "どこ行くの？どこでもいいや" },
    { "t": [56.1, 57.6], "ja": "助手席。今日はどの車でもずっと助手席" },
    { "t": [57.6, 59], "ja": "一生ずっとね" },
    { "t": [59, 60], "ja": "どんな車でも！" },
    { "t": [60, 61.2], "ja": "はは！" },
    { "t": [61.2, 63.1], "ja": "お前ら、先に取ったもんね！" },
    { "t": [63.1, 65.1], "ja": "じゃあ駐車場でね、ロン、あとで！" },
    { "t": [67.1, 68], "ja": "ねえ、ロン？" },
    { "t": [69.5, 71.7], "ja": "ちょっと大事な質問してもいい？" },
    { "t": [71.7, 74.9], "ja": "ほら、ATMでお金を下ろすときにさ" },
    { "t": [74.9, 78.3], "ja": "壁の後ろに本当に人が立ってて" },
    { "t": [78.3, 79.9], "ja": "お札を差し込んでたりするの？" },
    { "t": [79.9, 80.8], "ja": "いや" },
    { "t": [80.8, 82.3], "ja": "ああ、ロボットだね" },
    { "t": [82.3, 84.2], "ja": "あ、そうだ、ねえ" },
    { "t": [84.2, 85.3], "ja": "真面目な質問があるんだ" },
    { "t": [85.3, 87.1], "ja": "映画の「プレデター」でさ" },
    { "t": [87.1, 90.5], "ja": "体にどんな泥でも塗れば" },
    { "t": [90.5, 92.1], "ja": "プレデターに見つからないの？" },
    { "t": [92.1, 93.9], "ja": "熱を感知する目を持ってるけど" },
    { "t": [93.9, 94.8], "ja": "それとも…" },
    { "t": [94.8, 96], "ja": "痛っ！" },
    { "t": [96, 96.8], "ja": "最悪" },
    { "t": [96.8, 97.9], "ja": "けがしたか？" },
    { "t": [97.9, 99.3], "ja": "ううん" },
    { "t": [99.3, 100.7], "ja": "大丈夫" },
    { "t": [100.7, 102.4], "ja": "大丈夫" },
    { "t": [102.4, 104.1], "ja": "おっと、口以外はね" },
    { "t": [106.1, 107.7], "ja": "おっと、おっと" },
    { "t": [107.7, 109.4], "ja": "5秒ルール" },
    { "t": [109.4, 110.1], "ja": "だめだ" },
    { "t": [110.1, 110.9], "ja": "ああ！" },
    { "t": [110.9, 111.6], "ja": "さあ" },
    { "t": [111.6, 113.9], "ja": "歯医者に連れて行ったほうがいいな" },
    { "t": [113.9, 115.6], "ja": "受付の人が、診察に入れてくれるそうだ" },
    { "t": [115.6, 117], "ja": "空きが出たらすぐに" },
    { "t": [117, 119.1], "ja": "大丈夫なら、私は公園に戻る" },
    { "t": [119.1, 120.7], "ja": "ねえ、待って、待って、待って、早く、早く、早く" },
    { "t": [120.7, 123.4], "ja": "僕の社会保障番号って知ってる？" },
    { "t": [123.4, 125.8], "ja": "それか、何かアレルギーがあるかとか？" },
    { "t": [125.8, 127.3], "ja": "コーンは好きじゃないんだ" },
    { "t": [127.3, 128.2], "ja": "それって書いたほうがいい？" },
    { "t": [128.2, 129.7], "ja": "それとも、ややこしくなるかな？" },
    { "t": [129.7, 132.6], "ja": "だってキャンディコーンは好きだから" },
    { "t": [132.6, 134.4], "ja": "ああ、ロン" },
    { "t": [134.4, 135.6], "ja": "ぐちゃぐちゃだね" },
    { "t": [136.1, 139.4], "ja": "ほら、手伝ってあげる" },
    { "t": [139.4, 142.7], "ja": "望んだのは、忘れられる2時間だけだった" },
    { "t": [142.7, 144.7], "ja": "自分が親だってことを" },
    { "t": [144.7, 147.5], "ja": "見て、3つの違いを全部見つけたよ" },
