{
  "video": "-vmeMdTwy94",
  "lines": [
    { "t": [0,  2.8], "ja": "アン・パーキンス" },
    { "t": [2.8,  5], "ja": "やあ。ランニングはどうだった？" },
    { "t": [5,  8.4], "ja": "最後は1マイル5分半。自己ベストだ" },
    { "t": [8.4,  10.4], "ja": "この町の舗装は柔らかいんだと思う" },
    { "t": [10.4,  11.8], "ja": "そのマスク、どうしたの？" },
    { "t": [11.8,  12.9], "ja": "インフルエンザ予防だ" },
    { "t": [12.9,  15.1], "ja": "僕の体はマイクロチップみたいに精密に調整されていて" },
    { "t": [15.1,  16.9], "ja": "インフルエンザは砂粒みたいなものなんだ" },
    { "t": [16.9,  19.4], "ja": "文字どおり、システム全体を止めてしまいかねない" },
    { "t": [19.4,  21.5], "ja": "私の体もチップみたいなものよ" },
    { "t": [21.5,  23.4], "ja": "ポテトチップ" },
    { "t": [23.4,  24.6], "ja": "違う" },
    { "t": [24.6,  25.7], "ja": "ポテトチップといえば" },
    { "t": [25.7,  28], "ja": "明日は二人で夕食だよね？" },
    { "t": [28,  29], "ja": "ええ、もちろん" },
    { "t": [29,  32.1], "ja": "すごく、すごく楽しみ" },
    { "t": [32.1,  33.8], "ja": "楽しみにしてる" },
    { "t": [33.8,  35.5], "ja": "よかった" },
    { "t": [37.5,  39.1], "ja": "やったな、相棒。やったぞ" },
    { "t": [39.1,  41.1], "ja": "何回かデートしたの" },
    { "t": [41.1,  42.6], "ja": "彼のこと、すごく好き" },
    { "t": [42.6,  46.6], "ja": "問題は、彼が完璧な人間の男みたいだってこと" },
    { "t": [46.6,  49.4], "ja": "欠点が一つも見つからない" },
    { "t": [49.4,  52.5], "ja": "一度、彼がおならしたと思ったことがあったけど" },
    { "t": [52.5,  54.5], "ja": "私だった" },
    { "t": [56,  57], "ja": "やあ、アン" },
    { "t": [57,  58], "ja": "どうしたの？" },
    { "t": [58,  61], "ja": "数時間前に会ったときは元気だったのに" },
    { "t": [61,  64.4], "ja": "「うわ、かっこいい」の意味じゃなくて、健康面で元気って意味ね" },
    { "t": [64.4,  67.1], "ja": "僕の体には、病気から身を守る脂肪がないんだ" },
    { "t": [67.1,  68.1], "ja": "あっという間に悪くなる" },
    { "t": [68.1,  69.1], "ja": "聞いてくれ" },
    { "t": [69.1,  72.6], "ja": "すごく大事なんだ、僕の体に電解質を補給してくれ" },
    { "t": [72.6,  75.5], "ja": "体液が勝手に出ていくたびに" },
    { "t": [75.5,  76.5], "ja": "あらまあ" },
    { "t": [76.5,  80.1], "ja": "僕の体は、病気になると水分をたくさん失いがちなんだ" },
    { "t": [80.1,  82.5], "ja": "脳が燃えてる。死にそうだ" },
    { "t": [82.5,  85.5], "ja": "うーん。まあ、間違いなくインフルエンザね" },
    { "t": [85.5,  87.5], "ja": "ああ、なんてことだ" },
    { "t": [87.5,  90.2], "ja": "マイクロチップがやられてしまった" },
    { "t": [90.2,  95.2], "ja": "この部屋のどこかで吐いた" },
    { "t": [95.2,  97.2], "ja": "どこかは覚えてないけど" },
    { "t": [97.2,  99.9], "ja": "待って。その引き出しは確認したほうがいいかも" },
    { "t": [99.9,  105.3], "ja": "もう…下痢は…やめてくれ" },
    { "t": [105.3,  107], "ja": "もう床から起き上がらなきゃ" },
    { "t": [107,  109.4], "ja": "この床は僕の友だちなんだ" },
    { "t": [109.4,  111.5], "ja": "完全に体が参ってるのを見ると" },
    { "t": [111.5,  114], "ja": "男の人が全然こわく見えなくなるのよね" },
    { "t": [114,  116], "ja": "インフルエンザって最高" },
    { "t": [116,  126], "ja": "（音楽）" }
  ]
}
