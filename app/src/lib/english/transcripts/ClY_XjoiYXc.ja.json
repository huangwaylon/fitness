{
  "video": "ClY_XjoiYXc",
  "lines": [
    { "t": [0,  5], "ja": "やあ" },
    { "t": [5,  8], "ja": "あれ、これは何？" },
    { "t": [8,  10], "ja": "それは減点だ" },
    { "t": [10,  12], "ja": "ジム・ハルパート、遅刻" },
    { "t": [12,  14], "ja": "おお、もう気に入ったよ" },
    { "t": [14,  16], "ja": "学ばなきゃだめだ、ジム。君はナンバー2だが" },
    { "t": [16,  18], "ja": "だからといって、規則より上にいるわけじゃない" },
    { "t": [18,  21], "ja": "ああ、分かるよ。それに質問もたくさんある" },
    { "t": [21,  24], "ja": "例えば、減点ってどういう意味？" },
    { "t": [24,  25], "ja": "こう言っておこう" },
    { "t": [25,  27], "ja": "3つはもらいたくないはずだ" },
    { "t": [27,  28], "ja": "聞かせてよ。減点3つで" },
    { "t": [28,  30], "ja": "警告書が1枚" },
    { "t": [30,  32], "ja": "それは深刻そうだね。ああ、深刻だ" },
    { "t": [32,  35], "ja": "警告書が5枚で、違反だ" },
    { "t": [35,  38], "ja": "違反が4つで、口頭注意" },
    { "t": [38,  40], "ja": "それが続けば、書面での注意だ" },
    { "t": [40,  44], "ja": "それが2つで、ひどい目にあうことになる" },
    { "t": [44,  47], "ja": "私が書いた懲戒審査の形でな" },
    { "t": [47,  49], "ja": "それを私の直属の上司の机に置く" },
    { "t": [49,  51], "ja": "それは僕だね" },
    { "t": [51,  53], "ja": "そのとおりだ" },
    { "t": [53,  56], "ja": "よし。今日中に一部、僕の机に置いておいて" },
    { "t": [56,  60], "ja": "さもないと、完全なる「ディサジュレーション」を受けることになるよ" },
    { "t": [60,  64], "ja": "ディス…何だって？" },
    { "t": [64,  66], "ja": "ああ、知らないほうがいいよ" }
  ]
}
