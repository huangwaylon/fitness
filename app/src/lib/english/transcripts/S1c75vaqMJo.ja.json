{
  "video": "S1c75vaqMJo",
  "lines": [
    { "t": [0.7, 2.4], "ja": "ここに来たなんて信じられない" },
    { "t": [2.4, 3.8], "ja": "こんなことが起きてるなんて信じられないよ" },
    { "t": [3.8, 5.1], "ja": "信じろ" },
    { "t": [5.1, 6.6], "ja": "アフロのかつら？アフロのかつらいる？" },
    { "t": [6.6, 8.6], "ja": "いらない。マイケル、僕は車から降りないよ" },
    { "t": [8.6, 9.9], "ja": "ああもう。わかった" },
    { "t": [9.9, 10.7], "ja": "ドワイト。何だ？" },
    { "t": [10.7, 11.6], "ja": "こういう段取りでいくぞ" },
    { "t": [11.6, 13.6], "ja": "お前と僕で…" },
    { "t": [13.6, 15.5], "ja": "誰かが押す" },
    { "t": [15.5, 17.2], "ja": "お前と僕でこっそり中に入って" },
    { "t": [17.2, 18.9], "ja": "倉庫の作業員のふりをして" },
    { "t": [18.9, 21.2], "ja": "ひもスプレーで、あそこをめちゃくちゃにしてやるんだ" },
    { "t": [21.2, 22.6], "ja": "それで、もし身を守る必要があったら" },
    { "t": [22.6, 24.9], "ja": "警備員の目を" },
    { "t": [24.9, 25.9], "ja": "特大のチョークで刺す" },
    { "t": [25.9, 28], "ja": "だめだめ、そんなことはしない" },
    { "t": [28, 29.6], "ja": "しない。じゃあ特大チョークを粉にして" },
    { "t": [29.6, 30.8], "ja": "あいつの目に吹きかける" },
    { "t": [30.8, 35], "ja": "ドワイト、目には何もするな。頼むよ" },
    { "t": [35, 37.3], "ja": "わかったよ、ジム" },
    { "t": [37.3, 38.6], "ja": "うわ、あれ彼女だ" },
    { "t": [38.6, 39.6], "ja": "彼女だ。行け。行け、行け、行け" },
    { "t": [39.6, 41.2], "ja": "動け、動け、動け、動け、動け、動け、動け、動け" },
    { "t": [41.2, 42.7], "ja": "黙れ" },
    { "t": [42.7, 45], "ja": "今までで一番ばかなことしてるよ" },
    { "t": [59.2, 60.4], "ja": "今、階段にいる" },
    { "t": [60.4, 61.8], "ja": "階段を上っている" },
    { "t": [64.8, 65.9], "ja": "息が荒くなってる" },
    { "t": [65.9, 66.6], "ja": "ねえ、あのさ" },
    { "t": [66.6, 68.4], "ja": "そんなに逐一報告しなくて" },
    { "t": [68.4, 69.2], "ja": "いいんだけど" },
    { "t": [69.2, 69.9], "ja": "おっと、男がいる" },
    { "t": [69.9, 70.7], "ja": "男がいるぞ" },
    { "t": [70.7, 71.8], "ja": "警備員がこっちに来る" },
    { "t": [71.8, 72.9], "ja": "よし" },
    { "t": [72.9, 73.7], "ja": "どうも" },
    { "t": [73.7, 75.7], "ja": "我々は倉庫の作業員です" },
    { "t": [75.7, 76.8], "ja": "もっと証拠がほしいですか？" },
    { "t": [76.8, 77.8], "ja": "よし" },
    { "t": [77.8, 79.4], "ja": "うわあ" },
    { "t": [79.4, 80.9], "ja": "危なかった" },
    { "t": [80.9, 82.3], "ja": "警備員の目が見える" },
    { "t": [82.3, 83.1], "ja": "だめ、だめ" },
    { "t": [83.1, 84.6], "ja": "目には何もするな" },
    { "t": [84.6, 86.6], "ja": "あいつの目に何かしないと気がすまない" },
    { "t": [86.6, 90.3], "ja": "目は頭の急所なんだ" },
    { "t": [90.3, 91.8], "ja": "わかった、すごいね、スコットさん" },
    { "t": [91.8, 93.5], "ja": "窒息注意の張り紙を見つけたなら" },
    { "t": [93.5, 94.3], "ja": "もう帰ってきて" },
    { "t": [94.3, 95.5], "ja": "もっといいものを見つけたぞ" },
    { "t": [95.5, 98.3], "ja": "あそこの目玉商品、業務用コピー機だ" },
    { "t": [99.5, 100.9], "ja": "あれってすごく大きくない？" },
    { "t": [100.9, 103.9], "ja": "ものすごく大きいけど、車輪がついてる" },
    { "t": [103.9, 106.8], "ja": "廊下を転がして階段まで運んでる" },
    { "t": [106.8, 108.2], "ja": "車の準備をしておいてくれ" },
    { "t": [108.2, 109.5], "ja": "エンジンはかけたままでな" },
    { "t": [109.5, 111.5], "ja": "いや、それはひどい考えだよ" },
    { "t": [111.5, 112.6], "ja": "やめなよ" },
    { "t": [112.6, 115.5], "ja": "ああ、腰の骨が" },
    { "t": [115.5, 117.4], "ja": "コピー機と手すりの間にはさまってる" },
    { "t": [117.4, 118.3], "ja": "痛っ" },
    { "t": [118.3, 119.4], "ja": "くそ" },
    { "t": [119.4, 120.5], "ja": "脚の上にのってるんだ、ジム" },
    { "t": [120.5, 121.4], "ja": "俺たちを置いていけ、ジム" },
    { "t": [121.4, 122.4], "ja": "今すぐ置いていけ" },
    { "t": [122.4, 123.2], "ja": "自分だけでも助かれ" },
    { "t": [123.2, 124.1], "ja": "置いていかないで" },
    { "t": [124.1, 124.9], "ja": "助けて" },
    { "t": [124.9, 125.8], "ja": "助けが必要なんだ、ジム" },
    { "t": [125.8, 127.6], "ja": "いい、まず僕の名前を言わないで" },
    { "t": [127.6, 128.8], "ja": "それから、とにかく…" },
    { "t": [128.8, 129.8], "ja": "どいてくれ" },
    { "t": [129.8, 130.7], "ja": "もう、二人とも" },
    { "t": [130.7, 132.6], "ja": "ちょっと、少しずれて" },
    { "t": [132.6, 134], "ja": "ぼうこうがもう限界だ" },
    { "t": [134, 134.9], "ja": "うわ" },
    { "t": [134.9, 135.7], "ja": "うわ、うわ" },
    { "t": [135.7, 136.8], "ja": "カレンが戻ってきた" },
    { "t": [136.8, 137.9], "ja": "あれカレン？" },
    { "t": [137.9, 139], "ja": "彼女をモーテルに連れていけ" },
    { "t": [139, 140.4], "ja": "彼女を抱け、ジム" },
    { "t": [140.4, 141.4], "ja": "いや、そんなことしないよ" },
    { "t": [141.4, 143.7], "ja": "よりを戻したいって言えばいい" },
    { "t": [143.7, 145.3], "ja": "いや、そんなことしないって" },
    { "t": [145.3, 146.5], "ja": "意味なんかなくていいんだ" },
    { "t": [146.5, 149.5], "ja": "スタンリーのためにやれ" },
    { "t": [149.5, 150.2], "ja": "頼むよ、ジム" },
    { "t": [150.2, 152.4], "ja": "彼女の上に乗って、スタンリーのことを考えろ" },
    { "t": [152.4, 153.8], "ja": "ああ、もう" },
    { "t": [153.8, 155.7], "ja": "ああ、ジム" },
    { "t": [155.7, 157.8], "ja": "もし僕がここまでなら、ひとつ約束してくれ" },
    { "t": [158.8, 159.6], "ja": "ジム？" },
    { "t": [159.6, 160.8], "ja": "ダンディ賞の司会" },
    { "t": [164, 165], "ja": "やあ、カレン" },
    { "t": [167.6, 169.5], "ja": "えっと、ここで何してるの？" },
    { "t": [169.5, 171.6], "ja": "まずは、どうも" },
    { "t": [171.6, 173.3], "ja": "ここで何してるの？" },
    { "t": [173.3, 174.1], "ja": "元気？" },
    { "t": [175.9, 177.8], "ja": "ほかの支店の様子を見に来ただけだよ" },
    { "t": [177.8, 180.5], "ja": "マイケルにときどきやれって言われてるから" },
    { "t": [180.5, 184.4], "ja": "カレンに業務用コピー機のことは言うな" },
    { "t": [184.4, 185.2], "ja": "了解" },
    { "t": [186.5, 189.9], "ja": "あの人のことで何週間も泣いたの。だから、ええ" },
    { "t": [189.9, 191.6], "ja": "彼が小さな車からはい出てきて" },
    { "t": [191.6, 194.9], "ja": "しかも女性用の倉庫の制服姿なのを見て、かなりすっきりしたわ" },
    { "t": [194.9, 196.2], "ja": "最高の日ね" },
    { "t": [207.6, 208.6], "ja": "（音楽）" },
    { "t": [212.7, 214.8], "ja": "（音楽）" }
  ]
}
