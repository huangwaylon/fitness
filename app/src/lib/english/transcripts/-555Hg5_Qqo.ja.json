{
  "video": "-555Hg5_Qqo",
  "lines": [
    { "t": [0,2], "ja": "よし、いったぞ！" },
    { "t": [2,4], "ja": "いいね、すごくいい" },
    { "t": [4,5], "ja": "ナイス！" },
    { "t": [5,7], "ja": "よし、次の1枚はダリルだ" },
    { "t": [7,10], "ja": "セックスの最中に、ポケットの中の携帯で客に電話しちゃった件" },
    { "t": [10,14], "ja": "おお！　やるじゃないか、この野郎！" },
    { "t": [14,15], "ja": "まあ、ほら、何と言うか" },
    { "t": [15,17], "ja": "遊び人は遊ぶものさ" },
    { "t": [17,18], "ja": "ほらね" },
    { "t": [18,21], "ja": "実はあれ、俺がスパゲッティを食べてる音だったんだ" },
    { "t": [21,24], "ja": "でも、みんなにはそっちだと思わせておくよ" },
    { "t": [24,26], "ja": "よし、これは私がやる" },
    { "t": [26,28], "ja": "ああ、気をつけて、気をつけて、気をつけて！" },
    { "t": [28,30], "ja": "みんな、そっとだぞ" },
    { "t": [30,34], "ja": "誰も息もするなよ" },
    { "t": [38,40], "ja": "言っただろう？" },
    { "t": [40,43], "ja": "おい、おい、おい、ただの失敗だよ" },
    { "t": [43,44], "ja": "ただの失敗" },
    { "t": [44,46], "ja": "この塔はそういうものなんだ" },
    { "t": [46,47], "ja": "失敗のための塔" },
    { "t": [47,49], "ja": "いいか、へまをするのが怖いなら" },
    { "t": [49,50], "ja": "この塔は君には向いてない" },
    { "t": [50,54], "ja": "手を挙げてくれ。苦情を一度も受けたことがない人は？" },
    { "t": [54,55], "ja": "そうだろう" },
    { "t": [55,56], "ja": "誰もいない" },
    { "t": [56,57], "ja": "ほらな？" },
    { "t": [57,58], "ja": "誰も" },
    { "t": [58,59], "ja": "いいな？" },
    { "t": [59,61], "ja": "さあ、仕事に戻ろう" },
    { "t": [61,63], "ja": "ほら、やるか？" },
    { "t": [63,64], "ja": "うん" },
    { "t": [64,65], "ja": "よし" },
    { "t": [65,67], "ja": "よし、やろう" },
    { "t": [67,69], "ja": "よし、見てくれ" },
    { "t": [69,70], "ja": "やった！" },
    { "t": [70,73], "ja": "灰の中からよみがえる不死鳥みたいだ" },
    { "t": [73,74], "ja": "ナイス！" },
    { "t": [74,78], "ja": "もうすぐ天井まで届くぞ" },
    { "t": [78,79], "ja": "えっと、カードを1枚取ってくれる？" },
    { "t": [79,80], "ja": "あの、もうないよ" },
    { "t": [80,81], "ja": "何？" },
    { "t": [81,82], "ja": "何？" },
    { "t": [82,83], "ja": "いいじゃん、白紙のカードを使えば" },
    { "t": [83,84], "ja": "だめ！" },
    { "t": [84,85], "ja": "それは全部ずるだよ" },
    { "t": [85,86], "ja": "私が苦情を取ってこられるかも" },
    { "t": [86,87], "ja": "君が？" },
    { "t": [87,88], "ja": "お上品なお嬢さんが？" },
    { "t": [88,89], "ja": "君はチョウチョにだって失礼なことできないだろ" },
    { "t": [89,90], "ja": "ええ、できない" },
    { "t": [90,91], "ja": "そんな気持ち、想像もつかない" },
    { "t": [91,96], "ja": "君が？　お上品なお嬢さんが？　君はチョウチョにだって失礼なことできないだろ" },
    { "t": [96,103], "ja": "ええ、できない。そんな気持ち、想像もつかない。でも、お客さんの苦情なら取ってこられると思う。やってみたいの" },
    { "t": [103,107], "ja": "おお。いいぞ！　いいぞ、行け、パム！" },
    { "t": [107,117.3], "ja": "パム、パム、パム、パム、パム、パム、パム、パム、パム、パム、パム、パム、パム、パム、パム、パム" },
    { "t": [117.3,122.6], "ja": "よし、取引先はヘイモント・ブリッケンタイア。家族経営だけど、だからって手を抜くなよ" },
    { "t": [122.8,126.2], "ja": "ほら、パム、君ならしくじれる。君の中に失敗が見えるぞ" },
    { "t": [126.6,129.8], "ja": "いいか、君はクズなんだ。だから、こういうクズみたいなことを考えるんだ" },
    { "t": [132.5,138.9], "ja": "もしもし、パム・ハルパートです。ダンダー・ミフリンからお電話しています。ええ、紙の会社です" },
    { "t": [139.2,146.3], "ja": "お電話したのは、言いたいことがあって。あなたのママは太りすぎて、赤い服を着るとみんなが「おっ、クールエイド」って叫ぶんですって" },
    { "t": [146.7,149.5], "ja": "そう、あなたのママは太ってる。パム・ハルパートでした" },
    { "t": [150.8,152.6], "ja": "信じてもらえた？　何か言われた？" },
    { "t": [152.6,154.5], "ja": "何て言ってた？　分からない。なんとなく…" },
    { "t": [154.5,157.3], "ja": "怒ってた？　少なくとも、戸惑ってたみたい" },
    { "t": [157.4,157.6], "ja": "そう" },
    { "t": [160.6,165.5], "ja": "ダンダー・ミフリン、エリンです" },
    { "t": [166.5,167.4], "ja": "はい、どうぞ" },
    { "t": [168.8,169.2], "ja": "はい" },
    { "t": [170.5,171.9], "ja": "必ず記録に残しておきます" },
    { "t": [173.6,176.4], "ja": "みなさん、取引先をひとつ失いました！" },
    { "t": [176.4,178.4], "ja": "おお、すげえ！" },
    { "t": [179,180.4], "ja": "いいぞ！　さあ！" },
    { "t": [181.2,182.6], "ja": "じゃあな、ヘイモント" },
    { "t": [183.2,183.7], "ja": "いや" }
  ]
}
