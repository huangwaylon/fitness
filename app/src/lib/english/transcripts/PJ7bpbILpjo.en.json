{"video":"PJ7bpbILpjo","lines":[{"t":[0.5,0.9],"en":"Hey!"},{"t":[2,3.1],"en":"Is the show still on?"},{"t":[3.4,4.3],"en":"Almost over, man."},{"t":[4.9,5.6],"en":"Hey, Noni."},{"t":[6,6.5],"en":"Oh, go."},{"t":[6.6,7.5],"en":"Is that the poet?"},{"t":[7.7,7.9],"en":"Hey."},{"t":[11.1,12],"en":"Why am I looking?"},{"t":[13.5,14.5],"en":"Oh, Noni, here I am."},{"t":[14.6,15.3],"en":"Look, this is my big scene."},{"t":[16.4,17.4],"en":"All right, back off."},{"t":[20.2,21.1],"en":"I got a gun."},{"t":[22.5,23.8],"en":"I'm not afraid to use it."},{"t":[24.3,25.3],"en":"Oh, Joey!"},{"t":[25.6,26.7],"en":"That's right, Noni."},{"t":[27,28.5],"en":"You couldn't have at least changed your shirt."},{"t":[30,34.5],"en":"Now, I want a suitcase filled with $100,000."},{"t":[37.7,40.3],"en":"Filled with $100,000 in small bills."},{"t":[40.7,44.4],"en":"And if I don't get it, and if I don't get it,"},{"t":[46.7,48.2],"en":"I'm going to shoot this duck."},{"t":[49,49.7],"en":"Oh, no."},{"t":[51.6,52.8],"en":"I'm coming out."},{"t":[60,63.3],"en":"Was she supposed to buy this?"},{"t":[63.5,65.1],"en":"Joey, bravo!"},{"t":[65.4,66.1],"en":"Bellissimo!"},{"t":[66.6,67.4],"en":"Oh, ho, ho!"},{"t":[67.7,70.5],"en":"Ground control to Major Tom."},{"t":[72.7,74.2],"en":"Commencing countdown."},{"t":[75,75.8],"en":"Engines."},{"t":[77.5,78],"en":"On."},{"t":[84.8,87.1],"en":"That's, uh, scenes from next week's show."},{"t":[87.2,87.8],"en":"Next week."}]}
