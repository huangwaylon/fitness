  "lines": [
    { "t": [1, 2], "ja": "やあ、みんな" },
    { "t": [2.1, 4.4], "ja": "テニスしてたの？－ああ、でも負けた" },
    { "t": [4.5, 6], "ja": "上手になってきたと思ってたのに。－なってるよ" },
    { "t": [6.1, 8.6], "ja": "でも、ラケットを自分で作ったんだ" },
    { "t": [8.7, 11.7], "ja": "それで日なたに出したら、たぶん熱で…" },
    { "t": [17.2, 20], "ja": "それは、えっと、かなり恥ずかしいね" },
    { "t": [22.4, 25.8], "ja": "ねえ、テニスしたなら、友だちと一緒だったんでしょ？" },
    { "t": [25.9, 27.9], "ja": "もちろん、なんで？－入力の準備して" },
    { "t": [28.5, 30.6], "ja": "えっと、どの友だち？" },
    { "t": [32.1, 33.1], "ja": "ライアン" },
    { "t": [34.7, 36.8], "ja": "ねえ、トイレ借りてもいい？" },
    { "t": [36.9, 38.9], "ja": "いいよ、上がって右だ。－どうも" },
    { "t": [42, 44.1], "ja": "あの子、4年生？－3年生" },
    { "t": [45.7, 48.6], "ja": "ああ、ふにゃふにゃのラケットを直さなきゃ！" },
    { "t": [51.8, 54.2], "ja": "よし、スペンサーに同い年くらいの友だちを見つけてあげなきゃ" },
    { "t": [54.3, 55.5], "ja": "絶対ね。－うん" },
    { "t": [58, 59.6], "ja": "ねえ、あの人どう思う？" },
    { "t": [63.8, 64.8], "ja": "スペンサーの友だちになれそう" },
    { "t": [64.9, 65.9], "ja": "ちょうどいい年。－一人？" },
    { "t": [66, 67.2], "ja": "バカすぎず、賢すぎずって感じ" },
    { "t": [67.3, 68.1], "ja": "声をかけよう。－行くよ" },
    { "t": [70.3, 71.5], "ja": "え？" },
    { "t": [71.6, 84.5], "ja": "え？－名前は？" },
    { "t": [84.6, 86.2], "ja": "ああ、ダーネル" },
    { "t": [86.3, 88.1], "ja": "じゃあ、どうも、ダーネル" },
    { "t": [91, 91.9], "ja": "カーリーは何て？" },
    { "t": [92, 94.6], "ja": "スペンサーの最初の友だちが見つかったって。ダーネルっていう人" },
    { "t": [94.7, 97.6], "ja": "ああ、前にダーネルっていうやつを知ってたよ" },
    { "t": [100.5, 101.3], "ja": "それで？" },
    { "t": [101.4, 103.9], "ja": "いや、どの話も面白くなきゃいけないわけじゃないだろ" },
    { "t": [106.1, 107.6], "ja": "じゃあ、もう一人探してみよう" },
    { "t": [107.7, 108.5], "ja": "うん" },
    { "t": [108.6, 110], "ja": "スペンサーにかっこいい友だちを" },
    { "t": [111, 112], "ja": "あの人よさそう" },
    { "t": [112.1, 113.4], "ja": "うん。－あの、すみません" },
    { "t": [113.5, 117.7], "ja": "ええ、すみません。－何か用？" },
    { "t": [117.8, 132.4], "ja": "この人を見て。－ねえ、この人と友だちになりたくない？" },
    { "t": [135.9, 137.2], "ja": "なりたいでしょ" },
    { "t": [137.3, 140.2], "ja": "よう、よう、よう、ボウリングに行く準備はできた？" },
    { "t": [140.3, 142.2], "ja": "本当はボウリングには行かないの" },
    { "t": [142.3, 143.3], "ja": "ああ" },
    { "t": [144.8, 145.9], "ja": "じゃあ、何するの？" },
    { "t": [146, 148.2], "ja": "何もしないよ" },
    { "t": [149.2, 152], "ja": "友だちと夕食に行くの" },
    { "t": [156, 157.1], "ja": "さあ、本番" },
    { "t": [157.2, 160.6], "ja": "スペンサー、この人たちが新しい友だちよ" },
    { "t": [164.2, 166.3], "ja": "あ、やあ" },
    { "t": [167.3, 170.4], "ja": "えっと、パクチーを持ってきたよ" },
    { "t": [178.6, 179.6], "ja": "はい、チリフライ" },
    { "t": [179.7, 180.7], "ja": "やっとかよ。－マジで？" },
    { "t": [180.8, 182.5], "ja": "うわ、おいしそう" },
    { "t": [182.6, 183.5], "ja": "あっ！" },
    { "t": [183.6, 184.4], "ja": "何するんだよ？" },
    { "t": [184.5, 185.8], "ja": "チリフライはいらないって言ったじゃないか" },
    { "t": [185.9, 188.3], "ja": "ああ、ナチョスが同時に来ると思ったからさ" },
    { "t": [188.4, 189.5], "ja": "気が変わったなんて言わせないぞ" },
    { "t": [189.6, 190.7], "ja": "これは俺たちのだ" },
    { "t": [191.7, 196.8], "ja": "君たち、意地悪で退屈だな" },
    { "t": [197.3, 200.1], "ja": "まあ、お前は子どもっぽいな。－違うよ！" },
    { "t": [204.1, 206.5], "ja": "うーん、うまいチリフライだ" },
    { "t": [206.6, 208.1], "ja": "カーリー！" },
    { "t": [211.5, 212.4], "ja": "何？" },
    { "t": [212.5, 213.9], "ja": "あいつら、好きじゃない" },
    { "t": [214, 216.1], "ja": "ちょっとチャンスをあげて…－いやだ！" },
    { "t": [216.2, 220.2], "ja": "つまらなくて楽しくないし、政治とか税金とか演劇の話ばっかりで" },
    { "t": [220.3, 225.1], "ja": "大嫌いだ！－でも、同い年くらいの友だちが必要でしょ" },
    { "t": [225.2, 226.1], "ja": "必要ない！" },
    { "t": [228, 229.4], "ja": "ああ、おいで" },
    { "t": [229.5, 231.2], "ja": "おいで、よしよし" },
    { "t": [232.2, 233.2], "ja": "大丈夫" },
    { "t": [233.3, 235.1], "ja": "大丈夫だよ。－うん" },
    { "t": [237.3, 248.4], "ja": "うそ、うそ。アイカーリーだ。アイカーリーだ。こんにちは、こんにちは" },
    { "t": [248.5, 250.2], "ja": "大好き。－こんにちは" },
    { "t": [250.3, 251.5], "ja": "大好き。世界一のファンなの" },
    { "t": [251.6, 253], "ja": "カルロスです。－うそ" },
    { "t": [253.1, 254.4], "ja": "はじめまして。－写真撮りたい" },
    { "t": [254.5, 255.7], "ja": "写真撮りたい、写真撮りたい。－わあ" },
    { "t": [255.8, 257.2], "ja": "写真撮りたい。こんにちは、こんにちは。－うそでしょ" },
    { "t": [257.3, 258.2], "ja": "笑って" },
    { "t": [258.3, 259.9], "ja": "ああ、私の子たち。－あなたが一番好き、笑って" },
    { "t": [260, 262], "ja": "オーケー。－こんにちは、こんにちは" },
    { "t": [262.1, 263.4], "ja": "こんにちは。－こんにちは。アプリに映ってるよ" },
    { "t": [264.7, 266.6], "ja": "うそ。会いたかったの。笑って" },
    { "t": [269.9, 270.9], "ja": "ギビーはどこ？" },
    { "t": [271, 274.8], "ja": "ああ、男子トイレにいる。－うそ。ギビー！" },
    { "t": [276.2, 277.2], "ja": "ギビー！" },
    { "t": [282.1, 283.6], "ja": "うそ、ミートボール！－オーケー" },
    { "t": [284.7, 285.7], "ja": "それ、やるよ" },
    { "t": [287.7, 289.7], "ja": "よし、ギビー。ギビーに触っちゃった" },
    { "t": [289.8, 291.3], "ja": "うそ。－うそでしょ" },
    { "t": [295.2, 297], "ja": "だめ、だめ、だめ" },
    { "t": [297.1, 298.9], "ja": "大好き、もう" }
