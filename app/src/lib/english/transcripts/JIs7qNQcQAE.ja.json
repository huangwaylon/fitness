{
  "video": "JIs7qNQcQAE",
  "lines": [
    { "t": [0, 3], "ja": "ドワイト、やっと来てくれたのか？" },
    { "t": [3, 5.4], "ja": "ありがとう" },
    { "t": [5.4, 7.5], "ja": "やあ、ドワイト、遅刻のソースを取って" },
    { "t": [7.5, 8.7], "ja": "分かる、マイケル？ああ" },
    { "t": [8.7, 9.9], "ja": "よし" },
    { "t": [9.9, 12.5], "ja": "これがドリームチームだ" },
    { "t": [12.5, 14.5], "ja": "私の営業ドリームチーム" },
    { "t": [14.5, 16.7], "ja": "今日は、二人一組で営業回りをする" },
    { "t": [16.7, 20], "ja": "アンディ、これは君のアイデアだから、最初に選んでいいぞ" },
    { "t": [20, 24.6], "ja": "うーん。まあ、ちょっと考えさせてください" },
    { "t": [24.6, 26.7], "ja": "ああ、どうしようかな" },
    { "t": [26.7, 31.6], "ja": "マイケル・スコット、博士、営業学博士" },
    { "t": [31.6, 33.8], "ja": "いやあ、ありがとう。とてもありがたいよ" },
    { "t": [33.8, 36], "ja": "いえ、引き受けてくださって、とてもありがたいです" },
    { "t": [36, 38.5], "ja": "いや、ありがとう" },
    { "t": [38.5, 41.6], "ja": "よし。次は年功序列で行く" },
    { "t": [41.6, 43.4], "ja": "フィリス、うちの最年長だ" },
    { "t": [43.4, 46.1], "ja": "私たち、同い年でしょ" },
    { "t": [46.1, 49], "ja": "じゃあ、カレンを選ぶわ" },
    { "t": [49, 50.8], "ja": "あ、えっと、ありがとう" },
    { "t": [50.8, 52.3], "ja": "よし" },
    { "t": [52.3, 55.6], "ja": "次は、超イケてる男、スタンリー" },
    { "t": [55.6, 56.5], "ja": "パス" },
    { "t": [56.5, 58.5], "ja": "パスはできないぞ。誰か選ばないと" },
    { "t": [62.5, 64.1], "ja": "じゃあ、その若いのにする" },
    { "t": [64.1, 66.5], "ja": "すごく光栄です" },
    { "t": [66.5, 69.5], "ja": "「パス」の次の2番目の候補でしたけど" },
    { "t": [69.5, 72.4], "ja": "これで、残りはドワイトとジムだけだ" },
    { "t": [72.4, 74.3], "ja": "よし、待って。誰か交換したい人いる？" },
    { "t": [74.3, 75.9], "ja": "ああ。交換" },
    { "t": [75.9, 79], "ja": "ドワイトと僕は、昔よく一緒に営業回りをしてたんだ" },
    { "t": [79, 82.1], "ja": "実は、その時を思い出せる写真もある" },
    { "t": [82.1, 88], "ja": "ああ、若きジムよ、警告しておきたいことが山ほどある" },
    { "t": [88, 92.7], "ja": "だが、悲しいことに、それはできない" },
    { "t": [92.7, 95.8], "ja": "クライスラーのセブリングだ" },
    { "t": [95.8, 98.5], "ja": "すごい自動車だぞ" },
    { "t": [98.5, 99.3], "ja": "ドワイト！" },
    { "t": [99.3, 101.3], "ja": "ああ。はい、どうぞ！" },
    { "t": [101.3, 102.6], "ja": "よし！" },
    { "t": [102.6, 103.7], "ja": "シャツはハンガーにかけておく？" },
    { "t": [103.7, 104.7], "ja": "頼む" },
    { "t": [104.7, 106.4], "ja": "誰が洗濯してるの？" },
    { "t": [106.4, 108.2], "ja": "話せば長い" },
    { "t": [108.2, 110.7], "ja": "よし、みんな、集まって" },
    { "t": [110.7, 112.2], "ja": "始めるぞ" },
    { "t": [112.2, 113.7], "ja": "これが何か分かるな" },
    { "t": [113.7, 115.5], "ja": "これは「アメージング・レース」だ" },
    { "t": [115.5, 117.4], "ja": "君たちは退役した海兵隊員" },
    { "t": [117.4, 119.7], "ja": "君たちは母と娘" },
    { "t": [119.7, 122.2], "ja": "君たちはゲイのカップル" },
    { "t": [122.2, 124.6], "ja": "そして私たちは、ヒーローの消防士だ" },
    { "t": [124.6, 125.6], "ja": "準備はいいか？" },
    { "t": [125.6, 129.1], "ja": "待って。「アメージング・レース」って、一番たくさん売った人が勝ちってこと？" },
    { "t": [129.1, 130.7], "ja": "いや。急いで出かけて" },
    { "t": [130.7, 132], "ja": "営業をして、戻ってくるだけだ" },
    { "t": [132, 132.8], "ja": "賞品はあるの？" },
    { "t": [132.8, 134], "ja": "自慢できるってだけだ" },
    { "t": [134, 135.6], "ja": "じゃあ、どこが「アメージング・レース」なの？" },
    { "t": [135.6, 137.8], "ja": "それは、ただ…" },
    { "t": [137.8, 140.2], "ja": "「アメージング・レース」なんだよ、フィリス。いいか？" },
    { "t": [140.2, 142.7], "ja": "二人一組で、任務があるんだ" },
    { "t": [142.7, 143.7], "ja": "よし" },
    { "t": [143.7, 145.8], "ja": "じゃあ、位置について、用意、スタート！" },
    { "t": [145.8, 147.6], "ja": "行こう！ほら！" },
    { "t": [152.6, 154.2], "ja": "マイケル。おっと、おっと" },
    { "t": [154.2, 156.3], "ja": "おほほほほ！" },
    { "t": [156.3, 158.8], "ja": "行くぞ！いいね" },
    { "t": [158.8, 161.3], "ja": "棒はある？" },
    { "t": [161.3, 162.9], "ja": "ほうきを取りに行こう" },
    { "t": [162.9, 164], "ja": "本気？" },
    { "t": [164, 165.4], "ja": "後ろに座るの？" },
    { "t": [165.4, 166.6], "ja": "ああ、そうだ" },
    { "t": [166.6, 168.3], "ja": "車の中で一番安全な場所だからな" },
    { "t": [168.3, 169.3], "ja": "事故が起きたら" },
    { "t": [169.3, 172.4], "ja": "運転手はいつも、まず自分の側を守るものだ" },
    { "t": [172.4, 172.8], "ja": "うわあ！" },
    { "t": [183.8, 185.8], "ja": "よく分からない" }
