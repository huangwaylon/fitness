{
  "video": "TADOKwgIHKA",
  "lines": [
    { "t": [1, 3.3], "ja": "やあ、ジミー、調子はどう？" },
    { "t": [4.2, 5.1], "ja": "別に" },
    { "t": [5.1, 7.1], "ja": "いいね、すごくいいね" },
    { "t": [7.1, 9.8], "ja": "君がその気になれば、このオフィスで一番立派なひげを" },
    { "t": [9.8, 11.7], "ja": "生やせるんじゃないかな" },
    { "t": [11.7, 13], "ja": "ありがとう、ドワイト" },
    { "t": [13, 14.5], "ja": "その笑い声、つられちゃうな" },
    { "t": [14.5, 16.8], "ja": "ちょっと気味が悪いから、行くよ" },
    { "t": [16.8, 19.1], "ja": "今言ったことは、どれも本気じゃない" },
    { "t": [19.1, 21.8], "ja": "それに、オフィスのみんなから同じことをされると思っておけ" },
    { "t": [21.8, 23.6], "ja": "もし、この月間優秀社員の件を" },
    { "t": [23.6, 26.1], "ja": "早いうちにつぶしておかないとな" },
    { "t": [26.1, 28.5], "ja": "仕事の中身で決めろ" },
    { "t": [28.5, 30], "ja": "つまり、自分が取るべきだと思ってるんだね" },
    { "t": [30, 34], "ja": "これには、手に入るデータが全部入ってる" },
    { "t": [34, 38.5], "ja": "勤務時間、遅刻、確認できない病欠、参加度" },
    { "t": [38.5, 41.1], "ja": "全員にランダムな番号を割り当てた" },
    { "t": [41.1, 44.1], "ja": "公平さと透明性のためにな" },
    { "t": [44.1, 47.1], "ja": "それに、これには賞金もつけるべきだ" },
    { "t": [47.1, 48.3], "ja": "まあ、理想の世界なら…" },
    { "t": [48.3, 49.8], "ja": "理想の世界なら、10本全部の指が" },
    { "t": [49.8, 51.3], "ja": "左手にあって、右手は" },
    { "t": [51.3, 52.7], "ja": "ただ殴るためのこぶしになっていればいい" },
    { "t": [52.7, 54.1], "ja": "えっと、もしよければ" },
    { "t": [54.1, 57], "ja": "サバイバルの技術と護身術は外しておくよ" },
    { "t": [57, 59.4], "ja": "これをトビーと経理に見せて" },
    { "t": [59.4, 60.8], "ja": "データをまとめてもらうよ" },
    { "t": [60.8, 61.8], "ja": "大丈夫" },
    { "t": [61.8, 62.7], "ja": "私がやる" },
    { "t": [66.7, 68], "ja": "やあ" },
    { "t": [68, 70.8], "ja": "それで、ジムが、みんなで出し合えたら理想的だって…" },
    { "t": [70.8, 72.8], "ja": "おい！" },
    { "t": [72.8, 74.3], "ja": "それで、ジムが理想的だと思ってるのは" },
    { "t": [74.3, 76.1], "ja": "みんなで20ドルずつ出し合うことなんだ" },
    { "t": [76.1, 78.4], "ja": "この月間優秀社員のためにね" },
    { "t": [78.4, 79.7], "ja": "ジムがそう言ったの？" },
    { "t": [79.7, 80.3], "ja": "彼は、先月君が" },
    { "t": [80.3, 82.7], "ja": "すばらしい仕事をしたって思ってたよ" },
    { "t": [82.7, 84.5], "ja": "ジムがそう言ったの？" },
    { "t": [84.5, 85.9], "ja": "驚いてるみたいだね" },
    { "t": [85.9, 88], "ja": "いや、いや、すごく納得" },
    { "t": [92.8, 93.8], "ja": "やあ、相棒" },
    { "t": [95, 95.8], "ja": "それで、みんな…" },
    { "t": [98.7, 100.2], "ja": "予定より5分早い" },
    { "t": [101.2, 102.8], "ja": "ちょうど予定通り" },
    { "t": [102.8, 104.9], "ja": "さあ、皆さん、ようこそ" },
    { "t": [104.9, 106], "ja": "みんなすごくわくわくしてると思うが" },
    { "t": [106, 108.3], "ja": "誰が選ばれても" },
    { "t": [108.3, 109.7], "ja": "これだけは言いたい。君たちはみんな" },
    { "t": [109.7, 111.2], "ja": "私の目には月間優秀社員だった" },
    { "t": [111.2, 116.6], "ja": "そして優勝者は、9番の社員" },
    { "t": [116.6, 118.3], "ja": "それは誰？" },
    { "t": [118.3, 122.3], "ja": "9番、9番、ジム・ハルパート" },
    { "t": [122.3, 123.1], "ja": "何？" },
    { "t": [123.1, 123.8], "ja": "何？" },
    { "t": [123.8, 124.4], "ja": "冗談でしょ？" },
    { "t": [124.4, 125.6], "ja": "うわ" },
    { "t": [125.6, 126.8], "ja": "ちょっと待って" },
    { "t": [126.8, 130.2], "ja": "僕は、僕はしてない" },
    { "t": [130.2, 135.2], "ja": "してないよ、それは、なんで…" },
    { "t": [135.2, 138.3], "ja": "みんな、聞いて。これは匿名だったんだ、いい？" },
    { "t": [138.3, 140.1], "ja": "自分に賞をあげるなんてできるわけないよ" },
    { "t": [140.1, 142.5], "ja": "誰が載ってるかも知らなかったんだから" },
    { "t": [142.5, 143.4], "ja": "一番総合点が高い社員に" },
    { "t": [143.4, 144.5], "ja": "賞をあげただけなんだ" },
    { "t": [144.5, 147.6], "ja": "私の計算だと、君は自分の駐車場所を取り戻して" },
    { "t": [147.6, 149.7], "ja": "休暇を1日と、みんなから、きっかり" },
    { "t": [149.7, 151.5], "ja": "250ドルを手に入れたことになる" },
    { "t": [151.5, 152.8], "ja": "みんな、ちょっと待って" },
    { "t": [152.8, 154.6], "ja": "だって、もちろん僕はどれも受け取らないから" },
    { "t": [154.6, 156.6], "ja": "何か間違いがあったんだ。何とかするよ" },
    { "t": [156.6, 158.5], "ja": "次に、賞金なんてなかったはずだ" },
    { "t": [158.5, 159.5], "ja": "そうだ！" },
    { "t": [159.5, 160.3], "ja": "ドワイト？" },
    { "t": [160.3, 161.7], "ja": "ああ、理想の世界なら" },
    { "t": [161.7, 163.3], "ja": "賞金があるって、君が言ったんだろ？" },
    { "t": [163.3, 165.9], "ja": "違うよ、ドワイト、僕が言ったのは、そう、完璧な世界なら" },
    { "t": [165.9, 167], "ja": "誰かがお金をもらえるけど、でも…" },
    { "t": [167, 170.9], "ja": "ええ、でもあなたの完璧な世界では、お金をもらえるのはあなただけなのね" },
    { "t": [170.9, 173], "ja": "いいか、明らかに大きな間違いがあったから" },
    { "t": [173, 175.9], "ja": "僕が直すよ、いいね？" },
    { "t": [175.9, 177.2], "ja": "どうせ、これはあなたのアイデアだったんだし" },
    { "t": [177.2, 179.4], "ja": "訂正、私のアイデアだ" },
    { "t": [180.8, 181.6], "ja": "いい？" },
    { "t": [181.6, 183], "ja": "私のアイデアだ" },
    { "t": [183, 185.7], "ja": "みんな、パムは本当は妊娠してないんじゃないかって思えてきた" },
    { "t": [185.7, 188.7], "ja": "はい、念のため言っておくけど、私は妊娠してるから" },
    { "t": [188.7, 191.5], "ja": "それに、明らかに何かの間違いがあったんだから" },
    { "t": [191.5, 194.6], "ja": "ジムがリストで次に点数が高い人を選んで" },
    { "t": [194.6, 196.8], "ja": "それで終わりにしたら？" },
    { "t": [196.8, 197.6], "ja": "ああ、いいよ" },
    { "t": [197.6, 198.6], "ja": "それなら公平だ" },
    { "t": [198.6, 199.6], "ja": "すばらしいアイデアだ、パム" },
    { "t": [199.6, 200.6], "ja": "ありがとう" },
    { "t": [200.6, 203.3], "ja": "次は3番の社員だ" },
    { "t": [203.3, 208.5], "ja": "それは、なんてこった、パム・ハルパート" },
    { "t": [208.5, 210.1], "ja": "何？" },
    { "t": [210.1, 212], "ja": "どうしてそんなことがありえるの？" },
    { "t": [212, 215.1], "ja": "悪気はないけど、パム、いったいどうしてそんなことがありえるのよ？" },
    { "t": [215.1, 218.5], "ja": "何か納得のいく理由があるはずだ" },
    { "t": [218.5, 219.9], "ja": "ちょっと待って、おいおい" },
    { "t": [219.9, 222.2], "ja": "私は一日も休まなかったし、早く来て" },
    { "t": [222.2, 225.2], "ja": "遅くまで残って、先月は売り上げを倍にしたのに" },
    { "t": [225.2, 227.3], "ja": "へえ、本当？何から何に？2から4？" },
    { "t": [227.3, 228.1], "ja": "そうだ" }
  ]
}
