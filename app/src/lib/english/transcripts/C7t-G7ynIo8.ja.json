{
  "video": "C7t-G7ynIo8",
  "lines": [
    { "t": [0, 1], "ja": "もしもし？" },
    { "t": [1, 2.9], "ja": "フィリップ・ヘラーズ、調子はどう？" },
    { "t": [2.9, 4.1], "ja": "マイケル。左寄り？" },
    { "t": [4.1, 5.1], "ja": "マイケル。右寄り？" },
    { "t": [5.1, 6.5], "ja": "あのさ、僕は…わかった" },
    { "t": [6.5, 8.1], "ja": "世間話はこれくらいにして、どうぞ" },
    { "t": [8.1, 9.5], "ja": "電話してきたのはそっちでしょ" },
    { "t": [9.5, 11.4], "ja": "そうだ。聞いてくれ" },
    { "t": [11.4, 14.6], "ja": "えっと、こんなふうにスタンリーを家族から引き離すなんてだめだ" },
    { "t": [14.6, 17.1], "ja": "家族も一緒に来ると思うけど" },
    { "t": [17.1, 18.5], "ja": "違う、職場の家族だよ" },
    { "t": [18.5, 20.5], "ja": "いいか、これは僕にとってすごくつらいけど" },
    { "t": [20.5, 22.6], "ja": "うちで一番の男をあげよう" },
    { "t": [22.6, 24.2], "ja": "トビーを持っていっていい" },
    { "t": [24.2, 25.9], "ja": "トビーは営業じゃないでしょ" },
    { "t": [25.9, 27], "ja": "教えればいいさ" },
    { "t": [27, 29.6], "ja": "すごく、すごく頭がよくて面白くて" },
    { "t": [29.6, 31.2], "ja": "魅力的なんだ" },
    { "t": [31.2, 34.7], "ja": "ああ、やっぱり無理だ" },
    { "t": [34.7, 37.4], "ja": "トビーは最悪だ。今のははったりだ" },
    { "t": [37.4, 41.4], "ja": "えっと、いいか、そっちがうちの社員を引き抜くなら" },
    { "t": [41.4, 43.1], "ja": "こっちもそっちの社員を引き抜くぞ" },
    { "t": [43.1, 45.5], "ja": "へえ。じゃあね、マイケル" },
    { "t": [45.5, 47.4], "ja": "わかった、じゃあね。待って、待って" },
    { "t": [47.4, 49.3], "ja": "カレン、そっちの営業の人に" },
    { "t": [49.3, 50.9], "ja": "電話をつないでもらえる？" },
    { "t": [50.9, 52.2], "ja": "一番優秀な人に" },
    { "t": [55.2, 56.7], "ja": "ベン・ニュージェントにおつなぎしました" },
    { "t": [56.7, 59.1], "ja": "ユーティカ支店のトップ営業です" },
    { "t": [59.1, 60.3], "ja": "やあ、ベン。マイケル・スコットだ" },
    { "t": [60.3, 60.7], "ja": "どうも、マイケル" },
    { "t": [60.7, 62.8], "ja": "単刀直入に言うよ" },
    { "t": [62.8, 64.3], "ja": "魔法は好き？" },
    { "t": [64.3, 66.8], "ja": "僕は瓶の中の魔人で" },
    { "t": [66.8, 69], "ja": "君の願いを3つかなえてあげる" },
    { "t": [69, 70.7], "ja": "スクラントンに引っ越すこと" },
    { "t": [70.7, 72.5], "ja": "すばらしい仕事につくこと" },
    { "t": [72.5, 74], "ja": "そして僕の親友になること" },
    { "t": [74, 76.8], "ja": "あなた、女の人を車ではねた人じゃないですか？" },
    { "t": [76.8, 79], "ja": "おっと。うそだろ" },
    { "t": [79, 83.2], "ja": "あー、うん、彼女の命も救ったんだけど" },
    { "t": [83.2, 85.7], "ja": "そっちはあまり話題にならないみたいだね" },
    { "t": [85.7, 88.4], "ja": "それにみんな、スクラントン支店はカムデンよりひどいって言ってますよ" },
    { "t": [88.4, 91.5], "ja": "スタンフォード支店から来た人たち、すぐ全員辞めませんでした？" },
    { "t": [91.5, 93.6], "ja": "違う、僕がクビにしたんだ。次は君だ" },
    { "t": [97.3, 98.6], "ja": "で、どうする？" },
    { "t": [98.6, 100.2], "ja": "本気ですか？" },
    { "t": [100.2, 102.9], "ja": "あいつ、何を言ってるんだ？" },
    { "t": [102.9, 104.4], "ja": "スクラントンはダサくない" },
    { "t": [104.4, 107.1], "ja": "スクラントンはかっこよくて楽しい支店なんだ" },
    { "t": [107.1, 108.9], "ja": "映画の「アニマル・ハウス」みたいにね" },
    { "t": [108.9, 112.9], "ja": "…" },
    { "t": [112.9, 121.7], "ja": "…" }
  ]
}
