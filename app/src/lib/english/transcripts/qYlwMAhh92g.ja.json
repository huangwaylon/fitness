{
  "video": "qYlwMAhh92g",
  "lines": [
    { "t": [0,  2.9], "ja": "ねえ、包装紙ある？" },
    { "t": [2.9,  5.8], "ja": "あ、それって私の誕生日プレゼント用？" },
    { "t": [5.8,  8.5], "ja": "フィービー、君の誕生日って何か月も前だよ" },
    { "t": [8.5,  10.9], "ja": "そうだけど、特別なものを注文したって言ってたでしょ" },
    { "t": [10.9,  12.4], "ja": "それがまだ届いてないって" },
    { "t": [15.4,  18.8], "ja": "ああ、それなら今問い合わせ中なんだ" },
    { "t": [18.8,  19.7], "ja": "わかった" },
    { "t": [19.7,  21.6], "ja": "実はこれ、キャシーの誕生日用なんだ" },
    { "t": [21.6,  23.5], "ja": "彼女の大好きな本の、初期の版だよ" },
    { "t": [23.5,  25.9], "ja": "わあ、「ビロードのうさぎ」ね" },
    { "t": [25.9,  29.2], "ja": "すてき、男の子の愛でうさぎが本物になるところ" },
    { "t": [29.2,  30.3], "ja": "いいけど、触らないで" },
    { "t": [30.3,  32.2], "ja": "君の指の油は本を傷めるから" },
    { "t": [32.2,  36.4], "ja": "じゃあ、ロスの髪からは離しておいたほうがいいね" },
    { "t": [36.4,  41.2], "ja": "これってかなり珍しいよね。どうやって手に入れたの？" },
    { "t": [41.2,  42.2], "ja": "いや、大したことないよ" },
    { "t": [42.2,  43.6], "ja": "本屋を何軒か回って" },
    { "t": [43.6,  45.3], "ja": "古書の業者何人かと話して" },
    { "t": [45.3,  47.5], "ja": "作者の孫の何人かに電話しただけ" },
    { "t": [47.5,  50.8], "ja": "まあ、なんて優しいの" },
    { "t": [50.8,  52.2], "ja": "うん、それに、最高の伝え方だよね" },
    { "t": [52.2,  54.3], "ja": "「ルームメイトの彼女が、ひそかに好きだ」ってね" },
    { "t": [54.3,  58.3], "ja": "そんな意味じゃないよ" },
    { "t": [58.3,  60.3], "ja": "…そういう意味になる？" },
    { "t": [60.3,  61.6], "ja": "どう見えると思う？" },
    { "t": [61.6,  64], "ja": "あなたがすごく心のこもった" },
    { "t": [64,  65.2], "ja": "高価なものを贈って" },
    { "t": [65.2,  67.6], "ja": "彼氏のジョーイがオレンジを渡したら" }
  ]
}
