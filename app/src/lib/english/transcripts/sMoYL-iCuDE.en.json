{"video":"sMoYL-iCuDE","lines":[{"t":[0,3.6],"en":"You know, if-if anything else opens up, please, hello?"},{"t":[5.8,6.3],"en":"Hello?"},{"t":[22.8,23.9],"en":"Sorry, Rach."},{"t":[26,26.9],"en":"Where were we?"},{"t":[27.8,28.1],"en":"Oh!"},{"t":[28.5,29.6],"en":"Okay, five-card draw."},{"t":[30,32.2],"en":"Uh, jacks are better."},{"t":[33.2,34],"en":"Nothing wild."},{"t":[34,34.6],"en":"Everybody ante."},{"t":[35.4,37.7],"en":"Look, Rach, we don't have to do this."},{"t":[38.5,39.3],"en":"Yes, we do."},{"t":[42.3,43.5],"en":"All right, check."},{"t":[44.2,44.6],"en":"Check."},{"t":[45.3,46.3],"en":"I'm in for 50 cents."},{"t":[47.2,47.5],"en":"Call."},{"t":[48.2,48.9],"en":"I'm in."},{"t":[50.2,52.5],"en":"I see your 50 cents,"},{"t":[53.1,55.7],"en":"and I raise you..."},{"t":[55.7,56.6],"en":"five dollars."},{"t":[57.4,60],"en":"I thought it was a 50 cent limit."},{"t":[60.4,63],"en":"Well, I just lost a job and I'd like to raise the bed five bucks."},{"t":[63.6,64.6],"en":"Does anybody have a problem with that?"},{"t":[66.5,67.2],"en":"Not at all."},{"t":[67.2,68.4],"en":"Hold it right up. Hold it right up."}]}
