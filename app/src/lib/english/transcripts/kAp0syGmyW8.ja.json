{
  "video": "kAp0syGmyW8",
  "lines": [
    { "t": [0,  6.8], "ja": "子育てが大変だって、親がいつも文句を言うのがよく分からない" },
    { "t": [7.9,  11.1], "ja": "一緒にふざけて、ピザをあげて、お菓子をあげて" },
    { "t": [11.4,  14.1], "ja": "好きに生きさせればいい。大人なんだから、まったく" },
    { "t": [14.4,  19.1], "ja": "マイケル・ゲイリー・スコットの、ちょっと懐かしい映像をお見せしよう" },
    { "t": [19.1,  23.9], "ja": "子役スターだったころの、覚えてるかもしれない番組「ファンドル・バンドル」だ" },
    { "t": [24.2,  25.8], "ja": "では、前置きはこれくらいにして、ライアン" },
    { "t": [26.3,  28], "ja": "ファンドル、入ってくる準備はいい？" },
    { "t": [28,  31.1], "ja": "楽しく遊びましょう" },
    { "t": [31.3,  35.4], "ja": "あれがトゥルーディ先生。衣装じゃ分からないけど、すごいスタイルだったんだ" },
    { "t": [35.4,  36.6], "ja": "今日はとっても楽しいね？" },
    { "t": [36.6,  38.5], "ja": "よし、早送りしていいぞ" },
    { "t": [39.3,  40.9], "ja": "そして、みんなに…" },
    { "t": [40.9,  41.5], "ja": "あれ、本当に使えるメールアドレス？" },
    { "t": [41.5,  43.3], "ja": "止めて、止めて、止めて。ストップ" },
    { "t": [44.2,  45.4], "ja": "消防車ね、そう" },
    { "t": [45.5,  48.4], "ja": "そう、あれがエドワード・アール・ミャオだ" },
    { "t": [49.4,  50.2], "ja": "結構おもしろいね" },
    { "t": [51.5,  51.9], "ja": "はい" },
    { "t": [52.2,  52.7], "ja": "休み時間" },
    { "t": [53.5,  54.8], "ja": "ねえ、お名前は？" },
    { "t": [55.1,  55.9], "ja": "チェットです" },
    { "t": [56.4,  57.3], "ja": "あら、こんにちは、チェット" },
    { "t": [57.3,  58.3], "ja": "あれってチェット・モンゴメリー？" },
    { "t": [58.8,  60.1], "ja": "えーと、分からない" },
    { "t": [60.1,  60.7], "ja": "そうだよ！" },
    { "t": [60.7,  61.5], "ja": "僕の大好きな予報士だ" },
    { "t": [61.8,  63.3], "ja": "チェットは気象予報士なんだ" },
    { "t": [63.9,  65], "ja": "「チェットのお天気チェック」" },
    { "t": [65.2,  65.7], "ja": "「ドップラーレーダーは上々」" },
    { "t": [67.2,  69.8], "ja": "チェット、大きくなったら何になりたい？" },
    { "t": [70.5,  71.9], "ja": "テレビに出たい" },
    { "t": [72.7,  74.9], "ja": "そして今、彼はテレビに出てる" },
    { "t": [75,  76.8], "ja": "みんな、ちょっと黙ってくれないか？" },
    { "t": [77,  77.9], "ja": "見逃さないようにな" },
    { "t": [79.6,  80.7], "ja": "はい、次の子" },
    { "t": [81.2,  82.4], "ja": "じゃあ、お名前は？" },
    { "t": [82.5,  82.9], "ja": "これが僕だ" },
    { "t": [82.9,  84.4], "ja": "あら、こんにちは、マイケル" },
    { "t": [84.4,  85.1], "ja": "8歳です" },
    { "t": [85.7,  88.1], "ja": "じゃあ、学校で好きな科目は何？" },
    { "t": [89,  89.3], "ja": "休み時間" },
    { "t": [89.7,  90.3], "ja": "休み時間" },
    { "t": [91.1,  94.6], "ja": "じゃあ教えて、大きくなったら何になりたい？" },
    { "t": [94.9,  102], "ja": "結婚して子どもを100人つくりたい。そしたら友だちが100人できて、誰も僕と友だちになるのを断れないから" },
    { "t": [107.5,  111.3], "ja": "えー、そう、じゃあ、えー、話せてよかったよ、マイケル" },
    { "t": [111.5,  112.7], "ja": "トゥルーディ先生に戻しまーす" },
    { "t": [113.1,  113.8], "ja": "みんな、こんにちは" },
    { "t": [114.3,  115.9], "ja": "一日の中で、大好きな時間の一つよ" },
    { "t": [115.9,  116.4], "ja": "確か、あったはずなのに…" },
    { "t": [116.4,  117], "ja": "結婚したの？" },
    { "t": [117.1,  118.2], "ja": "そうよ、だから今日はお話を作りましょう" },
    { "t": [118.2,  118.8], "ja": "あー、いや" },
    { "t": [119.3,  119.7], "ja": "どうして？" },
    { "t": [120,  121.2], "ja": "あー、なんとなく、そうならなかった" },
    { "t": [122.4,  124.4], "ja": "じゃあ、子どもはいるの？" },
    { "t": [125,  125.7], "ja": "あー、いない" },
    { "t": [126.3,  127.1], "ja": "彼女はいるの？" },
    { "t": [127.5,  128.3], "ja": "まあ、それなりにね" },
    { "t": [128.4,  129.6], "ja": "チェット・モンゴメリーって、当時かっこよかった？" },
    { "t": [129.6,  129.7], "ja": "ああ" },
    { "t": [129.7,  130.8], "ja": "僕にだって彼女はいるよ" },
    { "t": [130.8,  132], "ja": "はい、分かった、分かった" },
    { "t": [132.5,  134.3], "ja": "つまり、なりたいものにはなれなかったんだね" },
    { "t": [136.7,  137.4], "ja": "そうみたいだね" },
    { "t": [140.5,  149], "ja": "あのね、仕事が山ほどあるから、このおいしいピザを一切れもらって、仕事をしに行くよ" },
