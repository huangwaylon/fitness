{"video":"lasJTERop7I","lines":[{"t":[1,2.8],"en":"Oh! Oh!"},{"t":[2.8,4.3],"en":"Excuse me, ma'am."},{"t":[4.3,5.3],"en":"Yes?"},{"t":[5.3,7.8],"en":"You can't put your cigarette out on a tree."},{"t":[7.8,9.3],"en":"Yeah, I can. It worked real well."},{"t":[9.3,11.8],"en":"No. No, but you shouldn't."},{"t":[11.8,13.8],"en":"So don't ever do that again."},{"t":[13.8,14.8],"en":"I won't."},{"t":[14.8,16.8],"en":"'Til I have my next cigarette."},{"t":[16.8,18.3],"en":"Hold it."},{"t":[18.3,20.3],"en":"NYPD freeze, punk."},{"t":[20.3,21.3],"en":"What?"},{"t":[21.3,23.3],"en":"Uh-huh. That's right."},{"t":[23.3,25.8],"en":"You are so busted."},{"t":[25.8,28.8],"en":"Uh, book 'em."},{"t":[28.8,30.1],"en":"Who are you talking to?"},{"t":[30.1,32.1],"en":"Save it, Red."},{"t":[32.1,34.1],"en":"Unless you want to spend a night in the slammer,"},{"t":[34.1,36.6],"en":"you apologize to the tree."},{"t":[36.6,39.6],"en":"I am not going to apologize to a tree."},{"t":[39.6,41.6],"en":"You apologize to the tree right now,"},{"t":[41.6,45.6],"en":"or I am calling for backup."},{"t":[45.6,47.6],"en":"Backup! Backup!"},{"t":[47.6,49.1],"en":"I'm sorry! Sorry!"},{"t":[49.1,51.6],"en":"Okay, cancel backup! Cancel backup!"},{"t":[51.6,62.1],"en":"I'll see you next time."}]}
