{"video":"orvkg918gbk","lines":[{"t":[0,2.1],"en":"I'm really glad you guys are okay."},{"t":[2.6,4.8],"en":"But I just keep thinking what would happen"},{"t":[4.8,6.9],"en":"if you two actually had hooked up."},{"t":[10.3,12],"en":"Honey, dinner's ready."},{"t":[18,20.4],"en":"What's my little chef got for me tonight?"},{"t":[20.7,21.8],"en":"Your favorite."},{"t":[23.2,24.7],"en":"Fried stuff with cheese."},{"t":[25.6,27.9],"en":"Yep. And lots of it."},{"t":[30,30.8],"en":"Thanks, sweetheart."},{"t":[31.8,32.6],"en":"You want to show you that?"},{"t":[33.3,33.8],"en":"Okay."},{"t":[35.3,36.1],"en":"You want to go?"},{"t":[36.3,37],"en":"Here we go."},{"t":[37.1,37.4],"en":"Here we go."},{"t":[41.5,44.9],"en":"How you doing?"},{"t":[60,90],"en":"Thank you."}]}
