{
  "video": "xwlNGHoOjKA",
  "lines": [
    { "t": [0,  4], "ja": "ドクター・ツナ、医師殿。悪い知らせがあります" },
    { "t": [4,  6], "ja": "待って、君は患者？ 医者？" },
    { "t": [6,  10], "ja": "職場全体が、たちの悪い「月曜病」にかかってしまったんです" },
    { "t": [10,  12], "ja": "へえ。助かる見込みはどれくらい？" },
    { "t": [12,  14], "ja": "ゼロパーセント" },
    { "t": [14,  18], "ja": "今すぐ、緊急の「やる気」移植手術をしない限りはね" },
    { "t": [18,  19], "ja": "大至急！" },
    { "t": [19,  20], "ja": "危なそうだな" },
    { "t": [20,  23], "ja": "ご心配なく。確実に効く治療法があります" },
    { "t": [23,  25], "ja": "月間優秀社員です" },
    { "t": [25,  27], "ja": "僕が働いた最高の職場には、どこにもあった" },
    { "t": [27,  32], "ja": "ベアー・スターンズ、リーマン・ブラザーズ、エーアイジー、夏に働いたエンロン" },
    { "t": [32,  34], "ja": "へえ、悪くない考えだね" },
    { "t": [34,  35], "ja": "よし！" },
    { "t": [35,  36], "ja": "他に何か？" },
    { "t": [36,  37], "ja": "いや" },
    { "t": [40,  42], "ja": "あいつ、今マイケルと話してるぞ" },
    { "t": [42,  44], "ja": "俺たちの案に完全に乗ってきた" },
    { "t": [44,  47], "ja": "ああ！ お前の案な" },
    { "t": [47,  48], "ja": "俺の案" },
    { "t": [48,  52], "ja": "アンディには自分の案だと思わせておけばいい。そうすれば私にたどり着かない" },
    { "t": [52,  58], "ja": "およそ6時間後、ジムにデビッド・ウォレスから電話が来る" },
    { "t": [58,  60], "ja": "そして、クビになる" },
    { "t": [60,  62], "ja": "はい、皆さん、ようこそ" },
    { "t": [62,  65], "ja": "みんなワクワクしてると思うけど、誰が選ばれても" },
    { "t": [65,  69], "ja": "僕から見れば、みんなが月間優秀社員だってことを言っておきたい" },
    { "t": [69,  75], "ja": "そして受賞者は、社員番号9番、つまり…" },
    { "t": [75,  79], "ja": "9番、9番、ジム・ハルパート" },
    { "t": [79,  80], "ja": "え？" },
    { "t": [80,  81], "ja": "え？" },
    { "t": [81,  82], "ja": "冗談でしょ？" },
    { "t": [82,  83], "ja": "うそ！" },
    { "t": [83,  84], "ja": "よし、待って" },
    { "t": [84,  86], "ja": "僕は…" },
    { "t": [86,  87], "ja": "僕はしてない…" },
    { "t": [87,  89], "ja": "僕はしてない…" },
    { "t": [89,  91], "ja": "それは…" },
    { "t": [91,  92], "ja": "なんでよ？" },
    { "t": [92,  93], "ja": "みんな、聞いて" },
    { "t": [93,  95], "ja": "これは匿名だったんだ、いい？" },
    { "t": [95,  99], "ja": "自分に賞をあげるなんて無理だよ。誰が載ってるかも知らなかったんだから" },
    { "t": [99,  101], "ja": "総合点が一番高い社員に賞をあげただけなんだ" },
    { "t": [101,  105], "ja": "私の計算だと、君は自分の駐車場所と、休暇1日と" },
    { "t": [105,  108], "ja": "みんなからの、きっちり250ドルを手に入れたことになる" },
    { "t": [108,  111], "ja": "みんな、ちょっと待って。もちろん僕は何も受け取らないから" },
    { "t": [111,  113], "ja": "何かの間違いだし、原因は調べる" },
    { "t": [113,  115], "ja": "それに、賞金なんてなかったよね" },
    { "t": [115,  116], "ja": "ありました！" },
    { "t": [116,  117], "ja": "ドワイト？" },
    { "t": [117,  119], "ja": "ああ、理想の世界なら賞金があるって言ったじゃないか" },
    { "t": [119,  120], "ja": "そう言ったよな？" },
    { "t": [120,  124], "ja": "違うよ、ドワイト。つまり、完璧な世界なら誰かがお金をもらえるって意味で、でも…" },
    { "t": [124,  128], "ja": "ああ、でも君の完璧な世界では、お金をもらえるのは君だけなんだな" },
    { "t": [128,  129], "ja": "いや、それは…" },
    { "t": [129,  130], "ja": "やめてくれよ！" },
    { "t": [130,  131], "ja": "分かってる、いい？" },
    { "t": [131,  135], "ja": "ほら、明らかに大きな間違いがあったから、僕が直すよ" },
    { "t": [135,  136], "ja": "いい？" },
    { "t": [136,  138], "ja": "そもそもこれはお前の案だろ" },
    { "t": [138,  139], "ja": "訂正！" },
    { "t": [139,  141], "ja": "私の案だ" },
    { "t": [141,  142], "ja": "いい？" },
    { "t": [142,  143], "ja": "俺の案" },
    { "t": [143,  146], "ja": "みんな、パムが本当に妊娠してるのかも怪しくなってきた" },
    { "t": [146,  147], "ja": "はいはい" },
    { "t": [147,  152], "ja": "念のため言うけど、妊娠してます。それに、明らかに何かの間違いがあったんだから" },
    { "t": [152,  157], "ja": "ジムがリストの次に点数が高い人を選んで、それで終わりにしない？" },
    { "t": [157,  158], "ja": "ああ、いいよ" },
    { "t": [158,  159], "ja": "それなら公平だ" },
    { "t": [159,  160], "ja": "いいわ" },
    { "t": [160,  161], "ja": "いい考えだね、パム" },
    { "t": [161,  162], "ja": "ありがとう" },
    { "t": [162,  169], "ja": "それは社員番号3番、つまり、ちくしょう、パム・ハルパート" },
    { "t": [169,  170], "ja": "え？" },
    { "t": [170,  172], "ja": "どういうこと？" },
    { "t": [172,  175], "ja": "悪いけど、パム、一体どうしてそうなるの？" },
    { "t": [175,  179], "ja": "何か、ちゃんとした理由があるはずだ" },
    { "t": [179,  180], "ja": "ちょっと待って、何よ" },
    { "t": [180,  185], "ja": "一日も休まなかったし、早く来て遅くまで残ったし、先月は売り上げを倍にしたのよ" },
    { "t": [185,  186], "ja": "へえ、本当？" },
    { "t": [186,  187], "ja": "いくつから？" },
    { "t": [187,  188], "ja": "2件から4件？" },
    { "t": [188,  189], "ja": "そうよ" },
    { "t": [189,  192], "ja": "みんな、これは手の込んだ詐欺なんかじゃないんだ、いい？" },
    { "t": [192,  193], "ja": "どうも" },
    { "t": [193,  196], "ja": "特注ケーキのご注文です、ジム・ハルパート様" },
    { "t": [196,  197], "ja": "はい" },
    { "t": [197,  200], "ja": "それは僕だけど、ケーキなんて注文してない" },
    { "t": [200,  202], "ja": "見てよ、これ！" },
    { "t": [202,  205], "ja": "あんたしかいない！" },
    { "t": [205,  207], "ja": "最初から分かってたんだ！" },
    { "t": [207,  208], "ja": "ケーキ食べよっと" }
  ]
}
