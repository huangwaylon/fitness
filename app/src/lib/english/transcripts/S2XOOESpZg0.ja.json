{
  "video": "S2XOOESpZg0",
  "lines": [
    { "t": [0, 7.5], "ja": "中国には、人口100万人を超える都市が56もあるって知ってたか？" },
    { "t": [7.5, 9.5], "ja": "こっちにはいくつあると思う？9つだ" },
    { "t": [9.5, 11], "ja": "実は、それは違います" },
    { "t": [11, 14.9], "ja": "その数字なら知ってますけど、それは15年後の予測ですよ" },
    { "t": [14.9, 15.6], "ja": "よかった" },
    { "t": [15.6, 17.4], "ja": "いや、いや、それは今の数字だ" },
    { "t": [17.4, 19], "ja": "マイケル、中国は農業国ですよ" },
    { "t": [19, 21.9], "ja": "都市化は速い、それはそう。でも、まだ農業国です" },
    { "t": [21.9, 24.2], "ja": "多いのは土地の広さで、人口じゃない" },
    { "t": [24.2, 25], "ja": "勘弁してくださいよ、マイケル" },
    { "t": [25, 27.9], "ja": "いや、いや、それは君が間違ってる" },
    { "t": [27.9, 29.3], "ja": "その情報はどこで知ったんですか？" },
    { "t": [29.3, 31.3], "ja": "ニューヨーク・タイムズのサイトだ" },
    { "t": [31.3, 32.3], "ja": "おっと" },
    { "t": [32.3, 34.3], "ja": "緊張してきたか、オスカー？" },
    { "t": [34.3, 35.3], "ja": "よし、誰か調べてくれ" },
    { "t": [35.3, 36.3], "ja": "任せて、ジム" },
    { "t": [36.3, 37.3], "ja": "任せて" },
    { "t": [37.3, 38.3], "ja": "みんな、調べるほどのことじゃないって、ほんとに" },
    { "t": [38.3, 40.3], "ja": "みんな、時間の無駄だよ" },
    { "t": [40.3, 41.3], "ja": "これ見てる？" },
    { "t": [41.3, 42.3], "ja": "本気？" },
    { "t": [42.3, 44.3], "ja": "で、見てるの？" },
    { "t": [44.3, 46.3], "ja": "ここに座ってるよ" },
    { "t": [46.3, 47.3], "ja": "出た" },
    { "t": [47.3, 50.3], "ja": "中国には人口100万人を超える都市が56ある" },
    { "t": [50.3, 54.3], "ja": "アメリカは9つ" },
    { "t": [54.3, 56.3], "ja": "ざまあみろ、オスカー" },
    { "t": [56.3, 60.3], "ja": "まあ、いい面を見れば、中国のことを心配したおかげで、オスカーより賢くなったね、マイケル" },
    { "t": [60.3, 61.3], "ja": "はいはい" },
    { "t": [61.3, 62.3], "ja": "僕が間違ってた" },
    { "t": [62.3, 63.3], "ja": "間違ってました" },
    { "t": [63.3, 64.3], "ja": "これでみんな満足？" },
    { "t": [64.3, 67.3], "ja": "つまり、私はたまたまオフィスで一番賢い男より物知りだったってわけだ" },
    { "t": [67.3, 68.3], "ja": "だから何だ？" },
    { "t": [68.3, 70.3], "ja": "気にしてないさ" },
    { "t": [70.3, 71.3], "ja": "よし" },
    { "t": [71.3, 74.3], "ja": "さて、オスカーを打ち負かす前は、どこまで話してたっけ？" },
    { "t": [74.3, 75.3], "ja": "うわあ" },
    { "t": [75.3, 77.3], "ja": "この部屋には頭のいい人がたくさんいるね" },
    { "t": [77.3, 81.3], "ja": "オフィスで一番賢い二人、マイケルとオスカーがいる。しかも、その順番でね" },
    { "t": [81.3, 82.3], "ja": "面白いね、ジム" },
    { "t": [82.3, 83.3], "ja": "それは面白い" },
    { "t": [83.3, 84.3], "ja": "とても喜劇的に愉快だな、ジム" },
    { "t": [84.3, 85.3], "ja": "パソコンのことで質問があるんだけど" },
    { "t": [85.3, 86.3], "ja": "ねえ、オスカー？" },
    { "t": [86.3, 87.3], "ja": "何？" },
    { "t": [87.3, 89.3], "ja": "どいてくれる？マイケルに聞きたいから" },
    { "t": [89.3, 90.3], "ja": "分かった" },
    { "t": [90.3, 91.3], "ja": "分かった、分かったよ" },
    { "t": [91.3, 92.3], "ja": "マイケル、新しいタブってどうやって開くの？" },
    { "t": [92.3, 94.3], "ja": "コントロールPを押してみろ" },
    { "t": [94.3, 95.3], "ja": "それは印刷です" },
    { "t": [95.3, 97.3], "ja": "プリンターがつながってなければ違う" },
    { "t": [97.3, 100.3], "ja": "君はかなり危ない思いこみをしているな、オスカー" },
    { "t": [100.3, 102.3], "ja": "オスカー、マイケルのほうが賢くなって、悔しくてたまらないでしょ" },
    { "t": [102.3, 106.3], "ja": "彼のほうが賢いわけじゃない。一つのことで正しかっただけだ" },
    { "t": [106.3, 110.3], "ja": "うん、でも当てたのが、実はすごく賢いことだったんだよね" },
    { "t": [110.3, 112.3], "ja": "実は、そうだった" },
    { "t": [112.3, 117.3], "ja": "ここでは、オスカーは「アクチュアリー（実は）」って呼ばれてる。だって、ほぼどんな会話にも" },
    { "t": [117.3, 121.3], "ja": "割りこんできて、事実を付け足したり、文法を直したりするから" },
    { "t": [121.3, 126.3], "ja": "彼はまさに、あの昔ながらの、気取ったゲイのメキシコ人ってイメージそのものよ" },
    { "t": [126.3, 128.3], "ja": "コーヒーのことは気にするな。私のおごりだ" },
    { "t": [128.3, 129.3], "ja": "ええ、そうだと思ってました" },
    { "t": [129.3, 136.3], "ja": "マイケル、こうして少し話せて本当によかったです" },
    { "t": [136.3, 138.3], "ja": "待て" },
    { "t": [138.3, 140.3], "ja": "何か忘れてるぞ" },
    { "t": [140.3, 141.3], "ja": "何をです？" },
    { "t": [141.3, 142.3], "ja": "この会話だ" },
    { "t": [142.3, 145.3], "ja": "二人の男。一人は白人、一人はラテン系の女" },
    { "t": [145.3, 147.3], "ja": "上司と、数字を扱う係" },
    { "t": [147.3, 148.3], "ja": "私は君をクビにできる" },
    { "t": [148.3, 149.3], "ja": "クビにしろ" },
    { "t": [149.3, 150.3], "ja": "いや" },
    { "t": [150.3, 151.3], "ja": "情けをかけてやって" },
    { "t": [151.3, 152.3], "ja": "でも、こうしてここにいる" },
    { "t": [152.3, 153.3], "ja": "何が言いたいんです？" },
    { "t": [153.3, 164.3], "ja": "私が言いたいのは、私や君のような人間が話すのをやめない限り、誰もアメリカを止められないってことだ" },
    { "t": [164.3, 165.3], "ja": "ええ" },
    { "t": [165.3, 166.3], "ja": "いい子だ" },
    { "t": [166.3, 170.3], "ja": "私が話しているのは自由のことだ" },
    { "t": [170.3, 171.3], "ja": "選択のことだ" },
    { "t": [171.3, 175.3], "ja": "アメリカよ、心配はいらないと思う" },
    { "t": [175.3, 178.3], "ja": "中国に勝ちたいなら、勝てるからだ" },
    { "t": [178.3, 180.3], "ja": "勝ちたくないなら、それでもいい" },
    { "t": [180.3, 184.3], "ja": "それこそが、友よ、君の勝利だ" },
    { "t": [184.3, 190.3], "ja": "ほら、よく言うだろ。長く深く掘り続ければ、中国にたどり着くって" },
    { "t": [190.3, 191.3], "ja": "それは本当かもしれない" },
    { "t": [191.3, 199.3], "ja": "でも、誰も教えてくれないのは、会話の中で長く深く掘り続ければ、友達にたどり着くってことだ" },
    { "t": [199.3, 200.3], "ja": "ああ" },
    { "t": [200.3, 204.3], "ja": "では、会話に乾杯" },
    { "t": [204.3, 205.3], "ja": "そういう話じゃ…" },
    { "t": [205.3, 208.3], "ja": "カップを高く掲げろ" },
    { "t": [208.3, 209.3], "ja": "これにて一件落着" },
    { "t": [209.3, 213.3], "ja": "そんな話はしてなかったでしょう" },
    { "t": [213.3, 214.3], "ja": "それが全部じゃ…" }
  ]
}
