{
  "video": "bDynTALUc84",
  "lines": [
    { "t": [0,1.7], "ja": "あの、マイケル？　パム！" },
    { "t": [1.7,3.5], "ja": "あの、ここに…　チーズバーガー！" },
    { "t": [3.5,5.5], "ja": "人が来てて…　フライドポテト！" },
    { "t": [5.5,7.5], "ja": "あの…　やあ、ジェイク。何？　どうぞ" },
    { "t": [7.5,9.5], "ja": "ハンドバッグを売りたいって人が来てるんです" },
    { "t": [9.5,11.4], "ja": "だめだめだめ。会社に物売りは入れない" },
    { "t": [11.4,12.7], "ja": "仕事のじゃまになる" },
    { "t": [12.7,14], "ja": "分かりました、少なくとも話はしてくれるって伝えちゃいました" },
    { "t": [14,15.8], "ja": "パム、パム、勘弁してよ。忙しいんだ" },
    { "t": [15.8,17.4], "ja": "だから帰ってもらって" },
    { "t": [17.4,18.4], "ja": "分かりました" },
    { "t": [20.4,22.4], "ja": "おお" },
    { "t": [24.4,26.6], "ja": "よし、話してみよう" },
    { "t": [26.6,29.1], "ja": "これは手作りで…　よし、みんな、集まって" },
    { "t": [29.1,30.7], "ja": "侵入者だぞ" },
    { "t": [30.7,32.8], "ja": "めんどりの小屋におんどりだ　おんどりたちだ" },
    { "t": [32.8,34], "ja": "おんどりって言うな" },
    { "t": [34,38.7], "ja": "おお、美しいお嬢さん、お名前は？" },
    { "t": [38.7,40.8], "ja": "ケイティ　ああ、ケイティ" },
    { "t": [40.8,43], "ja": "わあ、すてきだね" },
    { "t": [43,44.1], "ja": "君は、その…" },
    { "t": [44.1,45.8], "ja": "新しく改良されたパムみたいだ" },
    { "t": [45.8,47.6], "ja": "パム6.0だ" },
    { "t": [47.6,49.5], "ja": "あ、ほら" },
    { "t": [49.5,51.9], "ja": "おっと、二人とも、女同士のけんかはなしだぞ" },
    { "t": [51.9,53.2], "ja": "職場での暴力には反対だからな" },
    { "t": [53.2,54.9], "ja": "私もです　お前の意見なんて誰も聞いてない" },
    { "t": [54.9,57.4], "ja": "どうでもいい　それで、えーと、そうだ" },
    { "t": [57.4,59.9], "ja": "普段は会社に物売りは入れないんだ" },
    { "t": [59.9,62.8], "ja": "でも、今日はちょっとルールを破ろう" },
    { "t": [62.8,64.3], "ja": "会議室を使っていいよ" },
    { "t": [64.3,65.3], "ja": "一日中使っていい" },
    { "t": [65.3,68.3], "ja": "わあ、ありがとう　11時半にそこで人事の会議がありますけど" },
    { "t": [68.3,71], "ja": "じゃあ、そっちは廊下でやらせよう" },
    { "t": [71,73.4], "ja": "椅子くらいは用意してやる。な？" },
    { "t": [73.4,74.8], "ja": "決断力" },
    { "t": [74.8,78.3], "ja": "成功の秘訣の一つだ、スモール・ビジネスマン誌によるとな" },
    { "t": [78.3,79.5], "ja": "お似合いです" },
    { "t": [79.5,81.9], "ja": "ほら、薄紫とか紫とかもあるし" },
    { "t": [81.9,84.9], "ja": "バッグの子は、僕のチェックリストを全部満たしてる" },
    { "t": [84.9,91.4], "ja": "なめらかな肌、きれいな歯並び、巻き毛、すばらしい胸" },
    { "t": [91.4,93.2], "ja": "自分のためじゃない、子どものためだ" },
    { "t": [93.2,96.3], "ja": "シュルート家の赤ん坊は、ものすごくお乳を飲むんだ" },
    { "t": [96.3,99.3], "ja": "一番のお客さんは、たいてい男の人なんです" },
    { "t": [99.3,100.6], "ja": "高い品物を買ってくれるの" },
    { "t": [100.6,103.1], "ja": "ビーズやスパンコールがついたのとか" },
    { "t": [103.1,104.8], "ja": "プレゼント用にね" },
    { "t": [104.8,106.2], "ja": "何を見てるのか分かってないから" },
    { "t": [106.2,108.4], "ja": "私がおすすめするんです" },
    { "t": [108.4,110.1], "ja": "よし、いいか？" },
    { "t": [110.1,111.5], "ja": "とにかく彼女と話し続けろ" },
    { "t": [111.5,113.3], "ja": "話につまったら、完璧な逃げ道がある" },
    { "t": [113.3,115], "ja": "何です？　バッグを買うんだ" },
    { "t": [115,116.6], "ja": "バッグなんかいりません。バッグは女のものです" },
    { "t": [116.6,118.6], "ja": "ドワイト、そうとは限らないぞ　無理です" },
    { "t": [118.6,120.1], "ja": "ジーキュー読んでるか？　いいえ" },
    { "t": [120.1,123.1], "ja": "そうか、俺は読んでる。小さいビジネスバッグみたいなもんだ、な？" },
    { "t": [123.1,125.2], "ja": "持ってる男はたくさんいる" },
    { "t": [125.2,126.6], "ja": "あんなのですか？　そうだ" },
    { "t": [126.6,128.5], "ja": "いいか、お前は時間を使いすぎだ" },
    { "t": [128.5,131.4], "ja": "俺と話すのにな　分かりました、ちょっとトイレに…" },
    { "t": [131.4,133.4], "ja": "いや、トイレはいらない" },
    { "t": [133.4,135.3], "ja": "もう行っただろ…　行け" },
    { "t": [138.2,139.9], "ja": "よし。しーっ、止まって" },
    { "t": [139.9,140.9], "ja": "何をしてても手を止めて" },
    { "t": [140.9,144.4], "ja": "これは面白くなるから" },
    { "t": [144.4,145.8], "ja": "こんにちは、ドワイト・シュルートといいます" },
    { "t": [145.8,148.3], "ja": "あなたからバッグを買いたいんです" },
    { "t": [148.3,151], "ja": "なんと、このバッグを見てくれ" },
    { "t": [151,153.3], "ja": "これは特別だ" },
    { "t": [153.3,154.5], "ja": "うわあ" },
    { "t": [154.5,158.5], "ja": "これ、サルヴァトーレ・ディチーニのですか？" },
    { "t": [158.5,161.2], "ja": "ああ、そうやって、ぜひ足を入れたり出したりして" },
    { "t": [161.2,162.3], "ja": "ええ　うん、それを身につけて…" },
    { "t": [162.3,165], "ja": "耐久テストをしたいんです" },
    { "t": [165,167], "ja": "何かあった時のためにね" },
    { "t": [167,168.6], "ja": "おっ！" },
    { "t": [168.6,171], "ja": "今のは本当に…" },
    { "t": [171,172.4], "ja": "これはやらなきゃいけないんです" },
    { "t": [172.4,174.4], "ja": "しっかり試すためにね" },
    { "t": [174.4,176.2], "ja": "これは…おお" },
    { "t": [176.2,178.3], "ja": "これが一番きれいだ" },
    { "t": [178.3,181.1], "ja": "舞踏会で一番きれいな女の子になれる" },
    { "t": [181.1,182.7], "ja": "で、いくら？" },
    { "t": [182.7,184.7], "ja": "うわ。悲しい" },
    { "t": [184.7,186.2], "ja": "すごく悲しい" },
    { "t": [186.2,187.3], "ja": "来たぞ" },
    { "t": [194.8,197.1], "ja": "いいのを選べるよ　ひどい人ね" },
    { "t": [204.4,205.7], "ja": "どうも　どうも" },
    { "t": [205.7,208], "ja": "ところで、僕はジム　ケイティです" },
    { "t": [208,210], "ja": "やあ、ケイティ。よろしく　どうも、あっちに座ってる人ですよね？" },
    { "t": [210,211.7], "ja": "そう。それで一番知られてるんだ" },
    { "t": [211.7,213.3], "ja": "あそこに座ってることでね" },
    { "t": [213.3,215.4], "ja": "よし、バッグの話をしよう" },
    { "t": [215.4,218.4], "ja": "はい、えっと…　ケイティ、でもさ" },
    { "t": [218.4,220.4], "ja": "僕に売りつけようとしないでね" },
    { "t": [220.4,222.6], "ja": "本当に。勉強しに来ただけだから" },
    { "t": [222.6,225.7], "ja": "はい　ほとんど知ってるんだけど…" },
    { "t": [225.7,227.3], "ja": "はい　どう？" },
    { "t": [227.3,230.9], "ja": "退屈　選んでくれてありがとう" },
    { "t": [230.9,232.7], "ja": "いや、冗談だよ" },
    { "t": [232.7,235.7], "ja": "えっと、週末は何か大きな予定ある？" },
    { "t": [235.7,239.3], "ja": "ああ、ケイティと会うと思う" },
    { "t": [239.3,241.8], "ja": "ほんと？　うん" },
    { "t": [241.8,243.6], "ja": "二人で何するの？" },
    { "t": [243.6,245.3], "ja": "うーん、分からないな" },
    { "t": [245.3,250.1], "ja": "食事、お酒、映画、おそろいのタトゥー" },
    { "t": [250.1,251.9], "ja": "いいね　大イベントだよ" },
    { "t": [251.9,254], "ja": "いいね　うん" },
    { "t": [254,255.9], "ja": "君は何するの？　言おうと思ってたんだけど" },
    { "t": [255.9,258.9], "ja": "えっと、ロイのいとこの引っ越しを手伝うと思う" },
    { "t": [258.9,262.8], "ja": "そっか　ロイがトラックを持ってるから" },
    { "t": [262.8,264.9], "ja": "いいね　うん" },
    { "t": [264.9,268], "ja": "ええ　それはいいね" },
    { "t": [268,269.6], "ja": "でも、月曜には会うよね？" },
    { "t": [269.6,270.9], "ja": "よかった　うん" },
    { "t": [270.9,273.7], "ja": "じゃあ、戻るね　分かった" },
    { "t": [288.7,289.6], "ja": "また次回" },
    { "t": [289.6,290.6], "ja": "また次回" }
  ]
}
