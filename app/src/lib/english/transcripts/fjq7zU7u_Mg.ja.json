{
  "video": "fjq7zU7u_Mg",
  "lines": [
    { "t": [0,  0.8], "ja": "やあ、テリー" },
    { "t": [1,  1.9], "ja": "また会えてうれしいよ" },
    { "t": [2,  2.9], "ja": "久しぶりだね？" },
    { "t": [3.4,  4], "ja": "いやあ、面白いな" },
    { "t": [4.1,  5.9], "ja": "この廊下、前より狭く見えるよ" },
    { "t": [6.8,  7.8], "ja": "別の建物だからね" },
    { "t": [9.8,  10.2], "ja": "それで" },
    { "t": [11.6,  13.2], "ja": "ストライカー・ラモレイか" },
    { "t": [14,  15], "ja": "いつから始めればいい？" },
    { "t": [15.4,  16.5], "ja": "今すぐ始めたらどうかな？" },
    { "t": [16.6,  17], "ja": "分かった" },
    { "t": [18.2,  19.7], "ja": "これがオーディション用の台本だ" },
    { "t": [24.4,  24.8], "ja": "オーディション？" },
    { "t": [25.3,  26.7], "ja": "役をくれるんだと思ってたよ" },
    { "t": [27.1,  27.9], "ja": "なぜそう思ったんだ？" },
    { "t": [27.9,  29.9], "ja": "だって、僕はドクター・ドレイク・ラモレイだったんだよ" },
    { "t": [30,  31], "ja": "ストライカーの双子の兄弟だ" },
    { "t": [31.8,  33.7], "ja": "僕より僕に似てる役だろ？" },
    { "t": [35.3,  36.9], "ja": "全員オーディションを受けるんだ" },
    { "t": [39.5,  40.4], "ja": "あのさ、テリー" },
    { "t": [40.4,  42.5], "ja": "僕は別にこんなことしなくてもいいんだ" },
    { "t": [43,  44.6], "ja": "自分のケーブルテレビのシリーズがあるからね" },
    { "t": [45.8,  46.8], "ja": "ロボットと出てる" },
    { "t": [49,  50], "ja": "すまない、ジョーイ" },
    { "t": [50.1,  51.7], "ja": "決まりなんだ" },
    { "t": [52.9,  53.2], "ja": "そうか" },
    { "t": [54.8,  56.7], "ja": "自分は特別だと思ってるんだろうな？" },
    { "t": [57.5,  58.4], "ja": "ここにふんぞり返って" },
    { "t": [58.4,  60.4], "ja": "狭い廊下の立派な建物でさ" },
    { "t": [62.6,  64.8], "ja": "スターに輪っかをくぐらせて、言いなりにさせてるんだろ？" },
    { "t": [65.5,  66.2], "ja": "いいか" },
    { "t": [68.6,  70.4], "ja": "僕は、輪っかを…しないスターだ" },
    { "t": [71.9,  73.8], "ja": "輪っかを…するスター" },
    { "t": [73.8,  74.2], "ja": "この輪っか" },
    { "t": [74.4,  75.8], "ja": "僕はドクター・ドレイク・ラモレイだったんだぞ！" },
    { "t": [75.8,  77.5], "ja": "輪っかを…するスター" }
  ]
}
