{
  "video": "K1HHUx7CNC0",
  "lines": [
    { "t": [0,  1.3], "ja": "早くしてよ" },
    { "t": [1.3,  2.9], "ja": "任せて、やり方は分かってるから" },
    { "t": [2.9,  4.7], "ja": "里親の家と孤児院を合わせて" },
    { "t": [4.7,  6.7], "ja": "シラミには22回なったの" },
    { "t": [7.8,  9.1], "ja": "うわ、すごい、大きいのがいた" },
    { "t": [9.1,  11.8], "ja": "はい、みんな手を止めて。シラミが出た" },
    { "t": [11.8,  12.6], "ja": "うえっ" },
    { "t": [12.6,  14.5], "ja": "うそ、メレディス、シラミ？" },
    { "t": [14.5,  17], "ja": "シャワーを浴びるって誓約書にサインしなかったの？" },
    { "t": [17,  18.2], "ja": "何？" },
    { "t": [18.2,  19.1], "ja": "シラミ？" },
    { "t": [20.1,  21.3], "ja": "なんてことだ" },
    { "t": [21.3,  23.6], "ja": "ドアに鍵をかけろ、完全隔離だ！" },
    { "t": [23.6,  26.1], "ja": "ドワイト、落ち着いて。ただのシラミよ" },
    { "t": [26.1,  27.4], "ja": "たぶん、もしかしたらね" },
    { "t": [27.4,  28.9], "ja": "ただのシラミ" },
    { "t": [28.9,  32.9], "ja": "パム、神の大いなる緑の王国にいる害虫の中で" },
    { "t": [32.9,  35.3], "ja": "私が一番憎んでいるのがシラミなんだ" },
    { "t": [35.3,  37.4], "ja": "学校の初日、私はシラミがいて" },
    { "t": [37.4,  39.2], "ja": "誰も遊んでくれなかった" },
    { "t": [39.2,  42.6], "ja": "15年間、変人とかメガネとか" },
    { "t": [42.6,  44.9], "ja": "空想科学オタクとか、女を殴るやつとか呼ばれた" },
    { "t": [44.9,  47.9], "ja": "全部、7歳のときにシラミがいたせいでな" },
    { "t": [47.9,  49.6], "ja": "早く、待て、いや、私を調べてくれ" },
    { "t": [52.5,  55.1], "ja": "まあ、こんなにきれいな頭皮は初めて見た" },
    { "t": [55.1,  55.9], "ja": "問題なしよ" },
    { "t": [55.9,  57.9], "ja": "当然だ、毎朝シラミ用シャンプーを使っている" },
    { "t": [57.9,  59.8], "ja": "ねえ、それ何？" },
    { "t": [59.8,  60.8], "ja": "ああ、そうだった" },
    { "t": [60.8,  61.6], "ja": "ドワイト" },
    { "t": [62.9,  64.1], "ja": "次" },
    { "t": [64.1,  66.3], "ja": "まったく、メレディス、ここは職場なのよ" },
    { "t": [66.3,  68.4], "ja": "あなたのビーズクッション乱交パーティーじゃないの" },
    { "t": [68.4,  69.7], "ja": "少し大目に見てあげようよ" },
    { "t": [69.7,  72.2], "ja": "メレディスのせいだと決まったわけじゃないし" },
    { "t": [72.2,  73.6], "ja": "パム？" },
    { "t": [73.6,  74.8], "ja": "本気？" },
    { "t": [74.8,  75.6], "ja": "勘弁してよ" },
    { "t": [75.6,  76.4], "ja": "いいのよ" },
    { "t": [76.4,  77.8], "ja": "自分がどういう人間かは分かってる" },
    { "t": [77.8,  80.7], "ja": "メレディス・パーマーをオペラに連れていって女王に会わせる人なんていない" },
    { "t": [80.7,  81.6], "ja": "シラミ" },
    { "t": [81.6,  82.6], "ja": "またシラミ" },
    { "t": [82.6,  83.6], "ja": "アンジェラにシラミ" },
    { "t": [83.6,  84.4], "ja": "うえっ！" },
    { "t": [84.4,  85.8], "ja": "痛っ！" },
    { "t": [85.8,  87.6], "ja": "うわっ" },
    { "t": [87.6,  88.2], "ja": "シラミ" },
    { "t": [88.2,  89], "ja": "うひゃー" },
    { "t": [89,  89.8], "ja": "シラミ" },
    { "t": [89.8,  91.4], "ja": "いや！" },
    { "t": [91.4,  92.1], "ja": "どうして？" },
    { "t": [92.1,  93.6], "ja": "こんなに清潔なのに" },
    { "t": [93.6,  94.6], "ja": "ああ、そう、たっぷりね" },
    { "t": [94.6,  95.5], "ja": "ああ！" },
    { "t": [95.5,  97.4], "ja": "1日に少なくとも6回は手を洗ってる" },
    { "t": [97.4,  98.4], "ja": "便座カバー？" },
    { "t": [98.4,  100.4], "ja": "ええ、どうも、おしっこのときでもね" },
    { "t": [100.4,  103], "ja": "どうやら、それでも防ぎきれないみたい" },
    { "t": [103,  104.9], "ja": "メレディスが相手じゃね" },
    { "t": [104.9,  106.7], "ja": "だから私には見えないのね" },
    { "t": [106.7,  107.7], "ja": "おお！" },
    { "t": [107.7,  108.4], "ja": "おお！" },
    { "t": [108.4,  109.2], "ja": "ああ、そうだ" },
    { "t": [109.2,  110.7], "ja": "ねえ、何を着てるの？" },
    { "t": [110.7,  111.9], "ja": "防護服だ" },
    { "t": [111.9,  117], "ja": "「危険物、男性用、スーツ、着用」の略だ" },
    { "t": [117,  119.8], "ja": "年に4回以上借りるなら、買ったほうが得なんだ" },
    { "t": [119.8,  125.2], "ja": "ここに、シラミがいない人は他にいるか？" },
    { "t": [125.2,  125.7], "ja": "よろしい" },
    { "t": [125.7,  127.3], "ja": "自分の防護服を持ってるか？" },
    { "t": [127.3,  128.3], "ja": "いいえ" },
    { "t": [128.3,  130.4], "ja": "いや、レンタル派か" },
    { "t": [130.4,  132.4], "ja": "よし、荷物をまとめて" },
    { "t": [132.4,  134.5], "ja": "倉庫に退避し" },
    { "t": [134.5,  138.6], "ja": "感染者のシラミ駆除が終わるまで、そこで仕事をしてくれ" },
    { "t": [138.6,  139.5], "ja": "さあ、行こう" },
    { "t": [139.5,  141], "ja": "私はここに残って戦う" },
    { "t": [141,  143.4], "ja": "昼までに連絡がなかったら、電話してくれ" },
    { "t": [143.4,  144.6], "ja": "昼ごはんが欲しいかもしれないから" },
    { "t": [145.6,  147.9], "ja": "ねえ、メレディス、話さなきゃいけないことがあるの" },
    { "t": [147.9,  150.1], "ja": "うそ、メレディス、何してるの？" },
    { "t": [150.1,  150.8], "ja": "ケーキを焼いてるのよ" },
    { "t": [150.8,  151.9], "ja": "何してるように見える？" },
    { "t": [151.9,  152.9], "ja": "シラミを退治してる" },
    { "t": [152.9,  153.6], "ja": "ああ、やめて" },
    { "t": [153.6,  154.4], "ja": "本当にごめんなさい" },
    { "t": [154.4,  155.7], "ja": "あ、その話、ちょっと待ってくれる？" },
    { "t": [155.7,  156.9], "ja": "脱毛用のワックスなの" },
    { "t": [156.9,  159.2], "ja": "ほら、このちびたちは下のほうから移ってきたと思うのよね" },
    { "t": [161.1,  163], "ja": "何て言ってたっけ？" },
    { "t": [163,  164.1], "ja": "何でもない" },
    { "t": [164.1,  168.2], "ja": "いつかは言うけど、今じゃないのは明らか" },
    { "t": [168.2,  172], "ja": "かつらを買ってあげて、ちょっと笑い合うの" },
    { "t": [172,  174.6], "ja": "ちゃんとしたやり方があるのよ" },
    { "t": [176.6,  181.2], "ja": "頭皮のヒル、頭がい骨の吸血鬼、毛穴の流れ者" },
    { "t": [181.2,  185.5], "ja": "髪の毛の弁護士。一つ確かなのは、殺るか殺られるかだ" },
    { "t": [185.5,  186.1], "ja": "いや、いや、いや" },
    { "t": [186.1,  187.6], "ja": "どちらかというと、ただ迷惑なだけよ" },
    { "t": [187.6,  189.2], "ja": "そんなに大したことじゃない" },
    { "t": [189.2,  190.9], "ja": "それで、みんなの帽子とコートを集めた" },
    { "t": [190.9,  192.1], "ja": "燃やすためにな！" },
    { "t": [192.1,  193.1], "ja": "洗うためよ" },
    { "t": [193.1,  194.8], "ja": "頭はどうすればいいの？" },
    { "t": [194.8,  197.1], "ja": "嘘はつかない、シラミだ！" },
    { "t": [197.1,  199.7], "ja": "いいえ、マヨネーズさえあればいいの" },
    { "t": [199.7,  200.6], "ja": "何ですって？" },
    { "t": [200.6,  202.7], "ja": "彼女の言うとおり。効くのよ" },
    { "t": [202.7,  203.6], "ja": "そうでしょうね" },
    { "t": [203.6,  208.3], "ja": "ええ、ちびたちを窒息させてくれるし、とても体にいい代わりになるの" },
    { "t": [208.3,  210.6], "ja": "たいていのシラミ用シャンプーに入ってる化学物質のね" },
    { "t": [210.6,  212.2], "ja": "それは分かるわ" },
    { "t": [212.2,  215], "ja": "私も、地元の有機野菜しか食べないから" },
    { "t": [217.3,  218.3], "ja": "じゃーん！" },
    { "t": [218.3,  220.3], "ja": "どう、今の私？" },
    { "t": [220.3,  221.3], "ja": "わあ" },
    { "t": [221.3,  223.1], "ja": "写真でも撮れば？ そのほうが長持ちするわよ" },
    { "t": [223.1,  224.7], "ja": "長持ちしてほしくないよ" },
    { "t": [224.7,  225.7], "ja": "ひどいから" },
    { "t": [225.7,  227.3], "ja": "はげた人を見ると気分が悪くなる" },
    { "t": [227.3,  229.6], "ja": "はいはい、みんなでメレディスを責めればいいわ" },
    { "t": [229.6,  233], "ja": "でも、シラミにどっちが上か見せつける度胸があるのは私だけよ" },
    { "t": [235,  236.3], "ja": "よし、誰も慌てるな" },
    { "t": [236.3,  240.3], "ja": "みんなが私の指示に従えば、これ以上はげる人は出ない" },
    { "t": [240.3,  244.6], "ja": "見た目が悪いってわけじゃないよ、メレディス。すごく…すごくいいよ" },
    { "t": [244.6,  249], "ja": "突然50歳年を取った赤ちゃんみたい。かわいい赤ちゃんね" },
    { "t": [249,  251], "ja": "でも、何かに生命力を吸い取られた感じ" },
    { "t": [251,  253.4], "ja": "本当にごめん、マヨネーズが要るの、今すぐ" },
    { "t": [253.4,  254.7], "ja": "あ、私が行く" },
    { "t": [254.7,  257.7], "ja": "いいの、ありがとう、いや、大したことじゃないから、ほんとに" },
    { "t": [257.7,  261], "ja": "あの、メレディス、お店に行くついでに、何か特別な物を買ってこようか？" },
    { "t": [261,  264.1], "ja": "お菓子とか、おしゃれなターバンとか？" },
    { "t": [264.1,  265.1], "ja": "ありがとう、パム" },
    { "t": [265.1,  267.8], "ja": "禁煙ガムを1パックと、クールズのタバコを1箱ちょうだい" },
    { "t": [267.8,  268.8], "ja": "分かった" },
    { "t": [270,  273.8], "ja": "さあ、みんな、下の毛の話をしよう" }
  ]
}
