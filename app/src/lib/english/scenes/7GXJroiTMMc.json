 "scenes": [
  {
   "t": [
    0,
    14
   ],
   "ja": "オスカーが仮装の意図を聞き、ケビンはある有名人に似ているだけだと答える"
  },
  {
   "t": [
    14,
    30
   ],
   "ja": "エリンがおどけて電話に出て、パムの企画した催しが次々と紹介される"
  },
  {
   "t": [
    30,
    46
   ],
   "ja": "皆がコンテストに熱心なのは、豪華に聞こえる割引券の本のためだと分かる"
  },
  {
   "t": [
    46,
    62
   ],
   "ja": "ドワイトが忍び寄って脅し、怪しいとからかわれると鶏の話で返す"
  },
  {
   "t": [
    62,
    78
   ],
   "ja": "ドワイトがパムの仮装をけなし、パムは相方のジムが衣装を着ないと嘆く"
  },
  {
   "t": [
    78,
    93
   ],
   "ja": "ジムは昔から仮装が苦手だと語り、パムに渡された衣装を見て拒む"
  },
  {
   "t": [
    93,
    113
   ],
   "ja": "ケリーの衣装替えをめぐって言い合いになり、オスカーは賞品の価値を疑う"
  },
  {
   "t": [
    113,
    127
   ],
   "ja": "皆はオスカーを黙らせ、賞品が欲しくてパムの企画を渋々ほめる"
  },
  {
   "t": [
    127,
    141
   ],
   "ja": "吸血鬼の仮装が話題になり、オスカーは衣装なしで皮肉な仮装を名乗る"
  },
  {
   "t": [
    141,
    157
   ],
   "ja": "オスカーは同じ冗談を繰り返して流され、パムが投票のルールを説明する"
  },
  {
   "t": [
    157,
    175
   ],
   "ja": "マイケルが倉庫の同僚になりきり、大げさな口調で登場する"
  },
  {
   "t": [
    175,
    190
   ],
   "ja": "マイケルは誰の仮装か当てさせようとし、やめた方がいいと止められる"
  },
  {
   "t": [
    190,
    200
   ],
   "ja": "マイケルは仮装をやめるが、場を自分の問題にするなと責められる"
  },
  {
   "t": [
    200,
    214
   ],
   "ja": "音楽が流れる中、皆が順に仮装を披露していく"
  },
  {
   "t": [
    214,
    232
   ],
   "ja": "オスカーが衣装なしの仮装を気取って披露し、披露が続く"
  },
  {
   "t": [
    232,
    246
   ],
   "ja": "ある同僚が衣装選びを責められ、この職場で受けるものを選んだと言い返す"
  },
  {
   "t": [
    246,
    258
   ],
   "ja": "ジムがついにポパイの姿になり、パムと二人でポーズを決める"
  },
  {
   "t": [
    258,
    273
   ],
   "ja": "パムが票を集計し、優勝者はオスカーだと発表する"
  },
  {
   "t": [
    273,
    290
   ],
   "ja": "皆はそれぞれ、自分なりの理由でオスカーに投票したとカメラに語る"
  },
  {
   "t": [
    290,
    309
   ],
   "ja": "音楽が流れ、クリップが終わる"
  }
