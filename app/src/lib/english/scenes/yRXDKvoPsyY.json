   ],
   "ja": "ハロウィンのパーティーで、一人が思いどおりにいかない状況を大げさに嘆く"
  },
  {
   "t": [
    15,
    30
   ],
   "ja": "仲間は元気づけようと、トイレの前でトムを待ち伏せして驚かそうと誘う"
  },
  {
   "t": [
    30,
    45
   ],
   "ja": "一斉に飛び出すが、出てきたのはジェリーで、悲鳴と騒ぎが起こる"
  },
  {
   "t": [
    45,
    58
   ],
   "ja": "ジェリーが倒れて心臓発作の疑いが出て、皆が慌てて救急車を呼ぶ"
  },
  {
   "t": [
    58,
    72
   ],
   "ja": "介抱しながらもひどいにおいに皆が文句を言い、遅れて来たトムも驚く"
  },
  {
   "t": [
    72,
    84
   ],
   "ja": "病院で、仲間がジェリーに見舞いの品を渡し、トムは冗談を添える"
  },
  {
   "t": [
    84,
    97
   ],
   "ja": "アンが容体は良好だと伝え、医師は軽い心臓発作だったと説明する"
  },
  {
   "t": [
    97,
    110
   ],
   "ja": "一人が医師に、発作とおならを合わせた呼び名を言わせようと食い下がる"
