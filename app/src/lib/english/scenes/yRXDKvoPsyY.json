  {
   "t": [
    110,
    121
   ],
   "ja": "見舞いの多さに感謝の声が上がるが、そもそも彼らのせいだと指摘される"
  },
  {
   "t": [
    121,
    134
   ],
   "ja": "ジェリーはむしろ良いきっかけだったと語り、家族のために生活を変えると誓う"
  },
  {
   "t": [
    134,
    145
   ],
   "ja": "仲間たちは、ジェリーの将来は自分たちに任せろと請け合う"
  },
  {
   "t": [
    145,
    157
   ],
   "ja": "音楽が流れ、クリップが終わる"
  }
