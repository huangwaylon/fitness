  "chat.sp.daisy-mae.intro": "Morning! I'm Daisy Mae!\nI sell Grandma's turnips.\nJust saying hi today…\nSee you next Sunday morning!",
  "chat.sp.wisp.intro": "Boo! …Did I scare you?\nI'm Wisp. I'm a ghost.\nPlease don't be scared…\nI just love night walks.",
  "visitor.reese": "Reese",
  "visitor.cyrus": "Cyrus",
  "chat.sp.reese.intro": "Hello! I'm Reese.\nThis is my husband, Cyrus.\nWe came to cheer you on\nfor your wedding!",
  "chat.sp.reese.count": "{n} days to the wedding!",
  "chat.sp.reese.day": "Congratulations on your wedding!\nHave a wonderful day!",
  "chat.sp.reese.0": "How are the wedding\nplans coming along?",
  "chat.sp.reese.1": "Your two smiles are\njust lovely.",
  "chat.sp.reese.2": "Staying healthy every day is\nthe best gift of all!",
  "chat.sp.reese.3": "We're looking forward\nto the big day too!",
  "chat.sp.cyrus.0": "...Congrats.\nYou two are good together.",
  "chat.sp.cyrus.1": "I was nervous on\nmy wedding day too.",
  "chat.sp.cyrus.2": "Seeing Reese this happy\nmakes my day.",
  "chat.sp.cyrus.3": "Take care of each other,\nyou hear?",
  "visitor.franklin": "Franklin",
  "visitor.jingle": "Jingle",
  "visitor.zipper": "Zipper",
  "chat.sp.franklin.intro": "Happy Turkey Day!\nI'm Franklin, the chef.\nToday's the day we all sit down\nto a big feast together!",
  "chat.sp.franklin.ask": "For my very best dish\nI need one fish.\nIf you catch one, would you\nbring it to me?",
  "chat.sp.franklin.thanks": "Oh! A splendid {fish}!\nThank you! Now I can make\nthe finest feast of all!",
  "chat.sp.franklin.0": "Smells good, doesn't it?\nAlmost ready!",
  "chat.sp.franklin.1": "Food in season\ngives you energy!",
  "chat.sp.franklin.2": "Your fish is going to\ntaste wonderful!",
  "chat.sp.franklin.3": "Here's to a bountiful autumn!",
  "chat.sp.jingle.intro": "Merry Toy Day!\nI'm Jingle!\nTonight's the special night\nI deliver presents!",
  "chat.sp.jingle.0": "Good kids get\npresents!",
  "chat.sp.jingle.1": "It's cold out, so stay\nwarm when you sleep!",
  "chat.sp.jingle.2": "Your island is\nall sparkly!",
  "chat.sp.jingle.3": "Ho ho! Have a\njolly Toy Day!",
  "chat.sp.zipper.intro": "Hoppy hop!\nI'm Zipper!\nLet's hunt for\nBunny Day eggs!",
  "chat.sp.zipper.0": "Eggs hide in the ground\nand on balloons, hop!",
  "chat.sp.zipper.1": "You might even fish\none up, hop!",
  "chat.sp.zipper.2": "Having a hoppy\nBunny Day?",
  "chat.sp.zipper.3": "Hop hop! Let's keep\nbouncing along!",
  "beach.fished": "I caught {name}!",
  "visitor.celeste": "Celeste",
  "chat.sp.celeste.intro": "Oh, good evening!\nI'm Celeste. I just love the stars.\nThere'll be lots of shooting stars tonight!\nLet's watch them together.",
  "chat.sp.celeste.0": "When you see a shooting star,\ntap the sky and make a wish!",
  "chat.sp.celeste.1": "Wish on one, and tomorrow morning\nstar fragments wash up on the beach.",
  "chat.sp.celeste.2": "This season's sign is {sign}.\nYou might find its fragment too!",
  "chat.sp.celeste.3": "Hoo! Did you see that one?\nWhat a lovely shooting star!",
