  "visitor.daisy-mae": "Daisy Mae",
  "visitor.wisp": "Wisp",
  "visitor.gulliver": "Gulliver",
  "visitor.gulliver.zzz.0": "…zzz…",
  "visitor.gulliver.zzz.1": "…glub… glub…",
  "visitor.gulliver.zzz.2": "…mmh… my ship…",
  "chat.sp.daisy-mae.0": "Turnips, anyone?",
  "chat.sp.daisy-mae.1": "Grandma's turnips are the best!",
  "chat.sp.daisy-mae.2": "I only come on Sunday mornings!",
  "chat.sp.daisy-mae.3": "Good morning! What a nice day!",
  "chat.sp.wisp.0": "Boo! …Did I scare you?",
  "chat.sp.wisp.1": "The island's so quiet at night…",
  "chat.sp.wisp.2": "I'm a friendly ghost, honest!",
  "chat.sp.wisp.3": "Feels a little chilly, right?",
  "chat.sp.gulliver.0": "…Huh! Where am I?",
  "chat.sp.gulliver.1": "I seem to have fallen off my ship…",
  "chat.sp.gulliver.2": "This island's name… I forget.",
  "chat.sp.gulliver.3": "My crew should come get me soon!",
  "visitor.kicks": "Kicks",
  "visitor.label": "Label",
  "visitor.saharah": "Saharah",
  "visitor.leif": "Leif",
  "visitor.redd": "Redd",
  "visitor.cj": "C.J.",
  "visitor.flick": "Flick",
  "chat.sp.kicks.intro": "Hey there, I'm Kicks.\nI run a shoe and bag shop\non islands all over.\nJust saying hi today, though.",
  "chat.sp.kicks.0": "Those shoes really suit you.",
  "chat.sp.kicks.1": "Good shoes put a spring in your step.",
  "chat.sp.kicks.2": "Well-walked shoes are the coolest kind.",
  "chat.sp.kicks.3": "You look light on your feet today!",
  "chat.sp.label.intro": "Hello! I'm Label!\nI'm touring the islands\nlooking for ideas\nfor new fashion!",
  "chat.sp.label.0": "Clothes you can move in are the best!",
  "chat.sp.label.1": "Today's theme… sporty, I think!",
  "chat.sp.label.2": "A smile after a workout is the best accessory.",
  "chat.sp.label.3": "I'd love to use this island's colours in a design.",
  "chat.sp.saharah.intro": "Hoo hoo… I am Saharah.\nI come from a faraway desert,\ntravelling in search\nof wondrous rugs.",
  "chat.sp.saharah.0": "An island that doesn't smell of sand…",
  "chat.sp.saharah.1": "A room's floor is so very important.",
  "chat.sp.saharah.2": "Mysterious patterns calm the soul.",
  "chat.sp.saharah.3": "My journey goes on and on…",
  "chat.sp.leif.intro": "Heyyy… I'm Leif.\nI really love growing\nflowers and trees.\nYour island's so green, duuude.",
  "chat.sp.leif.0": "Been watering the flowers?",
  "chat.sp.leif.1": "Growing slowly is cool too, dude.",
  "chat.sp.leif.2": "The smell of soil is so relaxing…",
  "chat.sp.leif.3": "Bodies are like trees: a little every day.",
  "chat.sp.redd.intro": "Hey, cousin! Name's Redd.\nI tour the islands\nwith rare treasures…\ntoday I'm just scoping things out.",
  "chat.sp.redd.0": "Shh… this stays between us, cousin.",
  "chat.sp.redd.1": "Real or fake? It takes a good eye.",
  "chat.sp.redd.2": "Nice island you got here, cousin.",
  "chat.sp.redd.3": "Whoa, nobody's watching, right?",
  "chat.sp.cj.intro": "Hey! C.J. here!\nI make videos\nshowing off my fishing.\nCan't wait to see the fish here!",
  "chat.sp.cj.0": "What'll be biting today?",
  "chat.sp.cj.1": "Fishing is all patience and guts!",
  "chat.sp.cj.2": "Tell me if you land a big one!",
  "chat.sp.cj.3": "Like and subscribe, dude!",
  "chat.sp.flick.intro": "…Hey. I'm Flick.\nI make art\ninspired by bugs.\nCame to see this island's bugs.",
  "chat.sp.flick.0": "A bug's shape is… art, you know?",
  "chat.sp.flick.1": "Swing the net quietly.",
  "chat.sp.flick.2": "…This island looks good for bugs.",
  "chat.sp.flick.3": "Tell me if you find a rare one.",
