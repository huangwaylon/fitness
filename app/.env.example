# Copy to .env (never commit it).
PORT=3000
DATABASE_PATH=/data/island.db
# adapter-node: ingest bodies can be large; the app caps /ingest at 20 MB and everything else at 64 KB.
BODY_SIZE_LIMIT=20M

# Web push — generate once with `npx tsx scripts/vapid.ts` (changing them invalidates every subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Gym / studio places for the Arrive/Leave Shortcuts (defaults: anytime (A), pt_studio (B, auto-strength), anytime_b (B)).
# PLACES=[{"key":"anytime","person":"A","name":"エニタイム 渋谷","autoStrength":false},{"key":"pt_studio","person":"B","name":"PTスタジオ","autoStrength":true}]

# Real client IPs for rate limiting, if Funnel forwards them (verify with a test request first) [U].
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Optional: first week to settle (Monday). Default: first full week of season 1.
# SETTLE_FROM_WEEK=2026-11-02
# DISABLE_SCHEDULER=1

# Development only (ignored when NODE_ENV=production): act as this person without pairing.
# DEV_PERSON=A
